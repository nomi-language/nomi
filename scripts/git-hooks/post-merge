#!/usr/bin/env bash
# post-merge: after a merge into main, bring this machine's editors up to date
# with what the merge changed (scripts/dev-editors.sh).
#
# Enable it once per clone with `make enable-hooks`, which sets core.hooksPath
# to this directory's absolute path. A relative core.hooksPath resolves against
# the git directory, which in a clone with worktrees is the shared one, so the
# hook would never be found.
#
# core.hooksPath is shared by every worktree of a clone, so the hook acts only
# when the checked-out branch is main. A merge or fast-forward in a feature or
# agent worktree changes nothing outside that worktree.

set -uo pipefail

[[ "$(git symbolic-ref --short -q HEAD)" == "main" ]] || exit 0
root="$(git rev-parse --show-toplevel)"
changed="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null)" || exit 0

targets=()
if grep -qE '(\.go$|^go\.(mod|sum)$|^std/)' <<<"$changed"; then
  targets+=(cli)
fi
if grep -qE '^(tree-sitter-nomi/(src|queries)/|editors/(nvim|helix|zed)/)' <<<"$changed"; then
  targets+=(nvim helix zed)
fi
if grep -qE '^editors/vscode/' <<<"$changed"; then
  targets+=(vscode)
fi
[[ ${#targets[@]} -gt 0 ]] || exit 0

# Git exports GIT_DIR (and on some paths GIT_INDEX_FILE) to a hook. A
# `git -C <dir>` run under them still acts on THIS repository, which is how
# the Zed grammar sync once rewrote origin, made a branch and checked it out
# here. Clear them before running anything that drives another repository.
unset $(git rev-parse --local-env-vars)

echo "post-merge: refreshing ${targets[*]} from $root"
"$root/scripts/dev-editors.sh" "${targets[@]}" ||
  echo "post-merge: some steps failed; run make dev-editors to retry" >&2
exit 0
