//# Files and directories. Every function takes a path as a `String`
//# (std::path works on them) and returns a `Result` whose error is
//# `io.Error`, which names the path it is about: `NotFound`,
//# `AlreadyExists`, `IsADirectory` and the rest. An empty path or one
//# holding a NUL byte is `InvalidPath`, and every error names the path as
//# the program passed it. A relative path is resolved against the working
//# directory, `fs.current_dir()`, which a program cannot change. Reads,
//# writes, `metadata` and `exists` follow symlinks; a path through more
//# than 40 is `Other` with code `ELOOP`.
//#
//# The functions reach the file system the running call is given. A
//# native program run by `nomi run` or built by `nomi build`, and a
//# `wasip1/wasm` module, reach the operating system's (under WASI, the
//# directories the runner opens for it). A `js/wasm` module reaches one in
//# memory, whose working directory is `/work`: empty under Go's Node
//# loader, and seeded by `run`'s `files` option in the browser
//# ([Building](/tooling/building/)). Inside `std::fs::testing.run` a call reaches a sandbox
//# in memory, so a test checks what a function reads and writes without
//# touching the disk. Tasks reach the file system of the frame they were
//# started on.
//#
//# A `Dir` is a directory a program holds: `fs.open_dir` opens one, and
//# `Dir`'s functions are these same functions, each taking a path under the
//# directory and reaching nothing outside it. Opening the `Dir` is the call
//# an effects list names `std::fs`. A library handed a `Dir` reads and
//# writes only what is under it, and its own code needs no `std::fs`
//# ([Effects lists](/tooling/projects/#effects-lists)).
//#
//# ```nomi
//# import
//#     std::fs
//#     std::io
//# end
//#
//# fn main() -> Result<Unit, io.Error>
//#     fs.write_text("notes.txt", "milk\n")?
//#     fs.write_text("notes.txt", "eggs\n", mode: .Append)?
//#     io.print(fs.read_text("notes.txt")?)
//#     Ok(Unit)
//# end
//# ```

import
    bool.Bool.{self, False, True}
    bytes.Bytes
    duration.Duration
    equatable.Equatable
    fs::host
    instant.Instant
    int.{Int, Int64, NonNegativeInt, PositiveInt}
    io.{Error, File, Reader, Writer}
    iter.Iter
    lists.List
    option.Option.{self, None, Some}
    path
    resources.Release
    results.Result.{self, Err, Ok}
    strings.String
    unit.Unit
end

/// How a write treats what is already at its path.
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"log.txt" => "a\n"}}, fn ->
//!     _ = write_text("log.txt", "b\n", mode: WriteMode.Append)
//!     write_text("log.txt", "c\n", mode: WriteMode.New)
//! end)
//!
//! assert ran.value == Err(Error.AlreadyExists{path: "log.txt"})
//! assert testing.text(ran, "/work/log.txt") == Some("a\nb\n")
//
pub enum WriteMode
    /// Create the file, or empty it when it exists, and write from the
    /// start.
    Replace
    /// Write a temporary file beside the path and rename it over the path
    /// when the write ends, so a reader sees the old contents or the new,
    /// never part of either. A write that fails leaves the old file as it
    /// was. On the disk the temporary file is synced before the rename, and
    /// the directory is not after it: a crash right after the write can
    /// leave the old contents, never part of the new. `fs.sync_dir` keeps
    /// the new.
    ReplaceAtomically
    /// Create the file when it is missing, and write at its end.
    Append
    /// Fail with `AlreadyExists` when something is at the path.
    New
end

derive Equatable for WriteMode

/// What a path names.
pub enum Kind
    File
    Directory
    Symlink
    /// A device, a socket, a pipe: something that is none of the others.
    Other
end

derive Equatable for Kind

/// One entry of a directory, from `fs.list`.
pub struct Entry
    /// The path as the caller would write it: the directory and the name
    /// joined with `/`.
    path: String
    /// The entry's own name, with no directory.
    name: String
    kind: Kind
end

derive Equatable for Entry

/// What `fs.metadata` returns about a path.
pub struct Metadata
    kind: Kind
    /// The size in bytes. A directory's is what its file system reports:
    /// 0 in memory, and often not 0 on a disk.
    size: Int
    /// When the contents last changed.
    modified: Instant
    /// The permission bits, such as `0o644`.
    mode: Int
end

derive Equatable for Metadata

/// The write mode as its crossing carries it.
fn mode_code(mode: WriteMode) -> Int64
    case mode
        WriteMode.Replace           -> 0
        WriteMode.ReplaceAtomically -> 1
        WriteMode.Append            -> 2
        WriteMode.New               -> 3
    end
end

/// The whole file at `path`, as bytes.
///
/// ```nomi
/// data = fs.read("photo.png")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{binary: {"b.bin" => String.to_bytes("ab")}}, fn -> read("b.bin"))
//! assert ran.value == Ok(String.to_bytes("ab"))
//
pub fn read(path: String) -> Result<Bytes, Error>
    Dir.read(Dir{files: host.here()}, path)
end

/// The whole file at `path`, as text. Bytes that are not UTF-8 are
/// `InvalidText`, with the offset of the first bad one. Nothing at the
/// path is `NotFound`, which a program that makes its data file on first
/// run treats as empty. A directory is `IsADirectory`.
///
/// ```nomi
/// case fs.read_text("notes.txt")
///     Ok(text)                        -> io.print(text)
///     Err(io.Error.NotFound{path: _}) -> io.print("no notes yet")
///     Err(e)                          -> io.eprint("cannot read the notes: ${e}")
/// end
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"notes.txt" => "milk"}}, fn ->
//!     [read_text("notes.txt"), read_text("todo.txt")]
//! end)
//!
//! assert ran.value == [Ok("milk"), Err(Error.NotFound{path: "todo.txt"})]
//
pub fn read_text(path: String) -> Result<String, Error>
    Dir.read_text(Dir{files: host.here()}, path)
end

/// Writes `data` to `path`. By default it replaces the file; `mode` says
/// otherwise (`WriteMode`). The directory must exist: a missing one is
/// `NotFound` naming the directory. A new file's permissions are `0o644`,
/// and an atomic write keeps the old file's.
///
/// ```nomi
/// fs.write("out.bin", data)?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{}, fn ->
//!     [write("a.bin", String.to_bytes("a")), write("missing/b.bin", String.to_bytes("b"))]
//! end)
//!
//! assert ran.value == [Ok(Unit), Err(Error.NotFound{path: "missing"})]
//! assert ran.files == {"/work/a.bin" => String.to_bytes("a")}
//
pub fn write(path: String, data: Bytes, mode: WriteMode = WriteMode.Replace) -> Result<Unit, Error>
    Dir.write(Dir{files: host.here()}, path, data, mode:)
end

/// Writes `text` to `path` as UTF-8, as `fs.write` writes bytes.
///
/// ```nomi
/// fs.write_text("log.txt", "started\n", mode: .Append)?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"out.txt" => "old"}}, fn ->
//!     write_text("out.txt", "new", mode: WriteMode.ReplaceAtomically)
//! end)
//!
//! assert ran.value == Ok(Unit)
//! assert testing.text(ran, "/work/out.txt") == Some("new")
//
pub fn write_text(
    path: String,
    text: String,
    mode: WriteMode = WriteMode.Replace,
) -> Result<Unit, Error>
    Dir.write_text(Dir{files: host.here()}, path, text, mode:)
end

/// Each line of the file at `path`, as `Reader.lines` reads them: without
/// its `\n` and a `\r` before it, and with a last line that has no newline.
/// Each run of the iterator opens the file, reads it and closes it, so it
/// can run more than once, and a consumer that stops early closes the file
/// when it stops. A failure (the file is missing, a line is not UTF-8) is
/// the last item.
///
/// ```nomi
/// names = Result.collect(fs.lines("names.txt"))?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"in.txt" => "pear\r\napple"}}, fn ->
//!     each = lines("in.txt")
//!     (Result.collect(each), Iter.first(each), Result.collect(lines("none.txt")))
//! end)
//!
//! assert ran.value == (
//!     Ok(["pear", "apple"]),
//!     Some(Ok("pear")),
//!     Err(Error.NotFound{path: "none.txt"}),
//! )
//!
//! assert ran.open == []
//
pub fn lines(path: String) -> Iter<Result<String, Error>>
    Lines{reach: fn -> Dir{files: host.here()}, path:}
end

/// The file at `path` in pieces of at most `size` bytes, as `fs.lines`
/// reads it: each run opens the file again.
///
/// ```nomi
/// pieces = fs.chunks("big.bin", size: 4096) |> Iter.count()
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "abcde"}}, fn ->
//!     chunks("a.txt", size: 2) |> Result.collect()
//! end)
//!
//! assert ran.value == Ok([String.to_bytes("ab"), String.to_bytes("cd"), String.to_bytes("e")])
//
pub fn chunks(path: String, size: PositiveInt = 65536) -> Iter<Result<Bytes, Error>>
    Chunks{reach: fn -> Dir{files: host.here()}, path:, size:}
end

/// The lines of a file, which each run opens again in the directory `reach`
/// answers then.
struct Lines
    reach: () -> Dir
    path:  String
end

impl Iter<Result<String, Error>> for Lines
    fn each_while(lines: Lines, yield: (Result<String, Error>) -> Bool) -> Bool
        case Dir.open(lines.reach(), lines.path)
            Err(e) ->
                yield(Err(e))

            Ok(r) ->
                defer Reader.close_quietly(r)
                Iter.each_while(Reader.lines(r), yield)
        end
    end
end

struct Chunks
    reach: () -> Dir
    path:  String
    size:  PositiveInt
end

impl Iter<Result<Bytes, Error>> for Chunks
    fn each_while(chunks: Chunks, yield: (Result<Bytes, Error>) -> Bool) -> Bool
        case Dir.open(chunks.reach(), chunks.path)
            Err(e) ->
                yield(Err(e))

            Ok(r) ->
                defer Reader.close_quietly(r)
                Iter.each_while(Reader.chunks(r, size: chunks.size), yield)
        end
    end
end

/// A reader over the file at `path`. Defer `Reader.close_quietly` on the
/// next line, so the file is closed however the function ends.
///
/// ```nomi
/// r = fs.open("notes.txt")?
///
/// defer Reader.close_quietly(r)
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! fn first_line(path: String) -> Result<Option<String>, Error>
//!     r = open(path)?
//!     defer Reader.close_quietly(r)
//!     Reader.read_line(r)
//! end
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "one\ntwo\n"}}, fn -> first_line("a.txt"))
//!
//! assert ran.value == Ok(Some("one"))
//! assert ran.open == []
//
pub fn open(path: String) -> Result<Reader, Error>
    Dir.open(Dir{files: host.here()}, path)
end

/// A writer over the file at `path`, which `mode` treats as `fs.write`
/// does. What is written is buffered until `Writer.flush` or
/// `Writer.close`.
///
/// Defer `Writer.discard` on the next line, and end the success path with
/// `Writer.close(w)?`, which commits the write and reports a failed close.
/// When the function leaves any other way, an `Err` or a trap, the deferred
/// discard gives the writer up. With `ReplaceAtomically` it drops the
/// temporary file, and the old file is left as it was. With any other mode
/// it closes the file, which keeps what was written to it. A discard after
/// the close does nothing.
///
/// ```nomi
/// fn save(path: String, rows: List<String>) -> Result<Unit, io.Error>
///     w = fs.create(path, mode: .ReplaceAtomically)?
///     defer Writer.discard(w)
///
///     Writer.write_lines(w, rows)?
///     Writer.close(w)?
///     Ok(Unit)
/// end
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! fn save(path: String, rows: List<String>, fail: Bool) -> Result<Unit, Error>
//!     w = create(path, mode: WriteMode.ReplaceAtomically)?
//!     defer Writer.discard(w)
//!     Writer.write_lines(w, rows)?
//!     if fail then return Err(Error.TimedOut)
//!     Writer.close(w)?
//!     Ok(Unit)
//! end
//!
//! saved = testing.run(Sandbox{files: {"out.txt" => "old\n"}}, fn ->
//!     save("out.txt", ["new"], False)
//! end)
//!
//! assert saved.value == Ok(Unit)
//! assert testing.text(saved, "/work/out.txt") == Some("new\n")
//!
//! failed = testing.run(Sandbox{files: {"out.txt" => "old\n"}}, fn ->
//!     save("out.txt", ["new"], True)
//! end)
//!
//! assert failed.value == Err(Error.TimedOut)
//! assert testing.text(failed, "/work/out.txt") == Some("old\n")
//! assert failed.open == []
//!
//! appended = testing.run(Sandbox{files: {"log.txt" => "a\n"}}, fn ->
//!     w = create("log.txt", mode: WriteMode.Append)?
//!     defer Writer.discard(w)
//!     _ = Writer.write_text(w, "b\n")
//!     Writer.discard(w)
//!     Writer.close(w)
//! end)
//!
//! assert appended.value == Err(Error.Closed)
//! assert testing.text(appended, "/work/log.txt") == Some("a\nb\n")
//! assert appended.open == []
//
pub fn create(path: String, mode = WriteMode.Replace) -> Result<Writer, Error>
    Dir.create(Dir{files: host.here()}, path, mode:)
end

/// How `fs.open_file` opens a file.
pub enum Access
    /// Reads only; a write is `PermissionDenied`. The file must exist.
    Read
    /// Reads and writes. The file must exist.
    ReadWrite
    /// Reads and writes, making the file, empty, when it is missing. An
    /// existing file keeps its contents.
    Create
end

derive Equatable for Access

/// A `File` on `path` for reads and writes at a position (`io.File`):
/// `File.read_at`, `File.write_at`, `File.seek`. A write reaches the file
/// as it is made, so there is nothing to give up: defer `File.close_quietly`
/// on the next line, and end the success path with `File.close(f)?` when a
/// failed close should be reported.
///
/// ```nomi
/// fn patch_header(db: String, header: Bytes) -> Result<Unit, io.Error>
///     f = fs.open_file(db, access: .ReadWrite)?
///     defer File.close_quietly(f)
///
///     File.write_at(f, 0, header)?
///     File.close(f)
/// end
/// ```
//! import std::fs::testing.{self, Failure, Operation, Sandbox}
//!
//! ran = testing.run(Sandbox{}, fn ->
//!     [
//!         Result.map(open_file("none.bin"), fn _ -> Unit),
//!         Result.map(open_file(".", access: Access.Create), fn _ -> Unit),
//!     ]
//! end)
//!
//! assert ran.value == [Err(Error.NotFound{path: "none.bin"}), Err(Error.IsADirectory{path: "."})]
//!
//! edited = testing.run(Sandbox{files: {"a.txt" => "abcdef"}}, fn ->
//!     f = open_file("a.txt", access: Access.ReadWrite)?
//!     defer File.close_quietly(f)
//!     head = File.read(f, max: 2)?
//!     tail = File.read_at(f, 4, max: 8)?
//!     File.write(f, String.to_bytes("XY"))?
//!     File.write_at(f, 8, String.to_bytes("!"))?
//!     at = File.position(f)?
//!     size = File.size(f)?
//!     File.seek(f, 0)?
//!     whole = File.read(f)?
//!     File.truncate(f, 3)?
//!     Ok((head, tail, at, size, whole))
//! end)
//!
//! assert edited.value == Ok(
//!     (
//!         Some(String.to_bytes("ab")),
//!         Some(String.to_bytes("ef")),
//!         4,
//!         9,
//!         Some(String.to_bytes("abXYef\u{0}\u{0}!")),
//!     )
//! )
//!
//! assert testing.text(edited, "/work/a.txt") == Some("abX")
//! assert edited.open == []
//!
//! read_only = testing.run(Sandbox{files: {"a.txt" => "a"}}, fn ->
//!     f = open_file("a.txt")?
//!     defer File.close_quietly(f)
//!     File.write(f, String.to_bytes("b"))
//! end)
//!
//! assert read_only.value == Err(Error.PermissionDenied{path: "a.txt"})
//! assert read_only.open == []
//!
//! patched = testing.run(Sandbox{files: {"db" => "v1-data"}}, fn ->
//!     f = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(f)
//!     File.write_at(f, 0, String.to_bytes("v2"))?
//!     File.close(f)
//! end)
//!
//! assert patched.value == Ok(Unit)
//! assert testing.text(patched, "/work/db") == Some("v2-data")
//! assert patched.open == []
//!
//! fn save(data: String) -> Result<Unit, Error>
//!     f = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(f)
//!     File.write_at(f, 0, String.to_bytes(data))?
//!     File.sync(f)
//! end
//!
//! saved = testing.run(Sandbox{files: {"db" => "v1"}}, fn -> save("v2"))
//!
//! assert saved.value == Ok(Unit)
//! assert testing.text(saved, "/work/db") == Some("v2")
//!
//! broken = Error.Other{operation: "sync", path: "db", code: "EIO"}
//!
//! failed = testing.run(Sandbox{
//!     files:    {"db" => "v1"},
//!     failures: [Failure{path: "db", operation: Operation.Sync, error: broken}],
//! }, fn -> save("v2"))
//!
//! assert failed.value == Err(broken)
//! assert failed.open == []
//!
//! logged = testing.run(Sandbox{files: {"log" => "a"}}, fn ->
//!     f = open_file("log", access: Access.ReadWrite)?
//!     defer File.close_quietly(f)
//!     File.write_at(f, 1, String.to_bytes("b"))?
//!     File.sync_data(f)
//! end)
//!
//! assert logged.value == Ok(Unit)
//! assert testing.text(logged, "/work/log") == Some("ab")
//! assert logged.log == ["open /work/log", "sync_data /work/log"]
//
pub fn open_file(path: String, access = Access.Read) -> Result<File, Error>
    Dir.open_file(Dir{files: host.here()}, path, access:)
end

/// How a lock on a `File` holds its bytes (`fs.lock`, `fs.try_lock`).
pub enum LockMode
    /// Any number of handles may hold a shared lock on the same bytes.
    Shared
    /// No other handle holds any lock beside an exclusive one. The file must
    /// be open to write: a file opened with `Access.Read` is
    /// `PermissionDenied`.
    Exclusive
end

derive Equatable for LockMode

/// What `fs.try_lock` found.
pub enum LockAttempt
    /// The handle holds the lock.
    Acquired
    /// Another handle holds a lock on some of the bytes that conflicts with
    /// the one asked for. Nothing changed.
    Busy
end

derive Equatable for LockAttempt

/// Takes a lock on the file `f` from `fs.open_file`: on `length` bytes from
/// `start`, or on every byte from `start` on when `length` is `None`, so the
/// whole file by default. It waits while another handle holds a lock there
/// that conflicts, and returns `Err(io.Error.TimedOut)` when `timeout`
/// passes first. An exclusive lock conflicts with every other lock, and a
/// shared lock with an exclusive one. A lock may cover bytes past the end of
/// the file.
///
/// A lock belongs to its handle. Two handles on one file exclude each other,
/// in one program or in two, and so do two tasks that each open the file;
/// tasks that share a handle share its locks. A lock is advisory: it stops
/// other locks, not reads and writes. A lock on bytes the handle already
/// holds replaces it, so a shared lock becomes exclusive once no other
/// handle holds a lock there. Closing the file releases its locks, and so
/// does the program ending. An exclusive lock on a file opened with
/// `Access.Read` is `PermissionDenied`. A task cancelled while it waits
/// stops waiting.
///
/// On Linux and macOS a lock is an open file description lock
/// (`F_OFD_SETLK`). On Windows it is `LockFileEx`'s, which differs in three
/// ways: a lock is mandatory, so another handle's read or write of bytes
/// locked exclusively fails; a handle changes a lock only by unlocking it
/// first; and `fs.unlock` names bytes exactly as they were locked. In memory
/// (the browser, a sandbox) and in a wasip1 module, where WASI has no locks,
/// the program keeps its locks itself: they exclude its own handles and
/// nothing outside it.
///
/// ```nomi
/// fs.lock(f, .Exclusive, timeout: Duration.seconds(5))?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"db" => ""}}, fn ->
//!     a = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(a)
//!     b = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(b)
//!     lock(a, LockMode.Exclusive)?
//!     waited = lock(b, LockMode.Shared, timeout: Duration.milliseconds(10))
//!     unlock(a)?
//!     Ok((waited, lock(b, LockMode.Shared)))
//! end)
//!
//! assert ran.value == Ok((Err(Error.TimedOut), Ok(Unit)))
//! assert ran.open == []
//
pub fn lock(
    f:       File,
    mode:    LockMode,
    start:   NonNegativeInt = 0,
    length:  Option<PositiveInt> = None,
    timeout: Duration = Duration.seconds(5),
) -> Result<Unit, Error>
    if host.lock(f, lock_code(mode), start, length_code(length), timeout)? then
        Ok(Unit)
    else
        Err(Error.TimedOut)
    end
end

/// Takes a lock as `fs.lock` does, without waiting: `Busy` when another
/// handle holds a lock on some of the bytes that conflicts, in this program
/// or another, and nothing changed.
///
/// ```nomi
/// case fs.try_lock(f, .Exclusive)?
///     .Acquired -> write_page(f)
///     .Busy     -> Err(Busy)
/// end
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"db" => ""}}, fn ->
//!     a = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(a)
//!     b = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(b)
//!
//!     Ok([
//!         try_lock(a, LockMode.Exclusive, length: Some(100))?,
//!         try_lock(b, LockMode.Shared)?,
//!         try_lock(b, LockMode.Exclusive, start: 100)?,
//!         try_lock(a, LockMode.Shared, start: 50, length: Some(100))?,
//!     ])
//! end)
//!
//! busy = LockAttempt.Busy
//! assert ran.value == Ok([LockAttempt.Acquired, busy, LockAttempt.Acquired, busy])
//
pub fn try_lock(
    f:      File,
    mode:   LockMode,
    start:  NonNegativeInt = 0,
    length: Option<PositiveInt> = None,
) -> Result<LockAttempt, Error>
    if host.lock(f, lock_code(mode), start, length_code(length), Duration.nanoseconds(0))? then
        Ok(LockAttempt.Acquired)
    else
        Ok(LockAttempt.Busy)
    end
end

/// Lets go of the handle's lock on `length` bytes from `start`, or on every
/// byte from `start` on when `length` is `None`: the whole file by default.
/// Bytes the handle holds no lock on are left as they are, and a lock on
/// bytes on either side of the range keeps them. On Windows the range is
/// exactly one that was locked (`fs.lock`).
///
/// ```nomi
/// fs.unlock(f)?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"db" => ""}}, fn ->
//!     a = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(a)
//!     b = open_file("db", access: Access.ReadWrite)?
//!     defer File.close_quietly(b)
//!     lock(a, LockMode.Exclusive)?
//!     unlock(a, length: Some(10))?
//!     freed = try_lock(b, LockMode.Exclusive, length: Some(10))?
//!     kept = try_lock(b, LockMode.Exclusive, start: 10)?
//!     File.close(a)?
//!     Ok((freed, kept, try_lock(b, LockMode.Exclusive, start: 10)?))
//! end)
//!
//! assert ran.value == Ok((LockAttempt.Acquired, LockAttempt.Busy, LockAttempt.Acquired))
//
pub fn unlock(
    f:      File,
    start:  NonNegativeInt = 0,
    length: Option<PositiveInt> = None,
) -> Result<Unit, Error>
    _ = host.lock(f, 0, start, length_code(length), Duration.nanoseconds(0))?
    Ok(Unit)
end

/// The lock mode as its crossing carries it: 0 unlocks.
fn lock_code(mode: LockMode) -> Int64
    case mode
        LockMode.Shared    -> 1
        LockMode.Exclusive -> 2
    end
end

/// The length as its crossing carries it: 0 is every byte from the start
/// on.
fn length_code(length: Option<PositiveInt>) -> NonNegativeInt
    case length
        Some(n) -> n
        None    -> 0
    end
end

/// Runs `body` with every std::fs call in it, and in the tasks it starts,
/// confined to the directory `dir`, as the functions of the `Dir` that
/// `fs.open_dir(dir)` opens are: a relative path is under `dir`, an
/// absolute path must be under it, and a path that leads outside it is
/// `InvalidPath` (`Dir`). Inside, `fs.current_dir()` returns `dir` made
/// absolute, and `fs.make_temp_dir` is `Unsupported{operation:
/// "fs.make_temp_dir", target: "fs.within"}`, since its directory is
/// elsewhere. A `within` inside another confines the call further. A `dir`
/// that is missing is `NotFound`, and one that is not a directory is an
/// error too (`NotADirectory` in memory).
///
/// It is how code that takes paths handles paths it was given (an
/// archive's entries, a request's file name) without reaching files it did
/// not mean to. Code of your own can take a `Dir` instead, which says in
/// its signature what it reaches.
///
/// ```nomi
/// fn extract(dest: String, entries: List<(String, Bytes)>) -> Result<Unit, io.Error>
///     fs.within(dest, fn ->
///         Iter.each(entries, fn (name, data) -> fs.write(name, data))
///         Ok(Unit)
///     end)
/// end
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"secret.txt" => "s", "site/index.html" => "<p>"}}, fn ->
//!     within("site", fn -> Ok([read_text("index.html"), read_text("../secret.txt")]))
//! end)
//!
//! escaped = Error.InvalidPath{
//!     path:   "../secret.txt",
//!     reason: "the path leads outside the directory it is confined to",
//! }
//!
//! assert ran.value == Ok([Ok("<p>"), Err(escaped)])
//
pub fn within<T>(dir: String, body: () -> Result<T, Error>) -> Result<T, Error>
    confined = Dir.subdir(Dir{files: host.here()}, dir)?
    defer Dir.close(confined)
    value = host.run_in(confined.files, body)
    value
end

/// The entries of the directory `dir`, sorted by name, so a listing is the
/// same on every file system and every run. Each `Entry`'s `path` is `dir`
/// and its `name` joined with `/`. A symlink is listed as `Symlink`
/// whatever it points to. An entry whose name is not UTF-8 fails the
/// listing with `InvalidPath`, naming the entry with U+FFFD in place of
/// each bad sequence.
///
/// ```nomi
/// entries = fs.list("photos")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"d/b.txt" => "", "d/a.txt" => ""}, dirs: ["d/sub"]}, fn ->
//!     list("d")
//! end)
//!
//! assert ran.value == Ok([
//!         Entry{path: "d/a.txt", name: "a.txt", kind: Kind.File},
//!         Entry{path: "d/b.txt", name: "b.txt", kind: Kind.File},
//!         Entry{path: "d/sub", name: "sub", kind: Kind.Directory},
//!     ])
//
pub fn list(dir: String) -> Result<List<Entry>, Error>
    Dir.list(Dir{files: host.here()}, dir)
end

/// The entries of the directory `dir` under `at`, each decoded, or why the
/// directory cannot be listed.
fn listed(at: Dir, dir: String) -> Result<List<Result<Entry, Error>>, Error>
    coded = host.list(at.files, dir)?

    Ok(
        coded
        |> Iter.map(fn entry -> decoded(dir, entry))
        |> Iter.to_list()
    )
end

/// An entry as the listing crossing writes it: its kind's letter, then its
/// name, or `!` and the name when it is not UTF-8.
fn decoded(dir: String, coded: String) -> Result<Entry, Error>
    joined =
        fn name: String ->
            if String.ends_with(dir, "/") then
                "${dir}${name}"
            else
                "${dir}/${name}"
            end
        end

    case String.strip_prefix(coded, "!")
        Some(name) ->
            Err(Error.InvalidPath{path: joined(name), reason: "the name is not UTF-8"})

        None ->
            (kind, name) =
                case (
                    String.strip_prefix(coded, "f"),
                    String.strip_prefix(coded, "d"),
                    String.strip_prefix(coded, "l"),
                )
                    (Some(name), _, _) -> (Kind.File, name)
                    (_, Some(name), _) -> (Kind.Directory, name)
                    (_, _, Some(name)) -> (Kind.Symlink, name)
                    _ -> (Kind.Other, String.strip_prefix(coded, "o") |> Option.with_default(coded))
                end

            Ok(Entry{path: joined(name), name:, kind:})
    end
end

/// Every entry under `root`, depth first: each directory's entries in
/// name order, and a directory's own entries right after it. A symlink is
/// an entry of kind `Symlink` and is not followed, so a walk never leaves
/// the tree or meets a cycle. Each run of the iterator lists the
/// directories again, as `fs.lines` reads its file again. A directory that
/// cannot be listed is an `Err` item where its entries would be, and the
/// walk goes on with the next entry; a name that is not UTF-8 is an
/// `InvalidPath` item.
///
/// ```nomi
/// sources =
///     fs.walk("src")
///     |> Iter.count_by(fn e -> Result.map(e, fn e -> e.kind == fs.Kind.File) == Ok(True))
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{
//!     files: {"d/b.txt" => "", "d/a/x.txt" => ""},
//!     links: {"d/c" => "a"},
//! }, fn ->
//!     walk("d") |> Iter.map(fn e -> Result.map(e, fn e -> e.path)) |> Iter.to_list()
//! end)
//!
//! assert ran.value == [Ok("d/a"), Ok("d/a/x.txt"), Ok("d/b.txt"), Ok("d/c")]
//!
//! assert testing.run(Sandbox{}, fn -> Result.collect(walk("none"))).value
//!     == Err(Error.NotFound{path: "none"})
//
pub fn walk(root: String) -> Iter<Result<Entry, Error>>
    Walk{reach: fn -> Dir{files: host.here()}, root:, depth: -1}
end

/// A walk that goes `depth` directories down at most, or every one when
/// `depth` is negative, in the directory `reach` answers when it runs.
struct Walk
    reach: () -> Dir
    root:  String
    depth: Int
end

impl Iter<Result<Entry, Error>> for Walk
    fn each_while(w: Walk, yield: (Result<Entry, Error>) -> Bool) -> Bool
        walk_dir(w.reach(), w.root, w.depth, yield)
    end
end

/// Hands each entry under dir to yield, as `walk` orders them, until it
/// stops.
fn walk_dir(at: Dir, dir: String, depth: Int, yield: (Result<Entry, Error>) -> Bool) -> Bool
    case listed(at, dir)
        Err(e)      -> yield(Err(e))
        Ok(entries) -> walk_entries(at, entries, depth, yield)
    end
end

fn walk_entries(
    at:      Dir,
    entries: List<Result<Entry, Error>>,
    depth:   Int,
    yield:   (Result<Entry, Error>) -> Bool,
) -> Bool
    case entries
        [] ->
            True

        [Ok(entry), ..rest] ->
            if not yield(Ok(entry)) then
                False
            else if entry.kind == Kind.Directory and depth != 0 then
                if walk_dir(at, entry.path, depth - 1, yield) then
                    walk_entries(at, rest, depth, yield)
                else
                    False
                end
            else
                walk_entries(at, rest, depth, yield)
            end

        [Err(e), ..rest] ->
            if yield(Err(e)) then walk_entries(at, rest, depth, yield) else False
    end
end

/// The paths that match `pattern`, sorted. In a name, `*` matches any run
/// of characters, `?` any one and `[abc]` one of a set; a `**` name
/// matches any number of directories, none included. A name that starts
/// with `.` matches only a pattern name that starts with `.`. This is
/// `path.matches`'s rule, applied to the paths `fs.walk` finds under the
/// longest part of the pattern with no wildcard, so a symlink matches as
/// itself and is not followed. A pattern with no `**` is matched no deeper
/// than it reaches. A pattern with no wildcard returns the path when
/// something is there. Nothing under a missing directory is `Ok([])`.
///
/// ```nomi
/// sources = fs.glob("src/**/*.nomi")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! files = {
//!     "src/main.nomi"    => "",
//!     "src/lib/a.nomi"   => "",
//!     "src/lib/a.txt"    => "",
//!     "src/.hidden.nomi" => "",
//! }
//!
//! ran = testing.run(Sandbox{files:}, fn ->
//!     [glob("src/**/*.nomi"), glob("src/*.nomi"), glob("src/lib/a.txt"), glob("none/*")]
//! end)
//!
//! assert ran.value == [
//!     Ok(["src/lib/a.nomi", "src/main.nomi"]),
//!     Ok(["src/main.nomi"]),
//!     Ok(["src/lib/a.txt"]),
//!     Ok([]),
//! ]
//
pub fn glob(pattern: String) -> Result<List<String>, Error>
    Dir.glob(Dir{files: host.here()}, pattern)
end

/// The paths under `at` that match `pattern`, as `glob` finds them.
fn globbed(at: Dir, pattern: String) -> Result<List<String>, Error>
    names = String.split(pattern, "/") |> Iter.to_list()
    (fixed, rest) = glob_split(names, [])

    base =
        case (fixed, String.starts_with(pattern, "/"))
            ([], _)      -> ""
            ([""], True) -> "/"
            _            -> String.join(fixed, "/")
        end

    case rest
        [] ->
            case Dir.exists(at, base)
                Ok(True)  -> Ok([base])
                Ok(False) -> Ok([])
                Err(e)    -> Err(e)
            end

        _ ->
            depth =
                if Iter.contains(rest, "**") then
                    -1
                else
                    Iter.count(rest) - 1
                end

            root = if base == "" then "." else base

            found = walk_matches(Walk{reach: fn -> at, root:, depth:}, base, pattern)

            case found
                Ok(paths) ->
                    Ok(Iter.sort(paths))

                Err(Error.NotFound{path: _}) when base != ""
                    and Dir.exists(at, base) == Ok(False) ->
                    Ok([])

                Err(e) ->
                    Err(e)
            end
    end
end

/// The leading names of a pattern with no wildcard, and the names from the
/// first that has one.
fn glob_split(names: List<String>, fixed: List<String>) -> (List<String>, List<String>)
    case names
        [] ->
            (fixed, [])

        [name, ..rest] ->
            if is_wild(name) then
                (fixed, names)
            else
                glob_split(rest, fixed + [name])
            end
    end
end

fn is_wild(name: String) -> Bool
    String.contains(name, "*") or String.contains(name, "?") or String.contains(name, "[")
end

/// The paths of the walk that match pattern, written as the pattern writes
/// them: under base, or bare when base is empty.
fn walk_matches(w: Walk, base: String, pattern: String) -> Result<List<String>, Error>
    w
    |> Iter.map(fn item ->
        Result.map(item, fn e ->
            if base == "" then
                String.strip_prefix(e.path, "./") |> Option.with_default(e.path)
            else
                e.path
            end
        end)
    end)
    |> Iter.filter(fn item ->
        case item
            Ok(p)  -> path.matches(pattern, p)
            Err(_) -> True
        end
    end)
    |> Result.collect()
end

/// Makes the directory `path`. Its parent must exist unless `parents` is
/// `True`, which makes every missing directory above it too and succeeds
/// when the directory is already there. Without `parents` an existing
/// directory is `AlreadyExists`, and a file at `path` is `AlreadyExists`
/// either way.
///
/// ```nomi
/// fs.create_dir("out/2026", parents: True)?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{}, fn ->
//!     [create_dir("a/b"), create_dir("a/b", parents: True), create_dir("a")]
//! end)
//!
//! assert ran.value == [
//!     Err(Error.NotFound{path: "a"}),
//!     Ok(Unit),
//!     Err(Error.AlreadyExists{path: "a"}),
//! ]
//
pub fn create_dir(path: String, parents = False) -> Result<Unit, Error>
    Dir.create_dir(Dir{files: host.here()}, path, parents:)
end

/// Removes a file, a symlink or an empty directory. A directory with
/// entries is `DirectoryNotEmpty`; `fs.remove_all` removes it and what it
/// holds.
///
/// ```nomi
/// fs.remove("old.txt")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"d/x" => ""}}, fn ->
//!     [remove("d"), remove("d/x"), remove("d"), remove("d")]
//! end)
//!
//! assert ran.value == [
//!     Err(Error.DirectoryNotEmpty{path: "d"}),
//!     Ok(Unit),
//!     Ok(Unit),
//!     Err(Error.NotFound{path: "d"}),
//! ]
//
pub fn remove(path: String) -> Result<Unit, Error>
    Dir.remove(Dir{files: host.here()}, path)
end

/// Removes `path` and everything under it, following no symlink in it.
/// Nothing at the path is `Ok`.
///
/// ```nomi
/// fs.remove_all("build")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"build/a/b.o" => "", "keep.txt" => ""}}, fn ->
//!     [remove_all("build"), remove_all("build")]
//! end)
//!
//! assert ran.value == [Ok(Unit), Ok(Unit)]
//! assert ran.files == {"/work/keep.txt" => String.to_bytes("")}
//
pub fn remove_all(path: String) -> Result<Unit, Error>
    Dir.remove_all(Dir{files: host.here()}, path)
end

/// Removes `path` and everything under it, as `fs.remove_all` does, and
/// ignores the outcome: the form for a `defer` after `fs.make_temp_dir`.
///
/// ```nomi
/// defer fs.remove_all_quietly(dir)
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"build/a.o" => ""}}, fn -> remove_all_quietly("build"))
//!
//! assert ran.files == {}
//
pub fn remove_all_quietly(path: String) -> Unit
    Dir.remove_all_quietly(Dir{files: host.here()}, path)
end

/// Moves `from` to `to`, replacing a file at `to`. A symlink at `from` is
/// moved, rather than what it points to.
///
/// ```nomi
/// fs.rename("draft.txt", "final.txt")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "a", "b.txt" => "b"}}, fn ->
//!     rename("a.txt", "b.txt")
//! end)
//!
//! assert ran.value == Ok(Unit)
//! assert ran.files == {"/work/b.txt" => String.to_bytes("a")}
//
pub fn rename(from: String, to: String) -> Result<Unit, Error>
    Dir.rename(Dir{files: host.here()}, from, to)
end

/// Waits until the entries of the directory `dir` are on the storage
/// device, so a file made, renamed or removed in it is still there, or still
/// gone, after a crash or a power cut. `File.sync` makes a file's contents
/// durable and not its name, so a program that makes a file and must keep it
/// syncs the file, then its directory. Something other than a directory is
/// `NotADirectory`. On Linux and macOS it is an `fsync` of the directory, as
/// SQLite syncs one. On macOS that hands the entries to the drive, which may
/// keep them in its own cache: unlike `File.sync`, it does not wait for that
/// cache (`F_FULLFSYNC`), which costs a few milliseconds a call, so a power
/// cut can still lose an entry the drive had not written. Windows has no
/// call that flushes a directory, so there it checks the directory and
/// returns. In memory there is nothing to make durable.
///
/// ```nomi
/// fs.rename("orders.tmp", "orders")?
///
/// fs.sync_dir(".")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"d/a.txt" => ""}}, fn ->
//!     [sync_dir("d"), sync_dir("d/a.txt"), sync_dir("none")]
//! end)
//!
//! assert ran.value == [
//!     Ok(Unit),
//!     Err(Error.NotADirectory{path: "d/a.txt"}),
//!     Err(Error.NotFound{path: "none"}),
//! ]
//!
//! assert ran.log == ["sync_dir /work/d", "sync_dir /work/d/a.txt", "sync_dir /work/none"]
//
pub fn sync_dir(dir: String) -> Result<Unit, Error>
    Dir.sync_dir(Dir{files: host.here()}, dir)
end

/// Copies the file at `from` to `to`, replacing a file at `to`. A symlink
/// at `from` is read through.
///
/// ```nomi
/// fs.copy("config.toml", "config.toml.bak")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "a"}}, fn -> copy("a.txt", "b.txt"))
//! assert ran.value == Ok(Unit)
//! assert testing.text(ran, "/work/b.txt") == Some("a")
//
pub fn copy(from: String, to: String) -> Result<Unit, Error>
    Dir.copy(Dir{files: host.here()}, from, to)
end

/// What is at `path`, following symlinks. The modification time is the
/// file system's, exactly, whatever its year.
///
/// ```nomi
/// size = (fs.metadata("big.bin")?).size
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "four"}}, fn ->
//!     m = metadata("a.txt")?
//!     Ok((m.kind, m.size))
//! end)
//!
//! assert ran.value == Ok((Kind.File, 4))
//
pub fn metadata(path: String) -> Result<Metadata, Error>
    Dir.metadata(Dir{files: host.here()}, path)
end

/// What is at `path`, a symlink described as itself rather than as what it
/// points to, which `fs.metadata` follows. A symlink's size is its
/// target's length in bytes.
///
/// ```nomi
/// is_link = (fs.link_metadata("current")?).kind == .Symlink
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => "four"}, links: {"b" => "a.txt"}}, fn ->
//!     followed = metadata("b")?
//!     link = link_metadata("b")?
//!     Ok((followed.kind, followed.size, link.kind, link.size))
//! end)
//!
//! assert ran.value == Ok((Kind.File, 4, Kind.Symlink, 5))
//
pub fn link_metadata(path: String) -> Result<Metadata, Error>
    Dir.link_metadata(Dir{files: host.here()}, path)
end

// The Metadata of a crossing's fields.
fn metadata_of(path: String, fields: List<Int>) -> Result<Metadata, Error>
    case fields
        [kind, size, modified, mode] ->
            Ok(Metadata{kind: kind_at(kind), size:, modified: Instant.from_nanos(modified), mode:})

        _ ->
            Err(Error.Other{operation: "metadata", path:, code: "EINVAL"})
    end
end

/// Makes a symlink at `path` that points to `target`, as written: a
/// relative target is resolved from the symlink's own directory when the
/// link is followed, not from the working directory. The target need not
/// exist. Something already at `path` is `AlreadyExists`.
///
/// ```nomi
/// fs.create_symlink("current", target: "releases/2026-10")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"releases/v2/app" => "v2"}}, fn ->
//!     create_symlink("current", target: "releases/v2")?
//!     Ok((read_text("current/app"), create_symlink("current", target: "x")))
//! end)
//!
//! assert ran.value == Ok((Ok("v2"), Err(Error.AlreadyExists{path: "current"})))
//
pub fn create_symlink(path: String, target: String) -> Result<Unit, Error>
    Dir.create_symlink(Dir{files: host.here()}, path, target:)
end

/// The target of the symlink at `path`, as it was written. Something that
/// is not a symlink is `Other` with the code `EINVAL`.
///
/// ```nomi
/// release = fs.read_link("current")?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => ""}, links: {"b" => "a.txt"}}, fn ->
//!     [read_link("b"), read_link("a.txt")]
//! end)
//!
//! assert ran.value == [
//!     Ok("a.txt"),
//!     Err(Error.Other{operation: "readlink", path: "a.txt", code: "EINVAL"}),
//! ]
//
pub fn read_link(path: String) -> Result<String, Error>
    Dir.read_link(Dir{files: host.here()}, path)
end

/// Sets the permission bits of what `path` names, following a symlink:
/// `0o644`, `0o755`, from 0 to `0o777`; any other mode is `Other` with the
/// code `EINVAL`. Windows keeps only the owner's write bit, so a file reads
/// back as `0o666` or `0o444`. In memory (the browser, a sandbox) the bits
/// are kept and returned by `fs.metadata`, but nothing is refused for them.
///
/// ```nomi
/// fs.set_mode("deploy.sh", 0o755)?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"run.sh" => ""}}, fn ->
//!     set_mode("run.sh", 0o755)?
//!     Ok((metadata("run.sh")?).mode)
//! end)
//!
//! assert ran.value == Ok(0o755)
//
pub fn set_mode(path: String, mode: Int) -> Result<Unit, Error>
    Dir.set_mode(Dir{files: host.here()}, path, mode)
end

fn kind_at(position: Int) -> Kind
    case position
        0 -> Kind.File
        1 -> Kind.Directory
        2 -> Kind.Symlink
        _ -> Kind.Other
    end
end

/// Whether something is at `path`. It returns a `Result` because a refusal
/// (`PermissionDenied`) is not absence: only `NotFound` is `Ok(False)`.
///
/// ```nomi
/// if fs.exists("config.toml")? then ...
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"a.txt" => ""}}, fn ->
//!     [exists("a.txt"), exists("b.txt"), exists(".")]
//! end)
//!
//! assert ran.value == [Ok(True), Ok(False), Ok(True)]
//
pub fn exists(path: String) -> Result<Bool, Error>
    Dir.exists(Dir{files: host.here()}, path)
end

/// The directory temporary files go in: the operating system's (`/tmp`,
/// or what `TMPDIR` names), or `/tmp` in memory. A wasip1 module reaches
/// only the directories its runtime preopens, so there it is the first of
/// `TMPDIR`, `/tmp` and the working directory that is preopened, and `/tmp`
/// when none is.
///
/// ```nomi
/// fs.temp_dir() // "/tmp"
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! assert testing.run(Sandbox{}, fn -> temp_dir()).value == "/tmp"
//
pub fn temp_dir() -> String
    host.temp_dir(host.here())
end

/// Makes a fresh directory under `fs.temp_dir()` and returns its path.
/// Defer `fs.remove_all_quietly` on the next line, so the directory and
/// everything in it is removed however the function ends. It is how a test
/// exercises the real file system; a named temporary file is
/// `fs.create(path.join(dir, "x"), mode: .New)` inside it. In a wasip1
/// module whose runtime preopened none of those directories it returns
/// `Err(io.Error.Unsupported{operation: "fs.make_temp_dir", target:
/// "wasip1/wasm with no preopened directory (TMPDIR, /tmp or the working
/// directory)"})`.
///
/// ```nomi
/// dir = fs.make_temp_dir()?
///
/// defer fs.remove_all_quietly(dir)
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! fn scratch() -> Result<String, Error>
//!     dir = make_temp_dir()?
//!     defer remove_all_quietly(dir)
//!     write_text("${dir}/x.txt", "x")?
//!     read_text("${dir}/x.txt")
//! end
//!
//! ran = testing.run(Sandbox{}, scratch)
//!
//! assert ran.value == Ok("x")
//! assert ran.files == {}
//
pub fn make_temp_dir() -> Result<String, Error>
    host.make_temp_dir(host.here())
end

/// The directory relative paths are resolved against: the program's
/// working directory, or the sandbox's (`/work` by default). There is no
/// way to change it, since it would change what every relative path in
/// every task means.
///
/// ```nomi
/// here = fs.current_dir()?
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! assert testing.run(Sandbox{cwd: "/home/ada"}, fn -> current_dir()).value == Ok("/home/ada")
//
pub fn current_dir() -> Result<String, Error>
    host.current_dir(host.here())
end

/// The directory at `path`, held open as a `Dir`: what a program hands to
/// code that should reach only the files under it. This is the call an
/// effects list names `std::fs`; a call through the `Dir` is named by
/// none. Defer `Dir.close` on the next line, or keep the `Dir` in the app
/// struct for the program's life. A `path` that is missing is `NotFound`,
/// and one that is not a directory is an error too (`NotADirectory` in
/// memory). Inside `fs.within` or another `Dir`'s confinement, `path` is
/// under that directory too.
///
/// ```nomi
/// fn boot(startup: Startup) -> Result<App, io.Error>
///     dir = Map.get(startup.env, "DATA_DIR") |> Option.with_default("data")
///     Ok(App{data: fs.open_dir(dir)?})
/// end
/// ```
//! import std::fs::testing.{self, Sandbox}
//!
//! ran = testing.run(Sandbox{files: {"site/index.html" => "<p>"}}, fn ->
//!     site = open_dir("site")?
//!     defer Dir.close(site)
//!     Dir.read_text(site, "index.html")
//! end)
//!
//! assert ran.value == Ok("<p>")
//!
//! assert testing.run(Sandbox{}, fn -> Result.map(open_dir("none"), Dir.close)).value
//!     == Err(Error.NotFound{path: "none"})
//
pub fn open_dir(path: String) -> Result<Dir, Error>
    Dir.subdir(Dir{files: host.here()}, path)
end

/// A directory the program holds, and the functions that reach what is
/// under it: std::fs's functions, each taking a path under the directory.
/// `fs.open_dir` opens one, `Dir.subdir` one below it, and
/// `std::fs::testing.dir` one over files in memory. A function handed a
/// `Dir` reaches only what is under it, so the `Dir` in its signature says
/// what it can touch, and an effects list names `std::fs` where a `Dir`
/// is opened from a path, never at a call through one.
///
/// A relative path is under the directory, and an absolute one must be
/// under it. A path that leads outside, by `..`, by a symlink whose target
/// is outside or absolute, or as an absolute path elsewhere, is
/// `InvalidPath` with the reason `the path leads outside the directory it
/// is confined to`, and reaches nothing. The rules are the same on the
/// disk and in memory, except for a `..` after a symlink on a Windows
/// disk: with `up` a link, Windows reads `sub/up/../a.txt` as `sub/a.txt`,
/// which is `NotFound` when missing, where macOS, Linux and memory follow
/// `up` first and refuse the path as `InvalidPath` when its `..` then leads
/// outside. Neither answer leaves the directory. On the disk the directory
/// is Go's `os.Root`: each name is opened under the one before it,
/// relative to the open directory, so a symlink swapped in while a call
/// runs cannot lead out, and a `Dir` whose directory is renamed still
/// reaches it. What is under the directory is reached whatever it is: a
/// mount point, a device file, a Linux bind mount or `/proc` entry. On
/// Windows a reserved device name (`NUL`, `COM1`) is refused, and on Unix
/// `Dir.set_mode` of a path that is changed to a symlink while it runs may
/// set the link's target's mode.
///
/// A `Dir` holds its directory open until `Dir.close`, and a call through
/// it after that is `Closed`. A `File`, `Reader` or `Writer` opened through
/// a `Dir` is an ordinary one, which outlives the `Dir`'s close.
//! import std::fs::testing.{self, Sandbox}
//!
//! data = testing.dir(Sandbox{files: {"secret.txt" => "s", "site/index.html" => "<p>"}})
//! defer Dir.close(data)
//!
//! site = Dir.subdir(data, "site")!
//! defer Dir.close(site)
//!
//! escaped =
//!     fn p: String ->
//!         Error.InvalidPath{path: p, reason: "the path leads outside the directory it is confined to"}
//!     end
//!
//! assert Dir.read_text(site, "index.html") == Ok("<p>")
//! assert Dir.read_text(site, "../secret.txt") == Err(escaped("../secret.txt"))
//! assert Dir.read_text(site, "/etc/passwd") == Err(escaped("/etc/passwd"))
//! assert Dir.write_text(site, "../x.txt", "x") == Err(escaped("../x.txt"))
//!
//! Dir.close(site)
//! assert Dir.read_text(site, "index.html") == Err(Error.Closed)
//
pub opaque struct Dir
    files: host.FileSystem
end

impl Release for Dir
    fn release(dir: Dir)
        Dir.close(dir)
    end
end

impl Dir
    /// The whole file at `path` under `dir`, as `fs.read` reads it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{binary: {"b.bin" => String.to_bytes("ab")}})
    //! defer Dir.close(d)
    //! assert Dir.read(d, "b.bin") == Ok(String.to_bytes("ab"))
    //
    pub fn read(dir: Dir, path: String) -> Result<Bytes, Error>
        host.read(dir.files, path)
    end

    /// The whole file at `path` under `dir` as text, as `fs.read_text`
    /// reads it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"notes.txt" => "milk"}})
    //! defer Dir.close(d)
    //! assert Dir.read_text(d, "notes.txt") == Ok("milk")
    //! assert Dir.read_text(d, "todo.txt") == Err(Error.NotFound{path: "todo.txt"})
    //
    pub fn read_text(dir: Dir, path: String) -> Result<String, Error>
        host.read_text(dir.files, path)
    end

    /// Writes `data` to `path` under `dir`, as `fs.write` writes it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{})
    //! defer Dir.close(d)
    //! assert Dir.write(d, "a.bin", String.to_bytes("a")) == Ok(Unit)
    //! assert Dir.read(d, "a.bin") == Ok(String.to_bytes("a"))
    //
    pub fn write(
        dir:  Dir,
        path: String,
        data: Bytes,
        mode: WriteMode = WriteMode.Replace,
    ) -> Result<Unit, Error>
        host.write(dir.files, path, data, mode_code(mode))
    end

    /// Writes `text` to `path` under `dir` as UTF-8, as `fs.write_text`
    /// writes it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"log.txt" => "a\n"}})
    //! defer Dir.close(d)
    //! assert Dir.write_text(d, "log.txt", "b\n", mode: WriteMode.Append) == Ok(Unit)
    //! assert Dir.read_text(d, "log.txt") == Ok("a\nb\n")
    //
    pub fn write_text(
        dir:  Dir,
        path: String,
        text: String,
        mode: WriteMode = WriteMode.Replace,
    ) -> Result<Unit, Error>
        host.write(dir.files, path, String.to_bytes(text), mode_code(mode))
    end

    /// Each line of the file at `path` under `dir`, as `fs.lines` reads
    /// them: each run of the iterator opens the file again.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"in.txt" => "pear\r\napple"}})
    //! defer Dir.close(d)
    //! assert Result.collect(Dir.lines(d, "in.txt")) == Ok(["pear", "apple"])
    //
    pub fn lines(dir: Dir, path: String) -> Iter<Result<String, Error>>
        Lines{reach: fn -> dir, path:}
    end

    /// The file at `path` under `dir` in pieces of at most `size` bytes, as
    /// `fs.chunks` reads it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "abcde"}})
    //! defer Dir.close(d)
    //!
    //! assert Result.collect(Dir.chunks(d, "a.txt", size: 2))
    //!     == Ok([String.to_bytes("ab"), String.to_bytes("cd"), String.to_bytes("e")])
    //
    pub fn chunks(dir: Dir, path: String, size: PositiveInt = 65536) -> Iter<Result<Bytes, Error>>
        Chunks{reach: fn -> dir, path:, size:}
    end

    /// A reader over the file at `path` under `dir`, as `fs.open` opens it.
    /// Defer `Reader.close_quietly` on the next line.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "one\ntwo\n"}})
    //! defer Dir.close(d)
    //!
    //! fn first_line(d: Dir) -> Result<Option<String>, Error>
    //!     r = Dir.open(d, "a.txt")?
    //!     defer Reader.close_quietly(r)
    //!     Reader.read_line(r)
    //! end
    //!
    //! assert first_line(d) == Ok(Some("one"))
    //
    pub fn open(dir: Dir, path: String) -> Result<Reader, Error>
        host.open(dir.files, path)
    end

    /// A writer over the file at `path` under `dir`, as `fs.create` makes
    /// it. Defer `Writer.discard` on the next line, and end the success path
    /// with `Writer.close(w)?`.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{})
    //! defer Dir.close(d)
    //!
    //! fn save(d: Dir, rows: List<String>) -> Result<Unit, Error>
    //!     w = Dir.create(d, "out.txt", mode: WriteMode.ReplaceAtomically)?
    //!     defer Writer.discard(w)
    //!     Writer.write_lines(w, rows)?
    //!     Writer.close(w)?
    //!     Ok(Unit)
    //! end
    //!
    //! assert save(d, ["new"]) == Ok(Unit)
    //! assert Dir.read_text(d, "out.txt") == Ok("new\n")
    //
    pub fn create(dir: Dir, path: String, mode = WriteMode.Replace) -> Result<Writer, Error>
        host.create(dir.files, path, mode_code(mode))
    end

    /// A `File` on `path` under `dir` for reads and writes at a position,
    /// as `fs.open_file` opens it. It is an ordinary `File`: it syncs, locks
    /// and reads at a position as any other does.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"db" => "v1-data"}})
    //! defer Dir.close(d)
    //!
    //! fn patch(d: Dir) -> Result<Unit, Error>
    //!     f = Dir.open_file(d, "db", access: Access.ReadWrite)?
    //!     defer File.close_quietly(f)
    //!     lock(f, LockMode.Exclusive)?
    //!     File.write_at(f, 0, String.to_bytes("v2"))?
    //!     File.sync(f)?
    //!     File.close(f)
    //! end
    //!
    //! assert patch(d) == Ok(Unit)
    //! assert Dir.read_text(d, "db") == Ok("v2-data")
    //
    pub fn open_file(dir: Dir, path: String, access = Access.Read) -> Result<File, Error>
        code: Int64 =
            case access
                Access.Read      -> 0
                Access.ReadWrite -> 1
                Access.Create    -> 2
            end

        host.open_file(dir.files, path, code)
    end

    /// The entries of the directory `path` under `dir`, as `fs.list` lists
    /// them: each `Entry`'s `path` is `path` and its name joined with `/`.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"b.txt" => "", "a.txt" => ""}})
    //! defer Dir.close(d)
    //!
    //! assert Result.map(Dir.list(d, "."), fn es -> Iter.map(es, fn e -> e.name) |> Iter.to_list())
    //!     == Ok(["a.txt", "b.txt"])
    //
    pub fn list(dir: Dir, path: String) -> Result<List<Entry>, Error>
        listed(dir, path) |> Result.flat_map(fn entries -> Result.collect(entries))
    end

    /// Every entry under `root` under `dir`, depth first, as `fs.walk`
    /// finds them.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"d/b.txt" => "", "d/a/x.txt" => ""}})
    //! defer Dir.close(d)
    //!
    //! assert Dir.walk(d, "d") |> Iter.map(fn e -> Result.map(e, fn e -> e.path)) |> Iter.to_list() == [
    //!     Ok("d/a"),
    //!     Ok("d/a/x.txt"),
    //!     Ok("d/b.txt"),
    //! ]
    //
    pub fn walk(dir: Dir, root: String) -> Iter<Result<Entry, Error>>
        Walk{reach: fn -> dir, root:, depth: -1}
    end

    /// The paths under `dir` that match `pattern`, sorted, as `fs.glob`
    /// matches them.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"src/main.nomi" => "", "src/lib/a.nomi" => "", "a.txt" => ""}})
    //! defer Dir.close(d)
    //! assert Dir.glob(d, "src/**/*.nomi") == Ok(["src/lib/a.nomi", "src/main.nomi"])
    //
    pub fn glob(dir: Dir, pattern: String) -> Result<List<String>, Error>
        globbed(dir, pattern)
    end

    /// Makes the directory `path` under `dir`, as `fs.create_dir` makes it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{})
    //! defer Dir.close(d)
    //! assert Dir.create_dir(d, "a/b") == Err(Error.NotFound{path: "a"})
    //! assert Dir.create_dir(d, "a/b", parents: True) == Ok(Unit)
    //
    pub fn create_dir(dir: Dir, path: String, parents = False) -> Result<Unit, Error>
        host.create_dir(dir.files, path, parents)
    end

    /// Removes a file, a symlink or an empty directory under `dir`, as
    /// `fs.remove` does.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"old.txt" => ""}})
    //! defer Dir.close(d)
    //! assert Dir.remove(d, "old.txt") == Ok(Unit)
    //! assert Dir.remove(d, "old.txt") == Err(Error.NotFound{path: "old.txt"})
    //
    pub fn remove(dir: Dir, path: String) -> Result<Unit, Error>
        host.remove(dir.files, path)
    end

    /// Removes `path` under `dir` and everything under it, as
    /// `fs.remove_all` does.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"build/a/b.o" => ""}})
    //! defer Dir.close(d)
    //! assert Dir.remove_all(d, "build") == Ok(Unit)
    //! assert Dir.exists(d, "build") == Ok(False)
    //
    pub fn remove_all(dir: Dir, path: String) -> Result<Unit, Error>
        host.remove_all(dir.files, path)
    end

    /// Removes `path` under `dir` and everything under it, and ignores the
    /// outcome: the form for a `defer` after `Dir.make_temp_dir`.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"build/a.o" => ""}})
    //! defer Dir.close(d)
    //! Dir.remove_all_quietly(d, "build")
    //! assert Dir.exists(d, "build") == Ok(False)
    //
    pub fn remove_all_quietly(dir: Dir, path: String) -> Unit
        _ = host.remove_all(dir.files, path)
    end

    /// Moves `from` to `to`, both under `dir`, as `fs.rename` moves it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"draft.txt" => "a"}})
    //! defer Dir.close(d)
    //! assert Dir.rename(d, "draft.txt", "final.txt") == Ok(Unit)
    //! assert Dir.read_text(d, "final.txt") == Ok("a")
    //
    pub fn rename(dir: Dir, from: String, to: String) -> Result<Unit, Error>
        host.rename(dir.files, from, to)
    end

    /// Waits until the entries of the directory `path` under `dir` are on
    /// the storage device, as `fs.sync_dir` does. `"."` is `dir` itself.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => ""}})
    //! defer Dir.close(d)
    //! assert Dir.sync_dir(d, ".") == Ok(Unit)
    //! assert Dir.sync_dir(d, "a.txt") == Err(Error.NotADirectory{path: "a.txt"})
    //
    pub fn sync_dir(dir: Dir, path: String) -> Result<Unit, Error>
        host.sync_dir(dir.files, path)
    end

    /// Copies the file at `from` to `to`, both under `dir`, as `fs.copy`
    /// copies it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "a"}})
    //! defer Dir.close(d)
    //! assert Dir.copy(d, "a.txt", "b.txt") == Ok(Unit)
    //! assert Dir.read_text(d, "b.txt") == Ok("a")
    //
    pub fn copy(dir: Dir, from: String, to: String) -> Result<Unit, Error>
        host.copy(dir.files, from, to)
    end

    /// What is at `path` under `dir`, following symlinks, as `fs.metadata`
    /// answers it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "four"}})
    //! defer Dir.close(d)
    //! assert Result.map(Dir.metadata(d, "a.txt"), fn m -> (m.kind, m.size)) == Ok((Kind.File, 4))
    //
    pub fn metadata(dir: Dir, path: String) -> Result<Metadata, Error>
        fields = host.metadata(dir.files, path)?
        metadata_of(path, fields)
    end

    /// What is at `path` under `dir`, a symlink described as itself, as
    /// `fs.link_metadata` answers it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "four"}, links: {"b" => "a.txt"}})
    //! defer Dir.close(d)
    //! assert Result.map(Dir.link_metadata(d, "b"), fn m -> m.kind) == Ok(Kind.Symlink)
    //
    pub fn link_metadata(dir: Dir, path: String) -> Result<Metadata, Error>
        fields = host.link_metadata(dir.files, path)?
        metadata_of(path, fields)
    end

    /// Makes a symlink at `path` under `dir` that points to `target`, as
    /// written, as `fs.create_symlink` makes it. The link may point
    /// anywhere; following it through a `Dir` reaches only what is under
    /// the `Dir`.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"releases/v2/app" => "v2"}})
    //! defer Dir.close(d)
    //! assert Dir.create_symlink(d, "current", target: "releases/v2") == Ok(Unit)
    //! assert Dir.read_text(d, "current/app") == Ok("v2")
    //
    pub fn create_symlink(dir: Dir, path: String, target: String) -> Result<Unit, Error>
        host.create_symlink(dir.files, path, target)
    end

    /// The target of the symlink at `path` under `dir`, as it was written.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => ""}, links: {"b" => "a.txt"}})
    //! defer Dir.close(d)
    //! assert Dir.read_link(d, "b") == Ok("a.txt")
    //
    pub fn read_link(dir: Dir, path: String) -> Result<String, Error>
        host.read_link(dir.files, path)
    end

    /// Sets the permission bits of what `path` under `dir` names, as
    /// `fs.set_mode` sets them.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"run.sh" => ""}})
    //! defer Dir.close(d)
    //! assert Dir.set_mode(d, "run.sh", 0o755) == Ok(Unit)
    //! assert Result.map(Dir.metadata(d, "run.sh"), fn m -> m.mode) == Ok(0o755)
    //
    pub fn set_mode(dir: Dir, path: String, mode: Int) -> Result<Unit, Error>
        host.set_mode(dir.files, path, mode)
    end

    /// Whether something is at `path` under `dir`, as `fs.exists` answers.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => ""}})
    //! defer Dir.close(d)
    //! assert [Dir.exists(d, "a.txt"), Dir.exists(d, "b.txt")] == [Ok(True), Ok(False)]
    //
    pub fn exists(dir: Dir, path: String) -> Result<Bool, Error>
        case host.metadata(dir.files, path)
            Ok(_)                        -> Ok(True)
            Err(Error.NotFound{path: _}) -> Ok(False)
            Err(e)                       -> Err(e)
        end
    end

    /// Makes a fresh directory in `dir` and returns its name, `nomi-` and
    /// 16 hexadecimal digits: no other caller holds it. Defer
    /// `Dir.remove_all_quietly` on the next line. `Dir.subdir` opens it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{})
    //! defer Dir.close(d)
    //!
    //! fn scratch(d: Dir) -> Result<String, Error>
    //!     name = Dir.make_temp_dir(d)?
    //!     defer Dir.remove_all_quietly(d, name)
    //!     Dir.write_text(d, "${name}/x.txt", "x")?
    //!     Dir.read_text(d, "${name}/x.txt")
    //! end
    //!
    //! assert scratch(d) == Ok("x")
    //! assert Result.map(Dir.list(d, "."), List.length) == Ok(0)
    //
    pub fn make_temp_dir(dir: Dir) -> Result<String, Error>
        host.make_temp(dir.files, True)
    end

    /// Makes a fresh empty file in `dir` and returns its name, as
    /// `Dir.make_temp_dir` names a directory. `Dir.open_file` with
    /// `Access.ReadWrite` opens it, and `Dir.remove` removes it.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{})
    //! defer Dir.close(d)
    //!
    //! fn spill(d: Dir) -> Result<Int, Error>
    //!     name = Dir.make_temp_file(d)?
    //!     f = Dir.open_file(d, name, access: Access.ReadWrite)?
    //!     defer File.close_quietly(f)
    //!     File.write(f, String.to_bytes("rows"))?
    //!     size = File.size(f)?
    //!     File.close(f)?
    //!     Dir.remove(d, name)?
    //!     Ok(size)
    //! end
    //!
    //! assert spill(d) == Ok(4)
    //
    pub fn make_temp_file(dir: Dir) -> Result<String, Error>
        host.make_temp(dir.files, False)
    end

    /// The directory `path` under `dir`, held open as a `Dir` of its own,
    /// which reaches only what is under it. Defer `Dir.close` on the next
    /// line; the two close apart.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a/b.txt" => "b"}})
    //! defer Dir.close(d)
    //!
    //! a = Dir.subdir(d, "a")!
    //! defer Dir.close(a)
    //!
    //! assert Dir.read_text(a, "b.txt") == Ok("b")
    //! assert Result.map(Dir.subdir(d, "none"), Dir.close) == Err(Error.NotFound{path: "none"})
    //
    pub fn subdir(dir: Dir, path: String) -> Result<Dir, Error>
        Ok(Dir{files: host.within(dir.files, path)?})
    end

    /// Lets go of the directory. A call through the `Dir` after is
    /// `Closed`, and a second close does nothing. A `File`, `Reader` or
    /// `Writer` it opened stays open.
    //! import std::fs::testing.{self, Sandbox}
    //!
    //! d = testing.dir(Sandbox{files: {"a.txt" => "a"}})
    //! defer Dir.close(d)
    //!
    //! Dir.close(d)
    //! assert Dir.read_text(d, "a.txt") == Err(Error.Closed)
    //
    pub fn close(dir: Dir) -> Unit
        host.release(dir.files)
    end
end
