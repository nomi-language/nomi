import {
    add.Add
    bool.Bool.{self, False, True}
    bytes.Byte
    code_points.Codepoint
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    debug.Debug
    decimal.Decimal
    discrete.Discrete
    display.Display
    divide.Divide
    equatable.Equatable
    float.Float
    hashable.Hashable
    lists.List
    locale.Locale
    localize.NumberParseError
    maybe.Maybe.{self, None, Some}
    multiply.Multiply
    productable.Productable
    results.Result.{self, Err, Ok}
    steppable.Steppable
    strings.String
    subtract.Subtract
    summable.Summable
}

//# Operations on the 64-bit signed `Int` type: total division gated on the
//# refinement types `NonZeroInt`/`PositiveInt`, floored division and modulo, powers, integer
//# square roots, `gcd`/`lcm`, digits in a base, conversion to `Float`,
//# wrapping (modular) arithmetic, bit operations, and the `Int` limits. The
//# arithmetic, `Display`/`Debug`/`Equatable`/`Hashable`/`Comparable` impls give `Int` its
//# string form, hashing, and total order.

/// 64-bit signed integer.
pub host type Int

impl Int {
    /// The greatest value of the 64-bit `Int`.
    //! assert Int.max_value == 9223372036854775807
    //
    pub once max_value = 9223372036854775807

    /// The most negative value of the 64-bit `Int`. `min_value` is unrepresentable
    /// as a literal (a bare literal parses its magnitude, which overflows), so
    /// reach for these constants instead of writing the number.
    //! assert Int.min_value == Int.wrapping_add(Int.max_value, 1)
    //
    pub once min_value = Int.wrapping_add(Int.max_value, 1)

    /// Validates that `n` is non-zero and wraps it. Returns None when n == 0.
    //! assert Int.to_non_zero(5) == Some(NonZeroInt(5))
    //! assert Int.to_non_zero(-3) == Some(NonZeroInt(-3))
    //! assert Int.to_non_zero(0) == None
    //
    pub fn to_non_zero(n: Int) -> Maybe<NonZeroInt> {
        if n == 0 { None } else { Some(NonZeroInt(n)) }
    }

    /// Validates that `n` is positive (> 0) and wraps it. Returns None for
    /// zero or negative values.
    //! assert Int.to_positive(5) == Some(PositiveInt(5))
    //! assert Int.to_positive(0) == None
    //! assert Int.to_positive(-3) == None
    //
    pub fn to_positive(n: Int) -> Maybe<PositiveInt> {
        if n > 0 { Some(PositiveInt(n)) } else { None }
    }

    /// Converts an Int to a Float. Total — every Int64 maps to a Float64.
    /// Precision loss is possible for |x| > 2^53 (Float64 has a 52-bit mantissa);
    /// the result is the nearest representable Float.
    //! assert Int.to_float(5) == 5.0
    //! assert Int.to_float(-7) == -7.0
    //
    pub host fn to_float(x: Int) -> Float

    /// Converts an Int to a Decimal exactly, at scale 0. Total.
    //! assert Int.to_decimal(42) == 42d
    //! assert Int.to_decimal(-7) == -7d
    //
    pub host fn to_decimal(n: Int) -> Decimal

    /// Converts an Int to a Byte when it is in range 0..255.
    //! b = try Int.to_byte(65)
    //! assert Byte.to_int(b) == 65
    //! assert Int.to_byte(-1) == None
    //! assert Int.to_byte(256) == None
    //
    pub host fn to_byte(n: Int) -> Maybe<Byte>

    /// Converts an Int to a Codepoint when it is a Unicode scalar value:
    /// `0` through `0x10FFFF`, outside the UTF-16 surrogate block
    /// `0xD800` through `0xDFFF`.
    //! assert Int.to_codepoint(65) == Some('A')
    //! assert Int.to_codepoint(55_296) == None
    //! assert Int.to_codepoint(1_114_112) == None
    //
    pub host fn to_codepoint(n: Int) -> Maybe<Codepoint>

    /// Wrapping (modular, two's-complement) addition. Unlike `+`, which traps on
    /// overflow, this silently wraps — for hashing, checksums, and any algorithm
    /// that deliberately wants modular arithmetic.
    //! assert Int.wrapping_add(9223372036854775807, 1) == Int.min_value
    //
    pub host fn wrapping_add(a: Int, b: Int) -> Int

    /// Wrapping (modular, two's-complement) subtraction. See `Int.wrapping_add`.
    //! assert Int.wrapping_sub(Int.min_value, 1) == Int.max_value
    //
    pub host fn wrapping_sub(a: Int, b: Int) -> Int

    /// Wrapping (modular, two's-complement) multiplication. See `Int.wrapping_add`.
    //! assert Int.wrapping_mul(9223372036854775807, 2) == -2
    //
    pub host fn wrapping_mul(a: Int, b: Int) -> Int

    /// Bitwise AND of two Ints. Nomi has no bitwise operators; these functions are
    /// the surface, as in Gleam (`int.bitwise_*`) and Elm (`Bitwise.*`).
    //! assert Int.bitwise_and(12, 10) == 8
    //! assert Int.bitwise_or(12, 10) == 14
    //! assert Int.bitwise_xor(12, 10) == 6
    //! assert Int.bitwise_not(0) == -1
    //
    pub host fn bitwise_and(a: Int, b: Int) -> Int

    /// See `Int.bitwise_and`.
    //! assert Int.bitwise_or(12, 10) == 14
    //
    pub host fn bitwise_or(a: Int, b: Int) -> Int

    /// See `Int.bitwise_and`.
    //! assert Int.bitwise_xor(12, 10) == 6
    //
    pub host fn bitwise_xor(a: Int, b: Int) -> Int

    /// Bitwise NOT (one's complement) of one Int. See `Int.bitwise_and`.
    //! assert Int.bitwise_not(0) == -1
    //
    pub host fn bitwise_not(a: Int) -> Int

    /// Left shift `a` by `n` bit positions. `n` must be non-negative (a negative
    /// count is a runtime error); a count >= 64 shifts every bit out, yielding 0.
    //! assert Int.shift_left(1, 4) == 16
    //
    pub host fn shift_left(a: Int, n: Int) -> Int

    /// Arithmetic (sign-extending) right shift of `a` by `n` bit positions. `n`
    /// must be non-negative; a count >= 64 yields 0 for non-negative `a` and -1
    /// for negative `a`.
    //! assert Int.shift_right(-8, 1) == -4
    //
    pub host fn shift_right(a: Int, n: Int) -> Int

    /// Floored modulo: the result is zero or has the sign of the divisor `y`,
    /// as Python's `%`, Elixir's `Integer.mod/2` and Gleam's `int.modulo`
    /// answer, so it wraps a value into a range: `Int.modulo(-1, 1440)` is
    /// `1439`. `x % y` differs for operands of opposite signs: it is the
    /// remainder, takes the sign of the dividend `x`, and matches `/`
    /// (`-1 % 1440` is `-1`). `Int.modulo(x, y)` is `x - y * Int.floor_div(x, y)`.
    /// A zero `y` traps with the division-by-zero error `%` gives, and
    /// `Int.modulo(Int.min_value, -1)` is `0`.
    //! assert Int.modulo(7, 3) == 1
    //! assert Int.modulo(-7, 3) == 2
    //! assert Int.modulo(7, -3) == -2
    //! assert Int.modulo(-7, -3) == -1
    //! assert Int.modulo(-1, 1440) == 1439
    //! assert -1 % 1440 == -1
    //
    pub fn modulo(x: Int, y: Int) -> Int {
        r = x % y

        if r != 0 and (r < 0) != (y < 0) {
            r + y
        } else {
            r
        }
    }

    /// Floored division: `x / y` rounded toward negative infinity, as
    /// Python's `//`, Elixir's `Integer.floor_div/2` and Gleam's
    /// `int.floor_divide` answer. It is the partner of `Int.modulo`:
    /// `x == y * Int.floor_div(x, y) + Int.modulo(x, y)` for every `x` and
    /// non-zero `y`. `x / y` differs for operands of opposite signs: it
    /// truncates toward zero (`-7 / 2` is `-3`). A zero `y` traps with the
    /// division-by-zero error `/` gives, and `Int.floor_div(Int.min_value, -1)`
    /// traps with the integer overflow `Int.min_value / -1` gives.
    //! assert Int.floor_div(7, 2) == 3
    //! assert Int.floor_div(-7, 2) == -4
    //! assert Int.floor_div(7, -2) == -4
    //! assert Int.floor_div(-7, -2) == 3
    //! assert -7 / 2 == -3
    //! assert 2 * Int.floor_div(-7, 2) + Int.modulo(-7, 2) == -7
    //
    pub fn floor_div(x: Int, y: Int) -> Int {
        q = x / y

        if x % y != 0 and (x < 0) != (y < 0) {
            q - 1
        } else {
            q
        }
    }

    /// Returns |n|. `Int.abs(Int.min_value)` traps with the integer overflow
    /// `-Int.min_value` gives: its magnitude is one past `Int.max_value`.
    //! assert Int.abs(-5) == 5
    //! assert Int.abs(0) == 0
    //! assert Int.abs(Int.min_value + 1) == Int.max_value
    //
    pub fn abs(n: Int) -> Int {
        if n < 0 { -n } else { n }
    }

    /// Returns the sign of `n` as -1, 0, or +1.
    //! assert Int.sign(-7) == -1
    //! assert Int.sign(0) == 0
    //! assert Int.sign(7) == 1
    //
    pub fn sign(n: Int) -> Int {
        case {
            n < 0 -> -1
            n > 0 -> 1
            _ -> 0
        }
    }

    /// Returns the lesser of `a` and `b` (ties return `a`).
    //! assert Int.min(3, -2) == -2
    //! assert Int.min(Int.min_value, Int.max_value) == Int.min_value
    //
    pub fn min(a: Int, b: Int) -> Int {
        if a <= b { a } else { b }
    }

    /// Returns the greater of `a` and `b` (ties return `a`).
    //! assert Int.max(3, -2) == 3
    //! assert Int.max(Int.min_value, Int.max_value) == Int.max_value
    //
    pub fn max(a: Int, b: Int) -> Int {
        if a >= b { a } else { b }
    }

    /// `n` multiplied by itself `exp` times; `Int.pow(n, 0)` is `1` for every
    /// `n`, `0` included. A power past the Int range traps with an integer
    /// overflow, as `*` does, and a negative `exp` traps: its answer is a
    /// fraction, which is `Float.pow`'s.
    //! assert Int.pow(2, 10) == 1024
    //! assert Int.pow(-3, 3) == -27
    //! assert Int.pow(0, 0) == 1
    //! assert Int.pow(-2, 63) == Int.min_value
    //
    pub host fn pow(n: Int, exp: Int) -> Int

    /// The integer square root of `n`: the greatest Int whose square is at
    /// most `n`, so the root rounded down. A negative `n` traps, as a
    /// negative `exp` does in `Int.pow`; check the sign first when it comes
    /// from data.
    //! assert Int.sqrt(16) == 4
    //! assert Int.sqrt(15) == 3
    //! assert Int.sqrt(0) == 0
    //! assert Int.sqrt(Int.max_value) == 3037000499
    //
    pub host fn sqrt(n: Int) -> Int

    /// The greatest common divisor of `a` and `b`: the largest Int that
    /// divides both, never negative whatever their signs. `Int.gcd(n, 0)` is
    /// `Int.abs(n)` and `Int.gcd(0, 0)` is `0`. The one answer past the Int
    /// range, 2^63 from `Int.gcd(Int.min_value, 0)`, traps with an integer
    /// overflow.
    //! assert Int.gcd(12, 18) == 6
    //! assert Int.gcd(-12, 18) == 6
    //! assert Int.gcd(7, 0) == 7
    //! assert Int.gcd(0, 0) == 0
    //
    pub host fn gcd(a: Int, b: Int) -> Int

    /// The least common multiple of `a` and `b`: the smallest non-negative
    /// Int both divide, and `0` when either is `0`. A multiple past the Int
    /// range traps with an integer overflow.
    //! assert Int.lcm(4, 6) == 12
    //! assert Int.lcm(-4, 6) == 12
    //! assert Int.lcm(5, 0) == 0
    //
    pub host fn lcm(a: Int, b: Int) -> Int

    /// The digits of `n` in `base`, most significant first: `[1, 2, 3]` for
    /// `123`, and `[0]` for `0`. The digits are of a non-negative Int, so a
    /// negative `n` traps; `Int.abs` it first when its sign does not
    /// matter. A `base` below 2 traps. `Int.from_digits` reads them back.
    //! assert Int.to_digits(123) == [1, 2, 3]
    //! assert Int.to_digits(0) == [0]
    //! assert Int.to_digits(10, 2) == [1, 0, 1, 0]
    //! assert Int.to_digits(255, 16) == [15, 15]
    //
    pub fn to_digits(n: Int, base: Int = 10) -> List<Int> {
        int_to_digits(n, base)
    }

    /// The Int whose digits in `base`, most significant first, are `digits`,
    /// as `Int.to_digits` writes them, and `Some(0)` for no digits. `None`
    /// when a digit is outside `0` to `base - 1`, or the number is past the
    /// Int range, as `String.to_int` answers for text that is no Int. A
    /// `base` below 2 traps.
    //! assert Int.from_digits([1, 2, 3]) == Some(123)
    //! assert Int.from_digits([1, 0, 1, 0], 2) == Some(10)
    //! assert Int.from_digits([]) == Some(0)
    //! assert Int.from_digits([1, 2], 2) == None
    //! assert Int.from_digits([-1]) == None
    //! assert Int.from_digits(Int.to_digits(Int.max_value)) == Some(Int.max_value)
    //! assert Int.from_digits([9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9]) == None
    //
    pub fn from_digits(digits: List<Int>, base: Int = 10) -> Maybe<Int> {
        int_from_digits(digits, base)
    }

    /// `n` as a reader of `locale` writes it: the locale's digits, minus
    /// sign and group separator, grouped as the locale groups (`hi` writes
    /// lakhs). `grouping: False` leaves the separators out, and `min_digits`
    /// pads with zeros to at least that many digits (1 to 100). `Display`
    /// stays `1234567` everywhere.
    //! assert Int.format(1234567, Locale`en`) == "1,234,567"
    //! assert Int.format(1234567, Locale`de`) == "1.234.567"
    //! assert Int.format(1234567, Locale`pl`) == "1\u{a0}234\u{a0}567"
    //! assert Int.format(1234567, Locale`hi`) == "12,34,567"
    //! assert Int.format(1234567, Locale`ar-EG`) == "١٬٢٣٤٬٥٦٧"
    //! assert Int.format(1234567, Locale`ar-EG-u-nu-latn`) == "1,234,567"
    //! assert Int.format(1234567, Locale`en`, False) == "1234567"
    //! assert Int.format(7, Locale`en`, True, 3) == "007"
    //
    pub fn format(n: Int, locale: Locale, grouping: Bool = True, min_digits: Int = 1) -> String {
        int_format(locale, n, grouping, min_digits)
    }

    /// Read text a reader of `locale` wrote as an `Int`. Strict by default:
    /// the text must be what `Int.format` writes, except that the group
    /// separators may be left out, any space stands for the locale's space,
    /// and ASCII digits for the locale's digits. `lenient: True` also takes
    /// separators anywhere, surrounding space, `+`, `(12)` and `12-`.
    //! assert Int.parse_in("1.234.567", Locale`de`) == Ok(1234567)
    //! assert Int.parse_in("12,34,567", Locale`hi`) == Ok(1234567)
    //! assert Int.parse_in("1,234", Locale`de`) == Err(#NumberParseError.Unexpected{at: 1, text: ","})
    //! assert Int.parse_in("12,34,567", Locale`en`) == Err(#NumberParseError.Grouping{at: 2})
    //! assert Int.parse_in(" 12,34,567 ", Locale`en`, True) == Ok(1234567)
    //! assert Int.parse_in("", Locale`en`) == Err(NumberParseError.Empty)
    //
    pub fn parse_in(
        text: String,
        locale: Locale,
        lenient: Bool = False,
    ) -> Result<Int, NumberParseError> {
        int_parse_in(text, locale, lenient)
    }
}

host fn int_to_digits(n: Int, base: Int) -> List<Int>

host fn int_from_digits(digits: List<Int>, base: Int) -> Maybe<Int>

host fn int_format(locale: Locale, n: Int, grouping: Bool, min_digits: Int) -> String

host fn int_parse_in(text: String, locale: Locale, lenient: Bool) -> Result<Int, NumberParseError>

impl Display for Int {
    /// Returns the canonical decimal string form of `n`, matching the runtime
    /// stringifier used by `io.print` and string interpolation.
    //! assert Int.to_string(42) == "42"
    //! assert Int.to_string(-7) == "-7"
    //
    host fn to_string(n: Int) -> String
}

impl Add<Int, Int> for Int {
    host fn add(lhs: Int, rhs: Int) -> Int
}

impl Summable for Int {
    /// The sum of no Ints: `0`.
    //! assert Int.empty_sum() == 0
    //! assert 7 + Int.empty_sum() == 7
    //
    fn empty_sum() -> Int {
        0
    }
}

impl Subtract<Int, Int> for Int {
    host fn subtract(lhs: Int, rhs: Int) -> Int
}

impl Multiply<Int, Int> for Int {
    host fn multiply(lhs: Int, rhs: Int) -> Int
}

impl Productable for Int {
    /// The product of no Ints: `1`.
    //! assert Int.empty_product() == 1
    //! assert 7 * Int.empty_product() == 7
    //
    fn empty_product() -> Int {
        1
    }
}

impl Divide<Int, Int> for Int {
    host fn divide(lhs: Int, rhs: Int) -> Int
}

impl Divide<NonZeroInt, Int> for Int {
    /// Integer division. Total — the type system rules out a zero divisor at
    /// the call site by requiring `rhs: NonZeroInt`. Rounds toward zero
    /// (matches the `/` operator). Callers who have an unvalidated Int use
    /// `Int.to_non_zero` first; the fallibility moves to the validation step,
    /// where it belongs.
    //! nz = try Int.to_non_zero(3)
    //! assert Int.divide(10, nz) == 3
    //
    fn divide(lhs: Int, rhs: NonZeroInt) -> Int {
        NonZeroInt(n) = rhs
        lhs / n
    }
}

impl Debug for Int {
    fn inspect(n: Int) -> String {
        to_string(n)
    }
}

impl Equatable for Int {
    fn equal?(a: Int, b: Int) -> Bool {
        a == b
    }
}

impl Hashable for Int {
    fn hash(n: Int) -> Int {
        n
    }
}

impl Comparable for Int {
    fn compare(a: Int, b: Int) -> Ordering {
        case {
            a < b -> Less
            a == b -> Equal
            _ -> Greater
        }
    }
}

impl Discrete for Int {
    fn next(n: Int) -> Maybe<Int> {
        if n == Int.max_value {
            None
        } else {
            Some(n + 1)
        }
    }

    fn steps_between(start: Int, end: Int) -> Maybe<Int> {
        if start > end {
            Some(0)
        } else {
            Some(end - start)
        }
    }
}

impl Steppable for Int {
    fn step_by(n: Int, by: Int) -> Maybe<Int> {
        if by > 0 and n > Int.max_value - by {
            None
        } else if by < 0 and n < Int.min_value - by {
            None
        } else {
            Some(n + by)
        }
    }
}

/// An Int proven to be non-zero. The smart constructor `Int.to_non_zero` is
/// the only way to obtain a value; once you have one, `Int.divide` by it
/// cannot fail.
pub opaque type NonZeroInt Int

derive Debug for NonZeroInt
derive Display for NonZeroInt

/// An Int proven to be positive (> 0). Smart constructor: `Int.to_positive`.
/// Implies non-zero, so a `PositiveInt` can be passed wherever a
/// `NonZeroInt` is expected via `PositiveInt.to_non_zero`.
pub opaque type PositiveInt Int

impl PositiveInt {
    /// Widens a `PositiveInt` to a `NonZeroInt` — every positive Int is non-zero,
    /// so this is total (never fails). Lets a `PositiveInt` flow into a position
    /// that requires `NonZeroInt`, such as `Int.divide`'s divisor.
    //! p = try Int.to_positive(5)
    //! NonZeroInt(n) = PositiveInt.to_non_zero(p)
    //! assert n == 5
    //
    pub fn to_non_zero(p: PositiveInt) -> NonZeroInt {
        PositiveInt(n) = p
        NonZeroInt(n)
    }
}

derive Debug for PositiveInt
derive Display for PositiveInt
