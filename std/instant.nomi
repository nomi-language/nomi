import {
    add.Add
    bool.Bool
    duration.Duration
    int.Int
    subtract.Subtract
}

/// Opaque absolute point in time. Backed by Unix epoch nanoseconds.
/// Use `Instant.to_seconds` / `Instant.from_seconds` for the raw
/// seconds-grained representation (sufficient for whole-second
/// timestamps). Exact arithmetic uses `+` and `-` with a `Duration`, `-`
/// between two Instants (the `Duration` from the right to the left),
/// `Instant.between`, and `Instant.before?`.
pub opaque type Instant Int

impl Instant {
    /// Read the current wall clock as an Instant. Single canonical
    /// "current time" function — there is no `Int`-returning variant.
    /// Use `Instant.to_seconds(Instant.now())` if you need a
    /// seconds-grained representation.
    pub host fn now(): Instant

    /// Construct an Instant from whole seconds since the Unix epoch.
    //! assert Instant.to_seconds(Instant.from_seconds(42)) == 42
    //
    pub fn from_seconds(n: Int): Instant {
        Instant(n * 1_000_000_000)
    }

    /// Extract whole seconds since the Unix epoch from an Instant. Inverse
    /// of `Instant.from_seconds`; sub-second precision is truncated.
    //! assert Instant.to_seconds(Instant.from_seconds(42)) == 42
    //
    pub fn to_seconds(Instant(nanos)): Int {
        nanos / 1_000_000_000
    }

    /// Construct an Instant from whole nanoseconds since the Unix epoch.
    ///
    /// The nanosecond-grained counterpart of `Instant.from_seconds`, and the
    /// pair `Duration` has carried since it was written
    /// (`Duration.nanoseconds` / `Duration.as_nanos`). `Instant.now` reads the
    /// clock at nanosecond precision, so a seconds-only round trip is lossy for
    /// values a program actually holds.
    //! assert Instant.as_nanos(Instant.from_nanos(1_500_000_042)) == 1_500_000_042
    //
    pub fn from_nanos(n: Int): Instant {
        Instant(n)
    }

    /// Whole nanoseconds since the Unix epoch. Exact — nothing is truncated,
    /// unlike `Instant.to_seconds`.
    //! assert Instant.as_nanos(Instant.from_seconds(42)) == 42_000_000_000
    //
    pub fn as_nanos(Instant(nanos)): Int {
        nanos
    }

    /// The Duration between two Instants (later minus earlier).
    //! assert Instant.between(Instant.from_seconds(10), Instant.from_seconds(15)) == Duration.seconds(5)
    //
    pub fn between(Instant(earlier), Instant(later)): Duration {
        Duration.nanoseconds(later - earlier)
    }

    /// Compare: is `a` strictly before `b`?
    //! assert Instant.before?(Instant.from_seconds(10), Instant.from_seconds(15))
    //! refute Instant.before?(Instant.from_seconds(15), Instant.from_seconds(10))
    //
    pub fn before?(Instant(a), Instant(b)): Bool {
        a < b
    }
}

impl Add<Duration, Instant> for Instant {
    /// Add a Duration to an Instant, returning a new Instant.
    //! assert Instant.from_seconds(10) + Duration.seconds(5) == Instant.from_seconds(15)
    //
    fn add(Instant(nanos), rhs: Duration): Instant {
        Instant(nanos + Duration.as_nanos(rhs))
    }
}

impl Subtract<Duration, Instant> for Instant {
    /// Move an Instant back by a Duration, returning a new Instant.
    //! assert Instant.from_seconds(15) - Duration.seconds(5) == Instant.from_seconds(10)
    //
    fn subtract(Instant(nanos), rhs: Duration): Instant {
        Instant(nanos - Duration.as_nanos(rhs))
    }
}

impl Subtract<Instant, Duration> for Instant {
    /// `a - b` is the Duration from `b` to `a`: `Instant.between(b, a)`. It is
    /// negative when `a` is before `b`.
    //! assert Instant.from_seconds(15) - Instant.from_seconds(10) == Duration.seconds(5)
    //! assert Instant.from_seconds(10) - Instant.from_seconds(15) == Duration.seconds(-5)
    //
    fn subtract(lhs: Instant, rhs: Instant): Duration {
        Instant.between(rhs, lhs)
    }
}
