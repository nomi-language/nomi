//# Points in time. An `Instant` is a moment on the wall clock, the count a
//# Unix timestamp gives, and `Instant.now` reads it. A `Monotonic` is a
//# reading of a clock that only moves forward, for measuring how long
//# something took: `Monotonic.elapsed(started)` is right even when the wall
//# clock is set while the work runs, which `Instant.now() - started` is
//# not.
//#
//# ```nomi
//# started = Monotonic.now()
//#
//# run_batch()
//#
//# took = Monotonic.elapsed(started)
//# ```

import
    add.Add
    bool.Bool
    comparable.Comparable
    debug.Debug
    duration.Duration
    equatable.Equatable
    int.Int
    strings.String
    subtract.Subtract
end

/// A point in time: a count of nanoseconds from the Unix epoch, 1970-01-01
/// 00:00:00 UTC. `Instant.now` reads the clock. `Instant.from_seconds` and
/// `Instant.from_nanos` make an Instant from a count, and
/// `Instant.to_seconds` and `Instant.as_nanos` read the count back.
///
/// `+` and `-` move an Instant by a `Duration`, and `-` between two
/// Instants is the `Duration` from the right one to the left one.
/// `Instant.is_before` compares two, and `==` tells whether they are the
/// same nanosecond.
///
/// The count is an `Int` of any size, as a `Duration`'s is, so every one
/// of these functions returns for every value and none can fail. Timers
/// and timestamps count in a signed 64-bit number of nanoseconds, the
/// years 1677 to 2262. A std function that passes an Instant to one says
/// what one outside those years means: a deadline past 2262 never comes, and
/// a timestamp written out is clamped to the nearest end or refused.
//! start = Instant.from_seconds(1_700_000_000)
//! later = start + Duration.minutes(90)
//!
//! assert later - start == Duration.minutes(90)
//! assert Instant.is_before(start, later)
//! assert Instant.to_seconds(later) == 1_700_005_400
//
pub opaque type Instant Int

impl Instant
    /// The time now, read from the system clock at nanosecond precision.
    /// `Instant.to_seconds(Instant.now())` is the Unix timestamp in whole
    /// seconds. The system clock can be set back, so a later call may
    /// return an earlier Instant. To measure how long something took, use
    /// `Monotonic.now` and `Monotonic.elapsed`, which no setting of the
    /// clock moves.
    pub host fn now() -> Instant

    /// The Instant `n` whole seconds after the Unix epoch, before it for a
    /// negative `n`.
    //! assert Instant.to_seconds(Instant.from_seconds(42)) == 42
    //! assert Instant.to_seconds(Instant.from_seconds(10_000_000_000)) == 10_000_000_000
    //
    pub fn from_seconds(n: Int) -> Instant
        Instant(n * 1_000_000_000)
    end

    /// The whole seconds from the Unix epoch to the Instant, the count
    /// `Instant.from_seconds` takes. A part of a second is dropped, toward
    /// the epoch: half a second before the epoch is second 0.
    //! assert Instant.to_seconds(Instant.from_seconds(42)) == 42
    //! assert Instant.to_seconds(Instant.from_nanos(1_999_999_999)) == 1
    //! assert Instant.to_seconds(Instant.from_nanos(-500_000_000)) == 0
    //
    pub fn to_seconds(Instant(nanos)) -> Int
        nanos / 1_000_000_000
    end

    /// The Instant `n` nanoseconds after the Unix epoch, before it for a
    /// negative `n`. `Instant.as_nanos` reads the count back, so the pair
    /// stores an Instant with nothing lost; `Instant.to_seconds` drops the
    /// part of a second that `Instant.now` reads.
    //! assert Instant.as_nanos(Instant.from_nanos(1_500_000_042)) == 1_500_000_042
    //!
    //! assert Instant.as_nanos(Instant.from_nanos(-9_223_372_036_854_775_809))
    //!     == -9_223_372_036_854_775_809
    //
    pub fn from_nanos(n: Int) -> Instant
        Instant(n)
    end

    /// The nanoseconds from the Unix epoch to the Instant, negative for one
    /// before it: the count `Instant.from_nanos` takes. Nothing is dropped,
    /// where `Instant.to_seconds` drops the part of a second.
    //! assert Instant.as_nanos(Instant.from_seconds(42)) == 42_000_000_000
    //
    pub fn as_nanos(Instant(nanos)) -> Int
        nanos
    end

    /// The Duration from `earlier` to `later`, which is `later - earlier`.
    /// It is negative when `later` is the earlier of the two.
    //! assert Instant.between(Instant.from_seconds(10), Instant.from_seconds(15)) == Duration.seconds(5)
    //! assert Instant.between(Instant.from_seconds(15), Instant.from_seconds(10)) == Duration.seconds(-5)
    //
    pub fn between(Instant(earlier), Instant(later)) -> Duration
        Duration.nanoseconds(later - earlier)
    end

    /// Whether `a` is earlier than `b`. Two equal Instants are not before
    /// each other.
    //! assert Instant.is_before(Instant.from_seconds(10), Instant.from_seconds(15))
    //! refute Instant.is_before(Instant.from_seconds(15), Instant.from_seconds(10))
    //! refute Instant.is_before(Instant.from_seconds(10), Instant.from_seconds(10))
    //
    pub fn is_before(Instant(a), Instant(b)) -> Bool
        a < b
    end
end

derive Equatable for Instant

impl Add<Duration, Instant> for Instant
    /// `instant + duration`: the Instant that long after `instant`, or
    /// before it for a negative Duration. An Instant has no largest value,
    /// so the sum always exists.
    //! assert Instant.from_seconds(10) + Duration.seconds(5) == Instant.from_seconds(15)
    //! assert Instant.to_seconds(Instant.from_seconds(0) + Duration.hours(3_000_000)) == 10_800_000_000
    //
    fn add(Instant(nanos), rhs: Duration) -> Instant
        Instant(nanos + Duration.as_nanos(rhs))
    end
end

impl Subtract<Duration, Instant> for Instant
    /// `instant - duration`: the Instant that long before `instant`.
    //! assert Instant.from_seconds(15) - Duration.seconds(5) == Instant.from_seconds(10)
    //
    fn subtract(Instant(nanos), rhs: Duration) -> Instant
        Instant(nanos - Duration.as_nanos(rhs))
    end
end

impl Subtract<Instant, Duration> for Instant
    /// `a - b`: the Duration from `b` to `a`, which is
    /// `Instant.between(b, a)`. It is negative when `a` is before `b`.
    //! assert Instant.from_seconds(15) - Instant.from_seconds(10) == Duration.seconds(5)
    //! assert Instant.from_seconds(10) - Instant.from_seconds(15) == Duration.seconds(-5)
    //!
    //! earliest = Instant.from_nanos(-9_223_372_036_854_775_808)
    //! latest = Instant.from_nanos(9_223_372_036_854_775_807)
    //! assert Duration.as_hours(latest - earliest) == 5_124_095
    //
    fn subtract(lhs: Instant, rhs: Instant) -> Duration
        Instant.between(rhs, lhs)
    end
end

/// A reading of the monotonic clock: a clock that only moves forward, at
/// the rate of real time, and that setting the wall clock does not move.
/// It is the clock to measure elapsed time with, for a timeout, a rate
/// limit or a benchmark. `Monotonic.now` reads it, and
/// `Monotonic.elapsed` is the `Duration` since an earlier reading.
///
/// A reading counts from a point the process chose when it started, so it
/// means nothing outside the process, and it is no date: there is no way
/// to make an `Instant` from one or one from an `Instant`, and no
/// `Display`. Its `Debug` shows the time since that point
/// (`Monotonic(+1m30s)`). Two readings compare with `<` and `==`, and `+`
/// and `-` move one by a `Duration`, for a deadline:
///
/// ```nomi
/// deadline = Monotonic.now() + Duration.seconds(5)
///
/// if Monotonic.now() >= deadline then give_up()
/// ```
///
/// In a test under `clock Clock.Virtual`, the clock is the test's virtual
/// one: after `timer.sleep(Duration.seconds(5))`, `Monotonic.elapsed` of a
/// reading taken before it is exactly five seconds.
//! started = Monotonic.now()
//! later = Monotonic.now()
//!
//! assert started <= later
//! assert Monotonic.elapsed(started) >= Duration.seconds(0)
//! assert Monotonic.between(started, later) == later - started
//
pub opaque type Monotonic Int

impl Monotonic
    /// The monotonic clock now. A later call never returns an earlier
    /// reading.
    pub host fn now() -> Monotonic

    /// The Duration from `since` to now: `Monotonic.now() - since`. It is
    /// zero or more for a reading this process took earlier.
    //! started = Monotonic.now()
    //! assert Monotonic.elapsed(started) >= Duration.seconds(0)
    //
    pub fn elapsed(since: Monotonic) -> Duration
        Monotonic.between(since, Monotonic.now())
    end

    /// The Duration from `earlier` to `later`, which is `later - earlier`.
    /// It is negative when `later` is the earlier of the two.
    //! start = Monotonic.now()
    //! later = start + Duration.seconds(5)
    //!
    //! assert Monotonic.between(start, later) == Duration.seconds(5)
    //! assert Monotonic.between(later, start) == Duration.seconds(-5)
    //
    pub fn between(Monotonic(earlier), Monotonic(later)) -> Duration
        Duration.nanoseconds(later - earlier)
    end
end

derive Equatable for Monotonic
derive Comparable for Monotonic

impl Debug for Monotonic
    /// `Monotonic(+<duration>)`: the time since the point the process
    /// counts its readings from, in `Duration`'s form, and no date.
    //! assert Monotonic.inspect(Monotonic(90_000_000_000)) == "Monotonic(+1m30s)"
    //! assert Monotonic.inspect(Monotonic(-5_000_000_000)) == "Monotonic(-5s)"
    //
    fn inspect(Monotonic(nanos)) -> String
        sign = if nanos < 0 then "" else "+"
        "Monotonic(${sign}${Duration.nanoseconds(nanos)})"
    end
end

impl Add<Duration, Monotonic> for Monotonic
    /// `reading + duration`: the reading that long after `reading`, or
    /// before it for a negative Duration.
    //! start = Monotonic.now()
    //! assert (start + Duration.seconds(5)) - start == Duration.seconds(5)
    //
    fn add(Monotonic(nanos), rhs: Duration) -> Monotonic
        Monotonic(nanos + Duration.as_nanos(rhs))
    end
end

impl Subtract<Duration, Monotonic> for Monotonic
    /// `reading - duration`: the reading that long before `reading`.
    //! start = Monotonic.now()
    //! assert start - (start - Duration.seconds(5)) == Duration.seconds(5)
    //
    fn subtract(Monotonic(nanos), rhs: Duration) -> Monotonic
        Monotonic(nanos - Duration.as_nanos(rhs))
    end
end

impl Subtract<Monotonic, Duration> for Monotonic
    /// `a - b`: the Duration from `b` to `a`, which is
    /// `Monotonic.between(b, a)`. It is negative when `a` is before `b`.
    //! start = Monotonic.now()
    //! assert (start + Duration.seconds(2)) - start == Duration.seconds(2)
    //
    fn subtract(lhs: Monotonic, rhs: Monotonic) -> Duration
        Monotonic.between(rhs, lhs)
    end
end
