//# An HTTP client and server. A `Request` is a value; `http.fetch`
//# sends it with the ambient client and reads the whole response, and
//# `http.stream` returns a `StreamedResponse`, its body still arriving,
//# for `defer StreamedResponse.close(response)` to close. A status is never
//# an error: a 404 is a `Response` whose `status` a program checks with
//# `Status.is_success`.
//#
//# ```nomi
//# response = http.get(Url`https://api.example.com/users`)?
//#
//# if Status.is_success(response.status) then dbg Response.text(response)?
//# ```
//#
//# Every request runs under the context in force: its deadline bounds the
//# request, and cancelling the task cancels it. `http_testing.run` serves
//# requests with a function instead of the network, in tests and in the
//# tour. A `Client` made with `Client.new` holds its own options and
//# connection pool.
//#
//# A server never reads more of a request's body than a limit allows.
//# `Request.form` and `post_form` read at most 10 MB of a URL-encoded body
//# (Go's `ParseForm` limit), and `multipart_form` and `form_file` at most
//# 32 MB of a multipart one; they stop one byte past the limit and return
//# `Error.BodyTooLarge`. A limit on the request replaces both defaults, up
//# or down: `Request.limit_body` or the `http.limit_body` middleware for a
//# route, and the `Server`'s `max_body` for every request. Limits on one
//# request only lower each other, so a route cannot pass the server's.
//# `Request.text` and `json_as` read a body whole under the same limit as a
//# URL-encoded form. `Body.read_all` and `Body.reader` read what the stream
//# holds, stopped only by such a limit.
//#
//# ## Middleware
//#
//# A middleware takes a handler first and returns a handler, so a stack
//# of them reads as a pipe, each stage wrapping the ones before it:
//# `Router.handler(router) |> http.limit_body(1_000_000)`. `wrap_routes`
//# wraps only a group of routes, such as every `/admin` route.

import
    base64
    bool.Bool.{self, False, True}
    bytes.Bytes
    channels.{Channel, Receiver, Sender}
    code_points.Codepoint
    context.Context
    display.Display
    duration.Duration
    embed.Files
    equatable.Equatable
    fs
    hashable.Hashable
    html.Html
    http_host
    instant.Instant
    int.Int
    io
    io.{Reader, Writer}
    iter.Iter
    json.{FromJson, Json, ToJson}
    lists.List
    literals.{CheckedLiteral, Fragment, Literal, LiteralError}
    log.{self, Logger}
    maps.Map
    maybe.Maybe.{self, None, Some}
    net
    parse.{self, ParseFields}
    path
    resources.Release
    results.Infallible
    results.Result.{self, Err, Ok}
    strings.String
    supervisors.Supervisor
    tasks.Task
    tls
    unit.Unit
    url.{self, Query, Url}
    uuid.Uuid
end

/// A request method. `Other` holds any method Go sends as written.
pub enum Method
    Get
    Head
    Post
    Put
    Patch
    Delete
    Connect
    Options
    Trace
    Other String
end

derive Equatable for Method
derive Hashable for Method

impl Method
    /// The method as it is written on the wire: `GET`, or `Other`'s text.
    //! import std::http.Method
    //!
    //! assert Method.text(Method.Patch) == "PATCH"
    //! assert Method.text(Method.Other("PURGE")) == "PURGE"
    //
    pub fn text(method: Method) -> String
        case method
            .Get -> "GET"
            .Head -> "HEAD"
            .Post -> "POST"
            .Put -> "PUT"
            .Patch -> "PATCH"
            .Delete -> "DELETE"
            .Connect -> "CONNECT"
            .Options -> "OPTIONS"
            .Trace -> "TRACE"
            .Other(text) -> text
        end
    end

    /// The method `text` names, `Other` for one Go has no constant for.
    //! import std::http.Method
    //!
    //! assert Method.parse("DELETE") == Method.Delete
    //! assert Method.parse("PURGE") == Method.Other("PURGE")
    //
    pub fn parse(text: String) -> Method
        case text
            "GET" -> Method.Get
            "HEAD" -> Method.Head
            "POST" -> Method.Post
            "PUT" -> Method.Put
            "PATCH" -> Method.Patch
            "DELETE" -> Method.Delete
            "CONNECT" -> Method.Connect
            "OPTIONS" -> Method.Options
            "TRACE" -> Method.Trace
            other -> Method.Other(other)
        end
    end
end

impl Display for Method
    fn to_string(method: Method) -> String
        Method.text(method)
    end
end

/// An HTTP status code. Any code from 100 to 999 is a `Status`; the
/// constants name the ones Go names.
pub type Status Int

derive Equatable for Status
derive Hashable for Status

impl Status
    pub once continue_status = Status(100)
    pub once switching_protocols = Status(101)
    pub once processing = Status(102)
    pub once early_hints = Status(103)
    pub once ok = Status(200)
    pub once created = Status(201)
    pub once accepted = Status(202)
    pub once non_authoritative_info = Status(203)
    pub once no_content = Status(204)
    pub once reset_content = Status(205)
    pub once partial_content = Status(206)
    pub once multi_status = Status(207)
    pub once already_reported = Status(208)
    pub once im_used = Status(226)
    pub once multiple_choices = Status(300)
    pub once moved_permanently = Status(301)
    pub once found = Status(302)
    pub once see_other = Status(303)
    pub once not_modified = Status(304)
    pub once use_proxy = Status(305)
    pub once temporary_redirect = Status(307)
    pub once permanent_redirect = Status(308)
    pub once bad_request = Status(400)
    pub once unauthorized = Status(401)
    pub once payment_required = Status(402)
    pub once forbidden = Status(403)
    pub once not_found = Status(404)
    pub once method_not_allowed = Status(405)
    pub once not_acceptable = Status(406)
    pub once proxy_auth_required = Status(407)
    pub once request_timeout = Status(408)
    pub once conflict = Status(409)
    pub once gone = Status(410)
    pub once length_required = Status(411)
    pub once precondition_failed = Status(412)
    pub once request_entity_too_large = Status(413)
    pub once request_uri_too_long = Status(414)
    pub once unsupported_media_type = Status(415)
    pub once requested_range_not_satisfiable = Status(416)
    pub once expectation_failed = Status(417)
    pub once teapot = Status(418)
    pub once misdirected_request = Status(421)
    pub once unprocessable_entity = Status(422)
    pub once locked = Status(423)
    pub once failed_dependency = Status(424)
    pub once too_early = Status(425)
    pub once upgrade_required = Status(426)
    pub once precondition_required = Status(428)
    pub once too_many_requests = Status(429)
    pub once request_header_fields_too_large = Status(431)
    pub once unavailable_for_legal_reasons = Status(451)
    pub once internal_server_error = Status(500)
    pub once not_implemented = Status(501)
    pub once bad_gateway = Status(502)
    pub once service_unavailable = Status(503)
    pub once gateway_timeout = Status(504)
    pub once http_version_not_supported = Status(505)
    pub once variant_also_negotiates = Status(506)
    pub once insufficient_storage = Status(507)
    pub once loop_detected = Status(508)
    pub once not_extended = Status(510)
    pub once network_authentication_required = Status(511)

    /// The status with `code`, or an `Err` outside 100 to 999.
    //! import std::http.Status
    //!
    //! assert Status.from_code(404) == Ok(Status.not_found)
    //! assert Status.from_code(42) |> Result.is_err()
    //
    pub fn from_code(code: Int) -> Result<Status, Error>
        if code < 100 or code > 999 then
            return Err(Error.InvalidRequest{reason: "status code ${code} is not in 100 to 999"})
        end

        Ok(Status(code))
    end

    /// The status's number.
    pub fn code(status: Status) -> Int
        Status(code) = status
        code
    end

    /// The reason phrase registered for the status, "Not Found" for 404, or
    /// "" for a code that has none.
    //! import std::http.Status
    //!
    //! assert Status.text(Status.not_found) == "Not Found"
    //! assert Status.text(Status(599)) == ""
    //
    pub fn text(status: Status) -> String
        http_host.status_text(Status.code(status))
    end

    /// The status line's code and text: "404 Not Found".
    //! import std::http.Status
    //!
    //! assert Status.line(Status.teapot) == "418 I'm a teapot"
    //
    pub fn line(status: Status) -> String
        case Status.text(status)
            "" -> "${Status.code(status)}"
            text -> "${Status.code(status)} ${text}"
        end
    end

    /// 1xx.
    pub fn is_informational(status: Status) -> Bool
        Status.code(status) / 100 == 1
    end

    /// 2xx.
    //! import std::http.Status
    //!
    //! assert Status.is_success(Status.no_content)
    //! assert not Status.is_success(Status.found)
    //
    pub fn is_success(status: Status) -> Bool
        Status.code(status) / 100 == 2
    end

    /// 3xx.
    pub fn is_redirect(status: Status) -> Bool
        Status.code(status) / 100 == 3
    end

    /// 4xx.
    pub fn is_client_error(status: Status) -> Bool
        Status.code(status) / 100 == 4
    end

    /// 5xx.
    pub fn is_server_error(status: Status) -> Bool
        Status.code(status) / 100 == 5
    end
end

impl Display for Status
    /// The status line's code and text, as `Status.line`.
    fn to_string(status: Status) -> String
        Status.line(status)
    end
end

/// Header fields in order. A name may appear more than once, and names
/// compare without case.
pub type Headers List<(String, String)>

derive Equatable for Headers

impl Headers
    /// `name` as HTTP writes header names, each word capitalized:
    /// `content-type` is `Content-Type`. A name that holds a space or other
    /// character a header name cannot is returned as it is.
    //! import std::http.Headers
    //!
    //! assert Headers.canonical_key("x-request-id") == "X-Request-Id"
    //
    pub fn canonical_key(name: String) -> String
        http_host.canonical_key(name)
    end

    /// The first value of `name`.
    //! import std::http.Headers
    //!
    //! h = Headers[("Accept", "text/html"), ("accept", "*/*")]
    //! assert Headers.get(h, "ACCEPT") == Some("text/html")
    //! assert Headers.values(h, "accept") == ["text/html", "*/*"]
    //
    pub fn get(headers: Headers, name: String) -> Maybe<String>
        Headers.values(headers, name) |> List.head()
    end

    /// Every value of `name`, in order.
    pub fn values(headers: Headers, name: String) -> List<String>
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        fields
        |> Iter.filter(fn (k, _) -> Headers.canonical_key(k) == key)
        |> Iter.map(fn (_, v) -> v)
        |> Iter.to_list()
    end

    /// Whether `name` has a value.
    pub fn has(headers: Headers, name: String) -> Bool
        Headers.values(headers, name) != []
    end

    /// The fields with `name`'s values replaced by `value`, in the place of
    /// its first value, or added at the end.
    //! import std::http.Headers
    //!
    //! h = Headers[("A", "1"), ("B", "2"), ("a", "3")]
    //! assert Headers.set(h, "a", "9") == Headers[("A", "9"), ("B", "2")]
    //
    pub fn set(headers: Headers, name: String, value: String) -> Headers
        if not Headers.has(headers, name) then return Headers.add(headers, name, value)
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        (_, kept) = Iter.map_reduce(fields, False, fn seen, (k, v) ->
            if Headers.canonical_key(k) != key then return (seen, [(k, v)])

            if seen then (True, []) else (True, [(k, value)])
        end)

        Headers(
            kept
            |> Iter.flat_map(fn p -> p)
            |> Iter.to_list()
        )
    end

    /// The fields with `value` added to `name`'s, at the end.
    pub fn add(headers: Headers, name: String, value: String) -> Headers
        Headers(fields) = headers
        Headers(fields + [(name, value)])
    end

    /// The fields without `name`.
    pub fn remove(headers: Headers, name: String) -> Headers
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        Headers(
            fields
            |> Iter.filter(fn (k, _) -> Headers.canonical_key(k) != key)
            |> Iter.to_list()
        )
    end

    /// Writes the headers in wire format, `Name: value` lines each ending
    /// in CRLF, sorted by name, leaving out the names in `except`. A line
    /// break in a value is written as a space and the value is trimmed, so
    /// no value can add a line. It writes as Go's `Header.WriteSubset`.
    //! import std::http.Headers
    //! import std::io.Writer
    //!
    //! (_, written) = Writer.collect(fn w -> Headers.write_to(Headers[("b", "2"), ("A", "1")], w))
    //! assert Bytes.to_string(written) == Ok("A: 1\r\nB: 2\r\n")
    //!
    //! (_, folded) = Writer.collect(fn w -> Headers.write_to(Headers[("X", " a\r\nb ")], w))
    //! assert Bytes.to_string(folded) == Ok("X: a  b\r\n")
    //
    pub fn write_to(
        headers: Headers,
        w: io.Writer,
        except: List<String> = [],
    ) -> Result<Unit, io.Error>
        io.Writer.write_text(w, http_host.headers_wire(flat(headers), except))
    end
end

/// A request's or response's body.
pub enum Body
    Empty
    /// Sent with `Content-Type: text/plain; charset=utf-8` unless the
    /// request sets one.
    Text String
    Bytes Bytes
    /// Encoded with `Json.encode`; sent with `Content-Type:
    /// application/json` unless the request sets one.
    Json Json
    /// Rendered markup; sent with `Content-Type: text/html;
    /// charset=utf-8` unless the request or response sets one.
    Html Html
    /// URL-encoded; sent with `Content-Type:
    /// application/x-www-form-urlencoded` unless the request sets one.
    Form Query
    /// A `multipart/form-data` form; sent with its `Content-Type` and
    /// boundary unless the request sets one.
    Multipart List<FormPart>
    /// A stream, read once: a request's body as a server receives it.
    Stream Reader
    /// A response body a function writes as the client reads it, for
    /// streaming and server-sent events: what it writes is sent each time
    /// the writer passes bytes on, at `Writer.flush` or when its buffer
    /// fills. A server's response only; a request refuses it.
    Produce (io.Writer) -> Result<Unit, io.Error>
end

impl Body
    /// A `Reader` over the body.
    pub fn reader(body: Body) -> Reader
        case body
            .Stream(r) -> r
            other -> Reader.from_bytes(Body.bytes_of(other))
        end
    end

    /// The whole body, a stream read to its end. It has no default limit:
    /// a request's body is held whole in memory unless `limit_body` or the
    /// server's `max_body` limits it. `Request.form` and `multipart_form`
    /// read with a default limit.
    //! import std::http.Body
    //!
    //! assert Body.read_all(Body.Text("hi")) == Ok(String.to_bytes("hi"))
    //
    pub fn read_all(body: Body) -> Result<Bytes, Error>
        case body
            .Stream(r) -> Reader.read_all(r) |> Result.map_err(fn e -> Error.Body{error: e})
            other -> Ok(Body.bytes_of(other))
        end
    end

    fn bytes_of(body: Body) -> Bytes
        case body
            .Empty -> String.to_bytes("")
            .Text(text) -> String.to_bytes(text)
            .Bytes(data) -> data
            .Json(value) -> String.to_bytes(Json.encode(value))
            .Html(page) -> String.to_bytes(Html.to_string(page))
            .Form(query) -> String.to_bytes(Query.encode(query))
            .Multipart(parts) -> FormPart.encode(parts).body
            .Stream(_) -> String.to_bytes("")
            .Produce(_) -> String.to_bytes("")
        end
    end
end

/// One part of a `Body.Multipart` form.
pub enum FormPart
    /// A field and its value: Go's `Writer.WriteField`.
    Field {name: String, value: String}
    /// A file: Go's `Writer.CreateFormFile`, with a content type.
    File {
        field: String,
        filename: String,
        content_type: String = "application/octet-stream",
        content: Bytes,
    }
    /// A part with headers of its own: Go's `Writer.CreatePart`.
    Raw {headers: Headers, content: Bytes}
end

impl FormPart
    /// `parts` as a multipart body, and the `Content-Type` that names its
    /// boundary. The boundary is a digest of the parts, so the same parts
    /// always encode to the same bytes.
    //! import std::http.FormPart
    //!
    //! encoded = FormPart.encode([FormPart.Field{name: "a", value: "1"}])
    //! assert String.starts_with(encoded.content_type, "multipart/form-data; boundary=")
    //
    pub fn encode(parts: List<FormPart>) -> {content_type: String, body: Bytes}
        flat = parts |> Iter.flat_map(FormPart.flat) |> Iter.to_list()

        case http_host.encode_multipart(flat)
            [content_type, body] -> {content_type: Bytes.to_string(content_type)!, body:}
            _ -> {content_type: "multipart/form-data", body: String.to_bytes("")}
        end
    end

    /// The `Content-Disposition` of a file part: Go's
    /// `multipart.FileContentDisposition`.
    //! import std::http.FormPart
    //!
    //! assert FormPart.file_disposition("doc", "a.txt") == "form-data; name=\"doc\"; filename=\"a.txt\""
    //
    pub fn file_disposition(field: String, filename: String) -> String
        http_host.file_content_disposition(field, filename)
    end

    fn flat(part: FormPart) -> List<Bytes>
        case part
            .Field{name:, value:} ->
                ["v", name, value] |> Iter.map(String.to_bytes) |> Iter.to_list()

            .File{field:, filename:, content_type:, content:} ->
                [..(["f", field, filename, content_type] |> Iter.map(String.to_bytes)), content]

            .Raw{headers:, content:} ->
                Headers(pairs) = headers
                texts = pairs |> Iter.flat_map(fn (k, v) -> [k, v]) |> Iter.to_list()
                [..(["r", "${Iter.count(pairs)}", ..texts] |> Iter.map(String.to_bytes)), content]
        end
    end
end

/// A file a multipart form holds: Go's `multipart.FileHeader`.
pub struct FormFile
    filename: String
    headers: Headers = Headers[]
    size: Int = 0
    content: Bytes
end

impl FormFile
    /// The file's content as a stream.
    pub fn open(file: FormFile) -> Reader
        Reader.from_bytes(file.content)
    end
end

/// A multipart form: Go's `multipart.Form`.
pub struct MultipartForm
    values: Query = Query[]
    files: Map<String, List<FormFile>> = {}
end

fn multipart_of(flat: List<Bytes>, form: MultipartForm) -> MultipartForm
    case flat
        [kind, name, value, ..rest] when text_of(kind) == "v" ->
            multipart_of(
                rest,
                {..form, values: Query.add(form.values, text_of(name), text_of(value))},
            )

        [_, field, filename, count, ..rest] ->
            n = String.to_int(text_of(count)) |> Maybe.with_default(0)
            texts = rest |> Iter.take(2 * n) |> Iter.map(text_of) |> Iter.to_list()

            headers = Headers(
                texts
                |> Iter.chunks(2)
                |> Iter.flat_map(fn kv ->
                    case kv
                        [k, v] -> [(k, v)]
                        _ -> []
                    end
                end)
                |> Iter.to_list()
            )

            after = rest |> Iter.drop(2 * n) |> Iter.to_list()

            case after
                [content, ..remaining] ->
                    file = FormFile{
                        filename: text_of(filename),
                        headers:,
                        size: Bytes.length(content),
                        content:,
                    }

                    key = text_of(field)

                    files = Map.put(
                        form.files,
                        key,
                        [..Map.get(form.files, key) |> Maybe.with_default([]), file],
                    )

                    multipart_of(remaining, {..form, files:})

                [] ->
                    form
            end

        _ ->
            form
    end
end

/// The most a URL-encoded form read takes without a request limit: Go's
/// `ParseForm` limit, 10 MB.
once max_form_body = 10_485_760

/// The most a multipart form read takes without a request limit: Go's
/// `defaultMaxMemory`, 32 MB.
once max_multipart_body = 33_554_432

/// At most `max` bytes of `body`, or `Error.BodyTooLarge`: it reads one byte
/// past `max` to tell, and never the rest. A stream that `limit` (the
/// request's `body_limit`) cut off when the read reached it was too large
/// too.
fn read_capped(body: Body, max: Int, limit: Maybe<Int>) -> Result<Bytes, Error>
    case body
        .Stream(r) ->
            (copied, data) = Writer.collect(fn w -> copy_capped(r, w, max + 1))
            got = Bytes.length(data)

            case copied
                Ok(_) when got > max -> Err(Error.BodyTooLarge{limit: max})
                Ok(_) -> Ok(data)
                Err(_) when limit == Some(got) -> Err(Error.BodyTooLarge{limit: got})
                Err(error) -> Err(Error.Body{error:})
            end

        other ->
            data = Body.bytes_of(other)

            if Bytes.length(data) > max then
                Err(Error.BodyTooLarge{limit: max})
            else
                Ok(data)
            end
    end
end

/// Copies at most `left` bytes of `r` to `w`.
fn copy_capped(r: Reader, w: Writer, left: Int) -> Result<Unit, io.Error>
    if left <= 0 then return Ok(Unit)

    case Reader.read(r, max: Int.min(left, 65_536))?
        Some(chunk) ->
            Writer.write(w, chunk)?
            copy_capped(r, w, left - Bytes.length(chunk))

        None ->
            Ok(Unit)
    end
end

fn text_of(data: Bytes) -> String
    Bytes.to_string(data) |> Result.to_maybe() |> Maybe.with_default("")
end

/// An HTTP version.
pub struct Protocol
    major: Int = 1
    minor: Int = 1
end

derive Equatable for Protocol

impl Protocol
    /// Whether the version is `major.minor` or later.
    //! import std::http.Protocol
    //!
    //! assert Protocol.is_at_least(Protocol{major: 2, minor: 0}, 1, 1)
    //! assert not Protocol.is_at_least(Protocol{major: 1, minor: 0}, 1, 1)
    //
    pub fn is_at_least(protocol: Protocol, major: Int, minor: Int) -> Bool
        protocol.major > major or protocol.major == major and protocol.minor >= minor
    end

    /// Reads an HTTP version: `HTTP/`, a digit, a `.` and a digit, as in
    /// `HTTP/1.1`.
    //! import std::http.Protocol
    //!
    //! assert Protocol.parse("HTTP/2.0") == Some(Protocol{major: 2, minor: 0})
    //! assert Protocol.parse("HTTP/x") == None
    //! assert Protocol.parse("HTTP/1.-1") == None
    //
    pub fn parse(text: String) -> Maybe<Protocol>
        case http_host.parse_http_version(text)
            [major, minor] -> Some(Protocol{major:, minor:})
            _ -> None
        end
    end
end

impl Display for Protocol
    /// `HTTP/1.1`.
    fn to_string(protocol: Protocol) -> String
        "HTTP/${protocol.major}.${protocol.minor}"
    end
end

/// A request to send, or one a server received.
pub struct Request
    method: Method = Method.Get
    /// The URL. On a request a server received it is absolute: its scheme
    /// is `https` over TLS and `http` otherwise, and its host is the `Host`
    /// the client sent, as `http_testing.request` builds one.
    url: Url
    headers: Headers = Headers[]
    body: Body = Body.Empty
    /// The `Host` to send in place of the URL's host. On a request a server
    /// received, the `Host` the client sent.
    host: Maybe<String> = None
    /// The body's length when it is known ahead.
    content_length: Maybe<Int> = None
    transfer_encoding: List<String> = []
    /// Close the connection after this request.
    close: Bool = False
    /// Trailers sent after a streamed body.
    trailers: Headers = Headers[]
    /// The most body bytes the request's readers take, which replaces
    /// the form defaults: set by `limit_body` and the server's `max_body`.
    body_limit: Maybe<Int> = None
    // Set by a server on a request it received.
    protocol: Protocol = Protocol{}
    remote_address: String = ""
    request_uri: String = ""
    pattern: Maybe<String> = None
    path_values: Map<String, String> = {}
    context: Context = Context.root()
    /// The server address the request came in on.
    local_address: String = ""
    /// What the TLS handshake of the connection agreed on; `None` over
    /// plain HTTP.
    tls: Maybe<tls.ConnectionState> = None
    /// Records what happens while the client sends this request
    /// (`Tracer.events`).
    trace: Maybe<Tracer> = None
    /// The server's hold on a request it received, for
    /// `Request.extend_read_deadline`.
    incoming: Maybe<http_host.Incoming> = None
end

impl Request
    /// The form's fields: those of the body (`post_form`) and then the
    /// URL's query. It reads the body, which a request can do once, so keep
    /// what it returns.
    //! import std::http.{Method, Request}
    //! import std::http_testing
    //! import std::url.Query
    //!
    //! r = http_testing.form_request(Method.Post, "/?b=2", [("a", "1")])
    //! assert Request.form(r) == Ok(Query[("a", "1"), ("b", "2")])
    //
    pub fn form(request: Request) -> Result<Query, Error>
        Query(posted) = Request.post_form(request)?
        Query(query) = Url.query_values(request.url)
        Ok(Query([..posted, ..query]))
    end

    /// The fields of the body: a URL-encoded body of a `POST`, `PUT` or
    /// `PATCH`, or a multipart form's fields.
    /// Empty for any other request. It reads the body, at most 10 MB of a
    /// URL-encoded one or the request's `body_limit`, and returns
    /// `Error.BodyTooLarge` past that.
    //! import std::http.{Body, Method, Request}
    //! import std::http_testing
    //!
    //! posted = fn size: Int ->
    //!     {
    //!         ..http_testing.request(Method.Post, "/"),
    //!         headers: Headers[("Content-Type", "application/x-www-form-urlencoded")],
    //!         body: Body.Stream(Reader.from_text("a=${String.repeat("x", size - 2)}")),
    //!     }
    //! end
    //!
    //! assert Request.post_form(Request.limit_body(posted(8), 8)) |> Result.is_ok()
    //!
    //! assert Request.post_form(Request.limit_body(posted(9), 8)) == Err(Error.BodyTooLarge{limit: 8})
    //!
    //! twice = Request.limit_body(Request.limit_body(posted(9), 8), 100)
    //! assert Request.post_form(twice) == Err(Error.BodyTooLarge{limit: 8})
    //
    pub fn post_form(request: Request) -> Result<Query, Error>
        media = Request.media_type(request)

        if media == "multipart/form-data" then
            return Request.multipart_form(request) |> Result.map(fn f -> f.values)
        end

        posts = request.method == Method.Post
            or request.method == Method.Put
            or request.method == Method.Patch

        if not posts or media != "application/x-www-form-urlencoded" then return Ok(Query[])
        max = Maybe.with_default(request.body_limit, max_form_body)
        data = read_capped(request.body, max, request.body_limit)?

        text =
            Bytes.to_string(data)
            |> Result.map_err(fn _ -> Error.Form{reason: "the form is not UTF-8"})?

        Query.parse(text) |> Result.map_err(fn e -> Error.Form{reason: e.reason})
    end

    /// The first value of `key` in the form (`form`), or `None` when the
    /// form has none or does not parse.
    pub fn form_value(request: Request, key: String) -> Maybe<String>
        Request.form(request) |> Result.to_maybe() |> Maybe.flat_map(fn q -> Query.get(q, key))
    end

    /// The first value of `key` in the body's fields, as Go's
    /// `Request.PostFormValue`.
    pub fn post_form_value(request: Request, key: String) -> Maybe<String>
        Request.post_form(request) |> Result.to_maybe() |> Maybe.flat_map(fn q -> Query.get(q, key))
    end

    /// The multipart form the body holds, as Go's
    /// `Request.ParseMultipartForm`. The whole form is read into memory,
    /// so a body past 32 MB, or past the request's `body_limit` when it
    /// has one, is `Error.BodyTooLarge`; `parts` streams a larger
    /// one. It reads the body.
    //! import std::http.{Body, FormPart, Method, Request}
    //! import std::http_testing
    //!
    //! file = fn text: String ->
    //!     FormPart.File{field: "doc", filename: "a", content: String.to_bytes(text)}
    //! end
    //!
    //! upload = fn size: Int ->
    //!     overhead = Bytes.length(FormPart.encode([file("")]).body)
    //!     encoded = FormPart.encode([file(String.repeat("x", size - overhead))])
    //!
    //!     {
    //!         ..http_testing.request(Method.Post, "/upload"),
    //!         headers: Headers[("Content-Type", encoded.content_type)],
    //!         body: Body.Stream(Reader.from_bytes(encoded.body)),
    //!     }
    //! end
    //!
    //! assert Request.multipart_form(upload(1000)) |> Result.is_ok()
    //! assert Request.multipart_form(Request.limit_body(upload(1000), 1000)) |> Result.is_ok()
    //!
    //! assert Request.multipart_form(Request.limit_body(upload(1000), 999))
    //!     == Err(Error.BodyTooLarge{limit: 999})
    //
    pub fn multipart_form(request: Request) -> Result<MultipartForm, Error>
        content_type = Headers.get(request.headers, "Content-Type") |> Maybe.with_default("")
        max = Maybe.with_default(request.body_limit, max_multipart_body)
        data = read_capped(request.body, max, request.body_limit)?

        flat =
            http_host.parse_multipart(content_type, data)
            |> Result.map_err(fn reason -> Error.Form{reason:})?

        Ok(multipart_of(flat, MultipartForm{}))
    end

    /// The first file in the multipart form's field `field`, as Go's
    /// `Request.FormFile`. It reads the body.
    //! import std::http.{Body, FormPart, Method, Request}
    //! import std::http_testing
    //!
    //! parts = [
    //!     FormPart.Field{name: "note", value: "hi"},
    //!     FormPart.File{field: "doc", filename: "a.txt", content: String.to_bytes("abc")},
    //! ]
    //!
    //! request = {
    //!     ..http_testing.request(Method.Post, "/upload"),
    //!     headers: Headers[("Content-Type", FormPart.encode(parts).content_type)],
    //!     body: Body.Multipart(parts),
    //! }
    //!
    //! file = Request.form_file(request, "doc")!
    //! assert file.filename == "a.txt"
    //! assert file.size == 3
    //! assert Request.form_value(request, "note") == Some("hi")
    //! assert Request.form_file(request, "nope") == Err(Error.MissingFile{field: "nope"})
    //
    pub fn form_file(request: Request, field: String) -> Result<FormFile, Error>
        form = Request.multipart_form(request)?

        Map.get(form.files, field)
        |> Maybe.flat_map(List.head)
        |> Maybe.to_result(Error.MissingFile{field:})
    end

    /// The whole body as text. It reads at most 10 MB, or the request's
    /// `body_limit`, as `post_form` does, and returns `Error.BodyTooLarge`
    /// past that; a body that is not UTF-8 is `Error.MalformedBody`, which a
    /// handler's `?` answers with a 400. It reads the body, which a request
    /// can do once.
    //! import std::http.{Body, Method, Request}
    //! import std::http_testing
    //!
    //! posted = fn body: Body -> {..http_testing.request(Method.Post, "/notes"), body:}
    //!
    //! assert Request.text(posted(Body.Stream(Reader.from_text("hello")))) == Ok("hello")
    //!
    //! assert Request.text(Request.limit_body(posted(Body.Text("too long")), 4))
    //!     == Err(Error.BodyTooLarge{limit: 4})
    //!
    //! assert Request.text(posted(Body.Bytes(Bytes.from_list([255]))))
    //!     == Err(Error.MalformedBody{reason: "the body is not UTF-8 text"})
    //
    pub fn text(request: Request) -> Result<String, Error>
        max = Maybe.with_default(request.body_limit, max_form_body)
        data = read_capped(request.body, max, request.body_limit)?

        Bytes.to_string(data)
        |> Result.map_err(fn _ -> Error.MalformedBody{reason: "the body is not UTF-8 text"})
    end

    /// The body read as JSON into a `T`: `Request.text`, then
    /// `Json.decode_as`. Text that is not JSON, or JSON that is not a `T`, is
    /// `Error.MalformedBody`, so a handler that returns `Result<_,
    /// http.Error>` answers it with a 400 through `?`. It does not check the
    /// `Content-Type`. Give `T` with a binding's annotation or as
    /// `Request.json_as<T>(request)`.
    //! import std::http.{Body, Method, Request, Response, Status}
    //! import std::http_testing
    //!
    //! posted = fn text: String -> {..http_testing.request(Method.Post, "/todos"), body: Body.Text(text)}
    //!
    //! read: Result<Map<String, String>, Error> = Request.json_as(posted(`{"title": "milk"}`))
    //! assert read == Ok({"title" => "milk"})
    //!
    //! assert Request.json_as<List<Int>>(posted("[1,")) |> Result.is_err()
    //!
    //! todo = Request.json_as<{title: String, order: Maybe<Int>}>(posted(`{"title": "milk"}`))
    //! assert todo == Ok({title: "milk", order: None})
    //!
    //! create = fn request: Request ->
    //!     fields = Request.json_as<Map<String, String>>(request)?
    //!     Ok(Response{status: Status.created, body: Body.Text("${Map.get(fields, "title")}")})
    //! end
    //!
    //! answer = fn text: String -> ToResponse.to_response(create(posted(text)))
    //! assert answer(`{"title": "milk"}`).status == Status.created
    //! assert answer(`{"title": 7}`).status == Status.bad_request
    //!
    //! assert Response.text(answer(`{"title": 7}`))
    //!     == Ok("malformed body: title: expected String, got int\n")
    //
    pub fn json_as<T>(request: Request) -> Result<T, Error> where T: FromJson
        text = Request.text(request)?

        Json.decode_as<T>(text)
        |> Result.map_err(fn e -> Error.MalformedBody{reason: "${e}"})
    end

    /// The request's media type: its `Content-Type` without parameters, in
    /// lowercase.
    fn media_type(request: Request) -> String
        Headers.get(request.headers, "Content-Type")
        |> Maybe.with_default("")
        |> String.split(";")
        |> List.head()
        |> Maybe.with_default("")
        |> String.trim()
        |> String.lowercase()
    end

    /// The cookies the request's `Cookie` headers send, as Go's
    /// `Request.Cookies`; one that does not parse is left out.
    //! import std::http.{Cookie, Method, Request}
    //! import std::http_testing
    //!
    //! r = Request.add_cookie(http_testing.request(Method.Get, "/"), Cookie{name: "a", value: "1"})
    //! assert Request.cookie(r, "a") |> Maybe.map(fn c -> c.value) == Some("1")
    //!
    //! spaced = Request.add_cookie(r, Cookie{name: "b", value: "x y"})
    //! assert Headers.get(spaced.headers, "Cookie") == Some("a=1; b=\"x y\"")
    //
    pub fn cookies(request: Request) -> List<Cookie>
        Headers.values(request.headers, "Cookie")
        |> Iter.flat_map(fn line -> Cookie.parse_header(line) |> Result.with_default([]))
        |> Iter.to_list()
    end

    /// The cookies named `name`, as Go's `Request.CookiesNamed`.
    pub fn cookies_named(request: Request, name: String) -> List<Cookie>
        Request.cookies(request) |> Iter.filter(fn c -> c.name == name) |> Iter.to_list()
    end

    /// The first cookie named `name`, as Go's `Request.Cookie`.
    pub fn cookie(request: Request, name: String) -> Maybe<Cookie>
        Request.cookies_named(request, name) |> List.head()
    end

    /// The request with `cookie` added to its `Cookie` header. Only its name
    /// and value are sent; a character a value cannot carry is dropped,
    /// and a value with a space or a comma is quoted.
    pub fn add_cookie(request: Request, cookie: Cookie) -> Request
        existing = Headers.get(request.headers, "Cookie") |> Maybe.with_default("")
        line = http_host.add_cookie(existing, Cookie.parts(cookie))
        {..request, headers: Headers.set(request.headers, "Cookie", line)}
    end

    /// The request with a body that fails past `max` bytes, as Go's
    /// `MaxBytesReader`: reading it then returns an `io.Error`, and the
    /// form readers `Error.BodyTooLarge`. `max` becomes the request's
    /// `body_limit`, which replaces the form defaults, so an upload route
    /// can raise them; a second limit only lowers the first.
    pub fn limit_body(request: Request, max: Int) -> Request
        body_limit = case request.body_limit
            Some(earlier) -> Int.min(earlier, max)
            None -> max
        end

        {
            ..request,
            body: Body.Stream(http_host.limit_body(Body.reader(request.body), max)),
            body_limit: Some(body_limit),
        }
    end

    /// The `User-Agent` header.
    pub fn user_agent(request: Request) -> Maybe<String>
        Headers.get(request.headers, "User-Agent")
    end

    /// The `Referer` header.
    pub fn referer(request: Request) -> Maybe<String>
        Headers.get(request.headers, "Referer")
    end

    /// The user and password of a `Basic` `Authorization` header, whose
    /// scheme may be written in any case.
    //! import std::http.Request
    //! import std::url.Url
    //!
    //! r = Request.with_basic_auth(Request{url: Url`https://example.com`}, "ann", "pw")
    //! assert Request.basic_auth(r) == Some(("ann", "pw"))
    //!
    //! lower = {..r, headers: Headers[("Authorization", "basic YW5uOnB3")]}
    //! assert Request.basic_auth(lower) == Some(("ann", "pw"))
    //
    pub fn basic_auth(request: Request) -> Maybe<(String, String)>
        authorization = Headers.get(request.headers, "Authorization") |> Maybe.with_default("")

        case http_host.basic_auth(authorization)
            [user, password] -> Some((user, password))
            _ -> None
        end
    end

    /// The request with a `Basic` `Authorization` header for `user` and
    /// `password`.
    pub fn with_basic_auth(request: Request, user: String, password: String) -> Request
        token = base64.encode(String.to_bytes("${user}:${password}"))
        {..request, headers: Headers.set(request.headers, "Authorization", "Basic ${token}")}
    end

    /// The value a router matched for the wildcard `name`.
    /// Lets the client take until `by` from now to send the rest of the
    /// body, past the server's `read_timeout`. Go's
    /// `ResponseController.SetReadDeadline`. An `Err` for a request no
    /// server received.
    pub fn extend_read_deadline(request: Request, by: Duration) -> Result<Unit, Error>
        case request.incoming
            Some(incoming) ->
                http_host.extend_read_deadline(incoming, Duration.as_nanos(by))
                |> Result.map_err(fn reason -> Error.Protocol{reason:})

            None ->
                Err(Error.Protocol{reason: "the request was not received by a server"})
        end
    end

    /// Reads one request from `r` as it arrives on the wire, its body read
    /// whole: Go's `ReadRequest`. It reads no byte past the request, so the
    /// next one on `r` is left whole.
    //! import std::http.{Request, Method}
    //! import std::io.Reader
    //!
    //! r = Reader.from_text("POST /a?b=1 HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\nhi")
    //! request = Request.read(r)!
    //! assert request.method == Method.Post
    //! assert request.url.path == "/a"
    //! assert Body.read_all(request.body) == Ok(String.to_bytes("hi"))
    //
    pub fn read(r: Reader) -> Result<Request, Error>
        message =
            http_host.wire_read_request(r) |> Result.map_err(fn reason -> Error.Protocol{reason:})?

        (head, headers, trailers, encoding) = wire_parts_of(message)

        (method, target, major, minor, host, length, close) = case head
            [m, t, a, b, h, n, c, _] -> (m, t, a, b, h, n, c)
            _ -> ("GET", "/", "1", "1", "", "-1", "false")
        end

        url =
            Url.parse(target)
            |> Result.map_err(fn e -> Error.InvalidUrl{url: target, reason: "${e}"})?

        Ok(Request{
            method: Method.parse(method),
            url:,
            headers: Headers(pairs(headers)),
            body: Body.Bytes(http_host.wire_body(message)),
            host: if host == "" then None else Some(host),
            content_length: wire_length(length),
            transfer_encoding: encoding,
            close: close == "true",
            trailers: Headers(pairs(trailers)),
            protocol: Protocol{
                major: String.to_int(major) |> Maybe.with_default(1),
                minor: String.to_int(minor) |> Maybe.with_default(1),
            },
            request_uri: target,
        })
    end

    /// Writes the request to `w` as a client sends it: Go's `Request.Write`,
    /// or with `proxy` its `WriteProxy`, which names the whole URL.
    pub fn write_to(request: Request, w: Writer, proxy = False) -> Result<Unit, Error>
        _ = wire_request(if proxy then 1 else 0, request, w)?
        Ok(Unit)
    end

    /// The request as text, as a server received it: httputil's
    /// `DumpRequest`. Without `body`, the body is left out. It reads the
    /// body.
    //! import std::http.{Request, Method}
    //! import std::url.Url
    //!
    //! dumped = Request.dump(Request{method: Method.Get, url: Url.parse("http://x/a")!})!
    //! assert String.starts_with(dumped, "GET /a HTTP/1.1")
    //
    pub fn dump(request: Request, body = True) -> Result<String, Error>
        wire_request(if body then 2 else 3, request, io.stderr)
    end

    /// The request as text, as a client sends it: httputil's
    /// `DumpRequestOut`.
    pub fn dump_outgoing(request: Request, body = True) -> Result<String, Error>
        wire_request(if body then 4 else 5, request, io.stderr)
    end

    /// The parts of the request's multipart body, read as the iterator
    /// runs, each in turn: Go's `Request.MultipartReader`, for a body too
    /// large to read whole (`multipart_form`). An `Err` when the request
    /// is not multipart.
    pub fn parts(request: Request) -> Result<Iter<Result<Part, Error>>, Error>
        content_type = Headers.get(request.headers, "Content-Type") |> Maybe.with_default("")

        boundary =
            String.split(content_type, ";")
            |> Iter.map(String.trim)
            |> Iter.find(fn p -> String.starts_with(p, "boundary="))
            |> Maybe.map(fn p -> String.drop(p, 9) |> String.replace("\"", ""))

        case boundary
            Some(b) when String.starts_with(content_type, "multipart/") ->
                Ok(multipart_parts(Body.reader(request.body), b))

            _ ->
                Err(Error.Form{reason: "request Content-Type isn't multipart/form-data"})
        end
    end

    pub fn path_value(request: Request, name: String) -> Maybe<String>
        Map.get(request.path_values, name)
    end

    /// The request with the wildcard `name` matched as `value`.
    pub fn with_path_value(request: Request, name: String, value: String) -> Request
        {..request, path_values: Map.put(request.path_values, name, value)}
    end
end

/// A response a client received, or one a handler returns.
pub struct Response
    status: Status = Status.ok
    headers: Headers = Headers[]
    body: Body = Body.Empty
    trailers: Headers = Headers[]
    // Set by a client on a response it received.
    protocol: Protocol = Protocol{}
    /// The URL the last request went to, after any redirects.
    url: Maybe<Url> = None
    content_length: Maybe<Int> = None
    transfer_encoding: List<String> = []
    close: Bool = False
    /// The client asked for gzip and decompressed the body itself.
    uncompressed: Bool = False
    /// What the TLS handshake of the connection agreed on; `None` over
    /// plain HTTP.
    tls: Maybe<tls.ConnectionState> = None
    /// The longest writing this response may take, in place of the
    /// server's `write_timeout`. Go's `ResponseController.SetWriteDeadline`.
    write_timeout: Maybe<Duration> = None
    /// Lets the handler read the request body while it writes the
    /// response, as HTTP/1 servers otherwise refuse. Go's
    /// `ResponseController.EnableFullDuplex`.
    full_duplex: Bool = False
    /// Set by `Response.upgrade`: the server responds, then hands the
    /// connection to this function.
    upgrade: Maybe<(net.Connection) -> Unit> = None
end

impl Response
    /// Reads one response from `r`, to a request like `request`, its body
    /// read whole: Go's `ReadResponse`.
    pub fn read(r: Reader, request: Request) -> Result<Response, Error>
        message =
            http_host.wire_read_response(r, Method.text(request.method))
            |> Result.map_err(fn reason -> Error.Protocol{reason:})?

        (head, headers, trailers, encoding) = wire_parts_of(message)

        (major, minor, length, close, status) = case head
            [_, _, a, b, _, n, c, s] -> (a, b, n, c, s)
            _ -> ("1", "1", "-1", "false", "200")
        end

        Ok(Response{
            status: Status(
                String.to_int(status)
                |> Maybe.with_default(200)
            ),
            headers: Headers(pairs(headers)),
            body: Body.Bytes(http_host.wire_body(message)),
            trailers: Headers(pairs(trailers)),
            protocol: Protocol{
                major: String.to_int(major) |> Maybe.with_default(1),
                minor: String.to_int(minor) |> Maybe.with_default(1),
            },
            content_length: wire_length(length),
            transfer_encoding: encoding,
            close: close == "true",
        })
    end

    /// Writes the response to `w` as a server sends it: Go's
    /// `Response.Write`.
    //! import std::http.{Body, Response}
    //! import std::io.Writer
    //!
    //! (_, wire) = Writer.collect(fn w -> Response.write_to(Response{body: Body.Text("hi")}, w))
    //! assert String.starts_with(Bytes.to_string(wire)!, "HTTP/1.1 200 OK")
    //
    pub fn write_to(response: Response, w: Writer) -> Result<Unit, Error>
        _ = wire_response(0, response, w)?
        Ok(Unit)
    end

    /// The response as text: httputil's `DumpResponse`. Without `body`, the
    /// body is left out.
    pub fn dump(response: Response, body = True) -> Result<String, Error>
        wire_response(if body then 1 else 2, response, io.stderr)
    end

    /// A response that sends `status` and `headers`, then hands the
    /// connection to `on_connection`, which speaks another protocol over
    /// it, as a WebSocket server does after `101 Switching Protocols`. The
    /// connection is closed when `on_connection` returns. Go's `Hijack`.
    pub fn upgrade(
        status: Status = Status.switching_protocols,
        headers: Headers,
        on_connection: (net.Connection) -> Unit,
    ) -> Response
        Response{status:, headers:, upgrade: Some(on_connection)}
    end

    /// The cookies the response's `Set-Cookie` headers set, as Go's
    /// `Response.Cookies`; one that does not parse is left out.
    pub fn cookies(response: Response) -> List<Cookie>
        Headers.values(response.headers, "Set-Cookie")
        |> Iter.flat_map(fn line -> Cookie.parse_set_cookie(line) |> Result.to_maybe())
        |> Iter.to_list()
    end

    /// The response with a `Set-Cookie` header for `cookie`, as Go's
    /// `SetCookie`; a cookie Go cannot write is left out.
    //! import std::http.{Cookie, Response, SameSite}
    //!
    //! r = Response.set_cookie(
    //!     Response{},
    //!     Cookie{name: "id", value: "7", http_only: True, same_site: SameSite.Lax},
    //! )
    //!
    //! assert Headers.get(r.headers, "Set-Cookie") == Some("id=7; HttpOnly; SameSite=Lax")
    //
    pub fn set_cookie(response: Response, cookie: Cookie) -> Response
        text = "${cookie}"
        if text == "" then return response
        {..response, headers: Headers.add(response.headers, "Set-Cookie", text)}
    end

    /// A page or a fragment of one: a 200 whose body is `page`, sent as
    /// `text/html; charset=utf-8` with its length.
    //! import std::html.Html
    //! import std::http.Response
    //! import std::io.Writer
    //!
    //! page = Html.text("a < b")
    //! (_, wire) = Writer.collect(fn w -> Response.write_to(Response.html(page), w))
    //! sent = Bytes.to_string(wire)!
    //! assert String.contains(sent, "Content-Type: text/html; charset=utf-8")
    //! assert String.contains(sent, "Content-Length: 8")
    //! assert String.ends_with(sent, "a &lt; b")
    //
    pub fn html(page: Html) -> Response
        Response{body: Body.Html(page)}
    end

    /// `value` as JSON: a response with `status`, 200 unless given, whose
    /// body is `ToJson.to_json(value)`, sent as `application/json`. A `Json`
    /// value is sent as it is, and an anonymous struct as an object of its
    /// fields.
    //! import std::http.{Response, Status}
    //!
    //! r = Response.json({"id" => 7, "done" => 0})
    //! assert r.status == Status.ok
    //! assert Headers.get(r.headers, "Content-Type") == Some("application/json")
    //! assert Response.json_as<Map<String, Int>>(r) == Ok({"id" => 7, "done" => 0})
    //!
    //! created = Response.json(Json.Obj{"id" => Json.Int(8)}, status: Status.created)
    //! assert created.status == Status.created
    //! assert Response.text(created) == Ok(`{"id":8}`)
    //!
    //! missing = Response.json({error: "no todo 99"}, status: Status.not_found)
    //! assert Response.text(missing) == Ok(`{"error":"no todo 99"}`)
    //
    pub fn json(value: ToJson, status: Status = Status.ok) -> Response
        Response{
            status:,
            headers: Headers[("Content-Type", "application/json")],
            body: Body.Json(ToJson.to_json(value)),
        }
    end

    /// A plain-text response with `status` and `message`, as Go's `Error`
    /// writes it: `text/plain; charset=utf-8`, `X-Content-Type-Options:
    /// nosniff`, and the message and a newline.
    //! import std::http.{Response, Status}
    //!
    //! r = Response.error(Status.forbidden, "no")
    //! assert Response.text(r) == Ok("no\n")
    //! assert Headers.get(r.headers, "x-content-type-options") == Some("nosniff")
    //
    pub fn error(status: Status, message: String) -> Response
        headers =
            Headers[]
            |> Headers.set("Content-Type", "text/plain; charset=utf-8")
            |> Headers.set("X-Content-Type-Options", "nosniff")

        Response{status:, headers:, body: Body.Text("${message}\n")}
    end

    /// A 404 whose plain-text body is `404 page not found`.
    pub fn not_found() -> Response
        Response.error(Status.not_found, "404 page not found")
    end

    /// A redirect to `to`, which may be relative to the request's path,
    /// with `status` and a short HTML body for a `GET` or `HEAD`.
    //! import std::http.{Method, Response, Status}
    //! import std::http_testing
    //!
    //! r = Response.redirect(http_testing.request(Method.Get, "/a/b"), "c", Status.found)
    //! assert Headers.get(r.headers, "Location") == Some("/a/c")
    //
    pub fn redirect(request: Request, to: String, status: Status) -> Response
        from_go(
            http_host.answer_redirect(
                Method.text(request.method),
                "${request.url}",
                flat(request.headers),
                to,
                Status.code(status),
            )
        )
    end

    /// `data` as the response to `request`. Its `Content-Type` comes from
    /// the extension of `name`, or from the data itself, unless `headers`
    /// sets one. A `Range` gets 206 and the parts asked for, and
    /// the `If-*` conditional headers are checked against `modified` and
    /// the `ETag` in `headers`, so an `If-None-Match` that names it is a
    /// 304. The response carries `headers`. It responds as Go's
    /// `ServeContent` does.
    //! import std::http.{Method, Response, Status}
    //! import std::http_testing
    //!
    //! request = http_testing.request(Method.Get, "/f")
    //! ranged = {..request, headers: Headers.set(request.headers, "Range", "bytes=1-2")}
    //! r = Response.content(ranged, "f.txt", None, String.to_bytes("hello"))
    //! assert r.status == Status.partial_content
    //! assert Response.text(r) == Ok("el")
    //!
    //! head = {..request, method: Method.Head}
    //! assert Response.content(head, "f.txt", None, String.to_bytes("hello")).content_length == Some(5)
    //!
    //! tagged = Headers[("ETag", "\"v1\"")]
    //! again = {..request, headers: Headers.set(request.headers, "If-None-Match", "\"v1\"")}
    //!
    //! assert Response.content(again, "f.txt", None, String.to_bytes("hello"), headers: tagged).status
    //!     == Status.not_modified
    //
    pub fn content(
        request: Request,
        name: String,
        modified: Maybe<Instant>,
        data: Bytes,
        headers: Headers = Headers[],
    ) -> Response
        from_go(
            http_host.answer_content(
                Method.text(request.method),
                "${request.url}",
                flat(request.headers),
                name,
                modified
                |> Maybe.map(Instant.as_nanos)
                |> Maybe.with_default(-1),
                flat(headers),
                data,
            )
        )
    end

    /// `value` as a response, with each of `headers` set in
    /// place of any value the response has for that name. Middleware uses
    /// it on whatever its handler returned.
    //! import std::html.Html
    //! import std::http.Response
    //!
    //! r = Response.with_headers(Html"<p>hi</p>", Headers[("Cache-Control", "no-store")])
    //! assert Headers.get(r.headers, "Cache-Control") == Some("no-store")
    //! assert Response.text(r) == Ok("<p>hi</p>")
    //
    pub fn with_headers(value: ToResponse, headers: Headers) -> Response
        response = ToResponse.to_response(value)
        Headers(pairs) = headers

        set = Iter.reduce(pairs, response.headers, fn acc, (name, text) ->
            Headers.set(acc, name, text)
        end)

        {..response, headers: set}
    end

    /// `value` as a response, with each of `headers` the
    /// response does not have already: a header the handler set is kept.
    //! import std::http.Response
    //!
    //! r = Response.with_default_headers(
    //!     Response{headers: Headers[("X-Frame-Options", "SAMEORIGIN")]},
    //!     Headers[("X-Frame-Options", "DENY"), ("Referrer-Policy", "no-referrer")],
    //! )
    //!
    //! assert Headers.get(r.headers, "X-Frame-Options") == Some("SAMEORIGIN")
    //! assert Headers.get(r.headers, "Referrer-Policy") == Some("no-referrer")
    //
    pub fn with_default_headers(value: ToResponse, headers: Headers) -> Response
        response = ToResponse.to_response(value)
        Headers(pairs) = headers

        added = Iter.reduce(pairs, response.headers, fn acc, (name, text) ->
            if Headers.has(response.headers, name) then
                acc
            else
                Headers.add(acc, name, text)
            end
        end)

        {..response, headers: added}
    end

    /// The whole body as text.
    pub fn text(response: Response) -> Result<String, Error>
        Body.read_all(response.body)?
        |> Bytes.to_string()
        |> Result.map_err(fn _ -> Error.Protocol{reason: "the body is not UTF-8 text"})
    end

    /// The whole body.
    pub fn bytes(response: Response) -> Result<Bytes, Error>
        Body.read_all(response.body)
    end

    /// The whole body read as JSON into a `T`: `Response.text`, then
    /// `Json.decode_as`. Text that is not JSON, or JSON that is not a `T`, is
    /// `Error.Protocol`. It does not check the `Content-Type`. Give `T` with
    /// a binding's annotation or as `Response.json_as<T>(response)`;
    /// `Response.json_as<Json>` reads any JSON.
    //! import std::http.{Body, Response}
    //!
    //! r = Response{body: Body.Text(`{"id": 7}`)}
    //! assert Response.json_as<Map<String, Int>>(r) == Ok({"id" => 7})
    //! assert Response.json_as<Json>(r) == Ok(Json.Obj{"id" => Json.Int(7)})
    //! assert Response.json_as<List<Int>>(r) |> Result.is_err()
    //
    pub fn json_as<T>(response: Response) -> Result<T, Error> where T: FromJson
        text = Response.text(response)?

        Json.decode_as<T>(text)
        |> Result.map_err(fn e -> Error.Protocol{reason: "the body is not JSON: ${e}"})
    end

    /// The `Location` header resolved against the response's URL.
    pub fn location(response: Response) -> Result<Maybe<Url>, Error>
        case Headers.get(response.headers, "Location")
            None ->
                Ok(None)

            Some(text) ->
                parsed = case response.url
                    Some(base) -> Url.resolve_text(base, text)
                    None -> Url.parse(text)
                end

                parsed
                |> Result.map(Some)
                |> Result.map_err(fn e -> Error.InvalidUrl{url: e.url, reason: e.reason})
        end
    end
end

/// A value a handler may return: every place std::http takes a
/// handler takes a `Handler`, a `(Request) -> ToResponse`, and calls
/// `to_response` once on what it returns. A handler with several steps
/// that can fail returns `Result<Response, AppError>` and uses `?`, and
/// the program's error type implements `ToResponse` to render itself, as
/// axum's `IntoResponse` does.
///
/// `Response` is sent as it is, `Html` as `Response.html` makes it (a 200
/// page), and a `Result` as its `Ok` or its `Err`. `String` has no
/// implementation: a handler that returns text says which kind with
/// `Body.Text`, `Response.error` or a content type of its own.
//! import std::html.Html
//! import std::http.{self, Body, Method, Response, Route, Router, Status}
//! import std::http_testing
//!
//! router = Router.new([
//!     Route.to("GET /plain", fn _ -> Response{body: Body.Text("plain")}),
//!     Route.to("GET /page", fn _ -> Html"<p>page</p>"),
//!     Route.to_with("GET /items/{id}", fn _, p ->
//!         case String.to_int(p.id)
//!             Some(n) -> Ok(Response{body: Body.Text("item ${n}")})
//!             None -> Err(Response.error(Status.bad_request, "not a number"))
//!         end
//!     end),
//! ])!
//!
//! answer = fn target: String -> Router.serve(router, http_testing.request(Method.Get, target))
//! assert Response.text(answer("/plain")) == Ok("plain")
//! assert Response.text(answer("/page")) == Ok("<p>page</p>")
//! assert Response.text(answer("/items/7")) == Ok("item 7")
//! assert answer("/items/x").status == Status.bad_request
//
pub interface ToResponse
    fn to_response(value: self) -> Response
end

/// A request handler: a function from a `Request` to any value that
/// converts to a response (`ToResponse`). `Router.new`, `serve` and the
/// middleware take one. A named function or a lambda is one as it stands.
pub typealias Handler (Request) -> ToResponse

impl ToResponse for Response
    fn to_response(value: Response) -> Response
        value
    end
end

impl ToResponse for Html
    fn to_response(value: Html) -> Response
        Response.html(value)
    end
end

// Infallible has no values, so this is never called. It lets a handler
// whose body only answers `Ok(...)`, a `Result<Response, Infallible>`, be a
// `ToResponse` through the `Result` impl below.
impl ToResponse for Infallible
    fn to_response(value: Infallible) -> Response
        value
    end
end

impl ToResponse for Result<T, E> where T: ToResponse, E: ToResponse
    fn to_response(value: Result<T, E>) -> Response
        case value
            Ok(answer) -> ToResponse.to_response(answer)
            Err(failure) -> ToResponse.to_response(failure)
        end
    end
end

/// An error as a handler's answer, so a handler that returns
/// `Result<Response, http.Error>` passes a failure up with `?`. A request
/// the handler could not read is the client's fault and gets a 4xx whose
/// body says why: 413 for `BodyTooLarge`, 403 for `CrossOrigin`, and 400 for
/// `MalformedBody`, `Form`, `MissingFile` and `Body`. A request the handler
/// sent upstream and lost is a 502, or a 504 when it timed out, and a
/// handler that ran out of time a 503. Anything else is a 500. A 5xx body is
/// the status text alone, so it shows the client nothing internal.
//! import std::http.{Body, Method, Request, Response, Status}
//! import std::http_testing
//!
//! status = fn e: Error -> ToResponse.to_response(e).status
//! assert status(Error.MalformedBody{reason: "x"}) == Status.bad_request
//! assert status(Error.BodyTooLarge{limit: 8}) == Status.request_entity_too_large
//! assert status(Error.Timeout{during: "dial"}) == Status.gateway_timeout
//!
//! hidden = ToResponse.to_response(Error.Listen{address: ":80", reason: "secret"})
//! assert hidden.status == Status.internal_server_error
//! assert Response.text(hidden) == Ok("Internal Server Error\n")
//
impl ToResponse for Error
    fn to_response(error: Error) -> Response
        status = case error
            .BodyTooLarge{limit: _} -> Status.request_entity_too_large
            .CrossOrigin{reason: _} -> Status.forbidden
            .MalformedBody{reason: _} -> Status.bad_request
            .Form{reason: _} -> Status.bad_request
            .MissingFile{field: _} -> Status.bad_request
            .Body{error: _} -> Status.bad_request
            .Timeout{during: _} -> Status.gateway_timeout
            .HandlerTimeout -> Status.service_unavailable
            .InvalidUrl{url: _, reason: _} -> Status.bad_gateway
            .Dns{host: _, reason: _} -> Status.bad_gateway
            .Connect{address: _, reason: _} -> Status.bad_gateway
            .Tls{reason: _} -> Status.bad_gateway
            .Canceled -> Status.bad_gateway
            .TooManyRedirects{count: _} -> Status.bad_gateway
            .RedirectRefused{url: _, reason: _} -> Status.bad_gateway
            .Protocol{reason: _} -> Status.bad_gateway
            _ -> Status.internal_server_error
        end

        if Status.code(status) < 500 then
            Response.error(status, "${error}")
        else
            Response.error(status, Status.text(status))
        end
    end
end

/// Why a request got no response.
pub enum Error
    InvalidUrl {url: String, reason: String}
    InvalidRequest {reason: String}
    Dns {host: String, reason: String}
    Connect {address: String, reason: String}
    Tls {reason: String}
    /// The client's timeout, a deadline in force, or a transport timeout.
    Timeout {during: String}
    Canceled
    TooManyRedirects {count: Int}
    /// A form that does not parse, or a request that holds none of the
    /// kind asked for.
    Form {reason: String}
    /// `Request.form_file` found no file in the field.
    MissingFile {field: String}
    /// `CrossOrigin.check` refused a cross-origin request.
    CrossOrigin {reason: String}
    /// A `Redirects.Decide` function refused the redirect to `url`.
    RedirectRefused {url: String, reason: String}
    Protocol {reason: String}
    BodyTooLarge {limit: Int}
    /// A request body `Request.text` or `json_as` could not read as asked:
    /// not UTF-8, not JSON, or JSON of another shape.
    MalformedBody {reason: String}
    BodyNotAllowed
    ContentLength
    HandlerTimeout
    Body {error: io.Error}
    /// A server could not listen on `address`.
    Listen {address: String, reason: String}
    /// A router pattern that breaks `Route`'s rules or that Go's
    /// `ServeMux` refuses, or one that conflicts with an earlier pattern.
    Pattern {pattern: String, reason: String}
    /// The target has no network.
    Unsupported {reason: String}
end

derive Equatable for Error

impl Error
    /// Whether the error is a timeout, as Go's `Timeout()` reports.
    pub fn is_timeout(error: Error) -> Bool
        case error
            .Timeout{during: _} -> True
            _ -> False
        end
    end

    fn from_parts(parts: List<String>) -> Error
        case parts
            ["InvalidUrl", url, reason] ->
                Error.InvalidUrl{url:, reason:}

            ["InvalidRequest", reason] ->
                Error.InvalidRequest{reason:}

            ["Dns", host, reason] ->
                Error.Dns{host:, reason:}

            ["Connect", address, reason] ->
                Error.Connect{address:, reason:}

            ["Tls", reason] ->
                Error.Tls{reason:}

            ["Timeout", during] ->
                Error.Timeout{during:}

            ["Canceled"] ->
                Error.Canceled

            ["TooManyRedirects", count] ->
                Error.TooManyRedirects{count: String.to_int(count) |> Maybe.with_default(0)}

            ["BodyTooLarge", limit] ->
                Error.BodyTooLarge{limit: String.to_int(limit) |> Maybe.with_default(0)}

            ["Protocol", reason] ->
                Error.Protocol{reason:}

            ["Listen", address, reason] ->
                Error.Listen{address:, reason:}

            ["Pattern", pattern, reason] ->
                Error.Pattern{pattern:, reason:}

            _ ->
                Error.Protocol{reason: String.join(parts, ": ")}
        end
    end
end

impl Display for Error
    fn to_string(error: Error) -> String
        case error
            .InvalidUrl{url:, reason:} -> "invalid URL ${url}: ${reason}"
            .InvalidRequest{reason:} -> "invalid request: ${reason}"
            .Dns{host:, reason:} -> "looking up ${host}: ${reason}"
            .Connect{address:, reason:} -> "connecting to ${address}: ${reason}"
            .Tls{reason:} -> "TLS: ${reason}"
            .Timeout{during:} -> "timed out during the ${during}"
            .Canceled -> "the request was canceled"
            .TooManyRedirects{count:} -> "stopped after ${count} redirects"
            .Form{reason:} -> "reading the form: ${reason}"
            .MissingFile{field:} -> "no file in the form's field ${field}"
            .CrossOrigin{reason:} -> reason
            .RedirectRefused{url:, reason:} -> "the redirect to ${url} was refused: ${reason}"
            .Protocol{reason:} -> reason
            .BodyTooLarge{limit:} -> "the body is larger than ${limit} bytes"
            .MalformedBody{reason:} -> "malformed body: ${reason}"
            .BodyNotAllowed -> "this request or response cannot have a body"
            .ContentLength -> "the body's length is not its Content-Length"
            .HandlerTimeout -> "the handler timed out"
            .Body{error:} -> "reading the body: ${error}"
            .Listen{address:, reason:} -> "listening on ${address}: ${reason}"
            .Pattern{pattern:, reason:} -> "pattern ${pattern}: ${reason}"
            .Unsupported{reason:} -> reason
        end
    end
end

/// Which redirects a client follows.
pub enum Redirects
    /// Follow up to `max` redirects, as Go does (10).
    Follow {max: Int = 10}
    /// Return the redirect response itself.
    Never
    /// Ask a function before each redirect, as Go's `CheckRedirect` does.
    /// It gets the request the redirect would send and the requests
    /// already sent, oldest first, and returns whether to send it. There
    /// is no limit but the function's.
    Decide (Request, List<Request>) -> Redirect
end

/// What a `Redirects.Decide` function returns for one redirect.
pub enum Redirect
    /// Send the request.
    Follow
    /// Return the redirect response itself, as Go's `ErrUseLastResponse`.
    Stop
    /// Fail the request with `Error.RedirectRefused` and `reason`.
    Refuse String
end

/// Where a client's requests go through.
pub enum Proxy
    /// `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY`, as Go reads them.
    FromEnvironment
    /// No proxy.
    Direct
    /// Every request through `url`.
    Fixed Url
end

/// How a client's connections are made and kept: Go's `Transport` options.
pub struct Transport
    proxy: Proxy = Proxy.FromEnvironment
    tls_handshake_timeout: Duration = Duration.seconds(10)
    keep_alives: Bool = True
    compression: Bool = True
    max_idle: Int = 100
    max_idle_per_host: Int = 2
    max_per_host: Maybe<Int> = None
    idle_timeout: Maybe<Duration> = Some(Duration.seconds(90))
    response_header_timeout: Maybe<Duration> = None
    expect_continue_timeout: Duration = Duration.seconds(1)
    max_response_header_bytes: Maybe<Int> = None
    write_buffer_size: Maybe<Int> = None
    read_buffer_size: Maybe<Int> = None
    force_http2: Bool = True
    /// The protocols the transport speaks; `None` is Go's choice, HTTP/1,
    /// and HTTP/2 when `force_http2` is set.
    protocols: Maybe<Protocols> = None
    http2: Http2Options = Http2Options{}
    /// Headers sent with each `CONNECT` to a proxy.
    proxy_connect_headers: Headers = Headers[]
    /// Sees each proxy's response to `CONNECT`; an `Err` fails the request.
    /// Go's `OnProxyConnectResponse`. It runs on the task sending.
    on_proxy_connect: Maybe<(Url, Response) -> Result<Unit, Error>> = None
end

/// The HTTP protocols a server accepts or a transport speaks: Go's
/// `Protocols`.
pub struct Protocols
    http1: Bool = True
    /// HTTP/2 over TLS.
    http2: Bool = True
    /// HTTP/2 over plain TCP (h2c).
    unencrypted_http2: Bool = False
end

derive Equatable for Protocols

impl Display for Protocols
    //! import std::http.Protocols
    //!
    //! assert "${Protocols{}}" == "{HTTP1,HTTP2}"
    //
    fn to_string(protocols: Protocols) -> String
        names = [
            if protocols.http1 then Some("HTTP1") else None,
            if protocols.http2 then Some("HTTP2") else None,
            if protocols.unencrypted_http2 then
                Some("UnencryptedHTTP2")
            else
                None
            end,
        ]

        "{${names |> Iter.flat_map(fn n -> n) |> String.join(",")}}"
    end
end

fn protocol_flags(protocols: Maybe<Protocols>) -> List<Bool>
    p = Maybe.with_default(protocols, Protocols{})
    [p.http1, p.http2, p.unencrypted_http2]
end

/// HTTP/2's limits and timeouts: Go's `HTTP2Config`. `None` and `False`
/// are Go's defaults.
pub struct Http2Options
    /// The streams a client may have open at once; servers only.
    max_concurrent_streams: Maybe<Int> = None
    /// Keep to the server's stream limit across connections rather than
    /// opening another; transports only.
    strict_max_concurrent_requests: Bool = False
    max_decoder_header_table_size: Maybe<Int> = None
    max_encoder_header_table_size: Maybe<Int> = None
    max_read_frame_size: Maybe<Int> = None
    max_receive_buffer_per_connection: Maybe<Int> = None
    max_receive_buffer_per_stream: Maybe<Int> = None
    /// Pings a connection that has been quiet this long.
    send_ping_timeout: Maybe<Duration> = None
    /// Closes a connection whose ping gets no reply in this long.
    ping_timeout: Maybe<Duration> = None
    /// Closes a connection that accepts no bytes for this long.
    write_byte_timeout: Maybe<Duration> = None
    permit_prohibited_cipher_suites: Bool = False
    /// Told the kind of each HTTP/2 error, as a metrics counter would be.
    /// Go's `CountError`.
    on_error_count: Maybe<(String) -> Unit> = None
end

fn http2_numbers(options: Http2Options) -> List<Int>
    [
        Maybe.with_default(options.max_concurrent_streams, 0),
        Maybe.with_default(options.max_decoder_header_table_size, 0),
        Maybe.with_default(options.max_encoder_header_table_size, 0),
        Maybe.with_default(options.max_read_frame_size, 0),
        Maybe.with_default(options.max_receive_buffer_per_connection, 0),
        Maybe.with_default(options.max_receive_buffer_per_stream, 0),
        nanos(options.send_ping_timeout),
        nanos(options.ping_timeout),
        nanos(options.write_byte_timeout),
    ]
end

fn http2_flags(options: Http2Options) -> List<Bool>
    [options.strict_max_concurrent_requests, options.permit_prohibited_cipher_suites]
end

fn ignore_text(_text: String) -> Unit
    Unit
end

impl Transport
    /// The options Go's `DefaultTransport` has.
    pub once default = Transport{}
end

/// A response whose body is still arriving: what `http.stream` and
/// `Client.stream` return. It holds its connection until its body is
/// closed, so `defer StreamedResponse.close(response)` follows it (spec §9
/// *Releasing resources*). `http.fetch`'s `Response` holds its body whole.
pub struct StreamedResponse
    status: Status
    headers: Headers
    /// The body, read as it arrives.
    body: Reader
    protocol: Protocol
    /// The URL the last request went to, after any redirects.
    url: Maybe<Url>
    content_length: Maybe<Int>
    /// What the TLS handshake of the connection agreed on; `None` over
    /// plain HTTP.
    tls: Maybe<tls.ConnectionState>
end

impl StreamedResponse
    /// Closes the body, so its connection is released.
    pub fn close(response: StreamedResponse) -> Unit
        Reader.close_quietly(response.body)
    end

    /// `response` with its body read as a stream.
    fn of(response: Response) -> StreamedResponse
        StreamedResponse{
            status: response.status,
            headers: response.headers,
            body: Body.reader(response.body),
            protocol: response.protocol,
            url: response.url,
            content_length: response.content_length,
            tls: response.tls,
        }
    end
end

impl Release for StreamedResponse
    fn release(response: StreamedResponse)
        StreamedResponse.close(response)
    end
end

/// A client's options.
pub struct ClientOptions
    /// The longest a request may take, its body included.
    timeout: Maybe<Duration> = None
    redirects: Redirects = Redirects.Follow{}
    transport: Transport = Transport.default
    /// Replaces the transport: every request goes to this function.
    round_trip: Maybe<(Request) -> Result<Response, Error>> = None
    /// `fetch` refuses a body past this many bytes (`Error.BodyTooLarge`);
    /// `stream` streams any size.
    max_body: Maybe<Int> = Some(67_108_864)
    /// Where the client keeps cookies: it sends a jar's cookies with each
    /// request and stores those each response sets. `None` keeps none.
    cookies: Maybe<CookieJar> = None
    /// How the client checks servers and what it offers over TLS; `None`
    /// is Go's defaults. `Client.new` traps when its roots hold no
    /// certificate.
    tls: Maybe<tls.ClientConfig> = None
end

/// A client: its options and its connection pool. Make one with
/// `Client.new` and keep it; the pool is Go's, which only std::http can name.
pub struct Client
    handle: http_host.Client
    options: ClientOptions
end

impl Client
    /// A client with `options`.
    pub fn new(options: ClientOptions = ClientOptions{}) -> Client
        t = options.transport

        (proxy, proxy_url) = case t.proxy
            .FromEnvironment -> (0, "")
            .Direct -> (1, "")
            .Fixed(u) -> (2, "${u}")
        end

        handle = http_host.new_client(
            nanos(options.timeout),
            case options.redirects
                .Follow{max:} -> max
                .Never -> -1
                .Decide(_) -> -1
            end,
            proxy,
            proxy_url,
            Duration.as_nanos(t.tls_handshake_timeout),
            t.keep_alives,
            t.compression,
            t.max_idle,
            t.max_idle_per_host,
            Maybe.with_default(t.max_per_host, 0),
            nanos(t.idle_timeout),
            nanos(t.response_header_timeout),
            Duration.as_nanos(t.expect_continue_timeout),
            Maybe.with_default(t.max_response_header_bytes, 0),
            Maybe.with_default(t.write_buffer_size, 0),
            Maybe.with_default(t.read_buffer_size, 0),
            t.force_http2,
            protocol_flags(t.protocols),
            Maybe.is_some(t.protocols),
            http2_numbers(t.http2),
            http2_flags(t.http2),
            flat(t.proxy_connect_headers),
            case t.on_proxy_connect
                Some(check) ->
                    fn proxy_url, code, headers ->
                        answer = Response{status: Status(code), headers: Headers(pairs(headers))}

                        case Url.parse(proxy_url)
                        |> Result.map_err(fn e -> Error.InvalidUrl{url: proxy_url, reason: "${e}"})
                        |> Result.flat_map(fn u -> check(u, answer))
                            Ok(_) -> ""
                            Err(error) -> "${error}"
                        end
                    end

                None ->
                    fn _, _, _ -> ""
            end,
            Maybe.is_some(t.on_proxy_connect),
            Maybe.with_default(t.http2.on_error_count, ignore_text),
            Maybe.is_some(t.http2.on_error_count),
        )

        handle = case options.cookies
            Some(jar) -> http_host.with_jar(handle, jar.handle)
            None -> handle
        end

        handle = case options.tls
            Some(config) -> http_host.with_tls(handle, tls.ClientConfig.host(config)!)
            None -> handle
        end

        Client{handle:, options:}
    end

    /// Sends `request` and reads the whole body into `Body.Bytes`.
    pub fn fetch(client: Client, request: Request) -> Result<Response, Error>
        faked: Maybe<Result<Response, Error>> = http_host.answered(request)
        if Some(answer) = faked then return answer
        Client{handle:, options:} = client
        if Some(round_trip) = options.round_trip then return round_trip(request)
        exchange = send_following(handle, request, False, options.max_body, options.redirects, [])?
        Ok(response_of(exchange, Body.Bytes(http_host.body_bytes(exchange))))
    end

    /// Sends `request` and returns the response with its body still
    /// arriving, read as it arrives, of any size. Defer
    /// `StreamedResponse.close` on the next line, so the body is closed
    /// however the function ends. A faked or round-tripped response's body
    /// is read from memory.
    pub fn stream(client: Client, request: Request) -> Result<StreamedResponse, Error>
        faked: Maybe<Result<Response, Error>> = http_host.answered(request)
        if Some(answer) = faked then return Result.map(answer, StreamedResponse.of)
        Client{handle:, options:} = client

        if Some(round_trip) = options.round_trip then
            return Result.map(round_trip(request), StreamedResponse.of)
        end

        exchange = send_following(handle, request, True, None, options.redirects, [])?
        head = response_of(exchange, Body.Empty)

        Ok(StreamedResponse{
            status: head.status,
            headers: head.headers,
            body: http_host.body_reader(exchange),
            protocol: head.protocol,
            url: head.url,
            content_length: head.content_length,
            tls: head.tls,
        })
    end

    /// A `GET` of `url`.
    pub fn get(client: Client, url: Url) -> Result<Response, Error>
        Client.fetch(client, Request{url:})
    end

    /// A `HEAD` of `url`.
    pub fn head(client: Client, url: Url) -> Result<Response, Error>
        Client.fetch(client, Request{method: Method.Head, url:})
    end

    /// A `POST` of `body` to `url`.
    pub fn post(client: Client, url: Url, body: Body) -> Result<Response, Error>
        Client.fetch(client, Request{method: Method.Post, url:, body:})
    end

    /// A `POST` of `form`, URL-encoded, to `url`.
    pub fn post_form(client: Client, url: Url, form: Query) -> Result<Response, Error>
        Client.post(client, url, Body.Form(form))
    end

    /// Closes the client's idle connections.
    pub fn close_idle(client: Client) -> Unit
        http_host.close_idle(client.handle)
    end
end

/// The client `http.fetch` and the other module functions use: the default
/// options over one connection pool the whole program shares, as Go's
/// `DefaultClient`. `http_testing.run` responds in its place.
pub fn default_client() -> Client
    Client{handle: http_host.default_client(), options: ClientOptions{}}
end

/// Sends `request` with the default client and reads the whole response.
pub fn fetch(request: Request) -> Result<Response, Error>
    Client.fetch(default_client(), request)
end

/// Sends `request` with the default client and returns the response with
/// its body still arriving, as `Client.stream` does. Defer
/// `StreamedResponse.close` on the next line.
///
/// ```nomi
/// response = http.stream(Request{url:})?
///
/// defer StreamedResponse.close(response)
/// ```
//! import std::http.{Body, Request, Response, StreamedResponse}
//! import std::http_testing
//! import std::url.Url
//!
//! fn first_line(url: Url) -> Result<Maybe<String>, Error>
//!     response = stream(Request{url:})?
//!     defer StreamedResponse.close(response)
//!     Reader.read_line(response.body) |> Result.map_err(fn e -> Error.Body{error: e})
//! end
//!
//! ran = http_testing.run(fn _ -> Ok(Response{body: Body.Text("one\ntwo\n")}), fn ->
//!     first_line(Url`https://example.com/log`)
//! end)
//!
//! assert ran.value == Ok(Some("one"))
//
pub fn stream(request: Request) -> Result<StreamedResponse, Error>
    Client.stream(default_client(), request)
end

/// A `GET` of `url` with the default client.
pub fn get(url: Url) -> Result<Response, Error>
    Client.get(default_client(), url)
end

/// A `HEAD` of `url` with the default client.
pub fn head(url: Url) -> Result<Response, Error>
    Client.head(default_client(), url)
end

/// A `POST` of `body` to `url` with the default client.
pub fn post(url: Url, body: Body) -> Result<Response, Error>
    Client.post(default_client(), url, body)
end

/// A `POST` of `form` to `url` with the default client.
pub fn post_form(url: Url, form: Query) -> Result<Response, Error>
    Client.post_form(default_client(), url, form)
end

fn nanos(d: Maybe<Duration>) -> Int
    d |> Maybe.map(Duration.as_nanos) |> Maybe.with_default(0)
end

fn flat(headers: Headers) -> List<String>
    Headers(fields) = headers
    fields |> Iter.flat_map(fn (k, v) -> [k, v]) |> Iter.to_list()
end

fn send(
    handle: http_host.Client,
    request: Request,
    stream: Bool,
    max_body: Maybe<Int>,
) -> Result<http_host.Exchange, Error>
    headers = typed(request.headers, request.body)

    (kind, data, input) = case request.body
        .Empty ->
            (0, String.to_bytes(""), Reader.from_bytes(String.to_bytes("")))

        .Stream(r) ->
            (2, String.to_bytes(""), r)

        .Produce(_) ->
            return Err(Error.InvalidRequest{reason: "a request body cannot be Body.Produce"})

        other ->
            (1, Body.bytes_of(other), Reader.from_bytes(String.to_bytes("")))
    end

    http_host.send(
        handle,
        Method.text(request.method),
        "${request.url}",
        flat(headers),
        kind,
        data,
        input,
        Maybe.with_default(request.content_length, -1),
        Maybe.with_default(request.host, ""),
        request.close,
        flat(request.trailers),
        stream,
        Maybe.with_default(max_body, -1),
        case request.trace
            Some(t) -> t.handle
            None -> http_host.new_tracer()
        end,
        Maybe.is_some(request.trace),
    )
    |> Result.map_err(Error.from_parts)
end

// headers with the Content-Type body implies, unless they set one.
fn typed(headers: Headers, body: Body) -> Headers
    content_type = case body
        .Text(_) -> Some("text/plain; charset=utf-8")
        .Json(_) -> Some("application/json")
        .Html(_) -> Some("text/html; charset=utf-8")
        .Form(_) -> Some("application/x-www-form-urlencoded")
        .Multipart(parts) -> Some(FormPart.encode(parts).content_type)
        _ -> None
    end

    case content_type
        Some(t) ->
            if Headers.has(headers, "Content-Type") then
                headers
            else
                Headers.add(headers, "Content-Type", t)
            end

        None ->
            headers
    end
end

fn pairs(flat: List<String>) -> List<(String, String)>
    case flat
        [k, v, ..rest] -> [(k, v), ..pairs(rest)]
        _ -> []
    end
end

/// Sends `request`, and with `Redirects.Decide` follows its redirects here,
/// asking the function before each. Go follows the others itself.
fn send_following(
    handle: http_host.Client,
    request: Request,
    stream: Bool,
    max_body: Maybe<Int>,
    redirects: Redirects,
    via: List<Request>,
) -> Result<http_host.Exchange, Error>
    exchange = send(handle, request, stream, max_body)?

    decide = case redirects
        .Decide(f) -> f
        _ -> return Ok(exchange)
    end

    following = case redirected(request, response_of(exchange, Body.Empty))?
        Some(next) -> next
        None -> return Ok(exchange)
    end

    sent = [..via, request]

    case decide(following, sent)
        .Follow ->
            http_host.close_body(exchange)
            send_following(handle, following, stream, max_body, redirects, sent)

        .Stop ->
            Ok(exchange)

        .Refuse(reason) ->
            http_host.close_body(exchange)
            Err(Error.RedirectRefused{url: "${following.url}", reason:})
    end
end

/// The request a redirect response sends next, by Go's rules: a 301 or
/// 302 turns a `POST` into a `GET`, a 303 turns anything but `GET` and
/// `HEAD` into a `GET`, and either drops the body; a 307 or 308 sends the
/// same method and body again, unless the body is a stream, which cannot
/// be sent twice. Headers that carry credentials are dropped when the host
/// changes. `None` for any other response, as for one with no `Location`.
fn redirected(request: Request, response: Response) -> Result<Maybe<Request>, Error>
    target = case Response.location(response)?
        Some(url) -> url
        None -> return Ok(None)
    end

    code = Status.code(response.status)
    method = request.method

    (next_method, keeps_body) = if code == 301 or code == 302 then
        (
            if method == Method.Post then
                Method.Get
            else
                method
            end,
            False,
        )
    else if code == 303 then
        (
            if method == Method.Get or method == Method.Head then
                method
            else
                Method.Get
            end,
            False,
        )
    else if code == 307 or code == 308 then
        (method, True)
    else
        return Ok(None)
    end

    if keeps_body then
        if Body.Stream(_) = request.body then return Ok(None)
    end

    headers = if keeps_body then
        request.headers
    else
        Headers.remove(request.headers, "Content-Type")
    end

    headers = if Url.hostname(target) == Url.hostname(request.url) then
        headers
    else
        ["Authorization", "Www-Authenticate", "Cookie", "Cookie2"]
        |> Iter.reduce(headers, Headers.remove)
    end

    Ok(Some({
            ..request,
            method: next_method,
            url: target,
            headers:,
            body: if keeps_body then request.body else Body.Empty,
            content_length: if keeps_body then
                request.content_length
            else
                None
            end,
            host: None,
        }))
end

fn response_of(exchange: http_host.Exchange, body: Body) -> Response
    (major, minor) = case http_host.protocol(exchange)
        [a, b] -> (a, b)
        _ -> (1, 1)
    end

    length = http_host.content_length(exchange)

    Response{
        status: Status(http_host.status(exchange)),
        headers: Headers(pairs(http_host.headers(exchange))),
        body:,
        trailers: Headers(pairs(http_host.trailers(exchange))),
        protocol: Protocol{major:, minor:},
        url: Url.parse(http_host.final_url(exchange)) |> Result.to_maybe(),
        content_length: if length < 0 then None else Some(length),
        transfer_encoding: http_host.transfer_encoding(exchange),
        close: http_host.closes(exchange),
        uncompressed: http_host.uncompressed(exchange),
        tls: http_host.exchange_tls(exchange) |> Maybe.map(tls.ConnectionState.of_parts),
    }
end

/// How a server listens and responds. A timeout of `None` is none.
pub struct Server
    /// The address to listen on, `host:port`, as Go's `Server.Addr`:
    /// `:http` is port 80 on every interface. Port 0 picks a free one,
    /// which `Listener.address` reports.
    address: String = ":http"
    /// The longest a client may take to send a whole request.
    read_timeout: Maybe<Duration> = None
    /// The longest a client may take to send a request's headers.
    read_header_timeout: Maybe<Duration> = None
    /// The longest writing a response may take.
    write_timeout: Maybe<Duration> = None
    /// The longest a kept-alive connection waits for its next request.
    idle_timeout: Maybe<Duration> = None
    /// The largest request header, in bytes: Go's `DefaultMaxHeaderBytes`.
    max_header_bytes: Int = 1_048_576
    /// The largest request body, in bytes: each request is limited as
    /// `Request.limit_body` limits it, which replaces the form readers'
    /// defaults. `None` leaves bodies unlimited but for those defaults.
    max_body: Maybe<Int> = None
    /// Whether connections are kept open between requests.
    keep_alives: Bool = True
    /// A deadline for each request's handler, on its context.
    request_timeout: Maybe<Duration> = None
    /// How long `serve` waits for requests in flight when it stops.
    shutdown_timeout: Duration = Duration.seconds(5)
    /// Serves HTTPS with this configuration, as Go's `ListenAndServeTLS`
    /// does, HTTP/2 included; `None` serves plain HTTP.
    tls: Maybe<tls.ServerConfig> = None
    /// The most values one request header may hold: Go's
    /// `DefaultMaxHeaderValueCount`, 500, when `None`.
    max_header_value_count: Maybe<Int> = None
    /// Responds to `OPTIONS *` itself, as Go does; `False` hands it to the
    /// handler.
    answer_options_star: Bool = True
    /// Honours the priorities HTTP/2 and HTTP/3 clients ask for.
    client_priority: Bool = True
    /// The protocols the server accepts; `None` is Go's choice, HTTP/1
    /// and, over TLS, HTTP/2.
    protocols: Maybe<Protocols> = None
    http2: Http2Options = Http2Options{}
    /// Told each connection's address as its state changes. Go's
    /// `ConnState`. It runs on the task serving, in order.
    on_connection_state: Maybe<(String, ConnState) -> Unit> = None
    /// Told each error Go logs about the server's connections, a line at a
    /// time; `None` writes them to standard error. Go's `ErrorLog`.
    on_error: Maybe<(String) -> Unit> = None
    /// Runs when the server starts shutting down, as for connections that
    /// were upgraded, which the shutdown does not track. Go's
    /// `RegisterOnShutdown`.
    on_shutdown: Maybe<() -> Unit> = None
end

fn conn_state(code: Int) -> ConnState
    case code
        0 -> ConnState.New
        1 -> ConnState.Active
        2 -> ConnState.Idle
        3 -> ConnState.Hijacked
        _ -> ConnState.Closed
    end
end

/// A server listening for requests: `listen` binds it, and `serve` responds to
/// what arrives.
pub struct Listener
    handle: http_host.Listener
    server: Server
end

impl Listener
    /// The address the server is bound to, with the port it picked when
    /// its address asked for port 0.
    pub fn address(listener: Listener) -> String
        http_host.address(listener.handle)
    end

    /// Stops the server as Go's `Server.Shutdown` does: it stops accepting,
    /// waits up to the server's `shutdown_timeout` for the requests it is
    /// serving, then closes every connection. A second call does nothing.
    pub fn shutdown(listener: Listener) -> Unit
        http_host.shutdown(listener.handle, Duration.as_nanos(listener.server.shutdown_timeout))
    end

    /// Closes every connection the server holds, idle or busy; the server
    /// goes on accepting.
    pub fn close_connections(listener: Listener) -> Unit
        http_host.close_connections(listener.handle)
    end
end

/// Binds the server's address. The server accepts connections from here
/// on; `serve` responds to the requests they send.
pub fn listen(server: Server = Server{}) -> Result<Listener, Error>
    durations = [
        nanos(server.read_timeout),
        nanos(server.read_header_timeout),
        nanos(server.write_timeout),
        nanos(server.idle_timeout),
        Duration.as_nanos(server.shutdown_timeout),
    ]

    limits = [server.max_header_bytes, Maybe.with_default(server.max_header_value_count, 0)]
    flags = [server.keep_alives, server.answer_options_star, server.client_priority]

    on_state = case server.on_connection_state
        Some(told) -> fn address: String, code: Int -> told(address, conn_state(code))
        None -> fn _: String, _: Int -> Unit
    end

    on_error = Maybe.with_default(server.on_error, ignore_text)
    on_shutdown = Maybe.with_default(server.on_shutdown, fn -> Unit)
    on_count = Maybe.with_default(server.http2.on_error_count, ignore_text)

    handle =
        case server.tls
            None ->
                http_host.listen(
                    server.address,
                    durations,
                    limits,
                    flags,
                    protocol_flags(server.protocols),
                    Maybe.is_some(server.protocols),
                    http2_numbers(server.http2),
                    http2_flags(server.http2),
                    on_state,
                    Maybe.is_some(server.on_connection_state),
                    on_error,
                    Maybe.is_some(server.on_error),
                    on_shutdown,
                    Maybe.is_some(server.on_shutdown),
                    on_count,
                    Maybe.is_some(server.http2.on_error_count),
                )

            Some(config) ->
                host =
                    tls.ServerConfig.host(config)
                    |> Result.map_err(fn e -> Error.Tls{reason: "${e}"})?

                http_host.listen_tls(
                    server.address,
                    durations,
                    limits,
                    flags,
                    protocol_flags(server.protocols),
                    Maybe.is_some(server.protocols),
                    http2_numbers(server.http2),
                    http2_flags(server.http2),
                    on_state,
                    Maybe.is_some(server.on_connection_state),
                    on_error,
                    Maybe.is_some(server.on_error),
                    on_shutdown,
                    Maybe.is_some(server.on_shutdown),
                    on_count,
                    Maybe.is_some(server.http2.on_error_count),
                    host,
                )
        end
        |> Result.map_err(Error.from_parts)?

    Ok(Listener{handle:, server:})
end

/// Serves each request `listener` receives with `handler`, each as a task
/// of `supervisor`, so its `max_running` bounds the requests served at
/// once. Returns when the calling task is stopped, as at shutdown, after
/// shutting the listener down.
///
/// A handler runs under the request's context: the context in force here,
/// with the server's `request_timeout` as a deadline. The app's `Context`
/// field reads it while the handler runs, and `request.context` holds it.
/// The handler's task is stopped when the client goes away. A handler that
/// traps sends a 500. Use a supervisor that does not restart its tasks
/// (`Restart.Temporary`, the default); a restarted handler sends nothing.
///
/// When the program shuts down, at a signal or when `main` returns, the
/// server stops accepting at once, as Go's `Server.Shutdown` does. The
/// requests it took run to their end, for up to the server's
/// `shutdown_timeout` and the supervisor's, and then `serve` returns.
pub fn serve(listener: Listener, handler: Handler, supervisor: Supervisor) -> Unit
    defer Listener.shutdown(listener)
    accept(listener, handler, supervisor)
end

fn accept(listener: Listener, handler: Handler, supervisor: Supervisor) -> Unit
    case http_host.next(listener.handle)
        Some(incoming) ->
            _ = Supervisor.spawn(supervisor, fn -> answer(listener, incoming, handler))
            accept(listener, handler, supervisor)

        None ->
            Unit
    end
end

fn answer(listener: Listener, incoming: http_host.Incoming, handler: Handler) -> Unit
    if http_host.answered_already(incoming) then return Unit
    defer http_host.finish(incoming, [])

    timeout =
        listener.server.request_timeout |> Maybe.map(Duration.as_nanos) |> Maybe.with_default(-1)

    http_host.run_request(incoming, timeout, fn context ->
        request = request_of(incoming, context)

        limited = case listener.server.max_body
            Some(max) -> Request.limit_body(request, max)
            None -> request
        end

        respond(incoming, ToResponse.to_response(handler(limited)))
    end)
end

fn request_of(incoming: http_host.Incoming, context: Context) -> Request
    (major, minor) = case http_host.in_protocol(incoming)
        [a, b] -> (a, b)
        _ -> (1, 1)
    end

    length = http_host.in_content_length(incoming)
    host = http_host.in_host(incoming)
    local_address = http_host.in_local(incoming)
    connection = http_host.in_tls(incoming) |> Maybe.map(tls.ConnectionState.of_parts)

    Request{
        method: Method.parse(http_host.in_method(incoming)),
        url: served_url(
            Url.parse(http_host.in_url(incoming))!,
            host,
            local_address,
            connection is Some(_),
        ),
        headers: Headers(pairs(http_host.in_headers(incoming))),
        body: Body.Stream(http_host.in_body(incoming)),
        host: Some(host),
        content_length: if length < 0 then None else Some(length),
        transfer_encoding: http_host.in_transfer_encoding(incoming),
        close: http_host.in_close(incoming),
        protocol: Protocol{major:, minor:},
        remote_address: http_host.in_remote(incoming),
        request_uri: http_host.in_target(incoming),
        context:,
        local_address:,
        tls: connection,
        incoming: Some(incoming),
    }
end

/// A served request's URL made absolute, as a client wrote it: `https` over
/// TLS and `http` otherwise, and the `Host` it asked for, or the address it
/// reached when it sent none. A target that is already absolute (a proxy's
/// request) and `OPTIONS *` stay as they came.
fn served_url(target: Url, host: String, local_address: String, secure: Bool) -> Url
    if target.host != "" or not String.starts_with(target.path, "/") then return target

    {
        ..target,
        scheme: if secure then "https" else "http",
        host: if host == "" then local_address else host,
    }
end

fn respond(incoming: http_host.Incoming, response: Response) -> Unit
    status = Status.code(response.status)
    headers = flat(typed(response.headers, response.body))
    empty = String.to_bytes("")
    write_timeout = nanos(response.write_timeout)

    if Some(on_connection) = response.upgrade then
        if Ok(conn) = http_host.upgrade(incoming, status, flat(response.headers)) then
            connection = net.Connection.of_handle(conn)
            defer net.Connection.close(connection)
            on_connection(connection)
        end

        return http_host.finish(incoming, [])
    end

    case response.body
        .Produce(produce) ->
            Headers(trailers) = response.trailers
            names = trailers |> Iter.map(fn (k, _) -> k) |> Iter.to_list()

            writer = http_host.produce(
                incoming,
                status,
                headers,
                names,
                write_timeout,
                response.full_duplex,
            )

            _ = produce(writer)
            _ = io.Writer.close(writer)
            http_host.finish(incoming, flat(response.trailers))

        .Empty ->
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                0,
                empty,
                Reader.from_bytes(empty),
                length_of(response),
                write_timeout,
                response.full_duplex,
            )

        .Stream(r) ->
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                2,
                empty,
                r,
                length_of(response),
                write_timeout,
                response.full_duplex,
            )

        other ->
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                1,
                Body.bytes_of(other),
                Reader.from_bytes(empty),
                length_of(response),
                write_timeout,
                response.full_duplex,
            )
    end
end

fn length_of(response: Response) -> Int
    Maybe.with_default(response.content_length, -1)
end

/// A pattern a `Router` routes by, as Go's `ServeMux` reads it:
/// `[METHOD ][HOST]/PATH`, where a path segment `{name}` matches one
/// segment, a last `{name...}` the rest of the path, and `{$}` only the
/// end. A pattern with no method matches every method.
///
/// `P` is the route's path parameters: an anonymous struct with a field
/// per wildcard, `Route<{id: Uuid}>` for `GET /posts/{id}`, or `Unit` for
/// a route with none, which is the default: a `Route` is a `Route<Unit>`. A
/// field's type implements `Parse` and `Display`, and a `{rest...}` field
/// is a `String`. A literal with no expected type has
/// a `String` field per wildcard, so ``Route`GET /users/{id}` `` is a
/// `Route<{id: String}>`; a typed one names its fields' types:
/// `post: Route<{id: Uuid}> = "GET /posts/{id}"`. `Route.to_with` hands a
/// handler the parsed parameters and `Route.path_with` fills them into a
/// link. The parameters are a type only: a `Route` holds its text.
///
/// Two rules are stricter than Go's. The method is one of `Method`'s
/// named variants, written in capitals as on the wire (`GET`, `HEAD`,
/// `POST`, `PUT`, `PATCH`, `DELETE`, `CONNECT`, `OPTIONS`, `TRACE`), so a
/// misspelled `GETX` is an error rather than a route no request reaches;
/// `Route.with_method` takes any other. A `{` or `}` appears only in a
/// wildcard that is a whole segment, so `/token}` is an error rather than
/// a literal segment; a path that needs a brace percent-encodes it
/// (`%7B`, `%7D`).
///
/// A `Route` literal is checked when the program is checked, so a pattern
/// that breaks these rules, that Go refuses, or whose wildcards are not
/// `P`'s fields is a compile error at the literal. A pattern built at run
/// time goes through `Route.parse`.
//! assert "${Route`GET /users/{id}`}" == "GET /users/{id}"
//! assert Route.parse<Unit>("GET /a/{x}/{x}") |> Result.is_err()
//! assert Route.parse<{rest: String}>("/files/{rest...}/more") |> Result.is_err()
//! assert Route.parse<Unit>("GETX /complete-profile/token}") |> Result.is_err()
//! assert Route.parse<Unit>("/a/%7Bliteral%7D") |> Result.is_ok()
//
pub opaque type Route<P = Unit> String

derive Equatable for Route
derive Hashable for Route

impl Route<P>
    /// The route `text` names, or `Error.Pattern` with the reason when
    /// it breaks `Route`'s rules, Go's `ServeMux` refuses it, or its
    /// wildcards are not `P`'s fields. The method, when there is one, is a
    /// standard one in capitals; a near miss names the method it is close
    /// to.
    //! assert Route.parse("POST /orders") == Ok(Route`POST /orders`)
    //! assert Err(Error.Pattern{reason:}) = Route.parse<Unit>("GET users")
    //! assert String.contains(reason, "/")
    //!
    //! assert Route.parse<Unit>("GETX /complete-profile") == Err(Error.Pattern{
    //!         pattern: "GETX /complete-profile",
    //!         reason: "unknown method `GETX`; did you mean `GET`?",
    //!     })
    //!
    //! assert Err(Error.Pattern{reason: lower}) = Route.parse<Unit>("get /orders")
    //! assert lower == "unknown method `get`; did you mean `GET`?"
    //!
    //! assert Err(Error.Pattern{reason: webdav}) = Route.parse<Unit>("PROPFIND /files")
    //! assert webdav == "unknown method `PROPFIND`; a route's method is GET, HEAD, POST, PUT, PATCH, DELETE, CONNECT, OPTIONS or TRACE, and `Route.with_method` takes any other"
    //!
    //! assert Err(Error.Pattern{reason: closing}) = Route.parse<Unit>("GET /complete-profile/token}")
    //! assert closing == "a `}` outside a wildcard; a wildcard is a whole segment, `{name}`"
    //!
    //! assert Err(Error.Pattern{reason: opening}) = Route.parse<Unit>("/files/v{n}")
    //! assert opening == "a `{` outside a wildcard; a wildcard is a whole segment, `{name}`"
    //!
    //! assert Route.parse<{id: Int}>("GET /items/{id}") |> Result.is_ok()
    //! assert Err(Error.Pattern{reason: fields}) = Route.parse<{id: Int}>("GET /items/{key}")
    //! assert fields == "the pattern's wildcards are {key}, and the parameters' fields are id"
    //
    pub fn parse<P>(text: String) -> Result<Route<P>, Error> where P: ParseFields
        case pattern_reason(text)
            Some(reason) -> Err(Error.Pattern{pattern: text, reason:})
            None -> fields_rule(text, P.field_names())
        end
    end

    /// The route of `method` on `path` (`[HOST]/PATH`), for a method a
    /// `Route` literal does not take: one `Method.Other` holds, such as
    /// WebDAV's `PROPFIND`. A standard method is written in the literal,
    /// ``Route`GET /files` ``. The path keeps the literal's rule for
    /// braces, the method is a token Go accepts, with no space, and the
    /// wildcards are `P`'s fields, as `Route.parse` holds them.
    //! import std::http.{Body, Method, Request, Response, Route, Router}
    //! import std::http_testing
    //!
    //! propfind = Route.with_method<{name: String}>(Method.Other("PROPFIND"), "/files/{name}")!
    //! assert "${propfind}" == "PROPFIND /files/{name}"
    //!
    //! router = Router.new([Route.to_with(propfind, fn _, p -> Response{body: Body.Text(p.name)})])!
    //!
    //! answer = Router.serve(router, http_testing.request(Method.Other("PROPFIND"), "/files/a.txt"))
    //! assert Response.text(answer) == Ok("a.txt")
    //!
    //! assert Route.with_method<Unit>(Method.Get, "/a") == Ok(Route`GET /a`)
    //! assert Route.with_method<Unit>(Method.Other(""), "/a") |> Result.is_err()
    //! assert Route.with_method<Unit>(Method.Other("PROP FIND"), "/a") |> Result.is_err()
    //! assert Route.with_method<Unit>(Method.Other("PROPFIND"), "/a}") |> Result.is_err()
    //
    pub fn with_method<P>(
        method: Method,
        path: String,
    ) -> Result<Route<P>, Error> where P: ParseFields
        name = Method.text(method)
        text = "${name} ${path}"

        if name == "" then
            Err(Error.Pattern{pattern: text, reason: "the method is empty"})
        else if String.contains(name, " ") or String.contains(name, "\t") then
            Err(Error.Pattern{pattern: text, reason: "the method `${name}` has a space"})
        else
            case brace_or_mux_reason(text)
                Some(reason) -> Err(Error.Pattern{pattern: text, reason:})
                None -> fields_rule(text, P.field_names())
            end
        end
    end

    /// The path a route with no parameters matches, for a link: the
    /// pattern without its method or host, and a `{$}` dropped. A route
    /// with parameters fills them with `Route.path_with`.
    //! assert "${Route.path(Route`GET /about`)}" == "/about"
    //! assert "${Route.path(Route`GET example.com/docs/{$}`)}" == "/docs/"
    //
    pub fn path(route: Route) -> Url
        Route.path_with(route, Unit)
    end

    /// The path the route matches with `params` in its wildcards, for a
    /// link: each field's `Display` text escaped as one path segment, a
    /// `{rest...}` field's text escaped segment by segment, and the
    /// pattern's method and host left out.
    //! users = Route`GET /users/{name}/posts/{rest...}`
    //! link = Route.path_with(users, {name: "ann b", rest: "2024/a?b"})
    //! assert "${link}" == "/users/ann%20b/posts/2024/a%3Fb"
    //
    pub fn path_with<P>(route: Route<P>, params: P) -> Url where P: ParseFields
        Route(text) = route
        values = parse.write_fields(params) |> Iter.to_map()
        path = route_path(text)

        filled =
            String.split(path, "/")
            |> Iter.map(fn segment ->
                case wildcard_of(segment)
                    Some((name, True)) ->
                        Map.get(values, name)
                        |> Maybe.with_default("")
                        |> String.split("/")
                        |> Iter.map(url.escape_path_segment)
                        |> String.join("/")

                    Some((name, False)) ->
                        Map.get(values, name) |> Maybe.with_default("") |> url.escape_path_segment()

                    None ->
                        if segment == "{$}" then "" else segment
                end
            end)

        Url.parse(String.join(Iter.to_list(filled), "/"))!
    end

    /// The router entry that sends a request the route matches to
    /// `handler`, for a route with no parameters. A route with parameters
    /// hands them to its handler with `Route.to_with`.
    pub fn to(route: Route, handler: Handler) -> Entry
        Route(pattern) = route
        Entry{pattern:, serve: fn request -> Some(ToResponse.to_response(handler(request)))}
    end

    /// The router entry that sends a request the route matches to
    /// `handler`, with its path parameters read into `P`, each wildcard's
    /// text by its field's `Parse`. A request whose wildcard text does not
    /// parse gets `404`, as if no route matched: `GET /posts/{id}` with an
    /// `id: Int` does not match `/posts/latest`.
    //! import std::http.{Body, Method, Response, Route, Router, Status}
    //! import std::http_testing
    //!
    //! item: Route<{id: Int}> = "GET /items/{id}"
    //!
    //! router = Router.new(
    //!     [Route.to_with(item, fn _, p -> Response{body: Body.Text("item ${p.id + 1}")})]
    //! )!
    //!
    //! answer = fn target: String -> Router.serve(router, http_testing.request(Method.Get, target))
    //! assert Response.text(answer("/items/7")) == Ok("item 8")
    //! assert answer("/items/x").status == Status.not_found
    //
    pub fn to_with<P>(
        route: Route<P>,
        handler: (Request, P) -> ToResponse,
    ) -> Entry where P: ParseFields
        Route(pattern) = route

        Entry{
            pattern:,
            serve: fn request ->
                params = parse.read_fields<P>(request.path_values)
                Maybe.map(params, fn p -> ToResponse.to_response(handler(request, p)))
            end,
        }
    end
end

/// A route and the handler it sends requests to, for `Router.new`:
/// `Route.to` and `Route.to_with` make one. It leaves out the route's
/// parameters type, so routes with different parameters fit one list.
pub opaque struct Entry
    pattern: String
    serve: (Request) -> Maybe<Response>
end

impl Display for Entry
    fn to_string(entry: Entry) -> String
        entry.pattern
    end
end

/// The methods a `Route` literal takes, `Method`'s named variants.
fn route_methods() -> List<String>
    ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "CONNECT", "OPTIONS", "TRACE"]
end

/// Why `text`'s method is not one a `Route` takes, when it has one. Go
/// splits the method off at the first space or tab; a first word with a
/// `/` in it is no method, and Go's own check names it.
fn method_rule(text: String) -> Maybe<String>
    spaced = String.replace(text, "\t", " ")
    word = String.split(spaced, " ") |> List.head() |> Maybe.with_default("")

    if not String.contains(spaced, " ") or word == "" or String.contains(word, "/") then
        None
    else if Iter.any_match(route_methods(), &(&1 == word)) then
        None
    else
        upper = String.uppercase(word)

        guess = if Iter.any_match(route_methods(), &(&1 == upper)) then
            Some(upper)
        else
            Iter.find(route_methods(), &one_edit_apart(upper, &1))
        end

        case guess
            Some(m) ->
                Some("unknown method `${word}`; did you mean `${m}`?")

            None ->
                Some(
                    "unknown method `${word}`; a route's method is GET, HEAD, POST, PUT, PATCH, DELETE, CONNECT, OPTIONS or TRACE, and `Route.with_method` takes any other"
                )
        end
    end
end

/// Whether one insertion, deletion or substitution turns `a` into `b`.
fn one_edit_apart(a: String, b: String) -> Bool
    la = String.length(a)
    lb = String.length(b)

    if la == lb then
        differ =
            0..la |> Iter.filter(fn i -> String.slice(a, i, i + 1) != String.slice(b, i, i + 1))

        Iter.count(differ) == 1
    else if la == lb + 1 then
        Iter.any_match(0..la, fn i -> String.take(a, i) + String.drop(a, i + 1) == b)
    else if lb == la + 1 then
        one_edit_apart(b, a)
    else
        False
    end
end

/// Why `text` has a brace outside a wildcard, when it does: a `{` or
/// `}` before the path, or in a segment that is not `{...}` as a whole.
fn brace_rule(text: String) -> Maybe<String>
    case String.split(text, "/")
        [prefix, ..segments] ->
            case brace_in_segment(prefix, False)
                Some(reason) -> Some(reason)
                None -> Iter.find_map(segments, &brace_in_segment(&1, True))
            end

        [] ->
            None
    end
end

/// The reason `segment` has a stray brace, when it does. Only a path
/// segment (`in_path`) may be a wildcard.
fn brace_in_segment(segment: String, in_path: Bool) -> Maybe<String>
    opening = String.find_all(segment, "{") |> Iter.count()
    closing = String.find_all(segment, "}") |> Iter.count()
    wildcard = in_path and String.starts_with(segment, "{") and String.ends_with(segment, "}")

    if opening == 0 and closing == 0 or wildcard and opening == 1 and closing == 1 then
        None
    else if opening > 1 or opening == 1 and not (in_path and String.starts_with(segment, "{")) then
        Some(stray_brace("{"))
    else if closing > 0 then
        Some(stray_brace("}"))
    else
        Some(stray_brace("{"))
    end
end

fn stray_brace(brace: String) -> String
    "a `${brace}` outside a wildcard; a wildcard is a whole segment, `{name}`"
end

/// Why `text` is not a route pattern, by `Route`'s rules and then Go's,
/// when it is not one.
fn pattern_reason(text: String) -> Maybe<String>
    case method_rule(text)
        Some(reason) -> Some(reason)
        None -> brace_or_mux_reason(text)
    end
end

/// Why `text`'s braces break `Route`'s rule, or else why Go refuses it.
fn brace_or_mux_reason(text: String) -> Maybe<String>
    case brace_rule(text)
        Some(reason) -> Some(reason)
        None -> mux_reason(text)
    end
end

/// Go's reason its `ServeMux` refuses `text`, when it does.
fn mux_reason(text: String) -> Maybe<String>
    case http_host.check_pattern(text)
        "" -> None
        reason -> Some(reason)
    end
end

/// The route `text` names when its wildcards are `names`, the parameters'
/// fields; `Error.Pattern` otherwise.
fn fields_rule<P>(text: String, names: List<String>) -> Result<Route<P>, Error>
    wildcards = route_wildcards(text) |> Iter.map(fn (name, _, _) -> name) |> Iter.to_list()

    if Iter.sort(wildcards) == Iter.sort(names) then
        Ok(Route(text))
    else
        have = wildcards |> Iter.map(fn n -> "{${n}}") |> Iter.to_list()

        reason = case (have, names)
            ([], _) ->
                "the pattern has no wildcards, and the parameters' fields are ${String.join(names, ", ")}"

            (_, []) ->
                "the pattern's wildcards are ${String.join(have, ", ")}, and the parameters have no fields"

            _ ->
                "the pattern's wildcards are ${String.join(have, ", ")}, and the parameters' fields are ${String.join(names, ", ")}"
        end

        Err(Error.Pattern{pattern: text, reason:})
    end
end

/// The path of a route pattern: what follows its method and its host.
fn route_path(text: String) -> String
    spaced = String.replace(text, "\t", " ")

    after_method = case String.split(spaced, " ")
        [word, ..rest] when rest != [] and not String.contains(word, "/") ->
            String.join(rest, " ") |> String.trim()

        _ ->
            spaced
    end

    case String.split(after_method, "/")
        [_, ..segments] -> "/" + String.join(segments, "/")
        [] -> after_method
    end
end

/// A path segment's wildcard name, and whether it is a `{name...}` one,
/// when the segment is a wildcard; `{$}` is none.
fn wildcard_of(segment: String) -> Maybe<(String, Bool)>
    if not String.starts_with(segment, "{")
        or not String.ends_with(segment, "}")
        or segment == "{$}" then
        None
    else
        inner = String.slice(segment, 1, String.length(segment) - 1)

        case String.strip_suffix(inner, "...")
            Some(name) -> Some((name, True))
            None -> Some((inner, False))
        end
    end
end

/// Each wildcard of the pattern `text`: its name, whether it takes the
/// rest of the path, and the code point offset of its `{`.
fn route_wildcards(text: String) -> List<(String, Bool, Int)>
    path = route_path(text)
    start = String.length(text) - String.length(path)

    (_, found) = Iter.reduce(String.split(path, "/"), (start, []), fn acc, segment ->
        (at, found) = acc

        found = case wildcard_of(segment)
            Some((name, rest)) -> [..found, (name, rest, at)]
            None -> found
        end

        (at + String.length(segment) + 1, found)
    end)

    found
end

/// The fields of the anonymous struct `spelling` names, each its name and
/// its type's spelling, as a checked literal's `check_type` gets them:
/// `{id: Uuid, tags: Map<String, Int>}`. `Some([])` for `Unit`, and
/// `None` for any other type.
fn param_fields(spelling: String) -> Maybe<List<(String, String)>>
    if spelling == "Unit" then return Some([])

    if not String.starts_with(spelling, "{") or not String.ends_with(spelling, "}") then return None

    body = String.slice(spelling, 1, String.length(spelling) - 1)

    (parts, last, _) = Iter.reduce(String.to_codepoints(body), ([], "", 0), fn acc, cp ->
        (parts, current, depth) = acc
        c = Codepoint.to_string(cp)

        case c
            "<" or "(" or "{" -> (parts, current + c, depth + 1)
            ">" or ")" or "}" -> (parts, current + c, depth - 1)
            "," when depth == 0 -> ([..parts, current], "", depth)
            _ -> (parts, current + c, depth)
        end
    end)

    [..parts, last]
    |> Iter.map(fn part ->
        case String.split(part, ":")
            [name, ..rest] when rest != [] ->
                Some((String.trim(name), String.trim(String.join(rest, ":"))))

            _ ->
                None
        end
    end)
    |> Maybe.collect()
end

/// Why the pattern `text` does not fit the parameters spelled `params`:
/// a wildcard with no field, a field with no wildcard, a `{rest...}`
/// field that is not a `String`, or parameters that are not `Unit` or an
/// anonymous struct. The error names the wildcard's `{`, or the literal.
fn params_error(text: String, params: String) -> Maybe<LiteralError>
    case param_fields(params)
        None ->
            Some(LiteralError{
                fragment: 0,
                offset: 0,
                message: "a route's parameters are `Unit` or an anonymous struct with a field per wildcard, not `${params}`",
            })

        Some(fields) ->
            wildcards = route_wildcards(text)

            missing = Iter.find_map(wildcards, fn (name, rest, at) ->
                case Iter.find(fields, fn (f, _) -> f == name)
                    None when params == "Unit" ->
                        Some(LiteralError{
                            fragment: 0,
                            offset: at,
                            message: "the pattern has `{${name}}`, and a `Route` has no parameters; a route with them goes to `Route.path_with` or `Route.to_with`",
                        })

                    None ->
                        Some(
                            LiteralError{
                                fragment: 0,
                                offset: at,
                                message: "the pattern has `{${name}}`, but `${params}` has no field `${name}`",
                            }
                        )

                    Some((_, ty)) when rest and ty != "String" ->
                        Some(LiteralError{
                            fragment: 0,
                            offset: at,
                            message: "`{${name}...}` matches the rest of the path, so its field is a `String`, not `${ty}`",
                        })

                    Some(_) ->
                        None
                end
            end)

            case missing
                Some(e) ->
                    Some(e)

                None ->
                    Iter.find_map(fields, fn (f, _) ->
                        if Iter.any_match(wildcards, fn (name, _, _) -> name == f) then
                            None
                        else
                            Some(
                                LiteralError{
                                    fragment: 0,
                                    offset: 0,
                                    message: "`${params}` has a field `${f}`, but the pattern has no `{${f}}`",
                                }
                            )
                        end
                    end)
            end
    end
end

impl CheckedLiteral<String, Route<P>> for Route<P>
    fn check(statics: List<String>) -> Result<Unit, LiteralError>
        case statics
            [text] ->
                case pattern_reason(text)
                    Some(reason) ->
                        Err(
                            LiteralError{
                                fragment: 0,
                                offset: 0,
                                message: "pattern ${text}: ${reason}",
                            }
                        )

                    None ->
                        Ok(Unit)
                end

            [first, ..] ->
                Err(
                    LiteralError{
                        fragment: 0,
                        offset: String.length(first),
                        message: "a route takes no slots; build one at run time with `Route.parse`",
                    }
                )

            [] ->
                Ok(Unit)
        end
    end

    fn check_type(statics: List<String>, arguments: List<String>) -> Result<Unit, LiteralError>
        check(statics)?

        case (statics, arguments)
            ([text], [params]) ->
                case params_error(text, params)
                    Some(e) -> Err(e)
                    None -> Ok(Unit)
                end

            _ ->
                Ok(Unit)
        end
    end

    fn build(fragments: List<Fragment<String>>) -> Route<P>
        text = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        Route(text)
    end
end

impl Display for Route<P>
    fn to_string(route: Route<P>) -> String
        Route(text) = route
        text
    end
end

/// Routes requests to handlers by pattern, with the rules of Go's
/// `ServeMux`: `[METHOD ][HOST]/PATH`, where a path segment `{name}`
/// matches one segment, a last `{name...}` the rest of the path, and
/// `{$}` only the end. The most specific pattern wins; `GET` also matches
/// `HEAD`. A request whose path is not clean, or that lacks a trailing
/// slash a pattern has, is redirected; one whose path matches only under
/// another method gets 405 with `Allow`; anything else gets 404.
//! import std::http.{Body, Method, Request, Response, Route, Router, Status}
//! import std::http_testing
//!
//! router = Router.new([
//!     Route.to_with("GET /users/{id}", fn _, p -> Response{body: Body.Text("user ${p.id}")}),
//!     Route.to("/files/", fn r -> Response{body: Body.Text(r.url.path)}),
//!     Route.to_with("/raw/{path...}", fn r, _ -> Response{
//!         body: Body.Text(Request.path_value(r, "path")!),
//!     }),
//! ])!
//!
//! user = Router.serve(router, http_testing.request(Method.Get, "/users/7"))
//! assert Response.text(user) == Ok("user 7")
//!
//! assert Response.text(Router.serve(router, http_testing.request(Method.Get, "/raw/a/b.txt")))
//!     == Ok("a/b.txt")
//!
//! assert Router.serve(router, http_testing.request(Method.Post, "/users/7")).status
//!     == Status.method_not_allowed
//!
//! assert Router.serve(router, http_testing.request(Method.Get, "/nope")).status == Status.not_found
//
pub struct Router
    mux: http_host.Mux
    handlers: List<(Request) -> Maybe<Response>>
end

impl Router
    /// A router over `routes`, each a route and its handler from
    /// `Route.to` or `Route.to_with`, in order. A pattern that conflicts
    /// with an earlier one, matching the same requests with neither more
    /// specific, is `Error.Pattern`, where Go's `Handle` panics. Each
    /// pattern on its own was checked when it became a `Route`.
    //! import std::http.{Error, Response, Route, Router}
    //!
    //! conflict = Router.new(
    //!     [Route.to_with("/a/{x}", fn _, _ -> Response{}), Route.to_with("/a/{y}", fn _, _ -> Response{})]
    //! )
    //!
    //! assert Result.is_err(conflict)
    //
    pub fn new(routes: List<Entry>) -> Result<Router, Error>
        patterns = routes |> Iter.map(fn e -> e.pattern) |> Iter.to_list()
        mux = http_host.new_mux(patterns) |> Result.map_err(Error.from_parts)?
        Ok(Router{mux:, handlers: routes |> Iter.map(fn e -> e.serve) |> Iter.to_list()})
    end

    /// The pattern that matches `request`, or `None` when none does, as
    /// Go's `ServeMux.Handler` finds it.
    pub fn find(router: Router, request: Request) -> Maybe<String>
        case Router.route(router, request)
            ["match", _, pattern, ..] -> Some(pattern)
            _ -> None
        end
    end

    /// Serves `request` with the handler of the pattern that matches it,
    /// with `request.pattern` and its path values set, or with what the
    /// router sends itself: a redirect, a 405 or a 404. A route whose
    /// parameters do not parse from the request's path is a 404 too.
    pub fn serve(router: Router, request: Request) -> Response
        case Router.route(router, request)
            ["match", index, pattern, ..values] ->
                handler =
                    String.to_int(index) |> Maybe.flat_map(fn i -> Iter.get(router.handlers, i))

                found = {
                    ..request,
                    pattern: Some(pattern),
                    path_values: pairs(values) |> Iter.to_map(),
                }

                case handler |> Maybe.flat_map(fn h -> h(found))
                    Some(response) -> response
                    None -> Response.not_found()
                end

            ["answer", code, body, ..headers] ->
                Response{
                    status: Status(
                        String.to_int(code)
                        |> Maybe.with_default(500)
                    ),
                    headers: Headers(pairs(headers)),
                    body: Body.Text(body),
                }

            _ ->
                Response{status: Status.internal_server_error}
        end
    end

    /// The router as a handler, for `http.serve`.
    pub fn handler(router: Router) -> (Request) -> Response
        fn request -> Router.serve(router, request)
    end

    fn route(router: Router, request: Request) -> List<String>
        http_host.route(
            router.mux,
            Method.text(request.method),
            Maybe.with_default(request.host, ""),
            "${request.url}",
        )
    end
end

fn from_go(parts: List<String>) -> Response
    case parts
        ["answer", code, body, ..headers] ->
            answer = Headers(pairs(headers))

            status = Status(
                String.to_int(code)
                |> Maybe.with_default(500)
            )

            // A HEAD answer has no body and keeps the length the GET's would
            // have, as Go's ServeContent sends it.
            length = Headers.get(answer, "Content-Length") |> Maybe.flat_map(String.to_int)

            case length
                Some(n) when body == "" and n > 0 ->
                    Response{status:, headers: answer, body: Body.Empty, content_length: Some(n)}

                _ ->
                    Response{status:, headers: answer, body: Body.Text(body)}
            end

        _ ->
            Response{status: Status.internal_server_error}
    end
end

/// A handler that responds to every request with `Response.not_found`.
pub fn not_found(Request) -> Response
    Response.not_found()
end

/// A handler that redirects every request to `to` with `status`
/// (`Response.redirect`).
pub fn redirect_to(to: String, status: Status) -> (Request) -> Response
    fn request -> Response.redirect(request, to, status)
end

/// Middleware that removes `prefix` from the request's path, and from its
/// escaped form, before `handler` sees it, and returns 404 for a path
/// without it.
//! import std::http.{Body, Method, Request, Response}
//! import std::http_testing
//! import std::url.Url
//!
//! show = http.strip_prefix(fn r -> Response{body: Body.Text(Url.escaped_path(r.url))}, "/static")
//! assert Response.text(show(http_testing.request(Method.Get, "/static/a.css"))) == Ok("/a.css")
//! assert show(http_testing.request(Method.Get, "/a.css")).status == Status.not_found
//!
//! assert Response.text(show(http_testing.request(Method.Get, "/static/a%2Fb.css")))
//!     == Ok("/a%2Fb.css")
//
pub fn strip_prefix(handler: Handler, prefix: String) -> (Request) -> Response
    fn request ->
        // An escaped path must lose the prefix too, as Go's does.
        raw = case request.url.raw_path
            Some(r) -> String.strip_prefix(r, prefix) |> Maybe.map(Some)
            None -> Some(None)
        end

        case (String.strip_prefix(request.url.path, prefix), raw)
            (Some(rest), Some(raw_path)) ->
                ToResponse.to_response(handler({..request, url: {.., path: rest, raw_path:}}))

            _ ->
                Response.not_found()
        end
    end
end

/// Middleware that reads a `;` in the query as a `&`, for clients that
/// still separate fields with `;`. Without it, a `;` in the query is an
/// error to `Query.parse`.
//! import std::http.{self, Body, Method, Request, Response}
//! import std::http_testing
//! import std::url.{Query, Url}
//!
//! seen = http.allow_query_semicolons(fn r -> Response{
//!     body: Body.Text(Query.encode(Url.query_values(r.url))),
//! })
//!
//! response = seen(http_testing.request(Method.Get, "/?a=1;b=2"))
//! assert Response.text(response) == Ok("a=1&b=2")
//
pub fn allow_query_semicolons(handler: Handler) -> (Request) -> Response
    fn request ->
        rewritten = case request.url.query
            Some(q) when String.contains(q, ";") ->
                {..request, url: {.., query: Some(String.replace(q, ";", "&"))}}

            _ ->
                request
        end

        ToResponse.to_response(handler(rewritten))
    end
end

/// Middleware that returns `503 Service Unavailable` with `message` when
/// `handler` has not returned within `after`, and stops the handler's
/// task.
//! import std::duration.Duration
//! import std::http.{self, Body, Method, Request, Response, Status}
//! import std::http_testing
//! import std::timer
//!
//! sleepy = fn _: Request ->
//!     timer.sleep(Duration.seconds(5))
//!     Response{body: Body.Text("late")}
//! end
//!
//! slow = sleepy |> http.timeout(Duration.milliseconds(20), "too slow")
//! assert slow(http_testing.request(Method.Get, "/")).status == Status.service_unavailable
//!
//! fast = http.timeout(
//!     fn _: Request -> Response{body: Body.Text("ok")},
//!     Duration.milliseconds(20),
//!     "too slow",
//! )
//!
//! assert Response.text(fast(http_testing.request(Method.Get, "/"))) == Ok("ok")
//
pub fn timeout(handler: Handler, after: Duration, message: String) -> (Request) -> Response
    fn request ->
        concurrent
            answers: Channel<Response> = Channel.buffered(1)

            task = Task.spawn(fn ->
                _ = Sender.send(answers.sender, ToResponse.to_response(handler(request)))
            end)

            case Receiver.receive_within(answers.receiver, after)
                Ok(Some(response)) ->
                    Task.await(task)
                    response

                _ ->
                    Task.cancel(task)
                    _ = Task.outcome(task)
                    Response.error(Status.service_unavailable, message)
            end
        end
    end
end

/// A web origin, `scheme://host[:port]`, as a browser sends it in an
/// `Origin` header: no path, query, fragment or user. ``Origin`https://app.example.com` ``
/// is checked when the program is checked; `Origin.parse` checks one
/// read at run time. The scheme and host are kept in lowercase, as a
/// browser writes them, so an origin compares equal to the header's text.
//! import std::http.Origin
//!
//! assert "${Origin`HTTPS://App.Example.com:8443`}" == "https://app.example.com:8443"
//! assert Origin.parse("https://app.example.com/") |> Result.is_err()
//! assert Origin.parse("app.example.com") |> Result.is_err()
//
pub opaque type Origin String

derive Equatable for Origin
derive Hashable for Origin

impl Origin
    /// The origin `text` names, or `Error.InvalidUrl` when it is not
    /// `scheme://host[:port]`.
    //! import std::http.{Error, Origin}
    //!
    //! assert Origin.parse("http://localhost:5173") == Ok(Origin`http://localhost:5173`)
    //! assert Err(Error.InvalidUrl{url: _, reason:}) = Origin.parse("https://a.example?x=1")
    //! assert String.contains(reason, "scheme://host")
    //
    pub fn parse(text: String) -> Result<Origin, Error>
        refused = Err(Error.InvalidUrl{url: text, reason: "an origin is scheme://host[:port]"})

        case Url.parse(text)
            Ok(u) ->
                bare = u.scheme != ""
                    and u.host != ""
                    and u.user == None
                    and u.path == ""
                    and u.query == None
                    and u.fragment == None
                    and u.opaque_part == None

                if bare then
                    Ok(Origin(String.lowercase("${u.scheme}://${u.host}")))
                else
                    refused
                end

            Err(_) ->
                refused
        end
    end
end

impl Literal for Origin
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<Origin, Error>
        text = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        Origin.parse(text)
    end
end

impl Display for Origin
    fn to_string(origin: Origin) -> String
        Origin(text) = origin
        text
    end
end

/// Which cross-origin requests to let through, for
/// `cross_origin_protection`, which guards against cross-site request
/// forgery. A `GET`, `HEAD` or `OPTIONS` always passes.
pub struct CrossOrigin
    /// Origins whose requests pass.
    trusted_origins: List<Origin> = []
    /// `Router` patterns whose requests pass unchecked. A pattern ending
    /// in `/` matches every path under it.
    bypass_patterns: List<Route> = []
    /// The handler a refused request goes to; `None` returns `403
    /// Forbidden`.
    deny: Maybe<Handler> = None
end

impl CrossOrigin
    /// Whether `request` passes: a safe method passes; then a
    /// `Sec-Fetch-Site` of `same-origin` or `none`, or else an `Origin`
    /// whose host is the request's `Host`, or none at all (not a browser);
    /// and any request from a trusted origin. An empty header counts as
    /// missing. The bypass patterns are `cross_origin_protection`'s to
    /// apply. The check is Go's `CrossOriginProtection.Check`, with its
    /// reasons.
    //! import std::http.{CrossOrigin, Method, Origin, Request}
    //! import std::http_testing
    //!
    //! post = http_testing.request(Method.Post, "/pay")
    //!
    //! from = fn site: String -> {
    //!     ..post,
    //!     headers: Headers[("Sec-Fetch-Site", site), ("Origin", "https://evil.example")],
    //! }
    //!
    //! assert CrossOrigin.check(CrossOrigin{}, from("same-origin")) == Ok(Unit)
    //! assert CrossOrigin.check(CrossOrigin{}, from("cross-site")) |> Result.is_err()
    //!
    //! trusting = CrossOrigin{trusted_origins: [Origin`https://evil.example`]}
    //! assert CrossOrigin.check(trusting, from("cross-site")) == Ok(Unit)
    //!
    //! no_origin = {..post, headers: Headers[("Sec-Fetch-Site", ""), ("Origin", "")]}
    //! assert CrossOrigin.check(CrossOrigin{}, no_origin) == Ok(Unit)
    //
    pub fn check(options: CrossOrigin, request: Request) -> Result<Unit, Error>
        trusted = options.trusted_origins |> Iter.map(fn o -> "${o}") |> Iter.to_list()
        host = Maybe.with_default(request.host, "")
        method = Method.text(request.method)

        case http_host.cross_origin_check(method, host, flat(request.headers), trusted)
            "" -> Ok(Unit)
            reason -> Err(Error.CrossOrigin{reason:})
        end
    end
end

/// Middleware that sends a request
/// `CrossOrigin.check` refuses to `options.deny`, or returns `403`, and
/// passes one that matches a bypass pattern unchecked. Each `Origin` was
/// checked when it was made, so the middleware itself cannot fail.
//! import std::http.{self, Body, CrossOrigin, Method, Request, Response, Route, Status}
//! import std::http_testing
//!
//! pay = fn _: Request -> Response{body: Body.Text("paid")}
//! app = pay |> http.cross_origin_protection(CrossOrigin{bypass_patterns: ["POST /hooks/"]})
//!
//! post = fn path: String -> {
//!     ..http_testing.request(Method.Post, path),
//!     headers: Headers[("Sec-Fetch-Site", "cross-site")],
//! }
//!
//! assert app(post("/pay")).status == Status.forbidden
//! assert app(post("/hooks/stripe")).status == Status.ok
//
pub fn cross_origin_protection(handler: Handler, options: CrossOrigin) -> (Request) -> Response
    // One router per pattern: two bypass patterns may overlap, which one
    // router refuses, and a router of one pattern refuses nothing.
    bypass =
        options.bypass_patterns
        |> Iter.map(fn route -> Router.new([Route.to(route, not_found)]))
        |> Iter.to_list()

    fn request ->
        bypassed = Iter.any_match(bypass, fn built ->
            case built
                Ok(router) -> Router.find(router, request) |> Maybe.is_some()
                Err(_) -> False
            end
        end)

        if bypassed then return ToResponse.to_response(handler(request))

        case CrossOrigin.check(options, request)
            Ok(_) ->
                ToResponse.to_response(handler(request))

            Err(Error.CrossOrigin{reason:}) ->
                case options.deny
                    Some(deny) -> ToResponse.to_response(deny(request))
                    None -> Response.error(Status.forbidden, reason)
                end

            Err(_) ->
                Response.error(Status.forbidden, "cross-origin request refused")
        end
    end
end

/// Middleware that limits each request's body to `max` bytes
/// (`Request.limit_body`), which lowers the server's `max_body` or
/// replaces the form readers' defaults.
//! import std::http.{self, Body, Method, Request, Response}
//! import std::http_testing
//!
//! upload = http.limit_body(fn r: Request -> Response{body: Body.Text("${r.body_limit}")}, 1_000)
//! assert Response.text(upload(http_testing.request(Method.Post, "/upload"))) == Ok("Some(1000)")
//
pub fn limit_body(handler: Handler, max: Int) -> (Request) -> Response
    fn request -> ToResponse.to_response(handler(Request.limit_body(request, max)))
end

/// `routes` with each handler wrapped by `wrap`, for applying middleware
/// to a group of routes, such as every `/admin` route, before they join
/// the others in one `Router`.
//! import std::http.{self, Body, Method, Request, Response, Route, Router, Status}
//! import std::http_testing
//!
//! require_token = fn handler: Handler ->
//!     fn request: Request ->
//!         if Headers.get(request.headers, "Authorization") == Some("Bearer s3cret") then
//!             ToResponse.to_response(handler(request))
//!         else
//!             Response.error(Status.unauthorized, "unauthorized")
//!         end
//!     end
//! end
//!
//! home = fn _: Request -> Response{body: Body.Text("home")}
//! users = fn _: Request -> Response{body: Body.Text("users")}
//!
//! admin = [Route.to("GET /admin/users", users)]
//! routes = [Route.to("GET /", home)] + http.wrap_routes(admin, require_token)
//! router = Router.new(routes)!
//!
//! assert Router.serve(router, http_testing.request(Method.Get, "/")).status == Status.ok
//!
//! assert Router.serve(router, http_testing.request(Method.Get, "/admin/users")).status
//!     == Status.unauthorized
//
pub fn wrap_routes(routes: List<Entry>, wrap: (Handler) -> Handler) -> List<Entry>
    routes
    |> Iter.map(fn e -> Entry{pattern: e.pattern, serve: wrap_serve(e.serve, wrap)})
    |> Iter.to_list()
end

/// An entry's `serve` with `wrap` around it. A request whose parameters
/// do not parse reaches the wrapped handler as a `404`.
fn wrap_serve(serve: (Request) -> Maybe<Response>, wrap: (Handler) -> Handler) -> (
    Request
) -> Maybe<Response>
    inner: Handler = fn request -> Maybe.with_default(serve(request), Response.not_found())
    wrapped = wrap(inner)
    fn request -> Some(ToResponse.to_response(wrapped(request)))
end

/// Which cross-origin requests `cors` lets a browser make, and what it
/// tells the browser about them. The defaults let no origin in.
pub struct Cors
    /// The origins whose requests get CORS headers, matched exactly.
    origins: List<Origin> = []
    /// Lets every origin in with `Access-Control-Allow-Origin: *`. A
    /// browser sends no cookies or credentials to `*`, so with this set
    /// `credentials` is not sent: responding to every origin with credentials
    /// would let any site act as the signed-in user.
    any_origin: Bool = False
    /// The methods a preflight allows.
    methods: List<Method> = [Method.Get, Method.Head, Method.Post]
    /// The request headers a preflight allows, beyond the ones a browser
    /// always may send (`Accept`, `Content-Type` of a form, and a few
    /// more).
    allowed_headers: List<String> = []
    /// The response headers a page's script may read, beyond the few a
    /// browser always shows it.
    exposed_headers: List<String> = []
    /// Lets the browser send cookies and credentials, and the page read
    /// the response to such a request.
    credentials: Bool = False
    /// How long a browser may keep a preflight's response; `None` leaves it
    /// to the browser, a few seconds.
    max_age: Maybe<Duration> = None
end

/// Middleware that handles CORS for the origins `options` allows, so a
/// page on another origin, such as a frontend on its own host, can call
/// the handler from a browser.
///
/// A preflight, an `OPTIONS` request with `Origin` and
/// `Access-Control-Request-Method`, gets `204 No Content` here and
/// never reaches the handler. Any other request reaches it, and its
/// response gets `Access-Control-Allow-Origin` with the request's origin
/// when that origin is allowed. A request from an origin that is not
/// allowed gets no CORS headers, so the browser keeps the response from
/// the page; the handler still runs, as it would for a form posted from
/// that origin, so pair `cors` with `cross_origin_protection` or
/// credentials checks for requests that change state. Every response
/// gets `Vary: Origin`, so a cache does not hand one origin's response to
/// another.
//! import std::http.{self, Body, Cors, Method, Origin, Request, Response, Status}
//! import std::http_testing
//!
//! api = fn _: Request -> Response{body: Body.Text("data")}
//!
//! app =
//!     api
//!     |> http.cors(Cors{
//!         origins: [Origin`https://app.example.com`],
//!         methods: [Method.Get, Method.Post, Method.Delete],
//!         allowed_headers: ["Content-Type", "Authorization"],
//!     })
//!
//! from = fn method: Method, origin: String -> {
//!     ..http_testing.request(method, "/api/items"),
//!     headers: Headers[("Origin", origin)],
//! }
//!
//! ok = app(from(Method.Get, "https://app.example.com"))
//! assert Headers.get(ok.headers, "Access-Control-Allow-Origin") == Some("https://app.example.com")
//! assert Headers.get(ok.headers, "Vary") == Some("Origin")
//! assert Response.text(ok) == Ok("data")
//!
//! refused = app(from(Method.Get, "https://evil.example"))
//! assert Headers.get(refused.headers, "Access-Control-Allow-Origin") == None
//! assert Response.text(refused) == Ok("data")
//!
//! asking = from(Method.Options, "https://app.example.com")
//!
//! preflight = app(
//!     {..asking, headers: Headers.set(asking.headers, "Access-Control-Request-Method", "DELETE")}
//! )
//!
//! assert preflight.status == Status.no_content
//!
//! assert Headers.get(preflight.headers, "Access-Control-Allow-Methods") == Some("GET, POST, DELETE")
//!
//! assert Headers.get(preflight.headers, "Access-Control-Allow-Headers")
//!     == Some("Content-Type, Authorization")
//
pub fn cors(handler: Handler, options: Cors) -> (Request) -> Response
    fn request ->
        origin = Headers.get(request.headers, "Origin")

        allowed = case origin
            Some(o) -> options.any_origin or Iter.any_match(options.origins, fn a -> "${a}" == o)
            None -> False
        end

        preflight = request.method == Method.Options
            and origin != None
            and Headers.has(request.headers, "Access-Control-Request-Method")

        if preflight then
            vary = Headers[
                ("Vary", "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"),
            ]

            if not allowed then return Response{status: Status.no_content, headers: vary}

            methods =
                options.methods
                |> Iter.map(Method.text)
                |> String.join(", ")

            headers =
                cors_origin(vary, options, Maybe.with_default(origin, ""))
                |> Headers.set("Access-Control-Allow-Methods", methods)
                |> set_listed("Access-Control-Allow-Headers", options.allowed_headers)

            age = case options.max_age
                Some(d) ->
                    Headers.set(headers, "Access-Control-Max-Age", "${Duration.as_seconds(d)}")

                None ->
                    headers
            end

            return Response{status: Status.no_content, headers: age}
        end

        response = ToResponse.to_response(handler(request))

        headers = case origin
            Some(o) when allowed ->
                cors_origin(response.headers, options, o)
                |> set_listed("Access-Control-Expose-Headers", options.exposed_headers)

            _ ->
                response.headers
        end

        {..response, headers: Headers.add(headers, "Vary", "Origin")}
    end
end

fn cors_origin(headers: Headers, options: Cors, origin: String) -> Headers
    if options.any_origin then
        Headers.set(headers, "Access-Control-Allow-Origin", "*")
    else
        set = Headers.set(headers, "Access-Control-Allow-Origin", origin)

        if options.credentials then
            Headers.set(set, "Access-Control-Allow-Credentials", "true")
        else
            set
        end
    end
end

fn set_listed(headers: Headers, name: String, values: List<String>) -> Headers
    if Iter.is_empty(values) then
        headers
    else
        Headers.set(headers, name, String.join(values, ", "))
    end
end

/// Middleware that writes one `Info` record to `logger` for each
/// request, after the handler returns: `request` with the `method`, the
/// `path`, the response's `status`, `duration_ms`, the time the handler
/// took, and `bytes` when the body's length is known without reading it
/// (a streamed body's is not). A request that carries `X-Request-Id`
/// adds it as `request_id`, so put `request_id` after `log_requests` in a
/// pipe, outside it, to log the id it sets.
//! import std::http.{self, Body, Method, Request, Response, Status}
//! import std::http_testing
//! import std::log
//! import std::log_testing
//!
//! hello = fn _: Request -> Response{status: Status.created, body: Body.Text("hello")}
//!
//! got = log_testing.run(fn logger ->
//!     app = hello |> http.log_requests(logger) |> http.request_id()
//!     request = http_testing.request(Method.Post, "/items?x=1")
//!     app({..request, headers: Headers[("X-Request-Id", "req-7")]})
//! end)
//!
//! record = List.head(got.records)!
//! assert record.message == "request"
//! assert List.contains(record.fields, log.string("method", "POST"))
//! assert List.contains(record.fields, log.string("path", "/items"))
//! assert List.contains(record.fields, log.int("status", 201))
//! assert List.contains(record.fields, log.int("bytes", 5))
//! assert List.contains(record.fields, log.string("request_id", "req-7"))
//
pub fn log_requests(handler: Handler, logger: Logger) -> (Request) -> Response
    fn request ->
        started = Instant.now()
        response = ToResponse.to_response(handler(request))
        took = Instant.between(started, Instant.now())

        size = case response.content_length
            Some(n) -> Some(n)
            None -> known_length(response.body)
        end

        id = Headers.get(request.headers, "X-Request-Id")

        fields = [
            log.string("method", Method.text(request.method)),
            log.string("path", request.url.path),
            log.int("status", Status.code(response.status)),
            log.float("duration_ms", Int.to_float(Duration.as_micros(took)) / 1000.0),
        ]

        sized = case size
            Some(n) -> fields + [log.int("bytes", n)]
            None -> fields
        end

        tagged = case id
            Some(i) -> sized + [log.string("request_id", i)]
            None -> sized
        end

        log.info(logger, "request", tagged)
        response
    end
end

fn known_length(body: Body) -> Maybe<Int>
    case body
        .Empty -> Some(0)
        .Text(text) -> Some(Bytes.length(String.to_bytes(text)))
        .Bytes(data) -> Some(Bytes.length(data))
        _ -> None
    end
end

/// The headers `security_headers` adds to each response that does not
/// set them itself. A `None` leaves that header out.
pub struct SecurityHeaders
    /// `X-Content-Type-Options: nosniff`: the browser takes the
    /// `Content-Type` as sent and never guesses a script from a text file.
    nosniff: Bool = True
    /// `Referrer-Policy`: how much of the page's URL a link or a fetch
    /// sends on.
    referrer_policy: Maybe<String> = Some("strict-origin-when-cross-origin")
    /// `X-Frame-Options`: `DENY` keeps every other page from framing this
    /// one, against clickjacking. A `Content-Security-Policy` with
    /// `frame-ancestors` says the same to newer browsers.
    frame_options: Maybe<String> = Some("DENY")
    /// `Strict-Transport-Security`, such as `max-age=63072000;
    /// includeSubDomains`: the browser uses only HTTPS for the host from
    /// then on. Send it only from a host served over HTTPS for good.
    strict_transport_security: Maybe<String> = None
    /// `Content-Security-Policy`, such as `default-src 'self'`.
    content_security_policy: Maybe<String> = None
end

/// Middleware that adds the headers `options` names to each response, as
/// defaults: a header the handler set is kept. With no options it sends
/// `X-Content-Type-Options: nosniff`, `Referrer-Policy:
/// strict-origin-when-cross-origin` and `X-Frame-Options: DENY`.
//! import std::http.{self, Body, Method, Request, Response, SecurityHeaders}
//! import std::http_testing
//!
//! page = fn r: Request ->
//!     if r.url.path == "/embed" then
//!         Response{headers: Headers[("X-Frame-Options", "SAMEORIGIN")]}
//!     else
//!         Response{body: Body.Text("page")}
//!     end
//! end
//!
//! app = page |> http.security_headers()
//! plain = app(http_testing.request(Method.Get, "/"))
//! assert Headers.get(plain.headers, "X-Content-Type-Options") == Some("nosniff")
//! assert Headers.get(plain.headers, "Referrer-Policy") == Some("strict-origin-when-cross-origin")
//! assert Headers.get(plain.headers, "X-Frame-Options") == Some("DENY")
//! assert Headers.get(plain.headers, "Strict-Transport-Security") == None
//!
//! assert Headers.get(app(http_testing.request(Method.Get, "/embed")).headers, "X-Frame-Options")
//!     == Some("SAMEORIGIN")
//!
//! strict =
//!     page
//!     |> http.security_headers(SecurityHeaders{
//!         strict_transport_security: Some("max-age=63072000"),
//!         content_security_policy: Some("default-src 'self'"),
//!     })
//!
//! sent = strict(http_testing.request(Method.Get, "/"))
//! assert Headers.get(sent.headers, "Strict-Transport-Security") == Some("max-age=63072000")
//! assert Headers.get(sent.headers, "Content-Security-Policy") == Some("default-src 'self'")
//
pub fn security_headers(handler: Handler, options: SecurityHeaders = SecurityHeaders{}) -> (
    Request
) -> Response
    named = [
        if options.nosniff then
            Some(("X-Content-Type-Options", "nosniff"))
        else
            None
        end,
        options.referrer_policy |> Maybe.map(fn v -> ("Referrer-Policy", v)),
        options.frame_options |> Maybe.map(fn v -> ("X-Frame-Options", v)),
        options.strict_transport_security |> Maybe.map(fn v -> ("Strict-Transport-Security", v)),
        options.content_security_policy |> Maybe.map(fn v -> ("Content-Security-Policy", v)),
    ]

    defaults = Headers(
        Iter.reduce(named, [], fn acc, header ->
            case header
                Some(pair) -> acc + [pair]
                None -> acc
            end
        end)
    )

    fn request -> Response.with_default_headers(handler(request), defaults)
end

/// Middleware that gives each request an id in `header`, `X-Request-Id`
/// unless set, and sends it back on the response. It keeps an id the
/// request came with when `trust_incoming` holds and the id is 1 to 128
/// letters, digits and `-_.:+/=`; otherwise it makes a random UUID. The
/// handler reads the id from the request's headers, and `log_requests`
/// logs it when it runs inside `request_id`, before it in a pipe.
//! import std::http.{self, Body, Method, Request, Response}
//! import std::http_testing
//!
//! echo = fn r: Request -> Response{body: Body.Text(Headers.get(r.headers, "X-Request-Id")!)}
//! app = echo |> http.request_id()
//!
//! made = app(http_testing.request(Method.Get, "/"))
//! id = Headers.get(made.headers, "X-Request-Id")!
//! assert String.length(id) == 36
//! assert Response.text(made) == Ok(id)
//!
//! given = fn id: String -> {
//!     ..http_testing.request(Method.Get, "/"),
//!     headers: Headers[("X-Request-Id", id)],
//! }
//!
//! assert Headers.get(app(given("abc-123")).headers, "X-Request-Id") == Some("abc-123")
//! assert Headers.get(app(given("bad id\n")).headers, "X-Request-Id") != Some("bad id\n")
//!
//! untrusting = echo |> http.request_id(trust_incoming: False)
//! assert Headers.get(untrusting(given("abc-123")).headers, "X-Request-Id") != Some("abc-123")
//
pub fn request_id(
    handler: Handler,
    header: String = "X-Request-Id",
    trust_incoming: Bool = True,
) -> (Request) -> Response
    fn request ->
        incoming = if trust_incoming then
            Headers.get(request.headers, header)
            |> Maybe.flat_map(fn t -> if is_request_id(t) then t)
        else
            None
        end

        id = case incoming
            Some(given) -> Some(given)
            None -> Uuid.v4() |> Result.to_maybe() |> Maybe.map(fn u -> "${u}")
        end

        case id
            Some(text) ->
                tagged = {..request, headers: Headers.set(request.headers, header, text)}
                Response.with_headers(handler(tagged), Headers[(header, text)])

            None ->
                ToResponse.to_response(handler(request))
        end
    end
end

fn is_request_id(text: String) -> Bool
    codes = String.to_codepoints(text) |> Iter.map(Codepoint.to_int) |> Iter.to_list()
    count = Iter.count(codes)

    count >= 1
        and count <= 128
        and Iter.all_match(codes, fn c ->
            (c >= 48 and c <= 57)
                or (c >= 65 and c <= 90)
                or (c >= 97 and c <= 122)
                or List.contains([45, 95, 46, 58, 43, 47, 61], c)
        end)
end

/// How `compress` compresses.
pub struct Compress
    /// The shortest body worth compressing, in bytes. A body known to be
    /// shorter is sent as it is, since gzip's framing outweighs what it
    /// saves on a few hundred bytes.
    min_size: Int = 1024
    /// gzip's level, from 1, the fastest, to 9, the smallest.
    level: Int = 6
end

/// Middleware that compresses each response body with gzip when the
/// request's `Accept-Encoding` takes it (a coding it gives `q=0` is
/// refused), and adds `Vary: Accept-Encoding` to every response so a
/// cache keeps the two forms apart. A compressed response gets
/// `Content-Encoding: gzip`, loses its `Content-Length`, and has a strong
/// `ETag` made weak (`W/"..."`), since its bytes are not the ones the tag
/// names; `If-None-Match` still matches it.
///
/// A response is sent as it is when it already has a `Content-Encoding`
/// (a precompressed file `serve_embedded` sends), has no body (1xx, 204,
/// 304, a `HEAD`), is a range (206), says `Cache-Control: no-transform`,
/// has a body known to be shorter than `options.min_size`, or has a
/// content type that is compressed already: images other than SVG, audio,
/// video, archives such as zip and gzip, and `woff` fonts. A body of
/// bytes with no `Content-Type` gets the one its bytes are sniffed as
/// first; a streamed body with none is sent as it is.
///
/// A `Body.Stream` is compressed as it is read, and a `Body.Produce` as
/// it writes, each `Writer.flush` passing what it wrote so far to the
/// client, so server-sent events still arrive one by one. Go's standard
/// library has no brotli encoder, so `compress` writes only gzip; serve
/// `.br` files precompressed (`serve_embedded`).
//! import std::http.{self, Body, Method, Request, Response, Status}
//! import std::http_testing
//!
//! page = String.repeat("<p>hello</p>", 200)
//! app = (fn _: Request -> Response{body: Body.Text(page)}) |> http.compress()
//!
//! asking = fn accept: String ->
//!     r = http_testing.request(Method.Get, "/")
//!     {..r, headers: Headers[("Accept-Encoding", accept)]}
//! end
//!
//! zipped = app(asking("gzip, br"))
//! assert Headers.get(zipped.headers, "Content-Encoding") == Some("gzip")
//! assert Headers.get(zipped.headers, "Content-Type") == Some("text/plain; charset=utf-8")
//! assert Headers.get(zipped.headers, "Vary") == Some("Accept-Encoding")
//! assert Bytes.length(Response.bytes(zipped)!) < 100
//! assert http_testing.decompressed(zipped) == Ok(String.to_bytes(page))
//!
//! plain = app(asking("gzip;q=0, identity"))
//! assert Headers.get(plain.headers, "Content-Encoding") == None
//! assert Headers.get(plain.headers, "Vary") == Some("Accept-Encoding")
//! assert Response.text(plain) == Ok(page)
//!
//! small = (fn _: Request -> Response{body: Body.Text("hi")}) |> http.compress()
//! assert Headers.get(small(asking("gzip")).headers, "Content-Encoding") == None
//
pub fn compress(handler: Handler, options: Compress = Compress{}) -> (Request) -> Response
    fn request -> compressed(request, ToResponse.to_response(handler(request)), options)
end

/// `response` to `request` as `compress` sends it.
fn compressed(request: Request, response: Response, options: Compress) -> Response
    code = Status.code(response.status)
    if code < 200 then return response
    varied = {..response, headers: vary_on(response.headers, "Accept-Encoding")}

    no_transform =
        Headers.values(response.headers, "Cache-Control")
        |> Iter.any_match(fn v -> String.contains(String.lowercase(v), "no-transform"))

    skip = code == 204
        or code == 206
        or code == 304
        or request.method == Method.Head
        or Headers.has(response.headers, "Content-Encoding")
        or Headers.has(response.headers, "Content-Range")
        or no_transform
        or not Iter.contains(accepted_codings(request), "gzip")

    if skip then return varied

    short = case response.content_length
        Some(n) -> n < options.min_size
        None -> False
    end

    if short then return varied
    headers = typed(varied.headers, varied.body)

    case varied.body
        .Empty ->
            varied

        .Multipart(_) ->
            varied

        .Stream(r) ->
            if Headers.has(headers, "Content-Type") and compressible(headers) then
                gzip_response(varied, headers, Body.Stream(http_host.gzip_reader(r, options.level)))
            else
                varied
            end

        .Produce(produce) ->
            if Headers.has(headers, "Content-Type") and compressible(headers) then
                body = Body.Produce(fn w ->
                    gz = http_host.gzip_writer(w, options.level)
                    produced = produce(gz)
                    closed = Writer.close(gz)
                    Result.flat_map(produced, fn _: Unit -> closed)
                end)

                gzip_response(varied, headers, body)
            else
                varied
            end

        other ->
            data = Body.bytes_of(other)

            sniffed = if Headers.has(headers, "Content-Type") then
                headers
            else
                Headers.set(headers, "Content-Type", detect_content_type(data))
            end

            if Bytes.length(data) < options.min_size or not compressible(sniffed) then
                varied
            else
                gzip_response(
                    varied,
                    sniffed,
                    Body.Bytes(http_host.gzip_bytes(data, options.level)),
                )
            end
    end
end

/// `response` with `body`, compressed, and `headers` changed to say so.
fn gzip_response(response: Response, headers: Headers, body: Body) -> Response
    weak =
        Headers.values(headers, "ETag")
        |> Iter.map(fn tag ->
            if String.starts_with(tag, "\"") then
                "W/${tag}"
            else
                tag
            end
        end)
        |> Iter.to_list()

    tagged = Iter.reduce(weak, Headers.remove(headers, "ETag"), fn acc, tag ->
        Headers.add(acc, "ETag", tag)
    end)

    sent =
        tagged
        |> Headers.remove("Content-Length")
        |> Headers.set("Content-Encoding", "gzip")

    {..response, headers: sent, body:, content_length: None}
end

/// Whether the `Content-Type` in `headers` names a type gzip shrinks: not
/// one compressed already.
fn compressible(headers: Headers) -> Bool
    media =
        Headers.get(headers, "Content-Type")
        |> Maybe.with_default("")
        |> String.split(";")
        |> List.head()
        |> Maybe.with_default("")
        |> String.trim()
        |> String.lowercase()

    packed = [
        "application/gzip",
        "application/x-gzip",
        "application/zip",
        "application/x-bzip2",
        "application/x-xz",
        "application/zstd",
        "application/x-7z-compressed",
        "application/vnd.rar",
        "application/x-rar-compressed",
        "application/font-woff",
        "font/woff",
        "font/woff2",
    ]

    media_class = Iter.any_match(["image/", "audio/", "video/"], fn p ->
        String.starts_with(media, p)
    end)

    not (media_class and media != "image/svg+xml") and not List.contains(packed, media)
end

/// `headers` with `name` in `Vary`, unless it is there or `Vary` is `*`.
fn vary_on(headers: Headers, name: String) -> Headers
    listed =
        Headers.values(headers, "Vary")
        |> Iter.flat_map(fn v -> String.split(v, ","))
        |> Iter.map(fn t -> String.lowercase(String.trim(t)))
        |> Iter.to_list()

    if Iter.any_match(listed, fn t -> t == "*" or t == String.lowercase(name)) then
        headers
    else
        Headers.add(headers, "Vary", name)
    end
end

/// Middleware that lets a request through to `handler` only with a
/// `Basic` `Authorization` header whose user and password `check`
/// accepts. Any other request gets `401 Unauthorized` with
/// `WWW-Authenticate: Basic realm="<realm>", charset="UTF-8"`, which has
/// a browser ask for them. The handler reads the user with
/// `Request.basic_auth`. Send it only over HTTPS: the password crosses in
/// every request, encoded but not encrypted.
///
/// Write `check` with `hash.equal_in_constant_time`, never `==`, which
/// returns at the first byte that differs and so tells an attacker by its
/// timing how much of a guess was right. Comparing SHA-256 digests keeps
/// the lengths equal, so the time depends on neither, and checking both
/// before combining them keeps a right user from showing either.
//! import std::hash
//! import std::http.{self, Body, Method, Request, Response, Status}
//! import std::http_testing
//!
//! same = fn given: String, expected: String ->
//!     hash.equal_in_constant_time(
//!         hash.sha256(String.to_bytes(given)),
//!         hash.sha256(String.to_bytes(expected)),
//!     )
//! end
//!
//! admin_only = fn user: String, password: String ->
//!     user_ok = same(user, "admin")
//!     password_ok = same(password, "s3cret")
//!     user_ok and password_ok
//! end
//!
//! hello = fn r: Request -> Response{body: Body.Text("hello ${Request.basic_auth(r)!.first}")}
//! app = hello |> http.basic_auth("admin", admin_only)
//! visit = http_testing.request(Method.Get, "/admin")
//!
//! refused = app(visit)
//! assert refused.status == Status.unauthorized
//!
//! assert Headers.get(refused.headers, "WWW-Authenticate")
//!     == Some("Basic realm=\"admin\", charset=\"UTF-8\"")
//!
//! assert app(Request.with_basic_auth(visit, "admin", "guess")).status == Status.unauthorized
//! assert Response.text(app(Request.with_basic_auth(visit, "admin", "s3cret"))) == Ok("hello admin")
//
pub fn basic_auth(handler: Handler, realm: String, check: (String, String) -> Bool) -> (
    Request
) -> Response
    quoted = String.replace(realm, "\\", "\\\\") |> String.replace("\"", "\\\"")
    challenge = "Basic realm=\"${quoted}\", charset=\"UTF-8\""

    fn request ->
        case Request.basic_auth(request)
            Some((user, password)) when check(user, password) ->
                ToResponse.to_response(handler(request))

            _ ->
                Response.with_headers(
                    Response.error(Status.unauthorized, "401 Unauthorized"),
                    Headers[("WWW-Authenticate", challenge)],
                )
        end
    end
end

/// Middleware that lets an HTML form, which can send only `GET` and
/// `POST`, stand for a `PUT`, `PATCH` or `DELETE`: a `POST` whose
/// URL-encoded body has a `_method` field naming one of those three, in
/// any case, reaches `handler` as that method, so a router's
/// `DELETE /posts/{id}` route takes it. Any other request, and any other
/// `_method`, passes as it came. The form is read up to the request's
/// `body_limit`, or 10 MB, and the handler can read it again; past the
/// limit the request gets `413`.
///
/// Wrap the router, so the method is changed before it routes, and put
/// `limit_body` outside it (after it in a pipe) for its limit to hold
/// here. The `X-HTTP-Method-Override` header is not read: a page on
/// another origin could set it on a request a browser lets through.
//! import std::http.{self, Body, Method, Request, Response, Route, Router}
//! import std::http_testing
//!
//! router = Router.new([
//!     Route.to("POST /posts", fn _ -> Response{body: Body.Text("created")}),
//!     Route.to_with("PATCH /posts/{id}", fn r, _ -> Response{
//!         body: Body.Text("titled ${Request.form_value(r, "title")!}"),
//!     }),
//!     Route.to_with("DELETE /posts/{id}", fn _, _ -> Response{body: Body.Text("deleted")}),
//! ])!
//!
//! app = Router.handler(router) |> http.method_override()
//!
//! form = fn target: String, fields: List<(String, String)> ->
//!     http_testing.form_request(Method.Post, target, fields)
//! end
//!
//! assert Response.text(app(form("/posts/7", [("_method", "delete")]))) == Ok("deleted")
//!
//! assert Response.text(app(form("/posts/7", [("_method", "PATCH"), ("title", "Hi")])))
//!     == Ok("titled Hi")
//!
//! assert Response.text(app(form("/posts", [("_method", "CONNECT")]))) == Ok("created")
//
pub fn method_override(handler: Handler) -> (Request) -> Response
    fn request ->
        posted_form = request.method == Method.Post
            and Request.media_type(request) == "application/x-www-form-urlencoded"

        if not posted_form then return ToResponse.to_response(handler(request))
        max = Maybe.with_default(request.body_limit, max_form_body)

        case read_capped(request.body, max, request.body_limit)
            Ok(data) ->
                asked =
                    Bytes.to_string(data)
                    |> Result.to_maybe()
                    |> Maybe.flat_map(fn text -> Query.parse(text) |> Result.to_maybe())
                    |> Maybe.flat_map(fn q -> Query.get(q, "_method"))
                    |> Maybe.map(String.uppercase)

                method = case asked
                    Some("PUT") -> Method.Put
                    Some("PATCH") -> Method.Patch
                    Some("DELETE") -> Method.Delete
                    _ -> Method.Post
                end

                ToResponse.to_response(handler({..request, method:, body: Body.Bytes(data)}))

            Err(Error.BodyTooLarge{limit: _}) ->
                Response.error(Status.request_entity_too_large, "413 Request Entity Too Large")

            Err(_) ->
                Response.error(Status.bad_request, "400 Bad Request")
        end
    end
end

/// The file at `path` as the response to `request`, with ranges and
/// conditional requests (`Response.content`). A directory
/// is redirected to its path with a trailing slash, then served with its
/// `index.html` or a listing of its entries; a request for `.../index.html`
/// is redirected to `./`.
///
/// When nothing is at `file`, the request's path ends in no `/` and `file`
/// does not end in `.html`, the page `file.html` is served in its place, as
/// static hosts do: `/about` gets `about.html`, which is the
/// file Next's and SvelteKit's static exports write for each route. The
/// order is the file, then a directory, then the page. A request for
/// `/about.html` is served that file as named, not redirected. Anything
/// else missing is a 404, and a file that cannot be read a 403 or 500.
/// Files come through std::fs, so `fs_testing.run` and `fs.within` apply.
//! import std::fs_testing.{self, Sandbox}
//! import std::http.{Method, Response, Status}
//! import std::http_testing
//!
//! get = fn target: String, file: String -> serve_file(http_testing.request(Method.Get, target), file)
//!
//! site = {"site/about.html" => "<p>about</p>", "site/blog/index.html" => "<p>blog</p>"}
//!
//! ran = fs_testing.run(Sandbox{files: site}, fn ->
//!     (
//!         get("/about", "site/about"),
//!         get("/about.html", "site/about.html"),
//!         get("/blog", "site/blog"),
//!         get("/missing", "site/missing"),
//!     )
//! end)
//!
//! (about, named, blog, missing) = ran.value
//! assert Response.text(about) == Ok("<p>about</p>")
//! assert Headers.get(about.headers, "Content-Type") == Some("text/html; charset=utf-8")
//! assert Response.text(named) == Ok("<p>about</p>")
//! assert blog.status == Status.moved_permanently
//! assert missing.status == Status.not_found
//
pub fn serve_file(request: Request, file: String) -> Response
    asked = request.url.path

    if String.ends_with(asked, "/index.html") then
        return Response.redirect(request, "./", Status.moved_permanently)
    end

    case fs.metadata(file)
        Ok(meta) ->
            case meta.kind
                fs.Kind.Directory ->
                    if not String.ends_with(asked, "/") then
                        Response.redirect(request, "${path.base(asked)}/", Status.moved_permanently)
                    else
                        directory(request, file)
                    end

                _ ->
                    disk_file(request, file, meta)
            end

        Err(e) ->
            case disk_page(asked, file)
                Some((page, meta)) -> disk_file(request, page, meta)
                None -> failed(e)
            end
    end
end

/// The file on disk at `file`, which is one, as the response to `request`.
fn disk_file(request: Request, file: String, meta: fs.Metadata) -> Response
    case fs.read(file)
        Ok(data) -> Response.content(request, path.base(file), Some(meta.modified), data)
        Err(e) -> failed(e)
    end
end

/// The page a request for `asked` tries when nothing is at `file`:
/// `file.html`, when `asked` ends in no `/` and `file` not in `.html`.
fn html_page(asked: String, file: String) -> Maybe<String>
    if String.ends_with(asked, "/") or String.ends_with(file, ".html") then
        None
    else
        Some("${file}.html")
    end
end

/// `html_page` on disk, with its metadata, when it is a file there.
fn disk_page(asked: String, file: String) -> Maybe<(String, fs.Metadata)>
    html_page(asked, file)
    |> Maybe.flat_map(fn page ->
        case fs.metadata(page)
            Ok(meta) ->
                case meta.kind
                    fs.Kind.Directory -> None
                    _ -> Some((page, meta))
                end

            Err(_) ->
                None
        end
    end)
end

/// `html_page` in `files`, when it is a file there.
fn embedded_page(asked: String, files: Files, file: String) -> Maybe<String>
    html_page(asked, file)
    |> Maybe.flat_map(fn page ->
        case Files.metadata(files, page)
            Ok(meta) ->
                case meta.kind
                    fs.Kind.Directory -> None
                    _ -> Some(page)
                end

            Err(_) ->
                None
        end
    end)
end

/// A handler that serves each request the file under `root` its
/// cleaned path names (`serve_file`).
///
/// A path that names no file or directory is tried with `.html` appended,
/// so `/about` gets `about.html` (`serve_file`).
///
/// With `single_page`, a request for a page route that names no file,
/// directory or `.html` page gets `root`'s `index.html`,
/// status 200, so a single-page app whose client-side router owns
/// `/settings` loads at that URL (`is_page_route`). A file that exists is
/// served whatever its name, and a request for a missing asset is still a
/// 404.
//! import std::fs_testing.{self, Sandbox}
//! import std::http.{Method, Response, Status}
//! import std::http_testing
//!
//! site = file_server("site", single_page: True)
//! page = http_testing.request(Method.Get, "/settings")
//! page = {..page, headers: Headers.set(page.headers, "Accept", "text/html")}
//!
//! ran = fs_testing.run(Sandbox{files: {"site/index.html" => "<div id=root></div>"}}, fn ->
//!     (site(page), site(http_testing.request(Method.Get, "/app.js")))
//! end)
//!
//! (shell, script) = ran.value
//! assert Response.text(shell) == Ok("<div id=root></div>")
//! assert script.status == Status.not_found
//
pub fn file_server(root: String, single_page = False) -> (Request) -> Response
    fn request ->
        file = path.join(root, path.clean(rooted(request.url.path)))

        if single_page
            and is_page_route(request)
            and fs.metadata(file) is Err(io.Error.NotFound{})
            and disk_page(request.url.path, file) is None then
            serve_file(request, path.join(root, "index.html"))
        else
            serve_file(request, file)
        end
    end
end

/// `serve_file` from files a program embeds (std::embed): the file at
/// `file` in `files` as the response to `request`, with its `Content-Type`
/// from its name, ranges and conditional requests. A directory is
/// redirected to its path with a trailing slash, then served with its
/// `index.html`; one with no `index.html` is a 404, since an embedded
/// tree is not listed. A request for `.../index.html` is redirected to
/// `./`. When nothing is at `file`, the request's path ends in no `/` and
/// `file` does not end in `.html`, the page `file.html` is served in its
/// place, as `serve_file` serves it: the file, then a directory, then the
/// page. Anything else missing is a 404.
///
/// The file's SHA-256, which the compiler took when it read the file, is
/// its strong `ETag`, so a request whose `If-None-Match` names it is a 304
/// with no body. A file whose path in `files` matches one of the
/// `immutable` patterns (std::path's `matches`: `assets/**` for every
/// file under Vite's `assets`, `*-*.js` for hashed scripts at the root) is
/// sent with `Cache-Control: public, max-age=31536000, immutable`. Match
/// only files that have their contents' hash in their names, as a bundler
/// writes them, since a browser keeps such a file for a year without
/// asking again. A pattern with no wildcard (`*`, `?` or `[`) names a
/// file or a directory, and a directory covers every file under it, as in
/// an `embed` pattern: `assets` is `assets/**`. Any other
/// file is sent with `Cache-Control: no-cache`, which has a browser ask
/// each time and get the 304 while the file is unchanged.
///
/// A file that has a precompressed sibling, `file.br` or `file.gz` as
/// Vite's and webpack's compression plugins write them, is sent as that
/// sibling when the request's `Accept-Encoding` takes its coding (`br`
/// first), with `Content-Encoding`, the original name's `Content-Type`,
/// and the sibling's own `ETag`. Every response for such a file carries
/// `Vary: Accept-Encoding`. Nothing is compressed while the program runs.
//! import std::http.{Method, Response, Status}
//! import std::http_testing
//!
//! files = Files.from_bytes([
//!     ("index.html", String.to_bytes("<p>home</p>")),
//!     ("assets/app-3f9a1b2c.js", String.to_bytes("go()")),
//!     ("assets/app-3f9a1b2c.js.gz", String.to_bytes("zipped")),
//! ])
//!
//! get = http_testing.request(Method.Get, "/assets/app-3f9a1b2c.js")
//! js = serve_embedded(get, files, "assets/app-3f9a1b2c.js", immutable: ["assets/**"])
//! assert Headers.get(js.headers, "Cache-Control") == Some("public, max-age=31536000, immutable")
//! assert Headers.get(js.headers, "Content-Type") == Some("text/javascript; charset=utf-8")
//! assert Headers.get(js.headers, "Vary") == Some("Accept-Encoding")
//! assert Response.text(js) == Ok("go()")
//!
//! gzip = {..get, headers: Headers.set(get.headers, "Accept-Encoding", "gzip, deflate")}
//! zipped = serve_embedded(gzip, files, "assets/app-3f9a1b2c.js")
//! assert Headers.get(zipped.headers, "Content-Encoding") == Some("gzip")
//! assert Headers.get(zipped.headers, "Content-Type") == Some("text/javascript; charset=utf-8")
//! assert Response.text(zipped) == Ok("zipped")
//!
//! home = serve_embedded(http_testing.request(Method.Get, "/"), files, ".")
//! etag = Headers.get(home.headers, "ETag")!
//! assert Headers.get(home.headers, "Cache-Control") == Some("no-cache")
//!
//! again = http_testing.request(Method.Get, "/")
//! again = {..again, headers: Headers.set(again.headers, "If-None-Match", etag)}
//! assert serve_embedded(again, files, ".").status == Status.not_modified
//!
//! pages = Files.from_bytes([
//!     ("about.html", String.to_bytes("<p>about</p>")),
//!     ("about.html.br", String.to_bytes("squeezed")),
//! ])
//!
//! about = serve_embedded(http_testing.request(Method.Get, "/about"), pages, "about")
//! assert Response.text(about) == Ok("<p>about</p>")
//! assert Headers.get(about.headers, "Content-Type") == Some("text/html; charset=utf-8")
//! assert Headers.get(about.headers, "Vary") == Some("Accept-Encoding")
//!
//! brotli = http_testing.request(Method.Get, "/about")
//! brotli = {..brotli, headers: Headers.set(brotli.headers, "Accept-Encoding", "br")}
//! squeezed = serve_embedded(brotli, pages, "about")
//! assert Headers.get(squeezed.headers, "Content-Encoding") == Some("br")
//! assert Response.text(squeezed) == Ok("squeezed")
//!
//! slashed = serve_embedded(http_testing.request(Method.Get, "/about/"), pages, "about")
//! assert slashed.status == Status.not_found
//
pub fn serve_embedded(
    request: Request,
    files: Files,
    file: String,
    immutable: List<String> = [],
) -> Response
    asked = request.url.path

    if String.ends_with(asked, "/index.html") then
        return Response.redirect(request, "./", Status.moved_permanently)
    end

    case Files.metadata(files, file)
        Ok(meta) ->
            case meta.kind
                fs.Kind.Directory ->
                    if not String.ends_with(asked, "/") then
                        Response.redirect(request, "${path.base(asked)}/", Status.moved_permanently)
                    else
                        index = path.join(file, "index.html")

                        if Files.exists(files, index) then
                            embedded_file(request, files, index, immutable)
                        else
                            Response.not_found()
                        end
                    end

                _ ->
                    embedded_file(request, files, file, immutable)
            end

        Err(e) ->
            case embedded_page(asked, files, file)
                Some(page) -> embedded_file(request, files, page, immutable)
                None -> failed(e)
            end
    end
end

/// `file_server` over files a program embeds (std::embed): a handler that
/// serves each request the file its cleaned path names in `files`
/// (`serve_embedded`, which `immutable` is passed to). A path is cleaned
/// before it is looked up, so no request reaches outside the tree. Serve
/// a folder's files at the root with `Files.sub`:
///
/// ```nomi
/// embed site `static`
///
/// fn static_files() -> (Request) -> Response
///     http.file_server_embedded(Files.sub(site, "static")!)
/// end
/// ```
///
/// A path that names no file or directory is tried with `.html` appended,
/// so a static export with a page per route, `about.html` for `/about`,
/// is served as written. With `single_page`, a request for a page route
/// that names no file, directory or `.html` page gets the root
/// `index.html`, status 200, as `file_server` serves it. A Vite build's
/// `dist` is served so:
///
/// ```nomi
/// embed web `web/dist`
///
/// fn frontend() -> (Request) -> Response
///     http.file_server_embedded(
///         Files.sub(web, "web/dist")!,
///         single_page: True,
///         immutable: ["assets/**"],
///     )
/// end
/// ```
//! import std::http.{Method, Response, Status}
//! import std::http_testing
//!
//! app = file_server_embedded(
//!     Files.from_bytes([
//!         ("index.html", String.to_bytes("<div id=root></div>")),
//!         ("assets/app-3f9a1b2c.js", String.to_bytes("go()")),
//!     ]),
//!     single_page: True,
//!     immutable: ["assets/**"],
//! )
//!
//! visit = fn target: String ->
//!     r = http_testing.request(Method.Get, target)
//!     {..r, headers: Headers.set(r.headers, "Accept", "text/html,*/*;q=0.8")}
//! end
//!
//! assert Response.text(app(visit("/settings/profile"))) == Ok("<div id=root></div>")
//!
//! exported = file_server_embedded(
//!     Files.from_bytes([
//!         ("index.html", String.to_bytes("<p>home</p>")),
//!         ("about.html", String.to_bytes("<p>about</p>")),
//!     ]),
//!     single_page: True,
//! )
//!
//! assert Response.text(exported(visit("/about"))) == Ok("<p>about</p>")
//! assert Response.text(exported(visit("/contact"))) == Ok("<p>home</p>")
//! assert Response.text(app(visit("/users/jane.doe"))) == Ok("<div id=root></div>")
//!
//! missing = http_testing.request(Method.Get, "/assets/gone-0a1b2c3d.js")
//! missing = {..missing, headers: Headers.set(missing.headers, "Accept", "*/*")}
//! assert app(missing).status == Status.not_found
//
pub fn file_server_embedded(
    files: Files,
    single_page: Bool = False,
    immutable: List<String> = [],
) -> (Request) -> Response
    fn request ->
        file = String.drop(path.clean(rooted(request.url.path)), 1)

        if single_page
            and is_page_route(request)
            and not Files.exists(files, file)
            and embedded_page(request.url.path, files, file) is None then
            embedded_file(request, files, "index.html", immutable)
        else
            serve_embedded(request, files, file, immutable:)
        end
    end
end

/// Whether `request` asks for a page a single-page app's client-side
/// router handles, which `file_server` and `file_server_embedded` respond to
/// with `index.html` under `single_page` when no file matches the path: a
/// `GET` or `HEAD` from a client that takes HTML, whose `Accept` names
/// `text/html`. A browser sends that only when it navigates to a page,
/// never for a script, stylesheet, image or `fetch`, so the path may hold
/// a dot (`/users/jane.doe`) and a missing `/assets/app.js` stays a 404.
//! import std::http.Method
//! import std::http_testing
//!
//! asked = fn method: Method, target: String, accept: String ->
//!     r = http_testing.request(method, target)
//!     {..r, headers: Headers.set(r.headers, "Accept", accept)}
//! end
//!
//! html = "text/html,application/xhtml+xml,*/*;q=0.8"
//! assert is_page_route(asked(Method.Get, "/settings/profile", html))
//! assert is_page_route(asked(Method.Get, "/users/jane.doe", html))
//! refute is_page_route(asked(Method.Get, "/assets/app.js", "*/*"))
//! refute is_page_route(asked(Method.Post, "/settings", html))
//! refute is_page_route(asked(Method.Get, "/api/users", "application/json"))
//! refute is_page_route(asked(Method.Get, "/api/users", "*/*"))
//
pub fn is_page_route(request: Request) -> Bool
    takes_html =
        Headers.values(request.headers, "Accept")
        |> Iter.any_match(fn v -> String.contains(String.lowercase(v), "text/html"))

    (request.method == Method.Get or request.method == Method.Head) and takes_html
end

/// Whether `file` is one an `immutable` entry `pattern` covers: a glob
/// (`path.matches`), or with no wildcard the file itself or every file
/// under the directory it names.
fn immutable_match(pattern: String, file: String) -> Bool
    if Iter.any_match(["*", "?", "["], fn w -> String.contains(pattern, w)) then
        path.matches(pattern, file)
    else
        named = path.clean(pattern)
        file == named or String.starts_with(file, "${named}/")
    end
end

/// `asked` with a leading `/`.
fn rooted(asked: String) -> String
    if String.starts_with(asked, "/") then
        asked
    else
        "/${asked}"
    end
end

/// The embedded file at `file`, which is one, as the response to
/// `request`: `serve_embedded`'s headers, and its precompressed sibling
/// when the request takes it.
fn embedded_file(request: Request, files: Files, file: String, immutable: List<String>) -> Response
    siblings =
        [("br", "${file}.br"), ("gzip", "${file}.gz")]
        |> Iter.filter(fn (_, sibling) -> Files.exists(files, sibling))
        |> Iter.to_list()

    codings = accepted_codings(request)

    (sent, coding) =
        siblings
        |> Iter.find(fn (c, _) -> Iter.contains(codings, c))
        |> Maybe.map(fn (coding, sibling) -> (sibling, Some(coding)))
        |> Maybe.with_default((file, None))

    cache = if Iter.any_match(immutable, fn pattern -> immutable_match(pattern, file)) then
        "public, max-age=31536000, immutable"
    else
        "no-cache"
    end

    case Files.read(files, sent)
        Ok(data) ->
            sum = Files.sum(files, sent) |> Result.with_default("")

            vary = if Iter.is_empty(siblings) then
                []
            else
                [("Vary", "Accept-Encoding")]
            end

            encoding = case coding
                Some(c) -> [("Content-Encoding", c)]
                None -> []
            end

            headers = Headers(
                Iter.flatten([[("ETag", "\"${sum}\""), ("Cache-Control", cache)], vary, encoding])
            )

            Response.content(request, path.base(file), None, data, headers:)

        Err(e) ->
            failed(e)
    end
end

/// The content codings `request`'s `Accept-Encoding` takes, lowercased,
/// without one it gives `q=0`.
fn accepted_codings(request: Request) -> List<String>
    Headers.values(request.headers, "Accept-Encoding")
    |> Iter.flat_map(fn v -> String.split(v, ","))
    |> Iter.reject(fn item ->
        Iter.drop(String.split(item, ";"), 1)
        |> Iter.any_match(fn p ->
            case String.strip_prefix(String.trim(p), "q=")
                Some(q) -> String.replace(q, "0", "") == "" or String.replace(q, "0", "") == "."
                None -> False
            end
        end)
    end)
    |> Iter.map(fn item ->
        String.split(item, ";")
        |> Iter.first()
        |> Maybe.with_default("")
        |> String.trim()
        |> String.lowercase()
    end)
    |> Iter.to_list()
end

fn directory(request: Request, dir: String) -> Response
    index = path.join(dir, "index.html")

    case fs.metadata(index)
        Ok(_) ->
            case fs.read(index)
                Ok(data) -> Response.content(request, "index.html", None, data)
                Err(e) -> failed(e)
            end

        Err(_) ->
            case fs.list(dir)
                Ok(entries) ->
                    links = Html.each(entries, fn e ->
                        case e.kind
                            fs.Kind.Directory -> Html"<a href='./${e.name}/'>${e.name}/</a>\n"
                            _ -> Html"<a href='./${e.name}'>${e.name}</a>\n"
                        end
                    end)

                    Response.html(
                        Html"""
                        <!doctype html>
                        <meta name="viewport" content="width=device-width">
                        <pre>
                        ${links}</pre>
                        """
                    )

                Err(e) ->
                    failed(e)
            end
    end
end

fn failed(error: io.Error) -> Response
    case error
        .NotFound{path: _} -> Response.not_found()
        .PermissionDenied{path: _} -> Response.error(Status.forbidden, "403 Forbidden")
        _ -> Response.error(Status.internal_server_error, "500 Internal Server Error")
    end
end

/// The media type of `data`, guessed from at most its first 512 bytes by
/// the WHATWG MIME sniffing rules, as Go's `DetectContentType` guesses it:
/// `text/plain; charset=utf-8` for text, `application/octet-stream` when
/// nothing matches.
//! assert http.detect_content_type(String.to_bytes("<html>")) == "text/html; charset=utf-8"
//
pub fn detect_content_type(data: Bytes) -> String
    http_host.detect_content_type(data)
end

/// `at` as HTTP headers write dates, in GMT:
/// `Mon, 02 Jan 2006 15:04:05 GMT`.
//! import std::instant.Instant
//!
//! assert http.format_time(Instant.from_seconds(0)) == "Thu, 01 Jan 1970 00:00:00 GMT"
//
pub fn format_time(at: Instant) -> String
    http_host.format_time(Instant.as_nanos(at))
end

/// A date in any of the three formats HTTP allows: the one `format_time`
/// writes, RFC 850's and ANSI C's `asctime`.
pub fn parse_time(text: String) -> Result<Instant, Error>
    http_host.parse_time(text)
    |> Result.map(Instant.from_nanos)
    |> Result.map_err(fn reason -> Error.Protocol{reason:})
end

/// A cookie's `SameSite` attribute.
pub enum SameSite
    /// No attribute.
    Unset
    /// `SameSite` with no value.
    Default
    Lax
    Strict
    /// `SameSite=None`, which browsers accept only with `secure`.
    None
end

derive Equatable for SameSite

/// A cookie's `Max-Age`, in place of Go's 0 and negative codes.
pub enum MaxAge
    /// No `Max-Age` attribute.
    Unset
    /// `Max-Age=0`: delete the cookie now.
    DeleteNow
    Seconds Int
end

derive Equatable for MaxAge

/// An HTTP cookie: what a `Set-Cookie` header sets or a `Cookie` header
/// sends. `raw_expires`, `raw` and `unparsed` are set by parsing only.
pub struct Cookie
    name: String
    value: String
    /// Whether the value was or is to be written in double quotes.
    quoted: Bool = False
    path: Maybe<String> = None
    domain: Maybe<String> = None
    expires: Maybe<Instant> = None
    raw_expires: Maybe<String> = None
    max_age: MaxAge = MaxAge.Unset
    secure: Bool = False
    http_only: Bool = False
    same_site: SameSite = SameSite.Unset
    partitioned: Bool = False
    raw: Maybe<String> = None
    unparsed: List<String> = []
end

derive Equatable for Cookie

impl Cookie
    /// The cookies of a `Cookie` header's value, as Go's `ParseCookie`.
    //! import std::http.Cookie
    //!
    //! names = Cookie.parse_header("a=1; b=2")! |> Iter.map(fn c -> c.name) |> Iter.to_list()
    //! assert names == ["a", "b"]
    //
    pub fn parse_header(text: String) -> Result<List<Cookie>, Error>
        http_host.parse_cookie(text)
        |> Result.map(fn all -> all |> Iter.map(Cookie.of_parts) |> Iter.to_list())
        |> Result.map_err(fn reason -> Error.Protocol{reason:})
    end

    /// The cookie of a `Set-Cookie` header's value, as Go's
    /// `ParseSetCookie`.
    //! import std::http.{Cookie, MaxAge}
    //!
    //! c = Cookie.parse_set_cookie("id=7; Path=/; Max-Age=60; Secure")!
    //! assert c.path == Some("/")
    //! assert c.max_age == MaxAge.Seconds(60)
    //! assert c.secure
    //
    pub fn parse_set_cookie(text: String) -> Result<Cookie, Error>
        http_host.parse_set_cookie(text)
        |> Result.map(Cookie.of_parts)
        |> Result.map_err(fn reason -> Error.Protocol{reason:})
    end

    /// `Ok` when the cookie can be written in a `Set-Cookie` header: its
    /// name is a token, and its value, path, domain and expiry hold only
    /// what the header allows, and a partitioned cookie is secure.
    /// Otherwise `Error.Protocol` says what is wrong.
    pub fn validate(cookie: Cookie) -> Result<Unit, Error>
        reason = http_host.cookie_valid(Cookie.parts(cookie))

        if reason == "" then
            Ok(Unit)
        else
            Err(Error.Protocol{reason:})
        end
    end

    fn parts(cookie: Cookie) -> List<String>
        text = fn m: Maybe<String> -> Maybe.with_default(m, "")

        max_age = case cookie.max_age
            .Unset -> ""
            .DeleteNow -> "-1"
            .Seconds(n) -> "${n}"
        end

        same_site = case cookie.same_site
            .Unset -> ""
            .Default -> "default"
            .Lax -> "lax"
            .Strict -> "strict"
            .None -> "none"
        end

        [
            cookie.name,
            cookie.value,
            "${cookie.quoted}",
            text(cookie.path),
            text(cookie.domain),
            cookie.expires
            |> Maybe.map(fn at -> "${Instant.as_nanos(at)}")
            |> Maybe.with_default(""),
            text(cookie.raw_expires),
            max_age,
            "${cookie.secure}",
            "${cookie.http_only}",
            same_site,
            "${cookie.partitioned}",
            text(cookie.raw),
            ..cookie.unparsed
        ]
    end

    fn of_parts(parts: List<String>) -> Cookie
        case parts
            [name, value, quoted, path, domain, expires, raw_expires, max_age, secure, http_only, same_site, partitioned, raw, ..unparsed] ->
                some = fn t: String -> if t == "" then None else Some(t)

                Cookie{
                    name:,
                    value:,
                    quoted: quoted == "true",
                    path: some(path),
                    domain: some(domain),
                    expires: String.to_int(expires) |> Maybe.map(Instant.from_nanos),
                    raw_expires: some(raw_expires),
                    max_age: case max_age
                        "" ->
                            MaxAge.Unset

                        "-1" ->
                            MaxAge.DeleteNow

                        n ->
                            MaxAge.Seconds(
                                String.to_int(n)
                                |> Maybe.with_default(0)
                            )
                    end,
                    secure: secure == "true",
                    http_only: http_only == "true",
                    same_site: case same_site
                        "default" -> SameSite.Default
                        "lax" -> SameSite.Lax
                        "strict" -> SameSite.Strict
                        "none" -> SameSite.None
                        _ -> SameSite.Unset
                    end,
                    partitioned: partitioned == "true",
                    raw: some(raw),
                    unparsed:,
                }

            _ ->
                Cookie{name: "", value: ""}
        end
    end
end

/// The `Set-Cookie` value, or "" for a cookie that cannot be written
/// (`Cookie.validate`).
impl Display for Cookie
    fn to_string(cookie: Cookie) -> String
        http_host.cookie_text(Cookie.parts(cookie))
    end
end

/// Where a client keeps cookies: Go's net/http/cookiejar, with no public
/// suffix list. Give it to a client with `ClientOptions.cookies`.
pub struct CookieJar
    handle: http_host.Jar
end

impl CookieJar
    /// An empty jar.
    pub fn new() -> CookieJar
        CookieJar{handle: http_host.new_jar()}
    end

    /// The cookies the jar would send with a request to `url`.
    //! import std::http.{Cookie, CookieJar}
    //! import std::url.Url
    //!
    //! jar = CookieJar.new()
    //! CookieJar.set_cookies(jar, Url`https://example.com/`, [Cookie{name: "a", value: "1"}])
    //!
    //! sent =
    //!     CookieJar.cookies(jar, Url`https://example.com/x`) |> Iter.map(fn c -> c.name) |> Iter.to_list()
    //!
    //! assert sent == ["a"]
    //
    pub fn cookies(jar: CookieJar, url: Url) -> List<Cookie>
        http_host.jar_cookies(jar.handle, "${url}") |> Iter.map(Cookie.of_parts) |> Iter.to_list()
    end

    /// Stores `cookies`, as received in a response from `url`.
    pub fn set_cookies(jar: CookieJar, url: Url, cookies: List<Cookie>) -> Unit
        http_host.jar_set(
            jar.handle,
            "${url}",
            cookies
            |> Iter.map(Cookie.parts)
            |> Iter.to_list(),
        )
    end
end

/// What a server's connection is doing: Go's `ConnState`.
pub enum ConnState
    New
    Active
    Idle
    Hijacked
    Closed
end

derive Equatable for ConnState

impl Display for ConnState
    //! import std::http.ConnState
    //!
    //! assert "${ConnState.Idle}" == "idle"
    //
    fn to_string(state: ConnState) -> String
        case state
            .New -> "new"
            .Active -> "active"
            .Idle -> "idle"
            .Hijacked -> "hijacked"
            .Closed -> "closed"
        end
    end
end

/// Serves each request `listener` receives with `handler`, each as a task
/// of a `concurrent` block of its own, and returns once the listener shuts
/// down and every request it took is served. For a server with no
/// supervisor, as in a test; a program's server uses `serve` and a
/// supervisor, whose `max_running` bounds the requests in flight.
pub fn serve_here(listener: Listener, handler: Handler) -> Unit
    concurrent
        _ = Task.await_all(take_requests(listener, handler, []))
    end
end

fn take_requests(listener: Listener, handler: Handler, taken: List<Task<Unit>>) -> List<Task<Unit>>
    case http_host.next(listener.handle)
        Some(incoming) ->
            task = Task.spawn(fn -> answer(listener, incoming, handler))
            take_requests(listener, handler, [task, ..taken])

        None ->
            taken
    end
end

/// The request a reverse proxy received and the request it will send, for
/// its `rewrite` function: Go's `ProxyRequest`.
pub struct ProxyRequest
    incoming: Request
    outgoing: Request
end

impl ProxyRequest
    /// Sends the outgoing request to `target`: its scheme and host, its
    /// path joined before the request's, its query before the request's.
    /// The `Host` sent is the target's. Go's `SetURL`.
    pub fn set_url(proxy: ProxyRequest, target: Url) -> ProxyRequest
        out = proxy.outgoing
        incoming_url = out.url

        query = case (target.query, incoming_url.query)
            (Some(a), Some(b)) when a != "" and b != "" -> Some("${a}&${b}")
            (Some(a), _) when a != "" -> Some(a)
            (_, b) -> b
        end

        url = {
            ..incoming_url,
            scheme: target.scheme,
            host: target.host,
            path: join_paths(target.path, incoming_url.path),
            raw_path: None,
            query:,
        }

        {..proxy, outgoing: {..out, url:, host: None}}
    end

    /// Sets `X-Forwarded-For` to the client's address (added to what an
    /// earlier proxy set), `X-Forwarded-Host` to the host it asked for and
    /// `X-Forwarded-Proto` to `http` or `https`. Go's `SetXForwarded`.
    pub fn set_x_forwarded(proxy: ProxyRequest) -> ProxyRequest
        incoming = proxy.incoming

        client =
            net.split_host_port(incoming.remote_address)
            |> Result.map(fn (host, _) -> host)
            |> Result.with_default(incoming.remote_address)

        prior = Headers.values(incoming.headers, "X-Forwarded-For")
        forwarded = String.join([..prior, client], ", ")

        headers =
            proxy.outgoing.headers
            |> Headers.set("X-Forwarded-For", forwarded)
            |> Headers.set("X-Forwarded-Host", Maybe.with_default(incoming.host, incoming.url.host))
            |> Headers.set(
                "X-Forwarded-Proto",
                if incoming.url.scheme == "https" then
                    "https"
                else
                    "http"
                end,
            )

        {..proxy, outgoing: {.., headers:}}
    end
end

fn join_paths(a: String, b: String) -> String
    case (String.ends_with(a, "/"), String.starts_with(b, "/"))
        (True, True) -> a + String.drop(b, 1)
        (False, False) -> "${a}/${b}"
        _ -> a + b
    end
end

/// How a reverse proxy forwards: Go's `ReverseProxy`. `rewrite` turns each
/// request it receives into the one it sends.
pub struct ReverseProxy
    rewrite: (ProxyRequest) -> ProxyRequest
    /// The client that sends the outgoing request.
    client: Client = default_client()
    /// Changes each response before it goes back; an `Err` is handled as
    /// `on_error` does.
    modify_response: Maybe<(Response) -> Result<Response, Error>> = None
    /// Responds when the request fails; `None` returns 502 Bad Gateway.
    on_error: Maybe<(Request, Error) -> Response> = None
    /// How often the response is flushed to the client while it streams:
    /// `None` flushes it as it arrives only for a response of unknown
    /// length or an event stream, and otherwise at its end; zero flushes
    /// after each write. Go's `FlushInterval`.
    flush_interval: Maybe<Duration> = None
    /// Told each error the proxy meets: a request that failed, a copy that
    /// broke. `None` writes them to standard error. Go's `ErrorLog`.
    on_error_log: Maybe<(String) -> Unit> = None
end

impl ReverseProxy
    /// A proxy to one host: each request goes to `target`, its path joined
    /// after the target's, with `X-Forwarded-*` set. Go's
    /// `NewSingleHostReverseProxy`.
    pub fn to(target: Url) -> ReverseProxy
        ReverseProxy{
            rewrite: fn p -> ProxyRequest.set_url(p, target) |> ProxyRequest.set_x_forwarded(),
        }
    end
end

/// The headers that describe one connection, which a proxy does not pass
/// on (RFC 9110, section 7.6.1).
once hop_headers = [
    "Connection",
    "Proxy-Connection",
    "Keep-Alive",
    "Proxy-Authenticate",
    "Proxy-Authorization",
    "Te",
    "Trailer",
    "Transfer-Encoding",
    "Upgrade",
]

fn without_hop_headers(headers: Headers) -> Headers
    named =
        Headers.values(headers, "Connection")
        |> Iter.flat_map(fn v -> String.split(v, ","))
        |> Iter.map(String.trim)
        |> Iter.to_list()

    [..hop_headers, ..named] |> Iter.reduce(headers, fn h, name -> Headers.remove(h, name))
end

/// A handler that forwards each request as `options` says and responds
/// with the response, its connection headers removed: Go's
/// `ReverseProxy.ServeHTTP`. The response streams to the client as it
/// arrives, flushed as `flush_interval` says.
pub fn reverse_proxy(options: ReverseProxy) -> (Request) -> Response
    fn request ->
        outgoing = {
            ..request,
            headers: without_hop_headers(request.headers),
            request_uri: "",
            host: request.host,
        }

        rewritten = options.rewrite(ProxyRequest{incoming: request, outgoing:})

        answered =
            forward(options, rewritten.outgoing)
            |> Result.map(fn r -> {..r, headers: without_hop_headers(r.headers)})
            |> Result.flat_map(fn r ->
                case options.modify_response
                    Some(modify) -> modify(r)
                    None -> Ok(r)
                end
            end)

        case answered
            Ok(response) ->
                response

            Err(error) ->
                proxy_log(options, "${error}")

                case options.on_error
                    Some(on_error) -> on_error(request, error)
                    None -> Response{status: Status.bad_gateway, body: Body.Empty}
                end
        end
    end
end

fn proxy_log(options: ReverseProxy, text: String) -> Unit
    case options.on_error_log
        Some(told) ->
            told(text)

        None ->
            _ = io.Writer.write_text(io.stderr, "http: proxy error: ${text}\n")
    end
end

// The upstream response with a body that streams to the client: sent once,
// following no redirect, as Go's Transport does for a ReverseProxy. A faked
// or round-tripped client response comes back whole.
fn forward(options: ReverseProxy, outgoing: Request) -> Result<Response, Error>
    faked: Maybe<Result<Response, Error>> = http_host.answered(outgoing)
    if Some(answer) = faked then return answer
    Client{handle:, options: client_options} = options.client
    if Some(round_trip) = client_options.round_trip then return round_trip(outgoing)
    exchange = send(handle, outgoing, True, None)?
    reader = http_host.body_reader(exchange)
    head = response_of(exchange, Body.Empty)

    content_type = Headers.get(head.headers, "Content-Type") |> Maybe.with_default("")

    streaming = Maybe.is_none(head.content_length)
        or String.starts_with(content_type, "text/event-stream")

    every = case options.flush_interval
        Some(d) -> Some(d)
        None when streaming -> Some(Duration.nanoseconds(0))
        None -> None
    end

    Ok({
        ..head,
        body: Body.Produce(fn w ->
            defer http_host.close_body(exchange)

            pump(reader, w, every, Instant.now())
            |> Result.map_err(fn e ->
                proxy_log(options, "${e}")
                e
            end)
        end),
    })
end

fn pump(r: Reader, w: Writer, every: Maybe<Duration>, flushed: Instant) -> Result<Unit, io.Error>
    case Reader.read(r)?
        None ->
            Writer.flush(w)

        Some(chunk) ->
            Writer.write(w, chunk)?
            now = Instant.now()

            due = case every
                Some(d) -> Duration.as_nanos(Instant.between(flushed, now)) >= Duration.as_nanos(d)
                None -> False
            end

            if due then
                Writer.flush(w)?
                pump(r, w, every, now)
            else
                pump(r, w, every, flushed)
            end
    end
end

/// Records what Go's client reports while it sends the requests that name
/// it in `Request.trace`: Go's `httptrace.ClientTrace`, as data rather than
/// callbacks.
pub struct Tracer
    handle: http_host.Handle
end

impl Tracer
    pub fn new() -> Tracer
        Tracer{handle: http_host.new_tracer()}
    end

    /// What happened so far, in order.
    pub fn events(tracer: Tracer) -> List<TraceEvent>
        http_host.tracer_events(tracer.handle)
        |> Iter.flat_map(TraceEvent.of_parts)
        |> Iter.to_list()
    end
end

/// One thing a client did while it sent a request: Go's `ClientTrace`
/// hooks, each with its info's fields.
pub enum TraceEvent
    /// It looked for a connection to `address` (`host:port`).
    GetConnection {address: String}
    /// It got one: reused from an earlier request, idle for `idle_time`.
    GotConnection {reused: Bool, was_idle: Bool, idle_time: Duration}
    /// It returned the connection to the idle pool, or failed to.
    PutIdleConnection {error: Maybe<String>}
    FirstResponseByte
    /// The server sent `100 Continue`.
    Continue
    /// The server sent a 1xx status before the final one.
    Informational {status: Status, headers: Headers}
    DnsStart {host: String}
    DnsDone {addresses: List<String>, error: Maybe<String>, coalesced: Bool}
    ConnectStart {network: String, address: String}
    ConnectDone {network: String, address: String, error: Maybe<String>}
    TlsStart
    TlsDone {state: tls.ConnectionState, error: Maybe<String>}
    /// It wrote one header field.
    WroteHeader {name: String, values: List<String>}
    WroteHeaders
    /// It waits for `100 Continue` before sending the body.
    WaitContinue
    WroteRequest {error: Maybe<String>}
end

impl TraceEvent
    fn of_parts(parts: List<List<String>>) -> Maybe<TraceEvent>
        error = fn text: String -> if text == "" then None else Some(text)

        case parts
            [["GetConnection", address]] ->
                Some(TraceEvent.GetConnection{address:})

            [["GotConnection", reused, was_idle, idle]] ->
                Some(TraceEvent.GotConnection{
                    reused: reused == "true",
                    was_idle: was_idle == "true",
                    idle_time: Duration.nanoseconds(
                        String.to_int(idle)
                        |> Maybe.with_default(0)
                    ),
                })

            [["PutIdleConnection", e]] ->
                Some(TraceEvent.PutIdleConnection{error: error(e)})

            [["FirstResponseByte"]] ->
                Some(TraceEvent.FirstResponseByte)

            [["Continue"]] ->
                Some(TraceEvent.Continue)

            [["Informational", code, ..headers]] ->
                Some(TraceEvent.Informational{
                    status: Status(
                        String.to_int(code)
                        |> Maybe.with_default(0)
                    ),
                    headers: Headers(pairs(headers)),
                })

            [["DnsStart", host]] ->
                Some(TraceEvent.DnsStart{host:})

            [["DnsDone", coalesced, e, ..addresses]] ->
                Some(
                    TraceEvent.DnsDone{addresses:, error: error(e), coalesced: coalesced == "true"}
                )

            [["ConnectStart", network, address]] ->
                Some(TraceEvent.ConnectStart{network:, address:})

            [["ConnectDone", network, address, e]] ->
                Some(TraceEvent.ConnectDone{network:, address:, error: error(e)})

            [["TlsStart"]] ->
                Some(TraceEvent.TlsStart)

            [["TlsDone", e], ..state] ->
                Some(
                    TraceEvent.TlsDone{state: tls.ConnectionState.of_parts(state), error: error(e)}
                )

            [["WroteHeader", name, ..values]] ->
                Some(TraceEvent.WroteHeader{name:, values:})

            [["WroteHeaders"]] ->
                Some(TraceEvent.WroteHeaders)

            [["WaitContinue"]] ->
                Some(TraceEvent.WaitContinue)

            [["WroteRequest", e]] ->
                Some(TraceEvent.WroteRequest{error: error(e)})

            _ ->
                None
        end
    end
end

fn wire_parts_of(
    message: http_host.Handle,
) -> (List<String>, List<String>, List<String>, List<String>)
    case http_host.wire_parts(message)
        [head, headers, trailers, encoding] -> (head, headers, trailers, encoding)
        _ -> ([], [], [], [])
    end
end

fn wire_length(text: String) -> Maybe<Int>
    case String.to_int(text)
        Some(n) when n >= 0 -> Some(n)
        _ -> None
    end
end

fn wire_request(op: Int, request: Request, w: Writer) -> Result<String, Error>
    data = Body.read_all(request.body)?

    http_host.wire_request(
        op,
        w,
        Method.text(request.method),
        "${request.url}",
        flat(typed(request.headers, request.body)),
        Maybe.with_default(request.host, ""),
        Maybe.with_default(request.content_length, -1),
        request.transfer_encoding,
        request.close,
        flat(request.trailers),
        data,
    )
    |> Result.map_err(fn reason -> Error.Protocol{reason:})
end

fn wire_response(op: Int, response: Response, w: Writer) -> Result<String, Error>
    data = Body.read_all(response.body)?

    http_host.wire_response(
        op,
        w,
        Status.code(response.status),
        response.protocol.major,
        response.protocol.minor,
        flat(typed(response.headers, response.body)),
        Maybe.with_default(response.content_length, -1),
        response.transfer_encoding,
        response.close,
        flat(response.trailers),
        data,
        "GET",
    )
    |> Result.map_err(fn reason -> Error.Protocol{reason:})
end

/// A reader of the chunked transfer coding over `r`, which ends at the
/// last, empty chunk: httputil's `NewChunkedReader`.
//! import std::http
//! import std::io.Reader
//!
//! r = http.chunked_reader(Reader.from_text("2\r\nhi\r\n0\r\n\r\n"))
//! assert Reader.read_all_text(r) == Ok("hi")
//
pub fn chunked_reader(r: Reader) -> Reader
    http_host.chunked_reader(r)
end

/// A writer that sends what it is given to `w` in the chunked transfer
/// coding; closing it writes the last, empty chunk and leaves `w` open:
/// httputil's `NewChunkedWriter`.
pub fn chunked_writer(w: Writer) -> Writer
    http_host.chunked_writer(w)
end

/// One part of a multipart body, read as it arrives: Go's
/// `multipart.Part`. Reading the next part ends this one.
pub struct Part
    headers: Headers
    body: Reader
    handle: http_host.Handle
end

impl Part
    /// The `name` of its `form-data` `Content-Disposition`, if any.
    pub fn form_name(part: Part) -> Maybe<String>
        case http_host.part_form_name(part.handle)
            "" -> None
            name -> Some(name)
        end
    end

    /// The `filename` of its `Content-Disposition`, if any.
    pub fn file_name(part: Part) -> Maybe<String>
        case http_host.part_file_name(part.handle)
            "" -> None
            name -> Some(name)
        end
    end
end

/// The parts of the multipart body `r` holds, separated by `boundary`, each
/// read as the iteration reaches it: Go's `multipart.NewReader` and its
/// `NextPart`, which decodes quoted-printable parts. An `Err` ends it.
//! import std::http
//! import std::http.Part
//! import std::io.Reader
//!
//! body = "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\none\r\n--b--\r\n"
//!
//! names =
//!     http.multipart_parts(Reader.from_text(body), "b")
//!     |> Iter.map(fn p -> p |> Result.map(Part.form_name))
//!     |> Iter.to_list()
//!
//! assert names == [Ok(Some("a"))]
//
pub fn multipart_parts(r: Reader, boundary: String) -> Iter<Result<Part, Error>>
    parts_of(http_host.multipart_reader(r, boundary, False))
end

/// `multipart_parts` with each part as it was sent, not decoded: Go's
/// `NextRawPart`.
pub fn multipart_raw_parts(r: Reader, boundary: String) -> Iter<Result<Part, Error>>
    parts_of(http_host.multipart_reader(r, boundary, True))
end

fn parts_of(reader: http_host.Handle) -> Iter<Result<Part, Error>>
    Iter.repeat(reader)
    |> Iter.scan(Err(Error.Form{reason: ""}), fn previous: Result<Part, Error>, h ->
        if Err(Error.Form{reason:}) = previous then
            if reason != "" then break
        end

        case http_host.next_part(h)
            Ok(Some(part)) ->
                Ok(Part{
                    headers: Headers(pairs(http_host.part_headers(part))),
                    body: http_host.part_reader(part),
                    handle: part,
                })

            Ok(None) ->
                break

            Err(reason) ->
                Err(Error.Form{reason:})
        end
    end)
end

/// The multipart form `r` holds, read whole: Go's `Reader.ReadForm`. A
/// form larger than `max` bytes is `Error.BodyTooLarge`; no more than one
/// byte past `max` is read.
pub fn read_multipart_form(
    r: Reader,
    boundary: String,
    max: Int = 33_554_432,
) -> Result<MultipartForm, Error>
    data = read_capped(Body.Stream(r), max, None)?

    flat =
        http_host.parse_multipart("multipart/form-data; boundary=${boundary}", data)
        |> Result.map_err(fn reason -> Error.Form{reason:})?

    Ok(multipart_of(flat, MultipartForm{}))
end

/// Writes `parts` to `w` as a multipart body separated by `boundary`, each
/// as it comes, then the closing boundary: Go's `multipart.Writer`. The
/// body's `Content-Type` is `multipart/form-data; boundary=` and the
/// boundary.
pub fn write_multipart(w: Writer, boundary: String, parts: List<FormPart>) -> Result<Unit, Error>
    flat = parts |> Iter.flat_map(FormPart.flat) |> Iter.to_list()
    http_host.multipart_write(w, boundary, flat) |> Result.map_err(fn reason -> Error.Form{reason:})
end
