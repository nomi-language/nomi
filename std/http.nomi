//# An HTTP client and server. A `Request` is a value; `http.fetch`
//# sends it with the ambient client and reads the whole response, and
//# `http.with_response` gives a body the response with its body still
//# streaming. A status is never an error: a 404 is a `Response` whose
//# `status` a program checks with `Status.is_success`.
//#
//# ```nomi
//# response = http.get(Url`https://api.example.com/users`)?
//#
//# if Status.is_success(response.status) { dbg Response.text(response)? }
//# ```
//#
//# Every request runs under the context in force: its deadline bounds the
//# request, and cancelling the task cancels it. `http_testing.run` answers
//# requests with a function instead of the network, in tests and in the
//# tour. A `Client` made with `Client.new` holds its own options and
//# connection pool.

import {
    base64
    bool.Bool.{self, False, True}
    bytes.Bytes
    channels.{Channel, Receiver, Sender}
    context.Context
    display.Display
    duration.Duration
    equatable.Equatable
    fs
    hashable.Hashable
    html.Html
    http_host
    instant.Instant
    int.Int
    io
    io.{Reader, Writer}
    iter.Iter
    json.Json
    lists.List
    literals.{Fragment, Literal}
    maps.Map
    maybe.Maybe.{self, None, Some}
    net
    path
    results.Result.{self, Err, Ok}
    strings.String
    supervisors.Supervisor
    tasks.Task
    tls
    unit.Unit
    url.{self, Query, Url}
}

/// A request method. `Other` holds any method Go sends as written.
pub enum Method {
    Get
    Head
    Post
    Put
    Patch
    Delete
    Connect
    Options
    Trace
    Other String
}

derive Equatable for Method
derive Hashable for Method

impl Method {
    /// The method as it is written on the wire: `GET`, or `Other`'s text.
    //! import std/http.Method
    //!
    //! assert Method.text(Method.Patch) == "PATCH"
    //! assert Method.text(Method.Other("PURGE")) == "PURGE"
    //
    pub fn text(method: Method) -> String {
        case method {
            .Get -> "GET"
            .Head -> "HEAD"
            .Post -> "POST"
            .Put -> "PUT"
            .Patch -> "PATCH"
            .Delete -> "DELETE"
            .Connect -> "CONNECT"
            .Options -> "OPTIONS"
            .Trace -> "TRACE"
            .Other(text) -> text
        }
    }

    /// The method `text` names, `Other` for one Go has no constant for.
    //! import std/http.Method
    //!
    //! assert Method.parse("DELETE") == Method.Delete
    //! assert Method.parse("PURGE") == Method.Other("PURGE")
    //
    pub fn parse(text: String) -> Method {
        case text {
            "GET" -> Method.Get
            "HEAD" -> Method.Head
            "POST" -> Method.Post
            "PUT" -> Method.Put
            "PATCH" -> Method.Patch
            "DELETE" -> Method.Delete
            "CONNECT" -> Method.Connect
            "OPTIONS" -> Method.Options
            "TRACE" -> Method.Trace
            other -> Method.Other(other)
        }
    }
}

impl Display for Method {
    fn to_string(method: Method) -> String {
        Method.text(method)
    }
}

/// An HTTP status code. Any code from 100 to 999 is a `Status`; the
/// constants name the ones Go names.
pub type Status Int

derive Equatable for Status
derive Hashable for Status

impl Status {
    pub once continue_status = Status(100)
    pub once switching_protocols = Status(101)
    pub once processing = Status(102)
    pub once early_hints = Status(103)
    pub once ok = Status(200)
    pub once created = Status(201)
    pub once accepted = Status(202)
    pub once non_authoritative_info = Status(203)
    pub once no_content = Status(204)
    pub once reset_content = Status(205)
    pub once partial_content = Status(206)
    pub once multi_status = Status(207)
    pub once already_reported = Status(208)
    pub once im_used = Status(226)
    pub once multiple_choices = Status(300)
    pub once moved_permanently = Status(301)
    pub once found = Status(302)
    pub once see_other = Status(303)
    pub once not_modified = Status(304)
    pub once use_proxy = Status(305)
    pub once temporary_redirect = Status(307)
    pub once permanent_redirect = Status(308)
    pub once bad_request = Status(400)
    pub once unauthorized = Status(401)
    pub once payment_required = Status(402)
    pub once forbidden = Status(403)
    pub once not_found = Status(404)
    pub once method_not_allowed = Status(405)
    pub once not_acceptable = Status(406)
    pub once proxy_auth_required = Status(407)
    pub once request_timeout = Status(408)
    pub once conflict = Status(409)
    pub once gone = Status(410)
    pub once length_required = Status(411)
    pub once precondition_failed = Status(412)
    pub once request_entity_too_large = Status(413)
    pub once request_uri_too_long = Status(414)
    pub once unsupported_media_type = Status(415)
    pub once requested_range_not_satisfiable = Status(416)
    pub once expectation_failed = Status(417)
    pub once teapot = Status(418)
    pub once misdirected_request = Status(421)
    pub once unprocessable_entity = Status(422)
    pub once locked = Status(423)
    pub once failed_dependency = Status(424)
    pub once too_early = Status(425)
    pub once upgrade_required = Status(426)
    pub once precondition_required = Status(428)
    pub once too_many_requests = Status(429)
    pub once request_header_fields_too_large = Status(431)
    pub once unavailable_for_legal_reasons = Status(451)
    pub once internal_server_error = Status(500)
    pub once not_implemented = Status(501)
    pub once bad_gateway = Status(502)
    pub once service_unavailable = Status(503)
    pub once gateway_timeout = Status(504)
    pub once http_version_not_supported = Status(505)
    pub once variant_also_negotiates = Status(506)
    pub once insufficient_storage = Status(507)
    pub once loop_detected = Status(508)
    pub once not_extended = Status(510)
    pub once network_authentication_required = Status(511)

    /// The status with `code`, or an `Err` outside 100 to 999.
    //! import std/http.Status
    //!
    //! assert Status.from_code(404) == Ok(Status.not_found)
    //! assert Status.from_code(42) |> Result.is_err()
    //
    pub fn from_code(code: Int) -> Result<Status, Error> {
        if code < 100 or code > 999 {
            return Err(Error.InvalidRequest{reason: "status code ${code} is not in 100 to 999"})
        }

        Ok(Status(code))
    }

    /// The status's number.
    pub fn code(status: Status) -> Int {
        Status(code) = status
        code
    }

    /// Go's `StatusText`: "Not Found", or "" for a code Go does not name.
    //! import std/http.Status
    //!
    //! assert Status.text(Status.not_found) == "Not Found"
    //! assert Status.text(Status(599)) == ""
    //
    pub fn text(status: Status) -> String {
        http_host.status_text(Status.code(status))
    }

    /// The status line's code and text: "404 Not Found".
    //! import std/http.Status
    //!
    //! assert Status.line(Status.teapot) == "418 I'm a teapot"
    //
    pub fn line(status: Status) -> String {
        case Status.text(status) {
            "" -> "${Status.code(status)}"
            text -> "${Status.code(status)} ${text}"
        }
    }

    /// 1xx.
    pub fn is_informational(status: Status) -> Bool {
        Status.code(status) / 100 == 1
    }

    /// 2xx.
    //! import std/http.Status
    //!
    //! assert Status.is_success(Status.no_content)
    //! assert not Status.is_success(Status.found)
    //
    pub fn is_success(status: Status) -> Bool {
        Status.code(status) / 100 == 2
    }

    /// 3xx.
    pub fn is_redirect(status: Status) -> Bool {
        Status.code(status) / 100 == 3
    }

    /// 4xx.
    pub fn is_client_error(status: Status) -> Bool {
        Status.code(status) / 100 == 4
    }

    /// 5xx.
    pub fn is_server_error(status: Status) -> Bool {
        Status.code(status) / 100 == 5
    }
}

impl Display for Status {
    /// The status line's code and text, as `Status.line`.
    fn to_string(status: Status) -> String {
        Status.line(status)
    }
}

/// Header fields in order. A name may appear more than once, and names
/// compare without case.
pub type Headers List<#(String, String)>

derive Equatable for Headers

impl Headers {
    /// Go's `CanonicalHeaderKey`: `content-type` is `Content-Type`.
    //! import std/http.Headers
    //!
    //! assert Headers.canonical_key("x-request-id") == "X-Request-Id"
    //
    pub fn canonical_key(name: String) -> String {
        http_host.canonical_key(name)
    }

    /// The first value of `name`.
    //! import std/http.Headers
    //!
    //! h = Headers[#("Accept", "text/html"), #("accept", "*/*")]
    //! assert Headers.get(h, "ACCEPT") == Some("text/html")
    //! assert Headers.values(h, "accept") == ["text/html", "*/*"]
    //
    pub fn get(headers: Headers, name: String) -> Maybe<String> {
        Headers.values(headers, name) |> List.head()
    }

    /// Every value of `name`, in order.
    pub fn values(headers: Headers, name: String) -> List<String> {
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        fields
        |> Iter.filter(fn #(k, _) -> Headers.canonical_key(k) == key)
        |> Iter.map(fn #(_, v) -> v)
        |> Iter.to_list()
    }

    /// Whether `name` has a value.
    pub fn has(headers: Headers, name: String) -> Bool {
        Headers.values(headers, name) != []
    }

    /// The fields with `name`'s values replaced by `value`, in the place of
    /// its first value, or added at the end.
    //! import std/http.Headers
    //!
    //! h = Headers[#("A", "1"), #("B", "2"), #("a", "3")]
    //! assert Headers.set(h, "a", "9") == Headers[#("A", "9"), #("B", "2")]
    //
    pub fn set(headers: Headers, name: String, value: String) -> Headers {
        if not Headers.has(headers, name) { return Headers.add(headers, name, value) }
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        #(_, kept) = Iter.map_reduce(fields, False, fn seen, #(k, v) -> {
            if Headers.canonical_key(k) != key { return #(seen, [#(k, v)]) }

            if seen {
                #(True, [])
            } else {
                #(True, [#(k, value)])
            }
        })

        Headers(
            kept
            |> Iter.flat_map(fn p -> p)
            |> Iter.to_list()
        )
    }

    /// The fields with `value` added to `name`'s, at the end.
    pub fn add(headers: Headers, name: String, value: String) -> Headers {
        Headers(fields) = headers
        Headers(fields + [#(name, value)])
    }

    /// The fields without `name`.
    pub fn remove(headers: Headers, name: String) -> Headers {
        Headers(fields) = headers
        key = Headers.canonical_key(name)

        Headers(
            fields
            |> Iter.filter(fn #(k, _) -> Headers.canonical_key(k) != key)
            |> Iter.to_list()
        )
    }

    /// Writes the headers in wire format, `Name: value` lines each ending
    /// in CRLF, sorted by name, leaving out the names in `except`: Go's
    /// `Header.Write` and `WriteSubset`.
    //! import std/http.Headers
    //! import std/io.Writer
    //!
    //! #(_, written) = Writer.collect(fn w -> Headers.write_to(Headers[#("b", "2"), #("A", "1")], w))
    //! assert Bytes.to_string(written) == Ok("A: 1\r\nB: 2\r\n")
    //
    pub fn write_to(
        headers: Headers,
        w: io.Writer,
        except: List<String> = [],
    ) -> Result<Unit, io.Error> {
        Headers(fields) = headers
        skipped = except |> Iter.map(Headers.canonical_key) |> Iter.to_list()

        lines =
            fields
            |> Iter.map(fn #(name, value) -> #(Headers.canonical_key(name), value))
            |> Iter.filter(fn #(name, _) -> not (skipped |> Iter.any(fn s -> s == name)))
            |> Iter.sort_by(fn #(name, _) -> name)
            |> Iter.map(fn #(name, value) -> "${name}: ${value}\r\n")

        io.Writer.write_text(w, String.join(lines))
    }
}

/// A request's or response's body.
pub enum Body {
    Empty
    /// Sent with `Content-Type: text/plain; charset=utf-8` unless the
    /// request sets one.
    Text String
    Bytes Bytes
    /// Encoded with `Json.encode`; sent with `Content-Type:
    /// application/json` unless the request sets one.
    Json Json
    /// Rendered markup; sent with `Content-Type: text/html;
    /// charset=utf-8` unless the request or response sets one.
    Html Html
    /// URL-encoded; sent with `Content-Type:
    /// application/x-www-form-urlencoded` unless the request sets one.
    Form Query
    /// A `multipart/form-data` form; sent with its `Content-Type` and
    /// boundary unless the request sets one.
    Multipart List<FormPart>
    /// A stream, read once. `with_response`'s response body is one.
    Stream Reader
    /// A response body a function writes as the client reads it, for
    /// streaming and server-sent events: what it writes is sent each time
    /// the writer passes bytes on, at `Writer.flush` or when its buffer
    /// fills. A server's response only; a request refuses it.
    Produce (io.Writer) -> Result<Unit, io.Error>
}

impl Body {
    /// A `Reader` over the body.
    pub fn reader(body: Body) -> Reader {
        case body {
            .Stream(r) -> r
            other -> Reader.from_bytes(Body.bytes_of(other))
        }
    }

    /// The whole body, a stream read to its end.
    //! import std/http.Body
    //!
    //! assert Body.read_all(Body.Text("hi")) == Ok(String.to_bytes("hi"))
    //
    pub fn read_all(body: Body) -> Result<Bytes, Error> {
        case body {
            .Stream(r) -> Reader.read_all(r) |> Result.map_err(fn e -> Error.Body{error: e})
            other -> Ok(Body.bytes_of(other))
        }
    }

    fn bytes_of(body: Body) -> Bytes {
        case body {
            .Empty -> String.to_bytes("")
            .Text(text) -> String.to_bytes(text)
            .Bytes(data) -> data
            .Json(value) -> String.to_bytes(Json.encode(value))
            .Html(page) -> String.to_bytes(Html.to_string(page))
            .Form(query) -> String.to_bytes(Query.encode(query))
            .Multipart(parts) -> FormPart.encode(parts).body
            .Stream(_) -> String.to_bytes("")
            .Produce(_) -> String.to_bytes("")
        }
    }
}

/// One part of a `Body.Multipart` form.
pub enum FormPart {
    /// A field and its value: Go's `Writer.WriteField`.
    Field {name: String, value: String}
    /// A file: Go's `Writer.CreateFormFile`, with a content type.
    File {
        field: String,
        filename: String,
        content_type: String = "application/octet-stream",
        content: Bytes,
    }
    /// A part with headers of its own: Go's `Writer.CreatePart`.
    Raw {headers: Headers, content: Bytes}
}

impl FormPart {
    /// `parts` as a multipart body, and the `Content-Type` that names its
    /// boundary. The boundary is a digest of the parts, so the same parts
    /// always encode to the same bytes.
    //! import std/http.FormPart
    //!
    //! encoded = FormPart.encode([FormPart.Field{name: "a", value: "1"}])
    //! assert String.starts_with(encoded.content_type, "multipart/form-data; boundary=")
    //
    pub fn encode(parts: List<FormPart>) -> #{content_type: String, body: Bytes} {
        flat = parts |> Iter.flat_map(FormPart.flat) |> Iter.to_list()

        case http_host.encode_multipart(flat) {
            [content_type, body] -> #{content_type: Bytes.to_string(content_type)!, body}
            _ -> #{content_type: "multipart/form-data", body: String.to_bytes("")}
        }
    }

    /// The `Content-Disposition` of a file part: Go's
    /// `multipart.FileContentDisposition`.
    //! import std/http.FormPart
    //!
    //! assert FormPart.file_disposition("doc", "a.txt") == "form-data; name=\"doc\"; filename=\"a.txt\""
    //
    pub fn file_disposition(field: String, filename: String) -> String {
        http_host.file_content_disposition(field, filename)
    }

    fn flat(part: FormPart) -> List<Bytes> {
        case part {
            .Field{name, value} ->
                ["v", name, value] |> Iter.map(String.to_bytes) |> Iter.to_list()

            .File{field, filename, content_type, content} ->
                [..(["f", field, filename, content_type] |> Iter.map(String.to_bytes)), content]

            .Raw{headers, content} -> {
                Headers(pairs) = headers
                texts = pairs |> Iter.flat_map(fn #(k, v) -> [k, v]) |> Iter.to_list()
                [..(["r", "${Iter.count(pairs)}", ..texts] |> Iter.map(String.to_bytes)), content]
            }
        }
    }
}

/// A file a multipart form holds: Go's `multipart.FileHeader`.
pub struct FormFile {
    filename: String
    headers: Headers = Headers[]
    size: Int = 0
    content: Bytes
}

impl FormFile {
    /// The file's content as a stream.
    pub fn open(file: FormFile) -> Reader {
        Reader.from_bytes(file.content)
    }
}

/// A multipart form: Go's `multipart.Form`.
pub struct MultipartForm {
    values: Query = Query[]
    files: Map<String, List<FormFile>> = %{}
}

fn multipart_of(flat: List<Bytes>, form: MultipartForm) -> MultipartForm {
    case flat {
        [kind, name, value, ..rest] when text_of(kind) == "v" ->
            multipart_of(
                rest,
                #{..form, values: Query.add(form.values, text_of(name), text_of(value))},
            )

        [_, field, filename, count, ..rest] -> {
            n = String.to_int(text_of(count)) |> Maybe.with_default(0)
            texts = rest |> Iter.take(2 * n) |> Iter.map(text_of) |> Iter.to_list()

            headers = Headers(
                texts
                |> Iter.chunks(2)
                |> Iter.flat_map(fn kv -> {
                    case kv {
                        [k, v] -> [#(k, v)]
                        _ -> []
                    }
                })
                |> Iter.to_list()
            )

            after = rest |> Iter.drop(2 * n) |> Iter.to_list()

            case after {
                [content, ..remaining] -> {
                    file = FormFile{
                        filename: text_of(filename),
                        headers,
                        size: Bytes.length(content),
                        content,
                    }

                    key = text_of(field)

                    files = Map.put(
                        form.files,
                        key,
                        [..Map.get(form.files, key) |> Maybe.with_default([]), file],
                    )

                    multipart_of(remaining, #{..form, files})
                }

                [] ->
                    form
            }
        }

        _ ->
            form
    }
}

fn text_of(data: Bytes) -> String {
    Bytes.to_string(data) |> Result.to_maybe() |> Maybe.with_default("")
}

/// An HTTP version.
pub struct Protocol {
    major: Int = 1
    minor: Int = 1
}

derive Equatable for Protocol

impl Protocol {
    /// Whether the version is `major.minor` or later.
    //! import std/http.Protocol
    //!
    //! assert Protocol.at_least(Protocol{major: 2, minor: 0}, 1, 1)
    //! assert not Protocol.at_least(Protocol{major: 1, minor: 0}, 1, 1)
    //
    pub fn at_least(protocol: Protocol, major: Int, minor: Int) -> Bool {
        protocol.major > major or protocol.major == major and protocol.minor >= minor
    }

    /// Reads an HTTP version, `HTTP/1.1`: Go's `ParseHTTPVersion`.
    //! import std/http.Protocol
    //!
    //! assert Protocol.parse("HTTP/2.0") == Some(Protocol{major: 2, minor: 0})
    //! assert Protocol.parse("HTTP/x") == None
    //
    pub fn parse(text: String) -> Maybe<Protocol> {
        case String.strip_prefix(text, "HTTP/") {
            Some(rest) ->
                case String.split(rest, ".") {
                    [a, b] ->
                        String.to_int(a)
                        |> Maybe.flat_map(fn major -> {
                            String.to_int(b) |> Maybe.map(fn minor -> Protocol{major, minor})
                        })

                    _ ->
                        None
                }

            None ->
                None
        }
    }
}

impl Display for Protocol {
    /// `HTTP/1.1`.
    fn to_string(protocol: Protocol) -> String {
        "HTTP/${protocol.major}.${protocol.minor}"
    }
}

/// A request to send, or one a server received.
pub struct Request {
    method: Method = Method.Get
    url: Url
    headers: Headers = Headers[]
    body: Body = Body.Empty
    /// The `Host` to send in place of the URL's host.
    host: Maybe<String> = None
    /// The body's length when it is known ahead.
    content_length: Maybe<Int> = None
    transfer_encoding: List<String> = []
    /// Close the connection after this request.
    close: Bool = False
    /// Trailers sent after a streamed body.
    trailers: Headers = Headers[]
    // Set by a server on a request it received.
    protocol: Protocol = Protocol{}
    remote_address: String = ""
    request_uri: String = ""
    pattern: Maybe<String> = None
    path_values: Map<String, String> = %{}
    context: Context = Context.root()
    /// The server address the request came in on.
    local_address: String = ""
    /// What the TLS handshake of the connection agreed on; `None` over
    /// plain HTTP.
    tls: Maybe<tls.ConnectionState> = None
    /// Records what happens while the client sends this request
    /// (`Tracer.events`).
    trace: Maybe<Tracer> = None
    /// The server's hold on a request it received, for
    /// `Request.extend_read_deadline`.
    incoming: Maybe<http_host.Incoming> = None
}

impl Request {
    /// The form, as Go's `Request.Form`: the fields of the body
    /// (`post_form`) and then the URL's query. It reads the body, which a
    /// request can do once, so keep what it answers.
    //! import std/http.{Body, Method, Request}
    //! import std/http_testing
    //! import std/url.Query
    //!
    //! r = #{..http_testing.request(Method.Post, "/?b=2"), body: Body.Form(Query[#("a", "1")])}
    //! r = #{..r, headers: Headers.set(r.headers, "Content-Type", "application/x-www-form-urlencoded")}
    //! assert Request.form(r) == Ok(Query[#("a", "1"), #("b", "2")])
    //
    pub fn form(request: Request) -> Result<Query, Error> {
        Query(posted) = Request.post_form(request)?
        Query(query) = Url.query_values(request.url)
        Ok(Query([..posted, ..query]))
    }

    /// The fields of the body, as Go's `Request.PostForm`: a URL-encoded
    /// body of a `POST`, `PUT` or `PATCH`, or a multipart form's fields.
    /// Empty for any other request. It reads the body.
    pub fn post_form(request: Request) -> Result<Query, Error> {
        media = Request.media_type(request)

        if media == "multipart/form-data" {
            return Request.multipart_form(request) |> Result.map(fn f -> f.values)
        }

        posts = request.method == Method.Post
            or request.method == Method.Put
            or request.method == Method.Patch

        if not posts or media != "application/x-www-form-urlencoded" { return Ok(Query[]) }
        data = Body.read_all(request.body)?

        text =
            Bytes.to_string(data)
            |> Result.map_err(fn _ -> Error.Form{reason: "the form is not UTF-8"})?

        Query.parse(text) |> Result.map_err(fn e -> Error.Form{reason: e.reason})
    }

    /// The first value of `key` in the form, as Go's `Request.FormValue`:
    /// `None` when the form has none or does not parse.
    pub fn form_value(request: Request, key: String) -> Maybe<String> {
        Request.form(request) |> Result.to_maybe() |> Maybe.flat_map(fn q -> Query.get(q, key))
    }

    /// The first value of `key` in the body's fields, as Go's
    /// `Request.PostFormValue`.
    pub fn post_form_value(request: Request, key: String) -> Maybe<String> {
        Request.post_form(request) |> Result.to_maybe() |> Maybe.flat_map(fn q -> Query.get(q, key))
    }

    /// The multipart form the body holds, as Go's
    /// `Request.ParseMultipartForm`. A body larger than `max_memory` bytes
    /// is refused, since the whole form is read into memory. It reads the
    /// body.
    pub fn multipart_form(
        request: Request,
        max_memory: Int = 33_554_432,
    ) -> Result<MultipartForm, Error> {
        content_type = Headers.get(request.headers, "Content-Type") |> Maybe.with_default("")
        data = Body.read_all(request.body)?

        if Bytes.length(data) > max_memory {
            return Err(Error.Form{reason: "the form is larger than ${max_memory} bytes"})
        }

        flat =
            http_host.parse_multipart(content_type, data)
            |> Result.map_err(fn reason -> Error.Form{reason})?

        Ok(multipart_of(flat, MultipartForm{}))
    }

    /// The first file in the multipart form's field `field`, as Go's
    /// `Request.FormFile`. It reads the body.
    //! import std/http.{Body, FormPart, Method, Request}
    //! import std/http_testing
    //!
    //! parts = [
    //!     FormPart.Field{name: "note", value: "hi"},
    //!     FormPart.File{field: "doc", filename: "a.txt", content: String.to_bytes("abc")},
    //! ]
    //!
    //! request = #{
    //!     ..http_testing.request(Method.Post, "/upload"),
    //!     headers: Headers[#("Content-Type", FormPart.encode(parts).content_type)],
    //!     body: Body.Multipart(parts),
    //! }
    //!
    //! file = Request.form_file(request, "doc")!
    //! assert file.filename == "a.txt"
    //! assert file.size == 3
    //! assert Request.form_value(request, "note") == Some("hi")
    //! assert Request.form_file(request, "nope") == Err(Error.MissingFile{field: "nope"})
    //
    pub fn form_file(request: Request, field: String) -> Result<FormFile, Error> {
        form = Request.multipart_form(request)?

        Map.get(form.files, field)
        |> Maybe.flat_map(List.head)
        |> Maybe.to_result(Error.MissingFile{field})
    }

    /// The request's media type: its `Content-Type` without parameters, in
    /// lowercase.
    fn media_type(request: Request) -> String {
        Headers.get(request.headers, "Content-Type")
        |> Maybe.with_default("")
        |> String.split(";")
        |> List.head()
        |> Maybe.with_default("")
        |> String.trim()
        |> String.lowercase()
    }

    /// The cookies the request's `Cookie` headers send, as Go's
    /// `Request.Cookies`; one that does not parse is left out.
    //! import std/http.{Cookie, Method, Request}
    //! import std/http_testing
    //!
    //! r = Request.add_cookie(http_testing.request(Method.Get, "/"), Cookie{name: "a", value: "1"})
    //! assert Request.cookie(r, "a") |> Maybe.map(fn c -> c.value) == Some("1")
    //
    pub fn cookies(request: Request) -> List<Cookie> {
        Headers.values(request.headers, "Cookie")
        |> Iter.flat_map(fn line -> Cookie.parse_header(line) |> Result.with_default([]))
        |> Iter.to_list()
    }

    /// The cookies named `name`, as Go's `Request.CookiesNamed`.
    pub fn cookies_named(request: Request, name: String) -> List<Cookie> {
        Request.cookies(request) |> Iter.filter(fn c -> c.name == name) |> Iter.to_list()
    }

    /// The first cookie named `name`, as Go's `Request.Cookie`.
    pub fn cookie(request: Request, name: String) -> Maybe<Cookie> {
        Request.cookies_named(request, name) |> List.head()
    }

    /// The request with `cookie` added to its `Cookie` header, as Go's
    /// `Request.AddCookie`: only its name and value are sent.
    pub fn add_cookie(request: Request, cookie: Cookie) -> Request {
        pair = "${cookie.name}=${cookie.value}"

        headers = case Headers.get(request.headers, "Cookie") {
            Some(existing) -> Headers.set(request.headers, "Cookie", "${existing}; ${pair}")
            None -> Headers.set(request.headers, "Cookie", pair)
        }

        #{..request, headers}
    }

    /// The request with a body that fails past `max` bytes, as Go's
    /// `MaxBytesReader`: reading it then answers an `io.Error`.
    pub fn limit_body(request: Request, max: Int) -> Request {
        #{..request, body: Body.Stream(http_host.limit_body(Body.reader(request.body), max))}
    }

    /// The `User-Agent` header.
    pub fn user_agent(request: Request) -> Maybe<String> {
        Headers.get(request.headers, "User-Agent")
    }

    /// The `Referer` header.
    pub fn referer(request: Request) -> Maybe<String> {
        Headers.get(request.headers, "Referer")
    }

    /// The user and password of a `Basic` `Authorization` header.
    //! import std/http.Request
    //! import std/url.Url
    //!
    //! r = Request.with_basic_auth(Request{url: Url`https://example.com`}, "ann", "pw")
    //! assert Request.basic_auth(r) == Some(#("ann", "pw"))
    //
    pub fn basic_auth(request: Request) -> Maybe<#(String, String)> {
        Headers.get(request.headers, "Authorization")
        |> Maybe.flat_map(fn v -> String.strip_prefix(v, "Basic "))
        |> Maybe.flat_map(fn encoded -> base64.decode(encoded) |> Result.to_maybe())
        |> Maybe.flat_map(fn data -> Bytes.to_string(data) |> Result.to_maybe())
        |> Maybe.flat_map(fn text -> {
            case String.split(text, ":") {
                [user, ..rest] -> Some(#(user, String.join(rest, ":")))
                _ -> None
            }
        })
    }

    /// The request with a `Basic` `Authorization` header for `user` and
    /// `password`.
    pub fn with_basic_auth(request: Request, user: String, password: String) -> Request {
        token = base64.encode(String.to_bytes("${user}:${password}"))
        #{..request, headers: Headers.set(request.headers, "Authorization", "Basic ${token}")}
    }

    /// The value a router matched for the wildcard `name`.
    /// Lets the client take until `by` from now to send the rest of the
    /// body, past the server's `read_timeout`. Go's
    /// `ResponseController.SetReadDeadline`. An `Err` for a request no
    /// server received.
    pub fn extend_read_deadline(request: Request, by: Duration) -> Result<Unit, Error> {
        case request.incoming {
            Some(incoming) ->
                http_host.extend_read_deadline(incoming, Duration.as_nanos(by))
                |> Result.map_err(fn reason -> Error.Protocol{reason})

            None ->
                Err(Error.Protocol{reason: "the request was not received by a server"})
        }
    }

    /// Reads one request from `r` as it arrives on the wire, its body read
    /// whole: Go's `ReadRequest`. It reads no byte past the request, so the
    /// next one on `r` is left whole.
    //! import std/http.{Request, Method}
    //! import std/io.Reader
    //!
    //! r = Reader.from_text("POST /a?b=1 HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\nhi")
    //! request = Request.read(r)!
    //! assert request.method == Method.Post
    //! assert request.url.path == "/a"
    //! assert Body.read_all(request.body) == Ok(String.to_bytes("hi"))
    //
    pub fn read(r: Reader) -> Result<Request, Error> {
        message =
            http_host.wire_read_request(r) |> Result.map_err(fn reason -> Error.Protocol{reason})?

        #(head, headers, trailers, encoding) = wire_parts_of(message)

        #(method, target, major, minor, host, length, close) = case head {
            [m, t, a, b, h, n, c, _] -> #(m, t, a, b, h, n, c)
            _ -> #("GET", "/", "1", "1", "", "-1", "false")
        }

        url =
            Url.parse(target)
            |> Result.map_err(fn e -> Error.InvalidUrl{url: target, reason: "${e}"})?

        Ok(Request{
            method: Method.parse(method),
            url,
            headers: Headers(pairs(headers)),
            body: Body.Bytes(http_host.wire_body(message)),
            host: if host == "" { None } else { Some(host) },
            content_length: wire_length(length),
            transfer_encoding: encoding,
            close: close == "true",
            trailers: Headers(pairs(trailers)),
            protocol: Protocol{
                major: String.to_int(major) |> Maybe.with_default(1),
                minor: String.to_int(minor) |> Maybe.with_default(1),
            },
            request_uri: target,
        })
    }

    /// Writes the request to `w` as a client sends it: Go's `Request.Write`,
    /// or with `proxy` its `WriteProxy`, which names the whole URL.
    pub fn write_to(request: Request, w: Writer, proxy: Bool = False) -> Result<Unit, Error> {
        _ = wire_request(if proxy { 1 } else { 0 }, request, w)?
        Ok(Unit)
    }

    /// The request as text, as a server received it: httputil's
    /// `DumpRequest`. Without `body`, the body is left out. It reads the
    /// body.
    //! import std/http.{Request, Method}
    //! import std/url.Url
    //!
    //! dumped = Request.dump(Request{method: Method.Get, url: Url.parse("http://x/a")!})!
    //! assert String.starts_with(dumped, "GET /a HTTP/1.1")
    //
    pub fn dump(request: Request, body: Bool = True) -> Result<String, Error> {
        wire_request(if body { 2 } else { 3 }, request, io.stderr)
    }

    /// The request as text, as a client sends it: httputil's
    /// `DumpRequestOut`.
    pub fn dump_outgoing(request: Request, body: Bool = True) -> Result<String, Error> {
        wire_request(if body { 4 } else { 5 }, request, io.stderr)
    }

    /// Runs `body` over the parts of the request's multipart body as they
    /// arrive, each read in turn: Go's `Request.MultipartReader`, for a
    /// body too large to read whole (`multipart_form`). An `Err` when the
    /// request is not multipart.
    pub fn with_parts<T>(
        request: Request,
        body: (Iter<Result<Part, Error>>) -> T,
    ) -> Result<T, Error> {
        content_type = Headers.get(request.headers, "Content-Type") |> Maybe.with_default("")

        boundary =
            String.split(content_type, ";")
            |> Iter.map(String.trim)
            |> Iter.find(fn p -> String.starts_with(p, "boundary="))
            |> Maybe.map(fn p -> String.drop(p, 9) |> String.replace("\"", ""))

        case boundary {
            Some(b) when String.starts_with(content_type, "multipart/") ->
                Ok(body(multipart_parts(Body.reader(request.body), b)))

            _ ->
                Err(Error.Form{reason: "request Content-Type isn't multipart/form-data"})
        }
    }

    pub fn path_value(request: Request, name: String) -> Maybe<String> {
        Map.get(request.path_values, name)
    }

    /// The request with the wildcard `name` matched as `value`.
    pub fn with_path_value(request: Request, name: String, value: String) -> Request {
        #{..request, path_values: Map.put(request.path_values, name, value)}
    }
}

/// A response a client received, or one a handler answers.
pub struct Response {
    status: Status = Status.ok
    headers: Headers = Headers[]
    body: Body = Body.Empty
    trailers: Headers = Headers[]
    // Set by a client on a response it received.
    protocol: Protocol = Protocol{}
    /// The URL the last request went to, after any redirects.
    url: Maybe<Url> = None
    content_length: Maybe<Int> = None
    transfer_encoding: List<String> = []
    close: Bool = False
    /// The client asked for gzip and decompressed the body itself.
    uncompressed: Bool = False
    /// What the TLS handshake of the connection agreed on; `None` over
    /// plain HTTP.
    tls: Maybe<tls.ConnectionState> = None
    /// The longest writing this response may take, in place of the
    /// server's `write_timeout`. Go's `ResponseController.SetWriteDeadline`.
    write_timeout: Maybe<Duration> = None
    /// Lets the handler read the request body while it writes the
    /// response, as HTTP/1 servers otherwise refuse. Go's
    /// `ResponseController.EnableFullDuplex`.
    full_duplex: Bool = False
    /// Set by `Response.upgrade`: the server answers, then hands the
    /// connection to this function.
    upgrade: Maybe<(net.Connection) -> Unit> = None
}

impl Response {
    /// Reads one response from `r`, to a request like `request`, its body
    /// read whole: Go's `ReadResponse`.
    pub fn read(r: Reader, request: Request) -> Result<Response, Error> {
        message =
            http_host.wire_read_response(r, Method.text(request.method))
            |> Result.map_err(fn reason -> Error.Protocol{reason})?

        #(head, headers, trailers, encoding) = wire_parts_of(message)

        #(major, minor, length, close, status) = case head {
            [_, _, a, b, _, n, c, s] -> #(a, b, n, c, s)
            _ -> #("1", "1", "-1", "false", "200")
        }

        Ok(Response{
            status: Status(
                String.to_int(status)
                |> Maybe.with_default(200)
            ),
            headers: Headers(pairs(headers)),
            body: Body.Bytes(http_host.wire_body(message)),
            trailers: Headers(pairs(trailers)),
            protocol: Protocol{
                major: String.to_int(major) |> Maybe.with_default(1),
                minor: String.to_int(minor) |> Maybe.with_default(1),
            },
            content_length: wire_length(length),
            transfer_encoding: encoding,
            close: close == "true",
        })
    }

    /// Writes the response to `w` as a server sends it: Go's
    /// `Response.Write`.
    //! import std/http.{Body, Response}
    //! import std/io.Writer
    //!
    //! #(_, wire) = Writer.collect(fn w -> Response.write_to(Response{body: Body.Text("hi")}, w))
    //! assert String.starts_with(Bytes.to_string(wire)!, "HTTP/1.1 200 OK")
    //
    pub fn write_to(response: Response, w: Writer) -> Result<Unit, Error> {
        _ = wire_response(0, response, w)?
        Ok(Unit)
    }

    /// The response as text: httputil's `DumpResponse`. Without `body`, the
    /// body is left out.
    pub fn dump(response: Response, body: Bool = True) -> Result<String, Error> {
        wire_response(if body { 1 } else { 2 }, response, io.stderr)
    }

    /// A response that answers `status` and `headers`, then hands the
    /// connection to `on_connection`, which speaks another protocol over
    /// it, as a WebSocket server does after `101 Switching Protocols`. The
    /// connection is closed when `on_connection` returns. Go's `Hijack`.
    pub fn upgrade(
        status: Status = Status.switching_protocols,
        headers: Headers,
        on_connection: (net.Connection) -> Unit,
    ) -> Response {
        Response{status, headers, upgrade: Some(on_connection)}
    }

    /// The cookies the response's `Set-Cookie` headers set, as Go's
    /// `Response.Cookies`; one that does not parse is left out.
    pub fn cookies(response: Response) -> List<Cookie> {
        Headers.values(response.headers, "Set-Cookie")
        |> Iter.flat_map(fn line -> Cookie.parse_set_cookie(line) |> Result.to_maybe())
        |> Iter.to_list()
    }

    /// The response with a `Set-Cookie` header for `cookie`, as Go's
    /// `SetCookie`; a cookie Go cannot write is left out.
    //! import std/http.{Cookie, Response, SameSite}
    //!
    //! r = Response.set_cookie(
    //!     Response{},
    //!     Cookie{name: "id", value: "7", http_only: True, same_site: SameSite.Lax},
    //! )
    //!
    //! assert Headers.get(r.headers, "Set-Cookie") == Some("id=7; HttpOnly; SameSite=Lax")
    //
    pub fn set_cookie(response: Response, cookie: Cookie) -> Response {
        text = "${cookie}"
        if text == "" { return response }
        #{..response, headers: Headers.add(response.headers, "Set-Cookie", text)}
    }

    /// A page or a fragment of one: a 200 whose body is `page`, sent as
    /// `text/html; charset=utf-8` with its length.
    //! import std/html.Html
    //! import std/http.Response
    //! import std/io.Writer
    //!
    //! page = Html.text("a < b")
    //! #(_, wire) = Writer.collect(fn w -> Response.write_to(Response.html(page), w))
    //! sent = Bytes.to_string(wire)!
    //! assert String.contains(sent, "Content-Type: text/html; charset=utf-8")
    //! assert String.contains(sent, "Content-Length: 8")
    //! assert String.ends_with(sent, "a &lt; b")
    //
    pub fn html(page: Html) -> Response {
        Response{body: Body.Html(page)}
    }

    /// A plain-text response with `status` and `message`, as Go's `Error`
    /// writes it: `text/plain; charset=utf-8`, `X-Content-Type-Options:
    /// nosniff`, and the message and a newline.
    //! import std/http.{Response, Status}
    //!
    //! r = Response.error(Status.forbidden, "no")
    //! assert Response.text(r) == Ok("no\n")
    //! assert Headers.get(r.headers, "x-content-type-options") == Some("nosniff")
    //
    pub fn error(status: Status, message: String) -> Response {
        headers =
            Headers[]
            |> Headers.set("Content-Type", "text/plain; charset=utf-8")
            |> Headers.set("X-Content-Type-Options", "nosniff")

        Response{status, headers, body: Body.Text("${message}\n")}
    }

    /// Go's `NotFound`: a 404 with `404 page not found`.
    pub fn not_found() -> Response {
        Response.error(Status.not_found, "404 page not found")
    }

    /// Go's `Redirect`: a redirect to `to`, which may be relative to the
    /// request's path, with a short HTML body for a `GET` or `HEAD`.
    //! import std/http.{Method, Response, Status}
    //! import std/http_testing
    //!
    //! r = Response.redirect(http_testing.request(Method.Get, "/a/b"), "c", Status.found)
    //! assert Headers.get(r.headers, "Location") == Some("/a/c")
    //
    pub fn redirect(request: Request, to: String, status: Status) -> Response {
        from_go(
            http_host.answer_redirect(
                Method.text(request.method),
                "${request.url}",
                flat(request.headers),
                to,
                Status.code(status),
            )
        )
    }

    /// Go's `ServeContent`: `data` as the response to `request`, named
    /// `name` for its `Content-Type` when no header sets one, answering a
    /// `Range` with 206 and the `If-*` conditional headers against
    /// `modified` and an `ETag` header the response does not set here.
    //! import std/http.{Method, Response, Status}
    //! import std/http_testing
    //!
    //! request = http_testing.request(Method.Get, "/f")
    //! ranged = #{..request, headers: Headers.set(request.headers, "Range", "bytes=1-2")}
    //! r = Response.content(ranged, "f.txt", None, String.to_bytes("hello"))
    //! assert r.status == Status.partial_content
    //! assert Response.text(r) == Ok("el")
    //
    pub fn content(
        request: Request,
        name: String,
        modified: Maybe<Instant>,
        data: Bytes,
    ) -> Response {
        from_go(
            http_host.answer_content(
                Method.text(request.method),
                "${request.url}",
                flat(request.headers),
                name,
                modified
                |> Maybe.map(Instant.as_nanos)
                |> Maybe.with_default(-1),
                data,
            )
        )
    }

    /// The whole body as text.
    pub fn text(response: Response) -> Result<String, Error> {
        Body.read_all(response.body)?
        |> Bytes.to_string()
        |> Result.map_err(fn _ -> Error.Protocol{reason: "the body is not UTF-8 text"})
    }

    /// The whole body.
    pub fn bytes(response: Response) -> Result<Bytes, Error> {
        Body.read_all(response.body)
    }

    /// The whole body read as JSON.
    pub fn json(response: Response) -> Result<Json, Error> {
        text = Response.text(response)?

        Json.decode(text)
        |> Result.map_err(fn e -> Error.Protocol{reason: "the body is not JSON: ${e}"})
    }

    /// The `Location` header resolved against the response's URL.
    pub fn location(response: Response) -> Result<Maybe<Url>, Error> {
        case Headers.get(response.headers, "Location") {
            None ->
                Ok(None)

            Some(text) -> {
                parsed = case response.url {
                    Some(base) -> Url.resolve_text(base, text)
                    None -> Url.parse(text)
                }

                parsed
                |> Result.map(Some)
                |> Result.map_err(fn e -> Error.InvalidUrl{url: e.url, reason: e.reason})
            }
        }
    }
}

/// Why a request got no response.
pub enum Error {
    InvalidUrl {url: String, reason: String}
    InvalidRequest {reason: String}
    Dns {host: String, reason: String}
    Connect {address: String, reason: String}
    Tls {reason: String}
    /// The client's timeout, a deadline in force, or a transport timeout.
    Timeout {during: String}
    Canceled
    TooManyRedirects {count: Int}
    /// A form that does not parse, or a request that holds none of the
    /// kind asked for.
    Form {reason: String}
    /// `Request.form_file` found no file in the field.
    MissingFile {field: String}
    /// `CrossOrigin.check` refused a cross-origin request, or a trusted
    /// origin does not parse.
    CrossOrigin {reason: String}
    /// A `Redirects.Decide` function refused the redirect to `url`.
    RedirectRefused {url: String, reason: String}
    Protocol {reason: String}
    BodyTooLarge {limit: Int}
    BodyNotAllowed
    ContentLength
    HandlerTimeout
    Body {error: io.Error}
    /// A server could not listen on `address`.
    Listen {address: String, reason: String}
    /// A router pattern Go's `ServeMux` refuses, or one that conflicts
    /// with an earlier pattern.
    Pattern {pattern: String, reason: String}
    /// The target has no network.
    Unsupported {reason: String}
}

derive Equatable for Error

impl Error {
    /// Whether the error is a timeout, as Go's `Timeout()` answers.
    pub fn is_timeout(error: Error) -> Bool {
        case error {
            .Timeout{during: _} -> True
            _ -> False
        }
    }

    fn from_parts(parts: List<String>) -> Error {
        case parts {
            ["InvalidUrl", url, reason] ->
                Error.InvalidUrl{url, reason}

            ["InvalidRequest", reason] ->
                Error.InvalidRequest{reason}

            ["Dns", host, reason] ->
                Error.Dns{host, reason}

            ["Connect", address, reason] ->
                Error.Connect{address, reason}

            ["Tls", reason] ->
                Error.Tls{reason}

            ["Timeout", during] ->
                Error.Timeout{during}

            ["Canceled"] ->
                Error.Canceled

            ["TooManyRedirects", count] ->
                Error.TooManyRedirects{count: String.to_int(count) |> Maybe.with_default(0)}

            ["BodyTooLarge", limit] ->
                Error.BodyTooLarge{limit: String.to_int(limit) |> Maybe.with_default(0)}

            ["Protocol", reason] ->
                Error.Protocol{reason}

            ["Listen", address, reason] ->
                Error.Listen{address, reason}

            ["Pattern", pattern, reason] ->
                Error.Pattern{pattern, reason}

            _ ->
                Error.Protocol{reason: String.join(parts, ": ")}
        }
    }
}

impl Display for Error {
    fn to_string(error: Error) -> String {
        case error {
            .InvalidUrl{url, reason} -> "invalid URL ${url}: ${reason}"
            .InvalidRequest{reason} -> "invalid request: ${reason}"
            .Dns{host, reason} -> "looking up ${host}: ${reason}"
            .Connect{address, reason} -> "connecting to ${address}: ${reason}"
            .Tls{reason} -> "TLS: ${reason}"
            .Timeout{during} -> "timed out during the ${during}"
            .Canceled -> "the request was canceled"
            .TooManyRedirects{count} -> "stopped after ${count} redirects"
            .Form{reason} -> "reading the form: ${reason}"
            .MissingFile{field} -> "no file in the form's field ${field}"
            .CrossOrigin{reason} -> reason
            .RedirectRefused{url, reason} -> "the redirect to ${url} was refused: ${reason}"
            .Protocol{reason} -> reason
            .BodyTooLarge{limit} -> "the body is larger than ${limit} bytes"
            .BodyNotAllowed -> "this request or response cannot have a body"
            .ContentLength -> "the body's length is not its Content-Length"
            .HandlerTimeout -> "the handler timed out"
            .Body{error} -> "reading the body: ${error}"
            .Listen{address, reason} -> "listening on ${address}: ${reason}"
            .Pattern{pattern, reason} -> "pattern ${pattern}: ${reason}"
            .Unsupported{reason} -> reason
        }
    }
}

/// Which redirects a client follows.
pub enum Redirects {
    /// Follow up to `max` redirects, as Go does (10).
    Follow {max: Int = 10}
    /// Answer the redirect response itself.
    Never
    /// Ask a function before each redirect, as Go's `CheckRedirect` does.
    /// It gets the request the redirect would send and the requests
    /// already sent, oldest first, and answers whether to send it. There
    /// is no limit but the function's.
    Decide (Request, List<Request>) -> Redirect
}

/// What a `Redirects.Decide` function answers for one redirect.
pub enum Redirect {
    /// Send the request.
    Follow
    /// Answer the redirect response itself, as Go's `ErrUseLastResponse`.
    Stop
    /// Fail the request with `Error.RedirectRefused` and `reason`.
    Refuse String
}

/// Where a client's requests go through.
pub enum Proxy {
    /// `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY`, as Go reads them.
    FromEnvironment
    /// No proxy.
    Direct
    /// Every request through `url`.
    Fixed Url
}

/// How a client's connections are made and kept: Go's `Transport` options.
pub struct Transport {
    proxy: Proxy = Proxy.FromEnvironment
    tls_handshake_timeout: Duration = Duration.seconds(10)
    keep_alives: Bool = True
    compression: Bool = True
    max_idle: Int = 100
    max_idle_per_host: Int = 2
    max_per_host: Maybe<Int> = None
    idle_timeout: Maybe<Duration> = Some(Duration.seconds(90))
    response_header_timeout: Maybe<Duration> = None
    expect_continue_timeout: Duration = Duration.seconds(1)
    max_response_header_bytes: Maybe<Int> = None
    write_buffer_size: Maybe<Int> = None
    read_buffer_size: Maybe<Int> = None
    force_http2: Bool = True
    /// The protocols the transport speaks; `None` is Go's choice, HTTP/1,
    /// and HTTP/2 when `force_http2` is set.
    protocols: Maybe<Protocols> = None
    http2: Http2Options = Http2Options{}
    /// Headers sent with each `CONNECT` to a proxy.
    proxy_connect_headers: Headers = Headers[]
    /// Sees each proxy's answer to `CONNECT`; an `Err` fails the request.
    /// Go's `OnProxyConnectResponse`. It runs on the task sending.
    on_proxy_connect: Maybe<(Url, Response) -> Result<Unit, Error>> = None
}

/// The HTTP protocols a server accepts or a transport speaks: Go's
/// `Protocols`.
pub struct Protocols {
    http1: Bool = True
    /// HTTP/2 over TLS.
    http2: Bool = True
    /// HTTP/2 over plain TCP (h2c).
    unencrypted_http2: Bool = False
}

derive Equatable for Protocols

impl Display for Protocols {
    //! import std/http.Protocols
    //!
    //! assert "${Protocols{}}" == "{HTTP1,HTTP2}"
    //
    fn to_string(protocols: Protocols) -> String {
        names = [
            if protocols.http1 { Some("HTTP1") } else { None },
            if protocols.http2 { Some("HTTP2") } else { None },
            if protocols.unencrypted_http2 {
                Some("UnencryptedHTTP2")
            } else {
                None
            },
        ]

        "{${names |> Iter.flat_map(fn n -> n) |> String.join(",")}}"
    }
}

fn protocol_flags(protocols: Maybe<Protocols>) -> List<Bool> {
    p = Maybe.with_default(protocols, Protocols{})
    [p.http1, p.http2, p.unencrypted_http2]
}

/// HTTP/2's limits and timeouts: Go's `HTTP2Config`. `None` and `False`
/// are Go's defaults.
pub struct Http2Options {
    /// The streams a client may have open at once; servers only.
    max_concurrent_streams: Maybe<Int> = None
    /// Keep to the server's stream limit across connections rather than
    /// opening another; transports only.
    strict_max_concurrent_requests: Bool = False
    max_decoder_header_table_size: Maybe<Int> = None
    max_encoder_header_table_size: Maybe<Int> = None
    max_read_frame_size: Maybe<Int> = None
    max_receive_buffer_per_connection: Maybe<Int> = None
    max_receive_buffer_per_stream: Maybe<Int> = None
    /// Pings a connection that has been quiet this long.
    send_ping_timeout: Maybe<Duration> = None
    /// Closes a connection whose ping is not answered in this long.
    ping_timeout: Maybe<Duration> = None
    /// Closes a connection that accepts no bytes for this long.
    write_byte_timeout: Maybe<Duration> = None
    permit_prohibited_cipher_suites: Bool = False
    /// Told the kind of each HTTP/2 error, as a metrics counter would be.
    /// Go's `CountError`.
    on_error_count: Maybe<(String) -> Unit> = None
}

fn http2_numbers(options: Http2Options) -> List<Int> {
    [
        Maybe.with_default(options.max_concurrent_streams, 0),
        Maybe.with_default(options.max_decoder_header_table_size, 0),
        Maybe.with_default(options.max_encoder_header_table_size, 0),
        Maybe.with_default(options.max_read_frame_size, 0),
        Maybe.with_default(options.max_receive_buffer_per_connection, 0),
        Maybe.with_default(options.max_receive_buffer_per_stream, 0),
        nanos(options.send_ping_timeout),
        nanos(options.ping_timeout),
        nanos(options.write_byte_timeout),
    ]
}

fn http2_flags(options: Http2Options) -> List<Bool> {
    [options.strict_max_concurrent_requests, options.permit_prohibited_cipher_suites]
}

fn ignore_text(_text: String) -> Unit {
    Unit
}

impl Transport {
    /// The options Go's `DefaultTransport` has.
    pub once default = Transport{}
}

/// A client's options.
pub struct ClientOptions {
    /// The longest a request may take, its body included.
    timeout: Maybe<Duration> = None
    redirects: Redirects = Redirects.Follow{}
    transport: Transport = Transport.default
    /// Replaces the transport: every request goes to this function.
    round_trip: Maybe<(Request) -> Result<Response, Error>> = None
    /// `fetch` refuses a body past this many bytes (`Error.BodyTooLarge`);
    /// `with_response` streams any size.
    max_body: Maybe<Int> = Some(67_108_864)
    /// Where the client keeps cookies: it sends a jar's cookies with each
    /// request and stores those each response sets. `None` keeps none.
    cookies: Maybe<CookieJar> = None
    /// How the client checks servers and what it offers over TLS; `None`
    /// is Go's defaults. `Client.new` traps when its roots hold no
    /// certificate.
    tls: Maybe<tls.ClientConfig> = None
}

/// A client: its options and its connection pool. Make one with
/// `Client.new` and keep it; the pool is Go's, which only std/http can name.
pub struct Client {
    handle: http_host.Client
    options: ClientOptions
}

impl Client {
    /// A client with `options`.
    pub fn new(options: ClientOptions = ClientOptions{}) -> Client {
        t = options.transport

        #(proxy, proxy_url) = case t.proxy {
            .FromEnvironment -> #(0, "")
            .Direct -> #(1, "")
            .Fixed(u) -> #(2, "${u}")
        }

        handle = http_host.new_client(
            nanos(options.timeout),
            case options.redirects {
                .Follow{max} -> max
                .Never -> -1
                .Decide(_) -> -1
            },
            proxy,
            proxy_url,
            Duration.as_nanos(t.tls_handshake_timeout),
            t.keep_alives,
            t.compression,
            t.max_idle,
            t.max_idle_per_host,
            Maybe.with_default(t.max_per_host, 0),
            nanos(t.idle_timeout),
            nanos(t.response_header_timeout),
            Duration.as_nanos(t.expect_continue_timeout),
            Maybe.with_default(t.max_response_header_bytes, 0),
            Maybe.with_default(t.write_buffer_size, 0),
            Maybe.with_default(t.read_buffer_size, 0),
            t.force_http2,
            protocol_flags(t.protocols),
            Maybe.is_some(t.protocols),
            http2_numbers(t.http2),
            http2_flags(t.http2),
            flat(t.proxy_connect_headers),
            case t.on_proxy_connect {
                Some(check) ->
                    fn proxy_url, code, headers -> {
                        answer = Response{status: Status(code), headers: Headers(pairs(headers))}

                        case Url.parse(proxy_url)
                        |> Result.map_err(fn e -> Error.InvalidUrl{url: proxy_url, reason: "${e}"})
                        |> Result.flat_map(fn u -> check(u, answer)) {
                            Ok(_) -> ""
                            Err(error) -> "${error}"
                        }
                    }

                None ->
                    fn _, _, _ -> ""
            },
            Maybe.is_some(t.on_proxy_connect),
            Maybe.with_default(t.http2.on_error_count, ignore_text),
            Maybe.is_some(t.http2.on_error_count),
        )

        handle = case options.cookies {
            Some(jar) -> http_host.with_jar(handle, jar.handle)
            None -> handle
        }

        handle = case options.tls {
            Some(config) -> http_host.with_tls(handle, tls.ClientConfig.host(config)!)
            None -> handle
        }

        Client{handle, options}
    }

    /// Sends `request` and reads the whole body into `Body.Bytes`.
    pub fn fetch(client: Client, request: Request) -> Result<Response, Error> {
        faked: Maybe<Result<Response, Error>> = http_host.answered(request)
        if Some(answer) = faked { return answer }
        Client{handle, options} = client
        if Some(round_trip) = options.round_trip { return round_trip(request) }
        exchange = send_following(handle, request, False, options.max_body, options.redirects, [])?
        Ok(response_of(exchange, Body.Bytes(http_host.body_bytes(exchange))))
    }

    /// Sends `request` and gives `body` the response, with a `Body.Stream`
    /// body that is closed when `body` returns, traps or is cancelled.
    pub fn with_response<T>(
        client: Client,
        request: Request,
        body: (Response) -> T,
    ) -> Result<T, Error> {
        faked: Maybe<Result<Response, Error>> = http_host.answered(request)
        if Some(answer) = faked { return answer |> Result.map(body) }
        Client{handle, options} = client
        if Some(round_trip) = options.round_trip { return round_trip(request) |> Result.map(body) }
        exchange = send_following(handle, request, True, None, options.redirects, [])?
        defer http_host.close_body(exchange)
        Ok(body(response_of(exchange, Body.Stream(http_host.body_reader(exchange)))))
    }

    /// A `GET` of `url`.
    pub fn get(client: Client, url: Url) -> Result<Response, Error> {
        Client.fetch(client, Request{url})
    }

    /// A `HEAD` of `url`.
    pub fn head(client: Client, url: Url) -> Result<Response, Error> {
        Client.fetch(client, Request{method: Method.Head, url})
    }

    /// A `POST` of `body` to `url`.
    pub fn post(client: Client, url: Url, body: Body) -> Result<Response, Error> {
        Client.fetch(client, Request{method: Method.Post, url, body})
    }

    /// A `POST` of `form`, URL-encoded, to `url`.
    pub fn post_form(client: Client, url: Url, form: Query) -> Result<Response, Error> {
        Client.post(client, url, Body.Form(form))
    }

    /// Closes the client's idle connections.
    pub fn close_idle(client: Client) -> Unit {
        http_host.close_idle(client.handle)
    }
}

/// The client `http.fetch` and the other module functions use: the default
/// options over one connection pool the whole program shares, as Go's
/// `DefaultClient`. `http_testing.run` answers in its place.
pub fn default_client() -> Client {
    Client{handle: http_host.default_client(), options: ClientOptions{}}
}

/// Sends `request` with the default client and reads the whole response.
pub fn fetch(request: Request) -> Result<Response, Error> {
    Client.fetch(default_client(), request)
}

/// Sends `request` with the default client and gives `body` the streaming
/// response.
pub fn with_response<T>(request: Request, body: (Response) -> T) -> Result<T, Error> {
    Client.with_response(default_client(), request, body)
}

/// A `GET` of `url` with the default client.
pub fn get(url: Url) -> Result<Response, Error> {
    Client.get(default_client(), url)
}

/// A `HEAD` of `url` with the default client.
pub fn head(url: Url) -> Result<Response, Error> {
    Client.head(default_client(), url)
}

/// A `POST` of `body` to `url` with the default client.
pub fn post(url: Url, body: Body) -> Result<Response, Error> {
    Client.post(default_client(), url, body)
}

/// A `POST` of `form` to `url` with the default client.
pub fn post_form(url: Url, form: Query) -> Result<Response, Error> {
    Client.post_form(default_client(), url, form)
}

fn nanos(d: Maybe<Duration>) -> Int {
    d |> Maybe.map(Duration.as_nanos) |> Maybe.with_default(0)
}

fn flat(headers: Headers) -> List<String> {
    Headers(fields) = headers
    fields |> Iter.flat_map(fn #(k, v) -> [k, v]) |> Iter.to_list()
}

fn send(
    handle: http_host.Client,
    request: Request,
    stream: Bool,
    max_body: Maybe<Int>,
) -> Result<http_host.Exchange, Error> {
    headers = typed(request.headers, request.body)

    #(kind, data, input) = case request.body {
        .Empty ->
            #(0, String.to_bytes(""), Reader.from_bytes(String.to_bytes("")))

        .Stream(r) ->
            #(2, String.to_bytes(""), r)

        .Produce(_) ->
            return Err(Error.InvalidRequest{reason: "a request body cannot be Body.Produce"})

        other ->
            #(1, Body.bytes_of(other), Reader.from_bytes(String.to_bytes("")))
    }

    http_host.send(
        handle,
        Method.text(request.method),
        "${request.url}",
        flat(headers),
        kind,
        data,
        input,
        Maybe.with_default(request.content_length, -1),
        Maybe.with_default(request.host, ""),
        request.close,
        flat(request.trailers),
        stream,
        Maybe.with_default(max_body, -1),
        case request.trace {
            Some(t) -> t.handle
            None -> http_host.new_tracer()
        },
        Maybe.is_some(request.trace),
    )
    |> Result.map_err(Error.from_parts)
}

// headers with the Content-Type body implies, unless they set one.
fn typed(headers: Headers, body: Body) -> Headers {
    content_type = case body {
        .Text(_) -> Some("text/plain; charset=utf-8")
        .Json(_) -> Some("application/json")
        .Html(_) -> Some("text/html; charset=utf-8")
        .Form(_) -> Some("application/x-www-form-urlencoded")
        .Multipart(parts) -> Some(FormPart.encode(parts).content_type)
        _ -> None
    }

    case content_type {
        Some(t) ->
            if Headers.has(headers, "Content-Type") {
                headers
            } else {
                Headers.add(headers, "Content-Type", t)
            }

        None ->
            headers
    }
}

fn pairs(flat: List<String>) -> List<#(String, String)> {
    case flat {
        [k, v, ..rest] -> [#(k, v), ..pairs(rest)]
        _ -> []
    }
}

/// Sends `request`, and with `Redirects.Decide` follows its redirects here,
/// asking the function before each. Go follows the others itself.
fn send_following(
    handle: http_host.Client,
    request: Request,
    stream: Bool,
    max_body: Maybe<Int>,
    redirects: Redirects,
    via: List<Request>,
) -> Result<http_host.Exchange, Error> {
    exchange = send(handle, request, stream, max_body)?

    decide = case redirects {
        .Decide(f) -> f
        _ -> return Ok(exchange)
    }

    following = case redirected(request, response_of(exchange, Body.Empty))? {
        Some(next) -> next
        None -> return Ok(exchange)
    }

    sent = [..via, request]

    case decide(following, sent) {
        .Follow -> {
            http_host.close_body(exchange)
            send_following(handle, following, stream, max_body, redirects, sent)
        }

        .Stop ->
            Ok(exchange)

        .Refuse(reason) -> {
            http_host.close_body(exchange)
            Err(Error.RedirectRefused{url: "${following.url}", reason})
        }
    }
}

/// The request a redirect response sends next, by Go's rules: a 301 or
/// 302 turns a `POST` into a `GET`, a 303 turns anything but `GET` and
/// `HEAD` into a `GET`, and either drops the body; a 307 or 308 sends the
/// same method and body again, unless the body is a stream, which cannot
/// be sent twice. Headers that carry credentials are dropped when the host
/// changes. `None` for any other response, as for one with no `Location`.
fn redirected(request: Request, response: Response) -> Result<Maybe<Request>, Error> {
    target = case Response.location(response)? {
        Some(url) -> url
        None -> return Ok(None)
    }

    code = Status.code(response.status)
    method = request.method

    #(next_method, keeps_body) = if code == 301 or code == 302 {
        #(
            if method == Method.Post {
                Method.Get
            } else {
                method
            },
            False,
        )
    } else if code == 303 {
        #(
            if method == Method.Get or method == Method.Head {
                method
            } else {
                Method.Get
            },
            False,
        )
    } else if code == 307 or code == 308 {
        #(method, True)
    } else {
        return Ok(None)
    }

    if keeps_body { if Body.Stream(_) = request.body { return Ok(None) } }

    headers = if keeps_body {
        request.headers
    } else {
        Headers.remove(request.headers, "Content-Type")
    }

    headers = if Url.hostname(target) == Url.hostname(request.url) {
        headers
    } else {
        ["Authorization", "Www-Authenticate", "Cookie", "Cookie2"]
        |> Iter.reduce(headers, Headers.remove)
    }

    Ok(Some(#{
            ..request,
            method: next_method,
            url: target,
            headers,
            body: if keeps_body { request.body } else { Body.Empty },
            content_length: if keeps_body {
                request.content_length
            } else {
                None
            },
            host: None,
        }))
}

fn response_of(exchange: http_host.Exchange, body: Body) -> Response {
    #(major, minor) = case http_host.protocol(exchange) {
        [a, b] -> #(a, b)
        _ -> #(1, 1)
    }

    length = http_host.content_length(exchange)

    Response{
        status: Status(http_host.status(exchange)),
        headers: Headers(pairs(http_host.headers(exchange))),
        body,
        trailers: Headers(pairs(http_host.trailers(exchange))),
        protocol: Protocol{major, minor},
        url: Url.parse(http_host.final_url(exchange)) |> Result.to_maybe(),
        content_length: if length < 0 { None } else { Some(length) },
        transfer_encoding: http_host.transfer_encoding(exchange),
        close: http_host.closes(exchange),
        uncompressed: http_host.uncompressed(exchange),
        tls: http_host.exchange_tls(exchange) |> Maybe.map(tls.ConnectionState.of_parts),
    }
}

/// How a server listens and answers. A timeout of `None` is none.
pub struct Server {
    /// The address to listen on, `host:port`, as Go's `Server.Addr`:
    /// `:http` is port 80 on every interface. Port 0 picks a free one,
    /// which `Listener.address` reports.
    address: String = ":http"
    /// The longest a client may take to send a whole request.
    read_timeout: Maybe<Duration> = None
    /// The longest a client may take to send a request's headers.
    read_header_timeout: Maybe<Duration> = None
    /// The longest writing a response may take.
    write_timeout: Maybe<Duration> = None
    /// The longest a kept-alive connection waits for its next request.
    idle_timeout: Maybe<Duration> = None
    /// The largest request header, in bytes: Go's `DefaultMaxHeaderBytes`.
    max_header_bytes: Int = 1_048_576
    /// Whether connections are kept open between requests.
    keep_alives: Bool = True
    /// A deadline for each request's handler, on its context.
    request_timeout: Maybe<Duration> = None
    /// How long `serve` waits for requests in flight when it stops.
    shutdown_timeout: Duration = Duration.seconds(5)
    /// Serves HTTPS with this configuration, as Go's `ListenAndServeTLS`
    /// does, HTTP/2 included; `None` serves plain HTTP.
    tls: Maybe<tls.ServerConfig> = None
    /// The most values one request header may hold: Go's
    /// `DefaultMaxHeaderValueCount`, 500, when `None`.
    max_header_value_count: Maybe<Int> = None
    /// Answers `OPTIONS *` itself, as Go does; `False` hands it to the
    /// handler.
    answer_options_star: Bool = True
    /// Honours the priorities HTTP/2 and HTTP/3 clients ask for.
    client_priority: Bool = True
    /// The protocols the server accepts; `None` is Go's choice, HTTP/1
    /// and, over TLS, HTTP/2.
    protocols: Maybe<Protocols> = None
    http2: Http2Options = Http2Options{}
    /// Told each connection's address as its state changes. Go's
    /// `ConnState`. It runs on the task serving, in order.
    on_connection_state: Maybe<(String, ConnState) -> Unit> = None
    /// Told each error Go logs about the server's connections, a line at a
    /// time; `None` writes them to standard error. Go's `ErrorLog`.
    on_error: Maybe<(String) -> Unit> = None
    /// Runs when the server starts shutting down, as for connections that
    /// were upgraded, which the shutdown does not track. Go's
    /// `RegisterOnShutdown`.
    on_shutdown: Maybe<() -> Unit> = None
}

fn conn_state(code: Int) -> ConnState {
    case code {
        0 -> ConnState.New
        1 -> ConnState.Active
        2 -> ConnState.Idle
        3 -> ConnState.Hijacked
        _ -> ConnState.Closed
    }
}

/// A server listening for requests: `listen` binds it, and `serve` answers
/// what arrives.
pub struct Listener {
    handle: http_host.Listener
    server: Server
}

impl Listener {
    /// The address the server is bound to, with the port it picked when
    /// its address asked for port 0.
    pub fn address(listener: Listener) -> String {
        http_host.address(listener.handle)
    }

    /// Stops the server as Go's `Server.Shutdown` does: it stops accepting,
    /// waits up to the server's `shutdown_timeout` for the requests it is
    /// answering, then closes every connection. A second call does nothing.
    pub fn shutdown(listener: Listener) -> Unit {
        http_host.shutdown(listener.handle, Duration.as_nanos(listener.server.shutdown_timeout))
    }

    /// Closes every connection the server holds, idle or busy; the server
    /// goes on accepting.
    pub fn close_connections(listener: Listener) -> Unit {
        http_host.close_connections(listener.handle)
    }
}

/// Binds the server's address. The server accepts connections from here
/// on; `serve` answers the requests they send.
pub fn listen(server: Server = Server{}) -> Result<Listener, Error> {
    durations = [
        nanos(server.read_timeout),
        nanos(server.read_header_timeout),
        nanos(server.write_timeout),
        nanos(server.idle_timeout),
        Duration.as_nanos(server.shutdown_timeout),
    ]

    limits = [server.max_header_bytes, Maybe.with_default(server.max_header_value_count, 0)]
    flags = [server.keep_alives, server.answer_options_star, server.client_priority]

    on_state = case server.on_connection_state {
        Some(told) -> fn address: String, code: Int -> told(address, conn_state(code))
        None -> fn _: String, _: Int -> Unit
    }

    on_error = Maybe.with_default(server.on_error, ignore_text)
    on_shutdown = Maybe.with_default(server.on_shutdown, fn -> Unit)
    on_count = Maybe.with_default(server.http2.on_error_count, ignore_text)

    handle =
        case server.tls {
            None ->
                http_host.listen(
                    server.address,
                    durations,
                    limits,
                    flags,
                    protocol_flags(server.protocols),
                    Maybe.is_some(server.protocols),
                    http2_numbers(server.http2),
                    http2_flags(server.http2),
                    on_state,
                    Maybe.is_some(server.on_connection_state),
                    on_error,
                    Maybe.is_some(server.on_error),
                    on_shutdown,
                    Maybe.is_some(server.on_shutdown),
                    on_count,
                    Maybe.is_some(server.http2.on_error_count),
                )

            Some(config) -> {
                host =
                    tls.ServerConfig.host(config)
                    |> Result.map_err(fn e -> Error.Tls{reason: "${e}"})?

                http_host.listen_tls(
                    server.address,
                    durations,
                    limits,
                    flags,
                    protocol_flags(server.protocols),
                    Maybe.is_some(server.protocols),
                    http2_numbers(server.http2),
                    http2_flags(server.http2),
                    on_state,
                    Maybe.is_some(server.on_connection_state),
                    on_error,
                    Maybe.is_some(server.on_error),
                    on_shutdown,
                    Maybe.is_some(server.on_shutdown),
                    on_count,
                    Maybe.is_some(server.http2.on_error_count),
                    host,
                )
            }
        }
        |> Result.map_err(Error.from_parts)?

    Ok(Listener{handle, server})
}

/// Answers each request `listener` receives with `handler`, each as a task
/// of `supervisor`, so its `max_running` bounds the requests answered at
/// once. Returns when the calling task is stopped, as at shutdown, after
/// shutting the listener down.
///
/// A handler runs under the request's context: the context in force here,
/// with the server's `request_timeout` as a deadline. The app's `Context`
/// field reads it while the handler runs, and `request.context` holds it.
/// The handler's task is stopped when the client goes away. A handler that
/// traps answers a 500. Use a supervisor that does not restart its tasks
/// (`Restart.Temporary`, the default); a restarted handler answers nothing.
///
/// When the program shuts down, at a signal or when `main` returns, the
/// server stops accepting at once, as Go's `Server.Shutdown` does. The
/// requests it took run to their end, for up to the server's
/// `shutdown_timeout` and the supervisor's, and then `serve` returns.
pub fn serve(listener: Listener, handler: (Request) -> Response, supervisor: Supervisor) -> Unit {
    defer Listener.shutdown(listener)
    accept(listener, handler, supervisor)
}

fn accept(listener: Listener, handler: (Request) -> Response, supervisor: Supervisor) -> Unit {
    case http_host.next(listener.handle) {
        Some(incoming) -> {
            _ = Supervisor.spawn(supervisor, fn -> answer(listener, incoming, handler))
            accept(listener, handler, supervisor)
        }

        None ->
            Unit
    }
}

fn answer(
    listener: Listener,
    incoming: http_host.Incoming,
    handler: (Request) -> Response,
) -> Unit {
    if http_host.answered_already(incoming) { return Unit }
    defer http_host.finish(incoming, [])

    timeout =
        listener.server.request_timeout |> Maybe.map(Duration.as_nanos) |> Maybe.with_default(-1)

    http_host.run_request(incoming, timeout, fn context -> {
        respond(incoming, handler(request_of(incoming, context)))
    })
}

fn request_of(incoming: http_host.Incoming, context: Context) -> Request {
    #(major, minor) = case http_host.in_protocol(incoming) {
        [a, b] -> #(a, b)
        _ -> #(1, 1)
    }

    length = http_host.in_content_length(incoming)

    Request{
        method: Method.parse(http_host.in_method(incoming)),
        url: Url.parse(http_host.in_url(incoming))!,
        headers: Headers(pairs(http_host.in_headers(incoming))),
        body: Body.Stream(http_host.in_body(incoming)),
        host: Some(http_host.in_host(incoming)),
        content_length: if length < 0 { None } else { Some(length) },
        transfer_encoding: http_host.in_transfer_encoding(incoming),
        close: http_host.in_close(incoming),
        protocol: Protocol{major, minor},
        remote_address: http_host.in_remote(incoming),
        request_uri: http_host.in_target(incoming),
        context,
        local_address: http_host.in_local(incoming),
        tls: http_host.in_tls(incoming) |> Maybe.map(tls.ConnectionState.of_parts),
        incoming: Some(incoming),
    }
}

fn respond(incoming: http_host.Incoming, response: Response) -> Unit {
    status = Status.code(response.status)
    headers = flat(typed(response.headers, response.body))
    empty = String.to_bytes("")
    write_timeout = nanos(response.write_timeout)

    if Some(on_connection) = response.upgrade {
        if Ok(conn) = http_host.upgrade(incoming, status, flat(response.headers)) {
            connection = net.Connection.of_handle(conn)
            defer net.Connection.close(connection)
            on_connection(connection)
        }

        return http_host.finish(incoming, [])
    }

    case response.body {
        .Produce(produce) -> {
            Headers(trailers) = response.trailers
            names = trailers |> Iter.map(fn #(k, _) -> k) |> Iter.to_list()

            writer = http_host.produce(
                incoming,
                status,
                headers,
                names,
                write_timeout,
                response.full_duplex,
            )

            _ = produce(writer)
            _ = io.Writer.close(writer)
            http_host.finish(incoming, flat(response.trailers))
        }

        .Empty -> {
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                0,
                empty,
                Reader.from_bytes(empty),
                length_of(response),
                write_timeout,
                response.full_duplex,
            )
        }

        .Stream(r) -> {
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                2,
                empty,
                r,
                length_of(response),
                write_timeout,
                response.full_duplex,
            )
        }

        other -> {
            _ = http_host.respond(
                incoming,
                status,
                headers,
                flat(response.trailers),
                1,
                Body.bytes_of(other),
                Reader.from_bytes(empty),
                length_of(response),
                write_timeout,
                response.full_duplex,
            )
        }
    }
}

fn length_of(response: Response) -> Int {
    Maybe.with_default(response.content_length, -1)
}

/// A pattern a `Router` routes by, as Go's `ServeMux` reads it:
/// `[METHOD ][HOST]/PATH`, where a path segment `{name}` matches one
/// segment, a last `{name...}` the rest of the path, and `{$}` only the
/// end. ``Route`GET /users/{id}` `` is checked when the program is
/// checked, so a pattern Go refuses is a compile error at the literal. A
/// pattern built at run time goes through `Route.parse`.
//! assert "${Route`GET /users/{id}`}" == "GET /users/{id}"
//! assert Route.parse("GET /a/{x}/{x}") |> Result.is_err()
//! assert Route.parse("/files/{rest...}/more") |> Result.is_err()
//
pub opaque type Route String

derive Equatable for Route
derive Hashable for Route

impl Route {
    /// The route `text` names, or `Error.Pattern` with Go's reason when
    /// its `ServeMux` refuses it.
    //! assert Route.parse("POST /orders") == Ok(Route`POST /orders`)
    //! assert Err(Error.Pattern{reason}) = Route.parse("GET users")
    //! assert String.contains(reason, "/")
    //
    pub fn parse(text: String) -> Result<Route, Error> {
        reason = http_host.check_pattern(text)

        if reason == "" {
            Ok(Route(text))
        } else {
            Err(Error.Pattern{pattern: text, reason})
        }
    }
}

impl Literal for Route {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<Route, Error> {
        text = Iter.reduce(fragments, "", fn acc, frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        Route.parse(text)
    }
}

impl Display for Route {
    fn to_string(route: Route) -> String {
        Route(text) = route
        text
    }
}

/// Routes requests to handlers by pattern, with the rules of Go's
/// `ServeMux`: `[METHOD ][HOST]/PATH`, where a path segment `{name}`
/// matches one segment, a last `{name...}` the rest of the path, and
/// `{$}` only the end. The most specific pattern wins; `GET` also matches
/// `HEAD`. A request whose path is not clean, or that lacks a trailing
/// slash a pattern has, is redirected; one whose path matches only under
/// another method answers 405 with `Allow`; anything else answers 404.
//! import std/http.{Body, Method, Request, Response, Route, Router, Status}
//! import std/http_testing
//!
//! router = Router.new([
//!     #(
//!         Route`GET /users/{id}`,
//!         fn r -> Response{body: Body.Text("user ${Request.path_value(r, "id")!}")},
//!     ),
//!     #(Route`/files/{path...}`, fn r -> Response{body: Body.Text(Request.path_value(r, "path")!)}),
//! ])!
//!
//! user = Router.serve(router, http_testing.request(Method.Get, "/users/7"))
//! assert Response.text(user) == Ok("user 7")
//!
//! assert Response.text(Router.serve(router, http_testing.request(Method.Get, "/files/a/b.txt")))
//!     == Ok("a/b.txt")
//!
//! assert Router.serve(router, http_testing.request(Method.Post, "/users/7")).status
//!     == Status.method_not_allowed
//!
//! assert Router.serve(router, http_testing.request(Method.Get, "/nope")).status == Status.not_found
//
pub struct Router {
    mux: http_host.Mux
    handlers: List<(Request) -> Response>
}

impl Router {
    /// A router over `routes`, each a pattern and its handler, in order.
    /// A pattern that conflicts with an earlier one, matching the same
    /// requests with neither more specific, is `Error.Pattern`, where Go's
    /// `Handle` panics. Each pattern on its own was checked when it became
    /// a `Route`.
    //! import std/http.{Error, Response, Route, Router}
    //!
    //! conflict = Router.new([#(Route`/a/{x}`, fn _ -> Response{}), #(Route`/a/{y}`, fn _ -> Response{})])
    //! assert Result.is_err(conflict)
    //
    pub fn new(routes: List<#(Route, (Request) -> Response)>) -> Result<Router, Error> {
        patterns = routes |> Iter.map(fn #(p, _) -> "${p}") |> Iter.to_list()
        mux = http_host.new_mux(patterns) |> Result.map_err(Error.from_parts)?
        Ok(Router{mux, handlers: routes |> Iter.map(fn #(_, h) -> h) |> Iter.to_list()})
    }

    /// The handler for `request` and the pattern that matched it, or
    /// `None` when no pattern matches, as Go's `ServeMux.Handler`.
    pub fn find(router: Router, request: Request) -> Maybe<#((Request) -> Response, String)> {
        case Router.route(router, request) {
            ["match", index, pattern, ..] ->
                String.to_int(index)
                |> Maybe.flat_map(fn i -> Iter.get(router.handlers, i))
                |> Maybe.map(fn h -> #(h, pattern))

            _ ->
                None
        }
    }

    /// Answers `request` with the handler of the pattern that matches it,
    /// with `request.pattern` and its path values set, or with what the
    /// router answers itself: a redirect, a 405 or a 404.
    pub fn serve(router: Router, request: Request) -> Response {
        case Router.route(router, request) {
            ["match", index, pattern, ..values] -> {
                handler =
                    String.to_int(index) |> Maybe.flat_map(fn i -> Iter.get(router.handlers, i))

                found = #{
                    ..request,
                    pattern: Some(pattern),
                    path_values: pairs(values) |> Iter.to_map(),
                }

                case handler {
                    Some(h) -> h(found)
                    None -> Response{status: Status.not_found}
                }
            }

            ["answer", code, body, ..headers] ->
                Response{
                    status: Status(
                        String.to_int(code)
                        |> Maybe.with_default(500)
                    ),
                    headers: Headers(pairs(headers)),
                    body: Body.Text(body),
                }

            _ ->
                Response{status: Status.internal_server_error}
        }
    }

    /// The router as a handler, for `http.serve`.
    pub fn handler(router: Router) -> (Request) -> Response {
        fn request -> Router.serve(router, request)
    }

    fn route(router: Router, request: Request) -> List<String> {
        http_host.route(
            router.mux,
            Method.text(request.method),
            Maybe.with_default(request.host, ""),
            "${request.url}",
        )
    }
}

fn from_go(parts: List<String>) -> Response {
    case parts {
        ["answer", code, body, ..headers] ->
            Response{
                status: Status(
                    String.to_int(code)
                    |> Maybe.with_default(500)
                ),
                headers: Headers(pairs(headers)),
                body: Body.Text(body),
            }

        _ ->
            Response{status: Status.internal_server_error}
    }
}

/// Go's `NotFoundHandler`: answers every request with `Response.not_found`.
pub fn not_found(_request: Request) -> Response {
    Response.not_found()
}

/// Go's `RedirectHandler`: a handler that redirects every request to `to`.
pub fn redirect_to(to: String, status: Status) -> (Request) -> Response {
    fn request -> Response.redirect(request, to, status)
}

/// Go's `StripPrefix`: middleware that removes `prefix` from the request's
/// path before `handler` sees it, and answers 404 to a path without it.
//! import std/http.{Body, Method, Request, Response}
//! import std/http_testing
//!
//! show = http.strip_prefix("/static")(fn r -> Response{body: Body.Text(r.url.path)})
//! assert Response.text(show(http_testing.request(Method.Get, "/static/a.css"))) == Ok("/a.css")
//
pub fn strip_prefix(prefix: String) -> ((Request) -> Response) -> (Request) -> Response {
    fn handler -> {
        fn request -> {
            case String.strip_prefix(request.url.path, prefix) {
                Some(rest) ->
                    handler(#{..request, url: #{..request.url, path: rest, raw_path: None}})

                None ->
                    Response.not_found()
            }
        }
    }
}

/// Go's `AllowQuerySemicolons`: middleware that reads a `;` in the query
/// as Go did before 1.17, as a `&`.
//! import std/http.{self, Body, Method, Request, Response}
//! import std/http_testing
//! import std/url.{Query, Url}
//!
//! seen = http.allow_query_semicolons(fn r -> Response{
//!     body: Body.Text(Query.encode(Url.query_values(r.url))),
//! })
//!
//! response = seen(http_testing.request(Method.Get, "/?a=1;b=2"))
//! assert Response.text(response) == Ok("a=1&b=2")
//
pub fn allow_query_semicolons(handler: (Request) -> Response) -> (Request) -> Response {
    fn request -> {
        case request.url.query {
            Some(q) when String.contains(q, ";") ->
                handler(
                    #{..request, url: #{..request.url, query: Some(String.replace(q, ";", "&"))}}
                )

            _ ->
                handler(request)
        }
    }
}

/// Go's `TimeoutHandler`: middleware that answers `503 Service
/// Unavailable` with `message` when the handler has not answered within
/// `after`, and stops the handler's task.
//! import std/duration.Duration
//! import std/http.{self, Body, Method, Response, Status}
//! import std/http_testing
//! import std/timer
//!
//! within = http.timeout(Duration.milliseconds(20), "too slow")
//!
//! slow = within(fn _ -> {
//!     timer.sleep(Duration.seconds(5))
//!     Response{body: Body.Text("late")}
//! })
//!
//! assert slow(http_testing.request(Method.Get, "/")).status == Status.service_unavailable
//! fast = within(fn _ -> Response{body: Body.Text("ok")})
//! assert Response.text(fast(http_testing.request(Method.Get, "/"))) == Ok("ok")
//
pub fn timeout(after: Duration, message: String) -> ((Request) -> Response) -> (
    Request
) -> Response {
    fn handler -> {
        fn request -> {
            concurrent {
                answers: Channel<Response> = Channel.buffered(1)
                task = Task.spawn(fn -> { _ = Sender.send(answers.sender, handler(request)) })

                case Receiver.receive_within(answers.receiver, after) {
                    Ok(Some(response)) -> {
                        Task.await(task)
                        response
                    }

                    _ -> {
                        Task.cancel(task)
                        _ = Task.outcome(task)
                        Response.error(Status.service_unavailable, message)
                    }
                }
            }
        }
    }
}

/// Go's `CrossOriginProtection`: which cross-origin requests to let
/// through. A `GET`, `HEAD` or `OPTIONS` always passes.
pub struct CrossOrigin {
    /// Origins, `scheme://host[:port]`, whose requests pass.
    trusted_origins: List<String> = []
    /// `Router` patterns whose requests pass unchecked.
    bypass_patterns: List<Route> = []
    /// The handler a refused request goes to; `None` answers `403
    /// Forbidden`.
    deny: Maybe<(Request) -> Response> = None
}

impl CrossOrigin {
    /// Whether `request` passes, as Go's `CrossOriginProtection.Check`: a
    /// safe method passes; then a `Sec-Fetch-Site` of `same-origin` or
    /// `none`, or else an `Origin` whose host is the request's `Host`, or
    /// none at all (not a browser); and any request from a trusted origin.
    //! import std/http.{CrossOrigin, Method, Request}
    //! import std/http_testing
    //!
    //! post = http_testing.request(Method.Post, "/pay")
    //!
    //! from = fn site: String -> #{
    //!     ..post,
    //!     headers: Headers[#("Sec-Fetch-Site", site), #("Origin", "https://evil.example")],
    //! }
    //!
    //! assert CrossOrigin.check(CrossOrigin{}, from("same-origin")) == Ok(Unit)
    //! assert CrossOrigin.check(CrossOrigin{}, from("cross-site")) |> Result.is_err()
    //!
    //! assert CrossOrigin.check(CrossOrigin{trusted_origins: ["https://evil.example"]}, from("cross-site"))
    //!     == Ok(Unit)
    //
    pub fn check(options: CrossOrigin, request: Request) -> Result<Unit, Error> {
        safe = request.method == Method.Get
            or request.method == Method.Head
            or request.method == Method.Options

        if safe { return Ok(Unit) }
        origin = Headers.get(request.headers, "Origin")

        trusted = case origin {
            Some(o) -> List.contains(options.trusted_origins, o)
            None -> False
        }

        case Headers.get(request.headers, "Sec-Fetch-Site") {
            Some(site) when site == "same-origin" or site == "none" ->
                Ok(Unit)

            Some(_) ->
                if trusted {
                    Ok(Unit)
                } else {
                    Err(
                        Error.CrossOrigin{
                            reason: "cross-origin request detected from Sec-Fetch-Site header",
                        }
                    )
                }

            None ->
                case origin {
                    None ->
                        Ok(Unit)

                    Some(o) -> {
                        host = Url.parse(o) |> Result.to_maybe() |> Maybe.map(fn u -> u.host)

                        if trusted or host == request.host {
                            Ok(Unit)
                        } else {
                            Err(
                                Error.CrossOrigin{
                                    reason: "cross-origin request detected, and/or browser is out of date: Sec-Fetch-Site is missing, and Origin does not match Host",
                                }
                            )
                        }
                    }
                }
        }
    }
}

/// Go's `CrossOriginProtection.Handler`: middleware that sends a request
/// `CrossOrigin.check` refuses to `options.deny`, or answers `403`. An
/// `Err` when a trusted origin is not `scheme://host[:port]` or a bypass
/// pattern does not parse.
pub fn cross_origin_protection(options: CrossOrigin) -> Result<((Request) -> Response) -> (
    Request
) -> Response, Error> {
    bad =
        options.trusted_origins
        |> Iter.find(fn o -> {
            case Url.parse(o) {
                Ok(u) ->
                    u.scheme == ""
                        or u.host == ""
                        or u.path != ""
                        or u.query != None
                        or u.fragment != None

                Err(_) ->
                    True
            }
        })

    if Some(o) = bad { return Err(Error.CrossOrigin{reason: "invalid origin ${o}"}) }

    bypass = Router.new(
        options.bypass_patterns
        |> Iter.map(fn p -> #(p, not_found))
        |> Iter.to_list()
    )?

    Ok(fn handler -> {
        fn request -> {
            if Router.find(bypass, request) |> Maybe.is_some() { return handler(request) }

            case CrossOrigin.check(options, request) {
                Ok(_) ->
                    handler(request)

                Err(Error.CrossOrigin{reason}) ->
                    case options.deny {
                        Some(deny) -> deny(request)
                        None -> Response.error(Status.forbidden, reason)
                    }

                Err(_) ->
                    Response.error(Status.forbidden, "cross-origin request refused")
            }
        }
    })
}

/// Go's `MaxBytesHandler`: middleware that limits each request's body to
/// `max` bytes (`Request.limit_body`).
pub fn limit_body(max: Int) -> ((Request) -> Response) -> (Request) -> Response {
    fn handler -> fn request -> handler(Request.limit_body(request, max))
}

/// Go's `ServeFile`: the file at `path` as the response to `request`,
/// with ranges and conditional requests (`Response.content`). A directory
/// is redirected to its path with a trailing slash, then answered with its
/// `index.html` or a listing of its entries; a request for `.../index.html`
/// is redirected to `./`. A missing file is a 404 and one that cannot be
/// read a 403 or 500. Files come through std/fs, so `fs_testing.run` and
/// `fs.within` apply.
pub fn serve_file(request: Request, file: String) -> Response {
    asked = request.url.path

    if String.ends_with(asked, "/index.html") {
        return Response.redirect(request, "./", Status.moved_permanently)
    }

    case fs.metadata(file) {
        Ok(meta) ->
            case meta.kind {
                fs.Kind.Directory ->
                    if not String.ends_with(asked, "/") {
                        Response.redirect(request, "${path.base(asked)}/", Status.moved_permanently)
                    } else {
                        directory(request, file)
                    }

                _ ->
                    case fs.read(file) {
                        Ok(data) ->
                            Response.content(request, path.base(file), Some(meta.modified), data)

                        Err(e) ->
                            failed(e)
                    }
            }

        Err(e) ->
            failed(e)
    }
}

/// Go's `FileServer`: a handler that answers each request with the file
/// under `root` its cleaned path names (`serve_file`).
pub fn file_server(root: String) -> (Request) -> Response {
    fn request -> {
        asked = if String.starts_with(request.url.path, "/") {
            request.url.path
        } else {
            "/${request.url.path}"
        }

        serve_file(request, path.join(root, path.clean(asked)))
    }
}

fn directory(request: Request, dir: String) -> Response {
    index = path.join(dir, "index.html")

    case fs.metadata(index) {
        Ok(_) ->
            case fs.read(index) {
                Ok(data) -> Response.content(request, "index.html", None, data)
                Err(e) -> failed(e)
            }

        Err(_) ->
            case fs.list(dir) {
                Ok(entries) -> {
                    links = Html.each(entries, fn e -> {
                        case e.kind {
                            fs.Kind.Directory -> Html"<a href='./${e.name}/'>${e.name}/</a>\n"
                            _ -> Html"<a href='./${e.name}'>${e.name}</a>\n"
                        }
                    })

                    Response.html(
                        Html"""
                        <!doctype html>
                        <meta name="viewport" content="width=device-width">
                        <pre>
                        ${links}</pre>
                        """
                    )
                }

                Err(e) ->
                    failed(e)
            }
    }
}

fn failed(error: io.Error) -> Response {
    case error {
        .NotFound{path: _} -> Response.not_found()
        .PermissionDenied{path: _} -> Response.error(Status.forbidden, "403 Forbidden")
        _ -> Response.error(Status.internal_server_error, "500 Internal Server Error")
    }
}

/// Go's `DetectContentType`: the media type of `data` from at most its
/// first 512 bytes, `application/octet-stream` when nothing matches.
//! assert http.detect_content_type(String.to_bytes("<html>")) == "text/html; charset=utf-8"
//
pub fn detect_content_type(data: Bytes) -> String {
    http_host.detect_content_type(data)
}

/// Go's `TimeFormat` of `at`, as HTTP headers write dates:
/// `Mon, 02 Jan 2006 15:04:05 GMT`.
//! import std/instant.Instant
//!
//! assert http.format_time(Instant.from_seconds(0)) == "Thu, 01 Jan 1970 00:00:00 GMT"
//
pub fn format_time(at: Instant) -> String {
    http_host.format_time(Instant.as_nanos(at))
}

/// Go's `ParseTime`: a date in any of the three formats HTTP allows.
pub fn parse_time(text: String) -> Result<Instant, Error> {
    http_host.parse_time(text)
    |> Result.map(Instant.from_nanos)
    |> Result.map_err(fn reason -> Error.Protocol{reason})
}

/// A cookie's `SameSite` attribute.
pub enum SameSite {
    /// No attribute.
    Unset
    /// `SameSite` with no value.
    Default
    Lax
    Strict
    /// `SameSite=None`, which browsers accept only with `secure`.
    None
}

derive Equatable for SameSite

/// A cookie's `Max-Age`, in place of Go's 0 and negative codes.
pub enum MaxAge {
    /// No `Max-Age` attribute.
    Unset
    /// `Max-Age=0`: delete the cookie now.
    DeleteNow
    Seconds Int
}

derive Equatable for MaxAge

/// An HTTP cookie, as Go's `http.Cookie`: what a `Set-Cookie` header sets
/// or a `Cookie` header sends. `raw_expires`, `raw` and `unparsed` are set
/// by parsing only.
pub struct Cookie {
    name: String
    value: String
    /// Whether the value was or is to be written in double quotes.
    quoted: Bool = False
    path: Maybe<String> = None
    domain: Maybe<String> = None
    expires: Maybe<Instant> = None
    raw_expires: Maybe<String> = None
    max_age: MaxAge = MaxAge.Unset
    secure: Bool = False
    http_only: Bool = False
    same_site: SameSite = SameSite.Unset
    partitioned: Bool = False
    raw: Maybe<String> = None
    unparsed: List<String> = []
}

derive Equatable for Cookie

impl Cookie {
    /// The cookies of a `Cookie` header's value, as Go's `ParseCookie`.
    //! import std/http.Cookie
    //!
    //! names = Cookie.parse_header("a=1; b=2")! |> Iter.map(fn c -> c.name) |> Iter.to_list()
    //! assert names == ["a", "b"]
    //
    pub fn parse_header(text: String) -> Result<List<Cookie>, Error> {
        http_host.parse_cookie(text)
        |> Result.map(fn all -> all |> Iter.map(Cookie.of_parts) |> Iter.to_list())
        |> Result.map_err(fn reason -> Error.Protocol{reason})
    }

    /// The cookie of a `Set-Cookie` header's value, as Go's
    /// `ParseSetCookie`.
    //! import std/http.{Cookie, MaxAge}
    //!
    //! c = Cookie.parse_set_cookie("id=7; Path=/; Max-Age=60; Secure")!
    //! assert c.path == Some("/")
    //! assert c.max_age == MaxAge.Seconds(60)
    //! assert c.secure
    //
    pub fn parse_set_cookie(text: String) -> Result<Cookie, Error> {
        http_host.parse_set_cookie(text)
        |> Result.map(Cookie.of_parts)
        |> Result.map_err(fn reason -> Error.Protocol{reason})
    }

    /// Whether Go would write the cookie, as its `Cookie.Valid`.
    pub fn validate(cookie: Cookie) -> Result<Unit, Error> {
        reason = http_host.cookie_valid(Cookie.parts(cookie))

        if reason == "" {
            Ok(Unit)
        } else {
            Err(Error.Protocol{reason})
        }
    }

    fn parts(cookie: Cookie) -> List<String> {
        text = fn m: Maybe<String> -> Maybe.with_default(m, "")

        max_age = case cookie.max_age {
            .Unset -> ""
            .DeleteNow -> "-1"
            .Seconds(n) -> "${n}"
        }

        same_site = case cookie.same_site {
            .Unset -> ""
            .Default -> "default"
            .Lax -> "lax"
            .Strict -> "strict"
            .None -> "none"
        }

        [cookie.name, cookie.value, "${cookie.quoted}", text(cookie.path), text(
            cookie.domain
        ), cookie.expires
        |> Maybe.map(fn at -> "${Instant.as_nanos(at)}")
        |> Maybe.with_default(""), text(
            cookie.raw_expires
        ), max_age, "${cookie.secure}", "${cookie.http_only}", same_site, "${cookie.partitioned}", text(
            cookie.raw
        ), ..cookie.unparsed]
    }

    fn of_parts(parts: List<String>) -> Cookie {
        case parts {
            [name, value, quoted, path, domain, expires, raw_expires, max_age, secure, http_only, same_site, partitioned, raw, ..unparsed] -> {
                some = fn t: String -> if t == "" { None } else { Some(t) }

                Cookie{
                    name,
                    value,
                    quoted: quoted == "true",
                    path: some(path),
                    domain: some(domain),
                    expires: String.to_int(expires) |> Maybe.map(Instant.from_nanos),
                    raw_expires: some(raw_expires),
                    max_age: case max_age {
                        "" ->
                            MaxAge.Unset

                        "-1" ->
                            MaxAge.DeleteNow

                        n ->
                            MaxAge.Seconds(
                                String.to_int(n)
                                |> Maybe.with_default(0)
                            )
                    },
                    secure: secure == "true",
                    http_only: http_only == "true",
                    same_site: case same_site {
                        "default" -> SameSite.Default
                        "lax" -> SameSite.Lax
                        "strict" -> SameSite.Strict
                        "none" -> SameSite.None
                        _ -> SameSite.Unset
                    },
                    partitioned: partitioned == "true",
                    raw: some(raw),
                    unparsed,
                }
            }

            _ ->
                Cookie{name: "", value: ""}
        }
    }
}

/// The `Set-Cookie` value, as Go's `Cookie.String`: "" for a cookie Go
/// cannot write.
impl Display for Cookie {
    fn to_string(cookie: Cookie) -> String {
        http_host.cookie_text(Cookie.parts(cookie))
    }
}

/// Where a client keeps cookies: Go's net/http/cookiejar, with no public
/// suffix list. Give it to a client with `ClientOptions.cookies`.
pub struct CookieJar {
    handle: http_host.Jar
}

impl CookieJar {
    /// An empty jar.
    pub fn new() -> CookieJar {
        CookieJar{handle: http_host.new_jar()}
    }

    /// The cookies the jar would send with a request to `url`.
    //! import std/http.{Cookie, CookieJar}
    //! import std/url.Url
    //!
    //! jar = CookieJar.new()
    //! CookieJar.set_cookies(jar, Url`https://example.com/`, [Cookie{name: "a", value: "1"}])
    //!
    //! sent =
    //!     CookieJar.cookies(jar, Url`https://example.com/x`) |> Iter.map(fn c -> c.name) |> Iter.to_list()
    //!
    //! assert sent == ["a"]
    //
    pub fn cookies(jar: CookieJar, url: Url) -> List<Cookie> {
        http_host.jar_cookies(jar.handle, "${url}") |> Iter.map(Cookie.of_parts) |> Iter.to_list()
    }

    /// Stores `cookies`, as received in a response from `url`.
    pub fn set_cookies(jar: CookieJar, url: Url, cookies: List<Cookie>) -> Unit {
        http_host.jar_set(
            jar.handle,
            "${url}",
            cookies
            |> Iter.map(Cookie.parts)
            |> Iter.to_list(),
        )
    }
}

/// What a server's connection is doing: Go's `ConnState`.
pub enum ConnState {
    New
    Active
    Idle
    Hijacked
    Closed
}

derive Equatable for ConnState

impl Display for ConnState {
    //! import std/http.ConnState
    //!
    //! assert "${ConnState.Idle}" == "idle"
    //
    fn to_string(state: ConnState) -> String {
        case state {
            .New -> "new"
            .Active -> "active"
            .Idle -> "idle"
            .Hijacked -> "hijacked"
            .Closed -> "closed"
        }
    }
}

/// Answers each request `listener` receives with `handler`, each as a task
/// of a `concurrent` block of its own, and returns once the listener shuts
/// down and every request it took is answered. For a server with no
/// supervisor, as in a test; a program's server uses `serve` and a
/// supervisor, whose `max_running` bounds the requests in flight.
pub fn serve_here(listener: Listener, handler: (Request) -> Response) -> Unit {
    concurrent {
        _ = Task.await_all(take_requests(listener, handler, []))
    }
}

fn take_requests(
    listener: Listener,
    handler: (Request) -> Response,
    taken: List<Task<Unit>>,
) -> List<Task<Unit>> {
    case http_host.next(listener.handle) {
        Some(incoming) -> {
            task = Task.spawn(fn -> answer(listener, incoming, handler))
            take_requests(listener, handler, [task, ..taken])
        }

        None ->
            taken
    }
}

/// The request a reverse proxy received and the request it will send, for
/// its `rewrite` function: Go's `ProxyRequest`.
pub struct ProxyRequest {
    incoming: Request
    outgoing: Request
}

impl ProxyRequest {
    /// Sends the outgoing request to `target`: its scheme and host, its
    /// path joined before the request's, its query before the request's.
    /// The `Host` sent is the target's. Go's `SetURL`.
    pub fn set_url(proxy: ProxyRequest, target: Url) -> ProxyRequest {
        out = proxy.outgoing
        incoming_url = out.url

        query = case #(target.query, incoming_url.query) {
            #(Some(a), Some(b)) when a != "" and b != "" -> Some("${a}&${b}")
            #(Some(a), _) when a != "" -> Some(a)
            #(_, b) -> b
        }

        url = #{
            ..incoming_url,
            scheme: target.scheme,
            host: target.host,
            path: join_paths(target.path, incoming_url.path),
            raw_path: None,
            query,
        }

        #{..proxy, outgoing: #{..out, url, host: None}}
    }

    /// Sets `X-Forwarded-For` to the client's address (added to what an
    /// earlier proxy set), `X-Forwarded-Host` to the host it asked for and
    /// `X-Forwarded-Proto` to `http` or `https`. Go's `SetXForwarded`.
    pub fn set_x_forwarded(proxy: ProxyRequest) -> ProxyRequest {
        incoming = proxy.incoming

        client =
            net.split_host_port(incoming.remote_address)
            |> Result.map(fn #(host, _) -> host)
            |> Result.with_default(incoming.remote_address)

        prior = Headers.values(incoming.headers, "X-Forwarded-For")
        forwarded = String.join([..prior, client], ", ")

        headers =
            proxy.outgoing.headers
            |> Headers.set("X-Forwarded-For", forwarded)
            |> Headers.set("X-Forwarded-Host", Maybe.with_default(incoming.host, incoming.url.host))
            |> Headers.set(
                "X-Forwarded-Proto",
                if incoming.url.scheme == "https" {
                    "https"
                } else {
                    "http"
                },
            )

        #{..proxy, outgoing: #{..proxy.outgoing, headers}}
    }
}

fn join_paths(a: String, b: String) -> String {
    case #(String.ends_with(a, "/"), String.starts_with(b, "/")) {
        #(True, True) -> a + String.drop(b, 1)
        #(False, False) -> "${a}/${b}"
        _ -> a + b
    }
}

/// How a reverse proxy forwards: Go's `ReverseProxy`. `rewrite` turns each
/// request it receives into the one it sends.
pub struct ReverseProxy {
    rewrite: (ProxyRequest) -> ProxyRequest
    /// The client that sends the outgoing request.
    client: Client = default_client()
    /// Changes each response before it goes back; an `Err` answers as
    /// `on_error` does.
    modify_response: Maybe<(Response) -> Result<Response, Error>> = None
    /// Answers when the request fails; `None` answers 502 Bad Gateway.
    on_error: Maybe<(Request, Error) -> Response> = None
    /// How often the response is flushed to the client while it streams:
    /// `None` flushes it as it arrives only for a response of unknown
    /// length or an event stream, and otherwise at its end; zero flushes
    /// after each write. Go's `FlushInterval`.
    flush_interval: Maybe<Duration> = None
    /// Told each error the proxy meets: a request that failed, a copy that
    /// broke. `None` writes them to standard error. Go's `ErrorLog`.
    on_error_log: Maybe<(String) -> Unit> = None
}

impl ReverseProxy {
    /// A proxy to one host: each request goes to `target`, its path joined
    /// after the target's, with `X-Forwarded-*` set. Go's
    /// `NewSingleHostReverseProxy`.
    pub fn to(target: Url) -> ReverseProxy {
        ReverseProxy{
            rewrite: fn p -> ProxyRequest.set_url(p, target) |> ProxyRequest.set_x_forwarded(),
        }
    }
}

/// The headers that describe one connection, which a proxy does not pass
/// on (RFC 9110, section 7.6.1).
once hop_headers = [
    "Connection",
    "Proxy-Connection",
    "Keep-Alive",
    "Proxy-Authenticate",
    "Proxy-Authorization",
    "Te",
    "Trailer",
    "Transfer-Encoding",
    "Upgrade",
]

fn without_hop_headers(headers: Headers) -> Headers {
    named =
        Headers.values(headers, "Connection")
        |> Iter.flat_map(fn v -> String.split(v, ","))
        |> Iter.map(String.trim)
        |> Iter.to_list()

    [..hop_headers, ..named] |> Iter.reduce(headers, fn h, name -> Headers.remove(h, name))
}

/// A handler that forwards each request as `options` says and answers
/// with the response, its connection headers removed: Go's
/// `ReverseProxy.ServeHTTP`. The response streams to the client as it
/// arrives, flushed as `flush_interval` says.
pub fn reverse_proxy(options: ReverseProxy) -> (Request) -> Response {
    fn request -> {
        outgoing = #{
            ..request,
            headers: without_hop_headers(request.headers),
            request_uri: "",
            host: request.host,
        }

        rewritten = options.rewrite(ProxyRequest{incoming: request, outgoing})

        answered =
            forward(options, rewritten.outgoing)
            |> Result.map(fn r -> #{..r, headers: without_hop_headers(r.headers)})
            |> Result.flat_map(fn r -> {
                case options.modify_response {
                    Some(modify) -> modify(r)
                    None -> Ok(r)
                }
            })

        case answered {
            Ok(response) ->
                response

            Err(error) -> {
                proxy_log(options, "${error}")

                case options.on_error {
                    Some(on_error) -> on_error(request, error)
                    None -> Response{status: Status.bad_gateway, body: Body.Empty}
                }
            }
        }
    }
}

fn proxy_log(options: ReverseProxy, text: String) -> Unit {
    case options.on_error_log {
        Some(told) ->
            told(text)

        None -> {
            _ = io.Writer.write_text(io.stderr, "http: proxy error: ${text}\n")
        }
    }
}

// The upstream response with a body that streams to the client: sent once,
// following no redirect, as Go's Transport does for a ReverseProxy. A faked
// or round-tripped client answers whole.
fn forward(options: ReverseProxy, outgoing: Request) -> Result<Response, Error> {
    faked: Maybe<Result<Response, Error>> = http_host.answered(outgoing)
    if Some(answer) = faked { return answer }
    Client{handle, options: client_options} = options.client
    if Some(round_trip) = client_options.round_trip { return round_trip(outgoing) }
    exchange = send(handle, outgoing, True, None)?
    reader = http_host.body_reader(exchange)
    head = response_of(exchange, Body.Empty)

    content_type = Headers.get(head.headers, "Content-Type") |> Maybe.with_default("")

    streaming = Maybe.is_none(head.content_length)
        or String.starts_with(content_type, "text/event-stream")

    every = case options.flush_interval {
        Some(d) -> Some(d)
        None when streaming -> Some(Duration.nanoseconds(0))
        None -> None
    }

    Ok(#{
        ..head,
        body: Body.Produce(fn w -> {
            defer http_host.close_body(exchange)

            pump(reader, w, every, Instant.now())
            |> Result.map_err(fn e -> {
                proxy_log(options, "${e}")
                e
            })
        }),
    })
}

fn pump(r: Reader, w: Writer, every: Maybe<Duration>, flushed: Instant) -> Result<Unit, io.Error> {
    case Reader.read(r)? {
        None ->
            Writer.flush(w)

        Some(chunk) -> {
            Writer.write(w, chunk)?
            now = Instant.now()

            due = case every {
                Some(d) -> Duration.as_nanos(Instant.between(flushed, now)) >= Duration.as_nanos(d)
                None -> False
            }

            if due {
                Writer.flush(w)?
                pump(r, w, every, now)
            } else {
                pump(r, w, every, flushed)
            }
        }
    }
}

/// Records what Go's client reports while it sends the requests that name
/// it in `Request.trace`: Go's `httptrace.ClientTrace`, as data rather than
/// callbacks.
pub struct Tracer {
    handle: http_host.Handle
}

impl Tracer {
    pub fn new() -> Tracer {
        Tracer{handle: http_host.new_tracer()}
    }

    /// What happened so far, in order.
    pub fn events(tracer: Tracer) -> List<TraceEvent> {
        http_host.tracer_events(tracer.handle)
        |> Iter.flat_map(TraceEvent.of_parts)
        |> Iter.to_list()
    }
}

/// One thing a client did while it sent a request: Go's `ClientTrace`
/// hooks, each with its info's fields.
pub enum TraceEvent {
    /// It looked for a connection to `address` (`host:port`).
    GetConnection {address: String}
    /// It got one: reused from an earlier request, idle for `idle_time`.
    GotConnection {reused: Bool, was_idle: Bool, idle_time: Duration}
    /// It returned the connection to the idle pool, or failed to.
    PutIdleConnection {error: Maybe<String>}
    FirstResponseByte
    /// The server answered `100 Continue`.
    Continue
    /// The server answered a 1xx status before the final one.
    Informational {status: Status, headers: Headers}
    DnsStart {host: String}
    DnsDone {addresses: List<String>, error: Maybe<String>, coalesced: Bool}
    ConnectStart {network: String, address: String}
    ConnectDone {network: String, address: String, error: Maybe<String>}
    TlsStart
    TlsDone {state: tls.ConnectionState, error: Maybe<String>}
    /// It wrote one header field.
    WroteHeader {name: String, values: List<String>}
    WroteHeaders
    /// It waits for `100 Continue` before sending the body.
    WaitContinue
    WroteRequest {error: Maybe<String>}
}

impl TraceEvent {
    fn of_parts(parts: List<List<String>>) -> Maybe<TraceEvent> {
        error = fn text: String -> if text == "" { None } else { Some(text) }

        case parts {
            [["GetConnection", address]] ->
                Some(TraceEvent.GetConnection{address})

            [["GotConnection", reused, was_idle, idle]] ->
                Some(TraceEvent.GotConnection{
                    reused: reused == "true",
                    was_idle: was_idle == "true",
                    idle_time: Duration.nanoseconds(
                        String.to_int(idle)
                        |> Maybe.with_default(0)
                    ),
                })

            [["PutIdleConnection", e]] ->
                Some(TraceEvent.PutIdleConnection{error: error(e)})

            [["FirstResponseByte"]] ->
                Some(TraceEvent.FirstResponseByte)

            [["Continue"]] ->
                Some(TraceEvent.Continue)

            [["Informational", code, ..headers]] ->
                Some(TraceEvent.Informational{
                    status: Status(
                        String.to_int(code)
                        |> Maybe.with_default(0)
                    ),
                    headers: Headers(pairs(headers)),
                })

            [["DnsStart", host]] ->
                Some(TraceEvent.DnsStart{host})

            [["DnsDone", coalesced, e, ..addresses]] ->
                Some(TraceEvent.DnsDone{addresses, error: error(e), coalesced: coalesced == "true"})

            [["ConnectStart", network, address]] ->
                Some(TraceEvent.ConnectStart{network, address})

            [["ConnectDone", network, address, e]] ->
                Some(TraceEvent.ConnectDone{network, address, error: error(e)})

            [["TlsStart"]] ->
                Some(TraceEvent.TlsStart)

            [["TlsDone", e], ..state] ->
                Some(
                    TraceEvent.TlsDone{state: tls.ConnectionState.of_parts(state), error: error(e)}
                )

            [["WroteHeader", name, ..values]] ->
                Some(TraceEvent.WroteHeader{name, values})

            [["WroteHeaders"]] ->
                Some(TraceEvent.WroteHeaders)

            [["WaitContinue"]] ->
                Some(TraceEvent.WaitContinue)

            [["WroteRequest", e]] ->
                Some(TraceEvent.WroteRequest{error: error(e)})

            _ ->
                None
        }
    }
}

fn wire_parts_of(
    message: http_host.Handle,
) -> #(List<String>, List<String>, List<String>, List<String>) {
    case http_host.wire_parts(message) {
        [head, headers, trailers, encoding] -> #(head, headers, trailers, encoding)
        _ -> #([], [], [], [])
    }
}

fn wire_length(text: String) -> Maybe<Int> {
    case String.to_int(text) {
        Some(n) when n >= 0 -> Some(n)
        _ -> None
    }
}

fn wire_request(op: Int, request: Request, w: Writer) -> Result<String, Error> {
    data = Body.read_all(request.body)?

    http_host.wire_request(
        op,
        w,
        Method.text(request.method),
        "${request.url}",
        flat(typed(request.headers, request.body)),
        Maybe.with_default(request.host, ""),
        Maybe.with_default(request.content_length, -1),
        request.transfer_encoding,
        request.close,
        flat(request.trailers),
        data,
    )
    |> Result.map_err(fn reason -> Error.Protocol{reason})
}

fn wire_response(op: Int, response: Response, w: Writer) -> Result<String, Error> {
    data = Body.read_all(response.body)?

    http_host.wire_response(
        op,
        w,
        Status.code(response.status),
        response.protocol.major,
        response.protocol.minor,
        flat(typed(response.headers, response.body)),
        Maybe.with_default(response.content_length, -1),
        response.transfer_encoding,
        response.close,
        flat(response.trailers),
        data,
        "GET",
    )
    |> Result.map_err(fn reason -> Error.Protocol{reason})
}

/// A reader of the chunked transfer coding over `r`, which ends at the
/// last, empty chunk: httputil's `NewChunkedReader`.
//! import std/http
//! import std/io.Reader
//!
//! r = http.chunked_reader(Reader.from_text("2\r\nhi\r\n0\r\n\r\n"))
//! assert Reader.read_all_text(r) == Ok("hi")
//
pub fn chunked_reader(r: Reader) -> Reader {
    http_host.chunked_reader(r)
}

/// A writer that sends what it is given to `w` in the chunked transfer
/// coding; closing it writes the last, empty chunk and leaves `w` open:
/// httputil's `NewChunkedWriter`.
pub fn chunked_writer(w: Writer) -> Writer {
    http_host.chunked_writer(w)
}

/// One part of a multipart body, read as it arrives: Go's
/// `multipart.Part`. Reading the next part ends this one.
pub struct Part {
    headers: Headers
    body: Reader
    handle: http_host.Handle
}

impl Part {
    /// The `name` of its `form-data` `Content-Disposition`, if any.
    pub fn form_name(part: Part) -> Maybe<String> {
        case http_host.part_form_name(part.handle) {
            "" -> None
            name -> Some(name)
        }
    }

    /// The `filename` of its `Content-Disposition`, if any.
    pub fn file_name(part: Part) -> Maybe<String> {
        case http_host.part_file_name(part.handle) {
            "" -> None
            name -> Some(name)
        }
    }
}

/// The parts of the multipart body `r` holds, separated by `boundary`, each
/// read as the iteration reaches it: Go's `multipart.NewReader` and its
/// `NextPart`, which decodes quoted-printable parts. An `Err` ends it.
//! import std/http
//! import std/http.Part
//! import std/io.Reader
//!
//! body = "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\none\r\n--b--\r\n"
//!
//! names =
//!     http.multipart_parts(Reader.from_text(body), "b")
//!     |> Iter.map(fn p -> p |> Result.map(Part.form_name))
//!     |> Iter.to_list()
//!
//! assert names == [Ok(Some("a"))]
//
pub fn multipart_parts(r: Reader, boundary: String) -> Iter<Result<Part, Error>> {
    parts_of(http_host.multipart_reader(r, boundary, False))
}

/// `multipart_parts` with each part as it was sent, not decoded: Go's
/// `NextRawPart`.
pub fn multipart_raw_parts(r: Reader, boundary: String) -> Iter<Result<Part, Error>> {
    parts_of(http_host.multipart_reader(r, boundary, True))
}

fn parts_of(reader: http_host.Handle) -> Iter<Result<Part, Error>> {
    Iter.repeat(reader)
    |> Iter.scan(Err(Error.Form{reason: ""}), fn previous: Result<Part, Error>, h -> {
        if Err(Error.Form{reason}) = previous { if reason != "" { break } }

        case http_host.next_part(h) {
            Ok(Some(part)) ->
                Ok(Part{
                    headers: Headers(pairs(http_host.part_headers(part))),
                    body: http_host.part_reader(part),
                    handle: part,
                })

            Ok(None) ->
                break

            Err(reason) ->
                Err(Error.Form{reason})
        }
    })
}

/// The multipart form `r` holds, read whole: Go's `Reader.ReadForm`. A
/// form larger than `max_memory` bytes is refused.
pub fn read_multipart_form(
    r: Reader,
    boundary: String,
    max_memory: Int = 33_554_432,
) -> Result<MultipartForm, Error> {
    data = Reader.read_all(r) |> Result.map_err(fn e -> Error.Form{reason: "${e}"})?

    if Bytes.length(data) > max_memory {
        return Err(Error.Form{reason: "the form is larger than ${max_memory} bytes"})
    }

    flat =
        http_host.parse_multipart("multipart/form-data; boundary=${boundary}", data)
        |> Result.map_err(fn reason -> Error.Form{reason})?

    Ok(multipart_of(flat, MultipartForm{}))
}

/// Writes `parts` to `w` as a multipart body separated by `boundary`, each
/// as it comes, then the closing boundary: Go's `multipart.Writer`. The
/// body's `Content-Type` is `multipart/form-data; boundary=` and the
/// boundary.
pub fn write_multipart(w: Writer, boundary: String, parts: List<FormPart>) -> Result<Unit, Error> {
    flat = parts |> Iter.flat_map(FormPart.flat) |> Iter.to_list()
    http_host.multipart_write(w, boundary, flat) |> Result.map_err(fn reason -> Error.Form{reason})
}
