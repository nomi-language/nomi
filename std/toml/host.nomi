//# The Go-backed half of std::toml: placing a `Toml"..."` literal's slots,
//# reading its text as TOML, writing its slots' values, and reading a TOML
//# document (internal/stdtoml). It is internal; a program imports std::toml.

import
    float.Float
    int.Int
    lists.List
    strings.String
end

/// Where the literal's slots stand and whether its text is TOML with a
/// stand-in for each slot: fragment -1 when it is, else the static the
/// refusal is in, the code point offset there, and why.
host fn check(statics: List<String>) -> (Int, Int, String)

/// The statics with each slot's TOML between them, written as a quoted key
/// where the slot stands for a key.
host fn build(statics: List<String>, slots: List<String>) -> String

/// `text` as a TOML basic string.
host fn quote(text: String) -> String

/// `value` as a TOML float.
host fn float(value: Float) -> String

/// `text` read as a TOML document. The offset is -1 when it is TOML, and
/// the list holds the document's values in document order: each value is
/// its kind and then its text, or for an array or a table the count of its
/// items or entries, which follow it, each table entry a key and then its
/// value. Otherwise the list is empty, and the offset (code points from 0),
/// the line and column (from 1) and the message say where reading stopped
/// and why.
host fn decode(text: String) -> (List<String>, Int, Int, Int, String)
