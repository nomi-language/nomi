//# The Go-backed half of std::signatures: keys and signatures over Go's
//# crypto/ed25519, crypto/ecdsa, crypto/rsa and crypto/x509
//# (internal/stdhttp/signatures.go). A private key crosses as PKCS #8 DER
//# and a public key as PKIX DER. A key kind is its `KeyKind` variant's
//# position and a scheme its `Scheme` variant's, the positions of
//# internal/stdhttp's two tables. It is internal; a program imports
//# std::signatures.

import
    bool.Bool
    bytes.Bytes
    int.{Int, Int64}
    option.Option
    results.Result
    strings.{NonEmptyString, String}
end

/// A new Ed25519 private key.
host fn generate_ed25519() -> Bytes

/// A new ECDSA private key of an ECDSA kind.
host fn generate_ecdsa(kind: Int64) -> Bytes

/// A new RSA private key of `bits` bits, or why `bits` is out of range.
host fn generate_rsa(bits: Int) -> Result<Bytes, String>

/// A private key in PKCS #8, PKCS #1 or SEC 1 DER, as PKCS #8.
host fn private_from_der(der: Bytes) -> Result<Bytes, String>

/// The first private key in PEM text, as PKCS #8.
host fn private_from_pem(text: String) -> Result<Bytes, String>

/// A private key in a PKCS #8 `PRIVATE KEY` PEM block.
host fn private_to_pem(der: Bytes) -> NonEmptyString

/// A private key's kind.
host fn private_kind(der: Bytes) -> Int

/// A private key's public key.
host fn public_of(der: Bytes) -> Bytes

/// A public key in PKIX or PKCS #1 DER, as PKIX.
host fn public_from_der(der: Bytes) -> Result<Bytes, String>

/// The first public key in PEM text, as PKIX.
host fn public_from_pem(text: String) -> Result<Bytes, String>

/// A public key in a PKIX `PUBLIC KEY` PEM block.
host fn public_to_pem(der: Bytes) -> NonEmptyString

/// A public key's kind.
host fn public_kind(der: Bytes) -> Int

/// The Ed25519 private key with a 32-byte seed.
host fn ed25519_from_seed(seed: Bytes) -> Result<Bytes, String>

/// An Ed25519 private key's 32-byte seed.
host fn ed25519_seed(der: Bytes) -> Bytes

/// The Ed25519 public key with a 32-byte encoding.
host fn ed25519_public_from_bytes(raw: Bytes) -> Result<Bytes, String>

/// An Ed25519 public key's 32-byte encoding.
host fn ed25519_public_bytes(der: Bytes) -> Bytes

/// `message` signed under a private key with a scheme of its kind.
host fn sign(der: Bytes, scheme: Int64, message: Bytes) -> Bytes

/// Whether `signature` is `message`'s under a public key with a scheme.
host fn is_valid(der: Bytes, scheme: Int64, message: Bytes, signature: Bytes) -> Bool

/// The kind of key a scheme signs with.
host fn scheme_kind(scheme: Int64) -> Int

/// A scheme's variant name.
host fn scheme_name(scheme: Int64) -> String

/// `plaintext` encrypted to an RSA public key with RSA-OAEP and `label`, or
/// why it is too long for the key.
host fn encrypt(
    der:        Bytes,
    encryption: Int64,
    plaintext:  Bytes,
    label:      Bytes,
) -> Result<Bytes, String>

/// The plaintext `ciphertext` holds under an RSA private key with RSA-OAEP
/// and `label`, or `None` for any failure.
host fn decrypt(der: Bytes, encryption: Int64, ciphertext: Bytes, label: Bytes) -> Option<Bytes>
