import
    bool.Bool.{self, False, True}
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.Int
    iter.Iter
    lists.List
    results.Result
end

//# An `Option<T>` is a value that may be absent: `Some(value)` or `None`. A
//# function returns one when it may have no answer, as `Map.get` does for a
//# missing key. `Option`, `Some` and `None` are in the prelude, so a program
//# writes them without an import.
//#
//# Read an `Option` with `case`, which must handle both variants:
//#
//# ```nomi
//# fn describe(ages: Map<String, Int>, name: String) -> String
//#     case Map.get(ages, name)
//#         Some(age) -> "${name} is ${age}"
//#         None      -> "nobody is called ${name}"
//#     end
//# end
//# ```
//#
//# The functions here cover the common cases without a `case`. Test an
//# `Option` with `is_some` and `is_none`. Change the value with `map`,
//# `flat_map` and `filter`. Take the value out with `with_default`. Fall
//# back to another `Option` with `otherwise` and `or_else`. Unnest an
//# `Option<Option<T>>` with `flatten`. Turn it into a `Result` with
//# `to_result`. `collect` and `values` work over many options at once.
//#
//# An `Option` is an `Iter` of zero or one elements, so it goes wherever an
//# `Iter` does. It renders, in `Display` and in `Debug`, as `Some(...)`
//# around the rendered value or as `None`, never as the bare value or the
//# empty string.

/// A value that may or may not be present.
//! n: Option<Int> = Option.None
//! assert "${Option.Some(3)}" == "Some(3)"
//! assert "${n}" == "None"
//!
//! assert Option.Some(42)
//!     |> case
//!         .Some(v) -> v
//!         .None    -> 0
//!     end
//!     |> Int.equal(42)
//
pub enum Option<T>
    Some T
    None
end

impl Option<T>
    /// Returns True when the value is Some.
    //! assert Option.is_some(Option.Some(3))
    //! refute Option.is_some(Option.None)
    //
    pub fn is_some<T>(option: Option<T>) -> Bool
        case option
            Some(_) -> True
            None    -> False
        end
    end

    /// Returns True when the value is None.
    //! refute Option.is_none(Option.Some(3))
    //! assert Option.is_none(Option.None)
    //
    pub fn is_none<T>(option: Option<T>) -> Bool
        case option
            Some(_) -> False
            None    -> True
        end
    end

    /// Applies `f` to the value inside Some. None stays None.
    //! assert Option.map(Option.Some(3), &(&1 * 2)) == Option.Some(6)
    //! assert Option.map(Option.None, &(&1 * 2)) == Option.None
    //
    pub fn map<T, U>(option: Option<T>, f: (T) -> U) -> Option<U>
        case option
            Some(v) -> Option.Some(f(v))
            None    -> Option.None
        end
    end

    /// Returns the value inside Some, or the default if None.
    //! assert Option.with_default(Option.Some(5), 0) == 5
    //! assert Option.with_default(Option.None, 0) == 0
    //
    pub fn with_default<T>(option: Option<T>, default: T) -> T
        case option
            Some(v) -> v
            None    -> default
        end
    end

    /// Returns `option` when it is Some, and otherwise `fallback`: the first
    /// of two places a value may come from. `fallback` is computed even when
    /// `option` is Some; `or_else` computes it only when needed.
    //! import std::maps.Map
    //!
    //! assert Option.otherwise(Option.Some(1), Option.Some(2)) == Option.Some(1)
    //! assert Option.otherwise(Option.None, Option.Some(2)) == Option.Some(2)
    //! nothing: Option<Int> = Option.None
    //! assert Option.otherwise(nothing, Option.None) == Option.None
    //!
    //! flags = {"port" => "8080"}
    //! port = Map.get(flags, "listen") |> Option.otherwise(Map.get(flags, "port"))
    //! assert port == Option.Some("8080")
    //
    pub fn otherwise<T>(option: Option<T>, fallback: Option<T>) -> Option<T>
        case option
            Some(_) -> option
            None    -> fallback
        end
    end

    /// Returns `option` when it is Some, and otherwise what `fallback`
    /// returns. `fallback` is called only for None, so it can do work, such
    /// as a lookup, that a Some makes unneeded.
    //! assert Option.or_else(Option.Some(1), fn -> Option.Some(2)) == Option.Some(1)
    //! assert Option.or_else(Option.None, fn -> Option.Some(2)) == Option.Some(2)
    //
    pub fn or_else<T>(option: Option<T>, fallback: () -> Option<T>) -> Option<T>
        case option
            Some(_) -> option
            None    -> fallback()
        end
    end

    /// Converts Option to Result. None becomes Err(error).
    //! assert Option.to_result(Option.Some(3), "missing") == Result.Ok(3)
    //! assert Option.to_result(Option.None, "missing") == Result.Err("missing")
    //
    pub fn to_result<T, E>(option: Option<T>, error: E) -> Result<T, E>
        case option
            Some(v) -> Result.Ok(v)
            None    -> Result.Err(error)
        end
    end

    /// Applies `f`, which returns an Option itself, to the value inside Some
    /// and returns what `f` returns, not an Option of an Option. None stays
    /// None.
    //! safe_div =
    //!     fn a: Int, b: Int ->
    //!         if b == 0 then Option.None else Option.Some(a / b)
    //!     end
    //!
    //! assert Option.flat_map(Option.Some(10), &safe_div(&1, 2)) == Option.Some(5)
    //! assert Option.flat_map(Option.Some(10), &safe_div(&1, 0)) == Option.None
    //
    pub fn flat_map<T, U>(option: Option<T>, f: (T) -> Option<U>) -> Option<U>
        case option
            Some(v) -> f(v)
            None    -> Option.None
        end
    end

    /// Keeps the value inside Some when `keep` returns True for it, and
    /// otherwise returns None.
    //! assert Option.filter(Option.Some(4), &(&1 > 2)) == Option.Some(4)
    //! assert Option.filter(Option.Some(1), &(&1 > 2)) == Option.None
    //! nothing: Option<Int> = Option.None
    //! assert Option.filter(nothing, &(&1 > 2)) == Option.None
    //!
    //! // An empty setting counts as unset.
    //! host = Option.Some("") |> Option.filter(&(&1 != "")) |> Option.with_default("localhost")
    //! assert host == "localhost"
    //
    pub fn filter<T>(option: Option<T>, keep: (T) -> Bool) -> Option<T>
        case option
            Some(v) when keep(v) -> option
            _                    -> Option.None
        end
    end

    /// Removes one level of nesting: `Some(Some(v))` becomes `Some(v)`, and
    /// both `Some(None)` and `None` become `None`.
    //! assert Option.flatten(Option.Some(Option.Some(3))) == Option.Some(3)
    //! assert Option.flatten(Option.Some(Option.None)) == Option.None
    //!
    //! nothing: Option<Option<Int>> = Option.None
    //! assert Option.flatten(nothing) == Option.None
    //! assert Option.flatten(Option.None) == Option.None
    //
    pub fn flatten<T>(option: Option<Option<T>>) -> Option<T>
        case option
            Some(inner) -> inner
            None        -> Option.None
        end
    end

    /// Returns Some of every value in order when every element is Some, and
    /// otherwise None. It stops consuming the iterator at the first None.
    //! import std::ranges.Range
    //!
    //! assert Option.collect([Option.Some(1), Option.Some(2)]) == Option.Some([1, 2])
    //! assert Option.collect([Option.Some(1), Option.None, Option.Some(3)]) == Option.None
    //! none: List<Option<Int>> = []
    //! assert Option.collect(none) == Option.Some([])
    //!
    //! halved =
    //!     [4, 2, 8]
    //!     |> Iter.map(fn n ->
    //!         if n % 2 == 0 then Option.Some(n / 2) else Option.None
    //!     end)
    //!     |> Option.collect()
    //!
    //! assert halved == Option.Some([2, 1, 4])
    //!
    //! // On an endless source, collect stops reading at the first None.
    //! stopped =
    //!     Range.naturals()
    //!     |> Iter.map(fn n -> if n < 3 then Option.Some(n) else Option.None)
    //!     |> Option.collect()
    //!
    //! assert stopped == Option.None
    //
    pub fn collect<T>(options: Iter<Option<T>>) -> Option<List<T>>
        reversed = Iter.reduce(options, Option.Some([]), fn acc: Option<List<T>>, item ->
            case item
                Some(v) -> Option.map(acc, fn vs -> [v, ..vs])
                None    -> break Option.None
            end
        end)

        Option.map(reversed, fn vs -> Iter.reverse(vs))
    end

    /// Yields the Some values in order and drops every None. It is lazy, so
    /// it works on an endless source.
    //! assert Option.values([Option.Some(1), Option.None, Option.Some(3)]) |> Iter.to_list() == [1, 3]
    //! nones: List<Option<Int>> = [Option.None, Option.None]
    //! assert Option.values(nones) |> Iter.is_empty()
    //!
    //! halves =
    //!     [4, 3, 8]
    //!     |> Iter.map(fn n ->
    //!         if n % 2 == 0 then Option.Some(n / 2) else Option.None
    //!     end)
    //!     |> Option.values()
    //!     |> Iter.to_list()
    //!
    //! assert halves == [2, 4]
    //!
    //! evens =
    //!     Iter.from(0)
    //!     |> Iter.map(fn n -> if n % 2 == 0 then Option.Some(n) else Option.None)
    //!     |> Option.values()
    //!     |> Iter.take(3)
    //!     |> Iter.to_list()
    //!
    //! assert evens == [0, 2, 4]
    //
    pub fn values<T>(options: Iter<Option<T>>) -> Iter<T>
        Iter.flat_map(options, fn m -> m)
    end
end

impl Iter for Option<T>
    /// An `Option` iterates as zero or one elements: `Some(x)` pushes `x` to
    /// `yield`, and `None` pushes nothing. So an `Option` goes wherever an
    /// `Iter` does, as in `Iter.concat(lines, reaction)` or a `flat_map`
    /// whose function returns an `Option`.
    //! assert Iter.to_list(Option.Some(3)) == [3]
    //! none: Option<Int> = Option.None
    //! assert Iter.to_list(none) == []
    //! assert Iter.concat(["a"], Option.Some("b")) |> Iter.to_list() == ["a", "b"]
    //!
    //! assert [1, 2, 3]
    //! |> Iter.flat_map(fn n ->
    //!     if n % 2 == 1 then Option.Some(n * 10) else Option.None
    //! end)
    //! |> Iter.to_list() == [10, 30]
    //
    fn each_while(option: Option<T>, yield: (T) -> Bool) -> Bool
        case option
            Some(v) -> yield(v)
            None    -> True
        end
    end

    // An Option holds zero or one element, so its count is known.
    fn known_count(option: Option<T>) -> Option<Int>
        case option
            Some(_) -> Option.Some(1)
            None    -> Option.Some(0)
        end
    end
end

derive Display for Option<T>
derive Equatable for Option<T>
derive Hashable for Option<T>
