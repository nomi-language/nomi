import
    add.Add
    bool.Bool
    bytes.{Byte, Bytes}
    code_points.Codepoint
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    contains.Contains
    debug.Debug
    decimal.Decimal
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.Int
    iter.Iter
    lists.List
    locale.Locale
    matcher.Matcher
    maybe.Maybe.{self, None, Some}
    regex.Regex
    summable.Summable
end

//# String operations including text-specific ops (`split`, `replace`, `join`,
//# `reverse`, ...) and the grapheme-cluster iterator used to drive lazy `iter`
//# pipelines over a `String`. Transform graphemes with `Iter.map(s, f) |>
//# String.join()`; join any `Iter<String>` back into one string with `String.join`.
//# The search functions (`starts_with`, `ends_with`, `replace`, `split`,
//# `find`, `find_all`) take any `Matcher`: a `String`, a `Regex` or a
//# `Codepoint`. `contains` takes the same three as String's `Contains` impls.
//#
//# ## Searching
//#
//# A `String` matches its own text, a `Regex` (`std::regex`) matches its
//# pattern, and a `Codepoint` matches itself, so `String.split("a,b", ",")`
//# and ``String.split(text, Regex`\s+`)`` are the same function. The thing
//# to look for is called a matcher, not a pattern, because a pattern in Nomi
//# is a destructuring shape.
//#
//# - Each `Matcher` function returns one of these operations with the
//#   matcher first (`is_contained_in`, `is_prefix_of`, `is_suffix_of`,
//#   `split_in`, `replace_in`, `find_all_in`, `find_in`). A type of your own
//#   implements it to become searchable, and a function of your own takes
//#   any matcher as a `Matcher` parameter.
//# - `String.contains` is String's `Contains` impl at the same three types,
//#   chosen by the needle's type, so a `String` also satisfies
//#   `where C: Contains<String>`.
//# - `String.replace` replaces every match. With a `Regex` it expands group
//#   references in the replacement (`$1`, `${name}`, `$$` for a `$`); with any other
//#   matcher the replacement is literal text.
//# - `String.captures` and `String.captures_all` take a `Regex` rather than
//#   any `Matcher`, since only a regex has groups, and return each match's
//#   groups as the regex's capture type
//#   ([capture types](/reference/regex/#capture-types)).
//# - `String.split` and the other `Matcher` search functions are generic, so
//#   a call with a `String` or a `Regex` runs as that type's search directly,
//#   and naming one as a value needs a function type to settle `M`:
//#   `split: (String, String) -> List<String> = String.split`.
//#
//# ## Graphemes
//#
//# `String` implements `Iter<String>`, one grapheme cluster per step, so
//# every `Iter` owner function works on a string. To map or filter
//# graphemes, run the generic adapter and join the result back into a
//# `String`: `Iter.map(s, f) |> String.join()`,
//# `Iter.filter(s, p) |> String.join()`. `String.join` takes any
//# `Iter<String>` (a List, Set or Vector, graphemes, or a lazy chain) and a
//# separator that defaults to `""`. `String.reverse` and `String.length`
//# stay container-specific: native, by grapheme cluster.

/// UTF-8 encoded string.
pub host type String

// String's membership test is `Contains` at three type arguments: a `String`
// occurs as a substring, a `Regex` matches anywhere, and a `Codepoint` occurs
// in the text. Each is a linear search.
impl Contains<String> for String
    /// True if `x` occurs in `c` as a substring. Every string holds `""`.
    //! assert String.contains("hello world", "world")
    //! refute String.contains("hello", "xyz")
    //! assert String.contains("hello", "")
    //
    fn contains(c: String, x: String) -> Bool
        String.is_contained_in(x, c)
    end
end

impl<C> Contains<Regex<C>> for String
    /// True if `x` matches anywhere in `c`.
    //! import std::regex.Regex
    //!
    //! assert String.contains("order 66", Regex`\d+`)
    //! refute String.contains("room", Regex`\d+`)
    //
    fn contains(c: String, x: Regex<C>) -> Bool
        Regex.is_contained_in(x, c)
    end
end

impl Contains<Codepoint> for String
    /// True if `x` occurs in `c`.
    //! assert String.contains("a-b", '-')
    //! refute String.contains("ab", '-')
    //
    fn contains(c: String, x: Codepoint) -> Bool
        Codepoint.is_contained_in(x, c)
    end
end

impl String
    /// True if `prefix` matches at the start of `s`. `prefix` is a `String` or
    /// a `Regex`.
    //! import std::regex.Regex
    //!
    //! assert String.starts_with("hello", "he")
    //! assert String.starts_with("42 apples", Regex`\d+`)
    //! refute String.starts_with("apples 42", Regex`\d+`)
    //
    pub fn starts_with<M>(s: String, prefix: M) -> Bool where M: Matcher
        M.is_prefix_of(prefix, s)
    end

    /// True if `suffix` matches at the end of `s`. `suffix` is a `String` or a
    /// `Regex`.
    //! import std::regex.Regex
    //!
    //! assert String.ends_with("hello.txt", ".txt")
    //! assert String.ends_with("report.PDF", Regex`(?i)\.pdf`)
    //
    pub fn ends_with<M>(s: String, suffix: M) -> Bool where M: Matcher
        M.is_suffix_of(suffix, s)
    end

    /// Upper-cases `s` (Unicode-aware, locale-independent).
    //! assert String.uppercase("café") == "CAFÉ"
    //
    pub host fn uppercase(s: String) -> String

    /// Lower-cases `s` (Unicode-aware, locale-independent).
    //! assert String.lowercase("CAFÉ") == "café"
    //
    pub host fn lowercase(s: String) -> String

    /// Whether `s` is in upper case: it has at least one cased letter, and
    /// every cased letter is upper case, as `Codepoint.is_upper` decides it.
    /// Characters with no case, such as digits and punctuation, count
    /// neither way. This is Python's `str.isupper`.
    //! refute String.is_upper("1, 2, 3")
    //! assert String.is_upper("ÜMLÄÜTS!")
    //! assert String.is_upper("WHAT'S UP?")
    //! refute String.is_upper("Hello")
    //
    pub host fn is_upper(s: String) -> Bool

    /// Whether `s` is in lower case: it has at least one cased letter, and
    /// every cased letter is lower case, as `Codepoint.is_lower` decides it.
    /// Characters with no case count neither way. This is Python's
    /// `str.islower`.
    //! refute String.is_lower("1, 2, 3")
    //! assert String.is_lower("ümläüts!")
    //! assert String.is_lower("what's up?")
    //! refute String.is_lower("Hello")
    //
    pub host fn is_lower(s: String) -> Bool

    /// Capitalizes `s`: its first grapheme in title case and the rest
    /// lowercased, as Python's `str.capitalize` does. Title case is not
    /// upper case for a few letters that stand for two: `ǆ` becomes `ǅ`,
    /// and `ß` becomes `Ss`. It uses Unicode's full case mappings with no
    /// language's rules; `String.capitalize_in` applies a language's.
    //! assert String.capitalize("hello WORLD") == "Hello world"
    //! assert String.capitalize("ǆemal") == "ǅemal"
    //! assert String.capitalize("ÉCOLE") == "École"
    //! assert String.capitalize("") == ""
    //
    pub host fn capitalize(s: String) -> String

    /// Upper-cases `s` as a reader of `locale` writes it, with Unicode's
    /// full case mappings (SpecialCasing) and the rules of the locale's
    /// language. Turkish and Azeri upper-case `i` to `İ`; Lithuanian drops
    /// the dot it keeps above an accented `i`. Every language upper-cases
    /// `ß` to `SS`. `String.uppercase` stays independent of any language.
    //! assert String.uppercase_in("istanbul", Locale"tr") == "İSTANBUL"
    //! assert String.uppercase_in("istanbul", Locale"en") == "ISTANBUL"
    //! assert String.uppercase_in("Straße", Locale"de") == "STRASSE"
    //
    pub host fn uppercase_in(s: String, locale: Locale) -> String

    /// Lower-cases `s` as a reader of `locale` writes it, with Unicode's
    /// full case mappings (SpecialCasing) and the rules of the locale's
    /// language. Turkish and Azeri lower-case `I` to dotless `ı` and `İ` to
    /// `i`; Lithuanian keeps the dot of an `i` under an accent (`Í` is
    /// `i̇́`). In every language a capital sigma that ends a word becomes
    /// `ς`. `String.lowercase` stays independent of any language.
    //! assert String.lowercase_in("DİYARBAKIR", Locale"tr") == "diyarbakır"
    //! assert String.lowercase_in("DIYARBAKIR", Locale"en") == "diyarbakir"
    //! assert String.lowercase_in("ΟΔΟΣ", Locale"el") == "οδος"
    //
    pub host fn lowercase_in(s: String, locale: Locale) -> String

    /// Capitalizes `s` as a reader of `locale` writes it: its first
    /// grapheme in title case and the rest lowercased, with the language's
    /// rules of `String.uppercase_in` and `String.lowercase_in`. In Turkish
    /// and Azeri `i` becomes `İ` and `I` stays `I`. Title case differs from
    /// upper case for the letters that stand for two, as in
    /// `String.capitalize`: `ǆ` becomes `ǅ`, and `ß` becomes `Ss`.
    //! assert String.capitalize_in("istanbul", Locale"tr") == "İstanbul"
    //! assert String.capitalize_in("IRMAK", Locale"tr") == "Irmak"
    //! assert String.capitalize_in("istanbul", Locale"en") == "Istanbul"
    //! assert String.capitalize_in("ßa", Locale"de") == "Ssa"
    //
    pub host fn capitalize_in(s: String, locale: Locale) -> String

    /// Folds case for caseless matching: two strings that differ only in
    /// case fold to the same string, in every language (Unicode's full case
    /// folding). It is for comparing, not for showing: `ß` folds to `ss`.
    /// To sort without regard to case, use a `Collator` of secondary
    /// strength.
    //! assert String.fold_case("Straße") == String.fold_case("STRASSE")
    //! assert String.fold_case("ΣΑΣ") == "σασ"
    //
    pub host fn fold_case(s: String) -> String

    /// `s`'s words in lower case joined by `_`: `user_id` from `userId`.
    /// Words split at `_`, `-` and whitespace, which are dropped (a run of
    /// them is one break, and those at either end are dropped too); where a
    /// lower-case letter or a digit is followed by an upper-case one
    /// (`userId`, `v2Api`); and at the end of an acronym, before the last
    /// of a run of capitals that a lower-case letter follows
    /// (`HTTPServer`). A digit stays with the word before it. Letters are
    /// upper or lower case by Unicode, and nothing is transliterated.
    /// `String.kebab_case`, `String.pascal_case` and `String.camel_case`
    /// split words the same way.
    //! assert String.snake_case("userId") == "user_id"
    //! assert String.snake_case("HTTPServer") == "http_server"
    //! assert String.snake_case("parseHTTP2Request") == "parse_http2_request"
    //! assert String.snake_case("v2Api") == "v2_api"
    //! assert String.snake_case("--Hello   World--") == "hello_world"
    //! assert String.snake_case("ÉcoleNormale") == "école_normale"
    //! assert String.snake_case("") == ""
    //
    pub host fn snake_case(s: String) -> String

    /// `s`'s words in lower case joined by `-`, split as
    /// `String.snake_case` splits them.
    //! assert String.kebab_case("userId") == "user-id"
    //! assert String.kebab_case("HTTP_Server") == "http-server"
    //! assert String.kebab_case("  big  red dog ") == "big-red-dog"
    //
    pub host fn kebab_case(s: String) -> String

    /// `s`'s words joined with nothing between them, each capitalized as
    /// `String.capitalize` does (its first letter in upper (title) case and
    /// the rest in lower case), split as
    /// `String.snake_case` splits them. An acronym is not kept in capitals:
    /// `HTTPServer` becomes `HttpServer`.
    //! assert String.pascal_case("extra_large") == "ExtraLarge"
    //! assert String.pascal_case("in-transit") == "InTransit"
    //! assert String.pascal_case("HTTPServer") == "HttpServer"
    //! assert String.pascal_case("parseHTTP2Request") == "ParseHttp2Request"
    //! assert String.pascal_case("école normale") == "ÉcoleNormale"
    //
    pub host fn pascal_case(s: String) -> String

    /// `String.pascal_case` with the first word in lower case.
    //! assert String.camel_case("user_id") == "userId"
    //! assert String.camel_case("HTTPServer") == "httpServer"
    //! assert String.camel_case("v2 api") == "v2Api"
    //
    pub host fn camel_case(s: String) -> String

    /// Replaces every non-overlapping match of `old` with `new`. `old` is any
    /// `Matcher`. With a `Regex`, `new` expands the match's groups as Go's
    /// `regexp` does: `$1` or `${1}` is group 1, `${name}` a named group, `$0`
    /// the whole match and `$$` a literal `$`; a reference to no group is
    /// empty. With any other matcher, `new` is literal text.
    //! import std::regex.Regex
    //!
    //! assert String.replace("a.b.c", ".", "-") == "a-b-c"
    //! assert String.replace("call 555-0100", Regex`\d`, "#") == "call ###-####"
    //! assert String.replace("ann@home", Regex`(\w+)@(\w+)`, "$2:$1") == "home:ann"
    //! assert String.replace("2026-10", Regex`(?P<y>\d+)-(?P<m>\d+)`, `${m}/${y}`) == "10/2026"
    //! assert String.replace("5 apples", Regex`(\d+)`, "$$$1") == "$5 apples"
    //! assert String.replace("a  b   c", Regex`\s+`, " ") == "a b c"
    //! assert String.replace("pay $1", "$1", "$2") == "pay $2"
    //
    pub fn replace<M>(s: String, old: M, new: String) -> String where M: Matcher
        M.replace_in(old, s, new)
    end

    /// Concatenates `count` copies of `s`. A negative `count` is a runtime error.
    //! assert String.repeat("ab", 3) == "ababab"
    //
    pub host fn repeat(s: String, count: Int) -> String

    /// Reverses `s` by grapheme cluster, so multi-code-point clusters (combining
    /// marks, ZWJ emoji) stay intact.
    //! assert String.reverse("abc") == "cba"
    //
    pub host fn reverse(s: String) -> String

    /// Returns `s` in the given Unicode normalization form.
    //! assert String.normalize("é", NormalForm.NFC) == "é"
    //! assert String.normalize("é", NormalForm.NFD) == "é"
    //
    pub host fn normalize(s: String, form: NormalForm) -> String

    /// Returns a substring from start index to end index (grapheme-based,
    /// start inclusive, end exclusive).
    //! assert String.slice("hello", 1, 4) == "ell"
    //
    pub host fn slice(s: String, start: Int, stop: Int) -> String

    /// The first `n` grapheme clusters of `s`, counted as `String.slice` and
    /// `String.length` count them. An `n` past the end gives the whole
    /// string, and an `n` of zero or less gives "". `String.drop` gives the
    /// rest, so `String.take(s, n) + String.drop(s, n) == s`.
    //! assert String.take("hello", 2) == "he"
    //! assert String.take("héllo", 2) == "hé"
    //! assert String.take("hi", 5) == "hi"
    //! assert String.take("hi", -1) == ""
    //
    pub fn take(s: String, n: Int) -> String
        slice(s, 0, n)
    end

    /// `s` after its first `n` grapheme clusters, counted as `String.slice`
    /// and `String.length` count them. An `n` past the end gives "", and an
    /// `n` of zero or less gives the whole string. `String.take` gives the
    /// clusters this drops.
    //! assert String.drop("hello", 2) == "llo"
    //! assert String.drop("héllo", 2) == "llo"
    //! assert String.drop("hi", 5) == ""
    //! assert String.drop("hi", -1) == "hi"
    //
    pub fn drop(s: String, n: Int) -> String
        if n <= 0 then s else slice(s, n, length(s))
    end

    /// Prepends copies of `fill` until `s` is `width` grapheme clusters long,
    /// the units `String.length` counts. A multi-character `fill` repeats and
    /// is cut to fit exactly. A string already `width` long or longer comes
    /// back unchanged, never truncated, and so does any `s` when `fill` is
    /// empty or `width` is zero or negative. The "é" below is "e" followed by
    /// U+0301 COMBINING ACUTE ACCENT: two code points, one grapheme cluster.
    //! assert String.pad_start("5", 3) == "  5"
    //! assert String.pad_start("5", 3, "0") == "005"
    //! assert String.pad_start("5", 4, "ab") == "aba5"
    //! assert String.pad_start("é", 3) == "  é"
    //! assert String.pad_start("👋🏽", 2, "-") == "-👋🏽"
    //! assert String.pad_start("hello", 3) == "hello"
    //! assert String.pad_start("hi", 0) == "hi"
    //! assert String.pad_start("hi", -4) == "hi"
    //! assert String.pad_start("hi", 5, "") == "hi"
    //!
    //! // Right-align a column of amounts.
    //! assert String.pad_start("9.50", 7) == "   9.50"
    //! assert String.pad_start("120.00", 7) == " 120.00"
    //
    pub fn pad_start(s: String, width: Int, fill: String = " ") -> String
        padding(fill, width - length(s)) + s
    end

    /// Appends copies of `fill` until `s` is `width` grapheme clusters long,
    /// the units `String.length` counts. A multi-character `fill` repeats and
    /// is cut to fit exactly. A string already `width` long or longer comes
    /// back unchanged, never truncated, and so does any `s` when `fill` is
    /// empty or `width` is zero or negative. The "é" in "café" below is "e"
    /// followed by U+0301 COMBINING ACUTE ACCENT, one grapheme cluster.
    //! assert String.pad_end("ab", 4) == "ab  "
    //! assert String.pad_end("5", 4, "ab") == "5aba"
    //! assert String.pad_end("café", 6, ".") == "café.."
    //! assert String.pad_end("👋🏽", 3, "*") == "👋🏽**"
    //! assert String.pad_end("hello", 2) == "hello"
    //! assert String.pad_end("hi", -1, "*") == "hi"
    //! assert String.pad_end("hi", 5, "") == "hi"
    //!
    //! // A table row: the name left-aligned, the count right-aligned.
    //! row = String.pad_end("fig", 8) + String.pad_start("12", 4)
    //! assert row == "fig       12"
    //! assert String.length(row) == 12
    //
    pub fn pad_end(s: String, width: Int, fill: String = " ") -> String
        s + padding(fill, width - length(s))
    end

    /// Joins the strings of any `Iter<String>` (a List, Set or Vector, a
    /// String's graphemes, or a lazy adapter chain) with `separator` between
    /// each element and nowhere else. The source is driven once, with no
    /// intermediate List. The separator defaults to "", so
    /// `String.join(parts)` concatenates.
    //! assert String.join(["a", "b", "c"], ", ") == "a, b, c"
    //! assert String.join([], ", ") == ""
    //! assert String.join(["he", "llo"]) == "hello"
    //! assert "héllo" |> Iter.map(String.uppercase) |> String.join() == "HÉLLO"
    //! assert 1..=3 |> Iter.map(Int.to_string) |> String.join("-") == "1-2-3"
    //! assert Vector["x", "y"] |> String.join("+") == "x+y"
    //! assert Set["solo"] |> String.join(", ") == "solo"
    //
    pub host fn join(parts: Iter<String>, separator: String = "") -> String

    /// Joins `items` into one phrase as a reader of `locale` lists things,
    /// with CLDR's list patterns: `style` says what the list means (`And`,
    /// `Or`, or `Unit` for the parts of one measure, such as "3 feet, 2
    /// inches") and `width` picks the pattern's wide, short or narrow words.
    /// The last two items join by the pattern's end form, each earlier one
    /// by its middle form and the first by its start form, so `en` writes
    /// `a, b, and c` and `a and b`. Materialize an `Iter` with
    /// `Iter.to_list()` first.
    //! assert String.join_list(["a", "b", "c"], Locale"en") == "a, b, and c"
    //! assert String.join_list(["a", "b"], Locale"en") == "a and b"
    //!
    //! assert [1000, 2000]
    //! |> Iter.map(&Int.format(&1, Locale"de"))
    //! |> Iter.to_list()
    //! |> String.join_list(Locale"de") == "1.000 und 2.000"
    //!
    //! assert String.join_list(["a", "b", "c"], Locale"en-GB") == "a, b and c"
    //! assert String.join_list(["a", "b"], Locale"en", ListStyle.Or) == "a or b"
    //! assert String.join_list(["a", "b", "c"], Locale"en", ListStyle.And, ListWidth.Short) == "a, b, & c"
    //! assert String.join_list(["a", "b", "c"], Locale"pl") == "a, b i c"
    //! assert String.join_list(["a", "b", "c"], Locale"ja") == "a、b、c"
    //!
    //! assert String.join_list(["3 quarters", "1 dime"], Locale"en", ListStyle.Unit)
    //!     == "3 quarters, 1 dime"
    //!
    //! items: List<String> = []
    //! assert String.join_list(items, Locale"en") == ""
    //
    pub fn join_list(
        items:  List<String>,
        locale: Locale,
        style:  ListStyle = ListStyle.And,
        width:  ListWidth = ListWidth.Wide,
    ) -> String
        style_tag = case style
            ListStyle.And  -> 1
            ListStyle.Or   -> 2
            ListStyle.Unit -> 3
        end

        width_tag = case width
            ListWidth.Wide   -> 1
            ListWidth.Short  -> 2
            ListWidth.Narrow -> 3
        end

        join_list_raw(locale, items, style_tag, width_tag)
    end

    /// Splits a string into a list of substrings on every non-overlapping
    /// match of `separator`, a `String` or a `Regex`. The separator itself is
    /// consumed and never appears in the output. Adjacent matches produce
    /// empty-string entries. An empty string `separator` splits at every UTF-8
    /// codepoint boundary (one entry per codepoint). Inverse of `String.join`.
    //! import std::regex.Regex
    //!
    //! assert String.split("a,b,c", ",") == ["a", "b", "c"]
    //! assert String.split("a, b, c", ", ") == ["a", "b", "c"]
    //! assert String.split(",a,", ",") == ["", "a", ""]
    //! assert String.split("hello", "") == ["h", "e", "l", "l", "o"]
    //! assert String.split("a, b,c", Regex`,\s*`) == ["a", "b", "c"]
    //! assert "one  two\tthree" |> String.split(Regex`\s+`) == ["one", "two", "three"]
    //!
    //! // Named as a value, a generic search function needs its type.
    //! split: (String, String) -> List<String> = String.split
    //! assert split("a,b", ",") == ["a", "b"]
    //
    pub fn split<M>(s: String, separator: M) -> List<String> where M: Matcher
        M.split_in(separator, s)
    end

    /// Every non-overlapping match of `needle` in `s`, left to right. With a
    /// `String` needle each match is the needle itself, so the list's length is
    /// the number of occurrences.
    //! import std::regex.Regex
    //!
    //! assert String.find_all("order 66, aisle 7", Regex`\d+`) == ["66", "7"]
    //! assert String.find_all("banana", "an") == ["an", "an"]
    //! assert String.find_all("banana", "x") == []
    //
    pub fn find_all<M>(s: String, needle: M) -> List<String> where M: Matcher
        M.find_all_in(needle, s)
    end

    /// The first match of `needle` in `s`, the leftmost, or `None` when there is
    /// none. It is the first element `find_all` would return. With a `String`
    /// needle the match is the needle itself, and an empty needle matches at the
    /// start of any text; an empty regex match is `Some("")`.
    //! import std::regex.Regex
    //!
    //! assert String.find("order 66, aisle 7", Regex`\d+`) == Some("66")
    //! assert String.find("banana", "an") == Some("an")
    //! assert String.find("banana", "x") == None
    //! assert String.find("none", Regex`\d+`) == None
    //
    pub fn find<M>(s: String, needle: M) -> Maybe<String> where M: Matcher
        M.find_in(needle, s)
    end

    /// The capture groups of the first match of `re` in `s`, the leftmost, or
    /// `None` when there is none, as the `C` of `re`'s type `Regex<C>`
    /// shapes them. The groups are the pattern's from group 1, in the order
    /// it opens them: the whole match is not one, and `String.find` gives
    /// it. A `Regex` literal's `C` has one part per group, `String` for a
    /// group every match fills and `Maybe<String>` for one a match can leave
    /// out, such as either side of `(a)|(b)`: a tuple of them, an anonymous
    /// struct when every group is named, the one part alone for a single
    /// unnamed group, and `Unit` when there is none. A regex compiled while
    /// the program runs is a `Regex<List<Maybe<String>>>`, whose groups are
    /// a list.
    //! import std::regex.Regex
    //!
    //! assert String.captures("ann@home", Regex`(\w+)@(\w+)`) == Some(("ann", "home"))
    //! assert String.captures("b", Regex"(a)|(b)") == Some((None, Some("b")))
    //! assert String.captures("v12", Regex`v(\d+)`) == Some("12")
    //! date = Regex`(?P<year>\d{4})-(?P<month>\d\d)?`
    //! assert String.captures("2024-", date) == Some({year: "2024", month: None})
    //! assert String.captures("no address", Regex`(\w+)@(\w+)`) == None
    //! assert String.captures("a1", Regex.compile("(\\w)(\\d)")?) == Some([Some("a"), Some("1")])
    //
    pub fn captures<C>(s: String, re: Regex<C>) -> Maybe<C>
        case capture_groups(s, re)
            Some(groups) -> Some(capture_shape(re, groups))
            None         -> None
        end
    end

    /// The capture groups of every non-overlapping match of `re` in `s`, left
    /// to right, each as `String.captures` gives them; `[]` when nothing
    /// matches. The matches are the ones `String.find_all` returns.
    //! import std::regex.Regex
    //!
    //! pairs = String.captures_all("a=1, b=22", Regex`(\w)=(\d+)`)
    //! assert pairs == [("a", "1"), ("b", "22")]
    //! assert String.captures_all("none", Regex`(\d)`) == []
    //
    pub fn captures_all<C>(s: String, re: Regex<C>) -> List<C>
        capture_groups_all(s, re)
        |> Iter.map(fn groups -> capture_shape(re, groups))
        |> Iter.to_list()
    end

    /// The words of `s`: the pieces between runs of Unicode whitespace, which
    /// includes U+00A0 NO-BREAK SPACE and U+3000. Unlike `split`, leading,
    /// trailing and repeated whitespace never produce empty strings.
    //! assert String.words("  1   2\t3 \n") == ["1", "2", "3"]
    //! assert String.words("") == []
    //! assert String.words("   ") == []
    //! assert String.words("café 🙂ok") == ["café", "🙂ok"]
    //! assert String.words("a\u{a0}b\u{3000}c") == ["a", "b", "c"]
    //
    pub host fn words(s: String) -> List<String>

    /// The lines of `s`, split on `\n` or `\r\n` with the terminator removed.
    /// Unlike `split(s, "\n")`, a final terminator does not add an empty last
    /// line; a lone `\r` is not a terminator.
    //! assert String.lines("a\nb\r\nc\n") == ["a", "b", "c"]
    //! assert String.lines("a\n\nb") == ["a", "", "b"]
    //! assert String.lines("") == []
    //! assert String.lines("\n") == [""]
    //! assert String.lines("a\rb") == ["a\rb"]
    //! assert String.lines("é\n🙂") == ["é", "🙂"]
    //
    pub host fn lines(s: String) -> List<String>

    /// Returns `s` with leading and trailing whitespace removed (spaces,
    /// tabs, newlines, carriage returns — Go's `strings.TrimSpace` rules).
    /// Inner whitespace is preserved.
    //! assert String.trim("  hello  ") == "hello"
    //! assert String.trim("\n\tworld\n") == "world"
    //! assert String.trim("a  b") == "a  b"
    //
    pub host fn trim(s: String) -> String

    /// Parses `s` as a base-10 signed integer. Returns Some(n) on success,
    /// None on any failure (non-digit characters, empty string, out-of-range
    /// value). Leading/trailing whitespace is tolerated.
    //! assert String.to_int("42") == Some(42)
    //! assert String.to_int("-7") == Some(-7)
    //! assert String.to_int("  3  ") == Some(3)
    //! assert String.to_int("abc") == None
    //! assert String.to_int("") == None
    //
    pub host fn to_int(s: String) -> Maybe<Int>

    /// Parses `s` as a base-10 Float, the same in every locale: an optional
    /// sign, digits, an optional `.` with digits on both sides, and an
    /// optional exponent (`e` or `E`, an optional sign, digits).
    /// Surrounding whitespace is tolerated, as `String.to_int` tolerates it.
    /// Returns None for anything else: empty text, `_` separators, hex,
    /// `.5` or `5.`, the words `Inf` and `NaN`, and a value too large for a
    /// Float. The result is the Float nearest the text. To read what a
    /// reader of some locale wrote (`1.234,5`), use `Float.parse_in`.
    //! assert String.to_float("19.99") == Some(19.99)
    //! assert String.to_float("-2.5e3") == Some(-2500.0)
    //! assert String.to_float(" 7 ") == Some(7.0)
    //! assert String.to_float("1,5") == None
    //! assert String.to_float(".5") == None
    //! assert String.to_float("1e400") == None
    //
    pub host fn to_float(s: String) -> Maybe<Float>

    /// Parses `s` as a plain base-10 Decimal. It accepts an optional sign,
    /// `_` digit separators and one fractional part, and the number of
    /// digits after the `.` becomes the scale (`"1.50"` is scale 2).
    /// Exponent notation is not accepted. Returns None for empty or
    /// malformed input.
    //! assert String.to_decimal("1.50") == Some(1.50d)
    //! assert String.to_decimal("1_000") == Some(1000d)
    //! assert String.to_decimal("oops") == None
    //
    pub host fn to_decimal(s: String) -> Maybe<Decimal>

    /// Returns the raw bytes of the string (UTF-8 encoded).
    //! assert String.to_bytes("ab")
    //! |> Bytes.to_list()
    //! |> Iter.map(Byte.to_int)
    //! |> Iter.to_list() == [97, 98]
    //
    pub host fn to_bytes(s: String) -> Bytes

    /// Returns the Unicode codepoints of the string as scalar values.
    //! assert "ab"
    //!     |> String.to_codepoints()
    //!     |> Iter.map(Codepoint.to_int)
    //!     |> Iter.to_list()
    //!     |> List.equal([97, 98])
    //
    pub host fn to_codepoints(s: String) -> List<Codepoint>

    /// The string of the codepoints in `cps`, in order: the inverse of
    /// `String.to_codepoints`. It takes a List, as `to_codepoints` gives
    /// one; end a lazy chain of codepoints with `Iter.to_list()`.
    //! assert String.from_codepoints(['h', 'i']) == "hi"
    //! assert String.from_codepoints([]) == ""
    //! assert "héllo" |> String.to_codepoints() |> String.from_codepoints() == "héllo"
    //!
    //! shifted =
    //!     "abc"
    //!     |> String.to_codepoints()
    //!     |> Iter.map(&Int.to_codepoint(Codepoint.to_int(&1) + 1))
    //!     |> Maybe.values()
    //!     |> Iter.to_list()
    //!     |> String.from_codepoints()
    //!
    //! assert shifted == "bcd"
    //
    pub fn from_codepoints(cps: List<Codepoint>) -> String
        cps
        |> Iter.map(&Codepoint.to_string(&1))
        |> join()
    end

    /// `s` as a Nomi string literal that reads back as `s`: quoted, with
    /// `\n`, `\r`, `\t`, `\\` and `\"` escaped, `\u{...}` for any other
    /// character that is not printable (NUL is `\u{0}`, a no-break space
    /// `\u{a0}`), and `${` written `\${`, so nothing in it
    /// interpolates. Letters, combining marks and emoji are written as they
    /// are. So are the invisible characters that are part of something
    /// visible: an emoji's zero-width joiners, variation selectors and tags
    /// (`"👩‍💻"`), and a zero-width joiner or non-joiner between two
    /// non-ASCII letters or marks, as in a Devanagari conjunct or a
    /// Persian word. One anywhere else (`a\u{200d}b`, at either end, beside
    /// a space) is escaped. What a program that writes Nomi source, such as
    /// a code generator, writes a string with, and a String's `Debug`.
    ///
    /// In detail:
    ///
    /// - A newline, tab or other control character shows as its escape
    ///   rather than raw: `dbg "a\nb"` prints `"a\nb"` on one line. A
    ///   carriage return is `\r`, and NUL is `\u{0}`, since Nomi has no `\0`
    ///   escape.
    /// - A `$` or `{` alone, non-ASCII letters, combining marks and emoji are
    ///   written as they are, an emoji's zero-width joiners, variation
    ///   selectors and tags included (`"👩‍💻"`, not `"👩\u{200d}💻"`).
    /// - A zero-width joiner or non-joiner between two non-ASCII letters or
    ///   combining marks is part of the word and is written as it is too: a
    ///   Devanagari conjunct (`"क्‍ष"`, a joiner after a virama) or a Persian
    ///   word (`"می‌خواهم"`).
    /// - Any other zero-width joiner, non-joiner or variation selector
    ///   (`"a\u{200d}b"`, one at either end of the string, beside a space or
    ///   punctuation, or doubled), and a no-break space (`\u{a0}`,
    ///   `\u{202f}`), are escaped, so an invisible character stays visible.
    ///
    /// `nomi fmt` writes string literals by the same rule. The same literal
    /// is what a String reads as inside a container's Debug, an assertion's
    /// `values:` row and the debugger's variable view.
    //! assert String.to_literal("a\tb") == "\"a\\tb\""
    //! assert String.to_literal("say \"hi\"") == "\"say \\\"hi\\\"\""
    //! assert String.to_literal("\${x} costs $5") == "\"\\\${x} costs $5\""
    //! assert String.to_literal("\r") == "\"\\r\""
    //! assert String.to_literal("a\u{0}b") == "\"a\\u{0}b\""
    //! assert String.to_literal("a\u{200d}b") == "\"a\\u{200d}b\""
    //! assert String.to_literal("x\u{202f}y") == "\"x\\u{202f}y\""
    //! assert String.to_literal("$5 {x}") == "\"$5 {x}\""
    //
    pub host fn to_literal(s: String) -> String

    /// A typed literal with prefix `tag` and fixed text `s`, as a program
    /// writes it: in double quotes when `s` needs no escape there, in
    /// backticks when it does and holds no backtick or line break, and
    /// otherwise as `String.to_literal` quotes it (style rule 21). A type's
    /// `Debug` shows its value this way.
    //! assert String.to_typed_literal("EUR", "Currency") == "Currency\"EUR\""
    //! assert String.to_typed_literal("\\d+", "Regex") == "Regex`\\d+`"
    //! assert String.to_typed_literal("say \"hi\"", "Regex") == "Regex`say \"hi\"`"
    //! assert String.to_typed_literal("a`b\\d", "Regex") == "Regex\"a`b\\\\d\""
    //
    pub fn to_typed_literal(s: String, tag: String) -> String
        quoted = to_literal(s)

        if quoted == "\"${s}\"" or String.contains(s, "`") or String.contains(s, "\n") then
            tag + quoted
        else
            "${tag}`${s}`"
        end
    end

    /// Strips a prefix from the string. Returns Some(rest) if the prefix matches,
    /// or None otherwise.
    //! assert String.strip_prefix("hello world", "hello ") == Some("world")
    //! assert String.strip_prefix("hello", "xyz") == None
    //
    pub fn strip_prefix(s: String, prefix: String) -> Maybe<String>
        if starts_with(s, prefix) then
            new_start = length(prefix)

            slice(s, new_start, length(s)) |> Some()
        else
            None
        end
    end

    /// Strips a suffix from the string. Returns Some(rest) if the suffix matches,
    /// or None otherwise.
    //! assert String.strip_suffix("hello.txt", ".txt") == Some("hello")
    //! assert String.strip_suffix("hello", "xyz") == None
    //
    pub fn strip_suffix(s: String, suffix: String) -> Maybe<String>
        if ends_with(s, suffix) then
            new_end = length(s) - length(suffix)

            slice(s, 0, new_end) |> Some()
        else
            None
        end
    end

    /// Number of grapheme clusters in the string. Scans the text without
    /// materializing clusters. Grapheme-based, not byte-based:
    /// `String.length("héllo")` is 5. (`String` keeps its own `length` because the
    /// generic count, `Iter.count`, is the fold; this is the fast path.)
    //! assert String.length("héllo") == 5
    //! assert String.length("") == 0
    //
    pub host fn length(s: String) -> Int
end

/// What a list `String.join_list` writes means: CLDR's list pattern types.
pub enum ListStyle
    /// All of the items: "a, b, and c".
    And
    /// One of the items: "a, b, or c".
    Or
    /// The parts of one measure: "3 feet, 2 inches".
    Unit
end

derive Equatable for ListStyle

/// How short the words `String.join_list` writes between items are. English
/// writes "and" wide and "&" short; many locales write the same at every
/// width.
pub enum ListWidth
    Wide
    Short
    Narrow
end

derive Equatable for ListWidth

/// Joins items with the list pattern of a style and width (1-based, in
/// `ListStyle` and `ListWidth` order) for a locale tag. Private helper
/// behind `String.join_list`.
host fn join_list_raw(locale: Locale, items: List<String>, style: Int, width: Int) -> String

// The capture groups of re's leftmost match in s, group 1 onward, each
// `Some` of its text or `None` when it took no part; `None` when nothing
// matches. Behind `String.captures`, which shapes them.
host fn capture_groups<C>(s: String, re: Regex<C>) -> Maybe<List<Maybe<String>>>

// capture_groups for every non-overlapping match, left to right.
host fn capture_groups_all<C>(s: String, re: Regex<C>) -> List<List<Maybe<String>>>

// The C value of a match whose groups are groups: the tuple, struct, text,
// Unit or list the checker gave re's type (analysis/regex_literal.go). A VM
// intrinsic built by C alone (irbuild's captureShapeCall), since C is
// phantom in the handle.
host fn capture_shape<C>(re: Regex<C>, groups: List<Maybe<String>>) -> C

/// Byte-lexicographic comparison of UTF-8 bytes. Returns -1 if `a < b`,
/// 1 if `a > b`, 0 if equal. Private helper backing the `Comparable` impl.
host fn string_compare(a: String, b: String) -> Int

/// `count` grapheme clusters of `fill` repeated, cut to fit; "" when `count`
/// is not positive or `fill` is empty. Private helper behind
/// `String.pad_start` and `String.pad_end`.
fn padding(fill: String, count: Int) -> String
    fill_length = String.length(fill)

    if count <= 0 or fill_length == 0 then
        ""
    else
        String.repeat(fill, count / fill_length + 1) |> String.slice(0, count)
    end
end

impl Matcher for String
    /// True if `needle` occurs in `text`.
    host fn is_contained_in(needle: String, text: String) -> Bool

    /// True if `text` begins with `prefix`.
    host fn is_prefix_of(prefix: String, text: String) -> Bool

    /// True if `text` ends with `suffix`.
    host fn is_suffix_of(suffix: String, text: String) -> Bool

    /// Splits on every occurrence; an empty separator splits at every
    /// codepoint.
    host fn split_in(separator: String, text: String) -> List<String>

    /// Replaces every non-overlapping occurrence.
    host fn replace_in(old: String, text: String, replacement: String) -> String

    /// One copy of `needle` per non-overlapping occurrence.
    host fn find_all_in(needle: String, text: String) -> List<String>

    /// `needle` itself when it occurs in `text`.
    fn find_in(needle: String, text: String) -> Maybe<String>
        if String.is_contained_in(needle, text) then Some(needle) else None
    end
end

impl Matcher for Codepoint
    // A codepoint matches its own one-codepoint text, so each search is the
    // String matcher's over `Codepoint.to_string(cp)`. Declared here rather
    // than in std/code_points so the String host functions are this module's.
    //! e_acute = Int.to_codepoint(0xE9)?
    //! assert String.contains("café", e_acute)
    //! refute String.contains("cafe", e_acute)
    //! assert String.split("a,b", ',') == ["a", "b"]
    //! assert String.starts_with("#tag", '#')
    //! assert String.ends_with("done.", '.')
    //! assert String.replace("a-b-c", '-', "+") == "a+b+c"
    //! assert String.find("x=1", '=') == Some("=")
    //! assert String.find_all("a,b,c", ',') == [",", ","]
    //
    fn is_contained_in(cp: Codepoint, text: String) -> Bool
        String.is_contained_in(Codepoint.to_string(cp), text)
    end

    fn is_prefix_of(cp: Codepoint, text: String) -> Bool
        String.is_prefix_of(Codepoint.to_string(cp), text)
    end

    fn is_suffix_of(cp: Codepoint, text: String) -> Bool
        String.is_suffix_of(Codepoint.to_string(cp), text)
    end

    fn split_in(cp: Codepoint, text: String) -> List<String>
        String.split_in(Codepoint.to_string(cp), text)
    end

    fn replace_in(cp: Codepoint, text: String, replacement: String) -> String
        String.replace_in(Codepoint.to_string(cp), text, replacement)
    end

    fn find_all_in(cp: Codepoint, text: String) -> List<String>
        String.find_all_in(Codepoint.to_string(cp), text)
    end

    fn find_in(cp: Codepoint, text: String) -> Maybe<String>
        String.find_in(Codepoint.to_string(cp), text)
    end
end

impl Iter for String
    /// A String iterates by grapheme cluster, one per user-visible character:
    /// `Iter.to_list("héllo")` is `["h", "é", "l", "l", "o"]`. Pushes each
    /// cluster to `yield`, stopping when it returns False.
    host fn each_while(s: String, yield: (String) -> Bool) -> Bool
end

impl Display for String
    /// The raw text, with no quotes, so `"hello ${name}"` does not
    /// double-quote `name`. `Debug` gives the round-trippable literal
    /// instead (`String.to_literal`), so `io.inspect("a\"b")` reveals the
    /// escape. String is the one primitive where the two differ.
    //! assert Display.to_string("a\"b") == "a\"b"
    //! assert Debug.inspect("a\"b") == "\"a\\\"b\""
    //
    fn to_string(s: String) -> String
        s
    end
end

impl Add<String, String> for String
    host fn add(lhs: String, rhs: String) -> String
end

impl Summable for String
    /// The sum of no Strings: `""`. Summing Strings concatenates them in
    /// order; to put a separator between them, use `String.join`.
    //! assert String.empty_sum() == ""
    //! assert "ab" + String.empty_sum() == "ab"
    //! assert Iter.sum(["no", "m", "i"]) == "nomi"
    //
    fn empty_sum() -> String
        ""
    end
end

impl Debug for String
    /// The string as a Nomi literal that reads back as it:
    /// `String.to_literal`.
    //! assert String.inspect("a\nb\tc") == "\"a\\nb\\tc\""
    //! assert Debug.inspect(["x\ny"]) == "[\"x\\ny\"]"
    //
    fn inspect(s: String) -> String
        String.to_literal(s)
    end
end

impl Equatable for String
    fn equal(a: String, b: String) -> Bool
        a == b
    end
end

impl Hashable for String
    /// FNV-1a 64-bit hash of the UTF-8 bytes, reinterpreted as an Int. Stable
    /// within one runtime process; not cryptographic, not stable across runs.
    host fn hash(s: String) -> Int
end

impl Comparable for String
    fn compare(a: String, b: String) -> Ordering
        n = string_compare(a, b)

        case
            n < 0 -> Less
            n > 0 -> Greater
            _     -> Equal
        end
    end
end

/// Unicode normalization forms (UAX #15). Equality and hashing are byte-based,
/// so two visually identical strings in different forms — a precomposed "é"
/// (U+00E9) vs a decomposed "e" + U+0301 — are *not* `==`. Normalize to a
/// common form first when comparing text from mixed sources.
pub enum NormalForm
    NFC
    NFD
    NFKC
    NFKD
end

derive Display for NormalForm
