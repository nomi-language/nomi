//# The Go-backed half of std::key_exchange: elliptic-curve Diffie-Hellman
//# over Go's crypto/ecdh (internal/stdcipher). A curve is 0 for X25519, 1
//# for P-256, 2 for P-384 and 3 for P-521. A private key crosses as its
//# scalar and a public key in its curve's standard encoding. It is
//# internal; a program imports std::key_exchange.

import
    bool.Bool
    bytes.Bytes
    int.Int64
    option.Option
end

/// A new private key on `curve`.
pub host fn generate(curve: Int64) -> Bytes

/// Whether `data` is a private key on `curve`.
pub host fn private_is_valid(curve: Int64, data: Bytes) -> Bool

/// Whether `data` is a public key on `curve`.
pub host fn public_is_valid(curve: Int64, data: Bytes) -> Bool

/// The public key of the private key `private` on `curve`.
pub host fn public_of(curve: Int64, private: Bytes) -> Bytes

/// The shared secret of `private` and `public` on `curve`, or `None` when
/// the exchange gives none: an X25519 public key of low order.
pub host fn shared_secret(curve: Int64, private: Bytes, public: Bytes) -> Option<Bytes>
