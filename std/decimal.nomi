import
    add.Add
    bool.Bool.{self, False, True}
    comparable.{Comparable, Ordering}
    debug.Debug
    display.Display
    divide.Divide
    equatable.Equatable
    float.Float
    hashable.Hashable
    int.{Int, NonNegativeInt, PositiveInt}
    iter.Iter
    lists.List
    locale.Locale
    localize.NumberParseError
    maybe.Maybe.{self, None, Some}
    multiply.Multiply
    productable.Productable
    ranges.{ClosedRange, Range}
    remainder.Remainder
    results.Result.{self, Err, Ok}
    steppable.Steppable
    strings.String
    subtract.Subtract
    summable.Summable
end

//# Operations on the arbitrary-precision, exact base-10 `Decimal` type:
//# conversions to/from `Int`/`Float`/`String`, explicit-rounding division and
//# quantization (every rounding op names a `RoundingMode`), sign/scale/abs
//# helpers, and the value-based (scale-insensitive) arithmetic/`Equatable`/`Comparable`/
//# `Hashable` impls. `+ - *` and `Decimal.pow` are exact. `/` rounds a
//# quotient that does not end to 34 significant digits, half-even, and keeps
//# one that ends exact, with no trailing zeros (`10.00d / 4d` is `2.5d`).
//# `Decimal.divide` rounds to a scale and mode you name, `Decimal.divide_exact`
//# returns `None` for a quotient that does not end, and `Decimal.sqrt` and
//# `Decimal.round` round as `Decimal.divide` does; `Decimal.round_exact` and
//# `Decimal.sqrt_exact` return `None` instead of rounding. `Decimal.split` and
//# `Decimal.allocate` divide an amount into parts that sum to it exactly.
//#
//# `Decimal.format` and `Decimal.format_percent` write a decimal as a reader
//# of a locale writes it, and `Decimal.parse_in` and
//# `Decimal.parse_percent_in` read it back, by the rules std::int's page gives
//# for [formatting](/reference/int/#formatting-numbers-for-a-reader) and
//# [parsing](/reference/int/#parsing-numbers-a-reader-wrote) numbers.

/// Arbitrary-precision exact base-10 number. The third blessed numeric type
/// alongside `Int` and `Float`: `+ - *` are always exact, `/` rounds to 34
/// significant digits, and there is no implicit conversion to/from `Int` or
/// `Float`. Literals carry
/// a `d` suffix (`1.50d`); scale is significant for display (`1.50d` prints
/// "1.50") but equality is scale-insensitive (`1.50d == 1.5d`).
pub host type Decimal

impl Decimal
    /// Converts a Decimal to an Int by truncating toward zero. Exact at any
    /// size, since an Int holds a whole number of any size. Use
    /// `Decimal.round` first if a different rounding rule is needed.
    //! assert Decimal.to_int(3.7d) == 3
    //! assert Decimal.to_int(-3.7d) == -3
    //! assert Decimal.to_int(123_456_789_012_345_678_901.9d) == 123_456_789_012_345_678_901
    //
    pub host fn to_int(d: Decimal) -> Int

    /// Converts a Decimal to a Float. Total and lossy-by-nature (Float is binary64,
    /// so most base-10 fractions are not exactly representable). Magnitudes beyond
    /// Float's range become ±Infinity. Explicit by design — there is no implicit
    /// Decimal→Float coercion.
    //! assert Decimal.to_float(1.50d) == 1.5
    //
    pub host fn to_float(d: Decimal) -> Float

    /// Divides `a` by `b` to exactly `scale` fractional digits, rounding the
    /// quotient with `mode`. It always returns a value at the named scale.
    /// Use it when the answer's places are fixed, as cents are; `a / b`
    /// keeps 34 significant digits instead, and `divide_exact` never rounds.
    /// `b` is a `NonZeroDecimal`, so `Decimal.divide(a, 0d, 2, mode)` is a
    /// compile error and a computed `b` goes through `NonZeroDecimal.try_from`.
    /// Runtime error for a `scale` past Decimal's, -2147483648 to 2147483647.
    //! assert Decimal.divide(10d, 3d, 2, RoundingMode.HalfEven) == 3.33d
    //! assert Decimal.divide(10.00d, 4d, 2, RoundingMode.Down) == 2.50d
    //
    pub host fn divide(a: Decimal, b: NonZeroDecimal, scale: Int, mode: RoundingMode) -> Decimal

    /// Divides `a` by `b` exactly: `Some` of the quotient when it terminates in
    /// base 10, `None` when it does not (`10d` by `3d`). A quotient's scale is
    /// `a`'s scale less `b`'s, or more when the quotient needs more digits
    /// (`1d` by `8d` is `0.125d`), and never below zero. `b` is a
    /// `NonZeroDecimal`, as `Decimal.divide`'s is, so it never traps.
    //! assert Decimal.divide_exact(10.00d, 4d) == Some(2.50d)
    //! assert Decimal.divide_exact(10.00d, 4d) |> Maybe.map(Decimal.to_string) == Some("2.50")
    //! assert Decimal.divide_exact(1d, 8d) == Some(0.125d)
    //! assert Decimal.divide_exact(10d, 3d) == None
    //
    pub host fn divide_exact(a: Decimal, b: NonZeroDecimal) -> Maybe<Decimal>

    /// Quantizes `d` to exactly `scale` fractional digits using `mode`. Increasing
    /// the scale pads trailing zeros (always exact); decreasing it rounds. A
    /// negative scale rounds to tens/hundreds/… `round_exact` is the form that
    /// refuses to round. A `scale` past Decimal's, -2147483648 to 2147483647,
    /// is a runtime error.
    //! assert Decimal.round(3.14159d, 2, RoundingMode.HalfEven) == 3.14d
    //! assert Decimal.round(2.5d, 0, RoundingMode.HalfEven) == 2d
    //! assert Decimal.round(1d, 2, RoundingMode.Up) == 1.00d
    //
    pub host fn round(d: Decimal, scale: Int, mode: RoundingMode) -> Decimal

    /// `d` at exactly `scale` fractional digits when that loses no digit:
    /// `Some` of it, and `None` when reaching `scale` would round. Increasing
    /// the scale pads trailing zeros, so it is always `Some`. Write `!` after
    /// it where the digits are known to fit.
    //! assert Decimal.round_exact(1.50d, 1) == Some(1.5d)
    //! assert Decimal.round_exact(1.5d, 3) |> Maybe.map(Decimal.to_string) == Some("1.500")
    //! assert Decimal.round_exact(1.55d, 1) == None
    //
    pub host fn round_exact(d: Decimal, scale: Int) -> Maybe<Decimal>

    /// `d` multiplied by itself `exp` times, exactly, as `*` multiplies: the
    /// scale is `exp` times `d`'s, so `1.5d` squared is `2.25d` and `1.50d`
    /// squared `2.2500d`. `Decimal.pow(d, 0)` is `1d` for every `d`, `0d`
    /// included. `exp` is a `NonNegativeInt`: a negative power is a
    /// quotient that may not end, so write `1d / Decimal.pow(d, n)`, or
    /// `Decimal.divide` to name the rounding. A result whose scale is past
    /// Decimal's (about two billion digits) traps too.
    //! assert Decimal.pow(1.5d, 2) == 2.25d
    //! assert Decimal.to_string(Decimal.pow(1.50d, 2)) == "2.2500"
    //! assert Decimal.pow(2d, 64) == 18446744073709551616d
    //! assert Decimal.pow(0d, 0) == 1d
    //! assert 1d / Decimal.pow(2d, 3) == 0.125d
    //
    pub host fn pow(d: Decimal, exp: NonNegativeInt) -> Decimal

    /// The square root of `d` to exactly `scale` digits after the decimal
    /// point, rounding with `mode`, as `Decimal.divide` rounds its quotient.
    /// A root that ends within `scale` digits is exact under every mode, and
    /// `sqrt_exact` is the form that refuses to round; a `scale` past
    /// Decimal's, -2147483648 to 2147483647, traps. `d` is a
    /// `NonNegativeDecimal`, and so is its root; a value from data goes
    /// through `NonNegativeDecimal.try_from`.
    //! assert Decimal.sqrt(2d, 4, RoundingMode.HalfEven) == 1.4142d
    //! assert Decimal.sqrt(2d, 4, RoundingMode.Up) == 1.4143d
    //! assert Decimal.to_string(Decimal.sqrt(6.25d, 3, RoundingMode.Down)) == "2.500"
    //! assert Decimal.sqrt(0d, 2, RoundingMode.HalfEven) == 0d
    //
    pub host fn sqrt(d: NonNegativeDecimal, scale: Int, mode: RoundingMode) -> NonNegativeDecimal

    /// The square root of `d` to exactly `scale` digits after the decimal
    /// point when it ends within them: `Some` of it, and `None` when the root
    /// would need rounding at `scale`.
    //! assert Decimal.sqrt_exact(6.25d, 3) |> Maybe.map(Decimal.to_string) == Some("2.500")
    //! assert Decimal.sqrt_exact(2d, 4) == None
    //
    pub host fn sqrt_exact(d: NonNegativeDecimal, scale: Int) -> Maybe<NonNegativeDecimal>

    /// Strips trailing fractional zeros, returning the value at its minimal scale.
    /// Integer magnitude is never reduced (`100d` stays `100d`, scale 0). Zero
    /// normalizes to scale 0. Equality/hashing already treat scale-equal values as
    /// equal; `normalize` is for when you want the minimal-scale
    /// representation for display.
    //! assert Decimal.normalize(1.50d) == 1.5d
    //! assert Decimal.normalize(100.00d) == 100d
    //
    pub host fn normalize(d: Decimal) -> Decimal

    /// Returns the scale (number of fractional digits) of `d`. Scale is
    /// display-significant — `1.50d` has scale 2, `1.5d` has scale 1 — even though
    /// the two are `==`-equal.
    //! assert Decimal.scale(1.50d) == 2
    //! assert Decimal.scale(5d) == 0
    //
    pub host fn scale(d: Decimal) -> Int

    /// Returns |d| (scale preserved), a `NonNegativeDecimal`.
    //! assert Decimal.abs(-1.50d) == 1.50d
    //
    pub fn abs(d: Decimal) -> NonNegativeDecimal
        NonNegativeDecimal.unchecked(if d < 0d then 0d - d else d)
    end

    /// Returns -d (scale preserved). Negating zero stays zero.
    //! assert Decimal.negate(1.50d) == -1.50d
    //
    pub fn negate(d: Decimal) -> Decimal
        0d - d
    end

    /// Returns the sign of `d` as -1, 0, or +1 (by mathematical value).
    //! assert Decimal.sign(-1.50d) == -1
    //! assert Decimal.sign(0.00d) == 0
    //! assert Decimal.sign(1.50d) == 1
    //
    pub fn sign(d: Decimal) -> Int
        case
            d < 0d -> -1
            d > 0d -> 1
            _      -> 0
        end
    end

    /// True if `d` is exactly zero (at any scale: `0d`, `0.00d` are both zero).
    //! assert Decimal.is_zero(0.00d)
    //! refute Decimal.is_zero(1.50d)
    //
    pub fn is_zero(d: Decimal) -> Bool
        d == 0d
    end

    /// `d` split into `n` parts that sum to it exactly and differ by at most
    /// one unit of the `scale`th digit after the point: a bill shared by `n`
    /// people. The leftover units go one each to the first parts, so the
    /// larger parts come first. It is `Decimal.allocate` with `n` equal
    /// ratios.
    ///
    /// `scale` is the least number of digits after the point a part has:
    /// when `d` has more, it is split in units of its own last digit, so
    /// `0.125d` split two ways at scale 2 is `0.063d` and `0.062d`, which
    /// still sum to it. `n` is a `PositiveInt`, so there is at least one
    /// part, and `scale` a `NonNegativeInt`.
    //! assert Decimal.split(100d, 3, 2) == [33.34d, 33.33d, 33.33d]
    //! assert Display.to_string(Decimal.split(100d, 3, 2)) == "[33.34, 33.33, 33.33]"
    //! assert Decimal.split(-0.05d, 2, 2) == [-0.03d, -0.02d]
    //! assert Decimal.split(10d, 4, 0) == [3d, 3d, 2d, 2d]
    //! assert Decimal.split(0.125d, 2, 2) == [0.063d, 0.062d]
    //
    pub fn split(d: Decimal, n: PositiveInt, scale: NonNegativeInt) -> List<Decimal>
        allocated(
            d,
            Iter.repeat(1)
            |> Iter.take(n)
            |> Iter.to_list(),
            scale,
        )
    end

    /// `d` split into parts proportional to `ratios`, one part per ratio,
    /// that sum to it exactly: a payment shared 70 to 30, or a discount
    /// spread over a cart's lines by their prices. Each part is its share
    /// rounded toward zero to a unit of the `scale`th digit after the point;
    /// the units left over go one each to the parts in the order of
    /// `ratios`, skipping a zero ratio, so a zero ratio's part is always
    /// zero. This is Fowler's `allocate`. A negative `d` is split as its
    /// magnitude is, and each part takes its sign.
    ///
    /// `scale` is the least number of digits after the point a part has:
    /// when `d` has more, it is split in units of its own last digit, so the
    /// parts still sum to it, and each part has that many digits. `ratios`
    /// are `Ratios`, so an empty list, a negative ratio, or ratios that are
    /// all zero are compile errors in a literal, and ratios computed when
    /// the program runs go through `Ratios.try_from`. `scale` is a
    /// `NonNegativeInt`.
    //! import std::decimal.Ratios
    //!
    //! assert Decimal.allocate(0.05d, [3, 7], 2) == [0.02d, 0.03d]
    //! assert Decimal.allocate(10d, [70, 0, 30], 2) == [7d, 0d, 3d]
    //! assert Decimal.allocate(-1d, [1, 2], 2) == [-0.34d, -0.66d]
    //! assert Decimal.allocate(1.5d, [1, 1], 0) == [0.8d, 0.7d]
    //!
    //! prices = [3, 1]
    //! shares = Ratios.try_from(prices)!
    //! assert Decimal.allocate(1d, shares, 2) == [0.75d, 0.25d]
    //
    pub fn allocate(d: Decimal, ratios: Ratios, scale: NonNegativeInt) -> List<Decimal>
        allocated(d, ratios, scale)
    end

    /// `d` as a reader of `locale` writes it, with as many digits after the
    /// decimal point as its scale has, held within `fraction`: padded with
    /// zeros to its start and rounded to its end. `fraction` is one
    /// `ClosedRange<NonNegativeInt>`, `2..=2`, so a negative count or a
    /// backwards range is a compile error. `Range.from(2)`, which has no
    /// end, is at least two digits and every digit of the scale past them.
    /// By default it is `Range.from(0)`, so every digit of the scale is kept
    /// and none rounded: `1234.50d` is `1,234.50` in `en`. A digit past the
    /// end is rounded as
    /// `mode` says, half to even unless it says otherwise, as `Money.round`
    /// rounds.
    //! assert Decimal.format(1234.50d, Locale"de") == "1.234,50"
    //! assert Decimal.format(1234.50d, Locale"en") == "1,234.50"
    //! assert Decimal.format(1234567.89d, Locale"en") == "1,234,567.89"
    //! assert Decimal.format(-0.5d, Locale"sv") == "−0,5"
    //! assert Decimal.format(1234.5d, Locale"en", grouping: False) == "1234.5"
    //! assert Decimal.format(0.125d, Locale"en", fraction: 0..=2) == "0.12"
    //! assert Decimal.format(0.125d, Locale"en", fraction: 0..=2, mode: RoundingMode.HalfUp) == "0.13"
    //! assert Decimal.format(12d, Locale"fr", fraction: 2..=2) == "12,00"
    //! assert Decimal.format(1.5d, Locale"en", fraction: Range.from(2)) == "1.50"
    //! assert Decimal.format(1.23456d, Locale"en", fraction: Range.from(2)) == "1.23456"
    //
    pub fn format(
        d:        Decimal,
        locale:   Locale,
        fraction: ClosedRange<NonNegativeInt> = Range.from(0),
        grouping: Bool = True,
        mode:     RoundingMode = RoundingMode.HalfEven,
    ) -> String
        (min, max) = fraction_bounds(fraction, Decimal.scale(d))
        shown = Decimal.fraction_digits(d, min, max, mode)
        decimal_format(locale, Display.to_string(shown), min, max, grouping)
    end

    /// `d` as a percentage in `locale`: `d` times 100, exactly, with the
    /// locale's percent sign where the locale's pattern puts it (`%26` in
    /// `tr`), and the digits after the
    /// decimal point the percentage's scale has (two fewer than `d`'s),
    /// held within `fraction` and rounded by `mode` as `Decimal.format`
    /// does. By default every digit is kept.
    //! assert Decimal.format_percent(0.125d, Locale"en") == "12.5%"
    //! assert Decimal.format_percent(0.5d, Locale"de") == "50\u{a0}%"
    //! assert Decimal.format_percent(0.26d, Locale"tr") == "%26"
    //! assert Decimal.format_percent(0.12345d, Locale"en", fraction: 0..=1) == "12.3%"
    //! assert Decimal.format_percent(0.12355d, Locale"en", fraction: 0..=2) == "12.36%"
    //! assert Decimal.format_percent(0.5d, Locale"en", fraction: 1..=1) == "50.0%"
    //
    pub fn format_percent(
        d:        Decimal,
        locale:   Locale,
        fraction: ClosedRange<NonNegativeInt> = Range.from(0),
        mode:     RoundingMode = RoundingMode.HalfEven,
    ) -> String
        // d times 100 ends in two more zeros than d has digits to lose,
        // so the scale drops by two without rounding.
        percent = Decimal.round_exact(d * 100d, Int.max(Decimal.scale(d) - 2, 0))!
        (min, max) = fraction_bounds(fraction, Decimal.scale(d) - 2)
        shown = Decimal.fraction_digits(percent, min, max, mode)
        decimal_format_percent(locale, Display.to_string(shown), min, max)
    end

    // `d` at its own scale held between min_fraction and max_fraction,
    // rounded by mode. The bounds are a ClosedRange's, so min_fraction is at
    // most max_fraction.
    fn fraction_digits(
        d:            Decimal,
        min_fraction: Int,
        max_fraction: Int,
        mode:         RoundingMode,
    ) -> Decimal
        Decimal.round(d, Int.min(Int.max(Decimal.scale(d), min_fraction), max_fraction), mode)
    end

    /// Read text a reader of `locale` wrote as a `Decimal`, strictly unless
    /// `lenient: True`, as `Int.parse_in` reads an `Int`. The digits typed
    /// after the decimal separator are the scale: `12,50` is `12.50d`.
    //! assert Decimal.parse_in("1.234,5", Locale"de") == Ok(1234.5d)
    //! assert Decimal.parse_in("12,50", Locale"pl") |> Result.map(&Display.to_string(&1)) == Ok("12.50")
    //!
    //! assert Decimal.parse_in("1.234,5", Locale"en") == Err(NumberParseError.Unexpected{at: 5, text: ","})
    //!
    //! assert Decimal.parse_in("∞", Locale"en") == Err(NumberParseError.OutOfRange)
    //
    pub fn parse_in(
        text:    String,
        locale:  Locale,
        lenient: Bool = False,
    ) -> Result<Decimal, NumberParseError>
        Decimal.lift(decimal_parse_in(text, locale, lenient))
    end

    /// Read a percentage a reader of `locale` wrote, as a fraction, divided
    /// by 100 exactly: `12,5 %` is `0.125d`. The percent sign is required,
    /// where the locale puts it unless `lenient: True`, which takes it on
    /// either side and ASCII `%` for the locale's sign.
    //! assert Decimal.parse_percent_in("12,5\u{a0}%", Locale"de") == Ok(0.125d)
    //! assert Decimal.parse_percent_in("12.5%", Locale"en") == Ok(0.125d)
    //! assert Decimal.parse_percent_in("%12.5", Locale"en", True) == Ok(0.125d)
    //!
    //! assert Decimal.parse_percent_in("12.5", Locale"en")
    //!     == Err(NumberParseError.Unexpected{at: 4, text: ""})
    //
    pub fn parse_percent_in(
        text:    String,
        locale:  Locale,
        lenient: Bool = False,
    ) -> Result<Decimal, NumberParseError>
        Decimal.lift(decimal_parse_percent_in(text, locale, lenient))
    end

    // The Decimal of the number text the Go half read.
    fn lift(read: Result<String, NumberParseError>) -> Result<Decimal, NumberParseError>
        case read
            Err(e) ->
                Err(e)

            Ok(text) ->
                case String.to_decimal(text)
                    Some(d) -> Ok(d)
                    None    -> Err(NumberParseError.OutOfRange)
                end
        end
    end
end

// The least and most fraction digits `fraction` asks for. An unbounded
// range has no most, and keeps every digit of `scale`.
fn fraction_bounds(fraction: ClosedRange<NonNegativeInt>, scale: Int) -> (Int, Int)
    min = Range.start(fraction)

    case Range.stop(fraction)
        Some(max) -> (min, max)
        None      -> (min, Int.max(scale, min))
    end
end

// `d` in parts proportional to `ratios`, which Ratios keeps not empty, not
// negative and not all zero, summing to it exactly: each part's share of the units of
// the larger of `scale` and `d`'s own scale rounded toward zero, and the
// units left over one each to the nonzero ratios in order. The sign is set
// apart, so a negative amount splits as its magnitude does.
fn allocated(d: Decimal, ratios: List<Int>, scale: NonNegativeInt) -> List<Decimal>
    digits: NonNegativeInt = case NonNegativeInt.try_from(Decimal.scale(d))
        Some(own) -> if own > scale then own else scale
        None      -> scale
    end

    // A power of ten is a PositiveDecimal.
    unit = Decimal.pow(10d, digits)
    units = Decimal.to_int(d * unit)
    sign = if units < 0 then -1 else 1
    magnitude = Int.abs(units)
    // Ratios keeps a ratio above zero and none below, so the sum is above
    // zero.
    total = PositiveInt.try_from(Iter.sum(ratios))!
    left = magnitude - Iter.sum_by(ratios, fn r -> magnitude * r / total)

    // How many nonzero ratios come up to and including each one.
    ranks = Iter.scan(ratios, 0, fn seen, r -> if r > 0 then seen + 1 else seen)

    Iter.zip(ratios, ranks)
    |> Iter.map(fn (r, rank) ->
        extra = if r > 0 and rank <= left then 1 else 0
        part = sign * (magnitude * r / total + extra)
        // A whole number of units at `digits` places: the division is exact.
        Decimal.divide(Int.to_decimal(part), unit, digits, RoundingMode.Down)
    end)
    |> Iter.to_list()
end

host fn decimal_format(
    locale:       Locale,
    text:         String,
    min_fraction: Int,
    max_fraction: Int,
    grouping:     Bool,
) -> String

host fn decimal_format_percent(
    locale:       Locale,
    text:         String,
    min_fraction: Int,
    max_fraction: Int,
) -> String

host fn decimal_parse_in(
    text:    String,
    locale:  Locale,
    lenient: Bool,
) -> Result<String, NumberParseError>

host fn decimal_parse_percent_in(
    text:    String,
    locale:  Locale,
    lenient: Bool,
) -> Result<String, NumberParseError>

impl Display for Decimal
    /// Returns the canonical scale-preserving string form of `d`, matching the
    /// runtime stringifier used by `io.print` and string interpolation. Trailing
    /// zeros are kept (`1.50d` → `"1.50"`).
    //! assert Decimal.to_string(1.50d) == "1.50"
    //! assert Decimal.to_string(100d) == "100"
    //
    host fn to_string(d: Decimal) -> String
end

impl Add<Decimal, Decimal> for Decimal
    host fn add(lhs: Decimal, rhs: Decimal) -> Decimal
end

impl Summable for Decimal
    /// The sum of no Decimals: `0d`, at scale 0. A sum takes the larger
    /// scale of its operands, so `x + 0d` keeps `x`'s scale.
    //! assert Decimal.empty_sum() == 0d
    //! assert Decimal.to_string(1.50d + Decimal.empty_sum()) == "1.50"
    //
    fn empty_sum() -> Decimal
        0d
    end
end

impl Subtract<Decimal, Decimal> for Decimal
    host fn subtract(lhs: Decimal, rhs: Decimal) -> Decimal
end

impl Multiply<Decimal, Decimal> for Decimal
    host fn multiply(lhs: Decimal, rhs: Decimal) -> Decimal
end

impl Divide<NonZeroDecimal, Decimal> for Decimal
    /// `lhs / rhs`: the quotient rounded half-even to 34 significant digits,
    /// with no trailing zeros after the point. A quotient that ends within
    /// 34 digits is exact. The divisor is a `NonZeroDecimal`, as Int's `/`
    /// takes a `NonZeroInt`.
    //! assert Decimal.to_string(10.00d / 4d) == "2.5"
    //! assert Decimal.to_string(10d / 3d) == "3.333333333333333333333333333333333"
    //! assert Decimal.to_string(1d / 4d) == "0.25"
    //! assert Decimal.scale(6.00d / 3d) == 0
    //! assert Decimal.to_string(-2d / 3d) == "-0.6666666666666666666666666666666667"
    //
    host fn divide(lhs: Decimal, rhs: NonZeroDecimal) -> Decimal
end

impl Remainder<NonZeroDecimal, Decimal> for Decimal
    /// `lhs % rhs`: `lhs - rhs * q`, where `q` is the quotient truncated
    /// toward zero. Exact, never rounds, and takes the sign of `lhs`; the
    /// scale is the larger of the operands'. The divisor is a
    /// `NonZeroDecimal`.
    //! assert 10.5d % 3d == 1.5d
    //! assert Decimal.to_string(7.25d % 0.5d) == "0.25"
    //! assert -7.5d % 2d == -1.5d
    //! assert Decimal.to_string(10d % 2.50d) == "0.00"
    //
    host fn remainder(lhs: Decimal, rhs: NonZeroDecimal) -> Decimal
end

impl Productable for Decimal
    /// The product of no Decimals: `1d`, at scale 0. A product's scale is
    /// the sum of its operands', so `x * 1d` keeps `x`'s scale.
    //! assert Decimal.empty_product() == 1d
    //! assert Decimal.to_string(1.50d * Decimal.empty_product()) == "1.50"
    //
    fn empty_product() -> Decimal
        1d
    end
end

impl Debug for Decimal
    // Round-trippable, scale-faithful form: the canonical string plus the `d`
    // suffix, so the REPL distinguishes a Decimal from a Float and the output can
    // be pasted back as a literal.
    fn inspect(d: Decimal) -> String
        to_string(d) + "d"
    end
end

impl Equatable for Decimal
    // Scale-insensitive Decimal equality — agrees with `hash`, so
    // `1.50d == 1.5d` AND both hash equally. The host implementation is shared
    // with the runtime's map-key equality (`value.DecimalEqual` in Go), so the
    // operator path, `Equatable.equal`, and map keys all converge on one
    // function.
    host fn equal(a: Decimal, b: Decimal) -> Bool
end

impl Hashable for Decimal
    // The normalized value is hashed, so `==`-equal decimals hash
    // equally regardless of scale (`1.50d` and `1.5d` agree). Keeps Map/Set keys
    // coherent.
    host fn hash(d: Decimal) -> Int
end

impl Comparable for Decimal
    // Compares by mathematical value, scale-insensitively:
    // `Decimal.compare(1.50d, 1.5d) == Equal`.
    host fn compare(a: Decimal, b: Decimal) -> Ordering
end

impl Steppable for Decimal
    /// Returns `value + by`. Decimal stepping is exact because Decimal is
    /// arbitrary-precision base-10.
    //! assert Decimal.step_by(1.0d, 0.1d) == Some(1.1d)
    //
    fn step_by(value: Decimal, by: Decimal) -> Maybe<Decimal>
        Some(value + by)
    end
end

/// A Decimal that is not zero, so dividing by one cannot trap. A literal is
/// checked when the program is compiled; `NonZeroDecimal.try_from(d)`
/// checks a value at run time. It is in the prelude.
//! d: NonZeroDecimal = 4d
//! assert 10d / d == 2.5d
//! assert NonZeroDecimal.try_from(0.00d) == None
//
pub subtype NonZeroDecimal Decimal when fn d -> d != 0d

/// A Decimal that is zero or more: an amount, a rate, what `Decimal.sqrt`
/// takes. A literal is checked when the program is compiled;
/// `NonNegativeDecimal.try_from(d)` checks a value at run time. It is in the
/// prelude.
//! r: NonNegativeDecimal = 6.25d
//! assert Decimal.sqrt(r, 1, RoundingMode.HalfEven) == 2.5d
//! assert NonNegativeDecimal.try_from(-0.01d) == None
//
pub subtype NonNegativeDecimal Decimal when fn d -> d >= 0d

/// A Decimal greater than zero. It refines both `NonNegativeDecimal` and
/// `NonZeroDecimal`, so a PositiveDecimal passes wherever either, or a
/// Decimal, is expected. It is in the prelude.
//! assert PositiveDecimal.try_from(0.5d) == Some(0.5d)
//! assert PositiveDecimal.try_from(0d) == None
//
pub subtype PositiveDecimal NonNegativeDecimal and NonZeroDecimal when fn d -> d > 0d

/// The ratios `Decimal.allocate` and `Money.allocate` split an amount by: at
/// least one, none negative, and not all zero, so every part has a share to
/// take. A literal, `[70, 30]`, is checked when the program is compiled;
/// `Ratios.try_from(xs)` checks ratios computed when it runs. It is not in
/// the prelude: `import std::decimal.Ratios` to name it.
//! import std::decimal.Ratios
//!
//! r: Ratios = [70, 0, 30]
//! assert Decimal.allocate(10d, r, 2) == [7d, 0d, 3d]
//! assert Ratios.try_from([]) == None
//! assert Ratios.try_from([1, -1]) == None
//! assert Ratios.try_from([0, 0]) == None
//! assert Ratios.try_from([0, 2]) == Some([0, 2])
//
pub subtype Ratios List<Int> when fn ratios ->
    Iter.all_match(ratios, fn r -> r >= 0) and Iter.any_match(ratios, fn r -> r > 0)
end

/// Rounding policy for decimal division and quantization. There is no default:
/// every rounding operation names its mode explicitly.
///
/// - `Up` — away from zero
/// - `Down` — toward zero (truncate)
/// - `Ceiling` — toward +∞
/// - `Floor` — toward −∞
/// - `HalfUp` — nearest; ties away from zero
/// - `HalfDown` — nearest; ties toward zero
/// - `HalfEven` — nearest; ties to even (banker's rounding)
///
/// No mode asserts that nothing rounds: `Decimal.round_exact`,
/// `Decimal.divide_exact` and `Decimal.sqrt_exact` return `None` when a
/// digit would be lost.
pub enum RoundingMode
    Up
    Down
    Ceiling
    Floor
    HalfUp
    HalfDown
    HalfEven
end

derive Display for RoundingMode
