import {
    add.Add
    bool.Bool.{self, False, True}
    comparable.{Comparable, Ordering}
    debug.Debug
    display.Display
    equatable.Equatable
    float.Float
    hashable.Hashable
    int.Int
    locale.Locale
    localize.NumberParseError
    maybe.Maybe.{self, None, Some}
    multiply.Multiply
    productable.Productable
    results.Result.{self, Err, Ok}
    steppable.Steppable
    strings.String
    subtract.Subtract
    summable.Summable
}

//# Operations on the arbitrary-precision, exact base-10 `Decimal` type:
//# conversions to/from `Int`/`Float`/`String`, explicit-rounding division and
//# quantization (every rounding op names a `RoundingMode`), sign/scale/abs
//# helpers, and the value-based (scale-insensitive) arithmetic/`Equatable`/`Comparable`/
//# `Hashable` impls. `+ - *` and `Decimal.pow` are exact; only
//# `Decimal.divide`, `Decimal.sqrt` and `Decimal.round` round. There is no `/`: `Decimal.divide` names its
//# rounding, and `Decimal.divide_exact` answers `None` for a quotient that
//# does not terminate.

/// Arbitrary-precision exact base-10 number. The third blessed numeric type
/// alongside `Int` and `Float`: `+ - *` are always exact, there is no `/`
/// (`Decimal.divide` and `Decimal.divide_exact` divide), and there is no
/// implicit conversion to/from `Int` or `Float`. Literals carry
/// a `d` suffix (`1.50d`); scale is significant for display (`1.50d` prints
/// "1.50") but equality is scale-insensitive (`1.50d == 1.5d`).
pub host type Decimal

impl Decimal {
    /// Converts a Decimal to an Int by truncating toward zero. Returns None when
    /// the truncated value falls outside Int64's range (~±9.22e18). Use
    /// `Decimal.round` first if a different rounding rule is needed.
    //! assert Decimal.to_int(3.7d) == Some(3)
    //! assert Decimal.to_int(-3.7d) == Some(-3)
    //
    pub host fn to_int(d: Decimal) -> Maybe<Int>

    /// Converts a Decimal to a Float. Total and lossy-by-nature (Float is binary64,
    /// so most base-10 fractions are not exactly representable). Magnitudes beyond
    /// Float's range become ±Infinity. Explicit by design — there is no implicit
    /// Decimal→Float coercion.
    //! assert Decimal.to_float(1.50d) == 1.5
    //
    pub host fn to_float(d: Decimal) -> Float

    /// Divides `a` by `b` to exactly `scale` fractional digits, rounding the
    /// quotient with `mode`. It always returns a value at the named scale;
    /// `divide_exact` is the division that never rounds. Runtime error on a
    /// zero `b`, or when `mode` is `Unnecessary` and the exact quotient does
    /// not fit at `scale`.
    //! assert Decimal.divide(10d, 3d, 2, RoundingMode.HalfEven) == 3.33d
    //! assert Decimal.divide(10.00d, 4d, 2, RoundingMode.Down) == 2.50d
    //
    pub host fn divide(a: Decimal, b: Decimal, scale: Int, mode: RoundingMode) -> Decimal

    /// Divides `a` by `b` exactly: `Some` of the quotient when it terminates in
    /// base 10, `None` when it does not (`10d` by `3d`). A quotient's scale is
    /// `a`'s scale less `b`'s, or more when the quotient needs more digits
    /// (`1d` by `8d` is `0.125d`), and never below zero. Runtime error on a
    /// zero `b`, as Int's `/` gives.
    //! assert Decimal.divide_exact(10.00d, 4d) == Some(2.50d)
    //! assert Decimal.divide_exact(10.00d, 4d) |> Maybe.map(Decimal.to_string) == Some("2.50")
    //! assert Decimal.divide_exact(1d, 8d) == Some(0.125d)
    //! assert Decimal.divide_exact(10d, 3d) == None
    //
    pub host fn divide_exact(a: Decimal, b: Decimal) -> Maybe<Decimal>

    /// Quantizes `d` to exactly `scale` fractional digits using `mode`. Increasing
    /// the scale pads trailing zeros (always exact); decreasing it rounds. A
    /// negative scale rounds to tens/hundreds/… A runtime error results only when
    /// `mode` is `Unnecessary` and rounding would lose information.
    //! assert Decimal.round(3.14159d, 2, RoundingMode.HalfEven) == 3.14d
    //! assert Decimal.round(2.5d, 0, RoundingMode.HalfEven) == 2d
    //! assert Decimal.round(1d, 2, RoundingMode.Up) == 1.00d
    //
    pub host fn round(d: Decimal, scale: Int, mode: RoundingMode) -> Decimal

    /// `d` multiplied by itself `exp` times, exactly, as `*` multiplies: the
    /// scale is `exp` times `d`'s, so `1.5d` squared is `2.25d` and `1.50d`
    /// squared `2.2500d`. `Decimal.pow(d, 0)` is `1d` for every `d`, `0d`
    /// included. A negative `exp` traps: its answer is a quotient that may
    /// not end, so write `Decimal.divide(1d, Decimal.pow(d, n), scale,
    /// mode)`, which names its rounding. A result whose scale is past
    /// Decimal's (about two billion digits) traps too.
    //! assert Decimal.pow(1.5d, 2) == 2.25d
    //! assert Decimal.to_string(Decimal.pow(1.50d, 2)) == "2.2500"
    //! assert Decimal.pow(2d, 64) == 18446744073709551616d
    //! assert Decimal.pow(0d, 0) == 1d
    //! assert Decimal.divide(1d, Decimal.pow(2d, 3), 3, RoundingMode.Unnecessary) == 0.125d
    //
    pub host fn pow(d: Decimal, exp: Int) -> Decimal

    /// The square root of `d` to exactly `scale` digits after the decimal
    /// point, rounding with `mode`, as `Decimal.divide` rounds its quotient.
    /// A root that ends within `scale` digits is exact under every mode; one
    /// that does not traps under `Unnecessary`. A negative `d` traps.
    //! assert Decimal.sqrt(2d, 4, RoundingMode.HalfEven) == 1.4142d
    //! assert Decimal.sqrt(2d, 4, RoundingMode.Up) == 1.4143d
    //! assert Decimal.to_string(Decimal.sqrt(6.25d, 3, RoundingMode.Unnecessary)) == "2.500"
    //! assert Decimal.sqrt(0d, 2, RoundingMode.HalfEven) == 0d
    //
    pub host fn sqrt(d: Decimal, scale: Int, mode: RoundingMode) -> Decimal

    /// Strips trailing fractional zeros, returning the value at its minimal scale.
    /// Integer magnitude is never reduced (`100d` stays `100d`, scale 0). Zero
    /// normalizes to scale 0. Equality/hashing already treat scale-equal values as
    /// equal; `normalize` is for when you want the minimal-scale
    /// representation for display.
    //! assert Decimal.normalize(1.50d) == 1.5d
    //! assert Decimal.normalize(100.00d) == 100d
    //
    pub host fn normalize(d: Decimal) -> Decimal

    /// Returns the scale (number of fractional digits) of `d`. Scale is
    /// display-significant — `1.50d` has scale 2, `1.5d` has scale 1 — even though
    /// the two are `==`-equal.
    //! assert Decimal.scale(1.50d) == 2
    //! assert Decimal.scale(5d) == 0
    //
    pub host fn scale(d: Decimal) -> Int

    /// Returns |d| (scale preserved).
    //! assert Decimal.abs(-1.50d) == 1.50d
    //
    pub fn abs(d: Decimal) -> Decimal {
        if d < 0d { 0d - d } else { d }
    }

    /// Returns -d (scale preserved). Negating zero stays zero.
    //! assert Decimal.negate(1.50d) == -1.50d
    //
    pub fn negate(d: Decimal) -> Decimal {
        0d - d
    }

    /// Returns the sign of `d` as -1, 0, or +1 (by mathematical value).
    //! assert Decimal.sign(-1.50d) == -1
    //! assert Decimal.sign(0.00d) == 0
    //! assert Decimal.sign(1.50d) == 1
    //
    pub fn sign(d: Decimal) -> Int {
        case {
            d < 0d -> -1
            d > 0d -> 1
            _ -> 0
        }
    }

    /// True if `d` is exactly zero (at any scale: `0d`, `0.00d` are both zero).
    //! assert Decimal.zero?(0.00d)
    //! refute Decimal.zero?(1.50d)
    //
    pub fn zero?(d: Decimal) -> Bool {
        d == 0d
    }

    /// Returns the lesser of `a` and `b` (by value; ties return `a`).
    //! assert Decimal.min(1.50d, 2d) == 1.50d
    //
    pub fn min(a: Decimal, b: Decimal) -> Decimal {
        if a <= b { a } else { b }
    }

    /// Returns the greater of `a` and `b` (by value; ties return `a`).
    //! assert Decimal.max(1.50d, 2d) == 2d
    //
    pub fn max(a: Decimal, b: Decimal) -> Decimal {
        if a >= b { a } else { b }
    }

    /// `d` as a reader of `locale` writes it, with as many digits after the
    /// decimal point as its scale has, at least `min_fraction` and at most
    /// `max_fraction` (0 <= min_fraction <= max_fraction <= 100, else a
    /// trap). By default every digit of the scale is kept and none rounded:
    /// `1234.50d` keeps its zero. A digit past `max_fraction` is rounded as
    /// `mode` says, half to even unless it says otherwise, as `Money.round`
    /// rounds.
    //! assert Decimal.format(1234.50d, Locale`de`) == "1.234,50"
    //! assert Decimal.format(1234567.89d, Locale`en`) == "1,234,567.89"
    //! assert Decimal.format(-0.5d, Locale`sv`) == "−0,5"
    //! assert Decimal.format(1234.5d, Locale`en`, grouping: False) == "1234.5"
    //! assert Decimal.format(0.125d, Locale`en`, max_fraction: 2) == "0.12"
    //! assert Decimal.format(0.125d, Locale`en`, max_fraction: 2, mode: RoundingMode.HalfUp) == "0.13"
    //! assert Decimal.format(12d, Locale`fr`, min_fraction: 2) == "12,00"
    //
    pub fn format(
        d: Decimal,
        locale: Locale,
        min_fraction: Int = 0,
        max_fraction: Int = Int.max(Decimal.scale(d), min_fraction),
        grouping: Bool = True,
        mode: RoundingMode = RoundingMode.HalfEven,
    ) -> String {
        shown = Decimal.fraction_digits(d, min_fraction, max_fraction, mode)
        decimal_format(locale, Display.to_string(shown), min_fraction, max_fraction, grouping)
    }

    /// `d` as a percentage in `locale`: `d` times 100, with the locale's
    /// percent sign where the locale puts it, and the digits after the
    /// decimal point the percentage's scale has (two fewer than `d`'s),
    /// limited by `min_fraction` and `max_fraction` and rounded by `mode` as
    /// `Decimal.format` does. By default every digit is kept.
    //! assert Decimal.format_percent(0.125d, Locale`en`) == "12.5%"
    //! assert Decimal.format_percent(0.5d, Locale`de`) == "50\u{a0}%"
    //! assert Decimal.format_percent(0.12345d, Locale`en`, max_fraction: 1) == "12.3%"
    //! assert Decimal.format_percent(0.12355d, Locale`en`, max_fraction: 2) == "12.36%"
    //! assert Decimal.format_percent(0.5d, Locale`en`, min_fraction: 1) == "50.0%"
    //
    pub fn format_percent(
        d: Decimal,
        locale: Locale,
        min_fraction: Int = 0,
        max_fraction: Int = Int.max(Decimal.scale(d) - 2, min_fraction),
        mode: RoundingMode = RoundingMode.HalfEven,
    ) -> String {
        percent = Decimal.round(
            d * 100d,
            Int.max(Decimal.scale(d) - 2, 0),
            RoundingMode.Unnecessary,
        )

        shown = Decimal.fraction_digits(percent, min_fraction, max_fraction, mode)
        decimal_format_percent(locale, Display.to_string(shown), min_fraction, max_fraction)
    }

    // `d` at its own scale held between min_fraction and max_fraction,
    // rounded by mode.
    fn fraction_digits(
        d: Decimal,
        min_fraction: Int,
        max_fraction: Int,
        mode: RoundingMode,
    ) -> Decimal {
        Decimal.round(d, Int.min(Int.max(Decimal.scale(d), min_fraction), max_fraction), mode)
    }

    /// Read text a reader of `locale` wrote as a `Decimal`, strictly unless
    /// `lenient: True`, as `Int.parse_in` reads an `Int`. The digits typed
    /// after the decimal separator are the scale: `12,50` is `12.50d`.
    //! assert Decimal.parse_in("1.234,5", Locale`de`) == Ok(1234.5d)
    //! assert Decimal.parse_in("12,50", Locale`pl`) |> Result.map(&Display.to_string(&1)) == Ok("12.50")
    //!
    //! assert Decimal.parse_in("1.234,5", Locale`en`)
    //!     == Err(#NumberParseError.Unexpected{at: 5, text: ","})
    //
    pub fn parse_in(
        text: String,
        locale: Locale,
        lenient: Bool = False,
    ) -> Result<Decimal, NumberParseError> {
        Decimal.lift(decimal_parse_in(text, locale, lenient))
    }

    /// Read a percentage a reader of `locale` wrote, as a fraction:
    /// `12,5 %` is `0.125d`. The percent sign is required, where the locale
    /// puts it unless `lenient: True`.
    //! assert Decimal.parse_percent_in("12,5\u{a0}%", Locale`de`) == Ok(0.125d)
    //! assert Decimal.parse_percent_in("12.5%", Locale`en`) == Ok(0.125d)
    //!
    //! assert Decimal.parse_percent_in("12.5", Locale`en`)
    //!     == Err(#NumberParseError.Unexpected{at: 4, text: ""})
    //
    pub fn parse_percent_in(
        text: String,
        locale: Locale,
        lenient: Bool = False,
    ) -> Result<Decimal, NumberParseError> {
        Decimal.lift(decimal_parse_percent_in(text, locale, lenient))
    }

    // The Decimal of the number text the Go half read.
    fn lift(read: Result<String, NumberParseError>) -> Result<Decimal, NumberParseError> {
        case read {
            Err(e) ->
                Err(e)

            Ok(text) -> {
                case String.to_decimal(text) {
                    Some(d) -> Ok(d)
                    None -> Err(NumberParseError.OutOfRange)
                }
            }
        }
    }
}

host fn decimal_format(
    locale: Locale,
    text: String,
    min_fraction: Int,
    max_fraction: Int,
    grouping: Bool,
) -> String

host fn decimal_format_percent(
    locale: Locale,
    text: String,
    min_fraction: Int,
    max_fraction: Int,
) -> String

host fn decimal_parse_in(
    text: String,
    locale: Locale,
    lenient: Bool,
) -> Result<String, NumberParseError>

host fn decimal_parse_percent_in(
    text: String,
    locale: Locale,
    lenient: Bool,
) -> Result<String, NumberParseError>

impl Display for Decimal {
    /// Returns the canonical scale-preserving string form of `d`, matching the
    /// runtime stringifier used by `io.print` and string interpolation. Trailing
    /// zeros are kept (`1.50d` → `"1.50"`).
    //! assert Decimal.to_string(1.50d) == "1.50"
    //! assert Decimal.to_string(100d) == "100"
    //
    host fn to_string(d: Decimal) -> String
}

impl Add<Decimal, Decimal> for Decimal {
    host fn add(lhs: Decimal, rhs: Decimal) -> Decimal
}

impl Summable for Decimal {
    /// The sum of no Decimals: `0d`, at scale 0. A sum takes the larger
    /// scale of its operands, so `x + 0d` keeps `x`'s scale.
    //! assert Decimal.empty_sum() == 0d
    //! assert Decimal.to_string(1.50d + Decimal.empty_sum()) == "1.50"
    //
    fn empty_sum() -> Decimal {
        0d
    }
}

impl Subtract<Decimal, Decimal> for Decimal {
    host fn subtract(lhs: Decimal, rhs: Decimal) -> Decimal
}

impl Multiply<Decimal, Decimal> for Decimal {
    host fn multiply(lhs: Decimal, rhs: Decimal) -> Decimal
}

impl Productable for Decimal {
    /// The product of no Decimals: `1d`, at scale 0. A product's scale is
    /// the sum of its operands', so `x * 1d` keeps `x`'s scale.
    //! assert Decimal.empty_product() == 1d
    //! assert Decimal.to_string(1.50d * Decimal.empty_product()) == "1.50"
    //
    fn empty_product() -> Decimal {
        1d
    }
}

impl Debug for Decimal {
    // Round-trippable, scale-faithful form: the canonical string plus the `d`
    // suffix, so the REPL distinguishes a Decimal from a Float and the output can
    // be pasted back as a literal.
    fn inspect(d: Decimal) -> String {
        to_string(d) + "d"
    }
}

impl Equatable for Decimal {
    // Scale-insensitive Decimal equality — agrees with `hash`, so
    // `1.50d == 1.5d` AND both hash equally. The host implementation is shared
    // with the runtime's map-key equality (`value.DecimalEqual` in Go), so the
    // operator path, `Equatable.equal?`, and map keys all converge on one
    // function.
    host fn equal?(a: Decimal, b: Decimal) -> Bool
}

impl Hashable for Decimal {
    // The normalized value is hashed, so `==`-equal decimals hash
    // equally regardless of scale (`1.50d` and `1.5d` agree). Keeps Map/Set keys
    // coherent.
    host fn hash(d: Decimal) -> Int
}

impl Comparable for Decimal {
    // Compares by mathematical value, scale-insensitively:
    // `Decimal.compare(1.50d, 1.5d) == Equal`.
    host fn compare(a: Decimal, b: Decimal) -> Ordering
}

impl Steppable for Decimal {
    /// Returns `value + by`. Decimal stepping is exact because Decimal is
    /// arbitrary-precision base-10.
    //! assert Decimal.step_by(1.0d, 0.1d) == Some(1.1d)
    //
    fn step_by(value: Decimal, by: Decimal) -> Maybe<Decimal> {
        Some(value + by)
    }
}

/// Rounding policy for decimal division and quantization. There is no default:
/// every rounding operation names its mode explicitly.
///
/// - `Up` — away from zero
/// - `Down` — toward zero (truncate)
/// - `Ceiling` — toward +∞
/// - `Floor` — toward −∞
/// - `HalfUp` — nearest; ties away from zero
/// - `HalfDown` — nearest; ties toward zero
/// - `HalfEven` — nearest; ties to even (banker's rounding)
/// - `Unnecessary` — assert exactness; runtime error if rounding is needed
pub enum RoundingMode {
    Up
    Down
    Ceiling
    Floor
    HalfUp
    HalfDown
    HalfEven
    Unnecessary
}

derive Display for RoundingMode
