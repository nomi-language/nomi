//# Object storage: files kept whole under keys, in a directory, an S3
//# bucket or memory. Code that stores files calls the `Store` interface,
//# and each backend implements it, so one function serves the local
//# directory in development, a bucket in production and a test's
//# `storage_testing.Memory`:
//#
//# ```nomi
//# fn save_avatar(user_id: Int, data: Bytes) -> Result<Url, storage.Error>
//#     key = "avatars/${user_id}.png"
//#     Store.put(App.store, key, data, "image/png")?
//#     Store.url(App.store, key)
//# end
//# ```
//#
//# `storage.local(root)` keeps objects as plain files under a directory,
//# and `storage.handler(store)` serves any store's objects through the app.
//# `lib/storage/s3` is a backend for any server that speaks the S3
//# protocol: DigitalOcean Spaces, MinIO, Cloudflare R2, Backblaze B2 and
//# AWS. Boot code picks one:
//#
//# ```nomi
//# store = if production then
//#     s3.store(config)?
//# else
//#     storage.local("tmp/files", public_base: Some(Url`/files/`))
//# end
//# ```
//#
//# std::storage_testing has `Memory`, a store kept in memory for tests,
//# `Failing`, a store whose every call fails, and `conformance`, the suite
//# every backend passes.
//#
//# ## Keys
//#
//# Every backend enforces one key grammar (`storage.check_key`), so a key
//# that works on the local store works on S3:
//#
//# - 1 to 1,024 bytes of UTF-8, in segments separated by `/`, none of
//#   them empty;
//# - each segment at most 255 bytes, and none starting with `.`;
//# - no control character and no `\`.
//#
//# Anything else is allowed: spaces, punctuation such as `(`, `!`, `%`,
//# `#` and `?`, and letters of any script, so a store can address the
//# objects a bucket already holds. `../etc/passwd`, `/abs` and `a\b` are
//# refused before any backend builds a path or a URL from them.
//#
//# ## Listing
//#
//# `Store.list` returns one page of the keys under a prefix, in order,
//# with each object's size and time. With a delimiter, keys that go on
//# past it are folded into the common prefix they share, as a directory
//# listing shows a folder once; a page's `next` is passed back as
//# `continuation` for the page after it. `storage.list_all` follows the
//# pages to the end:
//#
//# ```nomi
//# page = Store.list(App.store, ListOptions{prefix: "avatars/", delimiter: "/"})?
//#
//# everything = storage.list_all(App.store, prefix: "avatars/")?
//# ```
//#
//# Objects move whole, as `Bytes`; there is no streaming or multipart
//# upload.

import
    bool.Bool.{self, False, True}
    bytes.Bytes
    code_points.Codepoint
    debug.Debug
    display.Display
    equatable.Equatable
    fs.{self, Kind, WriteMode}
    hex
    http.{self, Headers, Request, Response, Status}
    instant.Instant
    int.Int
    io
    iter.Iter
    maybe.Maybe.{self, None, Some}
    path
    results.Result.{self, Err, Ok}
    strings.String
    unit.Unit
    url.{self, Url}
end

/// Why a store call failed.
//! assert "${Error.NotFound{key: "a.txt"}}" == "no object has the key a.txt"
//
pub enum Error
    /// No object has the key. `get` returns it; `info` returns `Ok(None)`
    /// instead, and `delete` returns `Ok`.
    NotFound {key: String}

    /// The key breaks the key rules (`check_key`). `reason` says which.
    InvalidKey {key: String, reason: String}

    /// The content type is empty, longer than 255 characters, or holds a
    /// character outside printable ASCII.
    InvalidContentType {content_type: String}

    /// The store was made with no public URL for its objects.
    NoPublicUrl

    /// The backend refused the credentials or the permission.
    Denied {message: String}

    /// The backend could not be reached, timed out, or said it is
    /// overloaded. The same call may succeed later.
    Unavailable {message: String}

    /// Anything else, with the backend's own code: an S3 error code such as
    /// `NoSuchBucket`, or an `io.Error` variant's name for the local store.
    Backend {code: String, message: String}
end

derive Equatable for Error
derive Debug for Error

impl Display for Error
    fn to_string(error: Error) -> String
        case error
            .NotFound{key:} -> "no object has the key ${key}"
            .InvalidKey{key:, reason:} -> "invalid key \"${key}\": ${reason}"
            .InvalidContentType{content_type:} -> "invalid content type \"${content_type}\""
            .NoPublicUrl -> "the store has no public URL"
            .Denied{message:} -> "denied: ${message}"
            .Unavailable{message:} -> "unavailable: ${message}"
            .Backend{code:, message:} -> "${code}: ${message}"
        end
    end
end

/// What a store knows about an object without reading it.
pub struct Info
    /// The size in bytes.
    size: Int
    /// The content type `put` stored.
    content_type: String
    /// When the object was last stored.
    modified: Instant
end

derive Equatable for Info
derive Debug for Info

/// An object read whole: its bytes and its `Info`.
pub struct Object
    data: Bytes
    info: Info
end

derive Equatable for Object
derive Debug for Object

/// An object as a listing shows it: its key, its size in bytes, and when
/// it was last stored.
pub struct Entry
    key: String
    size: Int
    modified: Instant
end

derive Equatable for Entry
derive Debug for Entry

/// Which keys `Store.list` lists, and which page of them.
pub struct ListOptions
    /// Only keys that start with this. It may be any text a key may hold,
    /// a `/` at its end included.
    prefix: String = ""
    /// When not empty, a key that holds this after `prefix` is folded
    /// into the common prefix up to and including its first one, listed
    /// once in `Listing.prefixes` instead of in `objects`.
    delimiter: String = ""
    /// The `next` of the page before, to list the page after it.
    continuation: Maybe<String> = None
    /// The most objects and prefixes a page holds, 1 to 1,000. A value
    /// outside that is taken as the nearer end.
    limit: Int = 1000
end

derive Equatable for ListOptions
derive Debug for ListOptions

/// One page of a listing: the objects and the common prefixes on it, each
/// in key order, and the continuation for the page after it, or `None` on
/// the last page.
pub struct Listing
    objects: List<Entry> = []
    prefixes: List<String> = []
    next: Maybe<String> = None
end

derive Equatable for Listing
derive Debug for Listing

/// A place objects live, each under a key. `storage.local`, `lib/storage/s3`
/// and `storage_testing.Memory` implement it.
///
/// Every backend follows these rules, and std::storage_testing's
/// `conformance` suite checks each:
///
/// - Every function checks its key with `check_key` first, and returns its
///   `Err(.InvalidKey)` before doing anything else. `put` then checks the
///   content type with `check_content_type`.
/// - `put` replaces any object under the key. A reader sees the old object
///   or the new one, never part of one.
/// - `get` and `info` return the bytes and content type the last `put`
///   stored, and its size.
/// - `get` of a missing key is `Err(.NotFound)`; `info` of one is
///   `Ok(None)`; `delete` of one is `Ok`.
/// - `url` does no I/O. It returns a URL whether or not the object exists.
/// - `list` returns the keys under its prefix in byte order, its prefix
///   checked with `check_prefix` first, folds keys that go on past the
///   delimiter into their common prefix, and pages as `ListOptions` says;
///   `page` is that rule over a list of entries.
//! import std::storage_testing.Memory
//!
//! store: Store = Memory.new()
//! assert Store.put(store, "notes/a.txt", String.to_bytes("hi"), "text/plain") == Ok(Unit)
//! assert Store.get(store, "notes/a.txt")!.data == String.to_bytes("hi")
//! assert Store.exists(store, "notes/b.txt") == Ok(False)
//
pub interface Store
    /// Stores `data` under `key` with `content_type`, replacing any object
    /// there.
    fn put(store: self, key: String, data: Bytes, content_type: String) -> Result<Unit, Error>
    /// The object under `key`, read whole, or `Err(.NotFound)`.
    fn get(store: self, key: String) -> Result<Object, Error>
    /// What the store knows about the object under `key`, or `None` when
    /// there is none.
    fn info(store: self, key: String) -> Result<Maybe<Info>, Error>
    /// Removes the object under `key`. A missing key is `Ok`.
    fn delete(store: self, key: String) -> Result<Unit, Error>
    /// Where a reader fetches the object under `key`, with no I/O, or
    /// `Err(.NoPublicUrl)` from a store made without one.
    fn url(store: self, key: String) -> Result<Url, Error>
    /// One page of the objects whose keys start with `options.prefix`.
    fn list(store: self, options: ListOptions) -> Result<Listing, Error>

    /// Whether an object has the key.
    fn exists(store: self, key: String) -> Result<Bool, Error>
        info(store, key) |> Result.map(Maybe.is_some)
    end
end

/// `Ok` when `key` is a valid key, else `Err(.InvalidKey)` saying why. A
/// key is 1 to 1,024 bytes of segments separated by `/`. Each segment is 1
/// to 255 bytes, does not start with `.`, and holds no control character
/// (U+0000 to U+001F, U+007F to U+009F) and no `\`. Any other character
/// is allowed, as S3 allows it.
//! assert check_key("posts/2024-05-01/a_1.jpg") == Ok(Unit)
//! assert check_key("posts/Noah_-_3010(1).jpg") == Ok(Unit)
//! assert check_key("100% café/a b#1?.txt") == Ok(Unit)
//!
//! assert check_key("../etc/passwd") == Err(Error.InvalidKey{
//!         key: "../etc/passwd",
//!         reason: "segment .. starts with a dot",
//!     })
//!
//! assert check_key("a//b") is Err(.InvalidKey{})
//! assert check_key("a\\b") is Err(.InvalidKey{})
//! assert check_key("a\nb") is Err(.InvalidKey{})
//! assert check_key("") is Err(.InvalidKey{})
//
pub fn check_key(key: String) -> Result<Unit, Error>
    bad = fn reason: String -> Err(Error.InvalidKey{key:, reason:})
    if key == "" then return bad("it is empty")
    size = byte_length(key)
    if size > 1024 then return bad("it is ${size} bytes, over 1024")

    if Some(c) = Iter.find(String.to_codepoints(key), is_control) then
        return bad("it holds the control character ${String.to_literal("${c}")}")
    end

    if String.contains(key, "\\") then
        return bad("it holds \\, which a file system may read as a separator")
    end

    segments = String.split(key, "/")
    if Iter.any_match(segments, fn s -> s == "") then return bad("it has an empty segment")

    if Some(long) = Iter.find(segments, fn s -> byte_length(s) > 255) then
        return bad("a segment is ${byte_length(long)} bytes, over 255")
    end

    if Some(dotted) = Iter.find(segments, fn s -> String.starts_with(s, ".")) then
        return bad("segment ${dotted} starts with a dot")
    end

    Ok(Unit)
end

/// `Ok` when `prefix` can start a key, as `list` takes it: at most 1,024
/// bytes, with no control character and no `\`. It may be empty, end
/// with `/` or stop inside a segment.
//! assert check_prefix("") == Ok(Unit)
//! assert check_prefix("avatars/") == Ok(Unit)
//! assert check_prefix("a\\b") is Err(.InvalidKey{})
//
pub fn check_prefix(prefix: String) -> Result<Unit, Error>
    bad = fn reason: String -> Err(Error.InvalidKey{key: prefix, reason:})
    size = byte_length(prefix)
    if size > 1024 then return bad("it is ${size} bytes, over 1024")

    if Some(c) = Iter.find(String.to_codepoints(prefix), is_control) then
        return bad("it holds the control character ${String.to_literal("${c}")}")
    end

    if String.contains(prefix, "\\") then return bad("it holds \\, which no key holds")
    Ok(Unit)
end

/// The page of `entries` that `options` asks for, as every backend lists:
/// the entries whose keys start with the prefix, in key order, each key
/// that holds the delimiter after the prefix folded into its common
/// prefix, after the continuation, at most `limit` of them. The
/// continuation is the last key or prefix of the page before, so a
/// backend that holds its keys can list with this alone.
//! at = Instant.from_seconds(0)
//! entry = fn key: String -> Entry{key:, size: 1, modified: at}
//! entries = [entry("p/b/2"), entry("p/a"), entry("p/b/1"), entry("q"), entry("p/c")]
//!
//! assert page(entries, ListOptions{prefix: "p/"}).objects
//! |> Iter.map(fn e -> e.key)
//! |> Iter.to_list() == ["p/a", "p/b/1", "p/b/2", "p/c"]
//!
//! assert page(entries, ListOptions{prefix: "p/", delimiter: "/", limit: 2}) == Listing{
//!     objects: [entry("p/a")],
//!     prefixes: ["p/b/"],
//!     next: Some("p/b/"),
//! }
//!
//! assert page(
//!     entries,
//!     ListOptions{prefix: "p/", delimiter: "/", limit: 2, continuation: Some("p/b/")},
//! ) == Listing{objects: [entry("p/c")]}
//
pub fn page(entries: Iter<Entry>, options: ListOptions) -> Listing
    limit = if options.limit < 1 then
        1
    else if options.limit > 1000 then
        1000
    else
        options.limit
    end

    items =
        entries
        |> Iter.filter(fn e -> String.starts_with(e.key, options.prefix))
        |> Iter.sort_by(fn e -> e.key)
        |> Iter.map(fn e ->
            case folded(e.key, options)
                Some(p) -> (p, None)
                None -> (e.key, Some(e))
            end
        end)
        |> Iter.chunk_by(fn (text, _) -> text)
        |> Iter.flat_map(fn group -> Iter.first(group))
        |> Iter.filter(fn (text, _) ->
            case options.continuation
                Some(after) -> text > after
                None -> True
            end
        end)
        |> Iter.take(limit + 1)
        |> Iter.to_list()

    shown = Iter.take(items, limit) |> Iter.to_list()

    next = if Iter.count(items) > limit then
        Iter.last(shown) |> Maybe.map(fn (text, _) -> text)
    else
        None
    end

    Listing{
        objects: shown |> Iter.flat_map(fn (_, entry) -> entry) |> Iter.to_list(),
        prefixes: shown
        |> Iter.filter(fn (_, entry) -> entry == None)
        |> Iter.map(fn (text, _) -> text)
        |> Iter.to_list(),
        next:,
    }
end

// The common prefix `key` is folded into, when it holds the delimiter
// after the prefix.
fn folded(key: String, options: ListOptions) -> Maybe<String>
    if options.delimiter == "" then return None
    rest = String.drop(key, String.length(options.prefix))

    case String.split(rest, options.delimiter)
        [head, _, ..] -> Some("${options.prefix}${head}${options.delimiter}")
        _ -> None
    end
end

/// Every object and common prefix under `prefix`, following each page's
/// `next` to the last page.
//! import std::storage_testing.Memory
//!
//! store = Memory.new()
//! _ = Store.put(store, "a/1", String.to_bytes("x"), "text/plain")
//! _ = Store.put(store, "a/2/z", String.to_bytes("y"), "text/plain")
//! all = list_all(store, prefix: "a/", delimiter: "/", page_size: 1)!
//! assert all.objects |> Iter.map(fn e -> e.key) |> Iter.to_list() == ["a/1"]
//! assert all.prefixes == ["a/2/"]
//! assert all.next == None
//
pub fn list_all(
    store: Store,
    prefix: String = "",
    delimiter: String = "",
    page_size: Int = 1000,
) -> Result<Listing, Error>
    follow(store, ListOptions{prefix:, delimiter:, limit: page_size}, Listing{})
end

fn follow(store: Store, options: ListOptions, done: Listing) -> Result<Listing, Error>
    listed = Store.list(store, options)?

    all = Listing{
        objects: done.objects + listed.objects,
        prefixes: done.prefixes + listed.prefixes,
    }

    case listed.next
        Some(token) when Some(token) != options.continuation ->
            follow(store, {..options, continuation: Some(token)}, all)

        _ ->
            Ok(all)
    end
end

fn byte_length(text: String) -> Int
    Bytes.length(String.to_bytes(text))
end

// C0 controls, DEL and C1 controls.
fn is_control(c: Codepoint) -> Bool
    n = Codepoint.to_int(c)
    n < 0x20 or n >= 0x7f and n <= 0x9f
end

/// `base` with the segments of `key` joined to its path, each escaped, so
/// that a `%`, `?` or `#` in a key stays part of the path. A backend's
/// `url` returns it for its public base. `key` is not checked.
//! u = join_key(Url`https://cdn.example.com/files/`, "a b/50%(1)#2.jpg")
//! assert u.path == "/files/a b/50%(1)#2.jpg"
//! assert "${u}" == "https://cdn.example.com/files/a%20b/50%25%281%29%232.jpg"
//
pub fn join_key(base: Url, key: String) -> Url
    segments = String.split(key, "/") |> Iter.map(url.escape_path_segment) |> Iter.to_list()
    Url.join_path(base, segments)
end

/// `Ok` when `content_type` can be stored: 1 to 255 characters of
/// printable ASCII, space to `~`. It refuses CR and LF, which could
/// otherwise add a header, but does not parse the media type: `image/jpg`
/// is stored as written.
//! assert check_content_type("image/jpeg") == Ok(Unit)
//! assert check_content_type("text/html; charset=utf-8") == Ok(Unit)
//! assert check_content_type("") is Err(.InvalidContentType{})
//! assert check_content_type("text/plain\r\nX-Evil: 1") is Err(.InvalidContentType{})
//
pub fn check_content_type(content_type: String) -> Result<Unit, Error>
    printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    length = String.length(content_type)

    if length == 0
        or length > 255
        or Iter.any_match(content_type, fn c -> not String.contains(printable, c)) then
        Err(Error.InvalidContentType{content_type:})
    else
        Ok(Unit)
    end
end

/// A store over the directory `root`. Each object is a plain file at
/// `<root>/<key>`, so the directory can be backed up, inspected or served
/// by anything; its content type is kept beside it in
/// `<root>/.nomi-storage/types/<key>`, which no key can name. `root` is
/// created on the first `put`.
///
/// A few characters of a key are written on disk as `%` and two
/// hexadecimal digits, because some file system cannot hold them in a
/// name: `%` itself, `<`, `>`, `:`, `"`, `|`, `?` and `*`; a `.` or space
/// that ends a segment, which Windows drops; and the first letter of a
/// segment Windows keeps for a device (`CON`, `nul.txt`, `COM1`). So the
/// key `a:b.txt` is the file `a%3Ab.txt`, and a file copied in by hand is
/// found under the key its name spells only when its name holds none of
/// these.
///
/// `public_base` is where the app serves the directory, as
/// `Some(Url`/files/`)` with a route to `storage.handler`; `url` joins the
/// key to it. With `None`, `url` returns `Err(.NoPublicUrl)`.
///
/// A `put` writes the type file, then the object, each to a temporary file
/// renamed over the old one, so a reader sees the old object or the new
/// one. A file someone copied in with no type file is read with the type
/// `http.detect_content_type` gives its bytes. Errors from the file system
/// map to `NotFound`, `Denied` for `PermissionDenied`, and `Backend` with
/// the `io.Error` variant's name for the rest.
///
/// It differs from S3 in three ways:
///
/// - Keys `a` and `a/b` cannot both exist, since `a` cannot be a file and
///   a directory. The second `put` is `Err(.Backend)`.
/// - Two concurrent `put`s to one key may pair one put's bytes with the
///   other's type. Keys that never collide, as ones built from a timestamp
///   or a UUID, are safe.
/// - On a case-insensitive file system, as macOS and Windows have by
///   default, keys that differ only in case name one file, and on macOS
///   keys that differ only in Unicode normalization (`é` as one code
///   point or two) do too.
///
/// The calls go through std::fs, so `fs_testing.run` sandboxes the store in
/// tests, and `fs.within` applies.
//! import std::fs_testing
//!
//! ran = fs_testing.run(fs_testing.Sandbox{}, fn ->
//!     store = local("files", public_base: Some(Url`/files/`))
//!     Store.put(store, "a/b.txt", String.to_bytes("hi"), "text/plain")?
//!     Ok((Store.get(store, "a/b.txt")?.info.content_type, "${Store.url(store, "a/b.txt")?}"))
//! end)
//!
//! assert ran.value == Ok(("text/plain", "/files/a/b.txt"))
//! assert fs_testing.text(ran, "/work/files/a/b.txt") == Some("hi")
//! assert fs_testing.text(ran, "/work/files/.nomi-storage/types/a/b.txt") == Some("text/plain")
//
pub fn local(root: String, public_base: Maybe<Url> = None) -> Store
    Local{root:, public_base:}
end

struct Local
    root: String
    public_base: Maybe<Url>
end

impl Local
    fn object_path(local: Local, key: String) -> String
        path.join_all([local.root, ..file_names(key)])
    end

    fn type_path(local: Local, key: String) -> String
        path.join_all([local.root, ".nomi-storage", "types", ..file_names(key)])
    end

    // The stored type of the object at `key`, else what its bytes look like.
    fn content_type(
        local: Local,
        key: String,
        data: () -> Result<Bytes, Error>,
    ) -> Result<String, Error>
        case fs.read_text(Local.type_path(local, key))
            Ok(text) -> Ok(text)
            Err(.NotFound{}) -> data() |> Result.map(http.detect_content_type)
            Err(.NotADirectory{}) -> data() |> Result.map(http.detect_content_type)
            Err(.IsADirectory{}) -> data() |> Result.map(http.detect_content_type)
            Err(e) -> Err(from_io(key, e))
        end
    end
end

impl Store for Local
    fn put(local: Local, key: String, data: Bytes, content_type: String) -> Result<Unit, Error>
        check_key(key)?
        check_content_type(content_type)?
        object = Local.object_path(local, key)
        type_file = Local.type_path(local, key)
        make_parent(key, object)?
        make_parent(key, type_file)?

        fs.write_text(type_file, content_type, mode: WriteMode.ReplaceAtomically)
        |> Result.map_err(fn e -> from_io(key, e))?

        fs.write(object, data, mode: WriteMode.ReplaceAtomically)
        |> Result.map_err(fn e -> from_io(key, e))
    end

    fn get(local: Local, key: String) -> Result<Object, Error>
        check_key(key)?
        object = Local.object_path(local, key)
        meta = fs.metadata(object) |> Result.map_err(fn e -> missing(key, e))?
        if meta.kind != Kind.File then return Err(Error.NotFound{key:})
        data = fs.read(object) |> Result.map_err(fn e -> missing(key, e))?
        content_type = Local.content_type(local, key, fn -> Ok(data))?

        Ok(
            Object{
                data:,
                info: Info{size: Bytes.length(data), content_type:, modified: meta.modified},
            }
        )
    end

    fn info(local: Local, key: String) -> Result<Maybe<Info>, Error>
        check_key(key)?
        object = Local.object_path(local, key)

        case fs.metadata(object)
            Ok(meta) when meta.kind == Kind.File ->
                content_type = Local.content_type(local, key, fn ->
                    fs.read(object) |> Result.map_err(fn e -> missing(key, e))
                end)?

                Ok(Some(Info{size: meta.size, content_type:, modified: meta.modified}))

            Ok(_) ->
                Ok(None)

            Err(e) ->
                case missing(key, e)
                    .NotFound{} -> Ok(None)
                    other -> Err(other)
                end
        end
    end

    fn delete(local: Local, key: String) -> Result<Unit, Error>
        check_key(key)?
        object = Local.object_path(local, key)

        is_file = case fs.metadata(object)
            Ok(meta) ->
                meta.kind == Kind.File

            Err(e) ->
                case missing(key, e)
                    .NotFound{} -> False
                    other -> return Err(other)
                end
        end

        if is_file then fs.remove(object) |> Result.map_err(fn e -> from_io(key, e))?

        case fs.remove(Local.type_path(local, key))
            Ok(_) ->
                Ok(Unit)

            Err(e) ->
                case missing(key, e)
                    .NotFound{} -> Ok(Unit)
                    other -> Err(other)
                end
        end
    end

    fn url(local: Local, key: String) -> Result<Url, Error>
        check_key(key)?

        case local.public_base
            Some(base) -> Ok(join_key(base, key))
            None -> Err(Error.NoPublicUrl)
        end
    end

    fn list(local: Local, options: ListOptions) -> Result<Listing, Error>
        check_prefix(options.prefix)?

        base = if String.ends_with(local.root, "/") then
            local.root
        else
            "${local.root}/"
        end

        entries =
            fs.walk(local.root)
            |> Iter.map(fn walked ->
                case walked
                    Ok(entry) when entry.kind == Kind.File ->
                        local_entry(base, entry.path, options.prefix)

                    Ok(_) ->
                        Ok(None)

                    Err(.NotFound{path:}) when path == local.root ->
                        Ok(None)

                    Err(e) ->
                        Err(from_io(options.prefix, e))
                end
            end)
            |> Result.collect()?

        Ok(page(Maybe.values(entries), options))
    end
end

// The entry for the file at `file`, under `base`, when it holds an object
// whose key starts with `prefix`: no segment of its path starts with `.`,
// which leaves out the types directory and a put's temporary files.
fn local_entry(base: String, file: String, prefix: String) -> Result<Maybe<Entry>, Error>
    segments = String.split(String.drop(file, String.length(base)), "/")
    if Iter.any_match(segments, fn s -> String.starts_with(s, ".")) then return Ok(None)
    key = segments |> Iter.map(key_segment) |> String.join("/")
    if not String.starts_with(key, prefix) then return Ok(None)
    meta = fs.metadata(file) |> Result.map_err(fn e -> from_io(key, e))?
    Ok(Some(Entry{key:, size: meta.size, modified: meta.modified}))
end

// A key's segment from its name on disk: each `%` and two hexadecimal
// digits `file_names` wrote is the character again.
fn key_segment(name: String) -> String
    case String.split(name, "%")
        [first, ..escaped] ->
            first + (escaped
            |> Iter.map(fn part ->
                code =
                    hex.decode(String.take(part, 2))
                    |> Result.flat_map(fn b ->
                        Bytes.to_string(b) |> Result.map_err(fn _ -> "not UTF-8")
                    end)

                case code
                    Ok(c) -> c + String.drop(part, 2)
                    Err(_) -> "%" + part
                end
            end)
            |> String.join(""))

        [] ->
            name
    end
end

// The names on disk of the segments of `key`, as `local` describes them.
fn file_names(key: String) -> List<String>
    String.split(key, "/") |> Iter.map(file_name) |> Iter.to_list()
end

fn file_name(segment: String) -> String
    codepoints = String.to_codepoints(segment)
    last = Iter.count(codepoints) - 1
    device = is_device_name(segment)

    codepoints
    |> Iter.with_index()
    |> Iter.map(fn (i, c) ->
        text = "${c}"

        escaped = String.contains("%<>:\"|?*", c)
            or i == last and (c == '.' or c == ' ')
            or i == 0 and device

        if escaped then "%${String.uppercase(hex.encode(String.to_bytes(text)))}" else text
    end)
    |> String.join("")
end

// Whether Windows keeps `segment` for a device: its part before the first
// `.`, in any case, is CON, PRN, AUX, NUL, or COM or LPT and a digit.
fn is_device_name(segment: String) -> Bool
    stem =
        String.split(segment, ".") |> Iter.first() |> Maybe.with_default("") |> String.uppercase()

    Iter.contains(["CON", "PRN", "AUX", "NUL"], stem)
        or String.length(stem) == 4
            and (String.starts_with(stem, "COM") or String.starts_with(stem, "LPT"))
            and String.contains("0123456789", String.drop(stem, 3))
end

// Create the directories above the file at `file`, which holds `key`.
fn make_parent(key: String, file: String) -> Result<Unit, Error>
    case path.parent(file)
        Some(dir) -> fs.create_dir(dir, parents: True) |> Result.map_err(fn e -> from_io(key, e))
        None -> Ok(Unit)
    end
end

// An io.Error from reading `key`, where a path that is not there, or a
// directory where a file was asked for, means no object has the key.
fn missing(key: String, error: io.Error) -> Error
    case error
        .NotADirectory{} -> Error.NotFound{key:}
        .IsADirectory{} -> Error.NotFound{key:}
        _ -> from_io(key, error)
    end
end

fn from_io(key: String, error: io.Error) -> Error
    case error
        .NotFound{} -> Error.NotFound{key:}
        .PermissionDenied{} -> Error.Denied{message: "${error}"}
        _ -> Error.Backend{code: io_code(error), message: "${error}"}
    end
end

fn io_code(error: io.Error) -> String
    case error
        .NotFound{} -> "NotFound"
        .AlreadyExists{} -> "AlreadyExists"
        .PermissionDenied{} -> "PermissionDenied"
        .NotADirectory{} -> "NotADirectory"
        .IsADirectory{} -> "IsADirectory"
        .DirectoryNotEmpty{} -> "DirectoryNotEmpty"
        .InvalidPath{} -> "InvalidPath"
        .InvalidText{} -> "InvalidText"
        .NoSpace{} -> "NoSpace"
        .ReadOnly{} -> "ReadOnly"
        .TooManyOpen -> "TooManyOpen"
        .Closed -> "Closed"
        .BrokenPipe -> "BrokenPipe"
        .TimedOut -> "TimedOut"
        .Unsupported{} -> "Unsupported"
        .Other{} -> "Other"
    end
end

/// A handler that serves `GET` and `HEAD` with the object whose key is the
/// request's path value `param`, with its stored content type. It handles
/// `Range` and conditional requests as `Response.content` does. A missing
/// object or an invalid key is a 404, `Denied` a 403, `Unavailable` a 503,
/// and any other error a 500.
///
/// ```nomi
/// files = storage.handler(App.store)
///
/// routes = [Route.to_with("GET /files/{key...}", fn r, _ -> files(r))]
/// ```
///
/// It sets no `Cache-Control`: an app whose keys never change wraps the
/// handler and adds one. It reads the whole object into memory first,
/// which suits images and documents, not video.
//! import std::http.{Method, Status}
//! import std::http_testing
//! import std::storage_testing.Memory
//!
//! store = Memory.new()
//! _ = Store.put(store, "a/b.css", String.to_bytes("p{}"), "text/css")
//! serve = handler(store)
//!
//! found = serve(
//!     Request.with_path_value(http_testing.request(Method.Get, "/files/a/b.css"), "key", "a/b.css")
//! )
//!
//! assert found.status == Status.ok
//! assert Headers.get(found.headers, "Content-Type") == Some("text/css")
//! assert Response.text(found) == Ok("p{}")
//!
//! missing = serve(Request.with_path_value(http_testing.request(Method.Get, "/files/x"), "key", "x"))
//! assert missing.status == Status.not_found
//
pub fn handler(store: Store, param: String = "key") -> (Request) -> Response
    fn request ->
        key = Request.path_value(request, param) |> Maybe.with_default("")

        case Store.get(store, key)
            Ok(object) ->
                response = Response.content(request, key, Some(object.info.modified), object.data)

                typed = response.status == Status.ok
                    or response.status == Status.partial_content
                        and not String.starts_with(
                            Headers.get(response.headers, "Content-Type")
                            |> Maybe.with_default(""),
                            "multipart/",
                        )

                if typed then
                    {
                        ..response,
                        headers: Headers.set(.., "Content-Type", object.info.content_type),
                    }
                else
                    response
                end

            Err(error) ->
                case error
                    .NotFound{} ->
                        Response.error(Status.not_found, "404 page not found")

                    .InvalidKey{} ->
                        Response.error(Status.not_found, "404 page not found")

                    .Denied{} ->
                        Response.error(Status.forbidden, "forbidden")

                    .Unavailable{} ->
                        Response.error(Status.service_unavailable, "service unavailable")

                    _ ->
                        Response.error(Status.internal_server_error, "internal server error")
                end
        end
    end
end
