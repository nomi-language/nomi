import {
    assertions.{Assertable, AssertionDetails}
    bool.Bool.{self, False, True}
    bytes.Bytes
    display.Display
    equatable.Equatable
    int.Int
    iter.Iter
    maybe.Maybe.{self, None, Some}
    results.Result.{self, Err, Ok}
    strings.String
    unit.Unit
}

/// What went wrong in an input or output operation: one error type for
/// files and the standard streams. A variant a program branches on names
/// the path it is about, as the program passed it. `Other` is a failure no
/// variant names: it keeps the operation (`"open"`, `"read"`), the path and
/// the operating system's error code (`"EIO"`), never the operating
/// system's own wording. `Display` writes a sentence for every variant.
///
/// ```nomi
/// case fs.read_text("notes.txt") {
///     Ok(text) -> io.print(text)
///     Err(#io.Error.NotFound{path: _}) -> io.print("no notes yet")
///     Err(e) -> io.eprint("cannot read the notes: ${e}")
/// }
/// ```
//! assert "${#Error.NotFound{path: "notes.txt"}}" == "notes.txt: not found"
//!
//! failed = #Error.Other{operation: "read", path: "a.txt", code: "EIO"}
//! assert "${failed}" == "read a.txt: input/output error (EIO)"
//!
//! refused = #Error.Unsupported{operation: "process.run", target: "js/wasm"}
//! assert "${refused}" == "process.run is not supported on js/wasm"
//! assert "${Error.TooManyOpen}" == "too many open files"
//
pub enum Error {
    /// Nothing is at `path`. A write into a missing directory names the
    /// directory.
    NotFound {path: String}
    /// Something is already at `path`.
    AlreadyExists {path: String}
    /// The operating system refused access to `path`.
    PermissionDenied {path: String}
    /// A directory was needed and `path` is something else.
    NotADirectory {path: String}
    /// A file was needed and `path` is a directory.
    IsADirectory {path: String}
    /// The directory at `path` still holds entries.
    DirectoryNotEmpty {path: String}
    /// `path` cannot name a file: it is empty or holds a NUL byte.
    InvalidPath {path: String, reason: String}
    /// What was read is not UTF-8 text. `offset` is the byte offset of the
    /// first sequence that is not, from the start of the file, or of the
    /// line for a line read. `path` is `<stdin>` for standard input.
    InvalidText {path: String, offset: Int}
    /// The device holding `path` is full.
    NoSpace {path: String}
    /// `path` is on a read-only file system.
    ReadOnly {path: String}
    /// The process has too many files open.
    TooManyOpen
    /// The stream was already closed.
    Closed
    /// The reader at the other end of a pipe has gone, as with `| head`.
    BrokenPipe
    /// The operation passed its deadline.
    TimedOut
    /// The target the program runs on cannot do `operation`, as
    /// starting a process in a js/wasm module.
    Unsupported {operation: String, target: String}
    /// Any other failure: the operation, the path and the operating system's
    /// error code.
    Other {operation: String, path: String, code: String}
}

derive Equatable for Error

impl Display for Error {
    fn to_string(e: Error) -> String {
        case e {
            #Error.NotFound{path} ->
                "${path}: not found"

            #Error.AlreadyExists{path} ->
                "${path}: already exists"

            #Error.PermissionDenied{path} ->
                "${path}: permission denied"

            #Error.NotADirectory{path} ->
                "${path}: not a directory"

            #Error.IsADirectory{path} ->
                "${path}: is a directory"

            #Error.DirectoryNotEmpty{path} ->
                "${path}: directory not empty"

            #Error.InvalidPath{path, reason} ->
                "invalid path \"${path}\": ${reason}"

            #Error.InvalidText{path, offset} ->
                "${path}: not UTF-8 text at byte ${offset}"

            #Error.NoSpace{path} ->
                "${path}: no space left on the device"

            #Error.ReadOnly{path} ->
                "${path}: read-only file system"

            Error.TooManyOpen ->
                "too many open files"

            Error.Closed ->
                "the stream is closed"

            Error.BrokenPipe ->
                "broken pipe"

            Error.TimedOut ->
                "timed out"

            #Error.Unsupported{operation, target} ->
                "${operation} is not supported on ${target}"

            #Error.Other{operation, path, code} ->
                "${operation} ${path}: ${code_text(code)} (${code})"
        }
    }
}

/// What an operating system error code means, for `Other`'s sentence.
fn code_text(code: String) -> String {
    case code {
        "EIO" -> "input/output error"
        "ELOOP" -> "too many levels of symbolic links"
        "ENAMETOOLONG" -> "file name too long"
        "EBUSY" -> "resource busy"
        "EXDEV" -> "cross-device link"
        "EINVAL" -> "invalid argument"
        "EAGAIN" -> "resource temporarily unavailable"
        "EFBIG" -> "file too large"
        "EMLINK" -> "too many links"
        "ENXIO" -> "no such device or address"
        "EINTR" -> "interrupted"
        "ENOTSUP" -> "operation not supported"
        _ -> "operating system error"
    }
}

/// Prints a value's user-facing representation to stdout, followed by a
/// newline. The argument may be any value whose type implements `Display` —
/// via an `impl Display for T` block or `derive Display` — and is stringified via
/// `Display.to_string`. `String` implements `Display` as the identity, so
/// `io.print("hello")` prints `hello` unchanged; no need to pre-stringify
/// other values. Use `io.inspect` for the developer-facing `Debug` form.
///
/// ```nomi
/// io.print("hello") // prints: hello
///
/// io.print(42) // prints: 42
/// ```
pub host fn print<T>(value: T) -> Unit where T: Display

/// Writes a value's user-facing representation to stdout with no trailing
/// newline. It renders exactly as `io.print` does, through
/// `Display.to_string`. Use it for a prompt that the user answers on the
/// same line, or to build one line of output from several writes.
///
/// ```nomi
/// io.write("> ") // prints: > (and no newline)
///
/// io.read_line() // the user types on the same line
/// ```
pub host fn write<T>(value: T) -> Unit where T: Display

/// Prints a value's runtime representation to stdout via `Debug.inspect`.
/// `Debug` is universal — every value is inspectable with no
/// `derive`/`impl` required (a structural impl is auto-synthesized for any
/// type that doesn't supply its own; opaque types render `<opaque T>`), so
/// `inspect` carries no `Debug` bound. Write an explicit `impl Debug`
/// implementation only to customize the rendering. Use `dbg` when you want to inspect a value
/// while preserving it in an expression or pipeline.
///
/// ```nomi
/// io.inspect([1, 2, 3]) // prints: [1, 2, 3]
/// ```
pub host fn inspect<T>(value: T) -> Unit

/// Prints a value's user-facing representation to stderr, followed by a
/// newline: `io.print` for the error stream. Use it for warnings, progress
/// and failures, which stay out of the output another program reads from
/// stdout.
///
/// ```nomi
/// io.eprint("warning: no config file, using defaults")
/// ```
//! run = capture("", fn -> {
//!     eprint("warning: low disk")
//!     print("done")
//! })
//!
//! assert run.output == "done\n"
//! assert run.errors == "warning: low disk\n"
//
pub host fn eprint<T>(value: T) -> Unit where T: Display

/// Writes a value's user-facing representation to stderr with no trailing
/// newline: `io.write` for the error stream.
///
/// ```nomi
/// io.ewrite("working...")
/// ```
//! run = capture("", fn -> {
//!     ewrite("a")
//!     ewrite(1)
//! })
//!
//! assert run.errors == "a1"
//
pub host fn ewrite<T>(value: T) -> Unit where T: Display

/// Reads the next line of standard input, without its `\n` and a `\r`
/// before it. Answers `Ok(None)` at the end of the input, and `Err` when the
/// read fails: `InvalidText` for a line that is not UTF-8. A last line with
/// no newline is still a line. Inside `io.capture` it reads the capture's
/// input instead. A task cancelled while the read waits for input stops
/// there at once, and the input that arrives later is the next read's.
///
/// ```nomi
/// case io.read_line() {
///     Ok(Some(name)) -> io.print("hello, ${name}")
///     _ -> io.print("hello, stranger")
/// }
/// ```
//! lines = capture("one\ntwo\r\n", fn -> [read_line(), read_line(), read_line()])
//! assert lines.value == [Result.Ok(Some("one")), Result.Ok(Some("two")), Result.Ok(None)]
//
pub host fn read_line() -> Result<Maybe<String>, Error>

/// Each line of standard input, as `io.read_line` reads them:
/// `Reader.lines(io.stdin)`, from the same buffer. It reads as it runs, so
/// a loop over it handles each line before the next is read, and it runs
/// once: a second run carries on from where the input is. Inside
/// `io.capture` it reads the capture's input.
///
/// ```nomi
/// io.lines()
/// |> Iter.each(fn line -> {
///     case line {
///         Ok(text) -> io.print(String.uppercase(text))
///         Err(e) -> io.eprint(e)
///     }
/// })
/// ```
//! run = capture("one\ntwo\n", fn -> {
//!     first = read_line()
//!     #(first, Result.collect(lines()))
//! })
//!
//! assert run.value == #(Result.Ok(Some("one")), Result.Ok(["two"]))
//
pub fn lines() -> Iter<Result<String, Error>> {
    Reader.lines(stdin)
}

/// A stream bytes are read from. Standard input is one (`io.stdin`). A
/// `Reader` is a value that names something outside the program: the value
/// never changes, and reading it moves the stream it names on.
pub host type Reader

/// A stream bytes are written to. Standard output and standard error are
/// two (`io.stdout`, `io.stderr`).
pub host type Writer

/// The program's standard input. `Reader.read_line(io.stdin)` reads what
/// `io.read_line()` reads, from the same buffer. The value names the
/// stream, not a place: inside `io.capture` it reads the capture's input,
/// even when it was read before the capture began.
pub once stdin: Reader = standard_input()

/// The program's standard output. `Writer.print(io.stdout, x)` writes where
/// `io.print(x)` writes, in order with it, and inside `io.capture` into the
/// capture's output.
//! import std/io
//!
//! w = io.stdout
//! run = capture("", fn -> Writer.print(w, "inside"))
//!
//! assert run.output == "inside\n"
//
pub once stdout: Writer = standard_output()

/// The program's standard error, where `io.eprint` writes.
pub once stderr: Writer = standard_error()

host fn standard_input() -> Reader

host fn standard_output() -> Writer

host fn standard_error() -> Writer

impl Reader {
    /// The next line without its `\n` (and a `\r` before it), or `Ok(None)`
    /// at the end of the stream. A last line with no newline is still a
    /// line. A line that is not UTF-8 is `InvalidText`, with the offset of
    /// the first bad byte in the line.
    ///
    /// ```nomi
    /// case Reader.read_line(io.stdin) {
    ///     Ok(Some(line)) -> io.print("got ${line}")
    ///     Ok(None) -> io.print("no input")
    ///     Err(e) -> io.eprint(e)
    /// }
    /// ```
    //! import std/io
    //!
    //! run = capture("a\nb", fn -> {
    //!     [Reader.read_line(io.stdin), io.read_line(), Reader.read_line(io.stdin)]
    //! })
    //!
    //! assert run.value == [Result.Ok(Some("a")), Result.Ok(Some("b")), Result.Ok(None)]
    //!
    //! r = Reader.from_text("one\r\ntwo")
    //!
    //! assert [Reader.read_line(r), Reader.read_line(r), Reader.read_line(r)] == [
    //!     Result.Ok(Some("one")),
    //!     Result.Ok(Some("two")),
    //!     Result.Ok(None),
    //! ]
    //
    pub host fn read_line(r: Reader) -> Result<Maybe<String>, Error>

    /// Up to `max` bytes, at least one, or `Ok(None)` at the end of the
    /// stream. A read answers what is ready, so it may answer fewer than
    /// `max` bytes before the end. `max` must be at least 1.
    ///
    /// ```nomi
    /// case Reader.read(r, max: 4096) {
    ///     Ok(Some(chunk)) -> Bytes.length(chunk)
    ///     Ok(None) -> 0
    ///     Err(_) -> -1
    /// }
    /// ```
    //! r = Reader.from_text("abcdef")
    //! assert Reader.read(r, max: 4) == Result.Ok(Some(String.to_bytes("abcd")))
    //! assert Reader.read(r) == Result.Ok(Some(String.to_bytes("ef")))
    //! assert Reader.read(r) == Result.Ok(None)
    //
    pub fn read(r: Reader, max: Int = 65536) -> Result<Maybe<Bytes>, Error> {
        read_up_to(r, max)
    }

    /// Everything left in the stream; after it the reader is at its end.
    ///
    /// ```nomi
    /// data = Reader.read_all(r)?
    /// ```
    //! r = Reader.from_text("a\nbc")
    //! _ = Reader.read_line(r)
    //! assert Reader.read_all(r) == Result.Ok(String.to_bytes("bc"))
    //! assert Reader.read_all(r) == Result.Ok(String.to_bytes(""))
    //
    pub host fn read_all(r: Reader) -> Result<Bytes, Error>

    /// Everything left in the stream as text. Bytes that are not UTF-8 are
    /// `InvalidText`, with the offset of the first bad one from where the
    /// read began.
    ///
    /// ```nomi
    /// text = Reader.read_all_text(io.stdin)?
    /// ```
    //! import std/io
    //!
    //! run = capture("one\ntwo\n", fn -> Reader.read_all_text(io.stdin))
    //! assert run.value == Result.Ok("one\ntwo\n")
    //!
    //! bad = Reader.from_bytes(Bytes.concat(String.to_bytes("hi"), Bytes.from_list([255])))
    //! assert Reader.read_all_text(bad) == Result.Err(#Error.InvalidText{path: "<bytes>", offset: 2})
    //
    pub host fn read_all_text(r: Reader) -> Result<String, Error>

    /// Each line left in the stream, without its `\n` and a `\r` before it,
    /// as `Reader.read_line` reads them. The iterator reads `r` as it runs,
    /// so it runs once: a second run carries on from where the stream is,
    /// which after a run to the end yields nothing. A failure (a line that
    /// is not UTF-8, a read that fails) is an item, and the last one. A
    /// consumer that stops early leaves the rest of the stream unread, and
    /// the reader open. `fs.lines(path)` opens the file on each run, so it
    /// can run again.
    ///
    /// ```nomi
    /// count = Reader.lines(r) |> Iter.count()
    /// ```
    //! r = Reader.from_text("pear\r\napple")
    //! each = Reader.lines(r)
    //!
    //! assert Result.collect(each) == Ok(["pear", "apple"])
    //! assert Iter.to_list(each) == []
    //!
    //! bad = Reader.from_bytes(Bytes.concat(String.to_bytes("ok\n"), Bytes.from_list([255, 10, 65])))
    //!
    //! assert Iter.to_list(Reader.lines(bad)) == [
    //!     Ok("ok"),
    //!     Err(#Error.InvalidText{path: "<bytes>", offset: 0}),
    //! ]
    //
    pub fn lines(r: Reader) -> Iter<Result<String, Error>> {
        Iter.repeat(r)
        |> Iter.scan(fn _: Result<String, Error> = Ok(""), reader -> {
            case Reader.read_line(reader) {
                Ok(Some(line)) -> Ok(line)
                Ok(None) -> break
                Err(e) -> break Err(e)
            }
        })
    }

    /// The rest of the stream in pieces of at most `size` bytes, as
    /// `Reader.read` reads them. Like `Reader.lines`, it reads `r` as it
    /// runs, so it runs once, and a failure is the last item.
    ///
    /// ```nomi
    /// sizes =
    ///     Reader.chunks(r, size: 4096)
    ///     |> Iter.map(fn chunk -> Result.map(chunk, Bytes.length))
    ///     |> Result.collect()
    /// ```
    //! r = Reader.from_text("abcde")
    //!
    //! assert Result.collect(Reader.chunks(r, size: 2)) == Ok([
    //!         String.to_bytes("ab"),
    //!         String.to_bytes("cd"),
    //!         String.to_bytes("e"),
    //!     ])
    //
    pub fn chunks(r: Reader, size: Int = 65536) -> Iter<Result<Bytes, Error>> {
        Iter.repeat(r)
        |> Iter.scan(fn _: Result<Bytes, Error> = Ok(String.to_bytes("")), reader -> {
            case Reader.read(reader, max: size) {
                Ok(Some(chunk)) -> Ok(chunk)
                Ok(None) -> break
                Err(e) -> break Err(e)
            }
        })
    }

    /// Copies everything left in `r` into `w` and answers how many bytes it
    /// copied. It reads and writes a chunk at a time, so a large file never
    /// has to fit in memory.
    ///
    /// ```nomi
    /// copied = Reader.copy_to(io.stdin, io.stdout)?
    /// ```
    //! import std/io
    //!
    //! run = capture("", fn -> Reader.copy_to(Reader.from_text("hello\n"), io.stdout))
    //! assert run.value == Result.Ok(6)
    //! assert run.output == "hello\n"
    //
    pub host fn copy_to(r: Reader, w: Writer) -> Result<Int, Error>

    /// Closes the stream. A second close is `Closed`, and so is any read
    /// after the first. Closing standard input does nothing.
    ///
    /// ```nomi
    /// Reader.close(r)?
    /// ```
    //! r = Reader.from_text("x")
    //! assert Reader.close(r) == Result.Ok(Unit)
    //! assert Reader.read_line(r) == Result.Err(Error.Closed)
    //! assert Reader.close(r) == Result.Err(Error.Closed)
    //
    pub host fn close(r: Reader) -> Result<Unit, Error>

    /// Closes the stream and ignores the outcome: the form for a `defer`,
    /// which cannot report a failure. A reader has nothing to lose on a
    /// failed close.
    ///
    /// ```nomi
    /// r = fs.open("notes.txt")?
    ///
    /// defer Reader.close_quietly(r)
    /// ```
    //! r = Reader.from_text("x")
    //! Reader.close_quietly(r)
    //! Reader.close_quietly(r)
    //! assert Reader.read_line(r) == Result.Err(Error.Closed)
    //
    pub fn close_quietly(r: Reader) -> Unit {
        _ = close(r)
    }

    /// A reader over bytes the program holds, for tests and for code
    /// written against `Reader`.
    ///
    /// ```nomi
    /// r = Reader.from_bytes(String.to_bytes("a\nb\n"))
    /// ```
    //! r = Reader.from_bytes(String.to_bytes("a\nb\n"))
    //! assert Reader.read_line(r) == Result.Ok(Some("a"))
    //
    pub host fn from_bytes(data: Bytes) -> Reader

    /// A reader over text the program holds.
    ///
    /// ```nomi
    /// r = Reader.from_text("pear\napple\n")
    /// ```
    //! r = Reader.from_text("pear\napple\n")
    //! assert Reader.read_all_text(r) == Result.Ok("pear\napple\n")
    //
    pub host fn from_text(text: String) -> Reader

    /// A reader that calls `next` each time it needs more bytes: `Ok(Some(chunk))`
    /// is the next chunk, `Ok(None)` the end of the stream, and `Err(e)` a
    /// failure the read that asked answers with. An empty chunk is skipped.
    /// `next` runs when a read needs it, on the task that reads, so a
    /// reader adapts any source a function can pull from. `next` must not
    /// read the reader it feeds.
    ///
    /// ```nomi
    /// yes = Reader.from_fn(fn -> Ok(Some(String.to_bytes("y\n"))))
    /// ```
    //! inner = Reader.from_text("a\nb\n")
    //! one_byte_at_a_time = Reader.from_fn(fn -> Reader.read(inner, max: 1))
    //!
    //! assert Reader.read_line(one_byte_at_a_time) == Result.Ok(Some("a"))
    //! assert Reader.read_all_text(one_byte_at_a_time) == Result.Ok("b\n")
    //!
    //! failing = Reader.from_fn(fn -> Result.Err(Error.TimedOut))
    //! assert Reader.read_line(failing) == Result.Err(Error.TimedOut)
    //
    pub host fn from_fn(next: () -> Result<Maybe<Bytes>, Error>) -> Reader

    /// A reader over a sequence of chunks, pulled one at a time as reads
    /// need them, so the sequence may be long or never end. The sequence
    /// runs on the task of the first read. Closing the reader stops it.
    ///
    /// ```nomi
    /// r = Reader.from_chunks([String.to_bytes("ab"), String.to_bytes("c\n")])
    /// ```
    //! r = Reader.from_chunks([String.to_bytes("one\ntw"), String.to_bytes("o\n")])
    //! assert Reader.read_line(r) == Result.Ok(Some("one"))
    //! assert Reader.read_line(r) == Result.Ok(Some("two"))
    //! assert Reader.read_line(r) == Result.Ok(None)
    //!
    //! endless = Reader.from_chunks(Iter.repeat(String.to_bytes("y\n")))
    //! assert Reader.read_line(endless) == Result.Ok(Some("y"))
    //! assert Reader.close(endless) == Result.Ok(Unit)
    //
    pub host fn from_chunks(chunks: Iter<Bytes>) -> Reader

    /// A reader over a sequence of text chunks, as `from_chunks` is over
    /// bytes.
    ///
    /// ```nomi
    /// r = Reader.from_text_chunks(["pear\n", "apple\n"])
    /// ```
    //! r = Reader.from_text_chunks(
    //!     Iter.from(1)
    //!     |> Iter.map(fn n -> "${n}\n")
    //! )
    //!
    //! assert [Reader.read_line(r), Reader.read_line(r)] == [Result.Ok(Some("1")), Result.Ok(Some("2"))]
    //
    pub host fn from_text_chunks(chunks: Iter<String>) -> Reader
}

/// Up to max bytes from r, for `Reader.read`.
host fn read_up_to(r: Reader, max: Int) -> Result<Maybe<Bytes>, Error>

impl Writer {
    /// Writes `data` to the stream as it is. A writer over a file buffers
    /// what it is given; `flush` and `close` send it on.
    ///
    /// ```nomi
    /// Writer.write(io.stdout, String.to_bytes("hi\n"))
    /// ```
    //! import std/io
    //!
    //! run = capture("", fn -> Writer.write(io.stderr, String.to_bytes("oops")))
    //! assert run.value == Result.Ok(Unit)
    //! assert run.errors == "oops"
    //
    pub host fn write(w: Writer, data: Bytes) -> Result<Unit, Error>

    /// Writes text to the stream as it is, with no newline added.
    ///
    /// ```nomi
    /// Writer.write_text(w, "# generated\n")
    /// ```
    //! import std/io
    //!
    //! run = capture("", fn -> Writer.write_text(io.stdout, "a"))
    //! assert run.output == "a"
    //
    pub host fn write_text(w: Writer, text: String) -> Result<Unit, Error>

    /// Writes a value's user-facing representation and a newline to the
    /// stream, as `io.print` does to stdout.
    ///
    /// ```nomi
    /// Writer.print(io.stderr, "warning: low disk")
    /// ```
    //! import std/io
    //!
    //! run = capture("", fn -> {
    //!     io.print("one")
    //!     _ = Writer.print(io.stdout, 2)
    //!     _ = Writer.print(io.stderr, "three")
    //! })
    //!
    //! assert run.output == "one\n2\n"
    //! assert run.errors == "three\n"
    //
    pub fn print<T>(w: Writer, value: T) -> Result<Unit, Error> where T: Display {
        write_text(w, "${value}\n")
    }

    /// Sends what the writer has buffered on to the file it writes. The
    /// standard streams are not buffered, so flushing one does nothing.
    ///
    /// ```nomi
    /// Writer.flush(w)?
    /// ```
    //! import std/io
    //!
    //! assert Writer.flush(io.stdout) == Result.Ok(Unit)
    //
    pub host fn flush(w: Writer) -> Result<Unit, Error>

    /// Flushes the stream and closes it, and answers whether everything
    /// written reached the file: a failed close of a written file means
    /// data may be lost. A second close is `Closed`, and so is any write
    /// after the first. Closing a standard stream does nothing.
    ///
    /// ```nomi
    /// Writer.close(w)?
    /// ```
    //! import std/io
    //!
    //! assert Writer.close(io.stdout) == Result.Ok(Unit)
    //
    pub host fn close(w: Writer) -> Result<Unit, Error>

    /// Closes the stream and ignores the outcome: the form for a `defer` on
    /// a writer kept past one body. Prefer `fs.with_writer`, which closes
    /// and reports a failed close.
    ///
    /// ```nomi
    /// w = fs.create("out.txt")?
    ///
    /// defer Writer.close_quietly(w)
    /// ```
    //! import std/io
    //!
    //! run = capture("", fn -> Writer.close_quietly(io.stdout))
    //! assert run.value == Unit
    //
    pub fn close_quietly(w: Writer) -> Unit {
        _ = close(w)
    }

    /// Writes each chunk in order and stops at the first failure, which it
    /// answers. A chunk is pulled when the one before it is written, so the
    /// sequence may be long.
    ///
    /// ```nomi
    /// Writer.write_all(w, [header, body])?
    /// ```
    //! #(written, data) = Writer.collect(fn w -> {
    //!     Writer.write_all(w, [String.to_bytes("ab"), String.to_bytes("c")])
    //! })
    //!
    //! assert written == Result.Ok(Unit)
    //! assert data == String.to_bytes("abc")
    //
    pub fn write_all(w: Writer, chunks: Iter<Bytes>) -> Result<Unit, Error> {
        Iter.reduce(chunks, fn written: Result<Unit, Error> = Ok(Unit), chunk -> {
            case Writer.write(w, chunk) {
                Ok(_) -> written
                failed -> break failed
            }
        })
    }

    /// Writes each item's user-facing representation followed by `\n`, as
    /// `Writer.print` writes one, and stops at the first failure, which it
    /// answers.
    ///
    /// ```nomi
    /// Writer.write_lines(io.stdout, ["pear", "apple"])?
    /// ```
    //! #(_, data) = Writer.collect(fn w -> {
    //!     Writer.write_lines(
    //!         w,
    //!         Iter.from(1)
    //!         |> Iter.take(3),
    //!     )
    //! })
    //!
    //! assert data == String.to_bytes("1\n2\n3\n")
    //!
    //! full = Writer.from_fn(unbuffered: True, fn _ -> Result.Err(Error.BrokenPipe))
    //! assert Writer.write_lines(full, ["a", "b"]) == Result.Err(Error.BrokenPipe)
    //
    pub fn write_lines<T>(w: Writer, lines: Iter<T>) -> Result<Unit, Error> where T: Display {
        Iter.reduce(lines, fn written: Result<Unit, Error> = Ok(Unit), line -> {
            case Writer.write_text(w, "${line}\n") {
                Ok(_) -> written
                failed -> break failed
            }
        })
    }

    /// A writer that hands what is written to `write`, for code written
    /// against `Writer` that should send its bytes somewhere a function can
    /// reach: a channel, a list, another writer. The writer is buffered, so
    /// `write` receives what accumulated when the buffer fills and on
    /// `flush` and `close`, and the boundaries of the program's writes are
    /// not kept; with `unbuffered: True` each write reaches `write` as it is
    /// made. `close`, named, runs when the writer is closed, after the last
    /// bytes. An `Err` from either is the error the write, flush or close
    /// answers, and a buffered writer answers a failed send's error to every
    /// later write, as a writer over a file does. Both run on the task that
    /// writes, flushes or closes. `write` may write to another writer, but
    /// not to the one it is fed by.
    ///
    /// Close the writer when done: once the program no longer holds it, or
    /// when the program ends, what it still buffers is dropped, since
    /// nothing may run `write` then.
    ///
    /// ```nomi
    /// w = Writer.from_fn(fn chunk -> Channel.send(sender, chunk))
    /// ```
    //! #(_, data) = Writer.collect(fn sink -> {
    //!     upper = Writer.from_fn(fn chunk -> {
    //!         text = Bytes.to_string(chunk) |> Result.with_default("")
    //!         Writer.write_text(sink, String.uppercase(text))
    //!     })
    //!
    //!     _ = Writer.write_text(upper, "hello, ")
    //!     _ = Writer.write_text(upper, "world")
    //!     Writer.close(upper)
    //! })
    //!
    //! assert data == String.to_bytes("HELLO, WORLD")
    //!
    //! failing = Writer.from_fn(unbuffered: True, fn _ -> Result.Err(#Error.NoSpace{path: "disk"}))
    //! assert Writer.write_text(failing, "x") == Result.Err(#Error.NoSpace{path: "disk"})
    //
    pub fn from_fn(
        close: () -> Result<Unit, Error> = fn -> Ok(Unit),
        unbuffered: Bool = False,
        write: (Bytes) -> Result<Unit, Error>,
    ) -> Writer {
        writer_from_fn(write, close, unbuffered)
    }

    /// Calls `body` with a writer into memory and answers what `body`
    /// returned and every byte it wrote. The writer is closed when `body`
    /// returns, so a write through it after that is `Closed`. It is the
    /// writer a test hands code written against `Writer`;
    /// `Bytes.to_string` reads the bytes as text.
    ///
    /// ```nomi
    /// #(_, data) = Writer.collect(fn w -> Writer.print(w, "hi"))
    /// ```
    //! #(value, data) = Writer.collect(fn w -> {
    //!     _ = Writer.print(w, "one")
    //!     _ = Writer.write(w, String.to_bytes("two"))
    //!     42
    //! })
    //!
    //! assert value == 42
    //! assert Bytes.to_string(data) == Result.Ok("one\ntwo")
    //!
    //! #(kept, _) = Writer.collect(fn w -> w)
    //! assert Writer.write_text(kept, "late") == Result.Err(Error.Closed)
    //
    pub fn collect<T>(body: (Writer) -> T) -> #(T, Bytes) {
        w = memory_writer()
        value = body(w)
        _ = close(w)
        #(value, collected(w))
    }
}

/// `Writer.from_fn`.
host fn writer_from_fn(
    write: (Bytes) -> Result<Unit, Error>,
    close: () -> Result<Unit, Error>,
    unbuffered: Bool,
) -> Writer

/// The writer into memory `Writer.collect` hands its body.
host fn memory_writer() -> Writer

/// Everything written to a `memory_writer`.
host fn collected(w: Writer) -> Bytes

/// One file open for reads and writes at a position, from `fs.open_file`.
///
/// A `Reader` and a `Writer` are streams: read or written front to back,
/// through a buffer. A `File` is not. Each call is one operation on the
/// file, with no buffer between the program and the file, so a write is in
/// the file when the call returns and the next read sees it. `File.read`
/// and `File.write` start at the file's position and move it on;
/// `File.read_at` and `File.write_at` name their own position and leave
/// the file's where it was. For reading or writing a whole file in order,
/// `fs.open` and `fs.create` are the simpler handles.
pub host type File

impl File {
    /// Up to `max` bytes at the position, which moves past them, or
    /// `Ok(None)` at or past the end. `max` must be at least 1.
    ///
    /// ```nomi
    /// header = File.read(f, max: 16)?
    /// ```
    pub fn read(f: File, max: Int = 65536) -> Result<Maybe<Bytes>, Error> {
        file_read(f, max)
    }

    /// Up to `max` bytes at `position`, or `Ok(None)` at or past the end.
    /// The file's position stays where it was.
    ///
    /// ```nomi
    /// record = File.read_at(f, 512 * n, max: 512)?
    /// ```
    pub host fn read_at(f: File, position: Int, max: Int) -> Result<Maybe<Bytes>, Error>

    /// Writes `data` at the position, which moves past it. A file opened
    /// with `Access.Read` is `PermissionDenied`.
    ///
    /// ```nomi
    /// File.write(f, String.to_bytes("hello"))?
    /// ```
    pub host fn write(f: File, data: Bytes) -> Result<Unit, Error>

    /// Writes `data` at `position`. A position past the end fills the gap
    /// with zero bytes. The file's position stays where it was.
    ///
    /// ```nomi
    /// File.write_at(f, 0, header)?
    /// ```
    pub host fn write_at(f: File, position: Int, data: Bytes) -> Result<Unit, Error>

    /// Moves the position to `position`, counted in bytes from the start.
    /// From the end is `File.seek(f, File.size(f)? - n)`, and from here
    /// `File.seek(f, File.position(f)? + n)`.
    ///
    /// ```nomi
    /// File.seek(f, 0)?
    /// ```
    pub host fn seek(f: File, position: Int) -> Result<Unit, Error>

    /// The position `File.read` and `File.write` start at.
    pub host fn position(f: File) -> Result<Int, Error>

    /// The file's size in bytes now.
    pub host fn size(f: File) -> Result<Int, Error>

    /// Makes the file `size` bytes long: what is past it is dropped, and a
    /// longer size adds zero bytes. The position stays where it was.
    ///
    /// ```nomi
    /// File.truncate(f, 0)?
    /// ```
    pub host fn truncate(f: File, size: Int) -> Result<Unit, Error>

    /// Closes the file. A second close is `Closed`, as is every call on a
    /// closed file. `fs.with_file` closes it for you.
    pub host fn close(f: File) -> Result<Unit, Error>

    /// Closes the file and ignores the outcome: the form for a `defer`.
    pub fn close_quietly(f: File) -> Unit {
        _ = close(f)
    }
}

host fn file_read(f: File, max: Int) -> Result<Maybe<Bytes>, Error>

/// What `io.capture` answers: the value `run` returned, everything it
/// printed to stdout and to stderr, and its stdout and input together as a
/// transcript.
pub struct Captured<T> {
    /// What `run` returned.
    value: T
    /// Everything `io.print`, `io.write` and `io.inspect` wrote while `run`
    /// ran, byte for byte, and what `Writer.write` and `Writer.print` wrote
    /// to `io.stdout`.
    output: String
    /// Everything `io.eprint`, `io.ewrite` and the writes to `io.stderr`
    /// wrote while `run` ran, byte for byte. It is not in the transcript.
    errors: String
    /// `output` with each line `run` read written in where it was read, in
    /// the form an `io.replay` script takes. A line read is four spaces, `> `
    /// and exactly the text read. Every output line is the line as `run`
    /// wrote it, except one that would read as input (indented, then `> `):
    /// it gets a backslash before its `>`. Part of a line written before a
    /// read (a prompt such as `io.write("age: ")`) is an output line of its
    /// own, and the line read follows it: `age: ` then `    > 36`. A read at
    /// the end of the input adds nothing, and its prompt stays where it was,
    /// on one line with whatever is printed next.
    transcript: String
}

/// Calls `run` with `input` as its standard input and answers what it
/// returned together with everything it printed.
///
/// While `run` runs, `io.read_line` reads `input` one line at a time and
/// answers `Ok(None)` once it is used up, `io.print`, `io.write` and
/// `io.inspect` append to `output` instead of writing to stdout, and
/// `io.eprint` and `io.ewrite` append to `errors` instead of writing to
/// stderr. The standard stream handles (`io.stdin`, `io.stdout`,
/// `io.stderr`) reach the capture the same way. Tasks started inside
/// `run` are captured too. `dbg` and files are not redirected
/// (`fs_testing.run` gives a call its own files). An inner `io.capture`
/// takes over for its own call, so its output and reads land only in its own `Captured`.
/// If `run` traps, the trap propagates and the captured output is dropped.
///
/// Passing a program's `main` is how a test checks what the program prints
/// for a given input: `io.capture("the fox the dog\n", main)`. For a
/// program that asks and answers in turn, `io.replay` reads better. A
/// program that reads nothing is checked through `output`, which holds the
/// output as it was written.
//! run = capture("", fn -> {
//!     print("hi")
//!     write(1)
//!     42
//! })
//!
//! assert run.value == 42
//! assert run.output == "hi\n1"
//!
//! echo = capture("one\ntwo", fn -> [read_line(), read_line(), read_line()])
//! assert echo.value == [Result.Ok(Some("one")), Result.Ok(Some("two")), Result.Ok(None)]
//! assert echo.output == ""
//!
//! asked = capture("Ada", fn -> {
//!     write("name: ")
//!
//!     case read_line() {
//!         Ok(Some(name)) -> print("hello, ${name}")
//!         _ -> print("hello, stranger")
//!     }
//! })
//!
//! assert asked.output == "name: hello, Ada\n"
//! assert asked.transcript == "name: \n    > Ada\nhello, Ada\n"
//
pub fn capture<T>(input: String, run: () -> T) -> Captured<T> {
    run_captured(input, run, fn value, output, errors, transcript -> #Captured{
        value,
        output,
        errors,
        transcript,
    })
}

/// Calls `run` under a capture of `input` and hands its result, output,
/// error output and transcript to `finish`, which builds the `Captured`.
/// Answered by the VM.
host fn run_captured<T>(
    input: String,
    run: () -> T,
    finish: (T, String, String, String) -> Captured<T>,
) -> Captured<T>

/// What `io.replay` answers. `assert` holds on it when the transcript
/// matches the script, and its failure shows a line diff of the two. It
/// does not hold what `run` returned; use `io.capture` to check that.
pub struct Replayed {
    /// Everything `run` printed, byte for byte, as in `Captured`.
    output: String
    /// The transcript, as `io.replay` compares it: each line without its
    /// trailing whitespace and ending in a newline, the last one included.
    transcript: String
    /// The script, compared the same way.
    expected: String
    /// How many of the script's input lines `run` never read.
    unread: Int
}

impl Assertable for Replayed {
    fn failure(replayed: Replayed) -> Maybe<AssertionDetails> {
        if replayed.transcript == replayed.expected and replayed.unread == 0 {
            None
        } else {
            Some(#AssertionDetails{
                reason: replay_reason(replayed),
                actual: Some(replayed.transcript),
                expected: Some(replayed.expected),
            })
        }
    }
}

fn replay_reason(replayed: Replayed) -> String {
    case replayed.unread {
        0 -> "the transcript differs from the script"
        1 -> "1 input line of the script was never read"
        n -> "${n} input lines of the script were never read"
    }
}

/// Runs `run` against a script of an interactive session and answers a
/// `Replayed` that `assert` checks: `assert io.replay(script, main)`.
///
/// The script is the session, output and input in order. A line indented
/// past the script's left edge whose text starts with `> ` is input: what
/// follows `> ` is the line typed, fed to `io.read_line` in order, and `>`
/// alone is an empty line. Every other line is output the program must
/// print, exactly as written, indented or not, and a blank line is a blank
/// output line. In a `"""` script the left edge is the closing quotes'
/// column, so write output there and indent the input lines under it.
///
/// A prompt written before a read (`io.write("age: ")`) is output on a line
/// of its own, with the input on the next line. An output line that would
/// read as input, indented and then `> `, is written with a backslash
/// before its `>`: `    \> not input`. Only that backslash is special; any
/// other is the character itself.
///
/// `run` runs as under `io.capture`, and its transcript must equal the
/// script. Trailing spaces, tabs and carriage returns on each line, and a
/// final newline, do not count, so a `"""` script, which drops its last
/// newline, matches output that ends in one, and a prompt's trailing space
/// need not be written. Once the script's input is used up, `io.read_line`
/// answers `Ok(None)`, and that read adds nothing to the transcript; the
/// prompt it answered stays on one line with what is printed next. An input
/// line the program never read fails the replay. A failure shows a line
/// diff: `-` lines are only in the script, `+` lines only in what the
/// program did.
///
/// A script holds stdout only. What `run` writes to stderr is captured and
/// dropped: it neither appears in the transcript nor fails the replay, so a
/// program's warnings need not be written into every script. Check them
/// with `io.capture`'s `errors`.
//! greet = fn -> {
//!     write("name: ")
//!
//!     case read_line() {
//!         Ok(Some(name)) -> print("hello, ${name}")
//!         _ -> print("hello, stranger")
//!     }
//! }
//!
//! assert replay(
//!     """
//!     name:
//!         > Ada
//!     hello, Ada
//!     """,
//!     greet,
//! )
//!
//! assert replay(
//!     """
//!     name: hello, stranger
//!     """,
//!     greet,
//! )
//!
//! table = fn -> {
//!     print("-10.0 C |   14.0 F")
//!     print(" -5.0 C |   23.0 F")
//! }
//!
//! assert replay(
//!     """
//!     -10.0 C |   14.0 F
//!      -5.0 C |   23.0 F
//!     """,
//!     table,
//! )
//!
//! refute replay(
//!     """
//!     name:
//!         > Ada
//!         > Grace
//!     hello, Ada
//!     """,
//!     greet,
//! )
//!
//! repl = fn -> {
//!     write("> ")
//!
//!     case read_line() {
//!         Ok(Some(word)) -> print("you said ${word}")
//!         _ -> print("bye")
//!     }
//! }
//!
//! assert replay(
//!     """
//!     >
//!         > hey
//!     you said hey
//!     """,
//!     repl,
//! )
//!
//! warned = fn -> {
//!     eprint("warning: no config")
//!     print("ready")
//! }
//!
//! assert replay(
//!     """
//!     ready
//!     """,
//!     warned,
//! )
//!
//! quoted = fn -> print("    > not input")
//!
//! assert replay(
//!     """
//!         \> not input
//!     """,
//!     quoted,
//! )
//
pub fn replay<T>(script: String, run: () -> T) -> Replayed {
    run_replayed(script, run, fn _, output, transcript, expected, unread -> #Replayed{
        output,
        transcript,
        expected,
        unread,
    })
}

/// Calls `run` under a capture whose input is the script's input lines and
/// hands `finish` its result, its output, the transcript and the script as
/// replay compares them, and the count of input lines never read. Answered
/// by the VM.
host fn run_replayed<T>(
    script: String,
    run: () -> T,
    finish: (T, String, String, String, Int) -> Replayed,
) -> Replayed
