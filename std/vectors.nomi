import
    add.Add
    averageable.Averageable
    bool.Bool
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.{Int, NonNegativeInt, PositiveInt}
    iter.Iter
    option.Option.{self, None, Some}
    strings.String
    summable.Summable
end

//# `Vector<T>`: an immutable sequence with fast lookup by index and fast
//# append at the end. Use a `List<T>` for recursion over a head and a tail
//# and for cheap prepends; use a `Vector<T>` when looking up by index and
//# appending at the end are the common operations. Every `Iter` function
//# works on a Vector, and `Iter.to_vector` collects any sequence into one.

/// An immutable sequence with fast lookup by index. Write one as
/// `Vector[1, 2, 3]`, or as a list literal where a Vector is expected.
pub host type Vector<T>

impl Vector<T>
    /// The number of elements. The vector stores its count, so this does not
    /// walk the elements.
    //! assert Vector.length(["a", "b"]) == 2
    //
    pub host fn length<T>(vector: Vector<T>) -> NonNegativeInt

    /// Returns the element at zero-based `index`, or None when the index is
    /// outside the vector. Use it when the index comes from data and may miss;
    /// for an index that must exist, `Vector.get(vector, index)!` returns the
    /// element and traps on any other index.
    //! assert Vector.get(["a", "b"], 1) == Some("b")
    //! assert Vector.get(["a", "b"], 9) == None
    //! assert Vector.get(["a", "b"], -1) == None
    //! assert Vector.get(["a", "b"], 1)! == "b"
    //
    pub host fn get<T>(vector: Vector<T>, index: Int) -> Option<T>

    /// Returns a new vector with `item` appended to the end. O(log32 n).
    //! assert Vector.push([1, 2], 3) == [1, 2, 3]
    //
    pub host fn push<T>(vector: Vector<T>, item: T) -> Vector<T>

    /// `Some` of a new vector with `item` replacing the element at zero-based
    /// `index`, in O(log32 n), or None when the index is outside the vector.
    /// For an index the code knows is in range, `Vector.set(vector, index,
    /// item)!` returns the new vector and traps on any other index.
    //! assert Vector.set(["a", "b"], 1, "z") == Some(["a", "z"])
    //! assert Vector.set(["a", "b"], 2, "z") == None
    //! assert Vector.set(["a", "b"], 0, "z")! == ["z", "b"]
    //
    pub host fn set<T>(vector: Vector<T>, index: Int, item: T) -> Option<Vector<T>>

    /// Concatenates two vectors, in time linear in the length of `b`.
    //! assert Vector.concat([1, 2], [3]) == [1, 2, 3]
    //
    pub host fn concat<T>(a: Vector<T>, b: Vector<T>) -> Vector<T>

    /// Returns the next element and remaining vector, or None if empty. Drives the
    /// `Iter` implementation for `Vector`.
    //! assert Vector.next_item([1, 2]) == Some((1, [2]))
    //! assert Vector.next_item([]) == None
    //
    pub host fn next_item<T>(vector: Vector<T>) -> Option<(T, Vector<T>)>

    /// The elements from index `start` up to, not including, `stop`. An
    /// index outside the vector is clamped to it, and a `stop` at or before
    /// `start` gives the empty vector, as `Bytes.slice` and `String.slice`
    /// answer. O(1): the slice shares the vector's storage, and a push onto
    /// it later copies only what that push would.
    //! assert Vector.slice(["a", "b", "c", "d"], 1, 3) == ["b", "c"]
    //! assert Vector.slice(["a", "b"], 1, 99) == ["b"]
    //! assert Vector.slice(["a", "b"], 2, 1) == []
    //
    pub host fn slice<T>(vector: Vector<T>, start: Int, stop: Int) -> Vector<T>

    /// Returns the last element and the vector without it, or None if the
    /// vector is empty: `Vector.next_item` from the other end, which makes
    /// a Vector a stack. O(log32 n): the rest is a slice.
    //! assert Vector.pop([1, 2, 3]) == Some((3, [1, 2]))
    //! assert Vector.pop([]) == None
    //
    pub fn pop<T>(vector: Vector<T>) -> Option<(T, Vector<T>)>
        case vector
            [..rest, last] -> Some((last, rest))
            []             -> None
        end
    end

    /// `Some` of a new vector with `item` at zero-based `index` and the
    /// elements from there on after it, or None when the index is outside
    /// `0` up to the length. At the length it is `Vector.push`, in
    /// O(log32 n); anywhere else the elements are copied, in O(n).
    //! assert Vector.insert(["a", "c"], 1, "b") == Some(["a", "b", "c"])
    //! assert Vector.insert(["a"], 1, "b") == Some(["a", "b"])
    //! assert Vector.insert(["a"], 2, "b") == None
    //
    pub fn insert<T>(vector: Vector<T>, index: Int, item: T) -> Option<Vector<T>>
        n = Vector.length(vector)
        if index < 0 or index > n then return None
        before = Vector.push(Vector.slice(vector, 0, index), item)
        Some(Vector.concat(before, Vector.slice(vector, index, n)))
    end

    /// `Some` of the vector without the element at zero-based `index`, or
    /// None when the index is outside the vector. The first or the last
    /// element is removed in O(1), as a slice; any other in O(n), as the
    /// elements are copied. For an index the code knows is in range,
    /// `Vector.remove_at(vector, index)!` returns the vector and traps on any
    /// other index.
    //! assert Vector.remove_at(["a", "b", "c"], 1) == Some(["a", "c"])
    //! assert Vector.remove_at(["a", "b", "c"], 0)! == ["b", "c"]
    //! assert Vector.remove_at(["a", "b", "c"], 3) == None
    //
    pub fn remove_at<T>(vector: Vector<T>, index: Int) -> Option<Vector<T>>
        n = Vector.length(vector)
        if index < 0 or index >= n then return None
        Some(Vector.concat(Vector.slice(vector, 0, index), Vector.slice(vector, index + 1, n)))
    end
end

impl Iter for Vector<T>
    // Host-side: a Vector is a window over a persistent trie, so the push loop
    // walks it a leaf at a time with no per-element view to rebuild.
    host fn each_while(vector: Vector<T>, yield: (T) -> Bool) -> Bool

    fn known_count(vector: Vector<T>) -> Option<Int>
        Some(length(vector))
    end
end

impl Contains for Vector<T> where T: Equatable
    /// True if an element of the vector is `==` to `x`. A linear scan that
    /// the runtime runs, comparing each element as `==` does; convert to a
    /// `Set` for repeated lookups.
    //! assert Vector.contains(Vector[1, 2, 3], 2)
    //! refute Vector.contains(Vector[1, 2, 3], 9)
    //! empty: Vector<Int> = []
    //! refute Vector.contains(empty, 1)
    //
    host fn contains(c: Vector<T>, x: T) -> Bool
end

impl Add<Vector<T>, Vector<T>> for Vector<T>
    /// `a + b` is `Vector.concat(a, b)`.
    //! assert Vector[1, 2] + Vector[3] == [1, 2, 3]
    //! assert Vector["a"] + Vector[] == ["a"]
    //
    fn add(lhs: Vector<T>, rhs: Vector<T>) -> Vector<T>
        concat(lhs, rhs)
    end
end

impl Summable for Vector<T>
    /// The sum of no Vectors: the empty Vector. Summing Vectors concatenates
    /// them in order.
    //! none: Vector<Int> = Vector.empty_sum()
    //! assert Vector.length(none) == 0
    //! assert Vector[1, 2] + Vector.empty_sum() == [1, 2]
    //! assert Iter.sum([Vector[1], Vector[2, 3]]) == [1, 2, 3]
    //
    fn empty_sum() -> Vector<T>
        []
    end
end

impl Display for Vector<T> where T: Display
    fn to_string(vector: Vector<T>) -> String
        body =
            vector
            |> Iter.map(fn item -> "${item}")
            |> String.join(", ")

        "Vector[" + body + "]"
    end
end

impl Debug for Vector<T>
    fn inspect(vector: Vector<T>) -> String
        body =
            vector
            |> Iter.map(&Debug.inspect(&1))
            |> String.join(", ")

        "Vector[" + body + "]"
    end
end

impl Equatable for Vector<T>
    fn equal(a: Vector<T>, b: Vector<T>) -> Bool
        a == b
    end
end

impl Hashable for Vector<T> where T: Hashable
    fn hash(vector: Vector<T>) -> Int
        Iter.reduce(vector, 19, fn acc, x ->
            Int.wrapping_add(Int.wrapping_mul(acc, 31), Hashable.hash(x))
        end)
    end
end

impl Comparable for Vector<T> where T: Comparable
    fn compare(a: Vector<T>, b: Vector<T>) -> Ordering
        case Vector.next_item(a)
            None ->
                case Vector.next_item(b)
                    None -> Equal
                    _    -> Less
                end

            Some((ha, ta)) ->
                case Vector.next_item(b)
                    None ->
                        Greater

                    Some((hb, tb)) ->
                        case Comparable.compare(ha, hb)
                            Equal -> compare(ta, tb)
                            other -> other
                        end
                end
        end
    end
end

/// A Vector with at least one element, so its first, last, largest and
/// smallest elements are values rather than `Option`s. A literal is checked
/// when the program is compiled; `NonEmptyVector.try_from(v)` checks a
/// Vector computed at run time, and `NonEmptyVector.push(v, item)` builds
/// one from any Vector. A NonEmptyVector is a Vector and passes wherever one
/// is expected. It is in the prelude.
//! v: NonEmptyVector<Int> = [4, 8, 2]
//! assert NonEmptyVector.last(v) == 2
//! assert NonEmptyVector.min(v) == 2
//! assert Vector.get(v, 1) == Some(8)
//!
//! none: Vector<Int> = []
//! assert NonEmptyVector.try_from(none) == None
//
pub refine NonEmptyVector<T> Vector<T> when fn vector -> Vector.length(vector) > 0

impl NonEmptyVector<T>
    /// A NonEmptyVector of `first` followed by the elements of `rest`, which
    /// may be empty.
    //! assert NonEmptyVector.of(1, [2, 3]) == Vector[1, 2, 3]
    //
    pub fn of<T>(first: T, rest: Vector<T>) -> NonEmptyVector<T>
        NonEmptyVector.unchecked(Vector.concat([first], rest))
    end

    /// The first element.
    //! assert NonEmptyVector.first([4, 5]) == 4
    //
    pub fn first<T>(vector: NonEmptyVector<T>) -> T
        Vector.get(vector, 0)!
    end

    /// The last element.
    //! assert NonEmptyVector.last([4, 5]) == 5
    //
    pub fn last<T>(vector: NonEmptyVector<T>) -> T
        Vector.get(vector, Vector.length(vector) - 1)!
    end

    /// The number of elements, at least one.
    //! assert NonEmptyVector.length(["a", "b"]) == 2
    //
    pub fn length<T>(vector: NonEmptyVector<T>) -> PositiveInt
        Iter.count(vector)
    end

    /// The largest element; the first of several equal ones.
    //! assert NonEmptyVector.max([3, 9, 4]) == 9
    //
    pub fn max<T>(vector: NonEmptyVector<T>) -> T where T: Comparable
        Iter.max(vector)!
    end

    /// The smallest element; the first of several equal ones.
    //! assert NonEmptyVector.min([3, 9, 4]) == 3
    //
    pub fn min<T>(vector: NonEmptyVector<T>) -> T where T: Comparable
        Iter.min(vector)!
    end

    /// The arithmetic mean of the elements, rounded as `Iter.mean` rounds;
    /// a value, since there is at least one.
    //! assert NonEmptyVector.mean([2, 4]) == 3.0
    //
    pub fn mean<T, R>(vector: NonEmptyVector<T>) -> R where T: Averageable<R>
        Iter.mean(vector)!
    end

    /// Combines the elements left to right with `f`, starting from the
    /// first, so it needs no starting value.
    //! assert NonEmptyVector.reduce([1, 2, 3], fn acc, n -> acc * n) == 6
    //
    pub fn reduce<T>(vector: NonEmptyVector<T>, f: (T, T) -> T) -> T
        Iter.reduce(Iter.drop(vector, 1), first(vector), f)
    end

    /// Applies `f` to each element; the result has as many elements.
    //! assert NonEmptyVector.map([1, 2], fn n -> n + 1) == Vector[2, 3]
    //
    pub fn map<T, U>(vector: NonEmptyVector<T>, f: (T) -> U) -> NonEmptyVector<U>
        NonEmptyVector.unchecked(
            Iter.map(vector, f)
            |> Iter.to_vector()
        )
    end

    /// Each element with its index, from 0.
    //! assert NonEmptyVector.with_index(["a"]) == Vector[(0, "a")]
    //
    pub fn with_index<T>(vector: NonEmptyVector<T>) -> NonEmptyVector<(NonNegativeInt, T)>
        NonEmptyVector.unchecked(
            Iter.with_index(vector)
            |> Iter.to_vector()
        )
    end

    /// The elements of `vector`, which may be empty, then `item`.
    //! assert NonEmptyVector.push(Vector[1], 2) == Vector[1, 2]
    //! empty: Vector<Int> = []
    //! assert NonEmptyVector.push(empty, 2) == Vector[2]
    //
    pub fn push<T>(vector: Vector<T>, item: T) -> NonEmptyVector<T>
        NonEmptyVector.unchecked(Vector.push(vector, item))
    end

    /// The elements of `a`, then those of `b`, which may be empty.
    //! assert NonEmptyVector.concat([1], Vector[2, 3]) == Vector[1, 2, 3]
    //
    pub fn concat<T>(a: NonEmptyVector<T>, b: Vector<T>) -> NonEmptyVector<T>
        NonEmptyVector.unchecked(Vector.concat(a, b))
    end
end
