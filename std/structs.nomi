//# `Struct` — the interface every struct satisfies, named or anonymous. Its
//# sole function, `update`, returns a copy of a struct with selected fields
//# replaced, and is reached type-qualified: `Struct.update(original, updates)`.
//#
//# `Distinct<T>` — the interface every distinct type `type X T` satisfies. It
//# has no functions; it is a bound that lets an interface default take
//# `self` apart (`self(n)`) and build one (`self(x)`).

/// The universal struct interface. Every struct value — a named `struct` type
/// or an anonymous `#{...}` — satisfies `Struct`, so its functions are callable on
/// any of them; no non-struct type satisfies it. `Struct` is also usable as a
/// bound (`fn f<T>(x: T) -> T where T: Struct`) and an existential (`fn f(s: Struct)`).
pub interface Struct {
    // `Partial<T>` (used below) is a compiler-known built-in type operator — a
    // partial of struct T, valid only in parameter position. It has no
    // import and no declaration anywhere in stdlib (unlike `List`/`Map`, which
    // are real `host type`s): it has no inhabitants, so it's recognized by name
    // in the resolver (analysis/type_resolver.go's `case "Partial"`) and lowers
    // to the deep-partial matcher.
    /// Returns a new struct with fields from `updates` merged into `original`.
    /// Non-overlapping fields on the original are preserved; fields present on
    /// both take the value from `updates`. `updates` is a `Partial<self>`: it
    /// may omit fields, and each field it writes is a whole value, or a
    /// literal with a bare `..` that updates the field's current value
    /// (`#{address: #{.., city: "NYC"}}` changes only the city).
    ///
    /// ```nomi
    /// original = #Point{x: 1, y: 2}
    /// Struct.update(original, #{x: 10})  // → #Point{x: 10, y: 2}
    /// ```
    host fn update(original: self, updates: Partial<self>) -> self
}

/// The universal distinct-type interface. Every distinct type that wraps a
/// value, `type Celsius Decimal`, satisfies `Distinct<T>` for exactly the type
/// it wraps, so `Celsius` is a `Distinct<Decimal>`; a zero-sized `type Done`
/// wraps nothing and satisfies no `Distinct<T>`. It is never implemented by
/// hand.
///
/// It has no functions. Its use is the bound `where self: Distinct<T>` on an
/// interface default, which lets the default take the implementing type apart
/// with the pattern `self(p)` and build one with `self(x)`, so a family of
/// distinct types shares one body:
///
/// ```nomi
/// interface Temperature {
///     fn unit(t: self) -> String
///
///     fn label(self(n) as t) -> String where self: Distinct<Decimal> {
///         "${Decimal.round(n, 1, .HalfUp)} ${Temperature.unit(t)}"
///     }
///
///     fn scale(self(n), by: Decimal) -> self where self: Distinct<Decimal> {
///         self(n * by)
///     }
/// }
/// ```
///
/// `T` may be a type parameter of the interface, so one interface serves
/// wrappers of different types. An opaque type implemented outside its own
/// file gets no default that uses `self(p)` or `self(x)`; it writes that
/// function instead.
pub interface Distinct<T> {}
