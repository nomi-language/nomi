import
    add.Add
    bool.Bool
    comparable.Comparable
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.{Int, NonNegativeInt, PositiveInt}
    iter.Iter
    lists.{List, NonEmptyList}
    maybe.Maybe.{self, None, Some}
    strings.String
    summable.Summable
end

//# Operations on the insertion-ordered `Map<K, V>` type. Map-specific ops
//# (`Map.map_values`, `Map.map_keys`, `Map.keys`/`values`, `Map.size`, ...)
//# live here; the generic iteration ops (`Iter.reduce`, `Iter.find`,
//# `Iter.each`, `Iter.count`, `Iter.to_list`, ...) are `Iter`
//# functions, applied to a `Map` because it iterates as `Iter<(K, V)>`.
//# `Map.size` is the map's own O(1) count; the generic count is `Iter.count`.
//# `a + b` merges two maps, the right-hand map winning on a shared key.
//# For lazy pipelines, use `Iter`; materialize back with
//# `Iter.to_map`.
//#
//# Maps iterate in insertion order, and every transformation keeps it. A
//# map element is a `(K, V)` pair, so every generic `Iter` op
//# (`Iter.reduce`, `Iter.each`, `Iter.find`, `Iter.filter`, ...) takes a
//# single tuple parameter, and filtering or generically mapping a map is
//# `Iter.filter(m, p) |> Iter.to_map()`. `Map.map_values` and `Map.map_keys`
//# stay on `Map` because a generic map or filter cannot keep the other half
//# of a pair, or could collide keys.

/// Immutable hash map from `K` to `V`. `a + b` is `Map.merge(a, b)`.
//! ages = {"ann" => 31, "bo" => 12, "cy" => 19}
//!
//! // Iter.filter gives an Iter<(K, V)>; Iter.to_map materializes it.
//! adults =
//!     ages
//!     |> Iter.filter(fn (_, age) -> age > 18)
//!     |> Iter.to_map()
//!
//! assert adults == {"ann" => 31, "cy" => 19}
//! assert Map.keys(adults) == ["ann", "cy"]
//
pub host type Map<K, V>

impl Map<K, V>
    /// Gets a value by key. Returns Some(value) if the key is present, None
    /// otherwise. When the program guarantees the key is there, as it does
    /// for a key it took from the map itself, `Map.get(m, key)!` returns the
    /// value and traps on a missing key.
    //! assert Map.get({"a" => 1, "b" => 2}, "a") == Some(1)
    //! assert Map.get({"a" => 1, "b" => 2}, "z") == None
    //! assert Map.get({"a" => 1, "b" => 2}, "b")! == 2
    //
    pub host fn get<K, V>(m: Map<K, V>, key: K) -> Maybe<V>

    /// Returns a new map with the key-value pair added or updated.
    //! assert Map.put({"a" => 1}, "b", 2) == {"a" => 1, "b" => 2}
    //! assert Map.put({"a" => 1}, "a", 9) == {"a" => 9}
    //
    pub host fn put<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V>

    /// Returns a new map with the key removed. No-op if the key is absent.
    //! assert Map.remove({"a" => 1, "b" => 2}, "a") == {"b" => 2}
    //
    pub host fn remove<K, V>(m: Map<K, V>, key: K) -> Map<K, V>

    /// Merges two maps. Values from the second map win on key conflict.
    /// `a + b` is the same call.
    //! assert Map.merge({"a" => 1}, {"a" => 9, "b" => 2}) == {"a" => 9, "b" => 2}
    //
    pub host fn merge<K, V>(a: Map<K, V>, b: Map<K, V>) -> Map<K, V>

    /// Merges two maps, combining the values of a key both hold:
    /// `combine(a_value, b_value)` is its value in the result. A key only
    /// one map holds keeps its value. The order is `Map.merge`'s: `a`'s
    /// keys, then the keys only `b` holds, in `b`'s order.
    //! assert Map.merge_with({"a" => 1, "b" => 2}, {"b" => 10, "c" => 3}, Int.add) == {
    //!     "a" => 1,
    //!     "b" => 12,
    //!     "c" => 3,
    //! }
    //!
    //! assert Map.merge_with({"x" => [1]}, {"x" => [2]}, fn a, b -> a + b) == {"x" => [1, 2]}
    //
    pub fn merge_with<K, V>(a: Map<K, V>, b: Map<K, V>, combine: (V, V) -> V) -> Map<K, V>
        Iter.reduce(b, a, fn merged, (key, value) ->
            case Map.get(a, key)
                Some(mine) -> Map.put(merged, key, combine(mine, value))
                None       -> Map.put(merged, key, value)
            end
        end)
    end

    /// Changes the value under `key` to `f` of it. When `key` is missing,
    /// `f` is applied to `default`, and the key is added at the end. So
    /// `default` is the value a missing key is taken to have, and counting
    /// one more is `Map.update(counts, word, 0, &(&1 + 1))`; counting every
    /// value of an iteration is `Iter.frequencies`. Elixir's `Map.update`
    /// differs: it stores a missing key's default unchanged.
    //! assert Map.update({"a" => 1}, "a", 0, &(&1 + 1)) == {"a" => 2}
    //! assert Map.update({"a" => 1}, "b", 0, &(&1 + 1)) == {"a" => 1, "b" => 1}
    //
    pub fn update<K, V>(m: Map<K, V>, key: K, default: V, f: (V) -> V) -> Map<K, V>
        before = Map.get(m, key) |> Maybe.with_default(default)
        Map.put(m, key, f(before))
    end

    /// Returns the next key-value pair and remaining map, or None if empty.
    /// Drives the `Iter` implementation for `Map`.
    //! assert Map.map_next({"a" => 1}) == Some((("a", 1), {}))
    //
    pub host fn map_next<K, V>(m: Map<K, V>) -> Maybe<((K, V), Map<K, V>)>

    /// Returns the number of entries in the map. O(1) — read from the backing
    /// map's size (host-backed), not folded.
    //! assert Map.size({"a" => 1, "b" => 2}) == 2
    //! m: Map<String, Int> = {}
    //! assert Map.size(m) == 0
    //
    pub host fn size<K, V>(m: Map<K, V>) -> NonNegativeInt

    /// Returns all keys as a list, in insertion order.
    //! assert Map.keys({"a" => 1, "b" => 2}) == ["a", "b"]
    //
    pub fn keys<K, V>(m: Map<K, V>) -> List<K>
        Iter.map(m, fn (k, _) -> k) |> Iter.to_list()
    end

    /// Returns all values as a list, in insertion order of the keys.
    //! assert Map.values({"a" => 1, "b" => 2}) == [1, 2]
    //
    pub fn values<K, V>(m: Map<K, V>) -> List<V>
        Iter.map(m, fn (_, v) -> v) |> Iter.to_list()
    end

    /// Transforms each value by applying a function. Keys are unchanged.
    //! assert Map.map_values({"a" => 1, "b" => 2}, &(&1 * 10)) == {"a" => 10, "b" => 20}
    //
    pub fn map_values<K, V, U>(m: Map<K, V>, f: (V) -> U) -> Map<K, U>
        Iter.map(m, fn (k, v) -> (k, f(v))) |> Iter.to_map()
    end

    /// Transforms each key by applying a function. Collisions resolve
    /// last-write-wins in insertion order.
    //! assert Map.map_keys({"a" => 1, "b" => 2}, &(&1 + "!")) == {"a!" => 1, "b!" => 2}
    //
    pub fn map_keys<K, V, J>(m: Map<K, V>, f: (K) -> J) -> Map<J, V>
        Iter.map(m, fn (k, v) -> (f(k), v)) |> Iter.to_map()
    end
end

impl Contains for Map<K, V>
    /// True if `x` is a key of the map: a hash lookup. A value is not a key.
    //! assert Map.contains({"a" => 1}, "a")
    //! refute Map.contains({"a" => 1}, "z")
    //! refute Map.contains({"a" => "b"}, "b")
    //! empty: Map<String, Int> = {}
    //! refute Map.contains(empty, "a")
    //
    fn contains(c: Map<K, V>, x: K) -> Bool
        Map.get(c, x) |> Maybe.is_some()
    end
end

impl Iter for Map<K, V>
    // Host-side: the push loop reads the insertion-ordered entries once, so a
    // full walk costs one sort instead of one O(log n) delete per element.
    host fn each_while(m: Map<K, V>, yield: ((K, V)) -> Bool) -> Bool

    // A Map stores its entry count, so report it directly (O(1)).
    fn known_count(m: Map<K, V>) -> Maybe<Int>
        Some(size(m))
    end
end

impl Display for Map<K, V> where K: Display, V: Display
    fn to_string(value: Map<K, V>) -> String
        // Render `{k1 => v1, k2 => v2}`, or `{}` when empty, as a map literal
        // is written. Entries follow the map's insertion order.
        if Map.size(value) == 0 then
            "{}"
        else
            body =
                value
                |> Iter.map(fn (k, v) -> "${k} => ${v}")
                |> String.join(", ")

            "{" + body + "}"
        end
    end
end

impl Debug for Map<K, V>
    fn inspect(value: Map<K, V>) -> String
        if Map.size(value) == 0 then
            "{}"
        else
            body =
                value
                |> Iter.map(fn (k, v) -> Debug.inspect(k) + " => " + Debug.inspect(v))
                |> String.join(", ")

            "{" + body + "}"
        end
    end
end

impl Equatable for Map<K, V>
    // Structural equality via the built-in `==`, which compares map contents
    // order-insensitively. Lets a record with a Map field `derive Equatable`.
    // Map is Hashable but intentionally not Comparable: there is no natural
    // total order for maps.
    fn equal(a: Map<K, V>, b: Map<K, V>) -> Bool
        a == b
    end
end

impl Hashable for Map<K, V> where K: Hashable, V: Hashable
    // Order-insensitive hash: combine per-entry hashes with a commutative `+`, so
    // it agrees with `==` (which ignores insertion order). Requires Hashable keys
    // and values.
    fn hash(m: Map<K, V>) -> Int
        Iter.reduce(m, 0, fn acc, (k, v) ->
            Int.wrapping_add(
                acc,
                Int.wrapping_add(Int.wrapping_mul(Hashable.hash(k), 31), Hashable.hash(v)),
            )
        end)
    end
end

impl Add<Map<K, V>, Map<K, V>> for Map<K, V>
    /// `a + b` is `Map.merge(a, b)`: the right-hand map wins on a shared key.
    //! assert {"a" => 1} + {"a" => 9, "b" => 2} == {"a" => 9, "b" => 2}
    //! empty: Map<String, Int> = {}
    //! assert empty + {"a" => 1} == {"a" => 1}
    //
    fn add(a: Map<K, V>, rhs: Map<K, V>) -> Map<K, V>
        Map.merge(a, rhs)
    end
end

impl Summable for Map<K, V>
    /// The sum of no Maps: the empty Map. Summing Maps merges them in order
    /// with `+`, so on a shared key the later map's value wins.
    //! empty: Map<String, Int> = Map.empty_sum()
    //! assert Map.size(empty) == 0
    //! assert {"a" => 1} + Map.empty_sum() == {"a" => 1}
    //! assert Iter.sum([{"a" => 1}, {"a" => 9, "b" => 2}]) == {"a" => 9, "b" => 2}
    //
    fn empty_sum() -> Map<K, V>
        {}
    end
end

/// A Map with at least one entry. A literal is checked when the program is
/// compiled, so `{}` where a NonEmptyMap is expected is an error before the
/// program runs; `NonEmptyMap.try_from(m)` checks a Map computed at run
/// time, and `NonEmptyMap.put(m, key, value)` builds one from any Map.
/// Its keys and values are NonEmptyLists, and its first and last entries
/// are values rather than `Maybe`s. A NonEmptyMap is a Map and passes
/// wherever one is expected. It is in the prelude.
//! ages: NonEmptyMap<String, Int> = {"ann" => 31, "bo" => 12}
//! assert NonEmptyMap.first_entry(ages) == ("ann", 31)
//! assert NonEmptyList.max(NonEmptyMap.values(ages)) == 31
//! assert Map.get(ages, "bo") == Some(12)
//!
//! none: Map<String, Int> = {}
//! assert NonEmptyMap.try_from(none) == None
//
pub subtype NonEmptyMap<K, V> Map<K, V> when fn m -> Map.size(m) > 0

impl NonEmptyMap<K, V>
    /// A NonEmptyMap of `key` mapped to `value`, then the entries of
    /// `rest`, which may be empty; `rest`'s value wins if it holds `key`.
    //! assert NonEmptyMap.of("a", 1, {"b" => 2}) == {"a" => 1, "b" => 2}
    //
    pub fn of<K, V>(key: K, value: V, rest: Map<K, V>) -> NonEmptyMap<K, V>
        NonEmptyMap.unchecked(Map.merge({key => value}, rest))
    end

    /// The number of entries, at least one. O(1).
    //! assert NonEmptyMap.size({"a" => 1}) == 1
    //
    pub fn size<K, V>(m: NonEmptyMap<K, V>) -> PositiveInt
        PositiveInt.try_from(Iter.count(m))!
    end

    /// The entry inserted first.
    //! assert NonEmptyMap.first_entry({"a" => 1, "b" => 2}) == ("a", 1)
    //
    pub fn first_entry<K, V>(m: NonEmptyMap<K, V>) -> (K, V)
        Iter.first(m)!
    end

    /// The entry inserted last.
    //! assert NonEmptyMap.last_entry({"a" => 1, "b" => 2}) == ("b", 2)
    //
    pub fn last_entry<K, V>(m: NonEmptyMap<K, V>) -> (K, V)
        Iter.last(m)!
    end

    /// The entry `key` ranks largest; the first of several equal ones.
    //! assert NonEmptyMap.max_by({"a" => 3, "b" => 9}, fn (_, v) -> v) == ("b", 9)
    //
    pub fn max_by<K, V, C>(m: NonEmptyMap<K, V>, key: ((K, V)) -> C) -> (K, V) where C: Comparable
        Iter.max_by(m, key)!
    end

    /// The entry `key` ranks smallest; the first of several equal ones.
    //! assert NonEmptyMap.min_by({"a" => 3, "b" => 9}, fn (_, v) -> v) == ("a", 3)
    //
    pub fn min_by<K, V, C>(m: NonEmptyMap<K, V>, key: ((K, V)) -> C) -> (K, V) where C: Comparable
        Iter.min_by(m, key)!
    end

    /// The keys, in insertion order.
    //! assert NonEmptyMap.keys({"a" => 1, "b" => 2}) == ["a", "b"]
    //
    pub fn keys<K, V>(m: NonEmptyMap<K, V>) -> NonEmptyList<K>
        NonEmptyList.try_from(Map.keys(m))!
    end

    /// The values, in insertion order.
    //! assert NonEmptyMap.values({"a" => 1, "b" => 2}) == [1, 2]
    //
    pub fn values<K, V>(m: NonEmptyMap<K, V>) -> NonEmptyList<V>
        NonEmptyList.try_from(Map.values(m))!
    end

    /// Applies `f` to each value, keeping the keys.
    //! assert NonEmptyMap.map_values({"a" => 1}, fn n -> n * 2) == {"a" => 2}
    //
    pub fn map_values<K, V, U>(m: NonEmptyMap<K, V>, f: (V) -> U) -> NonEmptyMap<K, U>
        NonEmptyMap.unchecked(Map.map_values(m, f))
    end

    /// `m`, which may be empty, with `key` mapped to `value`.
    //! assert NonEmptyMap.put({"a" => 1}, "b", 2) == {"a" => 1, "b" => 2}
    //! empty: Map<String, Int> = {}
    //! assert NonEmptyMap.put(empty, "a", 1) == {"a" => 1}
    //
    pub fn put<K, V>(m: Map<K, V>, key: K, value: V) -> NonEmptyMap<K, V>
        NonEmptyMap.unchecked(Map.put(m, key, value))
    end

    /// The entries of `a`, then those of `b`, which may be empty; `b`'s
    /// value wins on a shared key.
    //! assert NonEmptyMap.merge({"a" => 1}, {"a" => 5, "b" => 2}) == {"a" => 5, "b" => 2}
    //
    pub fn merge<K, V>(a: NonEmptyMap<K, V>, b: Map<K, V>) -> NonEmptyMap<K, V>
        NonEmptyMap.unchecked(Map.merge(a, b))
    end
end
