import {
    add.Add
    bool.Bool
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.Int
    iter.Iter
    lists.List
    maybe.Maybe.{self, None, Some}
    strings.String
    summable.Summable
}

//# Operations on the insertion-ordered `Map<K, V>` type. Map-specific ops
//# (`Map.map_values`, `Map.map_keys`, `Map.keys`/`values`, `Map.size`, ...)
//# live here; the generic iteration ops (`Iter.reduce`, `Iter.find`,
//# `Iter.each`, `Iter.count`, `Iter.to_list`, ...) are `Iter`
//# functions, applied to a `Map` because it iterates as `Iter<#(K, V)>`.
//# `Map.size` is the map's own O(1) count; the generic count is `Iter.count`.
//# `a + b` merges two maps, the right-hand map winning on a shared key.
//# For lazy pipelines, use `Iter`; materialize back with
//# `Iter.to_map`.

/// Immutable hash map from `K` to `V`. `a + b` is `Map.merge(a, b)`.
pub host type Map<K, V>

impl Map<K, V> {
    /// Gets a value by key. Returns Some(value) if the key is present, None otherwise.
    //! assert Map.get(%{"a" => 1, "b" => 2}, "a") == Some(1)
    //! assert Map.get(%{"a" => 1, "b" => 2}, "z") == None
    //
    pub host fn get<K, V>(m: Map<K, V>, key: K) -> Maybe<V>

    /// Returns a new map with the key-value pair added or updated.
    //! assert Map.put(%{"a" => 1}, "b", 2) == %{"a" => 1, "b" => 2}
    //! assert Map.put(%{"a" => 1}, "a", 9) == %{"a" => 9}
    //
    pub host fn put<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V>

    /// Returns a new map with the key removed. No-op if the key is absent.
    //! assert Map.remove(%{"a" => 1, "b" => 2}, "a") == %{"b" => 2}
    //
    pub host fn remove<K, V>(m: Map<K, V>, key: K) -> Map<K, V>

    /// Merges two maps. Values from the second map win on key conflict.
    /// `a + b` is the same call.
    //! assert Map.merge(%{"a" => 1}, %{"a" => 9, "b" => 2}) == %{"a" => 9, "b" => 2}
    //
    pub host fn merge<K, V>(a: Map<K, V>, b: Map<K, V>) -> Map<K, V>

    /// Returns the next key-value pair and remaining map, or None if empty.
    /// Drives the `Iter` implementation for `Map`.
    //! assert Map.map_next(%{"a" => 1}) == Some(#(#("a", 1), %{}))
    //
    pub host fn map_next<K, V>(m: Map<K, V>) -> Maybe<#(#(K, V), Map<K, V>)>

    /// Returns the number of entries in the map. O(1) — read from the backing
    /// map's size (host-backed), not folded.
    //! assert Map.size(%{"a" => 1, "b" => 2}) == 2
    //! m: Map<String, Int> = %{}
    //! assert Map.size(m) == 0
    //
    pub host fn size<K, V>(m: Map<K, V>) -> Int

    /// Returns all keys as a list, in insertion order.
    //! assert Map.keys(%{"a" => 1, "b" => 2}) == ["a", "b"]
    //
    pub fn keys<K, V>(m: Map<K, V>) -> List<K> {
        Iter.map(m, fn #(k, _) -> k) |> Iter.to_list()
    }

    /// Returns all values as a list, in insertion order of the keys.
    //! assert Map.values(%{"a" => 1, "b" => 2}) == [1, 2]
    //
    pub fn values<K, V>(m: Map<K, V>) -> List<V> {
        Iter.map(m, fn #(_, v) -> v) |> Iter.to_list()
    }

    /// Transforms each value by applying a function. Keys are unchanged.
    //! assert Map.map_values(%{"a" => 1, "b" => 2}, &(&1 * 10)) == %{"a" => 10, "b" => 20}
    //
    pub fn map_values<K, V, U>(m: Map<K, V>, f: (V) -> U) -> Map<K, U> {
        Iter.map(m, fn #(k, v) -> #(k, f(v))) |> Iter.to_map()
    }

    /// Transforms each key by applying a function. Collisions resolve
    /// last-write-wins in insertion order.
    //! assert Map.map_keys(%{"a" => 1, "b" => 2}, &(&1 + "!")) == %{"a!" => 1, "b!" => 2}
    //
    pub fn map_keys<K, V, J>(m: Map<K, V>, f: (K) -> J) -> Map<J, V> {
        Iter.map(m, fn #(k, v) -> #(f(k), v)) |> Iter.to_map()
    }
}

impl Contains for Map<K, V> {
    /// True if `x` is a key of the map: a hash lookup. A value is not a key.
    //! assert Map.contains?(%{"a" => 1}, "a")
    //! refute Map.contains?(%{"a" => 1}, "z")
    //! refute Map.contains?(%{"a" => "b"}, "b")
    //! empty: Map<String, Int> = %{}
    //! refute Map.contains?(empty, "a")
    //
    fn contains?(c: Map<K, V>, x: K) -> Bool {
        Map.get(c, x) |> Maybe.some?()
    }
}

impl Iter for Map<K, V> {
    // Host-side: the push loop reads the insertion-ordered entries once, so a
    // full walk costs one sort instead of one O(log n) delete per element.
    host fn each_while(m: Map<K, V>, yield: (#(K, V)) -> Bool) -> Bool

    // A Map stores its entry count, so report it directly (O(1)).
    fn known_count(m: Map<K, V>) -> Maybe<Int> {
        Some(size(m))
    }
}

impl Display for Map<K, V> where K: Display, V: Display {
    fn to_string(value: Map<K, V>) -> String {
        // Render `%{k1 => v1, k2 => v2}`, or `%{}` when empty, as a map literal
        // is written. Entries follow the map's insertion order.
        if Map.size(value) == 0 {
            "%{}"
        } else {
            body =
                value
                |> Iter.map(fn #(k, v) -> "${k} => ${v}")
                |> String.join(", ")

            "%{" + body + "}"
        }
    }
}

impl Debug for Map<K, V> {
    fn inspect(value: Map<K, V>) -> String {
        if Map.size(value) == 0 {
            "%{}"
        } else {
            body =
                value
                |> Iter.map(fn #(k, v) -> Debug.inspect(k) + " => " + Debug.inspect(v))
                |> String.join(", ")

            "%{" + body + "}"
        }
    }
}

impl Equatable for Map<K, V> {
    // Structural equality via the built-in `==`, which compares map contents
    // order-insensitively. Lets a record with a Map field `derive Equatable`.
    // Map is Hashable but intentionally not Comparable: there is no natural
    // total order for maps.
    fn equal?(a: Map<K, V>, b: Map<K, V>) -> Bool {
        a == b
    }
}

impl Hashable for Map<K, V> where K: Hashable, V: Hashable {
    // Order-insensitive hash: combine per-entry hashes with a commutative `+`, so
    // it agrees with `==` (which ignores insertion order). Requires Hashable keys
    // and values.
    fn hash(m: Map<K, V>) -> Int {
        Iter.reduce(m, fn acc = 0, #(k, v) -> {
            Int.wrapping_add(
                acc,
                Int.wrapping_add(Int.wrapping_mul(Hashable.hash(k), 31), Hashable.hash(v)),
            )
        })
    }
}

impl Add<Map<K, V>, Map<K, V>> for Map<K, V> {
    /// `a + b` is `Map.merge(a, b)`: the right-hand map wins on a shared key.
    //! assert %{"a" => 1} + %{"a" => 9, "b" => 2} == %{"a" => 9, "b" => 2}
    //! empty: Map<String, Int> = %{}
    //! assert empty + %{"a" => 1} == %{"a" => 1}
    //
    fn add(a: Map<K, V>, rhs: Map<K, V>) -> Map<K, V> {
        Map.merge(a, rhs)
    }
}

impl Summable for Map<K, V> {
    /// The sum of no Maps: the empty Map. Summing Maps merges them in order
    /// with `+`, so on a shared key the later map's value wins.
    //! empty: Map<String, Int> = Map.empty_sum()
    //! assert Map.size(empty) == 0
    //! assert %{"a" => 1} + Map.empty_sum() == %{"a" => 1}
    //! assert Iter.sum([%{"a" => 1}, %{"a" => 9, "b" => 2}]) == %{"a" => 9, "b" => 2}
    //
    fn empty_sum() -> Map<K, V> {
        %{}
    }
}
