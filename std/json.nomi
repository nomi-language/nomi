import {
    bool.Bool.{self, True}
    debug.Debug
    display.Display
    dynamic.Dynamic
    equatable.Equatable
    float.Float
    int.Int
    iter.Iter
    lists.List
    maps.Map
    maybe.Maybe.{self, None, Some}
    results.Result
    results.Result.{Err, Ok}
    sets.Set
    strings.String
    vectors.Vector
}

/// Tagged enum representing a parsed JSON value.
///
/// Variant names align with the Nomi-side type names rather than the
/// JSON spec's vocabulary — `String String`, `Int Int`, `Float Float`,
/// `Bool Bool` keep the payload type visible at the pattern site so
/// `case jv { Int(n) -> ... }` reads as the obvious shape match.
///
/// **Number representation note:** JSON has a single number type. `Json`
/// distinguishes `Int(Int)` from `Float(Float)` at parse time based on whether
/// the source has a decimal point or an exponent. An integer of any length is
/// an exact `Int`, as JSON text allows. This
/// makes integer fields easy to pattern-match while still preserving fractional
/// values. Text round-trips are not representation-preserving for this split:
/// `encode(Json.Float(36.0))` emits `36`.
pub enum Json {
    String String
    Int Int
    Float Float
    Bool Bool
    Arr List<Json>
    Obj Map<String, Json>
    Null
}

impl Json {
    /// Parse a JSON document into a `Json` tree. Returns `Err` with
    /// a structured `Json.DecodeError` on syntax errors, type errors, or
    /// trailing content past the first value.
    ///
    /// Numbers are decoded as `Int`, exactly and at any size, when they
    /// have no fractional part or exponent; otherwise as `Float`. See the
    /// `Json` doc-comment for the rationale.
    //! assert Json.decode("{\"ok\":true,\"n\":42}")
    //!     == Result.Ok(%Json.Obj{"ok" => Json.Bool(True), "n" => Json.Int(42)})
    //!
    //! assert Json.decode("123456789012345678901234567890")
    //!     == Result.Ok(Json.Int(123_456_789_012_345_678_901_234_567_890))
    //!
    //! assert Result.is_err(Json.decode("{"))
    //
    pub host fn decode(source: String) -> Result<Json, Json.DecodeError>

    /// Serialize a `Json` tree as compact JSON text (no whitespace
    /// between tokens).
    ///
    /// Number-rendering note: `Float(36.0)` renders as `"36"`, not `"36.0"`.
    /// The `Int`/`Float` distinction captured by `decode` therefore does
    /// not necessarily survive a text round-trip.
    //! assert Json.encode(Json.Int(Int.pow(2, 70))) == "1180591620717411303424"
    //!
    //! assert Json.encode(%Json.Obj{"ok" => Json.Bool(True), "n" => Json.Int(42)})
    //!     == "{\"ok\":true,\"n\":42}"
    //
    pub host fn encode(jv: Json) -> String

    /// Converts a `Json` tree to `Dynamic`, preserving the same shape: strings,
    /// numbers, booleans, arrays, objects, and null.
    //! dyn = Json.to_dynamic(Json.String("hello"))
    //! assert Dynamic.as_string(dyn) == Result.Ok("hello")
    //
    pub host fn to_dynamic(jv: Json) -> Dynamic

    /// Reads JSON text as a `T` in one step: `Json.decode`, then
    /// `T.from_json`. An `Err` is a `Json.Error`, `Decode` when the text is
    /// not JSON and `Shape` when its JSON is not a `T`. Give `T` with a
    /// binding's annotation or as `Json.decode_as<T>(text)`.
    //! assert Json.decode_as<List<Int>>("[1, 2, 3]") == Ok([1, 2, 3])
    //!
    //! names: Result<Map<String, Int>, Json.Error> = Json.decode_as(`{"a": 1}`)
    //! assert names == Ok(%{"a" => 1})
    //!
    //! shape = Json.decode_as<List<Int>>("[1, true]") |> Result.map_err(&Display.to_string(&1))
    //! assert shape == Err("[1]: expected int, got bool")
    //!
    //! syntax = Json.decode_as<List<Int>>("[1,") |> Result.map_err(&Display.to_string(&1))
    //!
    //! assert syntax
    //!     == Err("json decode error at line 1, col 4: unexpected end of input: incomplete JSON value")
    //
    pub fn decode_as<T>(text: String) -> Result<T, Json.Error> where T: FromJson {
        case Json.decode(text) {
            Ok(json) ->
                case T.from_json(json) {
                    Ok(value) -> Ok(value)
                    Err(e) -> Err(Json.Error.Shape(e))
                }

            Err(e) ->
                Err(Json.Error.Decode(e))
        }
    }

    /// Writes a `T` as compact JSON text in one step: `T.to_json`, then
    /// `Json.encode`. It is the other direction of `Json.decode_as`, and
    /// `Json.decode_as` reads its text back as the same value.
    //! assert Json.encode_as([1, 2, 3]) == "[1,2,3]"
    //! assert Json.encode_as(%{"a" => Some(1), "b" => None}) == `{"a":1,"b":null}`
    //!
    //! text = Json.encode_as(%{"a" => [1, 2]})
    //! assert Json.decode_as<Map<String, List<Int>>>(text) == Ok(%{"a" => [1, 2]})
    //
    pub fn encode_as<T>(value: T) -> String where T: ToJson {
        Json.encode(T.to_json(value))
    }

    /// Human-readable shape name used in `Json.ShapeError` messages.
    pub fn kind(jv: Json) -> String {
        case jv {
            Json.String(_) -> "string"
            Json.Int(_) -> "int"
            Json.Float(_) -> "float"
            Json.Bool(_) -> "bool"
            Json.Arr(_) -> "array"
            Json.Obj(_) -> "object"
            Json.Null -> "null"
        }
    }
}

// The element decoder arrives as a closure rather than being reached through
// `T.from_json`: a type parameter's concrete binding lives on the activation
// that supplied the type argument, so a capture written in the impl body
// sees it (`&T.from_json(&1)`) but a separate generic helper does not.
fn decode_list<T>(
    items: List<Json>,
    index: Int,
    acc: List<T>,
    decode_item: (Json) -> Result<T, Json.ShapeError>,
) -> Result<List<T>, Json.ShapeError> {
    case items {
        [] ->
            Ok(acc)

        [head, ..tail] ->
            case decode_item(head) {
                Ok(value) -> decode_list(tail, index + 1, List.concat(acc, [value]), decode_item)
                Err(e) -> Err(shape_error_prepend(e, "[${index}]"))
            }
    }
}

derive Equatable for Json

impl Display for Json {
    fn to_string(jv: Json) -> String {
        Json.encode(jv)
    }
}

impl Debug for Json {
    fn inspect(jv: Json) -> String {
        to_string(jv)
    }
}

/// Structured decode failure from `decode`. `line` and `col` are 1-based
/// source coordinates for human display; `offset` is the 0-based byte
/// position of the same spot, for programmatic tooling, and it points AT
/// the offending character rather than one past it.
///
/// `message` is Nomi's own text, not the host JSON parser's. That is a
/// designed contract, not an accident: the messages `decode` can produce
/// are exactly
///
/// - `unexpected character 'x'` — a locatable byte that cannot appear there
/// - `unexpected byte 0xff` — that byte begins no valid UTF-8 rune
/// - `unexpected end of input: incomplete JSON value` — input stopped mid-value
/// - `unexpected end of input: expected a JSON value` — input was empty or blank
/// - `trailing content after JSON value` — a second value follows the first
/// - `number out of range: <lexeme>` — well-formed number, unrepresentable
/// - `malformed JSON` — a failure shape with no position to report
///
/// and they are stable across host-toolchain upgrades. Code may match on
/// them; the host parser's own wording never appears here. A
/// hand-constructed `Json.DecodeError` may of course carry any message.
///
/// Named with the `Json` prefix so it is distinct from decode errors returned
/// by other modules.
pub struct Json.DecodeError {
    message: String
    line: Int
    col: Int
    offset: Int
}

impl Display for Json.DecodeError {
    fn to_string(e: Json.DecodeError) -> String {
        "json decode error at line ${e.line}, col ${e.col}: ${e.message}"
    }
}

/// Why `Json.decode_as` could not read its text as a `T`: the text is not
/// JSON (`Decode`, with `Json.decode`'s error), or its JSON does not have
/// `T`'s shape (`Shape`, with `T.from_json`'s error). `Display` writes the
/// error it holds.
pub enum Json.Error {
    Decode Json.DecodeError
    Shape Json.ShapeError
}

impl Display for Json.Error {
    fn to_string(e: Json.Error) -> String {
        case e {
            Json.Error.Decode(d) -> Display.to_string(d)
            Json.Error.Shape(s) -> Display.to_string(s)
        }
    }
}

/// Field-name casing for derived JSON object keys.
pub enum Json.Case {
    Snake
    Camel
    Pascal
    Kebab
    ScreamingSnake
}

derive Display for Json.Case
derive Equatable for Json.Case

/// Compile-time options accepted by `derive ToJson for T with ...`.
pub struct ToJson.Options {
    rename_all: Json.Case = Json.Case.Snake
}

derive Equatable for ToJson.Options

/// Compile-time options accepted by `derive FromJson for T with ...`.
pub struct FromJson.Options {
    rename_all: Json.Case = Json.Case.Snake
}

derive Equatable for FromJson.Options

/// Shape mismatch while converting an already-parsed `Json` tree into a typed
/// Nomi value. Parse errors stay `Json.DecodeError`; shape errors describe the
/// path inside the JSON tree where the typed conversion failed.
pub struct Json.ShapeError {
    path: List<String>
    expected: String
    got: String
}

pub fn shape_error_root(expected: String, got: Json) -> Json.ShapeError {
    #Json.ShapeError{
        path: [],
        expected,
        got: Json.kind(got),
    }
}

pub fn shape_error_prepend(e: Json.ShapeError, segment: String) -> Json.ShapeError {
    #Json.ShapeError{
        path: [segment] + e.path,
        expected: e.expected,
        got: e.got,
    }
}

impl Display for Json.ShapeError {
    fn to_string(e: Json.ShapeError) -> String {
        message = "expected ${e.expected}, got ${e.got}"

        if e.path == [] {
            message
        } else {
            path = String.join(e.path, ".")
            "${path}: ${message}"
        }
    }
}

pub interface ToJson {
    fn to_json(value: self) -> Json
}

pub interface FromJson {
    fn from_json(json: Json) -> Result<self, Json.ShapeError>
}

impl ToJson for Int {
    fn to_json(value: Int) -> Json {
        Json.Int(value)
    }
}

impl FromJson for Int {
    fn from_json(json: Json) -> Result<Int, Json.ShapeError> {
        case json {
            Json.Int(value) -> Ok(value)
            _ -> Err(shape_error_root("int", json))
        }
    }
}

impl ToJson for Float {
    fn to_json(value: Float) -> Json {
        Json.Float(value)
    }
}

impl FromJson for Float {
    /// Reads a JSON number. A whole number, which `Json.decode` reads as
    /// `Json.Int`, is a Float too: JSON writes `2.0` as `2`.
    //! assert Float.from_json(Json.Float(2.5)) == Ok(2.5)
    //! assert Float.from_json(Json.Int(2)) == Ok(2.0)
    //
    fn from_json(json: Json) -> Result<Float, Json.ShapeError> {
        case json {
            Json.Float(value) -> Ok(value)
            Json.Int(value) -> Ok(Int.to_float(value))
            _ -> Err(shape_error_root("float", json))
        }
    }
}

impl ToJson for String {
    fn to_json(value: String) -> Json {
        Json.String(value)
    }
}

impl FromJson for String {
    fn from_json(json: Json) -> Result<String, Json.ShapeError> {
        case json {
            Json.String(value) -> Ok(value)
            _ -> Err(shape_error_root("string", json))
        }
    }
}

impl ToJson for Bool {
    fn to_json(value: Bool) -> Json {
        Json.Bool(value)
    }
}

impl FromJson for Bool {
    fn from_json(json: Json) -> Result<Bool, Json.ShapeError> {
        case json {
            Json.Bool(value) -> Ok(value)
            _ -> Err(shape_error_root("bool", json))
        }
    }
}

impl ToJson for List<T> where T: ToJson {
    fn to_json(value: List<T>) -> Json {
        Json.Arr(
            Iter.map(value, &ToJson.to_json(&1))
            |> Iter.to_list()
        )
    }
}

impl FromJson for List<T> where T: FromJson {
    fn from_json(json: Json) -> Result<List<T>, Json.ShapeError> {
        case json {
            Json.Arr(items) -> decode_list(items, 0, [], &T.from_json(&1))
            _ -> Err(shape_error_root("array", json))
        }
    }
}

impl ToJson for Vector<T> where T: ToJson {
    fn to_json(value: Vector<T>) -> Json {
        Json.Arr(
            Iter.map(value, &ToJson.to_json(&1))
            |> Iter.to_list()
        )
    }
}

impl FromJson for Vector<T> where T: FromJson {
    /// A vector crosses as a JSON array, as a list does.
    fn from_json(json: Json) -> Result<Vector<T>, Json.ShapeError> {
        case json {
            Json.Arr(items) ->
                case decode_list(items, 0, [], &T.from_json(&1)) {
                    Ok(list) -> Ok(Iter.to_vector(list))
                    Err(e) -> Err(e)
                }

            _ ->
                Err(shape_error_root("array", json))
        }
    }
}

impl ToJson for Set<T> where T: ToJson {
    fn to_json(value: Set<T>) -> Json {
        Json.Arr(
            Iter.map(value, &ToJson.to_json(&1))
            |> Iter.to_list()
        )
    }
}

impl FromJson for Set<T> where T: FromJson {
    /// A set crosses as a JSON array of its elements.
    fn from_json(json: Json) -> Result<Set<T>, Json.ShapeError> {
        case json {
            Json.Arr(items) ->
                case decode_list(items, 0, [], &T.from_json(&1)) {
                    Ok(list) -> Ok(Iter.to_set(list))
                    Err(e) -> Err(e)
                }

            _ ->
                Err(shape_error_root("array", json))
        }
    }
}

impl ToJson for Maybe<T> where T: ToJson {
    fn to_json(value: Maybe<T>) -> Json {
        case value {
            Some(inner) -> ToJson.to_json(inner)
            None -> Json.Null
        }
    }
}

impl FromJson for Maybe<T> where T: FromJson {
    fn from_json(json: Json) -> Result<Maybe<T>, Json.ShapeError> {
        case json {
            Json.Null ->
                Ok(None)

            _ ->
                case T.from_json(json) {
                    Ok(value) -> Ok(Some(value))
                    Err(e) -> Err(e)
                }
        }
    }
}

impl ToJson for Map<String, V> where V: ToJson {
    fn to_json(value: Map<String, V>) -> Json {
        Json.Obj(Map.map_values(value, &ToJson.to_json(&1)))
    }
}

impl FromJson for Map<String, V> where V: FromJson {
    fn from_json(json: Json) -> Result<Map<String, V>, Json.ShapeError> {
        case json {
            Json.Obj(items) ->
                Iter.reduce(items, fn state = Ok(%{}), #(key, value) -> {
                    case state {
                        Err(e) ->
                            break Err(e)

                        Ok(acc) ->
                            case V.from_json(value) {
                                Ok(decoded) -> Ok(Map.put(acc, key, decoded))
                                Err(e) -> break Err(shape_error_prepend(e, key))
                            }
                    }
                })

            _ ->
                Err(shape_error_root("object", json))
        }
    }
}

// A host's call of an exported function (`export fn`) decodes each argument
// from its JSON text with export_argument, at the parameter's type, and
// encodes the result with export_result. The IR builder instantiates both
// for each exported signature (internal/irbuild/exports.go); no Nomi code
// calls them.
fn export_argument<T>(text: String) -> Result<T, String> where T: FromJson {
    Json.decode_as<T>(text) |> Result.map_err(&Display.to_string(&1))
}

fn export_result<T>(value: T) -> String where T: ToJson {
    Json.encode_as(value)
}
