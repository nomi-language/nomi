//# Password storage for logins: `passwords.hash` turns a password into a
//# string to keep, and `passwords.verify` checks a password someone typed
//# against it.
//#
//# ```nomi
//# stored = passwords.hash(form.password)?
//#
//# // later, at sign-in:
//# signed_in = passwords.verify(form.password, user.password_hash) == Ok(True)
//# ```
//#
//# The stored string is a PHC string: it names the algorithm and records
//# its parameters, a random salt and the hash, as
//# `$pbkdf2-sha256$i=600000$<salt>$<hash>` with the salt and hash in base64
//# without padding. So a hash keeps verifying after the defaults change,
//# and `passwords.needs_rehash` says when to hash a password again, which
//# an app does at sign-in, the one time it holds the password:
//#
//# ```nomi
//# if passwords.needs_rehash(user.password_hash) {
//#     save_password_hash(user, passwords.hash(form.password)?)
//# }
//# ```
//#
//# The default hasher is `Pbkdf2`, PBKDF2-HMAC-SHA256 at 600,000
//# iterations, what OWASP's Password Storage Cheat Sheet recommends for it,
//# because Go's standard library has it. Argon2id, which OWASP prefers, and
//# bcrypt, for hashes an older system made, are in the first-party
//# `password_hashers` module, whose types implement `PasswordHasher`; hand
//# `verify` every hasher whose hashes the app may hold, and it picks the
//# one that reads the stored string's algorithm.
//#
//# A password is hashed as its UTF-8 bytes, as typed: there is no
//# normalization, so a password typed with a different composition of the
//# same accented letter does not verify.

import {
    base64
    bool.Bool.{self, False, True}
    bytes.Bytes
    display.Display
    hash.{equal_in_constant_time, pbkdf2_sha256}
    int.Int
    iter.Iter
    lists.List
    maybe.Maybe.{self, None, Some}
    random
    results.Result.{self, Err, Ok}
    strings.String
}

/// A password hashing algorithm: how it hashes a password, and how it
/// checks a password against a hash it made before. `passwords.hash`,
/// `verify` and `needs_rehash` call these; a module that adds an algorithm
/// implements it.
pub interface PasswordHasher {
    /// Whether this hasher reads a stored hash whose algorithm is `id`:
    /// the text between a stored string's first two `$` (`pbkdf2-sha256`,
    /// `argon2id`, `2b`).
    fn reads(hasher: self, id: String) -> Bool
    /// `password` hashed with a new random salt, as the string to store,
    /// or why this hasher's parameters, or the password, cannot be hashed.
    fn hash(hasher: self, password: String) -> Result<String, String>
    /// Whether `password` is the one `stored` was made from, by the
    /// parameters `stored` records, compared in constant time. An `Err`
    /// says `stored` is not a well-formed hash of this algorithm.
    fn verify(hasher: self, password: String, stored: String) -> Result<Bool, String>
    /// Whether `stored`, which this hasher reads, was made with parameters
    /// other than this hasher's.
    fn needs_rehash(hasher: self, stored: String) -> Bool
}

/// PBKDF2 with HMAC-SHA256 (RFC 8018), the algorithm Go's standard library
/// carries. Its stored strings are `$pbkdf2-sha256$i=<iterations>$<salt>$<hash>`.
pub struct Pbkdf2 {
    /// How many rounds of HMAC-SHA256 a hash takes: 600,000, OWASP's
    /// recommendation for PBKDF2-HMAC-SHA256. About a quarter of a second
    /// on a 2024 laptop core.
    iterations: Int = 600_000
    /// The random salt's length in bytes, at least 8.
    salt_length: Int = 16
    /// The hash's length in bytes, at least 16: 32, SHA-256's own size.
    length: Int = 32
}

/// The algorithm id `Pbkdf2` writes and reads.
fn pbkdf2_id() -> String {
    "pbkdf2-sha256"
}

impl PasswordHasher for Pbkdf2 {
    fn reads(Pbkdf2, id: String) -> Bool {
        id == pbkdf2_id()
    }

    fn hash(hasher: Pbkdf2, password: String) -> Result<String, String> {
        if hasher.iterations < 1 {
            return Err("PBKDF2 needs at least 1 iteration, got ${hasher.iterations}")
        }

        if hasher.salt_length < 8 or hasher.salt_length > 1024 {
            return Err("a PBKDF2 salt is 8 to 1024 bytes, got ${hasher.salt_length}")
        }

        if hasher.length < 16 or hasher.length > 1024 {
            return Err("a PBKDF2 hash is 16 to 1024 bytes, got ${hasher.length}")
        }

        salt = random.secure_bytes(hasher.salt_length)
        derived = pbkdf2_sha256(String.to_bytes(password), salt, hasher.iterations, hasher.length)

        phc = Phc{
            id: pbkdf2_id(),
            params: [#("i", Int.to_string(hasher.iterations))],
            salt,
            hash: derived,
        }

        Ok(Display.to_string(phc))
    }

    fn verify(Pbkdf2, password: String, stored: String) -> Result<Bool, String> {
        phc = Phc.parse(stored)?

        if phc.id != pbkdf2_id() {
            return Err("not a PBKDF2-SHA256 hash: its algorithm is `${phc.id}`")
        }

        iterations = Phc.int_param(phc, "i")?
        length = Bytes.length(phc.hash)

        if iterations < 1 or length < 1 or length > 1024 {
            return Err("a PBKDF2-SHA256 hash with ${iterations} iterations and ${length} bytes")
        }

        derived = pbkdf2_sha256(String.to_bytes(password), phc.salt, iterations, length)
        Ok(equal_in_constant_time(derived, phc.hash))
    }

    fn needs_rehash(hasher: Pbkdf2, stored: String) -> Bool {
        case Phc.parse(stored) {
            Ok(phc) ->
                Phc.int_param(phc, "i") != Ok(hasher.iterations)
                    or Bytes.length(phc.salt) < hasher.salt_length
                    or Bytes.length(phc.hash) != hasher.length

            Err(_) ->
                True
        }
    }
}

/// `password` hashed by `hasher` with a new random salt: the string to
/// store. Hashing the same password twice gives two strings, each of which
/// verifies. An `Err` says the hasher's parameters, or the password, cannot
/// be hashed, such as a `Pbkdf2` with no iterations.
//! import std::passwords.{self, Pbkdf2}
//!
//! fast = Pbkdf2{iterations: 1_000}
//! stored = passwords.hash("correct horse", hasher: fast)!
//! assert String.starts_with(stored, "$pbkdf2-sha256$i=1000$")
//! assert passwords.hash("correct horse", hasher: fast)! != stored
//! assert passwords.verify("correct horse", stored) == Ok(True)
//!
//! assert passwords.hash("x", hasher: Pbkdf2{iterations: 0})
//!     == Err("PBKDF2 needs at least 1 iteration, got 0")
//
pub fn hash(password: String, hasher: PasswordHasher = Pbkdf2{}) -> Result<String, String> {
    PasswordHasher.hash(hasher, password)
}

/// Whether `password` is the one `stored` was made from, checked by the
/// first of `hashers` that reads `stored`'s algorithm, with the parameters
/// `stored` records. The comparison takes the same time however much of a
/// wrong password's hash matches. An `Err` says `stored` is not a password
/// hash, or that none of `hashers` reads its algorithm.
//! import std::passwords
//!
//! // PBKDF2-HMAC-SHA256 of "password" and "somesaltsomesalt" at 1,000
//! // iterations, as Go's crypto/pbkdf2 computes it.
//! stored = "$pbkdf2-sha256$i=1000$c29tZXNhbHRzb21lc2FsdA$s5LQUeAEZUMuFVrnmF3OMNPXs3QWnF8SO/5BXmCj6QQ"
//!
//! assert passwords.verify("password", stored) == Ok(True)
//! assert passwords.verify("Password", stored) == Ok(False)
//!
//! assert passwords.verify("password", "plain text")
//!     == Err("not a password hash: it does not start with `$<algorithm>$`")
//!
//! assert passwords.verify("password", "$argon2id$v=19$m=19456,t=2,p=1$c2FsdA$aGFzaA")
//!     == Err("no hasher given reads `argon2id` hashes")
//
pub fn verify(
    password: String,
    stored: String,
    hashers: List<PasswordHasher> = [Pbkdf2{}],
) -> Result<Bool, String> {
    id =
        algorithm(stored)
        |> Maybe.to_result("not a password hash: it does not start with `$<algorithm>$`")?

    case hashers |> Iter.find(fn h -> PasswordHasher.reads(h, id)) {
        Some(hasher) -> PasswordHasher.verify(hasher, password, stored)
        None -> Err("no hasher given reads `${id}` hashes")
    }
}

/// Whether `stored` should be hashed again with `hasher`: it was made by
/// another algorithm, with other parameters, or is not a hash `hasher`
/// reads at all. Check it after a password verifies, and store the new
/// hash.
//! import std::passwords.{self, Pbkdf2}
//!
//! old = passwords.hash("hunter2", hasher: Pbkdf2{iterations: 1_000})!
//! assert passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 2_000})
//! refute passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 1_000})
//! assert passwords.needs_rehash("$2b$10$abc")
//
pub fn needs_rehash(stored: String, hasher: PasswordHasher = Pbkdf2{}) -> Bool {
    case algorithm(stored) {
        Some(id) when PasswordHasher.reads(hasher, id) ->
            PasswordHasher.needs_rehash(hasher, stored)

        _ ->
            True
    }
}

/// The algorithm a stored hash names, between its first two `$`, or
/// `None` for a string that does not start that way.
//! import std::passwords
//!
//! assert passwords.algorithm("$pbkdf2-sha256$i=1000$c2FsdA$aGFzaA") == Some("pbkdf2-sha256")
//! assert passwords.algorithm("$2b$12$R9h/cIPz0gi.URNNX3kh2O") == Some("2b")
//! assert passwords.algorithm("hunter2") == None
//
pub fn algorithm(stored: String) -> Maybe<String> {
    case String.split(stored, "$") {
        ["", id, _, ..] when id != "" -> Some(id)
        _ -> None
    }
}

/// A PHC string's parts: `$<id>[$v=<version>][$<param>=<value>,...]$<salt>$<hash>`,
/// with the salt and hash in base64's standard alphabet without padding,
/// as the Password Hashing Competition's string format writes them. A
/// `PasswordHasher` for a PHC algorithm reads and writes its strings with
/// this.
pub struct Phc {
    /// The algorithm: `pbkdf2-sha256`, `argon2id`.
    id: String
    /// The algorithm's version, the `v=` segment, if the string has one.
    version: Maybe<Int> = None
    /// The parameters in their order, each a name and its value.
    params: List<#(String, String)> = []
    salt: Bytes
    hash: Bytes
}

impl Phc {
    /// The parts of a PHC string, or why it is not one. A salt or hash
    /// with `=` padding, or a version or parameter that is not a name and
    /// a value, is an `Err`.
    //! import std::passwords.Phc
    //!
    //! phc = Phc.parse("$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$aGFzaA")!
    //! assert phc.id == "argon2id"
    //! assert phc.version == Some(19)
    //! assert phc.params == [#("m", "19456"), #("t", "2"), #("p", "1")]
    //! assert phc.salt == String.to_bytes("somesalt")
    //! assert Display.to_string(phc) == "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$aGFzaA"
    //!
    //! assert Phc.parse("$pbkdf2-sha256$i=1000$c2FsdA==$aGFzaA") == Err("a PHC salt has no `=` padding")
    //
    pub fn parse(text: String) -> Result<Phc, String> {
        segments = String.split(text, "$")

        case segments {
            ["", id, ..rest] when id != "" -> {
                #(version, rest) = case rest {
                    [first, ..others] when String.starts_with(first, "v=") ->
                        #(Some(digits(String.drop(first, 2), "version")?), others)

                    _ ->
                        #(None, rest)
                }

                #(params, rest) = case rest {
                    [first, second, third] -> #(parse_params(first)?, [second, third])
                    _ -> #([], rest)
                }

                case rest {
                    [salt, hash] ->
                        Ok(
                            Phc{
                                id,
                                version,
                                params,
                                salt: b64(salt, "salt")?,
                                hash: b64(hash, "hash")?,
                            }
                        )

                    _ ->
                        Err("a PHC string is `$<id>[$v=<version>][$<params>]$<salt>$<hash>`")
                }
            }

            _ ->
                Err("a PHC string starts with `$<id>$`")
        }
    }

    /// The value of the parameter `name`, if `phc` has it.
    pub fn param(phc: Phc, name: String) -> Maybe<String> {
        phc.params |> Iter.find(fn #(key, _) -> key == name) |> Maybe.map(fn #(_, value) -> value)
    }

    /// The parameter `name` as a non-negative decimal Int, or why `phc`
    /// lacks it.
    //! import std::passwords.Phc
    //!
    //! phc = Phc.parse("$pbkdf2-sha256$i=1000$c2FsdA$aGFzaA")!
    //! assert Phc.int_param(phc, "i") == Ok(1000)
    //! assert Phc.int_param(phc, "m") == Err("the PHC string has no `m` parameter")
    //
    pub fn int_param(phc: Phc, name: String) -> Result<Int, String> {
        case Phc.param(phc, name) {
            Some(value) -> digits(value, "`${name}` parameter")
            None -> Err("the PHC string has no `${name}` parameter")
        }
    }
}

impl Display for Phc {
    /// The PHC string: `$<id>[$v=<version>][$<params>]$<salt>$<hash>`.
    fn to_string(phc: Phc) -> String {
        version = case phc.version {
            Some(v) -> "$v=${v}"
            None -> ""
        }

        params = case phc.params {
            [] ->
                ""

            list -> {
                joined = list |> Iter.map(fn #(key, value) -> "${key}=${value}") |> String.join(",")
                "$${joined}"
            }
        }

        salt = base64.encode(phc.salt, padded: False)
        hashed = base64.encode(phc.hash, padded: False)
        "$${phc.id}${version}${params}$${salt}$${hashed}"
    }
}

/// `text` as a non-negative decimal Int with no sign, spaces or leading
/// zeros, or an `Err` naming `what`.
fn digits(text: String, what: String) -> Result<Int, String> {
    case String.to_int(text) {
        Some(n) when n >= 0 and Int.to_string(n) == text -> Ok(n)
        _ -> Err("a PHC ${what} is a decimal number, got `${text}`")
    }
}

/// A PHC parameter segment, `name=value` pairs joined by `,`.
fn parse_params(segment: String) -> Result<List<#(String, String)>, String> {
    String.split(segment, ",")
    |> Iter.map(fn pair -> {
        case String.split(pair, "=") {
            [key, value] when key != "" and value != "" -> Ok(#(key, value))
            _ -> Err("a PHC parameter is `name=value`, got `${pair}`")
        }
    })
    |> Result.collect()
}

/// A PHC salt or hash: base64 in the standard alphabet with no padding.
fn b64(text: String, what: String) -> Result<Bytes, String> {
    if String.contains(text, "=") {
        Err("a PHC ${what} has no `=` padding")
    } else {
        base64.decode(text) |> Result.map_err(fn e -> "a PHC ${what} is not base64: ${e}")
    }
}
