//# Password storage for logins: `passwords.hash` turns a password into a
//# string to keep, and `passwords.verify` checks a password someone typed
//# against it.
//#
//# ```nomi
//# stored = passwords.hash(form.password)?
//#
//# // later, at sign-in:
//# signed_in = passwords.verify(form.password, user.password_hash) == Ok(True)
//# ```
//#
//# The stored string is a PHC string: it names the algorithm and records
//# its parameters, a random salt and the hash, as
//# `$pbkdf2-sha256$i=600000$<salt>$<hash>` with the salt and hash in base64
//# without padding. So a hash keeps verifying after the defaults change,
//# and `passwords.needs_rehash` says when to hash a password again, which
//# an app does at sign-in, the one time it holds the password:
//#
//# ```nomi
//# if passwords.needs_rehash(user.password_hash) then
//#     save_password_hash(user, passwords.hash(form.password)?)
//# end
//# ```
//#
//# The default hasher is `Pbkdf2`, PBKDF2-HMAC-SHA256 at 600,000
//# iterations, what OWASP's Password Storage Cheat Sheet recommends for it.
//# `Argon2id`, which OWASP recommends first, and `Scrypt` are the others to
//# hash with, each at OWASP's parameters, and `Bcrypt` reads and writes the
//# hashes an older system made. Each implements `PasswordHasher`; hand
//# `verify` every hasher whose hashes the app may hold, and it picks the
//# one that reads the stored string's algorithm:
//#
//# ```nomi
//# hashers = [Argon2id{}, Bcrypt{}, Pbkdf2{}]
//#
//# signed_in = passwords.verify(form.password, user.password_hash, hashers) == Ok(True)
//#
//# if signed_in and passwords.needs_rehash(user.password_hash, hasher: Argon2id{}) then
//#     save_password_hash(user, passwords.hash(form.password, hasher: Argon2id{})?)
//# end
//# ```
//#
//# A password is hashed as its UTF-8 bytes, as typed: there is no
//# normalization, so a password typed with a different composition of the
//# same accented letter does not verify.

import
    base64
    bool.Bool.{self, False, True}
    bytes.Bytes
    display.Display
    hash.{equal_in_constant_time, pbkdf2_sha256}
    int.{Int, PositiveInt}
    iter.Iter
    lists.List
    maybe.Maybe.{self, None, Some}
    passwords::host.{self, Cost, HashLength, Kib, Lanes, LogCost, Passes, ScryptFactor}
    random
    results.Result.{self, Err, Ok}
    strings.String
end

/// A password hashing algorithm: how it hashes a password, and how it
/// checks a password against a hash it made before. `passwords.hash`,
/// `verify` and `needs_rehash` call these; a module that adds an algorithm
/// implements it.
pub interface PasswordHasher
    /// Whether this hasher recognizes a stored hash whose algorithm is `id`:
    /// the text between a stored string's first two `$` (`pbkdf2-sha256`,
    /// `argon2id`, `2b`).
    fn recognizes(hasher: self, id: String) -> Bool
    /// `password` hashed with a new random salt, as the string to store,
    /// or why this hasher's parameters, or the password, cannot be hashed.
    fn hash(hasher: self, password: String) -> Result<String, String>
    /// Whether `password` is the one `stored` was made from, by the
    /// parameters `stored` records, compared in constant time. An `Err`
    /// says `stored` is not a well-formed hash of this algorithm.
    fn verify(hasher: self, password: String, stored: String) -> Result<Bool, String>
    /// Whether `stored`, which this hasher reads, was made with parameters
    /// other than this hasher's.
    fn needs_rehash(hasher: self, stored: String) -> Bool
end

/// PBKDF2 with HMAC-SHA256 (RFC 8018), the algorithm Go's standard library
/// carries. Its stored strings are `$pbkdf2-sha256$i=<iterations>$<salt>$<hash>`.
pub struct Pbkdf2
    /// How many rounds of HMAC-SHA256 a hash takes: 600,000, OWASP's
    /// recommendation for PBKDF2-HMAC-SHA256. About a quarter of a second
    /// on a 2024 laptop core.
    iterations: PositiveInt = 600_000
    /// The random salt's length in bytes, at least 8.
    salt_length: PositiveInt = 16
    /// The hash's length in bytes, at least 16: 32, SHA-256's own size.
    length: PositiveInt = 32
end

/// The algorithm id `Pbkdf2` writes and reads.
fn pbkdf2_id() -> String
    "pbkdf2-sha256"
end

impl PasswordHasher for Pbkdf2
    fn recognizes(Pbkdf2, id: String) -> Bool
        id == pbkdf2_id()
    end

    fn hash(hasher: Pbkdf2, password: String) -> Result<String, String>
        if hasher.salt_length < 8 or hasher.salt_length > 1024 then
            return Err("a PBKDF2 salt is 8 to 1024 bytes, got ${hasher.salt_length}")
        end

        if hasher.length < 16 or hasher.length > 1024 then
            return Err("a PBKDF2 hash is 16 to 1024 bytes, got ${hasher.length}")
        end

        salt = random.secure_bytes(hasher.salt_length)
        derived = pbkdf2_sha256(String.to_bytes(password), salt, hasher.iterations, hasher.length)

        phc = Phc{
            id:     pbkdf2_id(),
            params: [("i", Int.to_string(hasher.iterations))],
            salt:,
            hash: derived,
        }

        Ok(Display.to_string(phc))
    end

    fn verify(Pbkdf2, password: String, stored: String) -> Result<Bool, String>
        phc = Phc.parse(stored)?

        if phc.id != pbkdf2_id() then
            return Err("not a PBKDF2-SHA256 hash: its algorithm is `${phc.id}`")
        end

        iterations = Phc.int_param(phc, "i")?
        length = Bytes.length(phc.hash)
        unusable = "a PBKDF2-SHA256 hash with ${iterations} iterations and ${length} bytes"

        if length == 0 or length > 1024 or iterations <= 0 then return Err(unusable)

        derived = pbkdf2_sha256(String.to_bytes(password), phc.salt, iterations, length)
        Ok(equal_in_constant_time(derived, phc.hash))
    end

    fn needs_rehash(hasher: Pbkdf2, stored: String) -> Bool
        case Phc.parse(stored)
            Ok(phc) ->
                Phc.int_param(phc, "i") != Ok(hasher.iterations)
                    or Bytes.length(phc.salt) < hasher.salt_length
                    or Bytes.length(phc.hash) != hasher.length

            Err(_) ->
                True
        end
    end
end

/// Argon2id (RFC 9106), version 19, what OWASP's Password Storage Cheat
/// Sheet recommends first. Its stored strings are
/// `$argon2id$v=19$m=<KiB>,t=<passes>,p=<lanes>$<salt>$<hash>`, as the
/// reference implementation writes them.
//! import std::passwords.{self, Argon2id}
//!
//! // The reference implementation's test vectors: "password" and
//! // "somesalt" at t=2.
//! hashers = [Argon2id{}]
//!
//! for_64_mib = "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc"
//! assert passwords.verify("password", for_64_mib, hashers) == Ok(True)
//! assert passwords.verify("passw0rd", for_64_mib, hashers) == Ok(False)
//!
//! two_lanes = "$argon2id$v=19$m=256,t=2,p=2$c29tZXNhbHQ$bQk8UB/VmZZF4Oo79iDXuL5/0ttZwg2f/5U52iv1cDc"
//! assert passwords.verify("password", two_lanes, hashers) == Ok(True)
//! assert passwords.needs_rehash(two_lanes, hasher: Argon2id{})
//!
//! stored = passwords.hash("correct horse", hasher: Argon2id{memory_kib: 256})!
//! assert String.starts_with(stored, "$argon2id$v=19$m=256,t=2,p=1$")
//! assert passwords.verify("correct horse", stored, hashers) == Ok(True)
//! refute passwords.needs_rehash(stored, hasher: Argon2id{memory_kib: 256})
//!
//! assert passwords.hash("x", hasher: Argon2id{parallelism: 0})
//!     == Err("Argon2id has 1 to 255 lanes, got 0")
//!
//! assert passwords.verify("x", "$argon2id$v=19$m=65536,t=2$c29tZXNhbHQ$CTFh", hashers)
//!     == Err("the PHC string has no `p` parameter")
//
pub struct Argon2id
    /// The memory a hash uses, in KiB: 19,456 (19 MiB), OWASP's choice
    /// with 2 passes.
    memory_kib: Int = 19_456
    /// How many passes over the memory.
    iterations: Int = 2
    /// How many lanes the memory is split into.
    parallelism: Int = 1
    /// The random salt's length in bytes, at least 8.
    salt_length: PositiveInt = 16
    /// The hash's length in bytes, at least 16.
    length: Int = 32
end

/// Argon2id's parameters, each in the range its kernel takes.
struct Argon2Params
    memory_kib: Kib
    passes:     Passes
    lanes:      Lanes
    length:     HashLength
end

/// The parameters as Argon2id takes them, or why they cannot hash.
fn argon2_params(
    memory_kib:  Int,
    iterations:  Int,
    parallelism: Int,
    length:      Int,
) -> Result<Argon2Params, String>
    lanes = Maybe.to_result(
        Lanes.try_from(parallelism),
        "Argon2id has 1 to 255 lanes, got ${parallelism}",
    )?

    passes = Maybe.to_result(
        Passes.try_from(iterations),
        "Argon2id needs at least 1 pass, got ${iterations}",
    )?

    per_lane =
        if memory_kib < 8 * lanes then
            None
        else
            Kib.try_from(memory_kib)
        end

    memory = Maybe.to_result(
        per_lane,
        "Argon2id needs at least 8 KiB per lane, got ${memory_kib} KiB for ${parallelism}",
    )?

    bytes = Maybe.to_result(
        HashLength.try_from(length),
        "an Argon2id hash is 4 to 1024 bytes, got ${length}",
    )?

    Ok(Argon2Params{memory_kib: memory, passes:, lanes:, length: bytes})
end

impl PasswordHasher for Argon2id
    fn recognizes(Argon2id, id: String) -> Bool
        id == "argon2id"
    end

    fn hash(hasher: Argon2id, password: String) -> Result<String, String>
        if hasher.length < 16 then
            return Err("an Argon2id hash for a password is at least 16 bytes, got ${hasher.length}")
        end

        if hasher.salt_length < 8 or hasher.salt_length > 1024 then
            return Err("an Argon2id salt is 8 to 1024 bytes, got ${hasher.salt_length}")
        end

        params = argon2_params(
            hasher.memory_kib,
            hasher.iterations,
            hasher.parallelism,
            hasher.length,
        )?

        salt = random.secure_bytes(hasher.salt_length)

        derived = host.argon2id(
            String.to_bytes(password),
            salt,
            params.passes,
            params.memory_kib,
            params.lanes,
            params.length,
        )

        fields = [
            ("m", Int.to_string(hasher.memory_kib)),
            ("t", Int.to_string(hasher.iterations)),
            ("p", Int.to_string(hasher.parallelism)),
        ]

        Ok(
            Display.to_string(
                Phc{id: "argon2id", version: Some(19), params: fields, salt:, hash: derived}
            )
        )
    end

    fn verify(Argon2id, password: String, stored: String) -> Result<Bool, String>
        phc = Phc.parse(stored)?

        if phc.id != "argon2id" then
            return Err("not an Argon2id hash: its algorithm is `${phc.id}`")
        end

        if phc.version != Some(19) then
            return Err("an Argon2id hash of version 19 is read, not ${phc.version}")
        end

        memory = Phc.int_param(phc, "m")?
        time = Phc.int_param(phc, "t")?
        lanes = Phc.int_param(phc, "p")?
        params = argon2_params(memory, time, lanes, Bytes.length(phc.hash))?

        derived = host.argon2id(
            String.to_bytes(password),
            phc.salt,
            params.passes,
            params.memory_kib,
            params.lanes,
            params.length,
        )

        Ok(equal_in_constant_time(derived, phc.hash))
    end

    fn needs_rehash(hasher: Argon2id, stored: String) -> Bool
        case Phc.parse(stored)
            Ok(phc) ->
                phc.version != Some(19)
                    or Phc.int_param(phc, "m") != Ok(hasher.memory_kib)
                    or Phc.int_param(phc, "t") != Ok(hasher.iterations)
                    or Phc.int_param(phc, "p") != Ok(hasher.parallelism)
                    or Bytes.length(phc.salt) < hasher.salt_length
                    or Bytes.length(phc.hash) != hasher.length

            Err(_) ->
                True
        end
    end
end

/// scrypt (RFC 7914). Its stored strings are
/// `$scrypt$ln=<log2 N>,r=<block size>,p=<parallelism>$<salt>$<hash>`, the
/// PHC form passlib writes. A hash takes 128 × N × the block size bytes of
/// memory: 128 MiB at the defaults.
//! import std::passwords.{self, Scrypt}
//!
//! // RFC 7914, section 12: "pleaseletmein" and "SodiumChloride" at
//! // N = 16,384, r = 8, p = 1, and "" and "" at N = 16, r = 1, p = 1.
//! hashers = [Scrypt{}]
//!
//! rfc = "$scrypt$ln=14,r=8,p=1$U29kaXVtQ2hsb3JpZGU$cCO9yzr9c0hGHAbNgf046/2o+7qQT44+qbVD9lRdofLVQylVYT8Pz2LUlwUkKpr55h6F3A1lHkDfzwF7RVdYhw"
//! assert passwords.verify("pleaseletmein", rfc, hashers) == Ok(True)
//! assert passwords.verify("pleaseletmeout", rfc, hashers) == Ok(False)
//!
//! empty = "$scrypt$ln=4,r=1,p=1$$d9ZXYjhleyA7GcpCwYoEl/FrSETjB0ro39/6P+3iFEL80Aad7QlI+DJqdToPyB8X6NPg+y4NNijPNeIMONGJBg"
//! assert passwords.verify("", empty, hashers) == Ok(True)
//!
//! stored = passwords.hash("correct horse", hasher: Scrypt{log_cost: 10})!
//! assert String.starts_with(stored, "$scrypt$ln=10,r=8,p=1$")
//! assert passwords.verify("correct horse", stored, hashers) == Ok(True)
//! assert passwords.needs_rehash(stored, hasher: Scrypt{})
//!
//! assert passwords.hash("x", hasher: Scrypt{block_size: 1_048_576, parallelism: 1_024})
//!     == Err("scrypt's block size times its parallelism is below 2^30, got 1073741824")
//
pub struct Scrypt
    /// log2 of the CPU and memory cost N: 17, so N is 131,072, OWASP's
    /// minimum with a block size of 8 and a parallelism of 1.
    log_cost: Int = 17
    /// The block size r.
    block_size: Int = 8
    /// The parallelism p.
    parallelism: Int = 1
    /// The random salt's length in bytes, at least 8.
    salt_length: PositiveInt = 16
    /// The hash's length in bytes, at least 16.
    length: Int = 32
end

/// scrypt's parameters, each in the range its kernel takes.
struct ScryptParams
    log_cost:    LogCost
    block_size:  ScryptFactor
    parallelism: ScryptFactor
    length:      HashLength
end

/// The parameters as scrypt takes them, or why they cannot hash.
fn scrypt_params(
    log_cost:    Int,
    block_size:  Int,
    parallelism: Int,
    length:      Int,
) -> Result<ScryptParams, String>
    cost = Maybe.to_result(
        LogCost.try_from(log_cost),
        "scrypt's log2 cost is 1 to 62, got ${log_cost}",
    )?

    r = Maybe.to_result(
        ScryptFactor.try_from(block_size),
        "scrypt's block size is 1 to 2^30 - 1, got ${block_size}",
    )?

    p = Maybe.to_result(
        ScryptFactor.try_from(parallelism),
        "scrypt's parallelism is 1 to 2^30 - 1, got ${parallelism}",
    )?

    if block_size * parallelism >= 1_073_741_824 then
        return Err(
            "scrypt's block size times its parallelism is below 2^30, got ${block_size * parallelism}"
        )
    end

    bytes = Maybe.to_result(
        HashLength.try_from(length),
        "a scrypt hash is 4 to 1024 bytes, got ${length}",
    )?

    Ok(ScryptParams{log_cost: cost, block_size: r, parallelism: p, length: bytes})
end

/// scrypt of `password` and `salt` by `params`, or why it cannot derive a
/// key.
fn scrypt_key(password: String, salt: Bytes, params: ScryptParams) -> Result<Bytes, String>
    host.scrypt(
        String.to_bytes(password),
        salt,
        params.log_cost,
        params.block_size,
        params.parallelism,
        params.length,
    )
    |> Result.map_err(fn why -> "scrypt: ${why}")
end

impl PasswordHasher for Scrypt
    fn recognizes(Scrypt, id: String) -> Bool
        id == "scrypt"
    end

    fn hash(hasher: Scrypt, password: String) -> Result<String, String>
        if hasher.length < 16 then
            return Err("a scrypt hash for a password is at least 16 bytes, got ${hasher.length}")
        end

        if hasher.salt_length < 8 or hasher.salt_length > 1024 then
            return Err("a scrypt salt is 8 to 1024 bytes, got ${hasher.salt_length}")
        end

        params = scrypt_params(
            hasher.log_cost,
            hasher.block_size,
            hasher.parallelism,
            hasher.length,
        )?

        salt = random.secure_bytes(hasher.salt_length)
        derived = scrypt_key(password, salt, params)?

        fields = [
            ("ln", Int.to_string(hasher.log_cost)),
            ("r",  Int.to_string(hasher.block_size)),
            ("p",  Int.to_string(hasher.parallelism)),
        ]

        Ok(Display.to_string(Phc{id: "scrypt", params: fields, salt:, hash: derived}))
    end

    fn verify(Scrypt, password: String, stored: String) -> Result<Bool, String>
        phc = Phc.parse(stored)?

        if phc.id != "scrypt" then return Err("not a scrypt hash: its algorithm is `${phc.id}`")

        log_cost = Phc.int_param(phc, "ln")?
        block_size = Phc.int_param(phc, "r")?
        parallelism = Phc.int_param(phc, "p")?
        params = scrypt_params(log_cost, block_size, parallelism, Bytes.length(phc.hash))?
        derived = scrypt_key(password, phc.salt, params)?
        Ok(equal_in_constant_time(derived, phc.hash))
    end

    fn needs_rehash(hasher: Scrypt, stored: String) -> Bool
        case Phc.parse(stored)
            Ok(phc) ->
                Phc.int_param(phc, "ln") != Ok(hasher.log_cost)
                    or Phc.int_param(phc, "r") != Ok(hasher.block_size)
                    or Phc.int_param(phc, "p") != Ok(hasher.parallelism)
                    or Bytes.length(phc.salt) < hasher.salt_length
                    or Bytes.length(phc.hash) != hasher.length

            Err(_) ->
                True
        end
    end
end

/// bcrypt (Provos and Mazières, 1999), for hashes an older system made. It
/// reads `$2a$`, `$2b$` and `$2y$` hashes, and writes `$2a$`. bcrypt reads
/// only a password's first 72 bytes, so `hash` refuses a longer one rather
/// than cut it. It draws its own salt.
//! import std::passwords.{self, Argon2id, Bcrypt, PasswordHasher}
//!
//! // OpenBSD's and John the Ripper's "U*U" vector.
//! hashers: List<PasswordHasher> = [Argon2id{}, Bcrypt{}]
//! stored = "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"
//!
//! assert passwords.verify("U*U", stored, hashers) == Ok(True)
//! assert passwords.verify("U*V", stored, hashers) == Ok(False)
//!
//! assert passwords.verify(
//!     "U*U",
//!     "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW",
//!     hashers,
//! ) == Ok(True)
//!
//! assert passwords.needs_rehash(stored, hasher: Argon2id{})
//! refute passwords.needs_rehash(stored, hasher: Bcrypt{cost: 5})
//!
//! fresh = passwords.hash("hunter2", hasher: Bcrypt{cost: 4})!
//! assert String.starts_with(fresh, "$2a$04$")
//! assert passwords.verify("hunter2", fresh, hashers) == Ok(True)
//!
//! assert passwords.hash(String.repeat("x", 73), hasher: Bcrypt{cost: 4}) |> Result.is_err()
//! assert passwords.hash("x", hasher: Bcrypt{cost: 3}) == Err("a bcrypt cost is 4 to 31, got 3")
//! assert passwords.verify("x", "$2b$05$short", hashers) |> Result.is_err()
//
pub struct Bcrypt
    /// The cost: each step doubles the work. 12, a common choice above
    /// OWASP's floor of 10.
    cost: Int = 12
end

impl PasswordHasher for Bcrypt
    fn recognizes(Bcrypt, id: String) -> Bool
        id == "2a" or id == "2b" or id == "2y"
    end

    fn hash(hasher: Bcrypt, password: String) -> Result<String, String>
        cost = Maybe.to_result(
            Cost.try_from(hasher.cost),
            "a bcrypt cost is 4 to 31, got ${hasher.cost}",
        )?

        host.bcrypt_hash(String.to_bytes(password), cost)
        |> Result.map_err(fn why -> "bcrypt: ${why}")
    end

    fn verify(Bcrypt, password: String, stored: String) -> Result<Bool, String>
        host.bcrypt_verify(String.to_bytes(password), stored)
        |> Result.map_err(fn why -> "not a bcrypt hash: ${why}")
    end

    fn needs_rehash(hasher: Bcrypt, stored: String) -> Bool
        host.bcrypt_cost(stored) != Some(hasher.cost)
    end
end

/// `password` hashed by `hasher` with a new random salt: the string to
/// store. Hashing the same password twice gives two strings, each of which
/// verifies. An `Err` says the hasher's parameters, or the password, cannot
/// be hashed, such as a `Pbkdf2` whose salt is too short.
//! import std::passwords.{self, Pbkdf2}
//!
//! fast = Pbkdf2{iterations: 1_000}
//! stored = passwords.hash("correct horse", hasher: fast)!
//! assert String.starts_with(stored, "$pbkdf2-sha256$i=1000$")
//! assert passwords.hash("correct horse", hasher: fast)! != stored
//! assert passwords.verify("correct horse", stored) == Ok(True)
//!
//! assert passwords.hash("x", hasher: Pbkdf2{salt_length: 4})
//!     == Err("a PBKDF2 salt is 8 to 1024 bytes, got 4")
//
pub fn hash(password: String, hasher: PasswordHasher = Pbkdf2{}) -> Result<String, String>
    PasswordHasher.hash(hasher, password)
end

/// Whether `password` is the one `stored` was made from, checked by the
/// first of `hashers` that reads `stored`'s algorithm, with the parameters
/// `stored` records. The comparison takes the same time however much of a
/// wrong password's hash matches. An `Err` says `stored` is not a password
/// hash, or that none of `hashers` reads its algorithm.
//! import std::passwords
//!
//! // PBKDF2-HMAC-SHA256 of "password" and "somesaltsomesalt" at 1,000
//! // iterations, as Go's crypto/pbkdf2 computes it.
//! stored = "$pbkdf2-sha256$i=1000$c29tZXNhbHRzb21lc2FsdA$s5LQUeAEZUMuFVrnmF3OMNPXs3QWnF8SO/5BXmCj6QQ"
//!
//! assert passwords.verify("password", stored) == Ok(True)
//! assert passwords.verify("Password", stored) == Ok(False)
//!
//! assert passwords.verify("password", "plain text")
//!     == Err("not a password hash: it does not start with `$<algorithm>$`")
//!
//! assert passwords.verify("password", "$argon2id$v=19$m=19456,t=2,p=1$c2FsdA$aGFzaA")
//!     == Err("no hasher given reads `argon2id` hashes")
//
pub fn verify(
    password: String,
    stored:   String,
    hashers:  List<PasswordHasher> = [Pbkdf2{}],
) -> Result<Bool, String>
    id =
        algorithm(stored)
        |> Maybe.to_result("not a password hash: it does not start with `$<algorithm>$`")?

    case hashers |> Iter.find(fn h -> PasswordHasher.recognizes(h, id))
        Some(hasher) -> PasswordHasher.verify(hasher, password, stored)
        None         -> Err("no hasher given reads `${id}` hashes")
    end
end

/// Whether `stored` should be hashed again with `hasher`: it was made by
/// another algorithm, with other parameters, or is not a hash `hasher`
/// reads at all. Check it after a password verifies, and store the new
/// hash.
//! import std::passwords.{self, Pbkdf2}
//!
//! old = passwords.hash("hunter2", hasher: Pbkdf2{iterations: 1_000})!
//! assert passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 2_000})
//! refute passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 1_000})
//! assert passwords.needs_rehash("$2b$10$abc")
//
pub fn needs_rehash(stored: String, hasher: PasswordHasher = Pbkdf2{}) -> Bool
    case algorithm(stored)
        Some(id) when PasswordHasher.recognizes(hasher, id) ->
            PasswordHasher.needs_rehash(hasher, stored)

        _ ->
            True
    end
end

/// The algorithm a stored hash names, between its first two `$`, or
/// `None` for a string that does not start that way.
//! import std::passwords
//!
//! assert passwords.algorithm("$pbkdf2-sha256$i=1000$c2FsdA$aGFzaA") == Some("pbkdf2-sha256")
//! assert passwords.algorithm("$2b$12$R9h/cIPz0gi.URNNX3kh2O") == Some("2b")
//! assert passwords.algorithm("hunter2") == None
//
pub fn algorithm(stored: String) -> Maybe<String>
    case String.split(stored, "$")
        ["", id, _, ..] when id != "" -> Some(id)
        _                             -> None
    end
end

/// A PHC string's parts: `$<id>[$v=<version>][$<param>=<value>,...]$<salt>$<hash>`,
/// with the salt and hash in base64's standard alphabet without padding,
/// as the Password Hashing Competition's string format writes them. A
/// `PasswordHasher` for a PHC algorithm reads and writes its strings with
/// this.
pub struct Phc
    /// The algorithm: `pbkdf2-sha256`, `argon2id`.
    id: String
    /// The algorithm's version, the `v=` segment, if the string has one.
    version: Maybe<Int> = None
    /// The parameters in their order, each a name and its value.
    params: List<(String, String)> = []
    salt:   Bytes
    hash:   Bytes
end

impl Phc
    /// The parts of a PHC string, or why it is not one. A salt or hash
    /// with `=` padding, or a version or parameter that is not a name and
    /// a value, is an `Err`.
    //! import std::passwords.Phc
    //!
    //! phc = Phc.parse("$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$aGFzaA")!
    //! assert phc.id == "argon2id"
    //! assert phc.version == Some(19)
    //! assert phc.params == [("m", "19456"), ("t", "2"), ("p", "1")]
    //! assert phc.salt == String.to_bytes("somesalt")
    //! assert Display.to_string(phc) == "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$aGFzaA"
    //!
    //! assert Phc.parse("$pbkdf2-sha256$i=1000$c2FsdA==$aGFzaA") == Err("a PHC salt has no `=` padding")
    //
    pub fn parse(text: String) -> Result<Phc, String>
        segments = String.split(text, "$")

        case segments
            ["", id, ..rest] when id != "" ->
                (version, rest) =
                    case rest
                        [first, ..others] when String.starts_with(first, "v=") ->
                            (Some(digits(String.drop(first, 2), "version")?), others)

                        _ ->
                            (None, rest)
                    end

                (params, rest) =
                    case rest
                        [first, second, third] -> (parse_params(first)?, [second, third])
                        _                      -> ([], rest)
                    end

                case rest
                    [salt, hash] ->
                        Ok(
                            Phc{
                                id:,
                                version:,
                                params:,
                                salt: b64(salt, "salt")?,
                                hash: b64(hash, "hash")?,
                            }
                        )

                    _ ->
                        Err("a PHC string is `$<id>[$v=<version>][$<params>]$<salt>$<hash>`")
                end

            _ ->
                Err("a PHC string starts with `$<id>$`")
        end
    end

    /// The value of the parameter `name`, if `phc` has it.
    pub fn param(phc: Phc, name: String) -> Maybe<String>
        phc.params |> Iter.find(fn (key, _) -> key == name) |> Maybe.map(fn (_, value) -> value)
    end

    /// The parameter `name` as a non-negative decimal Int, or why `phc`
    /// lacks it.
    //! import std::passwords.Phc
    //!
    //! phc = Phc.parse("$pbkdf2-sha256$i=1000$c2FsdA$aGFzaA")!
    //! assert Phc.int_param(phc, "i") == Ok(1000)
    //! assert Phc.int_param(phc, "m") == Err("the PHC string has no `m` parameter")
    //
    pub fn int_param(phc: Phc, name: String) -> Result<Int, String>
        case Phc.param(phc, name)
            Some(value) -> digits(value, "`${name}` parameter")
            None        -> Err("the PHC string has no `${name}` parameter")
        end
    end
end

impl Display for Phc
    /// The PHC string: `$<id>[$v=<version>][$<params>]$<salt>$<hash>`.
    fn to_string(phc: Phc) -> String
        version =
            case phc.version
                Some(v) -> "$v=${v}"
                None    -> ""
            end

        params =
            case phc.params
                [] ->
                    ""

                list ->
                    joined =
                        list |> Iter.map(fn (key, value) -> "${key}=${value}") |> String.join(",")

                    "$${joined}"
            end

        salt = base64.encode(phc.salt, padded: False)
        hashed = base64.encode(phc.hash, padded: False)
        "$${phc.id}${version}${params}$${salt}$${hashed}"
    end
end

/// `text` as a non-negative decimal Int with no sign, spaces or leading
/// zeros, or an `Err` naming `what`.
fn digits(text: String, what: String) -> Result<Int, String>
    case String.to_int(text)
        Some(n) when n >= 0 and Int.to_string(n) == text -> Ok(n)
        _ -> Err("a PHC ${what} is a decimal number, got `${text}`")
    end
end

/// A PHC parameter segment, `name=value` pairs joined by `,`.
fn parse_params(segment: String) -> Result<List<(String, String)>, String>
    String.split(segment, ",")
    |> Iter.map(fn pair ->
        case String.split(pair, "=")
            [key, value] when key != "" and value != "" -> Ok((key, value))
            _ -> Err("a PHC parameter is `name=value`, got `${pair}`")
        end
    end)
    |> Result.collect()
end

/// A PHC salt or hash: base64 in the standard alphabet with no padding.
fn b64(text: String, what: String) -> Result<Bytes, String>
    if String.contains(text, "=") then
        Err("a PHC ${what} has no `=` padding")
    else
        base64.decode(text) |> Result.map_err(fn e -> "a PHC ${what} is not base64: ${e}")
    end
end
