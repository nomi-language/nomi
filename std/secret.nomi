//# `Secret`: text a program holds and must never show, such as a
//# password, an API key or a token. Its `Debug` prints `Secret(<hidden>)`,
//# so `dbg`, `Debug.inspect`, a log line and a failed test's report never
//# show the text, inside another value too. It has no `Display`, so
//# `"${secret}"` is a compile error. It is opaque: `Secret.new` makes one,
//# `Secret.expose` returns its text, and no other code outside this module
//# reaches the text.
//#
//# A config that holds a secret holds a `Secret`, made where the text is
//# read, in `boot`:
//#
//# ```nomi
//# password = Map.get(startup.env, "SMTP_PASSWORD") |> Option.map(Secret.new)
//# ```
//#
//# Two secrets are equal when their texts are, compared in a time that
//# depends only on their lengths. A secret's hash is its text's, so a `Map`
//# or `Set` can be keyed by secrets.
//#
//# It has `FromJson`, so a struct with `derive FromJson` reads one from a
//# JSON or TOML string. It has no `ToJson`, so `derive ToJson` refuses a
//# struct that holds one, and code that writes it out says how.

import
    bool.Bool
    debug.Debug
    equatable.Equatable
    hash.equal_in_constant_time
    hashable.Hashable
    json.{FromJson, Json, shape_error_root}
    option.Option.Some
    results.Result.{self, Err, Ok}
    strings.String
end

/// Text that is never shown: its `Debug` is `Secret(<hidden>)` and it has
/// no `Display`. Make one with `Secret.new` and read its text with
/// `Secret.expose`.
pub opaque type Secret String

impl Secret
    /// A secret holding `text`.
    //! import std::secret.Secret
    //!
    //! password = Secret.new("hunter2")
    //!
    //! assert Debug.inspect(password) == "Secret(<hidden>)"
    //! assert Secret.expose(password) == "hunter2"
    //
    pub fn new(text: String) -> Secret
        Secret(text)
    end

    /// The text `secret` holds, for the one call that needs it, such as
    /// the one that sends it to a server.
    //! import std::secret.Secret
    //!
    //! assert Secret.expose(Secret.new("s3cret")) == "s3cret"
    //
    pub fn expose(Secret(text)) -> String
        text
    end
end

impl Debug for Secret
    /// `Secret(<hidden>)`, alone, inside another value and in a failed
    /// assertion's report.
    //! import std::assertions.AssertionFailure
    //! import std::secret.Secret
    //! import std::testing
    //!
    //! password = Secret.new("hunter2")
    //!
    //! assert Debug.inspect(password) == "Secret(<hidden>)"
    //!
    //! assert Debug.inspect((Some(password), [password], {1 => password}))
    //!     == "(Some(Secret(<hidden>)), [Secret(<hidden>)], {1 => Secret(<hidden>)})"
    //!
    //! assert Err(failure) = testing.check([password] == [])
    //! report = AssertionFailure.format(failure)
    //!
    //! assert String.contains(report, "[Secret(<hidden>)]")
    //! refute String.contains(report, "hunter2")
    //
    fn inspect(Secret) -> String
        "Secret(<hidden>)"
    end
end

impl Equatable for Secret
    /// Two secrets are equal when their texts are. The texts are compared
    /// as UTF-8 bytes by `hash.equal_in_constant_time`, in a time that
    /// depends only on their lengths, not on where they first differ.
    //! import std::secret.Secret
    //! import std::sets.Set
    //!
    //! assert Secret.new("s3cret") == Secret.new("s3cret")
    //! assert Secret.new("s3cret") != Secret.new("s3creT")
    //! assert Secret.new("s3cret") != Secret.new("s3cre")
    //!
    //! keys = Set[Secret.new("a"), Secret.new("b"), Secret.new("a")]
    //! assert Set.size(keys) == 2
    //
    fn equal(Secret(a), Secret(b)) -> Bool
        equal_in_constant_time(String.to_bytes(a), String.to_bytes(b))
    end
end

impl Hashable for Secret
    /// The hash of the text, so two secrets `equal` calls equal hash alike.
    //! import std::secret.Secret
    //!
    //! assert Hashable.hash(Secret.new("s3cret")) == Hashable.hash(Secret.new("s3cret"))
    //
    fn hash(Secret(text)) -> Int
        Hashable.hash(text)
    end
end

impl FromJson for Secret
    /// Reads a JSON string. Anything else is a shape error that names its
    /// kind and none of its value.
    //! import std::json.Json
    //! import std::secret.Secret
    //!
    //! smtp = Json.decode_as<{password: Secret}>(`{"password": "hunter2"}`)!
    //! assert Secret.expose(smtp.password) == "hunter2"
    //!
    //! assert Err(e) = Secret.from_json(Json.Int(1234))
    //! assert e.got == "int"
    //
    fn from_json(json: Json) -> Result<Secret, Json.ShapeError>
        case json
            Json.String(text) -> Ok(Secret(text))
            _                 -> Err(shape_error_root("String", json))
        end
    end
end
