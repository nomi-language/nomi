//# The Go-backed half of std::signatures: keys and signatures over Go's
//# crypto/ed25519, crypto/ecdsa, crypto/rsa and crypto/x509
//# (internal/stdhttp/signatures.go). A private key crosses as PKCS #8 DER
//# and a public key as PKIX DER. A key kind is 0 for Ed25519, 1 for ECDSA
//# P-256 and 2 for RSA; a scheme is 0 for Ed25519, 1 for ES256 (r and s),
//# 2 for RS256, 3 for PS256 and 4 for ECDSA P-256 with SHA-256 in ASN.1.
//# It is internal; a program imports std::signatures.

import
    bool.Bool
    bytes.Bytes
    int.Int
    results.Result
    strings.String
end

/// A new Ed25519 private key.
pub host fn generate_ed25519() -> Bytes

/// A new ECDSA P-256 private key.
pub host fn generate_p256() -> Bytes

/// A new RSA private key of `bits` bits, or why `bits` is out of range.
pub host fn generate_rsa(bits: Int) -> Result<Bytes, String>

/// A private key in PKCS #8, PKCS #1 or SEC 1 DER, as PKCS #8.
pub host fn private_from_der(der: Bytes) -> Result<Bytes, String>

/// The first private key in PEM text, as PKCS #8.
pub host fn private_from_pem(text: String) -> Result<Bytes, String>

/// A private key in a PKCS #8 `PRIVATE KEY` PEM block.
pub host fn private_to_pem(der: Bytes) -> String

/// A private key's kind.
pub host fn private_kind(der: Bytes) -> Int

/// A private key's public key.
pub host fn public_of(der: Bytes) -> Bytes

/// A public key in PKIX or PKCS #1 DER, as PKIX.
pub host fn public_from_der(der: Bytes) -> Result<Bytes, String>

/// The first public key in PEM text, as PKIX.
pub host fn public_from_pem(text: String) -> Result<Bytes, String>

/// A public key in a PKIX `PUBLIC KEY` PEM block.
pub host fn public_to_pem(der: Bytes) -> String

/// A public key's kind.
pub host fn public_kind(der: Bytes) -> Int

/// The Ed25519 private key with a 32-byte seed.
pub host fn ed25519_from_seed(seed: Bytes) -> Result<Bytes, String>

/// An Ed25519 private key's 32-byte seed.
pub host fn ed25519_seed(der: Bytes) -> Bytes

/// The Ed25519 public key with a 32-byte encoding.
pub host fn ed25519_public_from_bytes(raw: Bytes) -> Result<Bytes, String>

/// An Ed25519 public key's 32-byte encoding.
pub host fn ed25519_public_bytes(der: Bytes) -> Bytes

/// `message` signed under a private key with a scheme its kind has.
pub host fn sign(der: Bytes, scheme: Int, message: Bytes) -> Bytes

/// Whether `signature` is `message`'s under a public key with a scheme.
pub host fn is_valid(der: Bytes, scheme: Int, message: Bytes, signature: Bytes) -> Bool
