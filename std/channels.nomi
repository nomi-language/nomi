//# Channels: typed queues between tasks, each split into a `Sender` and a
//# `Receiver`. `Channel.buffered(capacity)` lets a producer run ahead of
//# its consumer; `Channel.unbuffered()` makes every send wait for a
//# receive. `Sender.send` returns `Err` once the channel is closed,
//# `Sender.close` closes it, and `Receiver.receive` returns `None` when it
//# is closed and drained. `Channel.select` waits on several channel
//# operations and timers at once, and `Receiver.receive_within` on one
//# channel with a timeout. How a task waiting on a channel is cancelled is a
//# language rule ([Concurrency](/spec/concurrency/)).
//#
//# ## Multiplexing
//#
//# Producers that share one message type fan in through a single channel
//# of an enum:
//#
//# ```nomi
//# concurrent {
//#     events: Channel<Event> = Channel.buffered(2)
//#
//#     p1 = Task.spawn(fn -> Sender.send(events.sender, Event.UserMsg("hello")))
//#     p2 = Task.spawn(fn -> Sender.send(events.sender, Event.Tick(1)))
//#
//#     case Receiver.receive(events.receiver) {
//#         Some(.UserMsg(msg)) -> handle_msg(msg)
//#         Some(.Tick(n)) -> handle_tick(n)
//#         Some(.Shutdown) -> io.print("shutting down")
//#         None -> io.print("channel closed")
//#     }
//#
//#     _ = Task.await(p1)
//#     _ = Task.await(p2)
//#     Ok(Unit)
//# }
//# ```
//#
//# The enum is the multiplexing mechanism: producers tag their messages,
//# and the consumer pattern matches on variants.
//#
//# `Channel.select` covers what one channel cannot: a timeout, a send that
//# must not block, and channels of different element types or owned by
//# different code. Each arm's handler maps its own outcome to the result:
//#
//# ```nomi
//# answer = Channel.select([
//#     Arm.receive(replies, fn reply -> Maybe.with_default(reply, "closed")),
//#     Arm.receive(errors, fn error -> "failed: ${Maybe.with_default(error, 0)}"),
//#     Arm.after(Duration.seconds(5), fn -> "timed out"),
//# ])
//# ```

import {
    duration.Duration
    int.Int
    lists.List
    maybe.Maybe
    results.Result
    tasks.Task
    unit.Unit
}

/// Typed FIFO channel for communication between tasks, held as its two
/// halves. Producers `Sender.send` values; consumers `Receiver.receive` them
/// in arrival order.
///
/// The halves are what you pass around. A worker that reads its inbox
/// takes a `Receiver<T>` and cannot send on it; the callers hold the
/// `Sender<T>` and cannot read what they wrote. Handing over a whole
/// `Channel<T>` hands over both, which is right for the code that
/// created it and rarely right for anything downstream.
///
/// A channel is either buffered or not, and that is a choice about
/// coupling rather than a size: `Channel.buffered` lets a producer run
/// ahead by up to `capacity` values, while `Channel.unbuffered` makes
/// every `send` a rendezvous that waits for a paired `receive`. There is
/// no `Channel.new` — there is no third thing a channel could be.
///
/// Channels live independent of any specific `concurrent { }` block:
/// a channel can be created in one block, returned out of it, and
/// consumed by a later block. They are garbage-collected by the
/// host runtime when no Nomi reference remains.
//
pub struct Channel<T> {
    /// The writing half. Give this to whoever produces values.
    sender: Sender<T>

    /// The reading half. Give this to whoever consumes them.
    receiver: Receiver<T>
}

/// The writing half of a `Channel<T>`, and the half that can close it.
///
/// Closing is a producer's statement that nothing more is coming, which
/// is why it lives here and not on `Receiver`: a consumer closing what it
/// reads ends the conversation for everyone still writing, and it is a
/// mistake that reads like ordinary cleanup. There is no way to write it
/// now.
pub host type Sender<T>

/// The reading half of a `Channel<T>`. Receiving is all it does — a
/// consumer holding one can neither write to the channel nor close it.
pub host type Receiver<T>

impl Channel<T> {
    /// Construct a `Channel<T>` that buffers up to `capacity` pending values, so a
    /// producer can run that far ahead of its consumer before `send` blocks.
    ///
    /// `capacity` must be at least 1. Zero is not a small buffer, it is a
    /// different mode, and it has its own constructor -- passing 0 here is rejected
    /// rather than quietly aliased to `Channel.unbuffered`.
    //! ch = Channel.buffered<Int>(1)
    //! assert Ok(_) = Sender.send(ch.sender, 7)
    //! assert Receiver.receive(ch.receiver) == Maybe.Some(7)
    //
    pub host fn buffered<T>(capacity: Int) -> Channel<T>

    /// Construct a `Channel<T>` with no buffer, where every `send` waits for a
    /// paired `receive` and vice versa.
    ///
    /// This couples the two sides' schedules: a send is a rendezvous, not a
    /// hand-off, so it does not return until somebody is on the other end. That
    /// makes it a poor fit for reporting work nobody is waiting on, and it
    /// deadlocks outright if the same task sends and then receives. Under `clock
    /// Clock.Virtual` that deadlock is reported; on the system clock it simply
    /// hangs.
    //! ch = Channel.unbuffered<Int>()
    //!
    //! sent = concurrent {
    //!     w = Task.spawn(fn -> Sender.send(ch.sender, 7))
    //!     got = Receiver.receive(ch.receiver)
    //!     _ = Task.await(w)
    //!     got
    //! }
    //!
    //! assert sent == Maybe.Some(7)
    //
    pub host fn unbuffered<T>() -> Channel<T>

    /// Wait until one of `arms` can finish, run that arm's handler, and
    /// return what it returns. An arm is a receive (`Arm.receive`), a send
    /// (`Arm.send`) or a timer (`Arm.after`), and the arms may be on channels
    /// of different element types, since each handler turns its own outcome
    /// into the one result type `R`.
    ///
    /// When several arms can finish as `select` starts, the first one listed
    /// wins, so a run repeats exactly. That is a bias: an arm listed first
    /// that is always ready keeps the others waiting. A loop that must serve
    /// several busy channels fairly rotates its arms each round. Once
    /// `select` is waiting, the first arm to become ready wins.
    ///
    /// A receive on a closed channel is ready at once with `None`, and a send
    /// on one is ready at once with `Err(ChannelClosed)`, so a `select` whose
    /// channels are all closed runs its first listed channel arm. A timer
    /// counts on the clock in force: under `clock Clock.Virtual` it fires as
    /// soon as every task is waiting, without a real wait. A timer of zero
    /// or less is ready at once, so `Arm.after` of zero listed last makes a
    /// `select` that never waits. An empty list of arms is a fault.
    ///
    /// Waiting is cancellable, as `Receiver.receive` is: when the enclosing
    /// `concurrent` block's context fires, the wait ends and no handler runs.
    //! ch = Channel.buffered<Int>(1)
    //! assert Ok(_) = Sender.send(ch.sender, 7)
    //!
    //! got = Channel.select([
    //!     Arm.receive(ch.receiver, fn n -> Maybe.with_default(n, 0)),
    //!     Arm.after(Duration.seconds(1), fn -> -1),
    //! ])
    //!
    //! assert got == 7
    //
    pub host fn select<R>(arms: List<Arm<R>>) -> R
}

impl Sender<T> {
    /// Send a value on the channel. Blocks until the value is taken (for
    /// unbuffered channels) or capacity is available (for buffered). Returns
    /// `Err(ChannelClosed)` if the channel was closed at send time.
    /// Cancellation-aware: when called from inside a `concurrent { }` block whose
    /// context fires (via deadline or upstream cancellation), the send unwinds
    /// silently -- user code observes ancestor cancellation through other
    /// cancellation-aware sites, not here.
    //! ch = Channel.buffered<Int>(1)
    //! assert Ok(_) = Sender.send(ch.sender, 7)
    //
    pub host fn send<T>(sender: Sender<T>, value: T) -> Result<Unit, ChannelClosed>

    /// Close the channel. Subsequent `send` calls return `Err(ChannelClosed)`;
    /// pending blocked sends panic at runtime (the program is responsible for
    /// sequencing close so there are no blocked senders at close time).
    /// Double-close is a runtime error.
    //! ch = Channel.buffered<Int>(1)
    //! Sender.close(ch.sender)
    //! assert Receiver.receive(ch.receiver) == Maybe.None
    //! assert Sender.send(ch.sender, 7) == Result.Err(ChannelClosed)
    //
    pub host fn close<T>(sender: Sender<T>) -> Unit

    /// Close the channel when the program starts shutting down, as its
    /// supervisors begin to drain. A task that reads the channel until it
    /// closes then finishes what is queued and ends, so the drain does not
    /// wait out its grace period for a reader parked on an empty channel.
    /// A `close` before shutdown cancels it, and a `close` after shutdown
    /// closed the channel is no double close.
    //! ch = Channel.buffered<Int>(1)
    //! Sender.close_on_drain(ch.sender)
    //! assert Ok(_) = Sender.send(ch.sender, 1)
    //! Sender.close(ch.sender)
    //! assert Receiver.receive(ch.receiver) == Maybe.Some(1)
    //
    pub host fn close_on_drain<T>(sender: Sender<T>) -> Unit
}

impl Receiver<T> {
    /// Receive the next value from the channel. Blocks until a value arrives, the
    /// channel is closed and drained (returns `None`), or the enclosing concurrent
    /// block's context fires (silent unwind). After close, any remaining buffered
    /// values are delivered to subsequent `receive` calls; thereafter every call
    /// returns `None`.
    //! ch = Channel.buffered<Int>(1)
    //! assert Ok(_) = Sender.send(ch.sender, 7)
    //! assert Receiver.receive(ch.receiver) == Maybe.Some(7)
    //
    pub host fn receive<T>(receiver: Receiver<T>) -> Maybe<T>

    /// Receive the next value, waiting at most `wait`. `Ok(Some(value))` is a
    /// value, `Ok(None)` a channel closed and drained, and `Err(TimedOut)` a
    /// wait that ran out first, on the clock in force. A value already
    /// waiting is received even when `wait` is zero.
    ///
    /// For waiting on more than one channel, or on a send, use
    /// `Channel.select`.
    //! ch = Channel.buffered<Int>(1)
    //! assert Receiver.receive_within(ch.receiver, Duration.seconds(0)) == Result.Err(TimedOut)
    //! assert Ok(_) = Sender.send(ch.sender, 7)
    //! assert Receiver.receive_within(ch.receiver, Duration.seconds(1)) == Result.Ok(Maybe.Some(7))
    //
    pub host fn receive_within<T>(
        receiver: Receiver<T>,
        wait: Duration,
    ) -> Result<Maybe<T>, TimedOut>
}

/// One way a `Channel.select` can finish, with the handler that turns its
/// outcome into the `select`'s result. Build one with `Arm.receive`,
/// `Arm.send` or `Arm.after`.
pub host type Arm<R>

impl Arm<R> {
    /// An arm that finishes when `receiver` has a value, or is closed and
    /// drained, and passes `handle` the value or `None`.
    //! ch = Channel.buffered<Int>(1)
    //! Sender.close(ch.sender)
    //! assert Channel.select([Arm.receive(ch.receiver, fn n -> n)]) == Maybe.None
    //
    pub host fn receive<T, R>(receiver: Receiver<T>, handle: (Maybe<T>) -> R) -> Arm<R>

    /// An arm that finishes when `value` can be sent on `sender`, and passes
    /// `handle` the send's result: `Ok(Unit)`, or `Err(ChannelClosed)` when
    /// the channel is closed.
    //! ch = Channel.buffered<Int>(1)
    //! sent = Channel.select([Arm.send(ch.sender, 7, fn r -> r == Result.Ok(Unit))])
    //! assert sent
    //! assert Receiver.receive(ch.receiver) == Maybe.Some(7)
    //
    pub host fn send<T, R>(
        sender: Sender<T>,
        value: T,
        handle: (Result<Unit, ChannelClosed>) -> R,
    ) -> Arm<R>

    /// An arm that finishes once `wait` has passed on the clock in force,
    /// counted from the start of the `select`, and runs `handle`.
    //! ch = Channel.buffered<Int>(1)
    //!
    //! got = Channel.select([
    //!     Arm.receive(ch.receiver, fn _ -> "a value"),
    //!     Arm.after(Duration.seconds(0), fn -> "nothing yet"),
    //! ])
    //!
    //! assert got == "nothing yet"
    //
    pub host fn after<R>(wait: Duration, handle: () -> R) -> Arm<R>
}

/// Returned by `Sender.send` when the channel was closed at the time
/// the send attempted to enqueue. `Sender.close` itself is a one-shot
/// operation (panics on double-close, matching Go); user code should
/// plan shutdown so close happens exactly once.
pub type ChannelClosed

/// Returned by `Receiver.receive_within` when its wait ran out before a
/// value arrived or the channel closed.
pub type TimedOut
