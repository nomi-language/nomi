import {
    bool.Bool
    lists.List
    maybe.Maybe
    strings.String
}

//# The `Matcher` interface: what `String.split`, `String.replace`,
//# `String.starts_with`, `String.ends_with`, `String.find` and
//# `String.find_all` accept as the thing to look for. A `String` matches its
//# own text, a `Regex` matches its pattern, and a `Codepoint` matches itself.
//# `String.contains` takes the same three, as String's `Contains` impls.

/// Something to look for in a string. `String`, `Regex` and `Codepoint`
/// implement it, so the String search functions take any of them:
///
/// ```nomi
/// String.split("a,b", ",") // ["a", "b"]
///
/// String.split("a1b22c", Regex`\d+`) // ["a", "b", "c"]
/// ```
///
/// Each function answers one String operation for `text`, with the matcher
/// first. Call the String functions rather than these; they exist so a type can
/// say how it is found, and so a function of your own can take any matcher with
/// `where M: Matcher`.
//! import std/regex.Regex
//!
//! digits = Regex`\d+`
//! assert String.contains("order 66", digits)
//! assert String.contains("order 66", "66")
//! assert Matcher.split_in(",", "a,b") == ["a", "b"]
//
pub interface Matcher {
    /// True if the matcher matches anywhere in `text`.
    fn is_contained_in(m: self, text: String) -> Bool
    /// True if a match starts at the beginning of `text`.
    fn is_prefix_of(m: self, text: String) -> Bool
    /// True if a match ends at the end of `text`.
    fn is_suffix_of(m: self, text: String) -> Bool
    /// The pieces of `text` between non-overlapping matches.
    fn split_in(m: self, text: String) -> List<String>
    /// `text` with every non-overlapping match replaced by `replacement`,
    /// taken literally.
    fn replace_in(m: self, text: String, replacement: String) -> String
    /// Every non-overlapping match in `text`, left to right.
    fn find_all_in(m: self, text: String) -> List<String>
    /// The first match in `text`, the leftmost: the first element `find_all_in`
    /// returns, or `None` when there is no match.
    fn find_in(m: self, text: String) -> Maybe<String>
}
