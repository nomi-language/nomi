//# URLs (RFC 3986): parsed into parts, built from literals, and
//# percent-encoded. Parsing and writing follow Go's `net/url`.
//#
//# A `Url` is a parsed URL whose fields hold decoded text. `Url.parse` reads
//# text and returns a `UrlError` for text that is not a URL, and `Display`
//# writes the URL back escaped. A `Url` literal is checked when the program
//# is checked, so a malformed one is a compile error, and it is a `Url`, not
//# a `Result`, in every quote style:
//#
//# ```nomi
//# api = Url`https://api.example.com/v1/`
//#
//# users = Url.join_path(api, ["users", id])
//#
//# search = Url.with_query(users, Query[#("tab", "posts"), #("page", "2")])
//# ```
//#
//# In `Url"..."`, each `${...}` slot is escaped for where it stands, so data
//# cannot change the URL's shape: a slot in the path is one segment, one in
//# the query is one key or value, and one after `#` is the fragment. A slot
//# in the scheme, user or host is a compile error, since no escaping makes
//# it safe there; build that URL with `Url.parse`.
//#
//# ```nomi
//# profile = Url"https://example.com/users/${name}?tab=${tab}"
//# ```
//#
//# A `Query` is a query string's pairs, in order, and a key may appear more
//# than once. `Query.encode`, and so `Url.with_query`, writes the pairs in
//# that order.
//#
//# For a piece of text rather than a whole URL, `url.escape_query` escapes a
//# query key or value (a space as `+`), and `url.escape_path_segment` one
//# segment of a path (a space as `%20`, and `/` escaped so it cannot start a
//# new segment). Each `unescape_` function reverses its `escape_` function
//# and returns an `Err` for a malformed `%` escape or text that is not UTF-8
//# once unescaped.
//#
//# ```nomi
//# link = "/search/${url.escape_path_segment(tag)}?q=${url.escape_query(term)}"
//# ```
//#
//# Every function here is pure, so a typed literal's handler may call them.

import {
    bool.Bool.{self, False, True}
    code_points.Codepoint
    display.Display
    equatable.Equatable
    hashable.Hashable
    iter.Iter
    lists.List
    literals.{CheckedLiteral, Fragment, LiteralError}
    maybe.Maybe.{self, None, Some}
    results.Result.{self, Err, Ok}
    strings.String
    unit.Unit
    url_host
}

/// `text` percent-encoded as a query string's key or value: letters, digits
/// and `-_.~` stay, a space becomes `+`, and every other byte of its UTF-8 is
/// `%` and two uppercase hexadecimal digits.
//! import std::url
//!
//! assert url.escape_query("tea & cake") == "tea+%26+cake"
//! assert url.escape_query("a/b?c=d") == "a%2Fb%3Fc%3Dd"
//! assert url.escape_query("café") == "caf%C3%A9"
//
pub fn escape_query(text: String) -> String {
    url_host.escape_query(text)
}

/// The text a query string's key or value holds: `%` escapes decoded, and
/// `+` read as a space.
//! import std::url
//!
//! assert url.unescape_query("tea+%26+cake") == Ok("tea & cake")
//! assert url.unescape_query("caf%C3%A9") == Ok("café")
//! assert url.unescape_query("100%") == Err("invalid percent escape \"%\"")
//! assert url.unescape_query("%FF") == Err("the unescaped text is not valid UTF-8")
//
pub fn unescape_query(text: String) -> Result<String, String> {
    url_host.unescape_query(text)
}

/// `text` percent-encoded as one segment of a URL path: a space becomes
/// `%20`, and `/` and `?` are escaped so the text stays one segment.
//! import std::url
//!
//! assert url.escape_path_segment("tea & cake") == "tea%20&%20cake"
//! assert url.escape_path_segment("a/b?c") == "a%2Fb%3Fc"
//
pub fn escape_path_segment(text: String) -> String {
    url_host.escape_path_segment(text)
}

/// The text a URL path segment holds: `%` escapes decoded, and `+` kept as
/// itself.
//! import std::url
//!
//! assert url.unescape_path_segment("tea%20&%20cake") == Ok("tea & cake")
//! assert url.unescape_path_segment("a+b") == Ok("a+b")
//! assert url.unescape_path_segment("%zz") == Err("invalid percent escape \"%zz\"")
//
pub fn unescape_path_segment(text: String) -> Result<String, String> {
    url_host.unescape_path_segment(text)
}

/// A parsed URL: `scheme://user:password@host/path?query#fragment`. The
/// fields hold decoded text, and `Display` writes the URL back escaped.
pub struct Url {
    /// `https`, lowercase, or empty for a relative URL.
    scheme: String = ""
    /// The `user:password@` part.
    user: Maybe<Userinfo> = None
    /// The host and its port, as `example.com:8080` or `[::1]:80`.
    host: String = ""
    /// The decoded path.
    path: String = ""
    /// The escaped path, set only when it is not the default encoding of
    /// `path` (`/a%2Fb` for the path `/a/b`).
    raw_path: Maybe<String> = None
    /// The encoded query, without the `?`. `Some("")` keeps a lone `?`.
    query: Maybe<String> = None
    /// The decoded fragment, without the `#`.
    fragment: Maybe<String> = None
    /// The escaped fragment, set as `raw_path` is.
    raw_fragment: Maybe<String> = None
    /// A URL with no `//` after the scheme: `ann@example.com` in
    /// `mailto:ann@example.com`.
    opaque_part: Maybe<String> = None
    /// `True` for `file:///etc` read with an empty host that is not
    /// written back as `//`.
    omit_host: Bool = False
}

derive Equatable for Url
derive Hashable for Url

/// A URL's user name and optional password.
pub struct Userinfo {
    name: String
    password: Maybe<String> = None
}

derive Equatable for Userinfo
derive Hashable for Userinfo

/// Why a URL or query could not be read: the text and Go's reason.
pub struct UrlError {
    url: String
    reason: String
}

derive Equatable for UrlError

/// A query string's pairs, in order. A key may appear more than once.
pub type Query List<#(String, String)>

derive Equatable for Query
derive Hashable for Query

impl Url {
    /// `text` read as a URL, absolute or relative, as Go's `url.Parse`
    /// reads it.
    //! import std::url.Url
    //!
    //! u = Url.parse("https://ann:pw@example.com:8080/a%20b?q=1#top")!
    //! assert u.scheme == "https"
    //! assert u.host == "example.com:8080"
    //! assert u.path == "/a b"
    //! assert u.query == Some("q=1")
    //! assert u.fragment == Some("top")
    //! assert Maybe.map(u.user, fn user -> user.name) == Some("ann")
    //! assert Url.parse("http://[::1]:namedport") |> Result.is_err()
    //
    pub fn parse(text: String) -> Result<Url, UrlError> {
        url_host.parse_parts(text, False)
        |> Result.map(from_parts)
        |> Result.map_err(fn reason -> UrlError{url: text, reason})
    }

    /// `text` read as the target of an HTTP request: an absolute URL or an
    /// absolute path, with no fragment. Go's `url.ParseRequestURI`.
    //! import std::url.Url
    //!
    //! assert Url.parse_request_uri("/users?id=7")!.path == "/users"
    //! assert Url.parse_request_uri("users") |> Result.is_err()
    //
    pub fn parse_request_uri(text: String) -> Result<Url, UrlError> {
        url_host.parse_parts(text, True)
        |> Result.map(from_parts)
        |> Result.map_err(fn reason -> UrlError{url: text, reason})
    }

    /// Whether the URL has a scheme.
    //! import std::url.Url
    //!
    //! assert Url.is_absolute(Url`https://example.com`)
    //! assert not Url.is_absolute(Url`/a/b`)
    //
    pub fn is_absolute(url: Url) -> Bool {
        url.scheme != ""
    }

    /// The host without its port, and without the brackets of an IPv6
    /// address.
    //! import std::url.Url
    //!
    //! assert Url.hostname(Url`http://[::1]:8080/`) == "::1"
    //
    pub fn hostname(url: Url) -> String {
        url_host.hostname_parts(to_parts(url))
    }

    /// The host's port, if it names one.
    //! import std::url.Url
    //!
    //! assert Url.port(Url`http://example.com:8080`) == Some("8080")
    //! assert Url.port(Url`http://example.com`) == None
    //
    pub fn port(url: Url) -> Maybe<String> {
        case url_host.port_parts(to_parts(url)) {
            "" -> None
            port -> Some(port)
        }
    }

    /// The path as it is written in the URL: `raw_path` when it is set,
    /// else `path` escaped.
    //! import std::url.Url
    //!
    //! assert Url.escaped_path(Url`https://example.com/a b`) == "/a%20b"
    //
    pub fn escaped_path(url: Url) -> String {
        url_host.escaped_path_parts(to_parts(url))
    }

    /// The fragment as it is written in the URL.
    //! import std::url.Url
    //!
    //! assert Url.escaped_fragment(Url`https://example.com/#a b`) == "a%20b"
    //
    pub fn escaped_fragment(url: Url) -> String {
        url_host.escaped_fragment_parts(to_parts(url))
    }

    /// The target an HTTP request line carries: the escaped path and the
    /// query, or the opaque part.
    //! import std::url.Url
    //!
    //! assert Url.request_uri(Url`https://example.com/a b?q=1#top`) == "/a%20b?q=1"
    //
    pub fn request_uri(url: Url) -> String {
        url_host.request_uri_parts(to_parts(url))
    }

    /// The URL written with its password, if any, replaced by `xxxxx`.
    //! import std::url.Url
    //!
    //! assert Url.redacted(Url`https://ann:secret@example.com/`) == "https://ann:xxxxx@example.com/"
    //
    pub fn redacted(url: Url) -> String {
        url_host.redacted_parts(to_parts(url))
    }

    /// The URL's query read into pairs. A pair Go cannot read is left
    /// out; `Query.parse` reports it instead.
    //! import std::url.{Query, Url}
    //!
    //! assert Url.query_values(Url`https://example.com/?a=1&b=2&a=3`) == Query[
    //!     #("a", "1"),
    //!     #("b", "2"),
    //!     #("a", "3"),
    //! ]
    //
    pub fn query_values(url: Url) -> Query {
        url.query |> Maybe.with_default("") |> query_from_text()
    }

    /// The URL with its query replaced by `query`, encoded as
    /// `Query.encode` writes it, the pairs in their order.
    //! import std::url.{Query, Url}
    //!
    //! u = Url.with_query(Url`https://example.com/s`, Query[#("q", "tea & cake"), #("n", "2")])
    //! assert "${u}" == "https://example.com/s?q=tea+%26+cake&n=2"
    //
    pub fn with_query(url: Url, query: Query) -> Url {
        #{..url, query: Some(Query.encode(query))}
    }

    /// `reference` resolved against `base`, as RFC 3986 section 5.2 does:
    /// how a browser follows a link.
    //! import std::url.Url
    //!
    //! base = Url`https://example.com/a/b/c`
    //! assert "${Url.resolve(base, Url`../d?x=1`)}" == "https://example.com/a/d?x=1"
    //! assert "${Url.resolve(base, Url`//other.org/`)}" == "https://other.org/"
    //
    pub fn resolve(base: Url, reference: Url) -> Url {
        url_host.resolve_parts(to_parts(base), to_parts(reference)) |> from_parts()
    }

    /// `reference` parsed and resolved against `base`.
    //! import std::url.Url
    //!
    //! assert "${Url.resolve_text(Url`https://example.com/a/`, "b")!}" == "https://example.com/a/b"
    //
    pub fn resolve_text(base: Url, reference: String) -> Result<Url, UrlError> {
        Url.parse(reference) |> Result.map(fn r -> Url.resolve(base, r))
    }

    /// The URL with `segments` joined to its path, as Go's `JoinPath`
    /// joins them, and `.` and `..` cleaned from the result. A `/` in a
    /// segment separates segments; escape one with
    /// `url.escape_path_segment` to keep it whole.
    //! import std::url.Url
    //!
    //! u = Url.join_path(Url`https://example.com/api/`, ["users", "7", "../8"])
    //! assert "${u}" == "https://example.com/api/users/8"
    //
    pub fn join_path(url: Url, segments: List<String>) -> Url {
        url_host.join_path_parts(to_parts(url), segments) |> from_parts()
    }
}

impl Display for Url {
    /// The URL written back, escaped as Go's `URL.String` writes it.
    //! import std::url.Url
    //!
    //! assert "${Url.parse("https://example.com/a b?q=1#x y")!}" == "https://example.com/a%20b?q=1#x%20y"
    //
    fn to_string(url: Url) -> String {
        url_host.format_parts(to_parts(url))
    }
}

impl Display for Userinfo {
    /// `name` or `name:password`, escaped as in a URL.
    fn to_string(user: Userinfo) -> String {
        u = Url{scheme: "x", user: Some(user), host: "h"}
        written = "${u}" |> String.drop(4)
        String.take(written, String.length(written) - 2)
    }
}

impl Display for UrlError {
    fn to_string(error: UrlError) -> String {
        "invalid URL ${error.url}: ${error.reason}"
    }
}

impl Query {
    /// `text`, a query string without its `?`, read into pairs in order.
    /// Each key and value is unescaped, `+` read as a space. A `;` or a
    /// bad escape is an `Err`.
    //! import std::url.Query
    //!
    //! assert Query.parse("q=tea+cake&n=2")! == Query[#("q", "tea cake"), #("n", "2")]
    //! assert Query.parse("a=1;b=2") |> Result.is_err()
    //
    pub fn parse(text: String) -> Result<Query, UrlError> {
        case url_host.query_error(text) {
            "" -> Ok(query_from_text(text))
            reason -> Err(UrlError{url: text, reason})
        }
    }

    /// The first value of `key`.
    //! import std::url.Query
    //!
    //! assert Query.get(Query[#("a", "1"), #("a", "2")], "a") == Some("1")
    //! assert Query.get(Query[], "a") == None
    //
    pub fn get(query: Query, key: String) -> Maybe<String> {
        Query.values(query, key) |> List.head()
    }

    /// Every value of `key`, in order.
    pub fn values(query: Query, key: String) -> List<String> {
        Query(pairs) = query
        pairs |> Iter.filter(fn #(k, _) -> k == key) |> Iter.map(fn #(_, v) -> v) |> Iter.to_list()
    }

    /// Whether `key` has a value.
    pub fn has(query: Query, key: String) -> Bool {
        Query(pairs) = query
        Iter.any(pairs, fn #(k, _) -> k == key)
    }

    /// The query with `key`'s values replaced by `value`, in the place of
    /// its first value, or added at the end.
    //! import std::url.Query
    //!
    //! q = Query[#("a", "1"), #("b", "2"), #("a", "3")]
    //! assert Query.set(q, "a", "9") == Query[#("a", "9"), #("b", "2")]
    //! assert Query.set(q, "c", "4") == Query[#("a", "1"), #("b", "2"), #("a", "3"), #("c", "4")]
    //
    pub fn set(query: Query, key: String, value: String) -> Query {
        if not Query.has(query, key) { return Query.add(query, key, value) }
        Query(pairs) = query

        #(_, kept) = Iter.map_reduce(pairs, False, fn seen, #(k, v) -> {
            if k != key { return #(seen, [#(k, v)]) }

            if seen {
                #(True, [])
            } else {
                #(True, [#(k, value)])
            }
        })

        Query(
            kept
            |> Iter.flat_map(fn p -> p)
            |> Iter.to_list()
        )
    }

    /// The query with `value` added to `key`'s values, at the end.
    pub fn add(query: Query, key: String, value: String) -> Query {
        Query(pairs) = query
        Query(pairs + [#(key, value)])
    }

    /// The query without `key`.
    pub fn remove(query: Query, key: String) -> Query {
        Query(pairs) = query

        Query(
            pairs
            |> Iter.filter(fn #(k, _) -> k != key)
            |> Iter.to_list()
        )
    }

    /// The query encoded: each pair as `key=value`, both escaped as
    /// `url.escape_query` does, in the pairs' order and joined with `&`.
    //! import std::url.Query
    //!
    //! assert Query.encode(Query[#("b", "x y"), #("a", "1"), #("b", "&")]) == "b=x+y&a=1&b=%26"
    //
    pub fn encode(query: Query) -> String {
        Query(pairs) = query
        pairs |> Iter.flat_map(fn #(k, v) -> [k, v]) |> Iter.to_list() |> url_host.query_encode()
    }
}

impl Display for Query {
    /// The query's encoding, as `Query.encode`.
    fn to_string(query: Query) -> String {
        Query.encode(query)
    }
}

impl CheckedLiteral<String, Url> for Url {
    /// A `Url` literal is a `Url` in every quote style, never a `Result`,
    /// and is checked when the program is checked: text that `Url.parse`
    /// would refuse is a compile error. ``Url`https://example.com/a` `` is
    /// the URL `Url.parse` reads from its text. In `Url"..."`, each `${...}`
    /// slot is escaped for where it stands: as one path segment in the path,
    /// as a key or value in the query, and as the fragment after `#`. A slot
    /// of `.` or `..` in the path is escaped too, so it cannot climb the path.
    /// A slot in the scheme, user or host is a compile error, since no
    /// escaping makes it safe there; build such a URL with `Url.parse`.
    //! import std::url.Url
    //!
    //! id = "a/b c"
    //! tab = "x&y"
    //! u = Url"https://example.com/users/${id}?tab=${tab}#${tab}"
    //! assert u.path == "/users/a/b c"
    //! assert "${u}" == "https://example.com/users/a%2Fb%20c?tab=x%26y#x&y"
    //!
    //! // An empty slot is an empty segment, and cannot make a relative
    //! // URL name a host: `//b` would be the host `b`.
    //! empty = ""
    //! r = Url"/${empty}/b"
    //! assert r.host == ""
    //! assert "${r}" == "/.//b"
    //!
    //! // A slot of `.` or `..` is written escaped, so data cannot climb the
    //! // path with a dot segment.
    //! up = ".."
    //! f = Url"/files/${up}/secret"
    //! assert "${f}" == "/files/%2E%2E/secret"
    //
    fn check(statics: List<String>) -> Result<Unit, LiteralError> {
        last = Iter.count(statics) - 1

        // Each slot stands where the statics before it leave the URL, so
        // the place of every slot is known from the statics alone.
        #(_, refused) = Iter.reduce(Iter.with_index(statics), #(
            Place.InScheme,
            None,
        ), fn acc, #(i, s) -> {
            #(place, refused) = acc
            after = place_after(place, s)

            refused = case refused {
                Some(_) ->
                    refused

                None ->
                    if i < last and not escapable(after) {
                        Some(
                            LiteralError{
                                fragment: i,
                                offset: Iter.count(String.to_codepoints(s)),
                                message: "a slot in the scheme, user or host cannot be escaped",
                            }
                        )
                    } else {
                        None
                    }
            }

            #(after, refused)
        })

        // The rest of the text must be a URL whatever the slots hold, so it
        // is parsed with a stand-in for each slot.
        case refused {
            Some(e) ->
                Err(e)

            None ->
                case Url.parse(String.join(statics, "x")) {
                    Ok(_) -> Ok(Unit)
                    Err(e) -> Err(LiteralError{fragment: 0, offset: 0, message: e.reason})
                }
        }
    }

    fn build(fragments: List<Fragment<String>>) -> Url {
        #(_, text) = Iter.reduce(fragments, #(Place.InScheme, ""), fn acc, frag -> {
            #(place, text) = acc

            case frag {
                .Static(s) -> #(place_after(place, s), text + s)
                .Dynamic(v) -> #(place, text + slot_text(place, v))
            }
        })

        // check accepted the statics, so the text parses whatever the slots
        // held.
        Url.parse(keep_path(fragments, text))!
    }
}

// Whether a slot at place can be escaped: in the path, the query or the
// fragment.
fn escapable(place: Place) -> Bool {
    case place {
        .InPath or .InQuery or .InFragment -> True
        _ -> False
    }
}

// A slot's text at place, escaped for it. check refuses a slot anywhere
// else, so the last arm is never reached.
fn slot_text(place: Place, value: String) -> String {
    case place {
        .InPath -> path_slot(value)
        .InQuery -> url_host.escape_query(value)
        .InFragment -> url_host.escape_fragment(value)
        _ -> ""
    }
}

// A path slot's text: one escaped segment. Escaping leaves `.` alone, so a
// value of `.` or `..` would be a dot segment, which a client resolving the
// path removes or climbs with; such a value is written `%2E` or `%2E%2E`.
fn path_slot(value: String) -> String {
    if value == "." {
        "%2E"
    } else if value == ".." {
        "%2E%2E"
    } else {
        url_host.escape_path_segment(value)
    }
}

// The literal's text, written so a slot cannot make it name a host. A URL
// with no authority whose path starts with `//` reads as the host after the
// slashes, and an empty slot after a leading `/` writes exactly that
// (`Url"/${x}/b"` with `x = ""`). WHATWG's URL serializer keeps such a path
// a path by writing `/.` before it, and so does this.
fn keep_path(fragments: List<Fragment<String>>, text: String) -> String {
    first = case fragments {
        [.Static(s), ..] -> s
        _ -> ""
    }

    if String.starts_with(text, "//") and not String.starts_with(first, "//") {
        "/." + text
    } else {
        text
    }
}

// Where a Url"..." literal's text has reached, to escape a slot there.
enum Place {
    InScheme
    InAuthority
    InPath
    InQuery
    InFragment
}

fn place_after(place: Place, text: String) -> Place {
    #(after, _) =
        String.to_codepoints(text)
        |> Iter.reduce(#(place, ""), fn acc, cp -> {
            #(p, seen) = acc
            seen = seen + Codepoint.to_string(cp)
            c = Codepoint.to_string(cp)

            next = case p {
                .InScheme ->
                    if String.ends_with(seen, "://") {
                        Place.InAuthority
                    } else if String.ends_with(seen, ":/") {
                        p
                    } else if c == "/" {
                        Place.InPath
                    } else if c == "?" {
                        Place.InQuery
                    } else if c == "#" {
                        Place.InFragment
                    } else {
                        p
                    }

                .InAuthority ->
                    if c == "/" {
                        Place.InPath
                    } else if c == "?" {
                        Place.InQuery
                    } else if c == "#" {
                        Place.InFragment
                    } else {
                        p
                    }

                .InPath ->
                    if c == "?" {
                        Place.InQuery
                    } else if c == "#" {
                        Place.InFragment
                    } else {
                        p
                    }

                .InQuery ->
                    if c == "#" { Place.InFragment } else { p }

                .InFragment ->
                    p
            }

            #(next, seen)
        })

    after
}

fn query_from_text(text: String) -> Query {
    Query(pairs_of(url_host.query_pairs(text)))
}

fn pairs_of(flat: List<String>) -> List<#(String, String)> {
    case flat {
        [k, v, ..rest] -> [#(k, v), ..pairs_of(rest)]
        _ -> []
    }
}

fn maybe_text(text: String) -> Maybe<String> {
    if text == "" { None } else { Some(text) }
}

fn flag(b: Bool) -> String {
    if b { "1" } else { "" }
}

// A Url's parts, as rt/url.go reads them.
fn to_parts(url: Url) -> List<String> {
    #(has_user, user, has_password, password) = case url.user {
        Some(u) ->
            #("1", u.name, flag(Maybe.is_some(u.password)), Maybe.with_default(u.password, ""))

        None ->
            #("", "", "", "")
    }

    [
        url.scheme,
        Maybe.with_default(url.opaque_part, ""),
        has_user,
        user,
        has_password,
        password,
        url.host,
        url.path,
        Maybe.with_default(url.raw_path, ""),
        flag(url.query == Some("")),
        Maybe.with_default(url.query, ""),
        Maybe.with_default(url.fragment, ""),
        Maybe.with_default(url.raw_fragment, ""),
        flag(url.omit_host),
    ]
}

fn from_parts(parts: List<String>) -> Url {
    case parts {
        [
            scheme,
            opaque_text,
            has_user,
            user,
            has_password,
            password,
            host,
            path,
            raw_path,
            force_query,
            raw_query,
            fragment,
            raw_fragment,
            omit_host,
        ] -> {
            Url{
                scheme,
                opaque_part: maybe_text(opaque_text),
                user: if has_user == "" {
                    None
                } else {
                    Some(
                        Userinfo{
                            name: user,
                            password: if has_password == "" {
                                None
                            } else {
                                Some(password)
                            },
                        }
                    )
                },
                host,
                path,
                raw_path: maybe_text(raw_path),
                query: if force_query != "" or raw_query != "" {
                    Some(raw_query)
                } else {
                    None
                },
                fragment: maybe_text(fragment),
                raw_fragment: maybe_text(raw_fragment),
                omit_host: omit_host != "",
            }
        }

        _ ->
            todo
    }
}
