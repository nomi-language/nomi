//# Processes: how the running program ends, and the programs it starts.
//#
//# A `main` that returns `Err(Exit{code: 2, message: "usage: count
//# <file>"})` prints the message to stderr and exits with status 2. There
//# is no function that exits on the spot: returning `Exit` through `?` ends
//# the program the way returning from `main` does, so `defer`s run and
//# supervisors drain first.
//#
//# A `Command` names a program and its arguments, with no shell between:
//# nothing in an argument is expanded, split or quoted, so an argument
//# holding a space or a `*` reaches the program as it is. `output` runs it
//# to the end and answers what it wrote, `run` runs it with its output
//# going to the program's own, and `with_spawned` runs a body while it
//# runs, with its three streams to read and write. A program that ends
//# with a non-zero code is a `Status` to inspect, not an error; an `Err`
//# means it could not be started.
//#
//# ```nomi
//# import {
//#     std/io.Error
//#     std/process.{self, Command, Status}
//# }
//#
//# fn main() -> Result<Unit, Error> {
//#     listed = process.output(Command{program: "git", args: ["status", "--short"]})?
//#     dbg Status.is_success(listed.status)
//#     Ok(Unit)
//# }
//# ```
//#
//# Tests run commands against `std/process_testing`'s fake, which starts
//# nothing. A WebAssembly target has no processes: `nomi build` for
//# js/wasm or wasip1 refuses a program that starts one.

import {
    bool.Bool.{False, True}
    bytes.Bytes
    display.Display
    equatable.Equatable
    int.Int
    io.{Error, Reader, Writer}
    lists.List
    maps.Map
    maybe.Maybe.{self, None, Some}
    process_host
    results.Result.{self, Ok}
    strings.String
}

/// What a `main` or an entry boot answers in its `Err` to end the program
/// with a status of its choosing. The program prints `message` and a
/// newline to stderr when it is not empty, with no `error: ` before it, and
/// exits with `code`. A `code` outside 0 to 255 is a trap. An `Exit` with
/// code 0 ends the program successfully, its message printed all the same.
///
/// ```nomi
/// import std/process.Exit
///
/// fn main() -> Result<Unit, Exit> {
///     Err(Exit{code: 2, message: "usage: count <file>"})
/// }
/// ```
//! failed = Exit{message: "no input"}
//! assert failed.code == 1
//! assert Exit{} == Exit{code: 1, message: ""}
//
pub struct Exit {
    /// The exit status, 0 to 255.
    code: Int = 1
    /// What to print to stderr before exiting; nothing when empty.
    message: String = ""
}

/// A program to start and how: an immutable value, so one command can be
/// run any number of times.
//! command = Command{program: "git", args: ["log", "-1"], dir: Some("repo")}
//! assert command.env == %{}
//! assert not command.clear_env
//
pub struct Command {
    /// The program: a name with no `/`, looked up on the `PATH`, or a
    /// path to it.
    program: String
    /// The arguments, each passed as it is.
    args: List<String> = []
    /// Variables added to the environment, replacing any of the same name.
    env: Map<String, String> = %{}
    /// Start from an empty environment, so the program sees `env` alone.
    clear_env: Bool = False
    /// The directory the program runs in, relative to the working
    /// directory; `None` runs it in the working directory.
    dir: Maybe<String> = None
    /// What the program reads on its standard input, for `output` and
    /// `run`.
    stdin: Stdin = Stdin.Null
}

/// What a started program reads on its standard input.
pub enum Stdin {
    /// Nothing: the program reads the end of its input at once.
    Null
    /// The running program's own standard input.
    Inherit
    /// The text, then the end of the input.
    Text String
    /// The bytes, then the end of the input.
    Bytes Bytes
    /// What the reader reads, to its end.
    From Reader
}

/// How a started program ended.
pub enum Status {
    /// It exited with `code`, 0 for success.
    Exited {code: Int}
    /// A signal ended it (on Unix), as a kill does.
    Signaled {signal: Int}
}

derive Equatable for Status

impl Status {
    /// Whether the program exited with code 0.
    //! assert Status.is_success(Status.Exited{code: 0})
    //! assert not Status.is_success(Status.Exited{code: 1})
    //! assert not Status.is_success(Status.Signaled{signal: 9})
    //
    pub fn is_success(status: Status) -> Bool {
        status == Status.Exited{code: 0}
    }

    /// The exit code, or `None` when a signal ended the program.
    //! assert Status.code(Status.Exited{code: 3}) == Some(3)
    //! assert Status.code(Status.Signaled{signal: 9}) == None
    //
    pub fn code(status: Status) -> Maybe<Int> {
        case status {
            Status.Exited{code} -> Some(code)
            Status.Signaled{} -> None
        }
    }
}

impl Display for Status {
    //! assert "${Status.Exited{code: 2}}" == "exited with code 2"
    //! assert "${Status.Signaled{signal: 9}}" == "ended by signal 9"
    //
    fn to_string(status: Status) -> String {
        case status {
            Status.Exited{code} -> "exited with code ${code}"
            Status.Signaled{signal} -> "ended by signal ${signal}"
        }
    }
}

/// What `output` answers: how the program ended and everything it wrote.
pub struct Output {
    status: Status
    stdout: Bytes
    stderr: Bytes
}

derive Equatable for Output

/// Runs `command` to its end and answers its status and everything it
/// wrote to its standard output and error. A non-zero exit is in the
/// status; an `Err` means the program could not be started (`NotFound`
/// when nothing on the `PATH` has its name). A task that is cancelled, or
/// whose deadline passes, while it waits kills the program.
//! import std/process_testing.{self, Answer}
//!
//! ran = process_testing.run([Answer{program: "echo", stdout: "hi\n"}], fn -> {
//!     output(Command{program: "echo", args: ["hi"]})
//! })
//!
//! assert ran.value == Ok(
//!     Output{
//!         status: Status.Exited{code: 0},
//!         stdout: String.to_bytes("hi\n"),
//!         stderr: String.to_bytes(""),
//!     }
//! )
//
pub fn output(command: Command) -> Result<Output, Error> {
    child = start(command, 2, 2, False)?
    status = Child.wait(child)?

    Ok(Output{
        status,
        stdout: process_host.captured(child.handle, 1),
        stderr: process_host.captured(child.handle, 2),
    })
}

/// Runs `command` to its end with its standard output and error going to
/// the running program's own (and so to an `io.capture` in force), and
/// answers its status.
//! import std/process_testing.{self, Answer}
//! import std/io
//!
//! ran = process_testing.run([Answer{program: "make", stdout: "built\n"}], fn -> {
//!     io.capture("", fn -> run(Command{program: "make"}))
//! })
//!
//! assert ran.value.value == Ok(Status.Exited{code: 0})
//! assert ran.value.output == "built\n"
//
pub fn run(command: Command) -> Result<Status, Error> {
    child = start(command, 1, 1, False)?
    Child.wait(child)
}

/// Starts `command` and runs `body` while it runs, with the program's
/// standard input to write and its standard output and error to read
/// (`Child.stdin`, `Child.stdout`, `Child.stderr`; the command's `stdin` is
/// not used). `Child.wait` closes the input and waits for the program to
/// end. When `body` returns, traps or is cancelled, a program still
/// running is killed, so none outlives the call. An `Err` means the
/// program could not be started.
//! import std/process_testing.{self, Answer, Call}
//!
//! ran = process_testing.run([Answer{program: "sort", stdout: "a\nb\n"}], fn -> {
//!     with_spawned(Command{program: "sort"}, fn child -> {
//!         _ = Writer.write_text(Child.stdin(child), "b\na\n")
//!         status = Child.wait(child)
//!         #(status, Reader.read_all_text(Child.stdout(child)))
//!     })
//! })
//!
//! assert ran.value == Ok(#(Ok(Status.Exited{code: 0}), Ok("a\nb\n")))
//! assert ran.calls == [Call{program: "sort", input: String.to_bytes("b\na\n")}]
//
pub fn with_spawned<T>(command: Command, body: (Child) -> T) -> Result<T, Error> {
    child = start(command, 3, 3, True)?
    defer process_host.kill(child.handle)
    Ok(body(child))
}

/// A program `with_spawned` started.
pub opaque struct Child {
    handle: process_host.Child
}

impl Child {
    /// The writer to the program's standard input. Writes are buffered:
    /// `Writer.flush` sends them on, and `Child.wait` or `Writer.close`
    /// ends the input.
    pub fn stdin(child: Child) -> Writer {
        process_host.child_stdin(child.handle)
    }

    /// The reader over the program's standard output. Read it before
    /// waiting when the program writes more than a pipe holds, or it
    /// stops until something reads.
    pub fn stdout(child: Child) -> Reader {
        process_host.child_stdout(child.handle)
    }

    /// The reader over the program's standard error.
    pub fn stderr(child: Child) -> Reader {
        process_host.child_stderr(child.handle)
    }

    /// Ends the program's standard input and waits for it to end. A
    /// second wait answers the first's status.
    pub fn wait(child: Child) -> Result<Status, Error> {
        parts = process_host.wait(child.handle)?

        case parts {
            [1, signal] -> Ok(Status.Signaled{signal})
            [_, code] -> Ok(Status.Exited{code})
            _ -> unreachable "process_host.wait answers a kind and a number"
        }
    }
}

// Starts command with its output and error in the modes given (the
// program's 1, captured 2, piped 3), and its input piped when piped is
// set, else as the command says.
fn start(command: Command, stdout: Int, stderr: Int, piped: Bool) -> Result<Child, Error> {
    #(mode, input) = if piped {
        #(3, Reader.from_text(""))
    } else {
        stdin_of(command.stdin)
    }

    handle = process_host.start(
        command.program,
        command.args,
        command.env,
        command.clear_env,
        Maybe.with_default(command.dir, ""),
        mode,
        input,
        stdout,
        stderr,
    )?

    Ok(Child{handle})
}

fn stdin_of(stdin: Stdin) -> #(Int, Reader) {
    case stdin {
        Stdin.Null -> #(0, Reader.from_text(""))
        Stdin.Inherit -> #(1, Reader.from_text(""))
        Stdin.Text(text) -> #(2, Reader.from_text(text))
        Stdin.Bytes(data) -> #(2, Reader.from_bytes(data))
        Stdin.From(reader) -> #(2, reader)
    }
}
