//# Processes: how the running program ends, and the programs it starts.
//#
//# A `main` that returns `Err(Exit{code: 2, message: "usage: count
//# <file>"})` prints the message to stderr and exits with status 2. There
//# is no function that exits on the spot: returning `Exit` through `?` ends
//# the program the way returning from `main` does, so `defer`s run and
//# supervisors drain first.
//#
//# A `Command` names a program and its arguments, with no shell between:
//# nothing in an argument is expanded, split or quoted, so an argument
//# holding a space or a `*` reaches the program as it is. `output` runs it
//# to the end and returns what it wrote. `run` runs it with its output
//# going to the program's own. `spawn` starts it with its three streams to
//# read and write, and `defer Child.kill(child)` stops it when the function
//# that started it ends. A program that ends with a non-zero code is a
//# `Status` to inspect, not an error; an `Err` means it could not be
//# started.
//#
//# ```nomi
//# import
//#     std::io.Error
//#     std::process.{self, Command, Status}
//# end
//#
//# fn main() -> Result<Unit, Error>
//#     listed = process.output(Command{program: "git", args: ["status", "--short"]})?
//#     dbg Status.is_success(listed.status)
//#     Ok(Unit)
//# end
//# ```
//#
//# A started program has a process id, `Child.id`, and `Child.signal`
//# sends it a `Signal`. `Child.stop` is the way to end one that should get
//# the chance to finish its work: it sends `Signal.Terminate`, waits up to
//# a grace period, then kills it. A `Command` with `new_group` starts the
//# program in a process group of its own, and `Child.signal_group` and
//# `Child.stop` then reach every program it starts as well, as a shell
//# script's commands. `process.id` is this program's own id.
//#
//# A program started here is not tied to this one by the operating
//# system. When a function that spawned it returns, its deferred
//# `Child.kill` ends it; when a task is cancelled, the programs that task
//# started are killed. When this program is ended by an interrupt or a
//# terminate signal, its supervisors drain, which cancels their tasks and
//# kills the programs those tasks started, and then it exits: a program
//# started outside a supervisor's task keeps running unless the signal
//# reached it too, as Ctrl-C at a terminal reaches every program in the
//# terminal's foreground group, which a program started with `new_group`
//# is not in.
//#
//# Tests run commands against `std::process::testing`'s fake, which starts
//# nothing. A WebAssembly target has no processes: `nomi build` for
//# js/wasm or wasip1 refuses a program that starts one. `process.id` works
//# on every target, and answers 1 on js/wasm and wasip1.

import
    bool.Bool.{False, True}
    bytes.Bytes
    channels.{Channel, Receiver, Sender}
    display.Display
    duration.Duration
    equatable.Equatable
    int.{Int, Int64, PositiveInt}
    io.{Error, Reader, Writer}
    lists.List
    maps.Map
    option.Option.{self, None, Some}
    process::host
    resources.Release
    results.Result.{self, Err, Ok}
    strings.String
    tasks.Task
    unit.Unit
end

/// What a `main` or an entry boot returns in its `Err` to end the program
/// with a status of its choosing. The program prints `message` and a
/// newline to stderr when it is not empty, with no `error: ` before it, and
/// exits with `code`. An `Exit` with code 0 ends the program successfully,
/// its message printed all the same.
///
/// ```nomi
/// import std::process.Exit
///
/// fn main() -> Result<Unit, Exit>
///     Err(Exit{code: 2, message: "usage: count <file>"})
/// end
/// ```
//! failed = Exit{message: "no input"}
//! assert failed.code == 1
//! assert Exit{} == Exit{code: 1, message: ""}
//
pub struct Exit
    /// The exit status.
    code: ExitCode = 1
    /// What to print to stderr before exiting; nothing when empty.
    message: String = ""
end

/// A status a program can exit with: 0 to 255. A literal outside it does
/// not compile; a computed code goes through `ExitCode.try_from`.
//! assert ExitCode.try_from(255) == Some(255)
//! assert ExitCode.try_from(256) == None
//! assert ExitCode.try_from(-1) == None
//
pub refine ExitCode Int when fn code -> code >= 0 and code <= 255

/// A program to start and how: an immutable value, so one command can be
/// run any number of times.
//! command = Command{program: "git", args: ["log", "-1"], dir: Some("repo")}
//! assert command.env == {}
//! assert not command.clear_env
//
pub struct Command
    /// The program: a name with no `/`, looked up on the `PATH`, or a
    /// path to it.
    program: String
    /// The arguments, each passed as it is.
    args: List<String> = []
    /// Variables added to the environment, replacing any of the same name.
    env: Map<String, String> = {}
    /// Start from an empty environment, so the program sees `env` alone.
    clear_env: Bool = False
    /// The directory the program runs in, relative to the working
    /// directory; `None` runs it in the working directory.
    dir: Option<String> = None
    /// What the program reads on its standard input, for `output` and
    /// `run`.
    stdin: Stdin = Stdin.Null
    /// Start the program as the leader of a process group of its own, so
    /// `Child.signal_group` and `Child.stop` reach the programs it starts
    /// too, and Ctrl-C at the terminal does not reach it.
    new_group: Bool = False
end

/// What a started program reads on its standard input.
pub enum Stdin
    /// Nothing: the program reads the end of its input at once.
    Null
    /// The running program's own standard input.
    Inherit
    /// The text, then the end of the input.
    Text String
    /// The bytes, then the end of the input.
    Bytes Bytes
    /// What the reader reads, to its end.
    From Reader
end

/// How a started program ended.
pub enum Status
    /// It exited with `code`, 0 for success.
    Exited {code: Int}
    /// A signal ended it (on Unix), as a kill does.
    Signaled {signal: Int}
end

derive Equatable for Status

impl Status
    /// Whether the program exited with code 0.
    //! assert Status.is_success(Status.Exited{code: 0})
    //! assert not Status.is_success(Status.Exited{code: 1})
    //! assert not Status.is_success(Status.Signaled{signal: 9})
    //
    pub fn is_success(status: Status) -> Bool
        status == Status.Exited{code: 0}
    end

    /// The exit code, or `None` when a signal ended the program.
    //! assert Status.code(Status.Exited{code: 3}) == Some(3)
    //! assert Status.code(Status.Signaled{signal: 9}) == None
    //
    pub fn code(status: Status) -> Option<Int>
        case status
            Status.Exited{code:} -> Some(code)
            Status.Signaled{}    -> None
        end
    end
end

impl Display for Status
    //! assert "${Status.Exited{code: 2}}" == "exited with code 2"
    //! assert "${Status.Signaled{signal: 9}}" == "ended by signal 9"
    //
    fn to_string(status: Status) -> String
        case status
            Status.Exited{code:}     -> "exited with code ${code}"
            Status.Signaled{signal:} -> "ended by signal ${signal}"
        end
    end
end

/// A signal one program sends another. Its `Display` is the POSIX name
/// (`SIGTERM`). Windows has only `Kill`; `Child.signal` answers
/// `Error.Unsupported` there for the others.
pub enum Signal
    /// Asks the program to end. A service manager sends it to stop a
    /// service, and most programs end cleanly on it.
    Terminate
    /// An interrupt, as Ctrl-C at a terminal sends.
    Interrupt
    /// The terminal hung up. Many servers read their configuration again
    /// on it.
    Hangup
    /// Ends the program at once. It cannot be caught or ignored.
    Kill
    /// For the program's own use.
    User1
    /// For the program's own use.
    User2
    /// Pauses the program until `Continue`. It cannot be caught.
    Stop
    /// Lets a paused program run again.
    Continue
    /// Asks the program to end and, unless it catches it, to write a core
    /// dump.
    Quit
end

derive Equatable for Signal

impl Display for Signal
    //! assert "${Signal.Terminate}" == "SIGTERM"
    //! assert "${Signal.User1}" == "SIGUSR1"
    //
    fn to_string(signal: Signal) -> String
        case signal
            .Terminate -> "SIGTERM"
            .Interrupt -> "SIGINT"
            .Hangup    -> "SIGHUP"
            .Kill      -> "SIGKILL"
            .User1     -> "SIGUSR1"
            .User2     -> "SIGUSR2"
            .Stop      -> "SIGSTOP"
            .Continue  -> "SIGCONT"
            .Quit      -> "SIGQUIT"
        end
    end
end

/// What `output` returns: how the program ended and everything it wrote.
pub struct Output
    status: Status
    stdout: Bytes
    stderr: Bytes
end

derive Equatable for Output

/// Runs `command` to its end and returns its status and everything it
/// wrote to its standard output and error. A non-zero exit is in the
/// status; an `Err` means the program could not be started (`NotFound`
/// when nothing on the `PATH` has its name). A task that is cancelled, or
/// whose deadline passes, while it waits kills the program.
//! import std::process::testing.{self, Answer}
//!
//! ran = testing.run([Answer{program: "echo", stdout: "hi\n"}], fn ->
//!     output(Command{program: "echo", args: ["hi"]})
//! end)
//!
//! assert ran.value == Ok(
//!     Output{
//!         status: Status.Exited{code: 0},
//!         stdout: String.to_bytes("hi\n"),
//!         stderr: String.to_bytes(""),
//!     }
//! )
//
pub fn output(command: Command) -> Result<Output, Error>
    child = start(command, 2, 2, False)?
    defer Child.kill(child)
    status = Child.wait(child)?

    Ok(Output{
        status:,
        stdout: host.captured(child.handle, 1),
        stderr: host.captured(child.handle, 2),
    })
end

/// Runs `command` to its end with its standard output and error going to
/// the running program's own (and so to an `io.capture` in force), and
/// returns its status.
//! import std::process::testing.{self, Answer}
//! import std::io
//!
//! ran = testing.run([Answer{program: "make", stdout: "built\n"}], fn ->
//!     io.capture("", fn -> run(Command{program: "make"}))
//! end)
//!
//! assert ran.value.value == Ok(Status.Exited{code: 0})
//! assert ran.value.output == "built\n"
//
pub fn run(command: Command) -> Result<Status, Error>
    child = start(command, 1, 1, False)?
    defer Child.kill(child)
    Child.wait(child)
end

/// Starts `command` with the program's standard input to write and its
/// standard output and error to read (`Child.stdin`, `Child.stdout`,
/// `Child.stderr`; the command's `stdin` is not used). Defer `Child.kill`
/// on the next line, so a program still running when the function ends,
/// returns, traps or is cancelled, is killed and none outlives it.
/// `Child.wait` closes the input and waits for the program to end. An
/// `Err` means the program could not be started.
///
/// ```nomi
/// child = process.spawn(Command{program: "sort"})?
///
/// defer Child.kill(child)
/// ```
//! import std::process::testing.{self, Answer, Call}
//!
//! fn sorted(text: String) -> Result<String, Error>
//!     child = spawn(Command{program: "sort"})?
//!     defer Child.kill(child)
//!     Writer.write_text(Child.stdin(child), text)?
//!     _ = Child.wait(child)?
//!     Reader.read_all_text(Child.stdout(child))
//! end
//!
//! ran = testing.run([Answer{program: "sort", stdout: "a\nb\n"}], fn -> sorted("b\na\n"))
//!
//! assert ran.value == Ok("a\nb\n")
//! assert ran.calls == [Call{program: "sort", input: String.to_bytes("b\na\n")}]
//
pub fn spawn(command: Command) -> Result<Child, Error>
    start(command, 3, 3, True)
end

/// This program's process id. A js/wasm or wasip1 module, which has none,
/// answers 1.
//! assert id() >= 1
//
pub fn id() -> PositiveInt
    host.id()
end

/// A program `spawn` started.
pub opaque struct Child
    handle: host.Child
    group:  Bool
end

impl Child
    /// Kills the program if it is still running, and does nothing once it
    /// has ended: the form for a `defer` after `process.spawn`.
    pub fn kill(child: Child) -> Unit
        host.kill(child.handle)
    end

    /// The writer to the program's standard input. Writes are buffered:
    /// `Writer.flush` sends them on, and `Child.wait` or `Writer.close`
    /// ends the input.
    pub fn stdin(child: Child) -> Writer
        host.child_stdin(child.handle)
    end

    /// The reader over the program's standard output. Read it before
    /// waiting when the program writes more than a pipe holds, or it
    /// stops until something reads.
    pub fn stdout(child: Child) -> Reader
        host.child_stdout(child.handle)
    end

    /// The reader over the program's standard error.
    pub fn stderr(child: Child) -> Reader
        host.child_stderr(child.handle)
    end

    /// Ends the program's standard input and waits for it to end. A
    /// second wait returns the first's status.
    pub fn wait(child: Child) -> Result<Status, Error>
        parts = host.wait(child.handle)?

        case parts
            [1, signal] -> Ok(Status.Signaled{signal:})
            [_, code]   -> Ok(Status.Exited{code:})
            _           -> unreachable "host.wait answers a kind and a number"
        end
    end

    /// The program's process id, as the operating system knows it, which
    /// is its own until a wait or a kill has seen it end. Under
    /// `std::process::testing`'s fake it is the start's position among the
    /// calls, from 1.
    //! import std::process::testing.{self, Answer}
    //!
    //! ran = testing.run([Answer{program: "make"}], fn ->
    //!     child = spawn(Command{program: "make"})!
    //!     defer Child.kill(child)
    //!     Child.id(child)
    //! end)
    //!
    //! assert ran.value == 1
    //
    pub fn id(child: Child) -> PositiveInt
        host.child_id(child.handle)
    end

    /// Sends `signal` to the program. A program that has ended is
    /// `Error.Other` with code `ESRCH`, no such process. On Windows only
    /// `Signal.Kill` can be sent, and the others are `Error.Unsupported`.
    //! import std::process::testing.{self, Answer}
    //!
    //! ran = testing.run([Answer{program: "make"}], fn ->
    //!     child = spawn(Command{program: "make"})!
    //!     defer Child.kill(child)
    //!     Child.signal(child, Signal.Hangup)
    //! end)
    //!
    //! assert ran.value == Err(Error.Other{operation: "process.signal", path: "make", code: "ESRCH"})
    //
    pub fn signal(child: Child, signal: Signal) -> Result<Unit, Error>
        host.signal(child.handle, "${signal}", False)
    end

    /// Sends `signal` to every program in the process group the program
    /// leads, which a `Command` with `new_group` starts: the program, and
    /// the programs it started that are still in its group, after it has
    /// ended too. A program started without `new_group` is in this
    /// program's own group, so the call is `Error.Unsupported`. Windows
    /// sends no signal to a group: `Error.Unsupported`.
    pub fn signal_group(child: Child, signal: Signal) -> Result<Unit, Error>
        host.signal(child.handle, "${signal}", True)
    end

    /// Stops the program and returns how it ended: sends it
    /// `Signal.Terminate`, waits up to `grace` for it to end, and kills it
    /// if it has not. A program that ends on the signal reports its own
    /// status, and one killed after the grace is `Status.Signaled{signal:
    /// 9}`. A program started with `new_group` is stopped with its group:
    /// both signals go to every program in it. A program that has already
    /// ended is not signaled, and its status is returned. On Windows, which
    /// sends no `Terminate`, the program is killed at once.
    ///
    /// ```nomi
    /// server = process.spawn(Command{program: "./server", new_group: True})?
    ///
    /// defer Child.kill(server)
    ///
    /// status = Child.stop(server, Duration.seconds(10))?
    /// ```
    //! import std::process::testing.{self, Answer}
    //!
    //! ran = testing.run([Answer{program: "server", code: 3}], fn ->
    //!     child = spawn(Command{program: "server"})!
    //!     defer Child.kill(child)
    //!     Child.stop(child, Duration.seconds(5))
    //! end)
    //!
    //! assert ran.value == Ok(Status.Exited{code: 3})
    //
    pub fn stop(child: Child, grace: Duration) -> Result<Status, Error>
        case send(child, Signal.Terminate)
            Ok(_)  -> wait_up_to(child, grace)
            Err(_) -> kill_all(child)
        end

        Child.wait(child)
    end
end

// Sends signal to child, or to its group when it leads one.
fn send(child: Child, signal: Signal) -> Result<Unit, Error>
    if child.group then
        Child.signal_group(child, signal)
    else
        Child.signal(child, signal)
    end
end

// Waits up to grace for child to end, and kills it, with its group, when
// it has not.
fn wait_up_to(child: Child, grace: Duration)
    concurrent
        ended: Channel<Unit> = Channel.buffered(1)

        waiter = Task.spawn(fn ->
            _ = Child.wait(child)
            _ = Sender.send(ended.sender, Unit)
        end)

        if Receiver.receive_within(ended.receiver, grace) is Err(_) then kill_all(child)

        Task.await(waiter)
    end
end

// Kills child, and every program in its group when it leads one.
fn kill_all(child: Child)
    if child.group then
        _ = Child.signal_group(child, Signal.Kill)
    end

    Child.kill(child)
end

impl Release for Child
    fn release(child: Child)
        Child.kill(child)
    end
end

// Starts command with its output and error in the modes given (the
// program's 1, captured 2, piped 3), and its input piped when piped is
// set, else as the command says.
fn start(command: Command, stdout: Int64, stderr: Int64, piped: Bool) -> Result<Child, Error>
    (mode, input) =
        if piped then
            piped_stdin()
        else
            stdin_of(command.stdin)
        end

    handle = host.start(
        command.program,
        command.args,
        command.env,
        command.clear_env,
        Option.with_default(command.dir, ""),
        mode,
        input,
        stdout,
        stderr,
        command.new_group,
    )?

    Ok(Child{handle:, group: command.new_group})
end

// A standard input the caller writes to: mode 3.
fn piped_stdin() -> (Int64, Reader)
    (3, Reader.from_text(""))
end

fn stdin_of(stdin: Stdin) -> (Int64, Reader)
    case stdin
        Stdin.Null         -> (0, Reader.from_text(""))
        Stdin.Inherit      -> (1, Reader.from_text(""))
        Stdin.Text(text)   -> (2, Reader.from_text(text))
        Stdin.Bytes(data)  -> (2, Reader.from_bytes(data))
        Stdin.From(reader) -> (2, reader)
    end
end
