//# HTML for a server to send: one value type, `Html`, written as an
//# `Html"..."` or `Html"""..."""` literal that the compiler reads as an HTML
//# template when it checks the program (spec §18 *HTML templates*).
//#
//# ```nomi
//# import std::html.Html
//#
//# fn badge(count: Int) -> Html {
//#     Html"<span class='badge'>${count}</span>"
//# }
//#
//# fn comment(author: String, body: String) -> Html {
//#     Html"""
//#     <article class="comment">
//#       <p class="author">${author}</p>
//#       <p>${body}</p>
//#     </article>
//#     """
//# }
//# ```
//#
//# Each `${...}` is written by where it stands. In element text an `Html`
//# is inserted as it is, a `ToHtml` value renders itself, and a `String` or
//# any other `Display` value is escaped as text; a quoted attribute value
//# takes any `Display`; the start of an `href` or `src` takes a `Url` or a
//# `SafeUrl`; later in a URL a value is escaped for the path segment, query
//# value or fragment it stands in, so `/p/${id}` writes a `/` in `id` as
//# `%2F`; a `style` value takes a number or a `Css`; `checked=${on}` takes
//# a `Bool` or a `Maybe<String>` and writes the attribute or leaves it out.
//# Everywhere else a `Maybe` writes its value, or nothing for `None`, so an
//# `if` with no `else` adds a class: `class="badge ${if on { "on" }}"`.
//# A slot where no escaping is safe, markup that is not closed, and a value
//# with no rendering where it stands are compile errors.
//#
//# `Html.each` renders a list, and `Html.concat` joins parts:
//#
//# ```nomi
//# fn names(all: List<String>) -> Html {
//#     Html"<ul>${Html.each(all, fn name -> Html"<li>${name}</li>")}</ul>"
//# }
//# ```
//#
//# An attribute value may be quoted with `"` or `'`. A one-line fragment is
//# usually written `Html"..."` with `'` around its attributes, and markup of
//# several lines `Html"""..."""`.
//#
//# `Html.trusted` inserts markup as written, unescaped: for HTML a trusted
//# renderer produced, such as Markdown, and never for text a user wrote.

import {
    bool.Bool.{self, False, True}
    debug.Debug
    decimal.Decimal
    display.Display
    equatable.Equatable
    float.Float
    html_host.{escape, escape_url_path, filter_url}
    int.Int
    io.{Error, Writer}
    iter.Iter
    lists.List
    maybe.Maybe.{self, None, Some}
    results.Result
    strings.String
    unit.Unit
    url.{self, Url}
    url_host
}

/// Rendered HTML: balanced markup from templates, or markup a program
/// vouches for through `Html.trusted`. Two `Html` values are equal when
/// they render the same text.
//! assert Html.to_string(Html"<b>${"<i>"}</b>") == "<b>&lt;i&gt;</b>"
//!
//! // A `Maybe` in a quoted attribute value writes its value, or nothing.
//! tag = fn on: Bool -> Html"<b class='tag ${if on { "on" }}'></b>"
//! assert Html.to_string(tag(True)) == "<b class='tag on'></b>"
//! assert Html.to_string(tag(False)) == "<b class='tag '></b>"
//!
//! count: Maybe<Int> = None
//! assert Html.to_string(Html"<b data-count='${count}'></b>") == "<b data-count=''></b>"
//
pub opaque struct Html {
    text: String
}

derive Equatable for Html

impl Debug for Html {
    /// The rendered text, as `Html("<p>hi</p>")`.
    //! assert Debug.inspect(Html"<p>hi</p>") == "Html(\"<p>hi</p>\")"
    //
    fn inspect(html: Html) -> String {
        "Html(${Debug.inspect(html.text)})"
    }
}

impl Html {
    /// Markup inserted as written, unescaped: for HTML a trusted renderer
    /// produced, such as Markdown. Never for text from a user, which
    /// `Html.text` or a template's slot escapes.
    //! assert Html.to_string(Html.trusted("<em>x</em>")) == "<em>x</em>"
    //
    pub fn trusted(markup: String) -> Html {
        Html{text: markup}
    }

    /// Text, escaped.
    //! assert Html.to_string(Html.text("a < b & c")) == "a &lt; b &amp; c"
    //
    pub fn text(value: String) -> Html {
        Html{text: escape(value)}
    }

    /// No markup.
    //! assert Html.to_string(Html.empty()) == ""
    //
    pub fn empty() -> Html {
        Html{text: ""}
    }

    /// The parts, in order.
    //! assert Html.to_string(Html.concat([Html"<b>1</b>", Html"<b>2</b>"])) == "<b>1</b><b>2</b>"
    //
    pub fn concat(parts: List<Html>) -> Html {
        Html{text: parts |> Iter.map(&(&1.text)) |> String.join()}
    }

    /// The markup `item` makes of each of `items`, in order.
    //! items = Html.each([1, 2], fn n -> Html"<li>${n}</li>")
    //! assert Html.to_string(items) == "<li>1</li><li>2</li>"
    //
    pub fn each<T>(items: List<T>, item: (T) -> Html) -> Html {
        Html{text: items |> Iter.map(fn x -> item(x).text) |> String.join()}
    }

    /// The markup as text.
    pub fn to_string(html: Html) -> String {
        html.text
    }

    /// Writes the markup to `writer`.
    pub fn write_to(html: Html, writer: Writer) -> Result<Unit, Error> {
        Writer.write_text(writer, html.text)
    }
}

/// A value that renders itself in an element's content: `String` and the
/// numbers as escaped text, an `Html` as it is, a `List<Html>` joined, and
/// a `Maybe` of any of them as its value, or nothing for `None`, so an `if`
/// with no `else` shows its branch or nothing. Element content writes a
/// `Display` value that is not a `ToHtml` as escaped text; a program's own
/// type implements `ToHtml` to render as markup instead.
pub interface ToHtml {
    fn to_html(value: self) -> Html
}

impl ToHtml for String {
    fn to_html(value: String) -> Html {
        Html{text: escape(value)}
    }
}

impl ToHtml for Int {
    fn to_html(value: Int) -> Html {
        Html{text: "${value}"}
    }
}

impl ToHtml for Float {
    fn to_html(value: Float) -> Html {
        Html{text: "${value}"}
    }
}

impl ToHtml for Decimal {
    fn to_html(value: Decimal) -> Html {
        Html{text: "${value}"}
    }
}

impl ToHtml for Html {
    fn to_html(value: Html) -> Html {
        value
    }
}

impl ToHtml for List<Html> {
    fn to_html(value: List<Html>) -> Html {
        Html.concat(value)
    }
}

impl ToHtml for Maybe<T> where T: ToHtml {
    //! n = 3
    //! shown = Html"<p>${if n > 0 { n }}</p>"
    //! hidden = Html"<p>${if n > 5 { Html"<b>big</b>" }}</p>"
    //! assert Html.to_string(shown) == "<p>3</p>"
    //! assert Html.to_string(hidden) == "<p></p>"
    //
    fn to_html(value: Maybe<T>) -> Html {
        case value {
            Some(inner) -> ToHtml.to_html(inner)
            None -> Html.empty()
        }
    }
}

/// A value a URL attribute's value can start with: a `Url`, whose scheme
/// must be http, https, mailto or tel (another is written as
/// `about:invalid#unsafe-url`), or a `SafeUrl`, which the program vouches
/// for.
pub interface UrlValue {
    fn to_url(value: self) -> String
}

impl UrlValue for Url {
    fn to_url(value: Url) -> String {
        filter_url("${value}")
    }
}

/// A URL the program vouches for, whatever its scheme: written as it is,
/// escaped for the attribute.
pub type SafeUrl String

impl UrlValue for SafeUrl {
    fn to_url(SafeUrl(value)) -> String {
        value
    }
}

impl UrlValue for Maybe<T> where T: UrlValue {
    //! home = Url.parse("https://example.com") |> Result.to_maybe()
    //! assert Html.to_string(Html"<a href='${home}'>x</a>") == "<a href='https://example.com'>x</a>"
    //! none: Maybe<SafeUrl> = None
    //! assert Html.to_string(Html"<a href='${none}'>x</a>") == "<a href=''>x</a>"
    //
    fn to_url(value: Maybe<T>) -> String {
        case value {
            Some(inner) -> UrlValue.to_url(inner)
            None -> ""
        }
    }
}

/// A value a `style` attribute can hold: a number, or a `Css` the program
/// vouches for.
pub interface CssValue {
    fn to_css(value: self) -> String
}

impl CssValue for Int {
    fn to_css(value: Int) -> String {
        "${value}"
    }
}

impl CssValue for Float {
    fn to_css(value: Float) -> String {
        "${value}"
    }
}

impl CssValue for Decimal {
    fn to_css(value: Decimal) -> String {
        "${value}"
    }
}

/// CSS the program vouches for, escaped for the attribute.
pub type Css String

impl CssValue for Css {
    fn to_css(Css(value)) -> String {
        value
    }
}

impl CssValue for Maybe<T> where T: CssValue {
    //! wide = False
    //! assert Html.to_string(Html"<i style='width: ${if wide { 80 }}%'></i>") == "<i style='width: %'></i>"
    //
    fn to_css(value: Maybe<T>) -> String {
        case value {
            Some(inner) -> CssValue.to_css(inner)
            None -> ""
        }
    }
}

/// An attribute written or left out by its value, in `name=${value}`:
/// `True` writes the bare attribute and `False` leaves it out; `Some(text)`
/// writes `name="text"` and `None` leaves it out.
pub interface OptionalAttribute {
    /// The attribute's value, `Some("")` for a bare attribute, or `None` to
    /// leave it out.
    fn attribute(value: self) -> Maybe<String>
}

impl OptionalAttribute for Bool {
    fn attribute(value: Bool) -> Maybe<String> {
        if value { Some("") } else { None }
    }
}

impl OptionalAttribute for Maybe<String> {
    fn attribute(value: Maybe<String>) -> Maybe<String> {
        value
    }
}

// The functions an `Html` literal expands into (the compiler's
// internal/analysis/html_template.go). Each slot is a call of the one its
// context chose, so its parameter's interface is the slot's type rule.
fn assemble(parts: List<String>) -> Html {
    Html{text: String.join(parts)}
}

fn slot_text(value: ToHtml) -> String {
    ToHtml.to_html(value).text
}

fn slot_text_display(value: Display) -> String {
    escape("${value}")
}

fn slot_rcdata(value: Display) -> String {
    escape("${value}")
}

fn slot_attribute(value: Display) -> String {
    escape("${value}")
}

fn slot_url_start(value: UrlValue) -> String {
    escape(UrlValue.to_url(value))
}

fn slot_url_path(value: Display) -> String {
    escape(escape_url_path("${value}"))
}

fn slot_url_query(value: Display) -> String {
    escape(url.escape_query("${value}"))
}

fn slot_url_fragment(value: Display) -> String {
    escape(url_host.escape_fragment("${value}"))
}

fn slot_css(value: CssValue) -> String {
    escape(CssValue.to_css(value))
}

fn slot_optional_attribute(name: String, value: OptionalAttribute) -> String {
    case OptionalAttribute.attribute(value) {
        None -> ""
        Some("") -> " ${name}"
        Some(text) -> " ${name}=\"${escape(text)}\""
    }
}

// A `Maybe` in a slot that takes a `Display` writes its value as the slot
// writes one, or nothing for `None`; the checker moves a slot whose value is
// a `Maybe` to these (chooseHtmlTextSlots).
fn slot_rcdata_maybe<T>(value: Maybe<T>) -> String where T: Display {
    case value {
        Some(inner) -> slot_rcdata(inner)
        None -> ""
    }
}

fn slot_attribute_maybe<T>(value: Maybe<T>) -> String where T: Display {
    case value {
        Some(inner) -> slot_attribute(inner)
        None -> ""
    }
}

fn slot_url_path_maybe<T>(value: Maybe<T>) -> String where T: Display {
    case value {
        Some(inner) -> slot_url_path(inner)
        None -> ""
    }
}

fn slot_url_query_maybe<T>(value: Maybe<T>) -> String where T: Display {
    case value {
        Some(inner) -> slot_url_query(inner)
        None -> ""
    }
}

fn slot_url_fragment_maybe<T>(value: Maybe<T>) -> String where T: Display {
    case value {
        Some(inner) -> slot_url_fragment(inner)
        None -> ""
    }
}
