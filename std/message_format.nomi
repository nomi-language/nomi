//# The MessageFormat 2 formatter that `Message.format` (std/message) runs.
//# A `message` declaration's text and its catalogs' translations are
//# MessageFormat 2, which the compiler checks and stores in the program;
//# formatting one picks the text for the locale, selects its variant by the
//# locale's plural rules or an enum's variant, and writes its numbers as
//# the locale does, from the CLDR data the program carries. The module is
//# internal to std/message: only std and a `message` declaration's
//# expansion import it, and a program calls `Message.format`.

import {
    int.Int
    lists.List
    locale.Locale
    strings.String
}

/// The name of the variant `value` is, for an enum whose variants carry
/// nothing: what a message's `:string` formats and selects such a value by.
/// It is the name the declaration writes, whatever the enum's `Debug` says.
//! import std/comparable.Ordering
//!
//! assert message_format.variant_name(Ordering.Less) == "Less"
//
pub host fn variant_name<T>(value: T) -> String

/// The message `table` (the compiled texts a `message` declaration's
/// function holds) in `locale`, with its arguments in parameter order: each
/// one's kind, its number as decimal text, its `:string` key and its text
/// as `Localize` writes it in `locale`. `catalogs` are catalogs loaded
/// while the program runs, as `load` encodes them, which come before the
/// program's own texts.
pub fn format(
    table: String,
    locale: Locale,
    catalogs: List<String>,
    kinds: List<Int>,
    numbers: List<String>,
    keys: List<String>,
    texts: List<String>,
) -> String {
    format_raw(table, locale, catalogs, kinds, numbers, keys, texts)
}

/// The catalog `text` holds for `locale`, checked against the program's
/// compiled messages and nouns: the accepted entries, encoded as `format`
/// reads a catalog, then each rejected entry's name and the reason, in
/// turn. What `Catalog.load` (std/message) calls.
pub fn load(text: String, locale: Locale) -> List<String> {
    load_raw(text, locale)
}

host fn load_raw(text: String, locale: Locale) -> List<String>

/// The noun `table` (the forms and genders a `noun` declaration's value
/// holds) in `locale`: its nominative for one thing, in the nearest locale
/// on `locale`'s fallback chain that translates it, else the source's. It
/// is what a noun's `Localize` writes.
pub fn noun_text(table: String, locale: Locale) -> String {
    noun_raw(table, locale)
}

host fn noun_raw(table: String, locale: Locale) -> String

host fn format_raw(
    table: String,
    locale: Locale,
    catalogs: List<String>,
    kinds: List<Int>,
    numbers: List<String>,
    keys: List<String>,
    texts: List<String>,
) -> String
