import {
    add.Add
    bitwise.{BitwiseAnd, BitwiseNot, BitwiseOr, BitwiseXor}
    bool.Bool
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.Int
    iter.Iter
    lists.List
    maybe.Maybe
    maybe.Maybe.{None, Some}
    results.Result
    results.Result.Ok
    summable.Summable
}

//# Immutable byte buffers and their `Byte` element type. `Bytes` is the FFI
//# boundary for Go `[]byte`; convert to `List<Byte>` only when Nomi code needs
//# to inspect or transform individual bytes.

/// A single byte, 0 through 255. An Int literal written where a Byte is
/// expected is one: `b: Byte = 0x81`, `[0x81, 0x00]` as a `List<Byte>`.
pub host type Byte

impl Byte {
    /// Converts a Byte to its Int value.
    //! b: Byte = 255
    //! assert Byte.to_int(b) == 255
    //
    pub host fn to_int(b: Byte) -> Int
}

impl Display for Byte {
    fn to_string(b: Byte) -> String {
        b |> Byte.to_int() |> Int.to_string()
    }
}

impl Debug for Byte {
    fn inspect(b: Byte) -> String {
        "${b}"
    }
}

impl Equatable for Byte {
    fn equal(a: Byte, b: Byte) -> Bool {
        a == b
    }
}

impl Hashable for Byte {
    fn hash(b: Byte) -> Int {
        Byte.to_int(b)
    }
}

// A Byte has `&&&`, `|||`, `^^^` and `~~~`, whose answers stay within its 8
// bits, and no shift: a left shift would carry bits past them, and Nomi
// traps rather than wrap. Shift the Int, `Byte.to_int(b) <<< 1`.
impl BitwiseAnd<Byte, Byte> for Byte {
    /// Bitwise and, `a &&& b`.
    //! a: Byte = 0b1100
    //! b: Byte = 0b1010
    //! assert a &&& b == 0b1000
    //
    fn bitwise_and(lhs: Byte, rhs: Byte) -> Byte {
        Int.to_byte(Byte.to_int(lhs) &&& Byte.to_int(rhs))!
    }
}

impl BitwiseOr<Byte, Byte> for Byte {
    /// Bitwise or, `a ||| b`.
    //! a: Byte = 0b1100
    //! b: Byte = 0b1010
    //! assert a ||| b == 0b1110
    //
    fn bitwise_or(lhs: Byte, rhs: Byte) -> Byte {
        Int.to_byte(Byte.to_int(lhs) ||| Byte.to_int(rhs))!
    }
}

impl BitwiseXor<Byte, Byte> for Byte {
    /// Bitwise exclusive or, `a ^^^ b`.
    //! a: Byte = 0b1100
    //! b: Byte = 0b1010
    //! assert a ^^^ b == 0b0110
    //
    fn bitwise_xor(lhs: Byte, rhs: Byte) -> Byte {
        Int.to_byte(Byte.to_int(lhs) ^^^ Byte.to_int(rhs))!
    }
}

impl BitwiseNot<Byte> for Byte {
    /// Bitwise not, `~~~b`: each of the 8 bits flipped, `255 - b`.
    //! zero: Byte = 0
    //! high: Byte = 0b1111_0000
    //! assert ~~~zero == 255
    //! assert ~~~high == 0b0000_1111
    //
    fn bitwise_not(value: Byte) -> Byte {
        Int.to_byte(255 ^^^ Byte.to_int(value))!
    }
}

/// Immutable byte buffer.
pub host type Bytes

impl Bytes {
    /// Number of bytes in the buffer.
    //! assert Bytes.length(Bytes.from_list([97, 98])) == 2
    //
    pub host fn length(data: Bytes) -> Int

    /// Returns the byte at zero-based `index`, or None when the index is
    /// outside the buffer. For an index that must exist, `Bytes.get(data,
    /// index)!` answers the byte and traps on any other index.
    //! a: Byte = 97
    //! b: Byte = 98
    //! data = Bytes.from_list([a, b])
    //! assert data |> Bytes.get(0) |> Maybe.map(Byte.to_int) == Some(97)
    //! assert Bytes.get(data, 2) == None
    //! assert data |> Bytes.get(1)! |> Byte.to_int() == 98
    //
    pub host fn get(data: Bytes, index: Int) -> Maybe<Byte>

    /// Returns bytes from start index to end index (start inclusive, end
    /// exclusive). Out-of-range bounds are clamped.
    //! a: Byte = 97
    //! b: Byte = 98
    //! c: Byte = 99
    //! d: Byte = 100
    //! assert Bytes.slice(Bytes.from_list([a, b, c, d]), 1, 3) == Bytes.from_list([b, c])
    //
    pub host fn slice(data: Bytes, start: Int, end: Int) -> Bytes

    /// Concatenates two byte buffers.
    //! a: Byte = 97
    //! b: Byte = 98
    //! c: Byte = 99
    //! d: Byte = 100
    //!
    //! assert Bytes.concat(Bytes.from_list([a, b]), Bytes.from_list([c, d]))
    //!     == Bytes.from_list([a, b, c, d])
    //
    pub host fn concat(a: Bytes, b: Bytes) -> Bytes

    /// Materializes a byte buffer as a list of Byte values.
    //! a: Byte = 97
    //! b: Byte = 98
    //!
    //! assert Bytes.from_list([a, b])
    //! |> Bytes.to_list()
    //! |> Iter.map(Byte.to_int)
    //! |> Iter.to_list() == [97, 98]
    //
    pub host fn to_list(data: Bytes) -> List<Byte>

    /// Builds a byte buffer from a list of Byte values.
    //! a: Byte = 97
    //! b: Byte = 98
    //! assert Bytes.from_list([a, b]) |> Bytes.to_list() == [a, b]
    //
    pub host fn from_list(items: List<Byte>) -> Bytes

    /// Decodes bytes as UTF-8 text.
    //! assert Bytes.from_list([104, 195, 169]) |> Bytes.to_string() == Ok("hé")
    //
    pub host fn to_string(data: Bytes) -> Result<String, String>
}

impl Iter for Bytes {
    /// Pushes each byte to `yield`, stopping when it returns False.
    //! a: Byte = 97
    //! b: Byte = 98
    //!
    //! assert Bytes.from_list([a, b])
    //! |> Iter.map(Byte.to_int)
    //! |> Iter.to_list() == [97, 98]
    //
    host fn each_while(data: Bytes, yield: (Byte) -> Bool) -> Bool
}

impl Contains for Bytes {
    /// True if a byte of the buffer equals `x`. A linear scan that the runtime
    /// runs.
    //! a: Byte = 97
    //! b: Byte = 98
    //! z: Byte = 122
    //! assert Bytes.contains(Bytes.from_list([a, b]), b)
    //! refute Bytes.contains(Bytes.from_list([a, b]), z)
    //! refute Bytes.contains(Bytes.from_list([]), a)
    //
    host fn contains(c: Bytes, x: Byte) -> Bool
}

impl Add<Bytes, Bytes> for Bytes {
    /// Concatenates two byte buffers.
    //! a: Byte = 97
    //! b: Byte = 98
    //! c: Byte = 99
    //! d: Byte = 100
    //! assert Bytes.from_list([a, b]) + Bytes.from_list([c, d]) == Bytes.from_list([a, b, c, d])
    //
    fn add(lhs: Bytes, rhs: Bytes) -> Bytes {
        Bytes.concat(lhs, rhs)
    }
}

impl Summable for Bytes {
    /// The sum of no byte buffers: the empty buffer. Summing Bytes
    /// concatenates them in order.
    //! assert Bytes.length(Bytes.empty_sum()) == 0
    //! a: Byte = 97
    //! b: Byte = 98
    //! assert Bytes.from_list([a]) + Bytes.empty_sum() == Bytes.from_list([a])
    //! assert Iter.sum([Bytes.from_list([a]), Bytes.from_list([b])]) == Bytes.from_list([a, b])
    //
    fn empty_sum() -> Bytes {
        Bytes.from_list([])
    }
}

impl Display for Bytes {
    //! a: Byte = 97
    //! b: Byte = 98
    //! assert Display.to_string(Bytes.from_list([a, b])) == "Bytes(2)"
    //
    fn to_string(data: Bytes) -> String {
        "Bytes(${Bytes.length(data)})"
    }
}

impl Debug for Bytes {
    //! a: Byte = 97
    //! b: Byte = 98
    //! assert Debug.inspect(Bytes.from_list([a, b])) == "<<97, 98>>"
    //! assert Debug.inspect(Bytes.from_list([])) == "<<>>"
    //
    fn inspect(data: Bytes) -> String {
        inner =
            data
            |> Bytes.to_list()
            |> Iter.map(fn b: Byte -> Byte.to_int(b))
            |> Iter.map(fn n: Int -> Int.to_string(n))
            |> Iter.to_list()
            |> join_debug_parts()

        "<<${inner}>>"
    }
}

fn join_debug_parts(parts: List<String>) -> String {
    case parts {
        [] -> ""
        [head] -> head
        [head, ..tail] -> head + ", " + join_debug_parts(tail)
    }
}

impl Equatable for Bytes {
    fn equal(a: Bytes, b: Bytes) -> Bool {
        a == b
    }
}

impl Comparable for Bytes {
    /// Orders octet by octet; a prefix sorts first. A collator's sort keys
    /// (`Collator.sort_key`) compare this way.
    //! a: Byte = 97
    //! b: Byte = 98
    //! assert Bytes.from_list([a, b]) < Bytes.from_list([b])
    //! assert Bytes.from_list([a]) < Bytes.from_list([a, b])
    //
    fn compare(a: Bytes, b: Bytes) -> Ordering {
        n = bytes_compare(a, b)

        case {
            n < 0 -> Less
            n > 0 -> Greater
            _ -> Equal
        }
    }
}

/// -1, 0 or 1 as two byte buffers order. Private helper backing the
/// `Comparable` impl.
host fn bytes_compare(a: Bytes, b: Bytes) -> Int

impl Hashable for Bytes {
    /// FNV-1a 64-bit hash of the octets, reinterpreted as an Int, as
    /// `String`'s is. Stable within one runtime process.
    //! a: Byte = 97
    //! assert Hashable.hash(Bytes.from_list([a])) == Hashable.hash(Bytes.from_list([a]))
    //
    host fn hash(data: Bytes) -> Int
}
