import
    add.Add
    averageable.Averageable
    bool.Bool.{self, False, True}
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.{Int, NonNegativeInt, PositiveInt}
    iter.Iter
    option.Option.{self, None, Some}
    strings.String
    summable.Summable
end

//# A `List<T>` is an ordered, immutable sequence of values of one type,
//# written `[1, 2, 3]`. `[0, ..xs]` is `xs` with `0` in front: it takes
//# constant time and shares `xs`. A List keeps its length, so `List.length`
//# does not walk it.
//#
//# ## List and Iter
//#
//# This module holds the functions that depend on how a List is built:
//# `length`, `first`, `tail`, `concat`, `remove_at`, `remove`, `starts_with`,
//# `ends_with`, `split_while` and `contains`. Transforming, filtering,
//# sorting, folding and reading by index are functions of
//# [`Iter`](/reference/iter/), which work on a List as on every other
//# collection. `Iter.map`, `Iter.filter` and the other adapters are lazy:
//# they do no work until something reads the result. End a pipeline with
//# `Iter.to_list()` to get a List back.
//#
//# ```nomi
//# names = ["cy", "ann", "bo"]
//#
//# Iter.count(names) // 3
//#
//# Iter.get(names, 1) // Some("ann")
//#
//# Iter.sort(names) // ["ann", "bo", "cy"]
//#
//# Iter.contains(names, "bo") // True
//#
//# names
//# |> Iter.map(String.uppercase)
//# |> Iter.to_list() // ["CY", "ANN", "BO"]
//# ```
//#
//# The `Iter` functions used most with a List:
//#
//# - Reading: `Iter.first`, `Iter.last`, `Iter.get`, `Iter.count`,
//#   `Iter.is_empty`, `Iter.find`, `Iter.contains`.
//# - Transforming (lazy): `Iter.map`, `Iter.filter`, `Iter.flat_map`,
//#   `Iter.take`, `Iter.drop`, `Iter.zip`, `Iter.with_index`, `Iter.chunks`.
//# - Folding: `Iter.reduce`, `Iter.sum`, `Iter.min`, `Iter.max`,
//#   `Iter.any_match`, `Iter.all_match`.
//# - Rebuilding: `Iter.sort`, `Iter.sort_by`, `Iter.reverse`,
//#   `Iter.partition`, `Iter.group_by`, `Iter.frequencies`.

/// Ordered, immutable sequence of elements.
//! names = ["Alice", "Bob"]
//! names = ["Carol", ..names]
//! assert names == ["Carol", "Alice", "Bob"]
//!
//! // Iter.filter and Iter.map are lazy; Iter.sum reads the result.
//! total =
//!     [1, 2, 3, 4, 5]
//!     |> Iter.filter(fn x -> x > 2)
//!     |> Iter.map(fn x -> x * 2)
//!     |> Iter.sum()
//!
//! assert total == 24
//!
//! // Iter.to_list collects the result into a List.
//! doubled =
//!     [1, 2, 3, 4, 5]
//!     |> Iter.filter(fn x -> x > 2)
//!     |> Iter.map(fn x -> x * 2)
//!     |> Iter.to_list()
//!
//! assert doubled == [6, 8, 10]
//
pub host type List<T>

fn list_next<T>(list: List<T>) -> Option<(T, List<T>)>
    case list
        [h, ..t] -> Some((h, t))
        []       -> None
    end
end

impl List<T>
    /// Returns the first element and the rest of the list, or None if the
    /// list is empty.
    //! assert List.next_item([1, 2, 3]) == Some((1, [2, 3]))
    //! assert List.next_item([]) == None
    //
    pub fn next_item<T>(list: List<T>) -> Option<(T, List<T>)>
        list_next(list)
    end

    /// Returns the number of elements. O(1): a List keeps its length.
    /// `Iter.count` gives the same for any iterable.
    //! assert List.length(["a", "b"]) == 2
    //! assert List.length([]) == 0
    //
    pub fn length<T>(list: List<T>) -> NonNegativeInt
        Iter.count(list)
    end

    /// Concatenates two lists, yielding all elements of `a` followed by all of `b`.
    //! assert List.concat([1, 2], [3, 4]) == [1, 2, 3, 4]
    //
    pub host fn concat<T>(a: List<T>, b: List<T>) -> List<T>

    /// Returns the first element, or None if the list is empty. `Iter.first`
    /// gives the same for any iterable, and `NonEmptyList.first` returns the
    /// element itself.
    //! assert List.first([1, 2, 3]) == Some(1)
    //! assert List.first([]) == None
    //
    pub fn first<T>(list: List<T>) -> Option<T>
        case list
            [first, ..] -> Some(first)
            []          -> None
        end
    end

    /// Returns all elements except the first, or None if the list is empty.
    //! assert List.tail([1, 2, 3]) == Some([2, 3])
    //! assert List.tail([]) == None
    //
    pub fn tail<T>(list: List<T>) -> Option<List<T>>
        case list
            [_, ..tail] -> Some(tail)
            []          -> None
        end
    end

    /// `Some` of the list without the element at zero-based `index`, or None
    /// when the index is outside the list. O(n): the elements before `index`
    /// are copied, and the ones after it are shared. For an index the code
    /// knows is in range, `List.remove_at(list, index)!` returns the list and
    /// traps on any other index.
    //! assert List.remove_at(["a", "b", "c"], 1) == Some(["a", "c"])
    //! assert List.remove_at(["a", "b", "c"], 0)! == ["b", "c"]
    //! assert List.remove_at(["a", "b", "c"], 3) == None
    //
    pub host fn remove_at<T>(list: List<T>, index: Int) -> Option<List<T>>

    /// `Some` of the list with `item` at zero-based `index` and the elements
    /// from there on after it, or None when the index is outside `0` up to
    /// the length. O(index): the elements before `index` are copied, and
    /// the ones after it are shared, so inserting at the front is
    /// `[item, ..list]`.
    //! assert List.insert(["a", "c"], 1, "b") == Some(["a", "b", "c"])
    //! assert List.insert(["a"], 1, "b") == Some(["a", "b"])
    //! assert List.insert(["a"], 2, "b") == None
    //
    pub fn insert<T>(list: List<T>, index: Int, item: T) -> Option<List<T>>
        if index < 0 then return None
        insert_run(list, index, item, [])
    end

    /// The elements from index `start` up to, not including, `stop`. An
    /// index outside the list is clamped to it, and a `stop` at or before
    /// `start` gives the empty list, as `Vector.slice` answers. A slice that
    /// runs to the end is the list's own tail, shared, in O(start); any
    /// other copies its elements, in O(stop). `Iter.drop` and `Iter.take`
    /// give the same elements lazily, for any iterable.
    //! assert List.slice(["a", "b", "c", "d"], 1, 3) == ["b", "c"]
    //! assert List.slice(["a", "b"], 1, 99) == ["b"]
    //! assert List.slice(["a", "b"], 2, 1) == []
    //
    pub fn slice<T>(list: List<T>, start: Int, stop: Int) -> List<T>
        rest = drop_front(list, start)
        count = stop - Int.max(start, 0)

        if count >= List.length(rest) then
            rest
        else
            take_front(rest, count, [])
        end
    end

    /// The list without the first element `==` to `value`, or the same list
    /// when no element is. O(n).
    //! assert List.remove([1, 2, 3, 2], 2) == [1, 3, 2]
    //! assert List.remove([1, 2, 3], 9) == [1, 2, 3]
    //
    pub fn remove<T>(list: List<T>, value: T) -> List<T> where T: Equatable
        case Iter.find_index(list, fn item -> item == value)
            Some(index) -> List.remove_at(list, index)!
            None        -> list
        end
    end

    /// True if `list` begins with the elements of `prefix`, in order, each
    /// `==` to its counterpart. Every list starts with `[]`. The list form of
    /// `String.starts_with`.
    //! assert List.starts_with([1, 2, 3], [1, 2])
    //! refute List.starts_with([1, 2, 3], [2, 3])
    //! assert List.starts_with([1, 2], [])
    //! refute List.starts_with([1], [1, 2])
    //
    pub fn starts_with<T>(list: List<T>, prefix: List<T>) -> Bool where T: Equatable
        case prefix
            [] ->
                True

            [p, ..ps] ->
                case list
                    [x, ..xs] -> if x == p then starts_with(xs, ps) else False
                    []        -> False
                end
        end
    end

    /// True if `list` ends with the elements of `suffix`, in order, each `==`
    /// to its counterpart. Every list ends with `[]`. The list form of
    /// `String.ends_with`.
    //! assert List.ends_with([1, 2, 3], [2, 3])
    //! refute List.ends_with([1, 2, 3], [1, 2])
    //! assert List.ends_with([1, 2], [])
    //! refute List.ends_with([3], [2, 3])
    //
    pub fn ends_with<T>(list: List<T>, suffix: List<T>) -> Bool where T: Equatable
        extra = Iter.count(list) - Iter.count(suffix)

        if extra < 0 then
            False
        else
            starts_with(drop_front(list, extra), suffix)
        end
    end

    /// Splits `list` after its leading run of elements where `pred` is
    /// true: that run, and the rest from the first element where it is
    /// false. The rest is the list's own tail, shared, not copied; the run
    /// is a new list. `Iter.take_while` and `Iter.drop_while` give the two
    /// halves lazily, for any iterable.
    //! assert List.split_while([1, 2, 3, 1], &(&1 < 3)) == ([1, 2], [3, 1])
    //! assert List.split_while([5, 6], &(&1 < 3)) == ([], [5, 6])
    //! assert List.split_while([1, 2], &(&1 < 3)) == ([1, 2], [])
    //
    pub fn split_while<T>(list: List<T>, pred: (T) -> Bool) -> (List<T>, List<T>)
        split_run(list, pred, [])
    end
end

// The run of `list` where `pred` holds, after `taken` reversed, and the
// rest of `list`.
fn split_run<T>(list: List<T>, pred: (T) -> Bool, taken: List<T>) -> (List<T>, List<T>)
    case list
        [x, ..rest] ->
            if pred(x) then
                split_run(rest, pred, [x, ..taken])
            else
                (Iter.reverse(taken), list)
            end

        [] ->
            (Iter.reverse(taken), list)
    end
end

// `list` with `item` at `index`, after `before` reversed.
fn insert_run<T>(list: List<T>, index: Int, item: T, before: List<T>) -> Option<List<T>>
    if index == 0 then return Some(List.concat(Iter.reverse(before), [item, ..list]))

    case list
        [x, ..rest] -> insert_run(rest, index - 1, item, [x, ..before])
        []          -> None
    end
end

// The first `n` elements of `list`, after `taken` reversed.
fn take_front<T>(list: List<T>, n: Int, taken: List<T>) -> List<T>
    case list
        [x, ..rest] ->
            if n > 0 then
                take_front(rest, n - 1, [x, ..taken])
            else
                Iter.reverse(taken)
            end

        [] ->
            Iter.reverse(taken)
    end
end

// `list` after its first `n` elements.
fn drop_front<T>(list: List<T>, n: Int) -> List<T>
    case list
        [_, ..rest] -> if n > 0 then drop_front(rest, n - 1) else list
        []          -> list
    end
end

impl Iter for List<T>
    // Host-side because walking the cons chain in Go beats one Nomi frame per
    // element, and a List is the single most-iterated source in the language.
    host fn each_while(list: List<T>, yield: (T) -> Bool) -> Bool

    // A List tracks its element count, so report it directly (O(1)) instead of
    // folding through the generic default.
    host fn known_count(list: List<T>) -> Option<Int>
end

impl Contains for List<T> where T: Equatable
    /// True if an element of the list is `==` to `x`. A linear scan that the
    /// runtime runs, comparing each element as `==` does; convert to a `Set`
    /// for repeated lookups.
    //! assert List.contains([1, 2, 3], 2)
    //! refute List.contains([1, 2, 3], 9)
    //! refute List.contains([], 1)
    //
    host fn contains(c: List<T>, x: T) -> Bool
end

impl Add<List<T>, List<T>> for List<T>
    fn add(lhs: List<T>, rhs: List<T>) -> List<T>
        concat(lhs, rhs)
    end
end

impl Summable for List<T>
    /// The sum of no Lists: `[]`. Summing Lists concatenates them in order.
    //! none: List<Int> = List.empty_sum()
    //! assert none == []
    //! assert [1, 2] + List.empty_sum() == [1, 2]
    //! assert Iter.sum([[1], [2, 3], []]) == [1, 2, 3]
    //
    fn empty_sum() -> List<T>
        []
    end
end

impl Display for List<T> where T: Display
    fn to_string(value: List<T>) -> String
        // Render `[v1, v2, v3]`, or `[]` when empty.
        body =
            value
            |> Iter.map(fn item -> "${item}")
            |> String.join(", ")

        "[" + body + "]"
    end
end

impl Debug for List<T> where T: Debug
    fn inspect(value: List<T>) -> String
        body =
            value
            |> Iter.map(&Debug.inspect(&1))
            |> String.join(", ")

        "[" + body + "]"
    end
end

impl Equatable for List<T>
    /// Whether the two lists hold equal elements in the same order. The
    /// machine compares them element by element, so the elements need
    /// equality of their own.
    host fn equal(a: List<T>, b: List<T>) -> Bool
end

impl Hashable for List<T> where T: Hashable
    /// The hash a Map key of this type takes: the elements' hashes folded
    /// in order, so `[1, 2]` and `[2, 1]` hash apart. It is keyed by the
    /// run, so it may differ between runs.
    host fn hash(list: List<T>) -> Int
end

impl Comparable for List<T> where T: Comparable
    // Lexicographic order: the first differing element decides; a proper prefix is
    // Less. Requires the element type to be Comparable.
    fn compare(a: List<T>, b: List<T>) -> Ordering
        case list_next(a)
            .None ->
                case list_next(b)
                    .None -> Equal
                    _     -> Less
                end

            .Some((ha, ta)) ->
                case list_next(b)
                    .None ->
                        Greater

                    .Some((hb, tb)) ->
                        case Comparable.compare(ha, hb)
                            .Equal -> compare(ta, tb)
                            other  -> other
                        end
                end
        end
    end
end

/// A List with at least one element, so its first, last, largest and
/// smallest elements are plain values, not `Option`s. A literal is checked
/// when the program is compiled, so `[]` where a NonEmptyList is expected is
/// an error before the program runs; `NonEmptyList.try_from(xs)` checks a
/// List computed at run time, and `NonEmptyList.of(first, rest)` builds one
/// that cannot fail. A NonEmptyList is a List and passes wherever one is
/// expected; a NonEmptyList<Circle> passes as a NonEmptyList<Shape> when
/// Circle implements Shape. It is in the prelude.
//! scores: NonEmptyList<Int> = [70, 95, 82]
//! assert NonEmptyList.first(scores) == 70
//! assert NonEmptyList.max(scores) == 95
//! assert List.length(scores) == 3
//!
//! none: List<Int> = []
//! assert NonEmptyList.try_from(none) == None
//! assert NonEmptyList.try_from([1]) == Some([1])
//
pub refine NonEmptyList<T> List<T> when fn list -> not Iter.is_empty(list)

impl NonEmptyList<T>
    /// A NonEmptyList of `first` followed by the elements of `rest`, which
    /// may be empty.
    //! assert NonEmptyList.of(1, [2, 3]) == [1, 2, 3]
    //! assert NonEmptyList.of("a", []) == ["a"]
    //
    pub fn of<T>(first: T, rest: List<T>) -> NonEmptyList<T>
        NonEmptyList.unchecked([first, ..rest])
    end

    /// The first element.
    //! assert NonEmptyList.first([4, 5]) == 4
    //
    pub fn first<T>(list: NonEmptyList<T>) -> T
        List.first(list)!
    end

    /// The last element.
    //! assert NonEmptyList.last([4, 5]) == 5
    //
    pub fn last<T>(list: NonEmptyList<T>) -> T
        Iter.last(list)!
    end

    /// The elements after the first, a List that may be empty.
    //! assert NonEmptyList.tail([4, 5, 6]) == [5, 6]
    //! assert NonEmptyList.tail([4]) == []
    //
    pub fn tail<T>(list: NonEmptyList<T>) -> List<T>
        List.tail(list)!
    end

    /// The number of elements, at least one.
    //! assert NonEmptyList.length(["a", "b"]) == 2
    //
    pub fn length<T>(list: NonEmptyList<T>) -> PositiveInt
        Iter.count(list)
    end

    /// The largest element; the first of several equal ones.
    //! assert NonEmptyList.max([3, 9, 4]) == 9
    //
    pub fn max<T>(list: NonEmptyList<T>) -> T where T: Comparable
        Iter.max(list)!
    end

    /// The smallest element; the first of several equal ones.
    //! assert NonEmptyList.min([3, 9, 4]) == 3
    //
    pub fn min<T>(list: NonEmptyList<T>) -> T where T: Comparable
        Iter.min(list)!
    end

    /// The element whose key is largest.
    //! assert NonEmptyList.max_by(["bb", "a", "ccc"], String.length) == "ccc"
    //
    pub fn max_by<T, K>(list: NonEmptyList<T>, key: (T) -> K) -> T where K: Comparable
        Iter.max_by(list, key)!
    end

    /// The element whose key is smallest.
    //! assert NonEmptyList.min_by(["bb", "a", "ccc"], String.length) == "a"
    //
    pub fn min_by<T, K>(list: NonEmptyList<T>, key: (T) -> K) -> T where K: Comparable
        Iter.min_by(list, key)!
    end

    /// The arithmetic mean of the elements, rounded as `Iter.mean` rounds;
    /// a value, since there is at least one.
    //! assert NonEmptyList.mean([1, 2]) == 1.5
    //! assert NonEmptyList.mean([1.50d, 2.25d]) == 1.875d
    //
    pub fn mean<T, R>(list: NonEmptyList<T>) -> R where T: Averageable<R>
        Iter.mean(list)!
    end

    /// Combines the elements left to right with `f`, starting from the
    /// first, so it needs no starting value: `[a, b, c]` is `f(f(a, b), c)`.
    //! assert NonEmptyList.reduce([1, 2, 3], fn acc, n -> acc + n) == 6
    //! assert NonEmptyList.reduce(["x"], fn acc, s -> acc + s) == "x"
    //
    pub fn reduce<T>(list: NonEmptyList<T>, f: (T, T) -> T) -> T
        Iter.reduce(tail(list), first(list), f)
    end

    /// Applies `f` to each element; the result has as many elements.
    //! assert NonEmptyList.map([1, 2], fn n -> n * 10) == [10, 20]
    //
    pub fn map<T, U>(list: NonEmptyList<T>, f: (T) -> U) -> NonEmptyList<U>
        NonEmptyList.unchecked(
            Iter.map(list, f)
            |> Iter.to_list()
        )
    end

    /// Each element with its index, from 0.
    //! assert NonEmptyList.with_index(["a", "b"]) == [(0, "a"), (1, "b")]
    //
    pub fn with_index<T>(list: NonEmptyList<T>) -> NonEmptyList<(NonNegativeInt, T)>
        NonEmptyList.unchecked(
            Iter.with_index(list)
            |> Iter.to_list()
        )
    end

    /// The elements in reverse order.
    //! assert NonEmptyList.reverse([1, 2, 3]) == [3, 2, 1]
    //
    pub fn reverse<T>(list: NonEmptyList<T>) -> NonEmptyList<T>
        NonEmptyList.unchecked(Iter.reverse(list))
    end

    /// The elements in ascending order; the sort is stable.
    //! assert NonEmptyList.sort([3, 1, 2]) == [1, 2, 3]
    //
    pub fn sort<T>(list: NonEmptyList<T>) -> NonEmptyList<T> where T: Comparable
        NonEmptyList.unchecked(Iter.sort(list))
    end

    /// `item` before the elements of `list`, which may be empty. O(1).
    //! assert NonEmptyList.prepend([2, 3], 1) == [1, 2, 3]
    //! assert NonEmptyList.prepend([], 1) == [1]
    //
    pub fn prepend<T>(list: List<T>, item: T) -> NonEmptyList<T>
        NonEmptyList.unchecked([item, ..list])
    end

    /// The elements of `list`, which may be empty, then `item`. O(n).
    //! assert NonEmptyList.push([1, 2], 3) == [1, 2, 3]
    //! assert NonEmptyList.push([], 3) == [3]
    //
    pub fn push<T>(list: List<T>, item: T) -> NonEmptyList<T>
        NonEmptyList.unchecked(List.concat(list, [item]))
    end

    /// The elements of `a`, then those of `b`, which may be empty.
    //! assert NonEmptyList.concat([1], [2, 3]) == [1, 2, 3]
    //! assert NonEmptyList.concat([1], []) == [1]
    //
    pub fn concat<T>(a: NonEmptyList<T>, b: List<T>) -> NonEmptyList<T>
        NonEmptyList.unchecked(List.concat(a, b))
    end
end
