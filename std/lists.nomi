import {
    add.Add
    bool.Bool.{self, False, True}
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    contains.Contains
    debug.Debug
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.Int
    iter.Iter
    maybe.Maybe.{self, None, Some}
    strings.String
    summable.Summable
}

//# Operations on the persistent linked `List<T>` type. Container-specific ops
//# (`concat`, `head`, `tail`, `remove_at`, `remove`) live here;
//# generic iteration — including `Iter.count` (O(1) via the
//# `known_count` protocol) — goes through `Iter`:
//# `Iter.map(xs, f) |> Iter.to_list()` for the strict, List-returning form.
//#
//# ## List and Iter
//#
//# `List`'s own functions are the ones that read or rebuild its cons
//# structure (`head`, `tail`, `concat`, `next_item`, `remove_at`, `remove`,
//# `starts_with`, `ends_with`), its `Contains` impl (`contains`), and the
//# `Iter` protocol: `each_while`, and `known_count`, O(1), read from the
//# cached length. Every generic operation (transform, filter, reduce, sort,
//# count, index access) is an `Iter` owner function over any `Iter<T>`, and
//# a `List` is an `Iter<T>`. The adapters are lazy and fuse; end a chain with
//# `Iter.to_list()` to materialize a `List` back, one allocation at the
//# visible step. The rule: generic over any iterable is `Iter.X`; specific to
//# a container's structure is that container's owner.
//#
//# ```nomi
//# Iter.count(xs) // O(1) via known_count
//#
//# Iter.first(xs) / Iter.last(xs) / Iter.get(xs, i)
//#
//# Iter.is_empty(xs)
//#
//# Iter.reverse(xs) // → List
//#
//# Iter.map(xs, f) |> Iter.to_list()
//#
//# Iter.filter(xs, p) |> Iter.to_list()
//#
//# Iter.take(xs, n) / Iter.drop(xs, n)
//#
//# Iter.take_while(xs, p) / Iter.drop_while(xs, p)
//#
//# Iter.flat_map(xs, f) / Iter.flatten(xss) / Iter.zip(a, b) / Iter.with_index(xs)
//#
//# Iter.transpose(rows) // → List<List<T>>, column i from each row long enough
//#
//# Iter.chunks(xs, n) / Iter.chunk_by(xs, key)
//#
//# Iter.permutations(xs) / Iter.combinations(xs, k) // → Iter<List<T>>, by source position
//#
//# Iter.reduce(xs, start, f) / Iter.each(xs, f) / Iter.find(xs, p)
//#
//# Iter.scan(xs, start, f) / Iter.map_reduce(xs, start, fn acc, x -> #(next, out))
//#
//# Iter.min(xs) / Iter.max(xs) / Iter.min_by(xs, key) / Iter.max_by(xs, key) / Iter.sum(xs)
//#
//# Iter.any(xs, p) / Iter.all(xs, p) / Iter.contains(xs, x)
//#
//# Iter.sort(xs) / Iter.sort_by(xs, key) / Iter.sort_with(xs, cmp)
//#
//# Iter.partition(xs, p) / Iter.group_by(xs, key) / Iter.frequencies(xs)
//# ```

/// Ordered, immutable sequence of elements.
//! names = ["Alice", "Bob"]
//! names = ["Carol", ..names]
//! assert names == ["Carol", "Alice", "Bob"]
//!
//! // A lazy pipeline with a strict terminal...
//! total =
//!     [1, 2, 3, 4, 5]
//!     |> Iter.filter(fn x -> x > 2)
//!     |> Iter.map(fn x -> x * 2)
//!     |> Iter.sum()
//!
//! assert total == 24
//!
//! // ...or materialized back to a List.
//! doubled =
//!     [1, 2, 3, 4, 5]
//!     |> Iter.filter(fn x -> x > 2)
//!     |> Iter.map(fn x -> x * 2)
//!     |> Iter.to_list()
//!
//! assert doubled == [6, 8, 10]
//
pub host type List<T>

fn list_next<T>(list: List<T>) -> Maybe<#(T, List<T>)> {
    case list {
        [h, ..t] -> Some(#(h, t))
        [] -> None
    }
}

impl List<T> {
    /// Returns the next element and remaining list, or None if empty. Drives the
    /// `Iter` implementation for `List`.
    //! assert List.next_item([1, 2, 3]) == Some(#(1, [2, 3]))
    //! assert List.next_item([]) == None
    //
    pub fn next_item<T>(list: List<T>) -> Maybe<#(T, List<T>)> {
        list_next(list)
    }

    /// Concatenates two lists, yielding all elements of `a` followed by all of `b`.
    //! assert List.concat([1, 2], [3, 4]) == [1, 2, 3, 4]
    //
    pub host fn concat<T>(a: List<T>, b: List<T>) -> List<T>

    /// Returns the first element, or None if the list is empty. The cons-list idiom,
    /// paired with `tail`; the stream-vocabulary equivalent is the free function
    /// `Iter.first`.
    //! assert List.head([1, 2, 3]) == Some(1)
    //! assert List.head([]) == None
    //
    pub fn head<T>(list: List<T>) -> Maybe<T> {
        case list {
            [head, ..] -> Some(head)
            [] -> None
        }
    }

    /// Returns all elements except the first, or None if the list is empty.
    //! assert List.tail([1, 2, 3]) == Some([2, 3])
    //! assert List.tail([]) == None
    //
    pub fn tail<T>(list: List<T>) -> Maybe<List<T>> {
        case list {
            [_, ..tail] -> Some(tail)
            [] -> None
        }
    }

    /// The list without the element at zero-based `index`, which must be in
    /// `0 <= index < length`. Any other index traps:
    /// `index 7 is out of range for a List of length 5`. O(n): the elements
    /// before `index` are copied, and the ones after it are shared.
    //! assert List.remove_at(["a", "b", "c"], 1) == ["a", "c"]
    //! assert List.remove_at(["a", "b", "c"], 0) == ["b", "c"]
    //
    pub host fn remove_at<T>(list: List<T>, index: Int) -> List<T>

    /// The list without the first element `==` to `value`, or the same list
    /// when no element is. O(n).
    //! assert List.remove([1, 2, 3, 2], 2) == [1, 3, 2]
    //! assert List.remove([1, 2, 3], 9) == [1, 2, 3]
    //
    pub fn remove<T>(list: List<T>, value: T) -> List<T> where T: Equatable {
        case Iter.find_index(list, fn item -> item == value) {
            Some(index) -> List.remove_at(list, index)
            None -> list
        }
    }

    /// True if `list` begins with the elements of `prefix`, in order, each
    /// `==` to its counterpart. Every list starts with `[]`. The list form of
    /// `String.starts_with`.
    //! assert List.starts_with([1, 2, 3], [1, 2])
    //! refute List.starts_with([1, 2, 3], [2, 3])
    //! assert List.starts_with([1, 2], [])
    //! refute List.starts_with([1], [1, 2])
    //
    pub fn starts_with<T>(list: List<T>, prefix: List<T>) -> Bool where T: Equatable {
        case prefix {
            [] ->
                True

            [p, ..ps] ->
                case list {
                    [x, ..xs] -> if x == p { starts_with(xs, ps) } else { False }
                    [] -> False
                }
        }
    }

    /// True if `list` ends with the elements of `suffix`, in order, each `==`
    /// to its counterpart. Every list ends with `[]`. The list form of
    /// `String.ends_with`.
    //! assert List.ends_with([1, 2, 3], [2, 3])
    //! refute List.ends_with([1, 2, 3], [1, 2])
    //! assert List.ends_with([1, 2], [])
    //! refute List.ends_with([3], [2, 3])
    //
    pub fn ends_with<T>(list: List<T>, suffix: List<T>) -> Bool where T: Equatable {
        extra = Iter.count(list) - Iter.count(suffix)

        if extra < 0 {
            False
        } else {
            starts_with(drop_front(list, extra), suffix)
        }
    }
}

// `list` after its first `n` elements.
fn drop_front<T>(list: List<T>, n: Int) -> List<T> {
    case list {
        [_, ..rest] -> if n > 0 { drop_front(rest, n - 1) } else { list }
        [] -> list
    }
}

impl Iter for List<T> {
    // Host-side because walking the cons chain in Go beats one Nomi frame per
    // element, and a List is the single most-iterated source in the language.
    host fn each_while(list: List<T>, yield: (T) -> Bool) -> Bool

    // A List tracks its element count, so report it directly (O(1)) instead of
    // folding through the generic default.
    host fn known_count(list: List<T>) -> Maybe<Int>
}

impl Contains for List<T> where T: Equatable {
    /// True if an element of the list is `==` to `x`. A linear scan that the
    /// runtime runs, comparing each element as `==` does; convert to a `Set`
    /// for repeated lookups.
    //! assert List.contains([1, 2, 3], 2)
    //! refute List.contains([1, 2, 3], 9)
    //! refute List.contains([], 1)
    //
    host fn contains(c: List<T>, x: T) -> Bool
}

impl Add<List<T>, List<T>> for List<T> {
    fn add(lhs: List<T>, rhs: List<T>) -> List<T> {
        concat(lhs, rhs)
    }
}

impl Summable for List<T> {
    /// The sum of no Lists: `[]`. Summing Lists concatenates them in order.
    //! none: List<Int> = List.empty_sum()
    //! assert none == []
    //! assert [1, 2] + List.empty_sum() == [1, 2]
    //! assert Iter.sum([[1], [2, 3], []]) == [1, 2, 3]
    //
    fn empty_sum() -> List<T> {
        []
    }
}

impl Display for List<T> where T: Display {
    fn to_string(value: List<T>) -> String {
        // Render `[v1, v2, v3]`, or `[]` when empty.
        body =
            value
            |> Iter.map(fn item -> "${item}")
            |> String.join(", ")

        "[" + body + "]"
    }
}

impl Debug for List<T> {
    fn inspect(value: List<T>) -> String {
        body =
            value
            |> Iter.map(&Debug.inspect(&1))
            |> String.join(", ")

        "[" + body + "]"
    }
}

impl Equatable for List<T> {
    // Structural equality via the built-in `==` (recursive, element-wise). Lets a
    // record with a List field `derive Equatable`.
    fn equal(a: List<T>, b: List<T>) -> Bool {
        a == b
    }
}

impl Hashable for List<T> where T: Hashable {
    // FNV-style fold; agrees with `==` (equal lists hash equally) and requires the
    // element type to be Hashable. Wrapping arithmetic — hashes are modular.
    fn hash(list: List<T>) -> Int {
        Iter.reduce(list, 17, fn acc, x -> {
            Int.wrapping_add(Int.wrapping_mul(acc, 31), Hashable.hash(x))
        })
    }
}

impl Comparable for List<T> where T: Comparable {
    // Lexicographic order: the first differing element decides; a proper prefix is
    // Less. Requires the element type to be Comparable.
    fn compare(a: List<T>, b: List<T>) -> Ordering {
        case list_next(a) {
            .None ->
                case list_next(b) {
                    .None -> Equal
                    _ -> Less
                }

            .Some(#(ha, ta)) ->
                case list_next(b) {
                    .None ->
                        Greater

                    .Some(#(hb, tb)) ->
                        case Comparable.compare(ha, hb) {
                            .Equal -> compare(ta, tb)
                            other -> other
                        }
                }
        }
    }
}
