// Prelude surface: every re-export here is auto-in-scope in non-stdlib
// files. Stdlib files import dependencies explicitly.
//
// Whole-file imports bind a file API object. The prelude intentionally avoids
// those: user files get universal types, variants, core protocols, and lifecycle
// types. File API objects such as `io` still require imports.
pub import
    add.Add
    averageable.Averageable
    bitwise.{BitwiseAnd, BitwiseNot, BitwiseOr, BitwiseXor, ShiftLeft, ShiftRight}

    // `Literal` / `Fragment` are intentionally not preluded. Typed-literal authors
    // import them explicitly; ordinary call sites only name the prefix type.
    bool.Bool.{self, False, True}
    bytes.{Byte, Bytes}
    code_points.Codepoint
    comparable.{Comparable, Ordering}
    contains.Contains
    context.Context
    convert.{From, TryFrom}

    // Ordering's variants are intentionally not preluded; use `Ordering.Less` or
    // `.Less`.
    debug.Debug
    decimal.{Decimal, NonNegativeDecimal, NonZeroDecimal, PositiveDecimal}
    discrete.Discrete
    display.Display
    divide.Divide
    equatable.Equatable
    float.{Float, NonNegativeFloat, NonZeroFloat, PositiveFloat}
    hashable.Hashable
    int.{Int, NonNegativeInt, NonZeroInt, PositiveInt}
    iter.Iter
    lists.{List, NonEmptyList}
    locale.Locale
    maps.{Map, NonEmptyMap}
    maybe.Maybe
    maybe.Maybe.{None, Some}
    multiply.Multiply
    phrase.{Noun, Phrase}
    productable.Productable
    ranges.Range
    remainder.Remainder
    resources.{Commit, Release}
    results.{Infallible, Result}
    results.Result.{Err, Ok}
    sets.{NonEmptySet, Set}
    startup.Startup
    steppable.Steppable
    strings.{NonEmptyString, String}
    structs.{Distinct, Struct}
    subtract.Subtract
    summable.Summable
    type.Type
    unit.Unit
    variants.Variants
    vectors.{NonEmptyVector, Vector}
end
