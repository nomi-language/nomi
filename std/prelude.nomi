// Prelude surface: every re-export here is auto-in-scope in non-stdlib
// files. Stdlib files import dependencies explicitly.
//
// Whole-file imports bind a file API object. The prelude intentionally avoids
// those: user files get universal types, variants, core protocols, and lifecycle
// types. File API objects such as `io` still require imports.
pub import {
    add.Add

    // `Literal` / `Fragment` are intentionally not preluded. Typed-literal authors
    // import them explicitly; ordinary call sites only name the prefix type.
    bool.Bool.{self, False, True}
    bytes.{Byte, Bytes}
    code_points.Codepoint
    comparable.{Comparable, Ordering}
    contains.Contains
    context.Context

    // Ordering's variants are intentionally not preluded; use `Ordering.Less` or
    // `.Less`.
    debug.Debug
    decimal.Decimal
    discrete.Discrete
    display.Display
    divide.Divide
    equatable.Equatable
    float.Float
    hashable.Hashable
    int.Int
    iter.Iter
    lists.List
    maps.Map
    maybe.Maybe
    maybe.Maybe.{None, Some}
    multiply.Multiply
    ranges.Range
    results.{Infallible, Result}
    results.Result.{Err, Ok}
    sets.Set
    startup.Startup
    steppable.Steppable
    strings.String
    structs.{Distinct, Struct}
    subtract.Subtract
    summable.Summable
    type.Type
    unit.Unit
    variants.Variants
    vectors.Vector
}
