// Prelude surface: every exported import here is auto-in-scope in non-stdlib
// files. Stdlib files import dependencies explicitly.
//
// Whole-file imports bind a file API object. The prelude intentionally avoids
// those: user files get universal types, variants, core protocols, and lifecycle
// types. File API objects such as `io` still require imports.
import {
    add.Add export

    // `Literal` / `Fragment` are intentionally not preluded. Typed-literal authors
    // import them explicitly; ordinary call sites only name the prefix type.
    bool.Bool.{self, False, True} export
    bytes.{Byte, Bytes} export
    codepoints.Codepoint export
    comparable.{Comparable, Ordering} export
    context.Context export

    // Ordering's variants are intentionally not preluded; use `Ordering.Less` or
    // `.Less`.
    debug.Debug export
    decimal.Decimal export
    discrete.Discrete export
    display.Display export
    divide.Divide export
    equatable.Equatable export
    float.Float export
    hashable.Hashable export
    int.Int export
    iter.Iter export
    lists.List export
    maps.Map export
    maybe.Maybe export
    maybe.Maybe.{None, Some} export
    multiply.Multiply export
    ranges.Range export
    results.{Infallible, Result} export
    results.Result.{Err, Ok} export
    sets.Set export
    startup.Startup export
    steppable.Steppable export
    strings.String export
    structs.Struct export
    subtract.Subtract export
    type.Type export
    unit.Unit export
    vectors.Vector export
}
