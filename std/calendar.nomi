impl Add<Duration, NaiveDateTime> for NaiveDateTime {
    /// Add an exact `Duration`.
    fn add(lhs: NaiveDateTime, rhs: Duration): NaiveDateTime {
        naive_add_nanos(lhs, Duration.as_nanos(rhs))
    }
}

impl Subtract<Years, NaiveDateTime> for NaiveDateTime {
    /// Subtract whole calendar years, clamping leap days when needed.
    fn subtract(lhs: NaiveDateTime, Years(n)): NaiveDateTime {
        lhs + Years(-n)
    }
}

impl Subtract<Months, NaiveDateTime> for NaiveDateTime {
    /// Subtract whole calendar months, clamping end-of-month.
    fn subtract(lhs: NaiveDateTime, Months(n)): NaiveDateTime {
