impl Equatable for OffsetDateTime {
    fn equal?(a: OffsetDateTime, b: OffsetDateTime) -> Bool {
        a.instant_nanos == b.instant_nanos
    }
}

impl Hashable for OffsetDateTime {
    fn hash(value: OffsetDateTime) -> Int {
        value.instant_nanos
    }
}

impl Comparable for OffsetDateTime {
    fn compare(a: OffsetDateTime, b: OffsetDateTime) -> Ordering {
        Int.compare(a.instant_nanos, b.instant_nanos)
    }
}

// ============================================================================
// Disambiguation
// ============================================================================
/// How `DateTime.in_zone` resolves wall-clock readings that fall in a DST
/// spring-forward **gap** (the wall time never exists — clocks
/// jumped over it) or a fall-back **fold** (the wall time exists
/// twice — clocks rolled back). Modeled on Temporal's
/// `disambiguation` option.
///
/// The four modes:
///
/// - **`Compatible`** (the default — pass no `mode` argument and
///   you get this) — "do the obvious thing", always returning an
///   instant. In a fold, picks the **earlier** instant (the
///   pre-transition occurrence). In a gap, advances **forward**
///   through the gap so `02:30` becomes `03:30` post-transition.
///   Matches the intuition that "30 minutes after the gap started"
///   means "30 minutes of wall time after the gap's start". Reach
///   for this unless you have a specific reason not to.
///
/// - **`Earlier`** — pick the earlier instant in both transitions.
///   In a fold, same as `Compatible` (the pre-transition
///   occurrence). In a gap, the instant *just before* the
///   transition: `02:30` in a spring-forward gap resolves to `01:30`
///   pre-transition. Useful when "earlier is safer" — e.g.
///   scheduling a deadline or notification where the earlier
///   interpretation prevents a missed event.
///
/// - **`Later`** — pick the later instant in both transitions. In a
///   fold, the post-transition occurrence (`01:30` EST after the
///   fall-back). In a gap, the post-transition instant (same as
///   `Compatible` for gaps). Useful when "later is safer" — e.g.
///   expirations and grace periods, where the later interpretation
///   gives the user the benefit of the doubt.
///
/// - **`Reject`** — surface DST anomalies as `Err` instead of
///   resolving silently: `Err(Ambiguous ...)` for folds,
///   `Err(Nonexistent ...)` for gaps. The strict mode for code
///   that should never silently disambiguate — typically when the
///   wall reading came from a user (UI form, API request) and the
///   right answer is to bounce the ambiguity back to them.
pub enum Disambiguation {
    Compatible
    Earlier
    Later
    Reject
}

// ============================================================================
// DateTime (IANA-zoned, DST-aware)
// ============================================================================
/// A date+time anchored to an IANA time zone (`America/New_York`),
/// fully DST-aware. The default type for real moments in history —
/// short name, attractive-by-design, the right choice for almost
/// every timestamp a program handles. Backed by `time/tzdata`
/// embedded in the runtime, so IANA-zone lookups work on every
/// host without external tzdata.
///
/// Equality and ordering are **instant-only**: same moment in two
/// different zones compares equal. The zone is display metadata,
/// not identity.
///
/// Construct via `DateTime.in_zone(naive, zone, mode)` (the fallible
/// wall→instant projection — see `Disambiguation` for the gap/fold
/// modes), `DateTime.from_instant_in(instant, zone)` (always total),
/// `DateTime.now_in(zone)` (the system clock projected into a zone),
/// `DateTime.parse`, or the `DateTime"…"` typed literal (RFC 9557
/// bracket form).
pub opaque struct DateTime {
    instant_nanos: Int
    zone: String
}

impl DateTime {
    /// The moment as a reader of `locale` writes its wall clock, the date
    /// at the length `date` says and the time at `time`'s. `Full` and `Long`
    /// times end with the zone's offset in the locale's GMT format
    /// (`GMT+02:00`); zone names are not std's.
    //! dt = DateTime`2026-10-20T09:30:00+02:00[Europe/Warsaw]`
    //! assert DateTime.format(dt, Locale`pl`) == "20 paź 2026, 09:30"
    //!
    //! assert DateTime.format(
    //!     dt,
    //!     Locale`en`,
    //!     date: .Full,
    //!     time: .Long,
    //! ) == "Tuesday, October 20, 2026, 9:30:00\u{202f}AM GMT+2"
    //
    pub fn format(
        dt: DateTime,
        locale: Locale,
        date: DateStyle = DateStyle.Medium,
        time: TimeStyle = TimeStyle.Short,
    ) -> String {
        civil_format_style(
            locale,
            DateTime.fields_of(dt),
            "${DateStyle.name(date)}/${TimeStyle.name(time)}",
        )
    }

    /// The moment as a reader of `locale` writes the fields `fields` names.
    //! dt = DateTime`2026-10-20T09:30:00+02:00[Europe/Warsaw]`
    //! assert DateTime.format_fields(dt, Locale`en`, DateTimeFields`EEEEjm`) == "Tuesday 9:30\u{202f}AM"
    //
    pub fn format_fields(dt: DateTime, locale: Locale, fields: DateTimeFields) -> String {
        DateTimeFields(skeleton) = fields
        civil_format_fields(locale, DateTime.fields_of(dt), skeleton)
    }

    /// The moment's wall clock by a fixed numeric pattern.
    //! dt = DateTime`2026-10-20T09:30:00+02:00[Europe/Warsaw]`
    //! assert DateTime.to_string_with(dt, DateTimePattern`yyyyMMdd'T'HHmmss`) == "20261020T093000"
    //
    pub fn to_string_with(dt: DateTime, pattern: DateTimePattern) -> String {
        DateTimePattern(p) = pattern
        civil_format_pattern(DateTime.fields_of(dt), p)
    }

    // The fields a pattern writes a moment by: its wall clock and offset.
    fn fields_of(dt: DateTime) -> List<Int> {
        [
            DateTime.year(dt),
            DateTime.month(dt),
            DateTime.day(dt),
            DateTime.hour(dt),
            DateTime.minute(dt),
            DateTime.second(dt),
            DateTime.nanosecond(dt),
            zoned_offset_nanos(dt) / 1_000_000_000,
            7,
        ]
    }

    /// Project a naive wall-reading into an IANA zone, returning a
    /// `DateTime` anchored at the resolved instant. Fails on
    /// `UnknownZone` always, and — only when `mode = Reject` — on
    /// `Nonexistent` (gap) or `Ambiguous` (fold). The three resolving
    /// modes (`Compatible`/`Earlier`/`Later`) always land on an instant.
    //! assert try DateTime.in_zone(
    //!     try NaiveDateTime"2026-06-15T12:00:00",
    //!     "America/New_York",
    //! ) == try DateTime"2026-06-15T12:00:00-04:00[America/New_York]"
    //!
    //! assert Err(Error.UnknownZone(_zone)) = DateTime.in_zone(
    //!     try NaiveDateTime"2026-06-15T12:00:00",
    //!     "Mars/Base",
    //! )
    //
    pub fn in_zone(
        dt: NaiveDateTime,
        zone: String,
        mode: Disambiguation = Disambiguation.Compatible,
    ) -> Result<DateTime, Error> {
        DateTime.in_zone_resolve(dt, zone, mode)
    }

    fn in_zone_resolve(
        dt: NaiveDateTime,
        zone: String,
        mode: Disambiguation,
    ) -> Result<DateTime, Error> {
        mode_tag = case mode {
            Disambiguation.Compatible -> 1
            Disambiguation.Earlier -> 2
            Disambiguation.Later -> 3
            Disambiguation.Reject -> 4
        }

        attempt = zoned_in_zone_raw(dt, zone, mode_tag)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Project an absolute `Instant` into an IANA zone. Always total
    /// once the zone is known. Fails only on `UnknownZone`.
    //! assert try DateTime.from_instant_in(
    //!     Instant.from_seconds(0),
    //!     "UTC",
    //! ) == try DateTime"1970-01-01T00:00:00Z[UTC]"
    //
    pub fn from_instant_in(i: Instant, zone: String) -> Result<DateTime, Error> {
        attempt = zoned_from_instant_in_raw(Instant.as_nanos(i), zone)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Read the current wall clock and project into a zone. Sugar for
    /// `DateTime.from_instant_in(Instant.now(), zone)`.
    //! assert Err(Error.UnknownZone(_zone)) = DateTime.now_in("Mars/Base")
    //
    pub fn now_in(zone: String) -> Result<DateTime, Error> {
        DateTime.from_instant_in(Instant.now(), zone)
    }

    /// Freeze the zone's current offset at this instant — produces an
    /// `OffsetDateTime` carrying the offset effective at the `DateTime`'s
    /// instant. Lossy: the result no longer remembers the IANA zone.
    //! assert DateTime.to_offset(
    //!     try DateTime"2026-06-15T12:00:00-04:00[America/New_York]"
    //! ) == try OffsetDateTime"2026-06-15T12:00:00-04:00"
    //
    pub host fn to_offset(d: DateTime) -> OffsetDateTime

    /// Same instant, different IANA zone — re-project the wall reading
    /// through a new zone. Fails only on `UnknownZone`.
    //! assert try DateTime.with_zone(
    //!     try DateTime"2026-06-15T12:00:00-04:00[America/New_York]",
    //!     "Europe/Paris",
    //! ) == try DateTime"2026-06-15T18:00:00+02:00[Europe/Paris]"
    //
    pub fn with_zone(d: DateTime, zone: String) -> Result<DateTime, Error> {
        attempt = zoned_with_zone_raw(d, zone)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Parse an RFC 9557 datetime-with-zone string
    /// (`YYYY-MM-DDTHH:MM:SS[.fff…]±HH:MM[Zone/Name]`). The IANA-zone
    /// bracket suffix is required — bare offset forms parse via
    /// `OffsetDateTime.parse` instead.
    //! assert try DateTime.parse("2026-06-15T12:00:00-04:00[America/New_York]") == try DateTime.in_zone(
    //!     try NaiveDateTime"2026-06-15T12:00:00",
    //!     "America/New_York",
    //! )
    //!
    //! assert Err(Error.InvalidFormat(_msg)) = DateTime.parse("2026-06-15T12:00:00-04:00")
    //
    pub fn parse(s: String) -> Result<DateTime, Error> {
        attempt = zoned_parse_raw(s)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Exact duration between two zoned date-times, comparing their underlying
    /// instants rather than their displayed wall readings.
    //! assert DateTime.between(
    //!     try DateTime"2026-06-15T12:00:00-04:00[America/New_York]",
    //!     try DateTime"2026-06-15T18:30:00+02:00[Europe/Paris]",
    //! ) == Duration.minutes(30)
    //
    pub fn between(earlier: DateTime, later: DateTime) -> Duration {
        Duration.nanoseconds(later.instant_nanos - earlier.instant_nanos)
    }
}

impl Literal for DateTime {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTime, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        DateTime.parse(body)
    }
}

impl Display for DateTime {
    /// RFC 9557 datetime+zone string.
    host fn to_string(d: DateTime) -> String
}

impl Debug for DateTime {
    fn inspect(d: DateTime) -> String {
        "${d}"
    }
}

impl DateParts for DateTime {
    // `DateParts`/`TimeParts` accessors project through
    // `time.Unix(0, instant_nanos).In(loc)` (the IANA-loaded location) — the
    // extern IS the interface function.
    host fn year(value: DateTime) -> Int
    host fn month(value: DateTime) -> Int
    host fn day(value: DateTime) -> Int
}

impl TimeParts for DateTime {
    host fn hour(value: DateTime) -> Int
    host fn minute(value: DateTime) -> Int
    host fn second(value: DateTime) -> Int
    host fn nanosecond(value: DateTime) -> Int
}

impl Anchored for DateTime {
    /// The underlying instant.
    ///
    /// A field read rather than a Go call: the instant IS the stored
    /// representation and the zone is display metadata.
    fn to_instant(d: DateTime) -> Instant {
        Instant.from_nanos(d.instant_nanos)
    }

    /// The effective UTC offset at this instant.
    ///
    /// COMPUTED, unlike `OffsetDateTime.offset`: the answer depends on where
    /// this moment falls among the zone's transitions, so it is a tzdb read.
    fn offset(d: DateTime) -> Duration {
        Duration.nanoseconds(zoned_offset_nanos(d))
    }
}

impl Add<Duration, DateTime> for DateTime {
    /// Add an exact `Duration`.
    fn add(lhs: DateTime, rhs: Duration) -> DateTime {
        #DateTime{
            instant_nanos: lhs.instant_nanos + Duration.as_nanos(rhs),
            zone: lhs.zone,
        }
    }
}

impl Add<Years, DateTime> for DateTime {
    /// Add whole calendar years, clamping leap days when needed.
    fn add(lhs: DateTime, Years(n)) -> DateTime {
        zoned_add_years(lhs, n)
    }
}

impl Add<Months, DateTime> for DateTime {
    /// Add whole calendar months, clamping end-of-month.
    fn add(lhs: DateTime, Months(n)) -> DateTime {
        zoned_add_months(lhs, n)
    }
}

impl Add<Weeks, DateTime> for DateTime {
    /// Add whole calendar weeks.
    fn add(lhs: DateTime, Weeks(n)) -> DateTime {
        lhs + Days(n * 7)
    }
}

impl Add<Days, DateTime> for DateTime {
    /// Add whole calendar days.
    fn add(lhs: DateTime, Days(n)) -> DateTime {
        zoned_add_days(lhs, n)
    }
}

impl Add<Hours, DateTime> for DateTime {
    /// Add whole civil hours.
    fn add(lhs: DateTime, Hours(n)) -> DateTime {
        zoned_add_hours(lhs, n)
    }
}

impl Add<Minutes, DateTime> for DateTime {
    /// Add whole civil minutes.
    fn add(lhs: DateTime, Minutes(n)) -> DateTime {
        zoned_add_minutes(lhs, n)
    }
}

impl Add<Seconds, DateTime> for DateTime {
    /// Add whole civil seconds.
    fn add(lhs: DateTime, Seconds(n)) -> DateTime {
        zoned_add_seconds(lhs, n)
    }
}

impl Add<Milliseconds, DateTime> for DateTime {
    /// Add whole civil milliseconds.
    fn add(lhs: DateTime, Milliseconds(n)) -> DateTime {
        zoned_add_milliseconds(lhs, n)
    }
}

impl Add<Microseconds, DateTime> for DateTime {
    /// Add whole civil microseconds.
    fn add(lhs: DateTime, Microseconds(n)) -> DateTime {
        zoned_add_microseconds(lhs, n)
    }
}

impl Add<Nanoseconds, DateTime> for DateTime {
    /// Add whole civil nanoseconds.
    fn add(lhs: DateTime, Nanoseconds(n)) -> DateTime {
        zoned_add_nanoseconds(lhs, n)
    }
}

impl Subtract<Duration, DateTime> for DateTime {
    /// Subtract an exact `Duration`.
    fn subtract(lhs: DateTime, rhs: Duration) -> DateTime {
        lhs + rhs * -1
    }
}

impl Subtract<Years, DateTime> for DateTime {
    /// Subtract whole calendar years, clamping leap days when needed.
    fn subtract(lhs: DateTime, Years(n)) -> DateTime {
        lhs + Years(-n)
    }
}

impl Subtract<Months, DateTime> for DateTime {
    /// Subtract whole calendar months, clamping end-of-month.
    fn subtract(lhs: DateTime, Months(n)) -> DateTime {
        lhs + Months(-n)
    }
}

impl Subtract<Weeks, DateTime> for DateTime {
    /// Subtract whole calendar weeks.
    fn subtract(lhs: DateTime, Weeks(n)) -> DateTime {
        lhs + Weeks(-n)
    }
}

impl Subtract<Days, DateTime> for DateTime {
    /// Subtract whole calendar days.
    fn subtract(lhs: DateTime, Days(n)) -> DateTime {
        lhs + Days(-n)
    }
}

impl Subtract<Hours, DateTime> for DateTime {
    /// Subtract whole civil hours.
    fn subtract(lhs: DateTime, Hours(n)) -> DateTime {
        lhs + Hours(-n)
    }
}

impl Subtract<Minutes, DateTime> for DateTime {
    /// Subtract whole civil minutes.
    fn subtract(lhs: DateTime, Minutes(n)) -> DateTime {
        lhs + Minutes(-n)
    }
}

impl Subtract<Seconds, DateTime> for DateTime {
    /// Subtract whole civil seconds.
    fn subtract(lhs: DateTime, Seconds(n)) -> DateTime {
        lhs + Seconds(-n)
    }
}

impl Subtract<Milliseconds, DateTime> for DateTime {
    /// Subtract whole civil milliseconds.
    fn subtract(lhs: DateTime, Milliseconds(n)) -> DateTime {
        lhs + Milliseconds(-n)
    }
}

impl Subtract<Microseconds, DateTime> for DateTime {
    /// Subtract whole civil microseconds.
    fn subtract(lhs: DateTime, Microseconds(n)) -> DateTime {
        lhs + Microseconds(-n)
    }
}

impl Subtract<Nanoseconds, DateTime> for DateTime {
    /// Subtract whole civil nanoseconds.
    fn subtract(lhs: DateTime, Nanoseconds(n)) -> DateTime {
        lhs + Nanoseconds(-n)
    }
}

impl Equatable for DateTime {
    fn equal?(a: DateTime, b: DateTime) -> Bool {
        a.instant_nanos == b.instant_nanos
    }
}

impl Hashable for DateTime {
    fn hash(value: DateTime) -> Int {
        value.instant_nanos
    }
}

impl Comparable for DateTime {
    fn compare(a: DateTime, b: DateTime) -> Ordering {
        Int.compare(a.instant_nanos, b.instant_nanos)
    }
}

// ============================================================================
// Text for a reader
// ============================================================================
/// A day of the week, Monday first, as ISO 8601 counts them. `Display`
/// gives its English name, the same in every locale; a message selects by
/// one with `:nomi:weekday`.
//! assert Display.to_string(Weekday.Tuesday) == "Tuesday"
//
pub enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

derive Equatable for Weekday
derive Hashable for Weekday

impl Display for Weekday {
    fn to_string(day: Weekday) -> String {
        case day {
            Weekday.Monday -> "Monday"
            Weekday.Tuesday -> "Tuesday"
            Weekday.Wednesday -> "Wednesday"
            Weekday.Thursday -> "Thursday"
            Weekday.Friday -> "Friday"
            Weekday.Saturday -> "Saturday"
            Weekday.Sunday -> "Sunday"
        }
    }
}

/// How much of a date `Date.format` writes, in each locale's way: `Full`
/// (`Tuesday, October 20, 2026` in `en`), `Long` (`October 20, 2026`),
/// `Medium` (`Oct 20, 2026`) and `Short` (`10/20/26`).
pub enum DateStyle {
    Full
    Long
    Medium
    Short
}

derive Equatable for DateStyle

impl DateStyle {
    // CLDR's name for the style.
    fn name(style: DateStyle) -> String {
        case style {
            DateStyle.Full -> "full"
            DateStyle.Long -> "long"
            DateStyle.Medium -> "medium"
            DateStyle.Short -> "short"
        }
    }
}

/// How much of a time of day `Time.format` writes, in each locale's way:
/// `Short` is hours and minutes, `Medium` adds the seconds, and `Long` and
/// `Full` the zone's offset, where the value has a zone.
pub enum TimeStyle {
    Full
    Long
    Medium
    Short
}

derive Equatable for TimeStyle

impl TimeStyle {
    // CLDR's name for the style.
    fn name(style: TimeStyle) -> String {
        case style {
            TimeStyle.Full -> "full"
            TimeStyle.Long -> "long"
            TimeStyle.Medium -> "medium"
            TimeStyle.Short -> "short"
        }
    }
}

/// A unit of civil time, which `TimeUnit.format_relative` counts in. A
/// month and a year are not fixed lengths of time, so relative time takes
/// a unit and a count, not a `Duration`.
pub enum TimeUnit {
    Second
    Minute
    Hour
    Day
    Week
    Month
    Quarter
    Year
}

derive Equatable for TimeUnit

impl TimeUnit {
    /// `count` units from now, as a reader of `locale` says it: `in 3 days`
    /// and `3 days ago` in `en`, `za 3 dni` and `3 dni temu` in `pl`, each
    /// count in the plural form the locale's rules give it. Unless
    /// `numeric: True`, a count the locale has a word for is that word
    /// (`yesterday`, `tomorrow`, `vorgestern`).
    //! assert TimeUnit.format_relative(3, Locale`en`, TimeUnit.Day) == "in 3 days"
    //! assert TimeUnit.format_relative(-1, Locale`en`, TimeUnit.Day) == "yesterday"
    //! assert TimeUnit.format_relative(-1, Locale`en`, TimeUnit.Day, numeric: True) == "1 day ago"
    //! assert TimeUnit.format_relative(-3, Locale`de`, TimeUnit.Day) == "vor 3 Tagen"
    //! assert TimeUnit.format_relative(3, Locale`pl`, TimeUnit.Week) == "za 3 tygodnie"
    //! assert TimeUnit.format_relative(5, Locale`pl`, TimeUnit.Week) == "za 5 tygodni"
    //
    pub fn format_relative(
        count: Int,
        locale: Locale,
        unit: TimeUnit,
        numeric: Bool = False,
    ) -> String {
        position = case unit {
            TimeUnit.Second -> 0
            TimeUnit.Minute -> 1
            TimeUnit.Hour -> 2
            TimeUnit.Day -> 3
            TimeUnit.Week -> 4
            TimeUnit.Month -> 5
            TimeUnit.Quarter -> 6
            TimeUnit.Year -> 7
        }

        relative_format_raw(locale, count, position, numeric)
    }
}

/// The fields a date shows and how wide, as a CLDR skeleton: `y` the year,
/// `M` the month (`M` its number, `MMM` its short name, `MMMM` its name),
/// `d` the day, `E` the weekday (`EEEE` its name) and `G` the era. The
/// locale decides the order, the punctuation and the words
/// (`Date.format_fields`). A backtick literal is checked when the program
/// is checked, and its patterns are worked out when the program is built.
//! assert DateFields.parse("yMMMd") == Ok(DateFields`yMMMd`)
//! assert Err(Error.InvalidFormat(_why)) = DateFields.parse("yMMMdHH")
//
pub opaque type DateFields String

derive Equatable for DateFields

impl DateFields {
    /// The skeleton `text` names, or why it names none a date has.
    pub fn parse(text: String) -> Result<DateFields, Error> {
        reason = fields_check(0, text)

        if reason == "" {
            Ok(DateFields(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for DateFields {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateFields, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        DateFields.parse(body)
    }
}

impl Debug for DateFields {
    fn inspect(fields: DateFields) -> String {
        DateFields(text) = fields
        "DateFields`${text}`"
    }
}

/// The fields a time of day shows, as a CLDR skeleton: `j` the hour as the
/// locale writes it (a 12-hour clock with AM and PM, or a 24-hour one), `h`
/// a 12-hour clock's and `H` a 24-hour one's, `m` the minutes, `s` the
/// seconds and `S` their fraction.
//! assert TimeFields.parse("jm") == Ok(TimeFields`jm`)
//
pub opaque type TimeFields String

derive Equatable for TimeFields

impl TimeFields {
    /// The skeleton `text` names, or why it names none a time has.
    pub fn parse(text: String) -> Result<TimeFields, Error> {
        reason = fields_check(1, text)

        if reason == "" {
            Ok(TimeFields(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for TimeFields {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<TimeFields, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        TimeFields.parse(body)
    }
}

impl Debug for TimeFields {
    fn inspect(fields: TimeFields) -> String {
        TimeFields(text) = fields
        "TimeFields`${text}`"
    }
}

/// The fields a date and time show, as a CLDR skeleton of `DateFields`'
/// letters and `TimeFields`'.
//! assert DateTimeFields.parse("yMMMdjm") == Ok(DateTimeFields`yMMMdjm`)
//
pub opaque type DateTimeFields String

derive Equatable for DateTimeFields

impl DateTimeFields {
    /// The skeleton `text` names, or why it names none.
    pub fn parse(text: String) -> Result<DateTimeFields, Error> {
        reason = fields_check(2, text)

        if reason == "" {
            Ok(DateTimeFields(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for DateTimeFields {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTimeFields, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        DateTimeFields.parse(body)
    }
}

impl Debug for DateTimeFields {
    fn inspect(fields: DateTimeFields) -> String {
        DateTimeFields(text) = fields
        "DateTimeFields`${text}`"
    }
}

/// A fixed numeric pattern for a date, the same text in every locale: `y`
/// the year (`yyyy` four digits, `yy` two), `M` the month and `d` the day
/// (doubled for two digits), `D` the day of the year, with anything else,
/// or text in single quotes, written as it is. A month's or a weekday's
/// name is a word of a language, so a pattern holds none: `MMM` is a
/// compile error that points to `Date.format_fields`.
//! assert DatePattern.parse("yyyy-MM-dd") == Ok(DatePattern`yyyy-MM-dd`)
//! assert Err(Error.InvalidFormat(_why)) = DatePattern.parse("dd MMM yyyy")
//
pub opaque type DatePattern String

derive Equatable for DatePattern

impl DatePattern {
    /// The pattern `text` is, or why it is not a fixed date pattern.
    pub fn parse(text: String) -> Result<DatePattern, Error> {
        reason = pattern_check(0, text)

        if reason == "" {
            Ok(DatePattern(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for DatePattern {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DatePattern, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        DatePattern.parse(body)
    }
}

impl Debug for DatePattern {
    fn inspect(pattern: DatePattern) -> String {
        DatePattern(text) = pattern
        "DatePattern`${text}`"
    }
}

/// A fixed numeric pattern for a time of day: `H` the hour of a 24-hour
/// clock, `m` the minutes, `s` the seconds (each doubled for two digits)
/// and `S` the fraction of a second, one letter per digit. A 12-hour clock
/// needs AM or PM, a word, so a pattern has none.
//! assert TimePattern.parse("HH:mm") == Ok(TimePattern`HH:mm`)
//
pub opaque type TimePattern String

derive Equatable for TimePattern

impl TimePattern {
    /// The pattern `text` is, or why it is not a fixed time pattern.
    pub fn parse(text: String) -> Result<TimePattern, Error> {
        reason = pattern_check(1, text)

        if reason == "" {
            Ok(TimePattern(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for TimePattern {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<TimePattern, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        TimePattern.parse(body)
    }
}

impl Debug for TimePattern {
    fn inspect(pattern: TimePattern) -> String {
