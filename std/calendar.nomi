impl Add<Milliseconds, OffsetDateTime> for OffsetDateTime
    /// Add whole civil milliseconds.
    fn add(lhs: OffsetDateTime, Milliseconds(n)) -> OffsetDateTime
        lhs + Duration.milliseconds(n)
    end
end

impl Add<Microseconds, OffsetDateTime> for OffsetDateTime
    /// Add whole civil microseconds.
    fn add(lhs: OffsetDateTime, Microseconds(n)) -> OffsetDateTime
