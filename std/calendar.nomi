    end
end

impl Subtract<Duration, OffsetDateTime> for OffsetDateTime
    /// Subtract an exact `Duration`.
    fn subtract(lhs: OffsetDateTime, rhs: Duration) -> OffsetDateTime
        lhs + rhs * -1
    end
end

impl Subtract<Years, OffsetDateTime> for OffsetDateTime
    /// Subtract whole calendar years, clamping leap days when needed.
    fn subtract(lhs: OffsetDateTime, Years(n)) -> OffsetDateTime
        lhs + Years(-n)
    end
end

