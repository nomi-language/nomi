// ============================================================================
// OffsetDateTime
// ============================================================================
/// A date+time anchored at a fixed UTC offset (`-05:00`), with no DST
/// awareness. The right type for ISO-8601 timestamps from APIs that
/// include an offset but not a zone (`2026-05-04T14:30:00-05:00`).
/// For DST-aware semantics, reach for `DateTime` instead — `DateTime`
/// is the recommended default for real moments-in-time; an
/// `OffsetDateTime` deliberately can't tell you which zone you were
/// in, so converting back to `DateTime` requires re-naming the zone.
///
/// Equality and ordering are **instant-only**: two `OffsetDateTime`
/// values with the same underlying nanos but different offsets are
/// equal (they're the same moment in real history; the offset is
/// display metadata). Construct via `OffsetDateTime.with_offset(naive,
/// offset)`, `OffsetDateTime.from_instant(instant, offset)`,
/// `OffsetDateTime.parse`, or the `OffsetDateTime"…"` typed literal.
pub opaque struct OffsetDateTime {
    instant_nanos: Int
    offset_seconds: Int
}

impl OffsetDateTime {
    /// Combine a `NaiveDateTime` wall-reading with a fixed UTC offset.
    /// Returns `Err(.InvalidValue(...))` if the offset is outside the
    /// IANA-acceptable range (`±18:00`).
    //! assert try OffsetDateTime.with_offset(
    //!     try NaiveDateTime"2026-05-04T09:00:00",
    //!     Duration.hours(-5),
    //! ) == try OffsetDateTime"2026-05-04T09:00:00-05:00"
    //
    pub fn with_offset(dt: NaiveDateTime, offset: Duration) -> Result<OffsetDateTime, Error> {
        attempt = offset_with_offset_raw(dt, Duration.as_nanos(offset))

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Attach a fixed offset to an absolute `Instant`. Always total —
    /// every instant has a representation at every fixed offset.
    //! assert OffsetDateTime.from_instant(
    //!     Instant.from_seconds(0),
    //!     Duration.hours(0),
    //! ) == try OffsetDateTime"1970-01-01T00:00:00Z"
    //
    pub fn from_instant(i: Instant, offset: Duration) -> OffsetDateTime {
        offset_from_instant_nanos(Instant.as_nanos(i), Duration.as_nanos(offset))
    }

    /// Parse an ISO-8601 timestamp with offset suffix
    /// (`YYYY-MM-DDTHH:MM:SS[.fff…][±HH:MM|Z]`).
    //! assert try OffsetDateTime.parse(
    //!     "2026-05-04T14:30:00-05:00"
    //! ) == try OffsetDateTime"2026-05-04T14:30:00-05:00"
    //!
    //! assert Err(Error.InvalidFormat(_msg)) = OffsetDateTime.parse("2026-05-04T14:30:00")
    //
    pub fn parse(s: String) -> Result<OffsetDateTime, Error> {
        attempt = offset_parse_raw(s)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Exact duration between two fixed-offset date-times, comparing their
    /// underlying instants rather than their displayed wall readings.
    //! assert OffsetDateTime.between(
    //!     try OffsetDateTime"2026-05-04T14:30:00-05:00",
    //!     try OffsetDateTime"2026-05-04T20:30:00+00:00",
    //! ) == Duration.hours(1)
    //
    pub fn between(earlier: OffsetDateTime, later: OffsetDateTime) -> Duration {
        Duration.nanoseconds(later.instant_nanos - earlier.instant_nanos)
    }
}

impl Literal for OffsetDateTime {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<OffsetDateTime, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        OffsetDateTime.parse(body)
    }
}

impl Display for OffsetDateTime {
    /// ISO-8601 datetime + offset string (`YYYY-MM-DDTHH:MM:SS[.fff…]±HH:MM`).
    host fn to_string(odt: OffsetDateTime) -> String
}

impl Debug for OffsetDateTime {
    fn inspect(odt: OffsetDateTime) -> String {
        "${odt}"
    }
}

impl DateParts for OffsetDateTime {
    // `DateParts`/`TimeParts` accessors are Go projections through
    // `time.Unix(0, instant_nanos).In(time.FixedZone("", offset_seconds))` — the
    // extern IS the interface function (no wrapper).
    host fn year(value: OffsetDateTime) -> Int
    host fn month(value: OffsetDateTime) -> Int
    host fn day(value: OffsetDateTime) -> Int
}

impl TimeParts for OffsetDateTime {
    host fn hour(value: OffsetDateTime) -> Int
    host fn minute(value: OffsetDateTime) -> Int
    host fn second(value: OffsetDateTime) -> Int
    host fn nanosecond(value: OffsetDateTime) -> Int
}

impl Anchored for OffsetDateTime {
    /// The underlying instant.
    ///
    /// A field read rather than a Go call: the instant IS the stored
    /// representation, and the offset is display metadata that a projection
    /// onto a moment drops.
    fn to_instant(odt: OffsetDateTime) -> Instant {
        Instant.from_nanos(odt.instant_nanos)
    }

    /// The fixed UTC offset.
    ///
    /// Read rather than computed, which is the difference from `DateTime`: a
    /// zoned value has to ask the tzdb what its offset is at that instant, and a
    /// fixed-offset value carries the answer.
    fn offset(odt: OffsetDateTime) -> Duration {
        Duration.seconds(odt.offset_seconds)
    }
}

impl Add<Duration, OffsetDateTime> for OffsetDateTime {
    /// Add an exact `Duration`.
    fn add(lhs: OffsetDateTime, rhs: Duration) -> OffsetDateTime {
        #OffsetDateTime{
            instant_nanos: lhs.instant_nanos + Duration.as_nanos(rhs),
            offset_seconds: lhs.offset_seconds,
        }
    }
}

