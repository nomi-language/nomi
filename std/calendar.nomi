// --- Text for a reader ------------------------------------------------------
// A value crosses as its year, an Int of any size, and its other fields
// (`fields_of`): month, day, hour, minute, second, nanosecond, UTC offset
// in seconds, and flags (1 a date, 2 a time, 4 an offset). A style crosses
// as `<date style>/<time style>`, `-` for a part not written.
host fn civil_format_style(locale: Locale, year: Int, fields: List<Int64>, spec: String) -> String

host fn civil_format_fields(
    locale:   Locale,
    year:     Int,
    fields:   List<Int64>,
    skeleton: String,
) -> String

host fn civil_format_pattern(year: Int, fields: List<Int64>, pattern: String) -> String

host fn date_parse_style(text: String, locale: Locale, spec: String, lenient: Bool) -> DateAttempt

host fn time_parse_style(text: String, locale: Locale, spec: String, lenient: Bool) -> TimeAttempt

host fn date_parse_pattern(text: String, pattern: String) -> DateAttempt

host fn time_parse_pattern(text: String, pattern: String) -> TimeAttempt

host fn naive_parse_pattern(text: String, pattern: String) -> NaiveAttempt

// Why text is not a skeleton (`fields_check`) or a fixed pattern
// (`pattern_check`) of a kind, 0 a date's, 1 a time's, 2 both's, or "".
host fn fields_check(kind: Int64, text: String) -> String

host fn pattern_check(kind: Int64, text: String) -> String

host fn relative_format_raw(locale: Locale, count: Int, unit: Int64, numeric: Bool) -> String
