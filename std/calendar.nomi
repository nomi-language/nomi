}

impl Add<Years, NaiveDateTime> for NaiveDateTime {
    /// Add whole calendar years, clamping leap days when needed.
    fn add(lhs: NaiveDateTime, Years(n)): NaiveDateTime {
        naive_add_years(lhs, n)
    }
}

impl Add<Months, NaiveDateTime> for NaiveDateTime {
