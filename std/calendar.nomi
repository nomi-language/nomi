/// Date-bearing values expose their `year`/`month`/`day` components.
/// Impls: `Date`, `NaiveDateTime`, `OffsetDateTime`, `DateTime`.
pub interface DateParts {
    fn year(value: self) -> Int
    fn month(value: self) -> Int
    fn day(value: self) -> Int
}

/// Time-of-day values expose their `hour`/`minute`/`second`/
/// `nanosecond` components. Impls: `Time`, `NaiveDateTime`,
/// `OffsetDateTime`, `DateTime`.
pub interface TimeParts {
    fn hour(value: self) -> Int
    fn minute(value: self) -> Int
    fn second(value: self) -> Int
    fn nanosecond(value: self) -> Int
}

/// Anchored-to-a-moment values expose their underlying `Instant`
/// plus the effective UTC offset at that instant. Impls:
/// `OffsetDateTime`, `DateTime`.
pub interface Anchored {
    fn to_instant(value: self) -> Instant
    fn offset(value: self) -> Duration
}

/// A calendar date — year/month/day, no time-of-day, no zone. Construct
/// via `Date.new(y, m, d)` (validating), `Date.parse`, or the
/// `Date"…"` typed literal. Components reachable via `year`/`month`/`day`
/// (or the `DateParts` interface).
pub opaque struct Date {
    year: Int
    month: Int
    day: Int
}

impl Date {
    /// Construct a `Date`, validating the combination (no Feb 30,
    /// leap-year aware). Returns `Err(.InvalidValue(...))` for impossible
    /// dates.
    //! assert try Date.new(2026, 5, 4) == try Date"2026-05-04"
    //! assert Err(Error.InvalidValue(_msg)) = Date.new(2026, 2, 30)
    //
    pub fn new(year: Int, month: Int, day: Int) -> Result<Date, Error> {
        attempt = date_new_raw(year, month, day)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Parse an ISO-8601 date string (`YYYY-MM-DD`) into a `Date`. Backs
    /// the `Date"…"` typed literal and is exported for callers parsing
    /// from arbitrary string sources.
    //! assert try Date.parse("2026-05-04") == try Date"2026-05-04"
    //! assert Err(Error.InvalidFormat(_msg)) = Date.parse("05/04/2026")
    //
    pub fn parse(s: String) -> Result<Date, Error> {
        attempt = date_parse_raw(s)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Number of whole days between two `Date`s — positive if `later` is
    /// after `earlier`, negative if before. (Calendar-day count, ignoring
    /// any sub-day time of day.)
    //! assert Date.days_between(try Date"2026-05-04", try Date"2026-05-07") == 3
    //! assert Date.days_between(try Date"2026-05-07", try Date"2026-05-04") == -3
    //
    pub host fn days_between(earlier: Date, later: Date) -> Int

    /// The day of the week the date falls on.
    //! assert Date.weekday(Date`2026-10-20`) == Weekday.Tuesday
    //! assert Date.weekday(Date`2026-10-25`) == Weekday.Sunday
    //! assert Date.weekday(Date`1969-12-29`) == Weekday.Monday
    //
    pub fn weekday(d: Date) -> Weekday {
        days = Date.days_between(#Date{year: 1970, month: 1, day: 5}, d)

        case (days % 7 + 7) % 7 {
            0 -> Weekday.Monday
            1 -> Weekday.Tuesday
            2 -> Weekday.Wednesday
            3 -> Weekday.Thursday
            4 -> Weekday.Friday
            5 -> Weekday.Saturday
            _ -> Weekday.Sunday
        }
    }

    /// The date as a reader of `locale` writes it, at the length `style`
    /// says: the locale decides the order, the punctuation and the words.
    //! d = Date`2026-10-20`
    //! assert Date.format(d, Locale`en`) == "Oct 20, 2026"
    //! assert Date.format(d, Locale`en`, style: .Full) == "Tuesday, October 20, 2026"
    //! assert Date.format(d, Locale`en`, style: .Short) == "10/20/26"
    //! assert Date.format(d, Locale`pl`, style: .Long) == "20 października 2026"
    //! assert Date.format(d, Locale`de`, style: .Full) == "Dienstag, 20. Oktober 2026"
    //! assert Date.format(d, Locale`ja`, style: .Long) == "2026年10月20日"
    //
    pub fn format(d: Date, locale: Locale, style: DateStyle = DateStyle.Medium) -> String {
        civil_format_style(locale, Date.fields_of(d), "${DateStyle.name(style)}/-")
    }

    /// The date as a reader of `locale` writes the fields `fields` names,
    /// at their widths: a CLDR skeleton, from which the locale's data gives
    /// the order, the punctuation and the words. `yMMMd` is a year, a
    /// month's short name and a day; `MMMMEEEEd` a month's name, a weekday's
    /// and a day. A literal skeleton is checked when the program is checked.
    //! d = Date`2026-10-20`
    //! assert Date.format_fields(d, Locale`en`, DateFields`yMMMd`) == "Oct 20, 2026"
    //! assert Date.format_fields(d, Locale`pl`, DateFields`yMMMd`) == "20 paź 2026"
    //! assert Date.format_fields(d, Locale`en`, DateFields`MMMMEEEEd`) == "Tuesday, October 20"
    //! assert Date.format_fields(d, Locale`pl`, DateFields`MMMMd`) == "20 października"
    //! assert Date.format_fields(d, Locale`ja`, DateFields`MMMMEEEEd`) == "10月20日火曜日"
    //
    pub fn format_fields(d: Date, locale: Locale, fields: DateFields) -> String {
        DateFields(skeleton) = fields
        civil_format_fields(locale, Date.fields_of(d), skeleton)
    }

    /// Read a date a reader of `locale` typed, as `Date.format` writes it at
    /// `style`, strictly unless `lenient: True`. Strict takes one digit
    /// for a two-digit day or month, any space for a space the locale
    /// writes, and ASCII digits for the locale's. Lenient also takes a name
    /// in any width or case, with or without its final period, any spaces
    /// and punctuation between the fields, a four-digit year where the
    /// locale writes two, and spaces around the date. A two-digit year is
    /// 2000 plus its digits, at every style.
    //! assert Date.parse_in("4.5.26", Locale`de`) == Ok(Date`2026-05-04`)
    //! assert Date.parse_in("20.10.26", Locale`de`, style: .Medium) == Ok(Date`2026-10-20`)
    //! assert Date.parse_in("10/20/26", Locale`en`) == Ok(Date`2026-10-20`)
    //! assert Date.parse_in("Oct 20, 2026", Locale`en`, style: .Medium) == Ok(Date`2026-10-20`)
    //!
    //! assert Date.parse_in("october 20 2026", Locale`en`, style: .Medium, lenient: True) == Ok(
    //!     Date`2026-10-20`
    //! )
    //!
    //! assert Err(Error.InvalidFormat(_why)) = Date.parse_in("4.5.2026", Locale`de`)
    //! assert Date.parse_in("4.5.2026", Locale`de`, lenient: True) == Ok(Date`2026-05-04`)
    //!
    //! assert Date.parse_in("31.2.26", Locale`de`) == Err(
    //!     Error.InvalidValue("month 2 of 2026 has no day 31")
    //! )
    //
    pub fn parse_in(
        text: String,
        locale: Locale,
        style: DateStyle = DateStyle.Short,
        lenient: Bool = False,
    ) -> Result<Date, Error> {
        attempt = date_parse_style(text, locale, "${DateStyle.name(style)}/-", lenient)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// The date by a fixed numeric pattern: the same text in every locale,
    /// for file names, logs and protocols.
    //! assert Date.to_string_with(Date`2026-10-19`, DatePattern`yyyy-MM-dd`) == "2026-10-19"
    //! assert Date.to_string_with(Date`2026-05-04`, DatePattern`dd/MM/yyyy`) == "04/05/2026"
    //! assert Date.to_string_with(Date`2026-05-04`, DatePattern`yyyyMMdd`) == "20260504"
    //
    pub fn to_string_with(d: Date, pattern: DatePattern) -> String {
        DatePattern(p) = pattern
        civil_format_pattern(Date.fields_of(d), p)
    }

    /// Read a date by a fixed numeric pattern, as `Date.to_string_with`
    /// writes it. A one-digit day or month stands for a two-digit one.
    //! assert Date.parse_with("19/10/2026", DatePattern`dd/MM/yyyy`) == Ok(Date`2026-10-19`)
    //! assert Date.parse_with("20260504", DatePattern`yyyyMMdd`) == Ok(Date`2026-05-04`)
    //! assert Err(Error.InvalidFormat(_why)) = Date.parse_with("2026-10-19", DatePattern`dd/MM/yyyy`)
    //
    pub fn parse_with(text: String, pattern: DatePattern) -> Result<Date, Error> {
        DatePattern(p) = pattern
        attempt = date_parse_pattern(text, p)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    // The fields a pattern writes a date by: civil_format_style's list.
    fn fields_of(d: Date) -> List<Int> {
        [d.year, d.month, d.day, 0, 0, 0, 0, 0, 1]
    }
}

derive Equatable for Date
derive Hashable for Date
derive Comparable for Date

impl Literal for Date {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<Date, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        Date.parse(body)
    }
}

impl Display for Date {
    /// ISO-8601 date string (`YYYY-MM-DD`).
    host fn to_string(d: Date) -> String
}

impl Debug for Date {
    fn inspect(d: Date) -> String {
        "${d}"
    }
}

impl DateParts for Date {
    fn year(value: Date) -> Int {
        value.year
    }

    fn month(value: Date) -> Int {
        value.month
    }

    fn day(value: Date) -> Int {
        value.day
    }
}

impl Add<Years, Date> for Date {
    /// Add whole calendar years, clamping leap days when needed.
    fn add(lhs: Date, Years(n)) -> Date {
        date_add_years(lhs, n)
    }
}

impl Add<Months, Date> for Date {
    /// Add whole calendar months, clamping end-of-month.
    //! assert try Date"2011-01-31" + Months(1) == try Date"2011-02-28"
    //! assert try Date"2012-01-31" + Months(1) == try Date"2012-02-29"
    //
    fn add(lhs: Date, Months(n)) -> Date {
        date_add_months(lhs, n)
    }
}

impl Add<Weeks, Date> for Date {
    /// Add whole calendar weeks.
    fn add(lhs: Date, Weeks(n)) -> Date {
        lhs + Days(n * 7)
    }
}

impl Add<Days, Date> for Date {
    /// Add whole calendar days.
    fn add(lhs: Date, Days(n)) -> Date {
        date_add_days(lhs, n)
    }
}

impl Subtract<Years, Date> for Date {
    /// Subtract whole calendar years, clamping leap days when needed.
    fn subtract(lhs: Date, Years(n)) -> Date {
        lhs + Years(-n)
    }
}

impl Subtract<Months, Date> for Date {
    /// Subtract whole calendar months, clamping end-of-month.
    fn subtract(lhs: Date, Months(n)) -> Date {
        lhs + Months(-n)
    }
}

impl Subtract<Weeks, Date> for Date {
    /// Subtract whole calendar weeks.
    fn subtract(lhs: Date, Weeks(n)) -> Date {
        lhs + Weeks(-n)
    }
}

impl Subtract<Days, Date> for Date {
    /// Subtract whole calendar days.
    fn subtract(lhs: Date, Days(n)) -> Date {
        lhs + Days(-n)
    }
}

// ============================================================================
// Time
// ============================================================================
/// A time-of-day — hour/minute/second/nanosecond, no date, no zone.
/// Construct via `Time.new(h, m, s, ns)` (validating), `Time.parse`,
/// or the `Time"…"` typed literal. Components reachable via
/// `hour`/`minute`/`second`/`nanosecond` (or the `TimeParts` interface).
pub opaque struct Time {
    hour: Int
    minute: Int
    second: Int
    nanosecond: Int
}

impl Time {
    /// Construct a `Time`, validating each component (hour 0..=23,
    /// minute/second 0..=59, nanosecond 0..=999_999_999).
    //! assert try Time.new(8, 30) == try Time"08:30:00"
    //! assert try Time.new(8, 30, 15, 250_000_000) == try Time"08:30:15.25"
    //! assert Err(Error.InvalidValue(_msg)) = Time.new(24, 0)
    //
    pub fn new(
        hour: Int,
        minute: Int,
        second: Int = 0,
        nanosecond: Int = 0,
    ) -> Result<Time, Error> {
        if hour < 0 or hour > 23 {
            Err(Error.InvalidValue("hour out of range: " + Int.to_string(hour)))
        } else if minute < 0 or minute > 59 {
            Err(Error.InvalidValue("minute out of range: " + Int.to_string(minute)))
        } else if second < 0 or second > 59 {
            Err(Error.InvalidValue("second out of range: " + Int.to_string(second)))
        } else if nanosecond < 0 or nanosecond > 999_999_999 {
            Err(Error.InvalidValue("nanosecond out of range: " + Int.to_string(nanosecond)))
        } else {
            Ok(#Time{hour, minute, second, nanosecond})
        }
    }

    /// Parse a time-of-day string (`HH:MM:SS` or `HH:MM:SS.fff…`).
    //! assert try Time.parse("08:30:00") == try Time"08:30:00"
    //! assert Err(Error.InvalidFormat(_msg)) = Time.parse("nope")
    //
    pub fn parse(s: String) -> Result<Time, Error> {
        attempt = time_parse_raw(s)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Exact duration from `earlier` to `later`, measured within one civil day.
    //! assert Time.between(try Time"08:30:00", try Time"08:33:00") == Duration.minutes(3)
    //
    pub fn between(earlier: Time, later: Time) -> Duration {
        Duration.nanoseconds(day_nanos(later) - day_nanos(earlier))
    }

    /// The time of day as a reader of `locale` writes it, at the length
    /// `style` says: a 12-hour clock with AM and PM in `en`, a 24-hour one
    /// in `de`. A `Time` has no zone, so `Full` and `Long` write what
    /// `Medium` does.
    //! t = Time`21:30:00`
    //! assert Time.format(t, Locale`en`) == "9:30\u{202f}PM"
    //! assert Time.format(t, Locale`de`) == "21:30"
    //! assert Time.format(t, Locale`fr`, style: .Medium) == "21:30:00"
    //
    pub fn format(t: Time, locale: Locale, style: TimeStyle = TimeStyle.Short) -> String {
        civil_format_style(locale, Time.fields_of(t), "-/${TimeStyle.name(style)}")
    }

    /// The time of day as a reader of `locale` writes the fields `fields`
    /// names: `jm` is the hour as the locale writes it and the minutes, `Hm`
    /// a 24-hour clock, `hm` a 12-hour one.
    //! t = Time`21:30:00`
    //! assert Time.format_fields(t, Locale`en`, TimeFields`jm`) == "9:30\u{202f}PM"
    //! assert Time.format_fields(t, Locale`en`, TimeFields`Hm`) == "21:30"
    //! assert Time.format_fields(t, Locale`de`, TimeFields`hm`) == "9:30\u{202f}PM"
    //
    pub fn format_fields(t: Time, locale: Locale, fields: TimeFields) -> String {
        TimeFields(skeleton) = fields
        civil_format_fields(locale, Time.fields_of(t), skeleton)
    }

    /// Read a time of day a reader of `locale` typed, as `Time.format`
    /// writes it at `style`, strictly unless `lenient: True`, as
    /// `Date.parse_in` reads a date.
    //! assert Time.parse_in("9:30\u{202f}PM", Locale`en`) == Ok(Time`21:30:00`)
    //! assert Time.parse_in("9:30 PM", Locale`en`) == Ok(Time`21:30:00`)
    //! assert Time.parse_in("9:30 pm", Locale`en`, lenient: True) == Ok(Time`21:30:00`)
    //! assert Time.parse_in("21:30", Locale`de`) == Ok(Time`21:30:00`)
    //
    pub fn parse_in(
        text: String,
        locale: Locale,
        style: TimeStyle = TimeStyle.Short,
        lenient: Bool = False,
    ) -> Result<Time, Error> {
        attempt = time_parse_style(text, locale, "-/${TimeStyle.name(style)}", lenient)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// The time of day by a fixed numeric pattern, a 24-hour clock.
    //! assert Time.to_string_with(Time`09:05:00`, TimePattern`HHmmss`) == "090500"
    //! assert Time.to_string_with(Time`09:05:00.25`, TimePattern`HH:mm:ss.SSS`) == "09:05:00.250"
    //
    pub fn to_string_with(t: Time, pattern: TimePattern) -> String {
        TimePattern(p) = pattern
        civil_format_pattern(Time.fields_of(t), p)
    }

    /// Read a time of day by a fixed numeric pattern.
    //! assert Time.parse_with("0905", TimePattern`HHmm`) == Ok(Time`09:05:00`)
    //
    pub fn parse_with(text: String, pattern: TimePattern) -> Result<Time, Error> {
        TimePattern(p) = pattern
        attempt = time_parse_pattern(text, p)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    // The fields a pattern writes a time by.
    fn fields_of(t: Time) -> List<Int> {
        [1970, 1, 1, t.hour, t.minute, t.second, t.nanosecond, 0, 2]
    }
}

/// Total nanoseconds since midnight. Module-private — backs `Time.between`.
//! assert try Time"08:33:00" |> day_nanos() == 30780000000000
//
fn day_nanos(t: Time) -> Int {
    t.hour * 3_600_000_000_000 + t.minute * 60_000_000_000 + t.second * 1_000_000_000 + t.nanosecond
}

derive Equatable for Time
derive Hashable for Time
derive Comparable for Time

impl Literal for Time {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<Time, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        Time.parse(body)
    }
}

impl Display for Time {
    /// ISO time string. Sub-second precision renders as a trailing `.fff…`
    /// only when nonzero (so `09:30:00`, not `09:30:00.000`).
    host fn to_string(t: Time) -> String
}

impl Debug for Time {
    fn inspect(t: Time) -> String {
        "${t}"
    }
}

impl TimeParts for Time {
    fn hour(value: Time) -> Int {
        value.hour
    }

    fn minute(value: Time) -> Int {
        value.minute
    }

    fn second(value: Time) -> Int {
        value.second
    }

    fn nanosecond(value: Time) -> Int {
        value.nanosecond
    }
}

impl Add<Duration, Time> for Time {
    /// Add an exact `Duration`, wrapping around midnight.
    //! assert try Time"08:33:00" + Duration.minutes(3) == try Time"08:36:00"
    //
    fn add(lhs: Time, rhs: Duration) -> Time {
        time_add_nanos(lhs, Duration.as_nanos(rhs))
    }
}

impl Subtract<Duration, Time> for Time {
    /// Subtract an exact `Duration`, wrapping around midnight.
    //! assert try Time"08:36:00" - Duration.minutes(3) == try Time"08:33:00"
    //
    fn subtract(lhs: Time, rhs: Duration) -> Time {
        lhs + rhs * -1
    }
}

// ============================================================================
// NaiveDateTime
// ============================================================================
/// A naive date+time — a wall-clock reading like `2026-05-04T14:30:00`,
/// with no zone or offset. **Looks like a complete timestamp but
/// isn't**: a wall reading without a zone doesn't name a real moment in
/// history. Reach for `DateTime` (IANA-zoned) when you need a real
/// instant; reach for `NaiveDateTime` only when the value is genuinely
/// a wall reading (calendar templates, schedule patterns, dates with a
/// "local time of day" that will be resolved into a zone later).
pub opaque struct NaiveDateTime {
    year: Int
    month: Int
    day: Int
    hour: Int
    minute: Int
    second: Int
    nanosecond: Int
}

impl NaiveDateTime {
    /// The date and time as a reader of `locale` writes them, the date at
    /// the length `date` says and the time at `time`'s, joined as the
    /// locale joins them.
    //! dt = NaiveDateTime`2026-10-20T09:30:00`
    //! assert NaiveDateTime.format(dt, Locale`en`) == "Oct 20, 2026, 9:30\u{202f}AM"
    //! assert NaiveDateTime.format(dt, Locale`de`, date: .Long) == "20. Oktober 2026, 09:30"
    //
    pub fn format(
        dt: NaiveDateTime,
        locale: Locale,
        date: DateStyle = DateStyle.Medium,
        time: TimeStyle = TimeStyle.Short,
    ) -> String {
        civil_format_style(
            locale,
            NaiveDateTime.fields_of(dt),
            "${DateStyle.name(date)}/${TimeStyle.name(time)}",
        )
    }

    /// The date and time as a reader of `locale` writes the fields `fields`
    /// names.
    //! dt = NaiveDateTime`2026-10-20T09:30:00`
    //!
    //! assert NaiveDateTime.format_fields(
    //!     dt,
    //!     Locale`en`,
    //!     DateTimeFields`MMMdjm`,
    //! ) == "Oct 20, 9:30\u{202f}AM"
    //
    pub fn format_fields(dt: NaiveDateTime, locale: Locale, fields: DateTimeFields) -> String {
        DateTimeFields(skeleton) = fields
        civil_format_fields(locale, NaiveDateTime.fields_of(dt), skeleton)
    }

    /// The date and time by a fixed numeric pattern.
    //! dt = NaiveDateTime`2026-10-19T09:30:00`
    //! assert NaiveDateTime.to_string_with(dt, DateTimePattern`yyyyMMdd'T'HHmmss`) == "20261019T093000"
    //
    pub fn to_string_with(dt: NaiveDateTime, pattern: DateTimePattern) -> String {
        DateTimePattern(p) = pattern
        civil_format_pattern(NaiveDateTime.fields_of(dt), p)
    }

    /// Read a date and time by a fixed numeric pattern.
    //! assert NaiveDateTime.parse_with("20261019T093000", DateTimePattern`yyyyMMdd'T'HHmmss`) == Ok(
    //!     NaiveDateTime`2026-10-19T09:30:00`
    //! )
    //
    pub fn parse_with(text: String, pattern: DateTimePattern) -> Result<NaiveDateTime, Error> {
        DateTimePattern(p) = pattern
        attempt = naive_parse_pattern(text, p)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    // The fields a pattern writes a date and time by.
    fn fields_of(dt: NaiveDateTime) -> List<Int> {
        [dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.nanosecond, 0, 3]
    }

    /// Combine a `Date` and a `Time`. Both parts are already valid, so
    /// this is infallible.
    //! assert NaiveDateTime.of(
    //!     try Date"2026-05-04",
    //!     try Time"14:30:00",
    //! ) == try NaiveDateTime"2026-05-04T14:30:00"
    //
    pub fn of(d: Date, t: Time) -> NaiveDateTime {
        #NaiveDateTime{
            year: Date.year(d),
            month: Date.month(d),
            day: Date.day(d),
            hour: Time.hour(t),
            minute: Time.minute(t),
            second: Time.second(t),
            nanosecond: Time.nanosecond(t),
        }
    }

    /// A `NaiveDateTime` at midnight (00:00:00) on the given date.
    //! assert NaiveDateTime.at_midnight(try Date"2026-05-04") == try NaiveDateTime"2026-05-04T00:00:00"
    //
    pub fn at_midnight(d: Date) -> NaiveDateTime {
        #NaiveDateTime{
            year: Date.year(d),
            month: Date.month(d),
            day: Date.day(d),
            hour: 0,
            minute: 0,
            second: 0,
            nanosecond: 0,
        }
    }

    /// The date component.
    //! assert NaiveDateTime.to_date(try NaiveDateTime"2026-05-04T14:30:00") == try Date"2026-05-04"
    //
    pub host fn to_date(dt: NaiveDateTime) -> Date

    /// The time-of-day component.
    //! assert NaiveDateTime.to_time(try NaiveDateTime"2026-05-04T14:30:00") == try Time"14:30:00"
    //
    pub host fn to_time(dt: NaiveDateTime) -> Time

    /// Construct from seven integers, validating each component AND the
    /// year/month/day combination.
    //! assert try NaiveDateTime.new(2026, 5, 4, 14, 30) == try NaiveDateTime"2026-05-04T14:30:00"
    //! assert Err(Error.InvalidValue(_msg)) = NaiveDateTime.new(2026, 2, 30, 12, 0)
    //
    pub fn new(
        year: Int,
        month: Int,
        day: Int,
        hour: Int,
        minute: Int,
        second: Int = 0,
        nanosecond: Int = 0,
    ) -> Result<NaiveDateTime, Error> {
        NaiveDateTime.new_exact(year, month, day, hour, minute, second, nanosecond)
    }

    // The seven-component constructor, with no defaults of its own.
    //
    // The split exists so that `second: Int = 0` above has exactly ONE owner.
    // The Go half it reaches takes seven arguments and pads nothing, so a
    // default can only be written on a Nomi declaration, where the IR builder
    // reads it. Two layers, one encoding.
    //
    // `DateTime.in_zone` over `in_zone_resolve` below is this shape already.
    fn new_exact(
        year: Int,
        month: Int,
        day: Int,
        hour: Int,
        minute: Int,
        second: Int,
        nanosecond: Int,
    ) -> Result<NaiveDateTime, Error> {
        attempt = naive_new_exact_raw(year, month, day, hour, minute, second, nanosecond)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Parse an ISO naive datetime string (`YYYY-MM-DDTHH:MM:SS[.fff…]`).
    /// Allows a single space instead of `T` between the date and time.
    //! assert try NaiveDateTime.parse("2026-05-04T14:30:00") == NaiveDateTime.of(
    //!     try Date"2026-05-04",
    //!     try Time"14:30:00",
    //! )
    //!
    //! assert try NaiveDateTime.parse("2026-05-04 14:30:00") == try NaiveDateTime"2026-05-04T14:30:00"
    //
    pub fn parse(s: String) -> Result<NaiveDateTime, Error> {
        attempt = naive_parse_raw(s)

        if attempt.kind == 0 {
            Ok(attempt.value)
        } else {
            Err(Error.of(attempt.kind, attempt.reason))
        }
    }

    /// Difference (later − earlier), computed as if both were UTC wall-readings.
    //! assert NaiveDateTime.between(
    //!     try NaiveDateTime"2026-05-04T09:00:00",
    //!     try NaiveDateTime"2026-05-04T11:30:00",
    //! ) == Duration.minutes(150)
    //
    pub fn between(earlier: NaiveDateTime, later: NaiveDateTime) -> Duration {
        Duration.nanoseconds(naive_between_nanos(earlier, later))
    }
}

derive Equatable for NaiveDateTime
derive Hashable for NaiveDateTime
derive Comparable for NaiveDateTime

impl Literal for NaiveDateTime {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<NaiveDateTime, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        NaiveDateTime.parse(body)
    }
}

impl Display for NaiveDateTime {
    /// ISO datetime string (`YYYY-MM-DDTHH:MM:SS[.fff…]`).
