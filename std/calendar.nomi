impl Add<Duration, NaiveDateTime> for NaiveDateTime
    /// Add an exact `Duration`.
    fn add(lhs: NaiveDateTime, rhs: Duration) -> NaiveDateTime
        // Whole days first, as civil days, which on a reading with no zone
        // are 24 exact hours: a Duration of any length moves the reading.
        n = Duration.as_nanos(rhs)
        day: NonZeroInt = 86_400_000_000_000
        naive_add_nanos(lhs + Days(Int.floor_div(n, day)), Int.modulo(n, day))
    end
end

