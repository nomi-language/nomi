pub type Weeks Int

derive Equatable for Weeks
derive Hashable for Weeks
derive Comparable for Weeks
derive Display for Weeks

/// Whole calendar days for civil calendar arithmetic on date-bearing values.
pub type Days Int

derive Equatable for Days
derive Hashable for Days
derive Comparable for Days
derive Display for Days

/// Whole civil hours for date-time wall-clock arithmetic.
pub type Hours Int

derive Equatable for Hours
derive Hashable for Hours
derive Comparable for Hours
derive Display for Hours

/// Whole civil minutes for date-time wall-clock arithmetic.
pub type Minutes Int

derive Equatable for Minutes
derive Hashable for Minutes
derive Comparable for Minutes
derive Display for Minutes

/// Whole civil seconds for date-time wall-clock arithmetic.
pub type Seconds Int

derive Equatable for Seconds
derive Hashable for Seconds
derive Comparable for Seconds
derive Display for Seconds

/// Whole civil milliseconds for date-time wall-clock arithmetic.
pub type Milliseconds Int

derive Equatable for Milliseconds
derive Hashable for Milliseconds
derive Comparable for Milliseconds
derive Display for Milliseconds

/// Whole civil microseconds for date-time wall-clock arithmetic.
pub type Microseconds Int

