/// A fixed numeric pattern for a date and time, of `DatePattern`'s letters
/// and `TimePattern`'s.
//! assert DateTimePattern.parse("yyyyMMdd'T'HHmmss") == Ok(DateTimePattern`yyyyMMdd'T'HHmmss`)
//
pub opaque type DateTimePattern String

derive Equatable for DateTimePattern

impl DateTimePattern {
    /// The pattern `text` is, or why it is not a fixed date and time
    /// pattern.
    pub fn parse(text: String) -> Result<DateTimePattern, Error> {
        reason = pattern_check(2, text)

        if reason == "" {
            Ok(DateTimePattern(text))
        } else {
            Err(Error.InvalidFormat(reason))
        }
    }
}

impl Literal for DateTimePattern {
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTimePattern, Error> {
        body = Iter.reduce(fragments, fn acc = "", frag -> {
            case frag {
                .Static(s) -> acc + s
                .Dynamic(v) -> acc + v
            }
        })

        DateTimePattern.parse(body)
    }
}

impl Debug for DateTimePattern {
    fn inspect(pattern: DateTimePattern) -> String {
        DateTimePattern(text) = pattern
        "DateTimePattern`${text}`"
    }
}

impl Localize for Date {
    /// The date as `Date.format` writes it at its default length.
    fn localize(d: Date, locale: Locale) -> String {
        Date.format(d, locale, DateStyle.Medium)
    }
}

impl Localize for Time {
    /// The time of day as `Time.format` writes it at its default length.
    fn localize(t: Time, locale: Locale) -> String {
        Time.format(t, locale, TimeStyle.Short)
    }
}

impl Localize for NaiveDateTime {
    /// The date and time as `NaiveDateTime.format` writes them.
    fn localize(dt: NaiveDateTime, locale: Locale) -> String {
        NaiveDateTime.format(dt, locale, DateStyle.Medium, TimeStyle.Short)
    }
}

impl Localize for DateTime {
    /// The moment as `DateTime.format` writes it.
    fn localize(dt: DateTime, locale: Locale) -> String {
        DateTime.format(dt, locale, DateStyle.Medium, TimeStyle.Short)
    }
}

// ============================================================================
// The Go boundary
// ============================================================================
//
// Every declaration below is module-private and takes or returns only `Int`,
// `String` and the calendar structs themselves — the types the FFI
// projection carries directly, so each Go function is one adapter row.
// `stdcalendar/boundary.go`'s header names the three types it does not
// carry directly and states what each costs here.
//
// The twenty-one declarations bound INLINE above rather than through this
// section are the ones whose public signature was already agreeable:
// `Date.days_between`, the four `Display` renderings, `NaiveDateTime.to_date`
// / `to_time`, `DateTime.to_offset`, and the fourteen `DateParts`/`TimeParts`
// accessors on the two anchored types. A wrapper for those would be a second
// name and nothing else.
/// One fallible `Date` construction as the Go half reports it.
///
/// `kind` is 0 on success, otherwise the ordinal of the `Error` variant in its
/// declaration order. `reason` is that variant's payload. On failure `value`
/// is untouched and never read, because `Date.of` branches on `kind` first.
struct DateAttempt {
    value: Date
    kind: Int
    reason: String
}

/// One fallible `Time` construction as the Go half reports it.
struct TimeAttempt {
    value: Time
    kind: Int
    reason: String
}

/// One fallible `NaiveDateTime` construction as the Go half reports it.
struct NaiveAttempt {
    value: NaiveDateTime
    kind: Int
    reason: String
}

/// One fallible `OffsetDateTime` construction as the Go half reports it.
struct OffsetAttempt {
    value: OffsetDateTime
    kind: Int
    reason: String
}

/// One fallible `DateTime` construction as the Go half reports it.
struct ZonedAttempt {
    value: DateTime
    kind: Int
    reason: String
}

/// The ordinal-to-variant pairing, in one place.
///
/// IMPL-OWNED rather than a free function, and that is a lowering constraint
/// rather than taste: the IR builder refuses a call to a module-private free
/// function inside a stdlib module (`stdlib file-qualified call`), so
/// `Error.of(kind, reason)` made `Date.parse` unlowerable and took the
/// `Date"…"` typed literal with it. `Error.of` is a qualified call and lowers.
/// The same applies to the five lifts below and to `Disambiguation.tag`.
impl Error {
    /// `Error` has five variants and a caller matches on which one — a DST gap
    /// is `Nonexistent`, a bad string is `InvalidFormat` — so the classification
    /// has to survive the boundary. A trailing Go `error` projects to
    /// `Result<_, String>` and would leave it to be recovered by parsing a
    /// message; `runtime/extern_validate.go` refuses a typed `E` outright. So
    /// the Go half reports an ordinal and this is the only place it is read.
    /// `rt`'s `TagInvalidFormat` … `TagAmbiguous` constants are the other half.
    ///
    /// A `kind` outside 1..=5 cannot arise: the Go side writes only those five
    /// tags, and 0 is handled by the lifts below before they reach here. The
    /// final arm is `Ambiguous` because the chain needs a total answer, not
    /// because 5 is a fallback.
    fn of(kind: Int, reason: String) -> Error {
        if kind == 1 {
            Error.InvalidFormat(reason)
        } else if kind == 2 {
            Error.InvalidValue(reason)
        } else if kind == 3 {
            Error.UnknownZone(reason)
        } else if kind == 4 {
            Error.Nonexistent(reason)
        } else {
            Error.Ambiguous(reason)
        }
    }
}

