// ============================================================================
// OffsetDateTime
// ============================================================================
/// A date and time at a fixed UTC offset (`-05:00`). It names a moment and
/// follows no daylight-saving rules. It is the type for an ISO 8601
/// timestamp that carries an offset and no zone
/// (`2026-05-04T14:30:00-05:00`). For a moment in a zone, use `DateTime`.
/// An `OffsetDateTime` records no zone, so making a `DateTime` from one
/// means naming the zone.
///
/// Equality and ordering compare the instant only: two values at one
/// moment with different offsets are equal, and the offset decides how each
/// displays. Build one with the `OffsetDateTime"…"` typed literal,
/// `OffsetDateTime.with_offset(naive, offset)`,
/// `OffsetDateTime.from_instant(instant, offset)` or `OffsetDateTime.parse`.
//! odt = OffsetDateTime"2026-05-04T14:30:00-05:00"
//! assert Display.to_string(odt) == "2026-05-04T14:30:00-05:00"
//! assert odt == OffsetDateTime"2026-05-04T19:30:00Z"
//
pub opaque struct OffsetDateTime
    instant_nanos:  Int
    offset_seconds: Int64
end

// `Ok` when `offset`, cut to whole seconds, is within ±18 hours, which an
// OffsetDateTime's offset is; otherwise the InvalidValue naming it.
fn offset_in_range(offset: Duration) -> Result<Unit, Error>
    seconds = Duration.as_seconds(offset)

    if seconds < -64_800 or seconds > 64_800 then
        Err(Error.InvalidValue("offset out of range (±18h): ${seconds}s"))
    else
        Ok(Unit)
    end
end

impl OffsetDateTime
    /// The moment a clock at a fixed UTC `offset` showed the wall reading
    /// `dt`. Returns `Err(.InvalidValue(...))` for an offset outside ±18
    /// hours or one that is not a whole number of seconds.
    //! assert OffsetDateTime.with_offset(NaiveDateTime"2026-05-04T09:00:00", Duration.hours(-5))?
    //!     == OffsetDateTime"2026-05-04T09:00:00-05:00"
    //!
    //! assert OffsetDateTime.with_offset(NaiveDateTime"2026-05-04T09:00:00", Duration.hours(19))
    //!     == Err(Error.InvalidValue("offset out of range (±18h): 68400s"))
    //
    pub fn with_offset(dt: NaiveDateTime, offset: Duration) -> Result<OffsetDateTime, Error>
        offset_in_range(offset)?
        attempt = offset_with_offset_raw(dt, Duration.as_nanos(offset))

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// Attach a fixed offset to an absolute `Instant`, of any year. A
    /// sub-second offset is cut to whole seconds. Returns
    /// `Err(.InvalidValue(...))` for an offset outside ±18 hours, as
    /// `with_offset` does.
    //! assert OffsetDateTime.from_instant(Instant.from_seconds(0), Duration.hours(0))
    //!     == Ok(OffsetDateTime"1970-01-01T00:00:00Z")
    //!
    //! assert OffsetDateTime.from_instant(Instant.from_seconds(100_000_000_000), Duration.hours(0))
    //!     == Ok(OffsetDateTime"5138-11-16T09:46:40Z")
    //!
    //! assert OffsetDateTime.from_instant(Instant.from_seconds(Int.pow(10, 22)), Duration.hours(0))
    //!     == Ok(OffsetDateTime"+316887385070084-04-22T17:46:40Z")
    //!
    //! assert OffsetDateTime.from_instant(Instant.from_seconds(0), Duration.hours(19))
    //!     == Err(Error.InvalidValue("offset out of range (±18h): 68400s"))
    //
    pub fn from_instant(i: Instant, offset: Duration) -> Result<OffsetDateTime, Error>
        offset_in_range(offset)?
        Ok(offset_from_instant_nanos(Instant.as_nanos(i), Duration.as_nanos(offset)))
    end

    /// Parse an ISO 8601 timestamp with an offset:
    /// `YYYY-MM-DDTHH:MM:SS[.fff…]` and then `±HH:MM` or `Z`. The offset is
    /// required.
    //! assert OffsetDateTime.parse("2026-05-04T14:30:00-05:00")?
    //!     == OffsetDateTime"2026-05-04T14:30:00-05:00"
    //!
    //! assert Err(Error.InvalidFormat(_msg)) = OffsetDateTime.parse("2026-05-04T14:30:00")
    //
    pub fn parse(s: String) -> Result<OffsetDateTime, Error>
        attempt = offset_parse_raw(s)

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// Exact duration from `earlier` to `later`, between their instants,
    /// whatever their offsets; negative when `later` is the earlier moment.
    //! assert OffsetDateTime.between(
    //!     OffsetDateTime"2026-05-04T14:30:00-05:00",
    //!     OffsetDateTime"2026-05-04T20:30:00+00:00",
    //! ) == Duration.hours(1)
    //
    pub fn between(earlier: OffsetDateTime, later: OffsetDateTime) -> Duration
        Duration.nanoseconds(later.instant_nanos - earlier.instant_nanos)
    end

    /// The wall reading at the value's offset, with the offset dropped: the
    /// date and time its clock showed.
    //! assert OffsetDateTime.to_naive(OffsetDateTime"2026-05-04T14:30:00-05:00")
    //!     == NaiveDateTime"2026-05-04T14:30:00"
    //
    pub host fn to_naive(odt: OffsetDateTime) -> NaiveDateTime
end

impl Literal for OffsetDateTime
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<OffsetDateTime, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        OffsetDateTime.parse(body)
    end
end

impl Display for OffsetDateTime
    /// ISO 8601 date and time with its offset
    /// (`YYYY-MM-DDTHH:MM:SS[.fff…]±HH:MM`). UTC is written `+00:00`.
    host fn to_string(odt: OffsetDateTime) -> String
end

impl Debug for OffsetDateTime
    fn inspect(odt: OffsetDateTime) -> String
        "${odt}"
    end
end

impl DateParts for OffsetDateTime
    // `DateParts`/`TimeParts` accessors are Go projections of
    // `instant_nanos` at `offset_seconds` in exact civil arithmetic
    // (stdcalendar.OffsetDateTimeWall): the extern IS the interface function
    // (no wrapper).
    host fn year(value: OffsetDateTime) -> Int
    host fn month(value: OffsetDateTime) -> Int
    host fn day(value: OffsetDateTime) -> Int
end

impl TimeParts for OffsetDateTime
    host fn hour(value: OffsetDateTime) -> Int
    host fn minute(value: OffsetDateTime) -> Int
    host fn second(value: OffsetDateTime) -> Int
    host fn nanosecond(value: OffsetDateTime) -> Int
end

impl Anchored for OffsetDateTime
    /// The moment the value names, with its offset dropped.
    //! assert OffsetDateTime.to_instant(OffsetDateTime"1970-01-01T01:00:42+01:00")
    //!     == Instant.from_seconds(42)
    //
    fn to_instant(odt: OffsetDateTime) -> Instant
        Instant.from_nanos(odt.instant_nanos)
    end

    /// The fixed UTC offset the value carries.
    //! assert OffsetDateTime.offset(OffsetDateTime"2026-05-04T14:30:00-05:00") == Duration.hours(-5)
    //
    fn offset(odt: OffsetDateTime) -> Duration
        Duration.seconds(odt.offset_seconds)
    end
end

impl Add<Duration, OffsetDateTime> for OffsetDateTime
    /// Add an exact `Duration`, of any length.
    fn add(lhs: OffsetDateTime, rhs: Duration) -> OffsetDateTime
        offset_add_nanos(lhs, Duration.as_nanos(rhs))
    end
end

