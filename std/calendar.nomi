//# Calendar dates, times, civil periods, machine-time projections, and
//# IANA-zone-aware date-time arithmetic.
//# A date or time reads as a reader of a locale writes it with `format`, at
//# a style's length (`Date.format(d, locale, style: .Long)`) or with the
//# fields a skeleton names (`Date.format_fields(d, locale,
//# DateFields`yMMMd`)`), and is read back from what a reader typed with
//# `parse_in`. A fixed numeric pattern, the same in every locale, is for
//# file names and protocols: `Date.to_string_with(d, DatePattern`yyyyMMdd`)`
//# and `parse_with`. `TimeUnit.format_relative` writes "in 3 days" or
//# "yesterday". The calendar is the Gregorian one; the words and patterns
//# come from CLDR, from the data the program carries.

import {
    add.Add
    bool.Bool.{self, False, True}
    comparable.{Comparable, Ordering}
    debug.Debug
    display.Display
    duration.Duration
    equatable.Equatable
    hashable.Hashable
    instant.Instant
    int.Int
    iter.Iter
    lists.List
    literals.{Fragment, Literal}
    locale.Locale
    localize.Localize
    results.Result.{self, Err, Ok}
    strings.String
    subtract.Subtract
}

/// `Error` — what went wrong constructing or projecting a calendar value.
///
/// The first two variants (`InvalidFormat`, `InvalidValue`) cover parsing
/// and construction across every civil type. The last three
/// (`UnknownZone`, `Nonexistent`, `Ambiguous`) are only surfaced by the
/// anchored projection cluster (`OffsetDateTime`, `DateTime`):
/// `UnknownZone` when the zone name isn't in the embedded tzdb;
/// `Nonexistent` when a wall-clock reading falls in a spring-forward
/// gap with `mode = Reject`; `Ambiguous` when a wall-clock reading
/// falls in a fall-back fold with `mode = Reject`. (Other
/// disambiguation modes resolve gaps/folds silently.)
pub enum Error {
    InvalidFormat String
    InvalidValue String
    UnknownZone String
    Nonexistent String
    Ambiguous String
}

derive Equatable for Error

impl Display for Error {
    fn to_string(e: Error) -> String {
        case e {
            Error.InvalidFormat(s) -> "invalid format: " + s
            Error.InvalidValue(s) -> "invalid value: " + s
            Error.UnknownZone(s) -> "unknown zone: " + s
            Error.Nonexistent(s) -> "nonexistent local time: " + s
            Error.Ambiguous(s) -> "ambiguous local time: " + s
        }
    }
}

// ============================================================================
// Civil Periods
// ============================================================================
/// Whole calendar years for civil calendar arithmetic on date-bearing values.
pub type Years Int

derive Equatable for Years
derive Hashable for Years
derive Comparable for Years
derive Display for Years

/// Whole calendar months for civil calendar arithmetic on date-bearing values.
