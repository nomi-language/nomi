    fn compare(a: OffsetDateTime, b: OffsetDateTime) -> Ordering
        Int.compare(a.instant_nanos, b.instant_nanos)
    end
end

// ============================================================================
// Disambiguation
// ============================================================================
/// How `DateTime.in_zone` resolves a wall-clock reading that falls in a
/// spring-forward gap (clocks jumped over it, so it never happens) or a
/// fall-back fold (clocks rolled back, so it happens twice). The modes
/// follow Temporal's `disambiguation` option.
///
/// - **`Compatible`**, the default, always returns an instant. In a fold
///   it is the earlier one, before the transition. In a gap it moves the
///   reading forward by the gap's length, so `02:30` becomes `03:30` after
///   the transition.
/// - **`Earlier`** is the earlier instant in a fold, as `Compatible`'s is.
///   In a gap it moves the reading back by the gap's length, so `02:30`
///   becomes `01:30` before the transition. Use it where earlier is safer,
///   as for a deadline or a reminder.
/// - **`Later`** is the later instant in a fold, after the transition. In a
///   gap it is `Compatible`'s. Use it where later is safer, as for an
///   expiration or a grace period.
/// - **`Reject`** returns `Err(Ambiguous ...)` for a fold and
///   `Err(Nonexistent ...)` for a gap. Use it when the reading came from a
///   person (a form, an API request) who can be asked which they meant.
///
/// Civil shifts (`+ Hours(...)`, `+ Months(...)`, ...) always resolve with
/// `Compatible`, so they are total.
//! gap = NaiveDateTime"2026-03-08T02:30:00"
//! fold = NaiveDateTime"2026-11-01T01:30:00"
//! zone = "America/New_York"
//! assert DateTime.in_zone(gap, zone)? == DateTime"2026-03-08T03:30:00-04:00[America/New_York]"
//!
//! assert DateTime.in_zone(gap, zone, Disambiguation.Earlier)?
//!     == DateTime"2026-03-08T01:30:00-05:00[America/New_York]"
//!
//! assert DateTime.in_zone(fold, zone)? == DateTime"2026-11-01T01:30:00-04:00[America/New_York]"
//!
//! assert DateTime.in_zone(fold, zone, Disambiguation.Later)?
//!     == DateTime"2026-11-01T01:30:00-05:00[America/New_York]"
//!
//! assert Err(Error.Nonexistent(_why)) = DateTime.in_zone(gap, zone, Disambiguation.Reject)
//! assert Err(Error.Ambiguous(_why)) = DateTime.in_zone(fold, zone, Disambiguation.Reject)
//
pub enum Disambiguation
    Compatible
    Earlier
    Later
    Reject
end

// ============================================================================
// DateTime (IANA-zoned, DST-aware)
// ============================================================================
/// A date and time in an IANA time zone (`America/New_York`), following
/// the zone's daylight-saving rules. It is the type for a moment, and the
/// one to use for almost every timestamp a program handles. The zone
/// database is embedded in the program, so a zone lookup works on every
/// host.
///
/// Equality and ordering compare the instant only: one moment read in two
/// zones is two equal values. The zone decides how each displays.
///
/// Build one with the `DateTime"…"` typed literal (RFC 9557's bracket
/// form), `DateTime.in_zone(naive, zone, mode)` (a wall reading in a zone;
/// `Disambiguation` covers gaps and folds),
/// `DateTime.from_instant_in(instant, zone)`, `DateTime.now_in(zone)` or
/// `DateTime.parse`. A function that takes a zone name returns
/// `Err(UnknownZone ...)` for one the database lacks.
/// `DateTime.local_zone` names the zone the machine is set to, and
/// `DateTime.now_local` reads the clock in it.
//! dt = DateTime"2026-06-15T12:00:00-04:00[America/New_York]"
//! assert Display.to_string(dt) == "2026-06-15T12:00:00-04:00[America/New_York]"
//! assert DateTime.hour(dt) == 12
//!
//! paris = DateTime"2026-06-15T18:00:00+02:00[Europe/Paris]"
//! assert dt == paris
//! refute Display.to_string(dt) == Display.to_string(paris)
//
pub opaque struct DateTime
    instant_nanos: Int
    zone:          String
end

impl DateTime
    /// The moment as a reader of `locale` writes its wall clock, the date
    /// at the length `date` says and the time at `time`'s. A `Long` time
    /// ends with the zone's offset in the locale's short GMT format
    /// (`GMT+2`) and a `Full` one in its long format (`GMT+02:00`). std has
    /// no zone names.
    //! dt = DateTime"2026-10-20T09:30:00+02:00[Europe/Warsaw]"
    //! assert DateTime.format(dt, Locale"pl") == "20 paź 2026, 09:30"
    //! assert DateTime.format(dt, Locale"en", time: .Full) == "Oct 20, 2026, 9:30:00\u{202f}AM GMT+02:00"
    //!
    //! assert DateTime.format(dt, Locale"en", date: .Full, time: .Long)
    //!     == "Tuesday, October 20, 2026, 9:30:00\u{202f}AM GMT+2"
    //
    pub fn format(
        dt:     DateTime,
        locale: Locale,
        date:   DateStyle = DateStyle.Medium,
        time:   TimeStyle = TimeStyle.Short,
    ) -> String
        civil_format_style(
            locale,
            DateParts.year(dt),
            DateTime.fields_of(dt),
            "${DateStyle.name(date)}/${TimeStyle.name(time)}",
        )
    end

    /// The moment as a reader of `locale` writes the fields `fields` names.
    //! dt = DateTime"2026-10-20T09:30:00+02:00[Europe/Warsaw]"
    //! assert DateTime.format_fields(dt, Locale"en", DateTimeFields"EEEEjm") == "Tuesday 9:30\u{202f}AM"
    //
    pub fn format_fields(dt: DateTime, locale: Locale, fields: DateTimeFields) -> String
        DateTimeFields(skeleton) = fields
        civil_format_fields(locale, DateParts.year(dt), DateTime.fields_of(dt), skeleton)
    end

    /// The moment's wall clock by a fixed numeric pattern.
    //! dt = DateTime"2026-10-20T09:30:00+02:00[Europe/Warsaw]"
    //! assert DateTime.to_string_with(dt, DateTimePattern"yyyyMMdd'T'HHmmss") == "20261020T093000"
    //
    pub fn to_string_with(dt: DateTime, pattern: DateTimePattern) -> String
        DateTimePattern(p) = pattern
        civil_format_pattern(DateParts.year(dt), DateTime.fields_of(dt), p)
    end

    // The fields after the year a pattern writes a moment by: its wall
    // clock and offset.
    fn fields_of(dt: DateTime) -> List<Int64>
        odt = DateTime.to_offset(dt)
        wall = OffsetDateTime.to_naive(odt)

        [
            wall.month,
            wall.day,
            wall.hour,
            wall.minute,
            wall.second,
            wall.nanosecond,
            odt.offset_seconds,
            7,
        ]
    end

    /// The moment the clocks of an IANA zone showed the wall reading `dt`.
    /// An unknown zone, `"Local"` and `""` among them (`local_zone` names the
    /// machine's), is `Err(UnknownZone ...)`. A reading in a gap or a fold is
    /// resolved by `mode`, and is an `Err` only with `Disambiguation.Reject`.
    //! assert DateTime.in_zone(NaiveDateTime"2026-06-15T12:00:00", "America/New_York")?
    //!     == DateTime"2026-06-15T12:00:00-04:00[America/New_York]"
    //!
    //! assert Err(Error.UnknownZone(_zone)) = DateTime.in_zone(
    //!     NaiveDateTime"2026-06-15T12:00:00",
    //!     "Mars/Base",
    //! )
    //
    pub fn in_zone(
        dt:   NaiveDateTime,
        zone: String,
        mode: Disambiguation = Disambiguation.Compatible,
    ) -> Result<DateTime, Error>
        DateTime.in_zone_resolve(dt, zone, mode)
    end

    fn in_zone_resolve(
        dt:   NaiveDateTime,
        zone: String,
        mode: Disambiguation,
    ) -> Result<DateTime, Error>
        mode_tag: Int64 =
            case mode
                Disambiguation.Compatible -> 1
                Disambiguation.Earlier    -> 2
                Disambiguation.Later      -> 3
                Disambiguation.Reject     -> 4
            end

        attempt = zoned_in_zone_raw(dt, zone, mode_tag)

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// Project an absolute `Instant`, of any year, into an IANA zone.
    /// Fails only on an unknown zone, `UnknownZone`. Past the last
    /// transition a zone's database lists, its offset follows the rule
    /// the database extends forever (New York's daylight saving every
    /// summer); before the first, it is the zone's first offset, its
    /// local mean time. Past about 292 billion years either way, where no
    /// rule reaches, the offset is the one at the nearer end.
    //! assert DateTime.from_instant_in(Instant.from_seconds(0), "UTC")?
    //!     == DateTime"1970-01-01T00:00:00Z[UTC]"
    //!
    //! assert DateTime.from_instant_in(Instant.from_seconds(100_000_000_000), "America/New_York")?
    //!     == DateTime"5138-11-16T04:46:40-05:00[America/New_York]"
    //
    pub fn from_instant_in(i: Instant, zone: String) -> Result<DateTime, Error>
        attempt = zoned_from_instant_in_raw(Instant.as_nanos(i), zone)

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// The current moment, read in a zone. The same as
    /// `DateTime.from_instant_in(Instant.now(), zone)`.
    //! assert Err(Error.UnknownZone(_zone)) = DateTime.now_in("Mars/Base")
    //
    pub fn now_in(zone: String) -> Result<DateTime, Error>
        DateTime.from_instant_in(Instant.now(), zone)
    end

    /// The IANA zone the machine is set to, a name every function that
    /// takes a zone takes. It is the zone the `TZ` environment variable
    /// names, else the one the system's `/etc/localtime` links to, else
    /// `UTC` on a system with neither. An empty `TZ` is `UTC`. In a
    /// browser it is the zone the browser shows its clocks in. It is read
    /// at each call, so a long-running program follows a change.
    ///
    /// A zone with no IANA name is `Err(UnknownZone ...)`, with the
    /// reason: a `TZ` that names no zone, an `/etc/localtime` copied from
    /// a zone file instead of linked to one, and a Windows zone with no
    /// `TZ`, since Windows names its zones by names of its own.
    //! zone = DateTime.local_zone() |> Result.with_default("UTC")
    //! assert DateTime.from_instant_in(Instant.from_seconds(0), zone) is Ok(_)
    //
    pub fn local_zone() -> Result<String, Error>
        case local_zone_raw()
            Ok(zone)    -> Ok(zone)
            Err(reason) -> Err(Error.UnknownZone(reason))
        end
    end

    /// The current moment in the zone the machine is set to: `now_in` at
    /// the zone `DateTime.local_zone` names, which fails as it does.
    //! assert DateTime.now_local() |> Result.map(DateTime.zone) == DateTime.local_zone()
    //
    pub fn now_local() -> Result<DateTime, Error>
        zone = DateTime.local_zone()?
        DateTime.now_in(zone)
    end

    /// The same moment as an `OffsetDateTime`, at the offset the zone has
    /// at that moment. The result does not record the zone.
    //! assert DateTime.to_offset(DateTime"2026-06-15T12:00:00-04:00[America/New_York]")
    //!     == OffsetDateTime"2026-06-15T12:00:00-04:00"
    //
    pub host fn to_offset(d: DateTime) -> OffsetDateTime

    /// The wall reading in the value's zone, with the zone dropped: the
    /// date and time its clock showed. A UTC reading of an `Instant` is
    /// `NaiveDateTime.from_instant(i)`.
    //! assert DateTime.to_naive(DateTime"2026-06-15T12:00:00-04:00[America/New_York]")
    //!     == NaiveDateTime"2026-06-15T12:00:00"
    //
    pub fn to_naive(d: DateTime) -> NaiveDateTime
        OffsetDateTime.to_naive(DateTime.to_offset(d))
    end

    /// The same instant read in another IANA zone. Fails only on an
    /// unknown zone, `UnknownZone`.
    //! assert DateTime.with_zone(DateTime"2026-06-15T12:00:00-04:00[America/New_York]", "Europe/Paris")?
    //!     == DateTime"2026-06-15T18:00:00+02:00[Europe/Paris]"
    //
    pub fn with_zone(d: DateTime, zone: String) -> Result<DateTime, Error>
        attempt = zoned_with_zone_raw(d, zone)

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// The IANA zone the value reads its wall clock in, which its
    /// construction checked.
    //! assert DateTime.zone(DateTime"2026-06-15T12:00:00-04:00[America/New_York]") == "America/New_York"
    //
    pub fn zone(d: DateTime) -> String
        d.zone
    end

    /// Parse an RFC 9557 date and time with a zone
    /// (`YYYY-MM-DDTHH:MM:SS[.fff…]±HH:MM[Zone/Name]`). The offset and the
    /// bracketed zone are both required; text with an offset and no bracket
    /// reads with `OffsetDateTime.parse`. The offset names the instant and
    /// the zone reads it, so where the offset is not the zone's at that
    /// moment the wall reading changes.
    //! assert DateTime.parse("2026-06-15T12:00:00-04:00[America/New_York]")?
    //!     == DateTime.in_zone(NaiveDateTime"2026-06-15T12:00:00", "America/New_York")?
    //!
    //! winter_offset = DateTime.parse("2026-06-15T12:00:00-05:00[America/New_York]")?
    //! assert Display.to_string(winter_offset) == "2026-06-15T13:00:00-04:00[America/New_York]"
    //!
    //! assert Err(Error.InvalidFormat(_msg)) = DateTime.parse("2026-06-15T12:00:00-04:00")
    //
    pub fn parse(s: String) -> Result<DateTime, Error>
        attempt = zoned_parse_raw(s)

        if attempt.kind == 0 then
            Ok(attempt.value)
        else
            Err(Error.of(attempt.kind, attempt.reason))
        end
    end

    /// Exact duration from `earlier` to `later`, between their instants,
    /// whatever their zones; negative when `later` is the earlier moment.
    //! assert DateTime.between(
    //!     DateTime"2026-06-15T12:00:00-04:00[America/New_York]",
    //!     DateTime"2026-06-15T18:30:00+02:00[Europe/Paris]",
    //! ) == Duration.minutes(30)
    //
    pub fn between(earlier: DateTime, later: DateTime) -> Duration
        Duration.nanoseconds(later.instant_nanos - earlier.instant_nanos)
    end
end

impl Literal for DateTime
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTime, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        DateTime.parse(body)
    end
end

impl Display for DateTime
    /// RFC 9557 date and time with its offset and zone
    /// (`2026-06-15T12:00:00-04:00[America/New_York]`).
    host fn to_string(d: DateTime) -> String
end

impl Debug for DateTime
    fn inspect(d: DateTime) -> String
        "${d}"
    end
end

impl DateParts for DateTime
    // `DateParts`/`TimeParts` accessors project through
    // `time.Unix(0, instant_nanos).In(loc)` (the IANA-loaded location) — the
    // extern IS the interface function.
    host fn year(value: DateTime) -> Int
    host fn month(value: DateTime) -> Int
    host fn day(value: DateTime) -> Int
end

impl TimeParts for DateTime
    host fn hour(value: DateTime) -> Int
    host fn minute(value: DateTime) -> Int
    host fn second(value: DateTime) -> Int
    host fn nanosecond(value: DateTime) -> Int
end

impl Anchored for DateTime
    /// The moment the value names, with its zone dropped.
    //! assert DateTime.to_instant(DateTime"1970-01-01T00:00:42Z[UTC]") == Instant.from_seconds(42)
    //
    fn to_instant(d: DateTime) -> Instant
        Instant.from_nanos(d.instant_nanos)
    end

    /// The zone's UTC offset at this moment, which changes with the zone's
    /// daylight saving.
    //! assert DateTime.offset(DateTime"2026-06-15T12:00:00-04:00[America/New_York]") == Duration.hours(-4)
    //! assert DateTime.offset(DateTime"2026-01-15T12:00:00-05:00[America/New_York]") == Duration.hours(-5)
    //
    fn offset(d: DateTime) -> Duration
        Duration.nanoseconds(zoned_offset_nanos(d))
    end
end

impl Add<Duration, DateTime> for DateTime
    /// Add an exact `Duration`, of any length.
    fn add(lhs: DateTime, rhs: Duration) -> DateTime
        zoned_add_nanos(lhs, Duration.as_nanos(rhs))
    end
end

impl Add<Years, DateTime> for DateTime
    /// Add whole calendar years, clamping leap days when needed.
    fn add(lhs: DateTime, Years(n)) -> DateTime
        zoned_add_years(lhs, n)
    end
end

impl Add<Months, DateTime> for DateTime
    /// Add whole calendar months, clamping end-of-month.
    fn add(lhs: DateTime, Months(n)) -> DateTime
        zoned_add_months(lhs, n)
    end
end

impl Add<Weeks, DateTime> for DateTime
    /// Add whole calendar weeks.
    fn add(lhs: DateTime, Weeks(n)) -> DateTime
        lhs + Days(n * 7)
    end
end

impl Add<Days, DateTime> for DateTime
    /// Add whole calendar days.
    fn add(lhs: DateTime, Days(n)) -> DateTime
        zoned_add_days(lhs, n)
    end
end

impl Add<Hours, DateTime> for DateTime
    /// Add whole civil hours.
    fn add(lhs: DateTime, Hours(n)) -> DateTime
        zoned_add_hours(lhs, n)
    end
end

impl Add<Minutes, DateTime> for DateTime
    /// Add whole civil minutes.
    fn add(lhs: DateTime, Minutes(n)) -> DateTime
        zoned_add_minutes(lhs, n)
    end
end

impl Add<Seconds, DateTime> for DateTime
    /// Add whole civil seconds.
    fn add(lhs: DateTime, Seconds(n)) -> DateTime
        zoned_add_seconds(lhs, n)
    end
end

impl Add<Milliseconds, DateTime> for DateTime
    /// Add whole civil milliseconds.
    fn add(lhs: DateTime, Milliseconds(n)) -> DateTime
        zoned_add_milliseconds(lhs, n)
    end
end

impl Add<Microseconds, DateTime> for DateTime
    /// Add whole civil microseconds.
    fn add(lhs: DateTime, Microseconds(n)) -> DateTime
        zoned_add_microseconds(lhs, n)
    end
end

impl Add<Nanoseconds, DateTime> for DateTime
    /// Add whole civil nanoseconds.
    fn add(lhs: DateTime, Nanoseconds(n)) -> DateTime
        zoned_add_nanoseconds(lhs, n)
    end
end

impl Subtract<Duration, DateTime> for DateTime
    /// Subtract an exact `Duration`.
    fn subtract(lhs: DateTime, rhs: Duration) -> DateTime
        lhs + rhs * -1
    end
end

impl Subtract<Years, DateTime> for DateTime
    /// Subtract whole calendar years, clamping leap days when needed.
    fn subtract(lhs: DateTime, Years(n)) -> DateTime
        lhs + Years(-n)
    end
end

impl Subtract<Months, DateTime> for DateTime
    /// Subtract whole calendar months, clamping end-of-month.
    fn subtract(lhs: DateTime, Months(n)) -> DateTime
        lhs + Months(-n)
    end
end

impl Subtract<Weeks, DateTime> for DateTime
    /// Subtract whole calendar weeks.
    fn subtract(lhs: DateTime, Weeks(n)) -> DateTime
        lhs + Weeks(-n)
    end
end

impl Subtract<Days, DateTime> for DateTime
    /// Subtract whole calendar days.
    fn subtract(lhs: DateTime, Days(n)) -> DateTime
        lhs + Days(-n)
    end
end

impl Subtract<Hours, DateTime> for DateTime
    /// Subtract whole civil hours.
    fn subtract(lhs: DateTime, Hours(n)) -> DateTime
        lhs + Hours(-n)
    end
end

impl Subtract<Minutes, DateTime> for DateTime
    /// Subtract whole civil minutes.
    fn subtract(lhs: DateTime, Minutes(n)) -> DateTime
        lhs + Minutes(-n)
    end
end

impl Subtract<Seconds, DateTime> for DateTime
    /// Subtract whole civil seconds.
    fn subtract(lhs: DateTime, Seconds(n)) -> DateTime
        lhs + Seconds(-n)
    end
end

impl Subtract<Milliseconds, DateTime> for DateTime
    /// Subtract whole civil milliseconds.
    fn subtract(lhs: DateTime, Milliseconds(n)) -> DateTime
        lhs + Milliseconds(-n)
    end
end

impl Subtract<Microseconds, DateTime> for DateTime
    /// Subtract whole civil microseconds.
    fn subtract(lhs: DateTime, Microseconds(n)) -> DateTime
        lhs + Microseconds(-n)
    end
end

impl Subtract<Nanoseconds, DateTime> for DateTime
    /// Subtract whole civil nanoseconds.
    fn subtract(lhs: DateTime, Nanoseconds(n)) -> DateTime
        lhs + Nanoseconds(-n)
    end
end

impl Equatable for DateTime
    fn equal(a: DateTime, b: DateTime) -> Bool
        a.instant_nanos == b.instant_nanos
    end
end

impl Hashable for DateTime
    fn hash(value: DateTime) -> Int
        value.instant_nanos
    end
end

impl Comparable for DateTime
    fn compare(a: DateTime, b: DateTime) -> Ordering
        Int.compare(a.instant_nanos, b.instant_nanos)
    end
end

// ============================================================================
// Text for a reader
// ============================================================================
/// A day of the week, Monday first, as ISO 8601 counts them. `Display`
/// gives its English name, the same in every locale; a message selects by
/// one with `:nomi:weekday`.
//! assert Display.to_string(Weekday.Tuesday) == "Tuesday"
//
pub enum Weekday
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
end

derive Equatable for Weekday
derive Hashable for Weekday

impl Display for Weekday
    fn to_string(day: Weekday) -> String
        case day
            Weekday.Monday    -> "Monday"
            Weekday.Tuesday   -> "Tuesday"
            Weekday.Wednesday -> "Wednesday"
            Weekday.Thursday  -> "Thursday"
            Weekday.Friday    -> "Friday"
            Weekday.Saturday  -> "Saturday"
            Weekday.Sunday    -> "Sunday"
        end
    end
end

/// How much of a date `Date.format` writes, in each locale's way: `Full`
/// (`Tuesday, October 20, 2026` in `en`), `Long` (`October 20, 2026`),
/// `Medium` (`Oct 20, 2026`) and `Short` (`10/20/26`).
pub enum DateStyle
    Full
    Long
    Medium
    Short
end

derive Equatable for DateStyle

impl DateStyle
    // CLDR's name for the style.
    fn name(style: DateStyle) -> String
        case style
            DateStyle.Full   -> "full"
            DateStyle.Long   -> "long"
            DateStyle.Medium -> "medium"
            DateStyle.Short  -> "short"
        end
    end
end

/// How much of a time of day `Time.format` writes, in each locale's way:
/// `Short` is hours and minutes, `Medium` adds the seconds, and `Long` and
/// `Full` the zone's offset, where the value has a zone.
pub enum TimeStyle
    Full
    Long
    Medium
    Short
end

derive Equatable for TimeStyle

impl TimeStyle
    // CLDR's name for the style.
    fn name(style: TimeStyle) -> String
        case style
            TimeStyle.Full   -> "full"
            TimeStyle.Long   -> "long"
            TimeStyle.Medium -> "medium"
            TimeStyle.Short  -> "short"
        end
    end
end

/// A unit of civil time, which `TimeUnit.format_relative` counts in. A
/// month and a year are not fixed lengths of time, so relative time takes
/// a unit and a count, not a `Duration`.
pub enum TimeUnit
    Second
    Minute
    Hour
    Day
    Week
    Month
    Quarter
    Year
end

derive Equatable for TimeUnit

impl TimeUnit
    /// `count` units from now, as a reader of `locale` says it: `in 3 days`
    /// and `3 days ago` in `en`, `za 3 dni` and `3 dni temu` in `pl`, each
    /// count in the plural form the locale's rules give it. Unless
    /// `numeric: True`, a count the locale has a word for is that word
    /// (`yesterday`, `tomorrow`, `vorgestern`).
    //! assert TimeUnit.format_relative(3, Locale"en", TimeUnit.Day) == "in 3 days"
    //! assert TimeUnit.format_relative(-1, Locale"en", TimeUnit.Day) == "yesterday"
    //! assert TimeUnit.format_relative(0, Locale"en", TimeUnit.Day) == "today"
    //! assert TimeUnit.format_relative(-1, Locale"en", TimeUnit.Day, numeric: True) == "1 day ago"
    //! assert TimeUnit.format_relative(-3, Locale"de", TimeUnit.Day) == "vor 3 Tagen"
    //! assert TimeUnit.format_relative(3, Locale"pl", TimeUnit.Week) == "za 3 tygodnie"
    //! assert TimeUnit.format_relative(5, Locale"pl", TimeUnit.Week) == "za 5 tygodni"
    //
    pub fn format_relative(
        count:   Int,
        locale:  Locale,
        unit:    TimeUnit,
        numeric: Bool = False,
    ) -> String
        position: Int64 =
            case unit
                TimeUnit.Second  -> 0
                TimeUnit.Minute  -> 1
                TimeUnit.Hour    -> 2
                TimeUnit.Day     -> 3
                TimeUnit.Week    -> 4
                TimeUnit.Month   -> 5
                TimeUnit.Quarter -> 6
                TimeUnit.Year    -> 7
            end

        relative_format_raw(locale, count, position, numeric)
    end
end

/// The fields a date shows and how wide, as a CLDR skeleton: `y` the year,
/// `M` the month (`M` its number, `MMM` its short name, `MMMM` its name),
/// `d` the day, `E` the weekday (`EEEE` its name) and `G` the era. The
/// locale decides the order, the punctuation and the words
/// (`Date.format_fields`). A literal without slots is checked when the
/// program is checked, and its patterns are worked out when the program is built.
//! assert DateFields.parse("yMMMd") == Ok(DateFields"yMMMd")
//! assert Err(Error.InvalidFormat(_why)) = DateFields.parse("yMMMdHH")
//
pub opaque type DateFields String

derive Equatable for DateFields

impl DateFields
    /// The skeleton `text` names, or why it names none a date has.
    pub fn parse(text: String) -> Result<DateFields, Error>
        reason = fields_check(0, text)

        if reason == "" then
            Ok(DateFields(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for DateFields
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateFields, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        DateFields.parse(body)
    end
end

impl Debug for DateFields
    fn inspect(fields: DateFields) -> String
        DateFields(text) = fields
        String.to_typed_literal(text, "DateFields")
    end
end

/// The fields a time of day shows, as a CLDR skeleton: `j` the hour as the
/// locale writes it (a 12-hour clock with AM and PM, or a 24-hour one), `h`
/// a 12-hour clock's and `H` a 24-hour one's, `m` the minutes, `s` the
/// seconds and `S` their fraction.
//! assert TimeFields.parse("jm") == Ok(TimeFields"jm")
//
pub opaque type TimeFields String

derive Equatable for TimeFields

impl TimeFields
    /// The skeleton `text` names, or why it names none a time has.
    pub fn parse(text: String) -> Result<TimeFields, Error>
        reason = fields_check(1, text)

        if reason == "" then
            Ok(TimeFields(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for TimeFields
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<TimeFields, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        TimeFields.parse(body)
    end
end

impl Debug for TimeFields
    fn inspect(fields: TimeFields) -> String
        TimeFields(text) = fields
        String.to_typed_literal(text, "TimeFields")
    end
end

/// The fields a date and time show, as a CLDR skeleton of `DateFields`'
/// letters and `TimeFields`'.
//! assert DateTimeFields.parse("yMMMdjm") == Ok(DateTimeFields"yMMMdjm")
//
pub opaque type DateTimeFields String

derive Equatable for DateTimeFields

impl DateTimeFields
    /// The skeleton `text` names, or why it names none.
    pub fn parse(text: String) -> Result<DateTimeFields, Error>
        reason = fields_check(2, text)

        if reason == "" then
            Ok(DateTimeFields(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for DateTimeFields
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTimeFields, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        DateTimeFields.parse(body)
    end
end

impl Debug for DateTimeFields
    fn inspect(fields: DateTimeFields) -> String
        DateTimeFields(text) = fields
        String.to_typed_literal(text, "DateTimeFields")
    end
end

/// A fixed numeric pattern for a date, the same text in every locale: `y`
/// the year (`yyyy` four digits, `yy` two), `M` the month and `d` the day
/// (doubled for two digits), `D` the day of the year, with anything else,
/// or text in single quotes, written as it is. A month's or a weekday's
/// name is a word of a language, so a pattern holds none: `MMM` is a
/// compile error that points to `Date.format_fields`.
//! assert DatePattern.parse("yyyy-MM-dd") == Ok(DatePattern"yyyy-MM-dd")
//! assert Err(Error.InvalidFormat(_why)) = DatePattern.parse("dd MMM yyyy")
//
pub opaque type DatePattern String

derive Equatable for DatePattern

impl DatePattern
    /// The pattern `text` is, or why it is not a fixed date pattern.
    pub fn parse(text: String) -> Result<DatePattern, Error>
        reason = pattern_check(0, text)

        if reason == "" then
            Ok(DatePattern(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for DatePattern
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DatePattern, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        DatePattern.parse(body)
    end
end

impl Debug for DatePattern
    fn inspect(pattern: DatePattern) -> String
        DatePattern(text) = pattern
        String.to_typed_literal(text, "DatePattern")
    end
end

/// A fixed numeric pattern for a time of day: `H` the hour of a 24-hour
/// clock, `m` the minutes, `s` the seconds (each doubled for two digits)
/// and `S` the fraction of a second, one letter per digit. A 12-hour clock
/// needs AM or PM, a word, so a pattern has none.
//! assert TimePattern.parse("HH:mm") == Ok(TimePattern"HH:mm")
//
pub opaque type TimePattern String

derive Equatable for TimePattern

impl TimePattern
    /// The pattern `text` is, or why it is not a fixed time pattern.
    pub fn parse(text: String) -> Result<TimePattern, Error>
        reason = pattern_check(1, text)

        if reason == "" then
            Ok(TimePattern(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for TimePattern
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<TimePattern, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        TimePattern.parse(body)
    end
end

impl Debug for TimePattern
    fn inspect(pattern: TimePattern) -> String
        TimePattern(text) = pattern
        String.to_typed_literal(text, "TimePattern")
    end
end

/// A fixed numeric pattern for a date and time, of `DatePattern`'s letters
/// and `TimePattern`'s.
//! assert DateTimePattern.parse("yyyyMMdd'T'HHmmss") == Ok(DateTimePattern"yyyyMMdd'T'HHmmss")
//
pub opaque type DateTimePattern String

derive Equatable for DateTimePattern

impl DateTimePattern
    /// The pattern `text` is, or why it is not a fixed date and time
    /// pattern.
    pub fn parse(text: String) -> Result<DateTimePattern, Error>
        reason = pattern_check(2, text)

        if reason == "" then
            Ok(DateTimePattern(text))
        else
            Err(Error.InvalidFormat(reason))
        end
    end
end

impl Literal for DateTimePattern
    fn from_fragments(fragments: List<Fragment<String>>) -> Result<DateTimePattern, Error>
        body = Iter.reduce(fragments, "", fn acc, frag ->
            case frag
                .Static(s)  -> acc + s
                .Dynamic(v) -> acc + v
            end
        end)

        DateTimePattern.parse(body)
    end
end

impl Debug for DateTimePattern
    fn inspect(pattern: DateTimePattern) -> String
        DateTimePattern(text) = pattern
        String.to_typed_literal(text, "DateTimePattern")
    end
end

impl Localize for Date
    /// The date as `Date.format` writes it at its default length.
    //! assert Date.localize(Date"2026-10-20", Locale"en") == "Oct 20, 2026"
    //
    fn localize(d: Date, locale: Locale) -> String
        Date.format(d, locale, DateStyle.Medium)
    end
end

impl Localize for Time
    /// The time of day as `Time.format` writes it at its default length.
    //! assert Time.localize(Time"21:30:00", Locale"de") == "21:30"
    //
    fn localize(t: Time, locale: Locale) -> String
        Time.format(t, locale, TimeStyle.Short)
    end
end

impl Localize for NaiveDateTime
    /// The date and time as `NaiveDateTime.format` writes them.
    fn localize(dt: NaiveDateTime, locale: Locale) -> String
        NaiveDateTime.format(dt, locale, DateStyle.Medium, TimeStyle.Short)
    end
end

impl Localize for DateTime
    /// The moment as `DateTime.format` writes it.
    fn localize(dt: DateTime, locale: Locale) -> String
        DateTime.format(dt, locale, DateStyle.Medium, TimeStyle.Short)
    end
end

// ============================================================================
// The Go boundary
// ============================================================================
//
// Every declaration below is module-private and takes or returns only `Int`,
// `String` and the calendar structs themselves — the types the host
// projection carries directly, so each Go function is one adapter row.
// `stdcalendar/boundary.go`'s header names the three shapes it passes
// another way and states what each costs here.
//
// The twenty-one declarations bound INLINE above rather than through this
// section are the ones whose public signature was already agreeable:
// `Date.days_between`, the four `Display` renderings, `NaiveDateTime.to_date`
// / `to_time`, `DateTime.to_offset`, and the fourteen `DateParts`/`TimeParts`
// accessors on the two anchored types. A wrapper for those would be a second
// name and nothing else.
/// One fallible `Date` construction as the Go half reports it.
///
/// `kind` is 0 on success, otherwise the ordinal of the `Error` variant in its
/// declaration order. `reason` is that variant's payload. On failure `value`
/// is untouched and never read, because `Date.of` branches on `kind` first.
struct DateAttempt
    value:  Date
    kind:   Int
    reason: String
end

/// One fallible `Time` construction as the Go half reports it.
struct TimeAttempt
    value:  Time
    kind:   Int
    reason: String
end

/// One fallible `NaiveDateTime` construction as the Go half reports it.
struct NaiveAttempt
    value:  NaiveDateTime
    kind:   Int
    reason: String
end

/// One fallible `OffsetDateTime` construction as the Go half reports it.
struct OffsetAttempt
    value:  OffsetDateTime
    kind:   Int
    reason: String
end

/// One fallible `DateTime` construction as the Go half reports it.
struct ZonedAttempt
    value:  DateTime
    kind:   Int
    reason: String
end

/// The ordinal-to-variant pairing, in one place.
///
/// IMPL-OWNED rather than a free function, and that is a lowering constraint
/// rather than taste: the IR builder refuses a call to a module-private free
/// function inside a stdlib module (`stdlib file-qualified call`), so
/// `Error.of(kind, reason)` made `Date.parse` unlowerable and took the
/// `Date"…"` typed literal with it. `Error.of` is a qualified call and lowers.
/// The same applies to the five lifts below and to `Disambiguation.tag`.
impl Error
    /// `Error` has five variants and a caller matches on which one — a DST gap
    /// is `Nonexistent`, a bad string is `InvalidFormat` — so the classification
    /// has to survive the boundary. A trailing Go `error` projects to
    /// `Result<_, String>` and would leave it to be recovered by parsing a
    /// message; `runtime/extern_validate.go` refuses a typed `E` outright. So
    /// the Go half reports an ordinal and this is the only place it is read.
    /// `rt`'s `TagInvalidFormat` … `TagAmbiguous` constants are the other half.
    ///
    /// A `kind` outside 1..=5 cannot arise: the Go side writes only those five
    /// tags, and 0 is handled by the lifts below before they reach here. The
    /// final arm is `Ambiguous` because the chain needs a total result, not
    /// because 5 is a fallback.
    fn of(kind: Int, reason: String) -> Error
        if kind == 1 then
            Error.InvalidFormat(reason)
        else if kind == 2 then
            Error.InvalidValue(reason)
        else if kind == 3 then
            Error.UnknownZone(reason)
        else if kind == 4 then
            Error.Nonexistent(reason)
        else
            Error.Ambiguous(reason)
        end
    end
end

