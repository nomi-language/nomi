import
    comparable.Comparable
    convert.TryFrom
    debug.Debug
    discrete.Discrete
    display.Display
    equatable.Equatable
    hashable.Hashable
    int.{Int, Int64, NonNegativeInt}
    option.Option.{self, None, Some}
    steppable.Steppable
    strings.String
end

//# Unicode scalar values. `String` iterates by grapheme cluster for text
//# workflows; use `String.to_codepoints` when code needs to inspect the scalar
//# values that make up a string. An ASCII codepoint is written as a literal,
//# `'a'` or `'\n'`; every other scalar value comes from `Int.to_codepoint`.
//# The categories and properties the `is_` functions report are those of
//# Unicode 17.0.0.

/// A Unicode scalar value: an Int from `0` through `0x10FFFF` that is not a
/// UTF-16 surrogate, `0xD800` through `0xDFFF`, as its rule says. One comes
/// from a literal, from `Int.to_codepoint`, which answers `None` for an Int
/// the rule refuses, or from `String.to_codepoints`. The 128 ASCII
/// codepoints have a literal: `'a'`, `'\''`, `'\u{7F}'`.
pub opaque type Codepoint Int64 when fn n -> n >= 0 and n <= 0x10FFFF and (n < 0xD800 or n > 0xDFFF)

impl Codepoint
    /// Returns the numeric Unicode scalar value, from `0` through
    /// `0x10FFFF`, a NonNegativeInt.
    //! assert Codepoint.to_int('A') == 65
    //
    pub fn to_int(Codepoint(n)) -> NonNegativeInt
        // The rule holds `n` at 0 or more; the Int64 it is read as says only
        // its 64 bits.
        if n < 0 then unreachable "a Codepoint's rule holds it at 0 or more"
        n
    end

    /// Reports whether `cp` is a Unicode letter: general category L (Lu, Ll,
    /// Lt, Lm or Lo). Letters from any script count. Digits, punctuation,
    /// emoji and combining marks (category M, such as U+0301 COMBINING ACUTE
    /// ACCENT) do not.
    //! assert Codepoint.is_letter('a')
    //! zhe = Int.to_codepoint(0x0436)?
    //! assert Codepoint.is_letter(zhe)
    //! refute Codepoint.is_letter('7')
    //
    pub host fn is_letter(cp: Codepoint) -> Bool

    /// Reports whether `cp` is an ASCII digit, `'0'` through `'9'`. This is
    /// ASCII-only on purpose: a phone number, a checksum or a number to parse
    /// means ASCII digits, so Arabic-Indic `٣` (U+0663) and full-width `１`
    /// (U+FF11) are not digits here. There is no function for Unicode decimal
    /// digits (general category Nd).
    //! assert Codepoint.is_digit('7')
    //! three = Int.to_codepoint(0x0663)?
    //! refute Codepoint.is_digit(three)
    //! refute Codepoint.is_digit('x')
    //
    pub fn is_digit(Codepoint(n)) -> Bool
        n >= 48 and n <= 57
    end

    /// Returns the value of an ASCII digit: `Some(0)` for `'0'` through
    /// `Some(9)` for `'9'`, and `None` for every codepoint `Codepoint.is_digit`
    /// rejects. ASCII-only on purpose, as `is_digit` is: Arabic-Indic and
    /// full-width digits return `None`.
    //! assert Codepoint.to_digit('7') == Some(7)
    //! one = Int.to_codepoint(0xFF11)?
    //! assert Codepoint.to_digit(one) == None
    //! assert Codepoint.to_digit('x') == None
    //
    pub fn to_digit(Codepoint(n)) -> Option<NonNegativeInt>
        if n >= 48 and n <= 57 then Some(n - 48) else None
    end

    /// Reports whether `cp` has the Unicode White_Space property: ASCII
    /// space, `'\t'`, `'\n'`, `'\r'`, vertical tab and form feed, U+0085,
    /// no-break space U+00A0, the ideographic space U+3000 and the other
    /// Unicode spaces and line separators. Zero-width space U+200B is not
    /// White_Space.
    //! assert Codepoint.is_whitespace('\t')
    //! nbsp = Int.to_codepoint(0x00A0)?
    //! assert Codepoint.is_whitespace(nbsp)
    //! refute Codepoint.is_whitespace('a')
    //
    pub host fn is_whitespace(cp: Codepoint) -> Bool

    /// Reports whether `cp` is an uppercase letter: general category Lu.
    /// Title-case letters (category Lt, such as `ǅ` U+01C5) are neither
    /// upper nor lower, and neither are letters without case, such as
    /// `中`.
    //! assert Codepoint.is_upper('A')
    //! zhe = Int.to_codepoint(0x0416)?
    //! assert Codepoint.is_upper(zhe)
    //! refute Codepoint.is_upper('a')
    //
    pub host fn is_upper(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a lowercase letter: general category Ll.
    /// Title-case letters (category Lt, such as `ǅ` U+01C5) are neither
    /// lower nor upper, and neither are letters without case, such as
    /// `中`.
    //! assert Codepoint.is_lower('a')
    //! e_acute = Int.to_codepoint(0x00E9)?
    //! assert Codepoint.is_lower(e_acute)
    //! refute Codepoint.is_lower('A')
    //
    pub host fn is_lower(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a title-case letter: general category Lt. These
    /// are the digraphs whose first part is capital, such as `ǅ` U+01C5, which
    /// start a word in title case.
    //! dz = Int.to_codepoint(0x01C5)?
    //! assert Codepoint.is_title(dz)
    //! refute Codepoint.is_title('D')
    //
    pub host fn is_title(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a mark: general category M (Mn, Mc or Me). A
    /// mark combines with the codepoint before it, as U+0301 COMBINING ACUTE
    /// ACCENT puts an accent on a letter.
    //! acute = Int.to_codepoint(0x0301)?
    //! assert Codepoint.is_mark(acute)
    //! refute Codepoint.is_mark('a')
    //
    pub host fn is_mark(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a number: general category N (Nd, Nl or No).
    /// Unlike `Codepoint.is_digit`, which is ASCII-only, this counts the digits
    /// of every script, Roman numerals such as `Ⅻ` U+216B and fractions such as
    /// `½` U+00BD.
    //! assert Codepoint.is_number('7')
    //! three = Int.to_codepoint(0x0663)?
    //! assert Codepoint.is_number(three)
    //! half = Int.to_codepoint(0x00BD)?
    //! assert Codepoint.is_number(half)
    //! refute Codepoint.is_number('x')
    //
    pub host fn is_number(cp: Codepoint) -> Bool

    /// Reports whether `cp` is punctuation: general category P (Pc, Pd, Ps, Pe,
    /// Pi, Pf or Po). Some ASCII characters a reader may call punctuation are
    /// symbols in Unicode: `+`, `<`, `=`, `>`, `|`, `~`, `$`, `^` and the
    /// backtick.
    //! assert Codepoint.is_punctuation('!')
    //! guillemet = Int.to_codepoint(0x00AB)?
    //! assert Codepoint.is_punctuation(guillemet)
    //! refute Codepoint.is_punctuation('+')
    //
    pub host fn is_punctuation(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a symbol: general category S (Sm, Sc, Sk
    /// or So): math signs such as `+`, currency signs such as `$`,
    /// modifier symbols such as `^` and other symbols such as `©` and
    /// most emoji.
    //! assert Codepoint.is_symbol('+')
    //! assert Codepoint.is_symbol('$')
    //! copyright = Int.to_codepoint(0x00A9)?
    //! assert Codepoint.is_symbol(copyright)
    //! refute Codepoint.is_symbol('!')
    //
    pub host fn is_symbol(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a separator: general category Z (Zs, Zl or
    /// Zp), the space characters and the line and paragraph separators.
    /// `Codepoint.is_whitespace` answers the White_Space property instead,
    /// which also holds `'\t'`, `'\n'` and the other control characters that
    /// space text, none of them a separator.
    //! assert Codepoint.is_separator(' ')
    //! line = Int.to_codepoint(0x2028)?
    //! assert Codepoint.is_separator(line)
    //! refute Codepoint.is_separator('\t')
    //
    pub host fn is_separator(cp: Codepoint) -> Bool

    /// Reports whether `cp` is a control character: general category Cc, the C0
    /// controls U+0000 to U+001F, U+007F and the C1 controls U+0080 to U+009F.
    /// Format characters (category Cf, such as U+200B ZERO WIDTH SPACE) are not
    /// controls.
    //! assert Codepoint.is_control('\n')
    //! zwsp = Int.to_codepoint(0x200B)?
    //! refute Codepoint.is_control(zwsp)
    //! refute Codepoint.is_control('a')
    //
    pub host fn is_control(cp: Codepoint) -> Bool
end

derive Equatable for Codepoint
derive Hashable for Codepoint
derive Comparable for Codepoint

impl Display for Codepoint
    /// Returns a one-codepoint string containing `cp`.
    //! assert Codepoint.to_string('A') == "A"
    //
    host fn to_string(cp: Codepoint) -> String
end

impl Debug for Codepoint
    /// Returns the developer-facing form: `Codepoint(65)` for `'A'`.
    //! assert Codepoint.inspect('A') == "Codepoint(65)"
    //
    fn inspect(cp: Codepoint) -> String
        "Codepoint(${Codepoint.to_int(cp)})"
    end
end

impl Discrete for Codepoint
    /// Returns the next valid Codepoint, skipping the UTF-16 surrogate block.
    /// Returns None after the largest Unicode scalar value.
    //! assert Codepoint.next('A') == Some('B')
    //! assert Codepoint.next(Int.to_codepoint(0x10FFFF)?) == None
    //
    fn next(cp: Codepoint) -> Option<Codepoint>
        n = Codepoint.to_int(cp)

        // `cp` is a scalar value, so the next one is too: past the last
        // one there is none, and past the last before the surrogates
        // comes the first after them.
        if n == 1_114_111 then
            None
        else if n == 55_295 then
            Some(Codepoint.unchecked(57_344))
        else
            Some(Codepoint.unchecked(n + 1))
        end
    end

    /// Counts how many `next` steps move from the first Codepoint to the
    /// second, skipping invalid surrogate values without walking the range.
    //! assert Codepoint.steps_between('a', 'd') == Some(3)
    //
    fn steps_between(Codepoint(a), Codepoint(b)) -> Option<Int>
        if a > b then
            Some(0)
        else
            skipped = if a <= 55_295 and b >= 57_344 then 2_048 else 0

            Some(b - a - skipped)
        end
    end
end

impl Steppable for Codepoint
    /// Steps by a count of valid Unicode scalar values, skipping the UTF-16
    /// surrogate block. Returns None if the destination is outside the
    /// Codepoint domain.
    //! assert Codepoint.step_by('A', 2) == Some('C')
    //
    fn step_by(cp: Codepoint, by: Int) -> Option<Codepoint>
        n = Codepoint.to_int(cp)

        if by > 1_114_111 or by < -1_114_111 then
            None
        else
            raw = n + by

            adjusted =
                if by > 0 and n <= 55_295 and raw >= 55_296 then
                    raw + 2_048
                else if by < 0 and n >= 57_344 and raw <= 57_343 then
                    raw - 2_048
                else
                    raw
                end

            Int.to_codepoint(adjusted)
        end
    end
end
