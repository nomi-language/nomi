//# Testing code that reads and writes files, without the disk. Inside
//# `testing.run(sandbox, body)`, every std::fs call `body` makes, and
//# every call the tasks it starts make, goes to an in-memory file system
//# built from the sandbox. `run` returns what `body` returned together
//# with the files afterwards, each operation in order and the handles left
//# open. As with `io.capture`, the sandbox lasts for the call and follows
//# its tasks, two tasks running their own `testing.run` at once never
//# see each other's files, and a nested `run` takes over for its own call.
//#
//# The sandbox is the same in-memory file system the browser build uses,
//# and `testing.conformance` holds it to the operating system's: std's
//# own tests run every rule against a real temporary directory and against
//# a sandbox.
//#
//# ```nomi
//# import
//#     std::fs::testing.{self, Sandbox}
//#     sort_lines
//# end
//#
//# test "sorts the lines into the output file"
//#     ran = testing.run(Sandbox{files: {"in.txt" => "pear\napple\n"}}, fn ->
//#         sort_lines.sort_file("in.txt", "out.txt")
//#     end)
//#
//#     assert ran.value == Ok(2)
//#     assert testing.text(ran, "/work/out.txt") == Some("apple\npear\n")
//#     assert ran.open == []
//# end
//# ```

import
    bool.Bool.{False, True}
    bytes.Bytes
    debug.Debug
    duration.Duration
    equatable.Equatable
    fs.{self, Access, Dir, Entry, Kind, LockAttempt, LockMode, Metadata, Owner, WriteMode}
    fs::host
    instant.Instant
    int.{Int, Int64}
    io.{Error, File, Reader, Writer}
    iter.Iter
    lists.List
    maps.Map
    option.Option.{self, None, Some}
    path
    results.Result.{self, Err, Ok}
    strings.String
    unit.Unit
end

/// The files a `run` starts with. The sandbox keeps permission bits and
/// returns them, and refuses nothing because of them.
pub struct Sandbox
    /// Text files by path. A relative path is under `cwd`, and the
    /// directories above each file exist.
    files: Map<String, String> = {}
    /// Files of bytes by path, as `files` holds text.
    binary: Map<String, Bytes> = {}
    /// Directories that exist, empty unless a file is in them.
    dirs: List<String> = []
    /// Symlinks by path, each to its target as written. The directories
    /// above each link exist; the target need not.
    links: Map<String, String> = {}
    /// Operations that fail with a given error, matched in order.
    failures: List<Failure> = []
    /// What relative paths resolve against, and what `fs.current_dir`
    /// returns.
    cwd: String = "/work"
end

/// An operation on a path that fails with `error` instead of happening,
/// every time, or only the `nth` matching time when `nth` is `Some(n)`. An
/// atomic write whose `Write` fails leaves the old file in the sandbox.
//! full = Failure{path: "out.txt", operation: Operation.Write, error: Error.NoSpace{path: "out.txt"}}
//!
//! ran = run(Sandbox{files: {"out.txt" => "old"}, failures: [full]}, fn ->
//!     fs.write_text("out.txt", "new", mode: WriteMode.ReplaceAtomically)
//! end)
//!
//! assert ran.value == Err(Error.NoSpace{path: "out.txt"})
//! assert text(ran, "/work/out.txt") == Some("old")
//
pub struct Failure
    /// The path the operation is on, resolved as the sandbox resolves it.
    path:      String
    operation: Operation
    error:     Error
    /// Fail only the nth matching operation, from 1; `None` fails every
    /// one.
    nth: Option<Int> = None
end

/// What a `Failure` matches.
pub enum Operation
    /// Opening a file to read it: `fs.read`, `fs.read_text`, `fs.open`,
    /// each run of `fs.lines` and `fs.chunks`, `fs.copy`'s source, and
    /// `fs.open_file` with `Access.Read`.
    Read
    /// Each write of data to a file opened for writing, and each
    /// `File.write`, `File.write_at` and `File.truncate`.
    Write
    /// Opening a file to write it (`fs.write`, `fs.create`, `fs.copy`'s
    /// target, `fs.open_file` with another access, `fs.touch` of a missing
    /// file, `fs.truncate`), making a directory, and making a symlink or a
    /// hard link (`fs.create_link`).
    Create
    /// `fs.remove` and `fs.remove_all`.
    Remove
    /// `fs.rename`, matched on the path renamed from.
    Rename
    /// `fs.list`.
    List
    /// `fs.metadata`, `fs.exists`, `fs.link_metadata`, `fs.read_link`,
    /// `fs.set_mode`, `fs.set_times` (and `fs.touch`), `fs.set_owner`,
    /// `fs.set_link_owner` and `fs.disk_usage`.
    Metadata
    /// Closing a file opened to read or write.
    Close
    /// `File.sync`, `File.sync_data` and `fs.sync_dir`.
    Sync
end

derive Equatable for Operation

/// What `run` returns.
pub struct Ran<T>
    /// What `body` returned.
    value: T
    /// Every file in the sandbox when `body` returned, by absolute path.
    /// Directories and symlinks are not files.
    files: Map<String, Bytes>
    /// Each operation as `<operation> <absolute path>`, in order: `read`,
    /// `write`, `open` (`fs.open_file`, `fs.truncate`, and `fs.touch` of a
    /// missing file), `list`, `metadata`, `link_metadata`, `create_dir`,
    /// `create_symlink`, `create_link`, `read_link`, `set_mode`,
    /// `set_times` (and `fs.touch`), `set_owner`, `set_link_owner`,
    /// `disk_usage`, `remove`, `remove_all`, `sync_dir`, `sync` and
    /// `sync_data` (`File.sync` and `File.sync_data`, at the path the file
    /// was opened by), and `rename <from> to <to>`. The path is the one the
    /// program named, resolved against the working directory, before any
    /// symlink in it is followed.
    log: List<String>
    /// The absolute path of each handle still open when `body` returned. A
    /// test asserts `ran.open == []` to catch a reader or writer it forgot
    /// to close.
    open: List<String>
end

/// Runs `body` with an in-memory file system built from `sandbox`, and
/// returns what it returned with the files afterwards. Nothing touches the
/// disk. If `body` traps, the trap propagates.
//! ran = run(Sandbox{files: {"in.txt" => "b\na\n"}}, fn ->
//!     names = Result.collect(fs.lines("in.txt"))?
//!     fs.write_text("out.txt", String.join(Iter.sort(names), ","))
//! end)
//!
//! assert ran.value == Ok(Unit)
//! assert text(ran, "/work/out.txt") == Some("a,b")
//! assert ran.log == ["read /work/in.txt", "write /work/out.txt"]
//! assert ran.open == []
//
pub fn run<T>(sandbox: Sandbox, body: () -> T) -> Ran<T>
    fake = built(sandbox)
    value = host.run_in(fake, body)

    Ran{
        value:,
        files: host.sandbox_files(fake),
        log:   host.sandbox_log(fake),
        open:  host.sandbox_open(fake),
    }
end

/// A `fs.Dir` over an in-memory file system built from `sandbox`, at its
/// working directory (`/work` by default): what a test hands to code that
/// takes a `Dir`, which then reads and writes no disk. The sandbox's
/// failures apply. A test reads what the code wrote back through the
/// `Dir`. Defer `Dir.close` on the next line.
//! d = dir(Sandbox{files: {"in.txt" => "b\na\n"}})
//! defer Dir.close(d)
//!
//! names = Result.collect(Dir.lines(d, "in.txt"))!
//! assert Dir.write_text(d, "out.txt", String.join(Iter.sort(names), ",")) == Ok(Unit)
//! assert Dir.read_text(d, "out.txt") == Ok("a,b")
//!
//! assert Dir.read_text(d, "/tmp/x") == Err(Error.InvalidPath{
//!         path:   "/tmp/x",
//!         reason: "the path leads outside the directory it is confined to",
//!     })
//
pub fn dir(sandbox: Sandbox) -> Dir
    case host.run_in(built(sandbox), fn -> fs.open_dir(sandbox.cwd))
        Ok(d)  -> d
        Err(_) -> unreachable "a sandbox's working directory exists"
    end
end

/// The in-memory file system `sandbox` describes.
fn built(sandbox: Sandbox) -> host.FileSystem
    texts = Map.map_values(sandbox.files, fn text -> String.to_bytes(text))

    fake = host.new_sandbox(
        sandbox.cwd,
        Map.merge(texts, sandbox.binary),
        sandbox.dirs,
        sandbox.links,
    )

    Iter.each(sandbox.failures, fn f ->
        host.sandbox_fail(
            fake,
            f.path,
            operation_code(f.operation),
            f.error,
            Option.with_default(f.nth, 0),
        )
    end)

    fake
end

fn operation_code(operation: Operation) -> Int64
    case operation
        Operation.Read     -> 1
        Operation.Write    -> 2
        Operation.Create   -> 3
        Operation.Remove   -> 4
        Operation.Rename   -> 5
        Operation.List     -> 6
        Operation.Metadata -> 7
        Operation.Close    -> 8
        Operation.Sync     -> 9
    end
end

/// The text of the file at the absolute path `at` when `run` returned, or
/// `None` when it is missing or not UTF-8.
//! ran = run(Sandbox{}, fn -> fs.write_text("a.txt", "hi"))
//! assert text(ran, "/work/a.txt") == Some("hi")
//! assert text(ran, "a.txt") == None
//
pub fn text<T>(ran: Ran<T>, at: String) -> Option<String>
    case Map.get(ran.files, at)
        Some(data) -> Bytes.to_string(data) |> Result.to_option()
        None       -> None
    end
end

/// A rule of std::fs that a file system broke, from `conformance`.
pub struct ConformanceFailure
    rule: String
    /// What happened, and what the rule wants.
    reason: String
end

/// Runs every rule of std::fs against the directory `root`, which must
/// exist and be empty, and returns the rules the file system there broke.
/// Each rule works in a directory of its own under `root`. The rules cover
/// each `WriteMode`, `NotFound` for a missing parent, sorted listings,
/// `remove` of a directory with entries, `remove_all` of a missing path,
/// `rename` over a file, an atomic write that fails, line splitting,
/// `InvalidText`, closed handles, `exists`, walks and globs, symlinks
/// (followed by reads and `metadata`, not by `link_metadata`, `remove`,
/// `rename` and walks; a dangling one; a loop), hard links and
/// `same_file`, `set_mode`, `set_times` and `touch`, `set_owner` to the
/// owner a file has (`Unsupported` on Windows), `disk_usage`, `truncate`,
/// what `metadata` answers besides kind and size, a `File`'s
/// reads and writes at a position, its syncs and its locks against a second
/// handle, `fs.sync_dir`, `fs.within`'s confinement, and a `Dir`'s: what it
/// reaches, the paths it refuses, its close and its temporary files.
///
/// std's own tests run it twice, against the disk in a directory from
/// `fs.make_temp_dir` and against a sandbox inside `run`, so a rule both
/// pass is one the sandbox models as the disk behaves.
//! assert run(Sandbox{}, fn -> conformance("/work")).value == []
//!
//! fn on_disk() -> Result<List<ConformanceFailure>, Error>
//!     dir = fs.make_temp_dir()?
//!     defer fs.remove_all_quietly(dir)
//!     Ok(conformance(dir))
//! end
//!
//! assert on_disk() == Ok([])
//
pub fn conformance(root: String) -> List<ConformanceFailure>
    rules()
    |> Iter.flat_map(fn (rule, check) ->
        dir = path.join(root, rule_dir(rule))

        case fs.create_dir(dir)
            Err(e) ->
                [ConformanceFailure{rule:, reason: "cannot make its directory: ${e}"}]

            Ok(_) ->
                case check(dir)
                    Some(reason) -> [ConformanceFailure{rule:, reason:}]
                    None         -> []
                end
        end
    end)
    |> Iter.to_list()
end

/// A rule's directory name: its words joined with `-`, without a glob's
/// `*`, which Windows refuses in a name.
fn rule_dir(rule: String) -> String
    String.replace(rule, "*", "")
    |> String.split(" ")
    |> Iter.filter(fn word -> word != "")
    |> String.join("-")
end

/// The first failure among checks made in order, or None.
fn first(checks: List<Option<String>>) -> Option<String>
    checks |> Iter.find(fn c -> Option.is_some(c)) |> Option.flat_map(fn c -> c)
end

/// None when got is want, else a sentence naming both.
fn check<T>(what: String, got: T, want: T) -> Option<String> where T: Equatable
    if got == want then
        None
    else
        Some("${what}: got ${Debug.inspect(got)}, want ${Debug.inspect(want)}")
    end
end

fn rules() -> List<(String, (String) -> Option<String>)>
    [
        ("replace creates and truncates",                             rule_replace),
        ("append creates and appends",                                rule_append),
        ("new refuses an existing file",                              rule_new),
        ("replace atomically replaces and leaves nothing beside it",  rule_atomic),
        ("an atomic write that fails leaves the old file",            rule_atomic_failure),
        ("a missing parent is NotFound naming it",                    rule_missing_parent),
        ("a listing is sorted by name",                               rule_sorted),
        ("listing a file is NotADirectory",                           rule_list_file),
        ("reading a directory is IsADirectory",                       rule_read_dir),
        ("remove refuses a directory with entries",                   rule_remove_full),
        ("remove of a missing path is NotFound",                      rule_remove_missing),
        ("remove_all of a missing path is Ok",                        rule_remove_all_missing),
        ("remove_all removes a tree",                                 rule_remove_all),
        ("rename replaces a file",                                    rule_rename),
        ("rename of a missing path is NotFound",                      rule_rename_missing),
        ("copy copies and replaces",                                  rule_copy),
        ("create_dir makes parents only when asked",                  rule_create_dir),
        ("lines splits LF and CRLF and keeps a last line",            rule_lines),
        ("lines runs again from the start",                           rule_lines_twice),
        ("text that is not UTF-8 is InvalidText",                     rule_invalid_text),
        ("a closed handle answers Closed",                            rule_closed),
        ("exists answers absence and presence",                       rule_exists),
        ("metadata answers kind and size",                            rule_metadata),
        ("walk is depth first in name order and follows no symlink",  rule_walk),
        ("walk of a missing root is one NotFound",                    rule_walk_missing),
        ("glob matches with ** and skips dot names",                  rule_glob),
        ("a symlink is followed by reads and metadata only",          rule_symlink),
        ("a dangling symlink exists only as itself",                  rule_dangling),
        ("remove and remove_all of a symlink keep its target",        rule_remove_link),
        ("copy follows a symlink and rename moves it",                rule_copy_rename_link),
        ("read_link of a file is EINVAL",                             rule_read_link_file),
        ("a symlink loop is ELOOP",                                   rule_link_loop),
        ("set_mode sets the permission bits",                         rule_set_mode),
        ("metadata answers links, identity and the access time",      rule_metadata_fields),
        ("set_times sets the times metadata reads back",              rule_set_times),
        ("touch makes a missing file and moves its time",             rule_touch),
        ("create_link gives a file a second name",                    rule_create_link),
        ("set_owner keeps the owner a file has",                      rule_set_owner),
        ("disk_usage answers sizes in order",                         rule_disk_usage),
        ("truncate shortens and extends a file",                      rule_truncate),
        ("a file reads and writes at a position",                     rule_file),
        ("a file opened to read refuses writes",                      rule_file_read_only),
        ("open_file of a missing file is NotFound unless it creates", rule_file_missing),
        ("sync keeps the data and sync_dir takes a directory",        rule_sync),
        ("a lock excludes another handle until it is unlocked",       rule_lock_handles),
        ("shared locks share and refuse an exclusive one",            rule_lock_shared),
        ("a lock on a range excludes only that range",                rule_lock_ranges),
        ("closing a file releases its locks",                         rule_lock_close),
        ("a lock that cannot be taken times out",                     rule_lock_timeout),
        ("a file opened to read takes only shared locks",             rule_lock_read_only),
        ("within resolves paths under its directory",                 rule_within),
        ("within refuses paths that lead outside it",                 rule_within_escape),
        ("within of a missing directory is NotFound",                 rule_within_missing),
        ("a Dir reaches what is under its directory",                 rule_dir_reach),
        ("a Dir refuses paths that lead outside it",                  rule_dir_escape),
        ("a closed Dir is Closed and its File stays open",            rule_dir_closed),
        ("a Dir makes fresh temporary files and directories",         rule_dir_temp),
    ]
end

fn rule_replace(dir: String) -> Option<String>
    p = path.join(dir, "a.txt")

    first([
        check("first write",  fs.write_text(p, "abcdef"), Ok(Unit)),
        check("second write", fs.write_text(p, "xy"),     Ok(Unit)),
        check("read",         fs.read_text(p),            Ok("xy")),
    ])
end

fn rule_append(dir: String) -> Option<String>
    p = path.join(dir, "log.txt")

    first([
        check("append to a missing file", fs.write_text(p, "a", mode: WriteMode.Append), Ok(Unit)),
        check("append again",             fs.write_text(p, "b", mode: WriteMode.Append), Ok(Unit)),
        check("read",                     fs.read_text(p),                               Ok("ab")),
    ])
end

fn rule_new(dir: String) -> Option<String>
    p = path.join(dir, "n.txt")

    first([
        check("new on a missing file", fs.write_text(p, "1", mode: WriteMode.New), Ok(Unit)),
        check(
            "new on an existing file",
            fs.write_text(p, "2", mode: WriteMode.New),
            Err(Error.AlreadyExists{path: p}),
        ),
        check("read", fs.read_text(p), Ok("1")),
    ])
end

fn rule_atomic(dir: String) -> Option<String>
    p = path.join(dir, "a.txt")

    first([
        check("write", fs.write_text(p, "old"), Ok(Unit)),
        check("atomic write", fs.write_text(p, "new", mode: WriteMode.ReplaceAtomically), Ok(Unit)),
        check("read", fs.read_text(p), Ok("new")),
        check("listing", names(dir), Ok(["a.txt"])),
    ])
end

fn rule_atomic_failure(dir: String) -> Option<String>
    p = path.join(dir, "a.txt")
    written = fs.write_text(p, "old")

    failed = abandoned_write(p)

    first([
        check("write",                 written,         Ok(Unit)),
        check("a failed atomic write", failed,          Err(Error.TimedOut)),
        check("read",                  fs.read_text(p), Ok("old")),
        check("listing",               names(dir),      Ok(["a.txt"])),
    ])
end

// An atomic write of p that fails after writing part of its contents.
fn abandoned_write(p: String) -> Result<Unit, Error>
    w = fs.create(p, mode: WriteMode.ReplaceAtomically)?
    defer Writer.discard(w)
    Writer.write_text(w, "half")?
    Err(Error.TimedOut)
end

/// The names in dir, in the listing's order.
fn names(dir: String) -> Result<List<String>, Error>
    Result.map(fs.list(dir), fn entries -> entries |> Iter.map(fn e -> e.name) |> Iter.to_list())
end

fn rule_missing_parent(dir: String) -> Option<String>
    missing = path.join(dir, "missing")

    first([
        check(
            "write into a missing directory",
            fs.write_text(path.join(missing, "x.txt"), "x"),
            Err(Error.NotFound{path: missing}),
        ),
        check(
            "create into a missing directory",
            Result.map(fs.create(path.join(missing, "y.txt")), fn _ -> Unit),
            Err(Error.NotFound{path: missing}),
        ),
    ])
end

fn rule_sorted(dir: String) -> Option<String>
    first([
        check("write c", fs.write_text(path.join(dir, "c.txt"), ""), Ok(Unit)),
        check("write a", fs.write_text(path.join(dir, "a.txt"), ""), Ok(Unit)),
        check("make b",  fs.create_dir(path.join(dir, "b")),         Ok(Unit)),
        check("listing", fs.list(dir), Ok([
                Entry{path: path.join(dir, "a.txt"), name: "a.txt", kind: Kind.File},
                Entry{path: path.join(dir, "b"), name: "b", kind: Kind.Directory},
                Entry{path: path.join(dir, "c.txt"), name: "c.txt", kind: Kind.File},
            ])),
    ])
end

fn rule_list_file(dir: String) -> Option<String>
    p = path.join(dir, "f.txt")

    first([
        check("write",       fs.write_text(p, ""), Ok(Unit)),
        check("list a file", fs.list(p),           Err(Error.NotADirectory{path: p})),
        check(
            "list a missing directory",
            fs.list(path.join(dir, "none")),
            Err(Error.NotFound{path: path.join(dir, "none")}),
        ),
    ])
end

fn rule_read_dir(dir: String) -> Option<String>
    first([
        check("read_text of a directory", fs.read_text(dir), Err(Error.IsADirectory{path: dir})),
        check(
            "open of a directory",
            Result.map(fs.open(dir), fn _ -> Unit),
            Err(Error.IsADirectory{path: dir}),
        ),
    ])
end

fn rule_remove_full(dir: String) -> Option<String>
    sub = path.join(dir, "sub")

    first([
        check("make sub", fs.create_dir(sub), Ok(Unit)),
        check("write in sub", fs.write_text(path.join(sub, "x"), ""), Ok(Unit)),
        check("remove sub", fs.remove(sub), Err(Error.DirectoryNotEmpty{path: sub})),
        check("remove its file", fs.remove(path.join(sub, "x")), Ok(Unit)),
        check("remove the empty sub", fs.remove(sub), Ok(Unit)),
    ])
end

fn rule_remove_missing(dir: String) -> Option<String>
    p = path.join(dir, "none")
    check("remove", fs.remove(p), Err(Error.NotFound{path: p}))
end

fn rule_remove_all_missing(dir: String) -> Option<String>
    check("remove_all", fs.remove_all(path.join(dir, "none")), Ok(Unit))
end

fn rule_remove_all(dir: String) -> Option<String>
    tree = path.join(dir, "tree")

    first([
        check("make the tree", fs.create_dir(path.join(tree, "a/b"), parents: True), Ok(Unit)),
        check("write in it",   fs.write_text(path.join(tree, "a/b/c.txt"), "c"),     Ok(Unit)),
        check("remove_all",    fs.remove_all(tree),                                  Ok(Unit)),
        check("exists",        fs.exists(tree),                                      Ok(False)),
    ])
end

fn rule_rename(dir: String) -> Option<String>
    a = path.join(dir, "a.txt")
    b = path.join(dir, "b.txt")

    first([
        check("write a",         fs.write_text(a, "a"), Ok(Unit)),
        check("write b",         fs.write_text(b, "b"), Ok(Unit)),
        check("rename a over b", fs.rename(a, b),       Ok(Unit)),
        check("read b",          fs.read_text(b),       Ok("a")),
        check("listing",         names(dir),            Ok(["b.txt"])),
    ])
end

fn rule_rename_missing(dir: String) -> Option<String>
    p = path.join(dir, "none")
    check("rename", fs.rename(p, path.join(dir, "x")), Err(Error.NotFound{path: p}))
end

fn rule_copy(dir: String) -> Option<String>
    a = path.join(dir, "a.txt")
    b = path.join(dir, "b.txt")

    first([
        check("write a",       fs.write_text(a, "a"),      Ok(Unit)),
        check("write b",       fs.write_text(b, "longer"), Ok(Unit)),
        check("copy a over b", fs.copy(a, b),              Ok(Unit)),
        check("read b",        fs.read_text(b),            Ok("a")),
        check("read a",        fs.read_text(a),            Ok("a")),
    ])
end

fn rule_create_dir(dir: String) -> Option<String>
    deep = path.join(dir, "x/y")

    first([
        check(
            "without parents",
            fs.create_dir(deep),
            Err(Error.NotFound{path: path.join(dir, "x")}),
        ),
        check("with parents", fs.create_dir(deep, parents: True), Ok(Unit)),
        check("with parents again", fs.create_dir(deep, parents: True), Ok(Unit)),
        check("again without parents", fs.create_dir(deep), Err(Error.AlreadyExists{path: deep})),
    ])
end

fn rule_lines(dir: String) -> Option<String>
    p = path.join(dir, "lines.txt")

    first([
        check("write", fs.write_text(p, "one\ntwo\r\n\nlast"), Ok(Unit)),
        check(
            "lines",
            fs.lines(p)
            |> Result.collect(),
            Ok(["one", "two", "", "last"]),
        ),
        check(
            "a missing file",
            fs.lines(path.join(dir, "none"))
            |> Result.collect(),
            Err(Error.NotFound{path: path.join(dir, "none")}),
        ),
    ])
end

fn rule_lines_twice(dir: String) -> Option<String>
    p = path.join(dir, "l.txt")
    each = fs.lines(p)

    first([
        check("write",          fs.write_text(p, "a\nb\n"), Ok(Unit)),
        check("the first line", Iter.first(each),           Some(Ok("a"))),
        check(
            "every line",
            each
            |> Result.collect(),
            Ok(["a", "b"]),
        ),
    ])
end

fn rule_invalid_text(dir: String) -> Option<String>
    p = path.join(dir, "bad.txt")

    first([
        check("write", fs.write(p, bytes_of([104, 105, 10, 255])), Ok(Unit)),
        check("read_text", fs.read_text(p), Err(Error.InvalidText{path: p, offset: 3})),
        check(
            "lines",
            fs.lines(p)
            |> Iter.to_list(),
            [Ok("hi"), Err(Error.InvalidText{path: p, offset: 0})],
        ),
    ])
end

/// Bytes from their values, each 0 to 255.
fn bytes_of(values: List<Int>) -> Bytes
    values
    |> Iter.map(Int.to_byte)
    |> Option.collect()
    |> Option.with_default([])
    |> Bytes.from_list()
end

fn rule_closed(dir: String) -> Option<String>
    p = path.join(dir, "c.txt")

    case (fs.write_text(p, "x"), fs.open(p), fs.create(path.join(dir, "w.txt")))
        (Ok(_), Ok(r), Ok(w)) ->
            first([
                check("close the reader",  Reader.close(r),           Ok(Unit)),
                check("read after close",  Reader.read_line(r),       Err(Error.Closed)),
                check("close it again",    Reader.close(r),           Err(Error.Closed)),
                check("close the writer",  Writer.close(w),           Ok(Unit)),
                check("write after close", Writer.write_text(w, "x"), Err(Error.Closed)),
            ])

        other ->
            Some("setup: ${Debug.inspect(other)}")
    end
end

fn rule_exists(dir: String) -> Option<String>
    p = path.join(dir, "e.txt")

    first([
        check("a missing file", fs.exists(p),         Ok(False)),
        check("write",          fs.write_text(p, ""), Ok(Unit)),
        check("a file",         fs.exists(p),         Ok(True)),
        check("a directory",    fs.exists(dir),       Ok(True)),
    ])
end

fn rule_metadata(dir: String) -> Option<String>
    p = path.join(dir, "m.txt")
    shape = fn p: String -> Result.map(fs.metadata(p), fn m -> "${Debug.inspect(m.kind)} ${m.size}")

    first([
        check("write",  fs.write_text(p, "four"), Ok(Unit)),
        check("a file", shape(p),                 Ok("File 4")),
        check(
            "a directory's kind",
            Result.map(fs.metadata(dir), fn m -> m.kind),
            Ok(Kind.Directory),
        ),
        check(
            "a missing file",
            shape(path.join(dir, "none")),
            Err(Error.NotFound{path: path.join(dir, "none")}),
        ),
    ])
end

/// p with dir and a `/` taken off its front.
fn under(dir: String, p: String) -> String
    String.strip_prefix(p, "${dir}/") |> Option.with_default(p)
end

fn rule_walk(dir: String) -> Option<String>
    tree = path.join(dir, "t")

    walked =
        fn ->
            fs.walk(tree)
            |> Iter.map(fn item -> Result.map(item, fn e -> (under(tree, e.path), e.kind)))
            |> Result.collect()
        end

    first([
        check("make a",        fs.create_dir(path.join(tree, "a"), parents: True),   Ok(Unit)),
        check("write a/x.txt", fs.write_text(path.join(tree, "a/x.txt"), ""),        Ok(Unit)),
        check("write b.txt",   fs.write_text(path.join(tree, "b.txt"), ""),          Ok(Unit)),
        check("link c to a",   fs.create_symlink(path.join(tree, "c"), target: "a"), Ok(Unit)),
        check("the walk", walked(), Ok([
                ("a",       Kind.Directory),
                ("a/x.txt", Kind.File),
                ("b.txt",   Kind.File),
                ("c",       Kind.Symlink),
            ])),
        check(
            "the first entry",
            Iter.first(fs.walk(tree))
            |> Option.map(fn e -> Result.map(e, fn e -> e.name)),
            Some(Ok("a")),
        ),
    ])
end

fn rule_walk_missing(dir: String) -> Option<String>
    none = path.join(dir, "none")

    check(
        "walk",
        fs.walk(none)
        |> Iter.to_list(),
        [Err(Error.NotFound{path: none})],
    )
end

fn rule_glob(dir: String) -> Option<String>
    first([
        check("write a.nomi", fs.write_text(path.join(dir, "a.nomi"), ""), Ok(Unit)),
        check("make sub", fs.create_dir(path.join(dir, "sub/deep"), parents: True), Ok(Unit)),
        check("write sub/b.nomi", fs.write_text(path.join(dir, "sub/b.nomi"), ""), Ok(Unit)),
        check(
            "write sub/deep/c.nomi",
            fs.write_text(path.join(dir, "sub/deep/c.nomi"), ""),
            Ok(Unit),
        ),
        check("write sub/c.txt", fs.write_text(path.join(dir, "sub/c.txt"), ""), Ok(Unit)),
        check("write .h.nomi",   fs.write_text(path.join(dir, ".h.nomi"), ""),   Ok(Unit)),
        check("**/*.nomi", fs.glob(path.join(dir, "**/*.nomi")), Ok([
                path.join(dir, "a.nomi"),
                path.join(dir, "sub/b.nomi"),
                path.join(dir, "sub/deep/c.nomi"),
            ])),
        check("*/*.txt", fs.glob(path.join(dir, "*/*.txt")), Ok([path.join(dir, "sub/c.txt")])),
        check("s?b", fs.glob(path.join(dir, "s?b")), Ok([path.join(dir, "sub")])),
        check("a literal path", fs.glob(path.join(dir, "a.nomi")), Ok([path.join(dir, "a.nomi")])),
        check("under a missing directory", fs.glob(path.join(dir, "none/*")), Ok([])),
    ])
end

fn rule_symlink(dir: String) -> Option<String>
    target = path.join(dir, "t.txt")
    link = path.join(dir, "l")
    kind = fn m: Result<fs.Metadata, Error> -> Result.map(m, fn m -> m.kind)

    first([
        check("write the target", fs.write_text(target, "four"),            Ok(Unit)),
        check("link it",          fs.create_symlink(link, target: "t.txt"), Ok(Unit)),
        check(
            "link it again",
            fs.create_symlink(link, target: "t.txt"),
            Err(Error.AlreadyExists{path: link}),
        ),
        check("read through it",        fs.read_text(link),           Ok("four")),
        check("metadata follows it",    kind(fs.metadata(link)),      Ok(Kind.File)),
        check("link_metadata does not", kind(fs.link_metadata(link)), Ok(Kind.Symlink)),
        check("read_link",              fs.read_link(link),           Ok("t.txt")),
        check(
            "listing",
            fs.list(dir)
            |> Result.map(fn es -> es |> Iter.map(fn e -> e.kind) |> Iter.to_list()),
            Ok([
                Kind.Symlink,
                Kind.File,
            ]),
        ),
        check("write through it", fs.write_text(link, "five!"), Ok(Unit)),
        check("the target",       fs.read_text(target),         Ok("five!")),
    ])
end

fn rule_dangling(dir: String) -> Option<String>
    link = path.join(dir, "d")

    first([
        check("link to nothing", fs.create_symlink(link, target: "none"), Ok(Unit)),
        check("exists",          fs.exists(link),                         Ok(False)),
        check(
            "link_metadata",
            Result.map(fs.link_metadata(link), fn m -> m.kind),
            Ok(Kind.Symlink),
        ),
        check("read", fs.read_text(link), Err(Error.NotFound{path: link})),
        check(
            "into a missing directory",
            fs.create_symlink(path.join(dir, "no/l"), target: "x"),
            Err(Error.NotFound{path: path.join(dir, "no")}),
        ),
    ])
end

fn rule_remove_link(dir: String) -> Option<String>
    target = path.join(dir, "target")
    kept = path.join(target, "x")

    first([
        check("make the target", fs.create_dir(target), Ok(Unit)),
        check("write in it", fs.write_text(kept, "x"), Ok(Unit)),
        check("link one", fs.create_symlink(path.join(dir, "one"), target: "target"), Ok(Unit)),
        check("link two", fs.create_symlink(path.join(dir, "two"), target: "target"), Ok(Unit)),
        check("remove one", fs.remove(path.join(dir, "one")), Ok(Unit)),
        check("remove_all two", fs.remove_all(path.join(dir, "two")), Ok(Unit)),
        check("the target's file", fs.read_text(kept), Ok("x")),
        check("listing", names(dir), Ok(["target"])),
    ])
end

fn rule_copy_rename_link(dir: String) -> Option<String>
    link = path.join(dir, "l")
    copied = path.join(dir, "c.txt")
    moved = path.join(dir, "m")

    first([
        check("write the target", fs.write_text(path.join(dir, "t.txt"), "t"), Ok(Unit)),
        check("link it",          fs.create_symlink(link, target: "t.txt"),    Ok(Unit)),
        check("copy the link",    fs.copy(link, copied),                       Ok(Unit)),
        check(
            "the copy's kind",
            Result.map(fs.link_metadata(copied), fn m -> m.kind),
            Ok(Kind.File),
        ),
        check("the copy",        fs.read_text(copied),   Ok("t")),
        check("rename the link", fs.rename(link, moved), Ok(Unit)),
        check("the moved link",  fs.read_link(moved),    Ok("t.txt")),
        check("listing",         names(dir),             Ok(["c.txt", "m", "t.txt"])),
    ])
end

fn rule_read_link_file(dir: String) -> Option<String>
    p = path.join(dir, "f.txt")

    first([
        check("write", fs.write_text(p, ""), Ok(Unit)),
        check(
            "read_link",
            fs.read_link(p),
            Err(Error.Other{operation: "readlink", path: p, code: "EINVAL"}),
        ),
        check(
            "read_link of nothing",
            fs.read_link(path.join(dir, "none")),
            Err(Error.NotFound{path: path.join(dir, "none")}),
        ),
    ])
end

fn rule_link_loop(dir: String) -> Option<String>
    a = path.join(dir, "a")

    code =
        fn ->
            case fs.read_text(a)
                Err(Error.Other{operation: _, path: _, code:}) -> code
                other -> "${Debug.inspect(other)}"
            end
        end

    first([
        check("link a to b",        fs.create_symlink(a, target: "b"),                   Ok(Unit)),
        check("link b to a",        fs.create_symlink(path.join(dir, "b"), target: "a"), Ok(Unit)),
        check("the code of a read", code(),                                              "ELOOP"),
    ])
end

fn rule_set_mode(dir: String) -> Option<String>
    p = path.join(dir, "m.sh")
    sub = path.join(dir, "shared")
    mode = fn at: String -> Result.map(fs.metadata(at), fn m -> m.mode)
    // Windows ignores the setuid, setgid and sticky bits.
    sticky = if on_a_windows_disk() then 0o777 else 0o1777

    first([
        check("write",               fs.write_text(p, ""),     Ok(Unit)),
        check("set 0o444",           fs.set_mode(p, 0o444),    Ok(Unit)),
        check("read it",             mode(p),                  Ok(0o444)),
        check("set 0o666",           fs.set_mode(p, 0o666),    Ok(Unit)),
        check("read it again",       mode(p),                  Ok(0o666)),
        check("make a directory",    fs.create_dir(sub),       Ok(Unit)),
        check("set the sticky bit",  fs.set_mode(sub, 0o1777), Ok(Unit)),
        check("read the sticky bit", mode(sub),                Ok(sticky)),
        check(
            "a mode out of range",
            fs.set_mode(p, 0o10000),
            Err(Error.Other{operation: "chmod", path: p, code: "EINVAL"}),
        ),
        check(
            "a missing file",
            fs.set_mode(path.join(dir, "none"), 0o600),
            Err(Error.NotFound{path: path.join(dir, "none")}),
        ),
    ])
end

fn rule_metadata_fields(dir: String) -> Option<String>
    p = path.join(dir, "f.txt")
    there = fn field: Result<Option<Int>, Error> -> Result.map(field, Option.is_some)

    first([
        check("write",    fs.write_text(p, "f"),                               Ok(Unit)),
        check("links",    Result.map(fs.metadata(p), fn m -> m.links),         Ok(Some(1))),
        check("a device", there(Result.map(fs.metadata(p), fn m -> m.device)), Ok(True)),
        check("an inode", there(Result.map(fs.metadata(p), fn m -> m.inode)),  Ok(True)),
        check(
            "an access time",
            Result.map(fs.metadata(p), fn m -> Option.is_some(m.accessed)),
            Ok(True),
        ),
    ])
end

fn rule_set_times(dir: String) -> Option<String>
    p = path.join(dir, "t.txt")
    none = path.join(dir, "none")
    modified = Instant.from_seconds(1_000_000_000)
    accessed = Instant.from_seconds(1_100_000_000)
    later = Instant.from_seconds(1_200_000_000)
    times = fn -> Result.map(fs.metadata(p), fn m -> (m.modified, m.accessed))

    first([
        check("write", fs.write_text(p, "t"), Ok(Unit)),
        check(
            "set both",
            fs.set_times(p, modified: Some(modified), accessed: Some(accessed)),
            Ok(Unit),
        ),
        check("read them", times(), Ok((modified, Some(accessed)))),
        check("set the modification time alone", fs.set_times(p, modified: Some(later)), Ok(Unit)),
        check("the access time stays", times(), Ok((later, Some(accessed)))),
        check(
            "a missing file",
            fs.set_times(none, modified: Some(later)),
            Err(Error.NotFound{path: none}),
        ),
    ])
end

fn rule_touch(dir: String) -> Option<String>
    p = path.join(dir, "stamp")
    old = Instant.from_seconds(1_000_000_000)
    moved = fn -> Result.map(fs.metadata(p), fn m -> Instant.is_before(old, m.modified))

    first([
        check("touch a missing file", fs.touch(p),                          Ok(Unit)),
        check("the file",             fs.read_text(p),                      Ok("")),
        check("set an old time",      fs.set_times(p, modified: Some(old)), Ok(Unit)),
        check("touch it again",       fs.touch(p),                          Ok(Unit)),
        check("its time moved",       moved(),                              Ok(True)),
        check("touch a directory",    fs.touch(dir),                        Ok(Unit)),
        check(
            "touch under a missing directory",
            fs.touch(path.join(dir, "no/x")),
            Err(Error.NotFound{path: path.join(dir, "no")}),
        ),
    ])
end

fn rule_create_link(dir: String) -> Option<String>
    a = path.join(dir, "a.txt")
    b = path.join(dir, "b.txt")
    c = path.join(dir, "c.txt")
    sub = path.join(dir, "sub")
    none = path.join(dir, "none")
    links = fn p: String -> Result.map(fs.metadata(p), fn m -> m.links)
    inode = fn p: String -> Result.map(fs.metadata(p), fn m -> m.inode)

    first([
        check("write a", fs.write_text(a, "a"), Ok(Unit)),
        check("link b to a", fs.create_link(b, target: a), Ok(Unit)),
        check("read b", fs.read_text(b), Ok("a")),
        check("a's links", links(a), Ok(Some(2))),
        check("b's inode is a's", inode(b) == inode(a), True),
        check("one file", fs.same_file(a, b), Ok(True)),
        check("write through b", fs.write_text(b, "b"), Ok(Unit)),
        check("read a", fs.read_text(a), Ok("b")),
        check("copy a", fs.copy(a, c), Ok(Unit)),
        check("a copy is another file", fs.same_file(a, c), Ok(False)),
        check("link over a file", fs.create_link(c, target: a), Err(Error.AlreadyExists{path: c})),
        check(
            "link to nothing",
            fs.create_link(path.join(dir, "x"), target: none),
            Err(Error.NotFound{path: none}),
        ),
        check("make sub", fs.create_dir(sub), Ok(Unit)),
        check(
            "link to a directory",
            fs.create_link(path.join(dir, "y"), target: sub),
            Err(Error.PermissionDenied{path: sub}),
        ),
        check("remove a",  fs.remove(a),    Ok(Unit)),
        check("b stays",   fs.read_text(b), Ok("b")),
        check("b's links", links(b),        Ok(Some(1))),
    ])
end

fn rule_set_owner(dir: String) -> Option<String>
    p = path.join(dir, "o.txt")
    none = path.join(dir, "none")
    owner = fn -> Result.map(fs.metadata(p), fn m -> m.owner)

    case (fs.write_text(p, ""), owner())
        (Ok(_), Ok(found)) ->
            // Memory keeps no owner until one is set, and any it is given.
            want = Option.with_default(found, Owner{user_id: 0, group_id: 0})
            set = fn at: String -> fs.set_owner(at, user_id: want.user_id, group_id: want.group_id)

            if on_a_windows_disk() then
                check(
                    "set_owner",
                    set(p),
                    Err(Error.Unsupported{operation: "fs.set_owner", target: "windows"}),
                )
            else
                first([
                    check("set the owner it has", set(p),    Ok(Unit)),
                    check("read it",              owner(),   Ok(Some(want))),
                    check("a missing file",       set(none), Err(Error.NotFound{path: none})),
                    check(
                        "a user past 32 bits",
                        fs.set_owner(p, user_id: 4_294_967_296, group_id: 0),
                        Err(Error.Other{operation: "chown", path: p, code: "EINVAL"}),
                    ),
                ])
            end

        other ->
            Some("setup: ${Debug.inspect(other)}")
    end
end

fn rule_disk_usage(dir: String) -> Option<String>
    none = path.join(dir, "none")

    case fs.disk_usage(dir)
        Err(e) ->
            Some("disk_usage: ${e}")

        Ok(u) ->
            first([
                check("a total",               u.total > 0,           True),
                check("free within the total", u.free <= u.total,     True),
                check("available within free", u.available <= u.free, True),
                check(
                    "a missing path",
                    Result.map(fs.disk_usage(none), fn u -> u.total),
                    Err(Error.NotFound{path: none}),
                ),
            ])
    end
end

fn rule_truncate(dir: String) -> Option<String>
    p = path.join(dir, "t.bin")
    none = path.join(dir, "none")

    first([
        check("write",          fs.write_text(p, "abcdef"), Ok(Unit)),
        check("shorten",        fs.truncate(p, 2),          Ok(Unit)),
        check("read",           fs.read_text(p),            Ok("ab")),
        check("extend",         fs.truncate(p, 4),          Ok(Unit)),
        check("read the zeros", fs.read_text(p),            Ok("ab\u{0}\u{0}")),
        check("a missing file", fs.truncate(none, 0),       Err(Error.NotFound{path: none})),
    ])
end

fn rule_file(dir: String) -> Option<String>
    p = path.join(dir, "f.bin")

    text =
        fn data: Result<Option<Bytes>, Error> ->
            Result.map(data, fn d ->
                Option.map(d, fn d -> Bytes.to_string(d) |> Result.to_option())
            end)
        end

    case fs.open_file(p, access: Access.Create)
        Err(e) ->
            Some("open_file: ${e}")

        Ok(f) ->
            defer File.close_quietly(f)

            first([
                check("write", File.write(f, String.to_bytes("hello")), Ok(Unit)),
                check("position", File.position(f), Ok(5)),
                check("seek", File.seek(f, 0), Ok(Unit)),
                check("read", text(File.read(f, max: 2)), Ok(Some(Some("he")))),
                check("read_at", text(File.read_at(f, 3, max: 10)), Ok(Some(Some("lo")))),
                check("position after read_at", File.position(f), Ok(2)),
                check("write_at past the end", File.write_at(f, 7, String.to_bytes("!")), Ok(Unit)),
                check("size", File.size(f), Ok(8)),
                check("the gap", text(File.read_at(f, 5, max: 3)), Ok(Some(Some("\u{0}\u{0}!")))),
                check("read at the end", File.read_at(f, 8, max: 1), Ok(None)),
                check("truncate", File.truncate(f, 2), Ok(Unit)),
                check("size after truncate", File.size(f), Ok(2)),
                check("close", File.close(f), Ok(Unit)),
                check("close again", File.close(f), Err(Error.Closed)),
                check("read after close", File.read(f), Err(Error.Closed)),
                check("the file", fs.read_text(p), Ok("he")),
            ])
    end
end

fn rule_file_read_only(dir: String) -> Option<String>
    p = path.join(dir, "r.txt")
    written = fs.write_text(p, "abc")

    case fs.open_file(p)
        Err(e) ->
            Some("open_file: ${e}")

        Ok(f) ->
            defer File.close_quietly(f)

            first([
                check("write the file", written, Ok(Unit)),
                check(
                    "write",
                    File.write(f, String.to_bytes("x")),
                    Err(Error.PermissionDenied{path: p}),
                ),
                check("truncate", File.truncate(f, 0), Err(Error.PermissionDenied{path: p})),
                check("close",    File.close(f),       Ok(Unit)),
                check("the file", fs.read_text(p),     Ok("abc")),
            ])
    end
end

fn rule_file_missing(dir: String) -> Option<String>
    p = path.join(dir, "none.bin")
    missing = path.join(dir, "missing")
    opened = fn r: Result<File, Error> -> Result.map(r, fn f -> File.close(f))

    first([
        check("read a missing file", opened(fs.open_file(p)), Err(Error.NotFound{path: p})),
        check(
            "read and write a missing file",
            opened(fs.open_file(p, access: Access.ReadWrite)),
            Err(Error.NotFound{path: p}),
        ),
        check(
            "create into a missing directory",
            opened(fs.open_file(path.join(missing, "x"), access: Access.Create)),
            Err(Error.NotFound{path: missing}),
        ),
        check("open a directory", opened(fs.open_file(dir)), Err(Error.IsADirectory{path: dir})),
        check("create", opened(fs.open_file(p, access: Access.Create)), Ok(Ok(Unit))),
        check("the new file", fs.read_text(p), Ok("")),
    ])
end

fn rule_sync(dir: String) -> Option<String>
    p = path.join(dir, "s.txt")
    missing = path.join(dir, "none")

    case fs.open_file(p, access: Access.Create)
        Err(e) ->
            Some("open_file: ${e}")

        Ok(f) ->
            defer File.close_quietly(f)

            first([
                check("write", File.write(f, String.to_bytes("kept")), Ok(Unit)),
                check("sync", File.sync(f), Ok(Unit)),
                check("sync_data", File.sync_data(f), Ok(Unit)),
                check("close", File.close(f), Ok(Unit)),
                check("sync after close", File.sync(f), Err(Error.Closed)),
                check("the file", fs.read_text(p), Ok("kept")),
                check("sync_dir", fs.sync_dir(dir), Ok(Unit)),
                check("sync_dir of a file", fs.sync_dir(p), Err(Error.NotADirectory{path: p})),
                check(
                    "sync_dir of a missing path",
                    fs.sync_dir(missing),
                    Err(Error.NotFound{path: missing}),
                ),
            ])
    end
end

/// Calls body with two handles on the file p, made when it is missing, each
/// open to read and write.
fn on_two_handles(p: String, body: (File, File) -> Option<String>) -> Option<String>
    case fs.open_file(p, access: Access.Create)
        Err(e) ->
            Some("open_file: ${e}")

        Ok(a) ->
            defer File.close_quietly(a)

            case fs.open_file(p, access: Access.ReadWrite)
                Err(e) ->
                    Some("open_file again: ${e}")

                Ok(b) ->
                    defer File.close_quietly(b)
                    body(a, b)
            end
    end
end

fn rule_lock_handles(dir: String) -> Option<String>
    on_two_handles(path.join(dir, "db"), fn a, b ->
        first([
            check("exclusive", fs.try_lock(a, LockMode.Exclusive), Ok(LockAttempt.Acquired)),
            check("shared beside it", fs.try_lock(b, LockMode.Shared), Ok(LockAttempt.Busy)),
            check("exclusive beside it", fs.try_lock(b, LockMode.Exclusive), Ok(LockAttempt.Busy)),
            check("unlock", fs.unlock(a), Ok(Unit)),
            check(
                "exclusive after the unlock",
                fs.try_lock(b, LockMode.Exclusive),
                Ok(LockAttempt.Acquired),
            ),
        ])
    end)
end

fn rule_lock_shared(dir: String) -> Option<String>
    on_two_handles(path.join(dir, "db"), fn a, b ->
        first([
            check("shared",           fs.try_lock(a, LockMode.Shared), Ok(LockAttempt.Acquired)),
            check("shared beside it", fs.try_lock(b, LockMode.Shared), Ok(LockAttempt.Acquired)),
            check(
                "exclusive beside a shared one",
                fs.try_lock(a, LockMode.Exclusive),
                Ok(LockAttempt.Busy),
            ),
        ])
    end)
end

fn rule_lock_ranges(dir: String) -> Option<String>
    on_two_handles(path.join(dir, "db"), fn a, b ->
        first([
            check(
                "the first ten bytes",
                fs.try_lock(a, LockMode.Exclusive, length: Some(10)),
                Ok(LockAttempt.Acquired),
            ),
            check(
                "the next ten",
                fs.try_lock(b, LockMode.Exclusive, start: 10, length: Some(10)),
                Ok(LockAttempt.Acquired),
            ),
            check(
                "bytes across both",
                fs.try_lock(b, LockMode.Shared, start: 5, length: Some(10)),
                Ok(LockAttempt.Busy),
            ),
            check(
                "every byte past the end",
                fs.try_lock(a, LockMode.Exclusive, start: 1000),
                Ok(LockAttempt.Acquired),
            ),
            check(
                "a byte among them",
                fs.try_lock(b, LockMode.Shared, start: 2000, length: Some(1)),
                Ok(LockAttempt.Busy),
            ),
        ])
    end)
end

fn rule_lock_close(dir: String) -> Option<String>
    on_two_handles(path.join(dir, "db"), fn a, b ->
        first([
            check("exclusive", fs.try_lock(a, LockMode.Exclusive), Ok(LockAttempt.Acquired)),
            check("close",     File.close(a),                      Ok(Unit)),
            check(
                "exclusive after the close",
                fs.lock(b, LockMode.Exclusive, timeout: Duration.seconds(1)),
                Ok(Unit),
            ),
        ])
    end)
end

fn rule_lock_timeout(dir: String) -> Option<String>
    on_two_handles(path.join(dir, "db"), fn a, b ->
        first([
            check("exclusive", fs.lock(a, LockMode.Exclusive), Ok(Unit)),
            check(
                "a wait that runs out",
                fs.lock(b, LockMode.Shared, timeout: Duration.milliseconds(20)),
                Err(Error.TimedOut),
            ),
            check(
                "no wait",
                fs.lock(b, LockMode.Shared, timeout: Duration.nanoseconds(0)),
                Err(Error.TimedOut),
            ),
        ])
    end)
end

fn rule_lock_read_only(dir: String) -> Option<String>
    p = path.join(dir, "r.db")
    written = fs.write_text(p, "")

    case fs.open_file(p)
        Err(e) ->
            Some("open_file: ${e}")

        Ok(f) ->
            defer File.close_quietly(f)

            first([
                check("write the file", written, Ok(Unit)),
                check(
                    "exclusive",
                    fs.try_lock(f, LockMode.Exclusive),
                    Err(Error.PermissionDenied{path: p}),
                ),
                check("shared", fs.try_lock(f, LockMode.Shared), Ok(LockAttempt.Acquired)),
            ])
    end
end

fn rule_within(dir: String) -> Option<String>
    site = path.join(dir, "site")

    inside =
        fn ->
            fs.within(site, fn ->
                fs.write_text("new.txt", "n")?
                fs.create_dir("sub")?

                Ok([
                    fs.read_text("index.txt"),
                    fs.read_text(path.join(site, "index.txt")),
                    fs.read_text("sub/../index.txt"),
                    fs.current_dir(),
                    Result.map(fs.list("."), fn es ->
                        es |> Iter.map(fn e -> e.name) |> String.join(",")
                    end),
                ])
            end)
        end

    first([
        check("make site",       fs.create_dir(site),                              Ok(Unit)),
        check("write index.txt", fs.write_text(path.join(site, "index.txt"), "i"), Ok(Unit)),
        check(
            "inside",
            inside(),
            Ok([Ok("i"), Ok("i"), Ok("i"), Ok(site), Ok("index.txt,new.txt,sub")]),
        ),
        check("what it wrote", fs.read_text(path.join(site, "new.txt")), Ok("n")),
    ])
end

fn rule_within_escape(dir: String) -> Option<String>
    site = path.join(dir, "site")
    secret = path.join(dir, "secret.txt")

    escaped =
        fn p: String ->
            Err(
                Error.InvalidPath{
                    path:   p,
                    reason: "the path leads outside the directory it is confined to",
                }
            )
        end

    setup = [
        check("make site",        fs.create_dir(site),        Ok(Unit)),
        check("write the secret", fs.write_text(secret, "s"), Ok(Unit)),
        check(
            "link out",
            fs.create_symlink(path.join(site, "out"), target: "../secret.txt"),
            Ok(Unit),
        ),
        check(
            "link out absolutely",
            fs.create_symlink(path.join(site, "abs"), target: secret),
            Ok(Unit),
        ),
        check("link in", fs.create_symlink(path.join(site, "in"), target: "sub/../out"), Ok(Unit)),
    ]

    inside = fs.within(site, fn ->
        Ok([
            fs.read_text("../secret.txt"),
            fs.read_text("out"),
            fs.read_text("abs"),
            fs.read_text(secret),
            Result.map(fs.write_text("../x.txt", "x"), fn _ -> "written"),
        ])
    end)

    first(setup + [
        check("inside", inside, Ok([
                escaped("../secret.txt"),
                escaped("out"),
                escaped("abs"),
                escaped(secret),
                escaped("../x.txt"),
            ])),
        check("nothing written outside", fs.exists(path.join(dir, "x.txt")), Ok(False)),
        check(
            "a temporary directory inside",
            fs.within(site, fs.make_temp_dir),
            Err(Error.Unsupported{operation: "fs.make_temp_dir", target: "fs.within"}),
        ),
    ])
end

fn rule_within_missing(dir: String) -> Option<String>
    none = path.join(dir, "none")
    check("within", fs.within(none, fn -> Ok(Unit)), Err(Error.NotFound{path: none}))
end

/// Calls body with a Dir of `<dir>/site`, made holding `index.txt`, after
/// the checks setup makes once the directory is there.
fn on_site(
    dir:   String,
    setup: () -> List<Option<String>>,
    body:  (Dir) -> Option<String>,
) -> Option<String>
    site = path.join(dir, "site")

    made = first([
        check("make site",       fs.create_dir(site),                              Ok(Unit)),
        check("write index.txt", fs.write_text(path.join(site, "index.txt"), "i"), Ok(Unit)),
    ])

    if Option.is_some(made) then return made
    made_too = first(setup())
    if Option.is_some(made_too) then return made_too

    if Option.is_some(made) then return made

    case fs.open_dir(site)
        Err(e) ->
            Some("open_dir: ${e}")

        Ok(d) ->
            defer Dir.close(d)
            body(d)
    end
end

/// What `read` answers in the directory `name` under `d`, opened as a Dir
/// of its own.
fn in_subdir(d: Dir, name: String, read: (Dir) -> Result<String, Error>) -> Result<String, Error>
    sub = Dir.subdir(d, name)?
    defer Dir.close(sub)
    read(sub)
end

fn rule_dir_reach(dir: String) -> Option<String>
    site = path.join(dir, "site")

    names =
        fn listed: Result<List<Entry>, Error> ->
            Result.map(listed, fn es -> es |> Iter.map(fn e -> e.name) |> String.join(","))
        end

    on_site(dir, fn -> [], fn d ->
        first([
            check("read", Dir.read_text(d, "index.txt"), Ok("i")),
            check(
                "read by the absolute path",
                Dir.read_text(d, path.join(site, "index.txt")),
                Ok("i"),
            ),
            check(
                "write under a missing directory",
                Dir.write_text(d, "sub/x.txt", "x"),
                Err(Error.NotFound{path: "sub"}),
            ),
            check("create_dir", Dir.create_dir(d, "sub"),            Ok(Unit)),
            check("write",      Dir.write_text(d, "sub/x.txt", "x"), Ok(Unit)),
            check("rename",     Dir.rename(d, "sub/x.txt", "y.txt"), Ok(Unit)),
            check(
                "a link that stays inside",
                Dir.create_symlink(d, "in", target: "sub/../y.txt"),
                Ok(Unit),
            ),
            check("read through it", Dir.read_text(d, "in"),  Ok("x")),
            check("list",            names(Dir.list(d, ".")), Ok("in,index.txt,sub,y.txt")),
            check(
                "a subdir",
                in_subdir(d, "sub", fn sub ->
                    Dir.write_text(sub, "z.txt", "z")?
                    Dir.read_text(sub, "z.txt")
                end),
                Ok("z"),
            ),
            check("what it wrote, from outside", fs.read_text(path.join(site, "y.txt")), Ok("x")),
            check("and in the subdir", fs.read_text(path.join(site, "sub/z.txt")), Ok("z")),
        ])
    end)
end

fn rule_dir_escape(dir: String) -> Option<String>
    site = path.join(dir, "site")
    secret = path.join(dir, "secret.txt")

    escape =
        fn p: String ->
            Error.InvalidPath{
                path:   p,
                reason: "the path leads outside the directory it is confined to",
            }
        end

    // A Windows disk takes the `..` that follows the link `up` off the
    // path's text before it follows the link, so the path names
    // `sub/secret.txt`, under the directory and missing.
    up_and_out =
        if on_a_windows_disk() then
            Error.NotFound{path: "sub/up/../secret.txt"}
        else
            escape("sub/up/../secret.txt")
        end

    opened = fn r: Result<File, Error> -> Result.map(r, fn f -> File.close(f))
    size = fn r: Result<Metadata, Error> -> Result.map(r, fn m -> m.size)

    setup = fn -> [
        check("write the secret", fs.write_text(secret, "s"), Ok(Unit)),
        check(
            "link out",
            fs.create_symlink(path.join(site, "out"), target: "../secret.txt"),
            Ok(Unit),
        ),
        check(
            "link out absolutely",
            fs.create_symlink(path.join(site, "abs"), target: secret),
            Ok(Unit),
        ),
        check("make sub", fs.create_dir(path.join(site, "sub")), Ok(Unit)),
        check(
            "link out below",
            fs.create_symlink(path.join(site, "sub/out"), target: "../../secret.txt"),
            Ok(Unit),
        ),
        check(
            "link up below",
            fs.create_symlink(path.join(site, "sub/up"), target: ".."),
            Ok(Unit),
        ),
    ]

    on_site(dir, setup, fn d ->
        first([
            check("..", Dir.read_text(d, "../secret.txt"), Err(escape("../secret.txt"))),
            check("a link out", Dir.read_text(d, "out"), Err(escape("out"))),
            check("an absolute link", Dir.read_text(d, "abs"), Err(escape("abs"))),
            check("an absolute path outside", Dir.read_text(d, secret), Err(escape(secret))),
            check("a link out below", Dir.read_text(d, "sub/out"), Err(escape("sub/out"))),
            check("a link up and out", Dir.read_text(d, "sub/up/../secret.txt"), Err(up_and_out)),
            check("a link up and in", Dir.read_text(d, "sub/up/index.txt"), Ok("i")),
            check("write", Dir.write_text(d, "../x.txt", "x"), Err(escape("../x.txt"))),
            check(
                "rename out",
                Dir.rename(d, "index.txt", "../moved.txt"),
                Err(escape("../moved.txt")),
            ),
            check(
                "rename in",
                Dir.rename(d, "../secret.txt", "s.txt"),
                Err(escape("../secret.txt")),
            ),
            check("copy out", Dir.copy(d, "index.txt", "../copy.txt"), Err(escape("../copy.txt"))),
            check("copy in", Dir.copy(d, "out", "copy.txt"), Err(escape("out"))),
            check("remove", Dir.remove(d, "../secret.txt"), Err(escape("../secret.txt"))),
            check("remove_all", Dir.remove_all(d, "../secret.txt"), Err(escape("../secret.txt"))),
            check("metadata", size(Dir.metadata(d, "out")), Err(escape("out"))),
            check("exists", Dir.exists(d, "../secret.txt"), Err(escape("../secret.txt"))),
            check("list the parent", Result.map(Dir.list(d, ".."), List.length), Err(escape(".."))),
            check(
                "set_times through a link out",
                Dir.set_times(d, "out", modified: Some(Instant.from_seconds(0))),
                Err(escape("out")),
            ),
            check("touch outside", Dir.touch(d, "../t.txt"), Err(escape("../t.txt"))),
            check(
                "a hard link to outside",
                Dir.create_link(d, "l.txt", target: "../secret.txt"),
                Err(escape("../secret.txt")),
            ),
            check(
                "a hard link outside",
                Dir.create_link(d, "../l.txt", target: "index.txt"),
                Err(escape("../l.txt")),
            ),
            check(
                "disk_usage of the parent",
                Result.map(Dir.disk_usage(d, ".."), fn u -> u.total),
                Err(escape("..")),
            ),
            check(
                "open_file",
                opened(Dir.open_file(d, "out", access: Access.ReadWrite)),
                Err(escape("out")),
            ),
            check("create_dir", Dir.create_dir(d, "../made"), Err(escape("../made"))),
            check(
                "a link outside",
                Dir.create_symlink(d, "../l", target: "x"),
                Err(escape("../l")),
            ),
            check(
                "subdir of the parent",
                Result.map(Dir.subdir(d, ".."), Dir.close),
                Err(escape("..")),
            ),
            check("the secret as it was",    fs.read_text(secret),                       Ok("s")),
            check("nothing written outside", fs.exists(path.join(dir, "x.txt")),         Ok(False)),
            check("nothing moved outside",   fs.exists(path.join(dir, "moved.txt")),     Ok(False)),
            check("index.txt where it was",  fs.read_text(path.join(site, "index.txt")), Ok("i")),
        ])
    end)
end

/// Whether the rules run on a Windows disk: its temporary directory starts
/// with a drive (`C:/`), where the sandbox's is `/tmp` on every platform.
fn on_a_windows_disk() -> Bool
    temp = fs.temp_dir()
    path.is_absolute(temp) and not String.starts_with(temp, "/")
end

fn rule_dir_closed(dir: String) -> Option<String>
    p = path.join(dir, "kept.txt")

    case fs.open_dir(dir)
        Err(e) ->
            Some("open_dir: ${e}")

        Ok(d) ->
            defer Dir.close(d)

            case Dir.open_file(d, "kept.txt", access: Access.Create)
                Err(e) ->
                    Some("open_file: ${e}")

                Ok(f) ->
                    defer File.close_quietly(f)
                    Dir.close(d)

                    first([
                        check(
                            "read after the close",
                            Dir.read_text(d, "kept.txt"),
                            Err(Error.Closed),
                        ),
                        check(
                            "subdir after the close",
                            Result.map(Dir.subdir(d, "."), Dir.close),
                            Err(Error.Closed),
                        ),
                        check("the file writes", File.write(f, String.to_bytes("k")), Ok(Unit)),
                        check("and closes",      File.close(f),                       Ok(Unit)),
                        check("what it wrote",   fs.read_text(p),                     Ok("k")),
                    ])
            end
    end
end

fn rule_dir_temp(dir: String) -> Option<String>
    case fs.open_dir(dir)
        Err(e) ->
            Some("open_dir: ${e}")

        Ok(d) ->
            defer Dir.close(d)
            a = Dir.make_temp_file(d)
            b = Dir.make_temp_file(d)
            made = Dir.make_temp_dir(d)

            what =
                fn name: Result<String, Error> ->
                    Result.flat_map(name, fn n ->
                        Result.map(Dir.metadata(d, n), fn m -> (m.kind, m.size))
                    end)
                end

            named =
                fn name: Result<String, Error> ->
                    Result.map(name, fn n ->
                        String.starts_with(n, "nomi-") and String.length(n) == 21
                    end)
                end

            first([
                check("two names differ", a != b, True),
                check("a file", what(a), Ok((Kind.File, 0))),
                check("its name", named(a), Ok(True)),
                check("a directory", Result.map(what(made), fn k -> k.first), Ok(Kind.Directory)),
                check("its name", named(made), Ok(True)),
            ])
    end
end
