//# TOML text to and from Nomi values. `Toml.decode` reads a document into
//# its top-level table of `Toml.Value`s, and `Toml.encode` writes one.
//# `Toml.decode_as<T>` reads a document as a typed value through
//# `FromJson`, so a struct with `derive FromJson` reads TOML as it reads
//# JSON. A `Toml` holds TOML source text, and `Toml.text` returns it.
//#
//# ```nomi
//# import
//#     std::json.FromJson
//#     std::toml.Toml
//# end
//#
//# struct Server
//#     host: String
//#     port: Int = 8080
//# end
//#
//# derive FromJson for Server
//#
//# fn server(text: String) -> Result<Server, Toml.Error>
//#     Toml.decode_as(text)
//# end
//# ```
//#
//# A `Toml` literal is a `Toml` in every quote style, never a `Result`. Its
//# text is read as TOML when the program is checked, so text that is not
//# TOML is a compile error. Each `${...}` slot is written for where it
//# stands:
//#
//# - In value position (after `=`, or as an array item), the slot is its
//#   value's TOML: a `String` quoted and escaped, an `Int`, `Float` or `Bool`
//#   as a TOML number or boolean, a `Date`, `Time`, `NaiveDateTime` or
//#   `OffsetDateTime` as a TOML date or time, a `List` as an array, and a
//#   `Map<String, V>` as an inline table.
//# - In key position (at the start of a line, after `.` in a dotted key,
//#   in a `[table]` header, or as an inline table's key), the slot is one
//#   quoted key part.
//# - Anywhere else, inside a string or a comment or next to other text of
//#   the same key or value, the slot is a compile error, since no escaping
//#   makes it safe there.
//#
//# ```nomi
//# import std::toml.Toml
//#
//# fn server(name: String, port: Int, hosts: List<String>) -> Toml
//#     Toml"""
//#     [servers.${name}]
//#     port = ${port}
//#     hosts = ${hosts}
//#     """
//# end
//# ```
//#
//# A slot's value must implement `ToToml`, which turns it into a
//# `Toml.Value`. std implements it for the types above, and a program's own
//# type can implement it too. The literal writes the `Toml.Value` itself, so
//# no impl can put TOML text in the document.

import
    bool.Bool
    calendar.{Date, NaiveDateTime, OffsetDateTime, Time}
    display.Display
    equatable.Equatable
    float.Float
    int.Int
    iter.Iter
    json.{FromJson, Json, ToJson}
    lists.List
    literals.{CheckedLiteral, Fragment, LiteralError}
    maps.Map
    results.Result.{self, Err, Ok}
    strings.String
    toml::host
    unit.Unit
end

/// TOML source text, made by a `Toml"..."` literal. Its own type keeps it
/// apart from an arbitrary `String`, so a function that takes TOML says so.
pub type Toml String

/// Why text is not TOML, and where, for `Toml.decode` and `Toml.parse`.
/// `message` is the reader's, as a compile error at a `Toml"..."` literal
/// of the text words it. `line` and `col` count from 1, for a reader.
/// `offset` is the same place as a code point position counted from 0, and
/// `col` counts code points too.
//! import std::toml.Toml
//!
//! assert Toml.decode("a = 1\nb = = 2") == Err(
//!     Toml.DecodeError{message: "expected value but found '=' instead", line: 2, col: 5, offset: 10}
//! )
//!
//! assert Toml.decode("a = 1\na = 2") |> Result.map_err(&Display.to_string(&1)) == Err(
//!     "toml decode error at line 2, col 1: Key 'a' has already been defined."
//! )
//
pub struct Toml.DecodeError
    message: String
    line:    Int
    col:     Int
    offset:  Int
end

derive Equatable for Toml.DecodeError

impl Display for Toml.DecodeError
    fn to_string(e: Toml.DecodeError) -> String
        "toml decode error at line ${e.line}, col ${e.col}: ${e.message}"
    end
end

/// Why `Toml.decode_as` could not read its text as a `T`: the text is not
/// TOML (`Decode`, with `Toml.decode`'s error), or its document does not
/// have `T`'s shape (`Shape`, with `T.from_json`'s error). `Display` writes
/// the error it holds.
pub enum Toml.Error
    Decode Toml.DecodeError
    Shape Json.ShapeError
end

impl Display for Toml.Error
    fn to_string(e: Toml.Error) -> String
        case e
            Toml.Error.Decode(d) -> Display.to_string(d)
            Toml.Error.Shape(s)  -> Display.to_string(s)
        end
    end
end

impl Toml
    /// Reads TOML text as a document: its top-level table, each key with
    /// its `Toml.Value`, in the order the text gives them. A table, an
    /// inline table and an array of tables' element are each a
    /// `Toml.Value.Table`, and an array of tables is a `Toml.Value.Array`
    /// of them. A date or time is the std::calendar type of its kind:
    /// `Date`, `Time`, `NaiveDateTime` for a local date-time, and
    /// `OffsetDateTime`. Returns `Err` with a `Toml.DecodeError` when the
    /// text is not TOML, and when an offset date-time's offset is past the
    /// ±18:00 an `OffsetDateTime` holds.
    ///
    /// `Toml.encode` writes a document that `decode` reads back as the same
    /// document. The text's layout, comments and number and string forms
    /// are not kept.
    //! import std::toml.Toml
    //!
    //! text = """
    //!     name = "demo"
    //!     released = 2026-05-04
    //!
    //!     [server]
    //!     ports = [8080, 8081]
    //!     """
    //!
    //! assert Toml.decode(text) == Ok({
    //!         "name"     => Toml.Value.String("demo"),
    //!         "released" => Toml.Value.Date(Date"2026-05-04"),
    //!         "server" => Toml.Value.Table({
    //!             "ports" => Toml.Value.Array([Toml.Value.Int(8080), Toml.Value.Int(8081)]),
    //!         }),
    //!     })
    //!
    //! assert Ok(doc) = Toml.decode("b = 1\na = 2")
    //! assert Map.keys(doc) == ["b", "a"]
    //!
    //! assert Toml.decode("at = 07:32") == Ok({"at" => Toml.Value.Time(Time"07:32:00")})
    //!
    //! assert Ok(nan) = Toml.decode("x = nan")
    //! assert [Toml.Value.Float(x)] = Map.values(nan)
    //! assert Float.is_nan(x)
    //!
    //! assert Result.is_err(Toml.decode("title = "))
    //
    pub fn decode(text: String) -> Result<Map<String, Toml.Value>, Toml.DecodeError>
        (nodes, offset, line, col, message) = host.decode(text)

        if offset >= 0 then
            Err(Toml.DecodeError{message:, line:, col:, offset:})
        else
            case read_value(nodes)
                (Toml.Value.Table(document), _) -> Ok(document)
                _ -> unreachable "host.decode lists a document as a table"
            end
        end
    end

    /// Reads TOML text as a `T` in one step: `Toml.decode`, then
    /// `T.from_json` of the document as `ToJson` writes a `Toml.Value`. So
    /// a struct with `derive FromJson` reads its fields from a document's
    /// keys, a `Date`, `Time` or `NaiveDateTime` field from a date or time
    /// of its kind, and an `Instant` field from an offset date-time. An
    /// `Err` is a `Toml.Error`, `Decode` when the text is not TOML and
    /// `Shape` when its document is not a `T`. Give `T` with a binding's
    /// annotation or as `Toml.decode_as<T>(text)`.
    //! import std::toml.Toml
    //!
    //! config = Toml.decode_as<{name: String, port: Int}>("name = 'web'\nport = 80")
    //! assert config == Ok({name: "web", port: 80})
    //!
    //! due: Result<{due: Date}, Toml.Error> = Toml.decode_as("due = 2026-05-04")
    //! assert due == Ok({due: Date"2026-05-04"})
    //!
    //! shape = Toml.decode_as<{port: Int}>("port = 'eighty'") |> Result.map_err(&Display.to_string(&1))
    //! assert shape == Err("port: expected Int, got string")
    //!
    //! syntax = Toml.decode_as<{port: Int}>("port = ") |> Result.map_err(&Display.to_string(&1))
    //! assert syntax == Err("toml decode error at line 1, col 7: unexpected EOF; expected value")
    //
    pub fn decode_as<T>(text: String) -> Result<T, Toml.Error> where T: FromJson
        case Toml.decode(text)
            Ok(document) ->
                case T.from_json(ToJson.to_json(Toml.Value.Table(document)))
                    Ok(value) -> Ok(value)
                    Err(e)    -> Err(Toml.Error.Shape(e))
                end

            Err(e) ->
                Err(Toml.Error.Decode(e))
        end
    end

    /// Writes a document as TOML text: a line for each key in the map's
    /// order, `key = value`, with the key quoted and the value as
    /// `Toml.Value.text` writes it, so a table is an inline table.
    /// `Toml.decode` reads the text back as the same document when each
    /// `Int` in it fits in 64 bits and each offset is within ±18:00.
    //! import std::toml.Toml
    //!
    //! doc = {
    //!     "name"   => Toml.Value.String("demo"),
    //!     "server" => Toml.Value.Table({"port" => Toml.Value.Int(8080)}),
    //! }
    //!
    //! text = Toml.encode(doc)
    //! assert Toml.text(text) == "\"name\" = \"demo\"\n\"server\" = {\"port\" = 8080}\n"
    //! assert Toml.decode(Toml.text(text)) == Ok(doc)
    //
    pub fn encode(document: Map<String, Toml.Value>) -> Toml
        lines =
            document
            |> Iter.map(fn (key, value) -> host.quote(key) + " = " + Toml.Value.text(value) + "\n")
            |> Iter.to_list()

        Toml(String.join(lines, ""))
    end

    /// Reads `text` as TOML, as `Toml.decode` does, and returns the text as
    /// a `Toml`, or what is wrong and where. Use it for TOML text the
    /// program reads while it runs and passes on as text.
    //! import std::toml.Toml
    //!
    //! assert Ok(t) = Toml.parse("title = 'demo'")
    //! assert Toml.text(t) == "title = 'demo'"
    //!
    //! assert Toml.parse("title = ")
    //!     == Err(Toml.DecodeError{message: "unexpected EOF; expected value", line: 1, col: 8, offset: 7})
    //
    pub fn parse(text: String) -> Result<Toml, Toml.DecodeError>
        Toml.decode(text) |> Result.map(fn _ -> Toml(text))
    end

    /// Returns the literal TOML text.
    //! assert Toml.text(
    //!     Toml"""
    //!     [module]
    //!     name = "demo"
    //!     """
    //! ) == """
    //!     [module]
    //!     name = "demo"
    //!     """
    //!
    //! assert Toml.text(Toml"title = 'demo'") == "title = 'demo'"
    //
    pub fn text(source: Toml) -> String
        Toml(raw) = source
        raw
    end
end

/// A TOML value, which `ToToml` makes and a `Toml"..."` literal writes. The
/// literal writes each kind itself, so a value cannot hold TOML text: a
/// `String` is quoted and escaped wherever it sits, and a `Table`'s keys are
/// quoted keys.
///
/// `Int` is written as its decimal digits. TOML integers are 64-bit, so a
/// reader may refuse an `Int` outside that range. `Table` is an inline
/// table, `{"a" = 1, "b" = 2}`, its keys in the map's order.
//! import std::toml.Toml
//!
//! v = Toml.Value.Array([Toml.Value.Int(1), Toml.Value.String("a\"b")])
//! assert Toml.Value.text(v) == "[1, \"a\\\"b\"]"
//!
//! t = Toml.Value.Table({"x y" => Toml.Value.Int(1)})
//! assert Toml.Value.text(t) == "{\"x y\" = 1}"
//
pub enum Toml.Value
    String String
    Int Int
    Float Float
    Bool Bool
    Date Date
    Time Time
    NaiveDateTime NaiveDateTime
    OffsetDateTime OffsetDateTime
    Array List<Toml.Value>
    Table Map<String, Toml.Value>
end

derive Equatable for Toml.Value

impl Toml.Value
    /// The value as TOML, as a `Toml"..."` literal writes it where a slot
    /// stands for a value.
    pub fn text(value: Toml.Value) -> String
        case value
            .String(s) ->
                host.quote(s)

            .Int(n) ->
                "${n}"

            .Float(x) ->
                host.float(x)

            .Bool(b) ->
                if b then "true" else "false"

            .Date(d) ->
                "${d}"

            .Time(t) ->
                "${t}"

            .NaiveDateTime(t) ->
                "${t}"

            .OffsetDateTime(t) ->
                "${t}"

            .Array(items) ->
                texts =
                    items
                    |> Iter.map(fn item -> Toml.Value.text(item))
                    |> Iter.to_list()

                "[" + String.join(texts, ", ") + "]"

            .Table(entries) ->
                pairs =
                    entries
                    |> Iter.map(fn (k, v) -> host.quote(k) + " = " + Toml.Value.text(v))
                    |> Iter.to_list()

                "{" + String.join(pairs, ", ") + "}"
        end
    end
end

impl ToJson for Toml.Value
    /// The value as JSON: a string, number, boolean, array or table as
    /// itself, a `Table` as an object, and a date or time as the text its
    /// type's `FromJson` reads: a `Date`, `Time` or `NaiveDateTime` as its
    /// ISO 8601 text, and an `OffsetDateTime` as RFC 3339 text, which
    /// `Instant` reads. `Toml.decode_as` reads a document through it, and
    /// `Json.to_dynamic` of it reads one with `Dynamic`'s accessors.
    //! import std::toml.Toml
    //!
    //! value = Toml.Value.Table({
    //!     "on" => Toml.Value.Date(Date"2026-05-04"),
    //!     "at" => Toml.Value.OffsetDateTime(OffsetDateTime"2026-05-04T09:30:00+02:00"),
    //!     "n"  => Toml.Value.Array([Toml.Value.Int(1), Toml.Value.Float(2.5)]),
    //! })
    //!
    //! assert ToJson.to_json(value) == Json.Obj{
    //!     "on" => Json.String("2026-05-04"),
    //!     "at" => Json.String("2026-05-04T09:30:00+02:00"),
    //!     "n"  => Json.Arr([Json.Int(1), Json.Float(2.5)]),
    //! }
    //
    fn to_json(value: Toml.Value) -> Json
        case value
            .String(s) ->
                Json.String(s)

            .Int(n) ->
                Json.Int(n)

            .Float(x) ->
                Json.Float(x)

            .Bool(b) ->
                Json.Bool(b)

            .Date(d) ->
                ToJson.to_json(d)

            .Time(t) ->
                ToJson.to_json(t)

            .NaiveDateTime(t) ->
                ToJson.to_json(t)

            .OffsetDateTime(t) ->
                Json.String("${t}")

            .Array(items) ->
                Json.Arr(
                    items
                    |> Iter.map(fn item -> ToJson.to_json(item))
                    |> Iter.to_list()
                )

            .Table(entries) ->
                Json.Obj(Map.map_values(entries, fn item -> ToJson.to_json(item)))
        end
    end
end

// One value from the front of `nodes`, host.decode's listing of a
// document, and the nodes after it.
fn read_value(nodes: List<String>) -> (Toml.Value, List<String>)
    case nodes
        ["string", s, ..rest] -> (Toml.Value.String(s), rest)
        ["int", n, ..rest] -> (Toml.Value.Int(String.to_int(n)!), rest)
        ["float", x, ..rest] -> (Toml.Value.Float(read_float(x)), rest)
        ["bool", b, ..rest] -> (Toml.Value.Bool(b == "true"), rest)
        ["date", d, ..rest] -> (Toml.Value.Date(Date.parse(d)!), rest)
        ["time", t, ..rest] -> (Toml.Value.Time(Time.parse(t)!), rest)
        ["naive", t, ..rest] -> (Toml.Value.NaiveDateTime(NaiveDateTime.parse(t)!), rest)
        ["offset", t, ..rest] -> (Toml.Value.OffsetDateTime(OffsetDateTime.parse(t)!), rest)
        ["array", n, ..rest] -> read_items(String.to_int(n)!, rest, [])
        ["table", n, ..rest] -> read_entries(String.to_int(n)!, rest, {})
        _ -> unreachable "host.decode lists each value as its kind and then its text or count"
    end
end

// The next `count` values of `nodes` as an array, after the items in
// `items`, which are in reverse.
fn read_items(
    count: Int,
    nodes: List<String>,
    items: List<Toml.Value>,
) -> (Toml.Value, List<String>)
    if count <= 0 then
        (Toml.Value.Array(Iter.reverse(items)), nodes)
    else
        (item, rest) = read_value(nodes)
        read_items(count - 1, rest, [item, ..items])
    end
end

// The next `count` keys and values of `nodes` as a table, after the entries
// in `entries`.
fn read_entries(
    count:   Int,
    nodes:   List<String>,
    entries: Map<String, Toml.Value>,
) -> (Toml.Value, List<String>)
    if count <= 0 then
        (Toml.Value.Table(entries), nodes)
    else
        case nodes
            [key, ..after] ->
                (value, rest) = read_value(after)
                read_entries(count - 1, rest, Map.put(entries, key, value))

            [] ->
                unreachable "host.decode lists each table entry's key"
        end
    end
end

// A float as host.float writes it.
fn read_float(text: String) -> Float
    case text
        "inf"  -> Float.positive_infinity()
        "-inf" -> Float.negative_infinity()
        "nan"  -> Float.nan()
        _      -> String.to_float(text)!
    end
end

/// A value a `Toml"..."` slot can hold. `to_toml` returns the value as a
/// `Toml.Value`, which the literal writes where the slot stands for a value,
/// and quotes as one key where it stands for a key.
///
/// A program's own type implements it by returning a `Toml.Value`, often
/// another `ToToml`'s:
///
/// ```nomi
/// impl ToToml for Port
///     fn to_toml(port: Port) -> Toml.Value
///         ToToml.to_toml(port.number)
///     end
/// end
/// ```
///
/// No impl can write TOML text. The literal writes every `Toml.Value`
/// itself, quoting and escaping each string and key, so a slot cannot add a
/// key or break the document's structure.
//! import std::toml.{ToToml, Toml}
//!
//! assert ToToml.to_toml("a\"b") == Toml.Value.String("a\"b")
//! assert ToToml.to_toml([1, 2]) == Toml.Value.Array([Toml.Value.Int(1), Toml.Value.Int(2)])
//! assert ToToml.to_toml({"n" => 2.0}) == Toml.Value.Table({"n" => Toml.Value.Float(2.0)})
//
pub interface ToToml
    fn to_toml(value: self) -> Toml.Value
end

impl ToToml for Toml.Value
    /// The value itself.
    fn to_toml(value: Toml.Value) -> Toml.Value
        value
    end
end

impl ToToml for String
    /// A basic string: `"` and `\` escaped, and every control character
    /// written as an escape.
    fn to_toml(value: String) -> Toml.Value
        Toml.Value.String(value)
    end
end

impl ToToml for Int
    /// Its decimal digits. TOML integers are 64-bit, so a reader may refuse
    /// an `Int` outside that range.
    fn to_toml(value: Int) -> Toml.Value
        Toml.Value.Int(value)
    end
end

impl ToToml for Float
    /// The shortest text that reads back as the value, with `.0` when it
    /// would read as an integer; `inf`, `-inf` and `nan` for those.
    fn to_toml(value: Float) -> Toml.Value
        Toml.Value.Float(value)
    end
end

impl ToToml for Bool
    fn to_toml(value: Bool) -> Toml.Value
        Toml.Value.Bool(value)
    end
end

impl ToToml for Date
    /// A local date, `2026-05-04`.
    fn to_toml(value: Date) -> Toml.Value
        Toml.Value.Date(value)
    end
end

impl ToToml for Time
    /// A local time, `09:30:00`.
    fn to_toml(value: Time) -> Toml.Value
        Toml.Value.Time(value)
    end
end

impl ToToml for NaiveDateTime
    /// A local date-time, `2026-05-04T09:30:00`.
    fn to_toml(value: NaiveDateTime) -> Toml.Value
        Toml.Value.NaiveDateTime(value)
    end
end

impl ToToml for OffsetDateTime
    /// An offset date-time, `2026-05-04T09:30:00+02:00`.
    fn to_toml(value: OffsetDateTime) -> Toml.Value
        Toml.Value.OffsetDateTime(value)
    end
end

impl ToToml for List<T> where T: ToToml
    /// An array of its items' values.
    fn to_toml(value: List<T>) -> Toml.Value
        items =
            value
            |> Iter.map(fn item -> ToToml.to_toml(item))
            |> Iter.to_list()

        Toml.Value.Array(items)
    end
end

impl ToToml for Map<String, V> where V: ToToml
    /// An inline table, each key quoted, in the map's order.
    fn to_toml(value: Map<String, V>) -> Toml.Value
        Toml.Value.Table(Map.map_values(value, fn item -> ToToml.to_toml(item)))
    end
end

impl CheckedLiteral<ToToml, Toml> for Toml
    /// A `Toml` literal is checked when the program is checked: its text,
    /// with a stand-in for each slot, must be TOML, and each slot must stand
    /// for a whole key or value. In value position a slot is its value's
    /// TOML; in key position it is one quoted key part.
    //! import std::toml.Toml
    //!
    //! name = "web 1"
    //! port = 8080
    //! tags = ["a", "b"]
    //!
    //! t = Toml"""
    //!     [servers.${name}]
    //!     port = ${port}
    //!     tags = ${tags}
    //!     """
    //!
    //! assert Toml.text(t) == """
    //!     [servers."web 1"]
    //!     port = 8080
    //!     tags = ["a", "b"]
    //!     """
    //!
    //! // A string cannot add a key: its quotes and newline are escaped.
    //! evil = "x\"\nadmin = true"
    //! assert Toml.text(Toml"user = ${evil}") == "user = \"x\\\"\\nadmin = true\""
    //!
    //! // In key position every value is one quoted key.
    //! id = 42
    //! assert Toml.text(Toml"${id} = true") == "\"42\" = true"
    //
    fn check(statics: List<String>) -> Result<Unit, LiteralError>
        (fragment, offset, message) = host.check(statics)

        if fragment < 0 then
            Ok(Unit)
        else
            Err(LiteralError{fragment:, offset:, message:})
        end
    end

    fn build(fragments: List<Fragment<ToToml>>) -> Toml
        statics =
            fragments
            |> Iter.flat_map(fn frag ->
                case frag
                    .Static(s)  -> [s]
                    .Dynamic(_) -> []
                end
            end)
            |> Iter.to_list()

        slots =
            fragments
            |> Iter.flat_map(fn frag ->
                case frag
                    .Static(_)  -> []
                    .Dynamic(v) -> [Toml.Value.text(ToToml.to_toml(v))]
                end
            end)
            |> Iter.to_list()

        Toml(host.build(statics, slots))
    end
end
