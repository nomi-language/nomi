//# The Go-backed half of std::xml: a reader of XML tokens over a
//# `Reader`, and the escaping and name check its writer uses
//# (internal/stdxml, over Go's encoding/xml). It is internal; a program
//# imports std::xml.

import
    bool.Bool
    int.Int
    io.{Error, Reader}
    lists.List
    strings.String
end

/// An XML token reader over a `Reader`, which reads it a token at a time.
pub host type Tokens

/// A token reader of the XML in `reader`. A DOCTYPE is an error unless
/// `allow_doctype`.
pub host fn open(reader: Reader, allow_doctype: Bool) -> Tokens

/// Reads the next token and returns its kind: 1 a start tag, 2 an end
/// tag, 3 text, 4 a comment, 5 a processing instruction, 6 a DOCTYPE, or
/// 0 once reading stopped (`stopped` says why).
pub host fn next(tokens: Tokens) -> Int

/// The current tag's prefix, local name and namespace.
pub host fn name(tokens: Tokens) -> List<String>

/// The current start tag's attributes, four items each: prefix, local
/// name, namespace and value.
pub host fn attributes(tokens: Tokens) -> List<String>

/// The current start tag's namespace declarations, two items each: the
/// prefix (empty for the default) and the namespace.
pub host fn namespaces(tokens: Tokens) -> List<String>

/// The current text, comment, instruction data or DOCTYPE.
pub host fn text(tokens: Tokens) -> String

/// The current instruction's target.
pub host fn target(tokens: Tokens) -> String

/// The line and column where the current token starts, as `[line,
/// column]`.
pub host fn position(tokens: Tokens) -> List<Int>

/// Why reading stopped, as `[kind, line, column]`: kind 0 at the end (or
/// not yet), 1 a syntax error at the line and column, 2 the reader failed
/// (`failure`).
pub host fn stopped(tokens: Tokens) -> List<Int>

/// The message of the failure `stopped` describes.
pub host fn message(tokens: Tokens) -> String

/// The reader's error, once `stopped` says 2.
pub host fn failure(tokens: Tokens) -> Error

/// `text` as XML character data.
pub host fn escape_text(text: String) -> String

/// `text` as a double-quoted attribute value.
pub host fn escape_attribute(text: String) -> String

/// Whether `text` is an XML name with no colon.
pub host fn is_name(text: String) -> Bool
