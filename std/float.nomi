import {
    add.Add
    bool.Bool
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    debug.Debug
    display.Display
    divide.Divide
    equatable.Equatable
    hashable.Hashable
    int.Int
    maybe.Maybe
    multiply.Multiply
    strings.String
    subtract.Subtract
}

//# Operations on the IEEE 754 double-precision `Float` type: the special
//# values (`nan`, `±infinity`), classification predicates, rounding, and
//# conversion to `Int`. The arithmetic, `Display`/`Debug`/`Equatable`/`Hashable`/
//# `Comparable` impls give `Float` a total order and `==`-consistent hashing
//# (NaN and signed zero normalized).

/// 64-bit floating point number.
pub host type Float

impl Float {
    /// Returns IEEE 754 NaN ("not a number"). Produced by indeterminate
    /// operations like 0.0 / 0.0. NaN propagates through arithmetic and
    /// comparisons; use `Float.nan?` to test for it.
    //! assert Float.nan?(Float.nan())
    //
    pub host fn nan(): Float

    /// Returns IEEE 754 positive infinity. Produced by overflow and by dividing
    /// a positive Float by 0.0. Use `Float.infinite?` to test for it.
    //! assert Float.infinite?(Float.positive_infinity())
    //
    pub host fn positive_infinity(): Float

    /// Returns IEEE 754 negative infinity. Produced by overflow and by dividing
    /// a negative Float by 0.0. Use `Float.infinite?` to test for it.
    //! assert Float.infinite?(Float.negative_infinity())
    //
    pub host fn negative_infinity(): Float

    /// True if x is NaN.
    //! assert Float.nan?(Float.nan())
    //! refute Float.nan?(1.0)
    //
    pub host fn nan?(x: Float): Bool

    /// True if x is +Infinity or -Infinity.
    //! assert Float.infinite?(Float.positive_infinity())
    //! refute Float.infinite?(42.0)
    //
    pub fn infinite?(x: Float): Bool {
        x == Float.positive_infinity() or x == Float.negative_infinity()
    }

    /// True if x is a finite real number — not NaN, not ±Infinity.
    //! assert Float.finite?(42.0)
    //! refute Float.finite?(Float.nan())
    //! refute Float.finite?(Float.negative_infinity())
    //
    pub fn finite?(x: Float): Bool {
        !Float.nan?(x) and !Float.infinite?(x)
    }

    /// Converts a Float to an Int by truncating toward zero. Returns None for
    /// NaN, ±Infinity, and values outside Int64's range (~±9.22e18). Use
    /// `Float.round`/`floor`/`ceil` first if a different rounding rule is needed.
    //! assert Float.to_int(3.7) == Maybe.Some(3)
    //! assert Float.to_int(-3.7) == Maybe.Some(-3)
    //! assert Float.to_int(42.0) == Maybe.Some(42)
    //
    pub host fn to_int(x: Float): Maybe<Int>

    /// Rounds a Float to the nearest integer-valued Float using banker's
    /// rounding (half-to-even). NaN and ±Infinity pass through unchanged.
    //! assert Float.round(3.5) == 4.0
    //! assert Float.round(2.5) == 2.0
    //! assert Float.round(3.7) == 4.0
    //
    pub host fn round(x: Float): Float

    /// Rounds a Float toward -∞. NaN and ±Infinity pass through unchanged.
    //! assert Float.floor(3.7) == 3.0
    //! assert Float.floor(-3.2) == -4.0
    //
    pub host fn floor(x: Float): Float

    /// Rounds a Float toward +∞. NaN and ±Infinity pass through unchanged.
    //! assert Float.ceil(3.2) == 4.0
    //! assert Float.ceil(-3.7) == -3.0
    //
    pub host fn ceil(x: Float): Float

    /// Rounds a Float toward zero. NaN and ±Infinity pass through unchanged.
    //! assert Float.trunc(3.7) == 3.0
    //! assert Float.trunc(-3.7) == -3.0
    //
    pub host fn trunc(x: Float): Float
}

/// Returns the IEEE 754 bit-pattern of `x` reinterpreted as an Int (as if by
/// Go's `math.Float64bits`). Backs the `Hashable` impl. Two Float values
/// that are `==` and not NaN agree on `float_bits`. NaN values can have
/// multiple bit patterns; this returns the actual bits.
host fn float_bits(x: Float): Int

impl Display for Float {
    /// Returns the canonical string form of `x`, matching the runtime
    /// stringifier used by `io.print` and string interpolation. NaN renders as
    /// `NaN`, ±Infinity as `+Inf` / `-Inf`.
    //! assert Float.to_string(3.14) == "3.14"
    //! assert Float.to_string(1e20) == "100000000000000000000.0"
    //
    host fn to_string(x: Float): String
}

impl Add<Float, Float> for Float {
    host fn add(lhs: Float, rhs: Float): Float
}

impl Subtract<Float, Float> for Float {
    host fn subtract(lhs: Float, rhs: Float): Float
}

impl Multiply<Float, Float> for Float {
    host fn multiply(lhs: Float, rhs: Float): Float
}

impl Divide<Float, Float> for Float {
    host fn divide(lhs: Float, rhs: Float): Float
}

impl Debug for Float {
    fn inspect(x: Float): String {
        to_string(x)
    }
}

impl Equatable for Float {
    fn equal?(a: Float, b: Float): Bool {
        a == b
    }
}

impl Hashable for Float {
    // Hash must agree with `==`: equal values hash equally. Two cases need
    // normalizing before taking the raw bits, because `==` treats them as equal
    // but their bit patterns differ: signed zero (`-0.0 == 0.0`) and NaN (which
    // is reflexively equal under Nomi's structural `==`, yet has many encodings).
    fn hash(x: Float): Int {
        if Float.nan?(x) {
            float_bits(Float.nan())
        } else if x == 0.0 {
            0
        } else {
            float_bits(x)
        }
    }
}

impl Comparable for Float {
    // A total order. NaN is placed at the top: all NaNs compare Equal to each
    // other and Greater than every non-NaN Float, including +Infinity. For
    // non-NaN operands the IEEE order applies; -0.0 and +0.0 compare Equal.
    //
    // Float has THREE comparison behaviours, and they do not all agree. Read
    // this before "fixing" any one of them, because two of the three are forced:
    //
    //   `==` / `equal?`   reflexive on NaN    `nan == nan` is True
    //   `compare` (here)  a total order       `compare(nan, nan)` is Equal
    //   `<` `<=` `>` `>=` IEEE                `nan <= nan` is False
    //
    // `==` is reflexive because `impl Hashable for Float` above requires it:
    // equal values must hash equally, so a NaN key would otherwise be
    // unretrievable from a Map. That law is what makes it non-negotiable, not
    // taste. `compare` agrees with `==` so that sorting is deterministic and
    // `Iter.sort` terminates with NaNs collected at one end.
    //
    // The ordering OPERATORS stay IEEE, which is the one place the three
    // disagree: `a == b` does not imply `a <= b` when both are NaN. That is
    // deliberate — IEEE ordering is what numeric code expects, and routing the
    // operators through this function to buy the implication would surprise more
    // often than it helps. Java splits the same three behaviours across three
    // spellings (`==`, `.equals()`, `Double.compare`) for the same reason and
    // with the same hashing motivation; Nomi's `==` is Java's `.equals()`.
    fn compare(a: Float, b: Float): Ordering {
        case {
            Float.nan?(a) and Float.nan?(b) -> Equal
            Float.nan?(a) -> Greater
            Float.nan?(b) -> Less
            a < b -> Less
            a == b -> Equal
            _ -> Greater
        }
    }
}
