import {
    add.Add
    bool.Bool.{self, False, True}
    comparable.Comparable
    comparable.Ordering.{self, Equal, Greater, Less}
    debug.Debug
    decimal.Decimal
    decimal.RoundingMode
    display.Display
    divide.Divide
    equatable.Equatable
    hashable.Hashable
    int.Int
    locale.Locale
    localize.NumberParseError
    maybe.Maybe
    multiply.Multiply
    productable.Productable
    results.Result.{self, Err, Ok}
    strings.String
    subtract.Subtract
    summable.Summable
}

//# Operations on the IEEE 754 double-precision `Float` type: the special
//# values (`nan`, `±infinity`), classification predicates, rounding, powers,
//# roots, logarithms, trigonometry, and conversion to `Int`. The arithmetic, `Display`/`Debug`/`Equatable`/`Hashable`/
//# `Comparable` impls give `Float` a total order and `==`-consistent hashing
//# (NaN and signed zero normalized).

/// 64-bit floating point number.
pub host type Float

impl Float {
    /// Returns IEEE 754 NaN ("not a number"). Produced by indeterminate
    /// operations like 0.0 / 0.0. NaN propagates through arithmetic and
    /// comparisons; use `Float.nan?` to test for it.
    //! assert Float.nan?(Float.nan())
    //
    pub host fn nan() -> Float

    /// Returns IEEE 754 positive infinity. Produced by overflow and by dividing
    /// a positive Float by 0.0. Use `Float.infinite?` to test for it.
    //! assert Float.infinite?(Float.positive_infinity())
    //
    pub host fn positive_infinity() -> Float

    /// Returns IEEE 754 negative infinity. Produced by overflow and by dividing
    /// a negative Float by 0.0. Use `Float.infinite?` to test for it.
    //! assert Float.infinite?(Float.negative_infinity())
    //
    pub host fn negative_infinity() -> Float

    /// True if x is NaN.
    //! assert Float.nan?(Float.nan())
    //! refute Float.nan?(1.0)
    //
    pub host fn nan?(x: Float) -> Bool

    /// True if x is +Infinity or -Infinity.
    //! assert Float.infinite?(Float.positive_infinity())
    //! refute Float.infinite?(42.0)
    //
    pub fn infinite?(x: Float) -> Bool {
        x == Float.positive_infinity() or x == Float.negative_infinity()
    }

    /// True if x is a finite real number — not NaN, not ±Infinity.
    //! assert Float.finite?(42.0)
    //! refute Float.finite?(Float.nan())
    //! refute Float.finite?(Float.negative_infinity())
    //
    pub fn finite?(x: Float) -> Bool {
        !Float.nan?(x) and !Float.infinite?(x)
    }

    /// Converts a Float to an Int by truncating toward zero. Returns None for
    /// NaN, ±Infinity, and values outside Int64's range (~±9.22e18). Use
    /// `Float.round`/`floor`/`ceil` first if a different rounding rule is needed.
    //! assert Float.to_int(3.7) == Maybe.Some(3)
    //! assert Float.to_int(-3.7) == Maybe.Some(-3)
    //! assert Float.to_int(42.0) == Maybe.Some(42)
    //
    pub host fn to_int(x: Float) -> Maybe<Int>

    /// Converts a Float to a Decimal at exactly `scale` fractional digits,
    /// rounding the Float's exact binary value with `mode`. The scale and
    /// mode are required so it never hands back `0.1000…0055` silently.
    /// Returns None for NaN and ±Infinity. `RoundingMode.Unnecessary` traps
    /// when rounding would lose information.
    //! assert Float.to_decimal(0.1, 2, RoundingMode.HalfEven) == Maybe.Some(0.10d)
    //! assert Float.to_decimal(3.14159, 2, RoundingMode.Floor) == Maybe.Some(3.14d)
    //
    pub host fn to_decimal(x: Float, scale: Int, mode: RoundingMode) -> Maybe<Decimal>

    /// Rounds `x` to `scale` digits after the decimal point by `mode`:
    /// `Float.round(x)` is the nearest integer-valued Float, half to even
    /// (banker's rounding), and a negative scale rounds to tens, hundreds
    /// and so on. The modes are `Decimal.round`'s, and `Unnecessary` traps
    /// when rounding would change the value. NaN and ±Infinity pass through
    /// unchanged, and a result of zero keeps `x`'s sign.
    ///
    /// A Float is binary, so most decimal fractions are not exactly one:
    /// `2.675` is 2.67499999999999982236431605997495353221893310546875, which
    /// rounds to `2.67` at scale 2 even under `HalfUp`. The rounding is of
    /// that exact value, and the answer is the Float nearest the rounded
    /// decimal, so `Float.round(0.125, 2)` prints `0.12` but is not exactly
    /// 0.12 either. Round a `Decimal` when the decimal digits must be exact.
    //! import std/decimal.RoundingMode
    //!
    //! assert Float.round(3.5) == 4.0
    //! assert Float.round(2.5) == 2.0
    //! assert Float.round(3.7) == 4.0
    //! assert Float.round(3.14159, 2) == 3.14
    //! assert Float.round(1234.5, -2) == 1200.0
    //! assert Float.round(2.5, 0, RoundingMode.HalfUp) == 3.0
    //! assert Float.round(2.675, 2, RoundingMode.HalfUp) == 2.67
    //! assert Float.round(-0.4) == 0.0
    //
    pub fn round(x: Float, scale: Int = 0, mode: RoundingMode = RoundingMode.HalfEven) -> Float {
        float_round(x, scale, mode)
    }

    /// Rounds a Float toward -∞. NaN and ±Infinity pass through unchanged.
    //! assert Float.floor(3.7) == 3.0
    //! assert Float.floor(-3.2) == -4.0
    //
    pub host fn floor(x: Float) -> Float

    /// Rounds a Float toward +∞. NaN and ±Infinity pass through unchanged.
    //! assert Float.ceil(3.2) == 4.0
    //! assert Float.ceil(-3.7) == -3.0
    //
    pub host fn ceil(x: Float) -> Float

    /// Rounds a Float toward zero. NaN and ±Infinity pass through unchanged.
    //! assert Float.trunc(3.7) == 3.0
    //! assert Float.trunc(-3.7) == -3.0
    //
    pub host fn trunc(x: Float) -> Float

    /// Returns |x|, with the sign bit cleared: `-0.0` gives `0.0`, either
    /// infinity gives +Infinity, and NaN gives NaN.
    //! assert Float.abs(-1.5) == 1.5
    //! assert Float.to_string(Float.abs(-0.0)) == "0.0"
    //! assert Float.abs(Float.negative_infinity()) == Float.positive_infinity()
    //! assert Float.nan?(Float.abs(Float.nan()))
    //
    pub fn abs(x: Float) -> Float {
        if float_bits(x) < 0 { -x } else { x }
    }

    /// Returns the sign of `x` as -1, 0, or +1. Both zeros give 0, and so does
    /// NaN, which is neither less than nor greater than zero; test for it with
    /// `Float.nan?` first when it must be told apart from zero.
    //! assert Float.sign(-1.5) == -1
    //! assert Float.sign(-0.0) == 0
    //! assert Float.sign(Float.positive_infinity()) == 1
    //! assert Float.sign(Float.nan()) == 0
    //
    pub fn sign(x: Float) -> Int {
        case {
            x < 0.0 -> -1
            x > 0.0 -> 1
            _ -> 0
        }
    }

    /// Returns the lesser of `a` and `b`: NaN if either is NaN, and `-0.0` as
    /// the lesser of the two zeros (IEEE 754-2019 `minimum`). Other ties return
    /// `a`.
    //! assert Float.min(1.5, -2.0) == -2.0
    //! assert Float.to_string(Float.min(0.0, -0.0)) == "-0.0"
    //! assert Float.nan?(Float.min(Float.nan(), 1.0))
    //
    pub fn min(a: Float, b: Float) -> Float {
        case {
            Float.nan?(a) -> a
            Float.nan?(b) -> b
            a < b -> a
            a > b -> b
            // Equal, so either the same value or the two zeros.
            float_bits(b) < 0 -> b
            _ -> a
        }
    }

    /// Returns the greater of `a` and `b`: NaN if either is NaN, and `0.0` as
    /// the greater of the two zeros (IEEE 754-2019 `maximum`). Other ties
    /// return `a`.
    //! assert Float.max(1.5, -2.0) == 1.5
    //! assert Float.to_string(Float.max(-0.0, 0.0)) == "0.0"
    //! assert Float.nan?(Float.max(1.0, Float.nan()))
    //
    pub fn max(a: Float, b: Float) -> Float {
        case {
            Float.nan?(a) -> a
            Float.nan?(b) -> b
            a > b -> a
            a < b -> b
            // Equal, so either the same value or the two zeros.
            float_bits(a) < 0 -> b
            _ -> a
        }
    }

    /// `x` raised to the power `y`, with IEEE 754's answers at the edges, as
    /// Go's `math.Pow` gives them: `Float.pow(x, 0.0)` and
    /// `Float.pow(1.0, y)` are `1.0` for every `x` and `y`, NaN included; a
    /// negative `x` to a `y` that is not a whole number is NaN; `0.0` to a
    /// negative `y` is +Infinity; and a result past the Float range is
    /// ±Infinity. `Int.pow` is the exact power of two Ints.
    //! assert Float.pow(2.0, 10.0) == 1024.0
    //! assert Float.pow(4.0, 0.5) == 2.0
    //! assert Float.pow(Float.nan(), 0.0) == 1.0
    //! assert Float.nan?(Float.pow(-8.0, 1.0 / 3.0))
    //! assert Float.pow(0.0, -1.0) == Float.positive_infinity()
    //
    pub host fn pow(x: Float, y: Float) -> Float

    /// The square root of `x`: NaN for a negative `x`, `-0.0` for `-0.0`,
    /// and +Infinity for +Infinity.
    //! assert Float.sqrt(2.25) == 1.5
    //! assert Float.nan?(Float.sqrt(-1.0))
    //! assert Float.to_string(Float.sqrt(-0.0)) == "-0.0"
    //
    pub host fn sqrt(x: Float) -> Float

    /// e raised to the power `x`: +Infinity past the Float range, `0.0`
    /// below it, and `0.0` for -Infinity.
    //! assert Float.exp(0.0) == 1.0
    //! assert Float.exp(1000.0) == Float.positive_infinity()
    //! assert Float.exp(Float.negative_infinity()) == 0.0
    //
    pub host fn exp(x: Float) -> Float

    /// The natural logarithm of `x`, to base e: -Infinity for `0.0`, NaN
    /// for a negative `x`, and +Infinity for +Infinity.
    //! assert Float.log(1.0) == 0.0
    //! assert Float.log(Float.exp(2.0)) == 2.0
    //! assert Float.log(0.0) == Float.negative_infinity()
    //! assert Float.nan?(Float.log(-1.0))
    //
    pub host fn log(x: Float) -> Float

    /// The base-2 logarithm of `x`, exact at a power of two, with
    /// `Float.log`'s answers at `0.0`, a negative `x` and the infinities.
    //! assert Float.log2(8.0) == 3.0
    //! assert Float.log2(0.5) == -1.0
    //
    pub host fn log2(x: Float) -> Float

    /// The base-10 logarithm of `x`, with `Float.log`'s answers at `0.0`, a
    /// negative `x` and the infinities.
    //! assert Float.log10(1000.0) == 3.0
    //! assert Float.log10(0.0) == Float.negative_infinity()
    //
    pub host fn log10(x: Float) -> Float

    /// The sine of the angle `x` in radians. NaN for an infinity or NaN.
    //! assert Float.sin(0.0) == 0.0
    //! assert Float.sin(Float.atan2(1.0, 0.0)) == 1.0
    //! assert Float.nan?(Float.sin(Float.positive_infinity()))
    //
    pub host fn sin(x: Float) -> Float

    /// The cosine of the angle `x` in radians. NaN for an infinity or NaN.
    //! assert Float.cos(0.0) == 1.0
    //! assert Float.cos(Float.atan2(0.0, -1.0)) == -1.0
    //
    pub host fn cos(x: Float) -> Float

    /// The tangent of the angle `x` in radians. NaN for an infinity or NaN.
    //! assert Float.tan(0.0) == 0.0
    //! assert Float.nan?(Float.tan(Float.negative_infinity()))
    //
    pub host fn tan(x: Float) -> Float

    /// The angle in radians, from -π to π, between the positive x axis and
    /// the point (`x`, `y`); note that `y` comes first, as in C, Go and
    /// Python. The quadrant comes from both signs, so
    /// `Float.atan2(0.0, -1.0)` is π, and the signed zeros follow IEEE 754:
    /// `Float.atan2(-0.0, -1.0)` is -π. NaN when either is NaN.
    //! assert Float.atan2(0.0, 1.0) == 0.0
    //! assert Float.atan2(1.0, 1.0) * 4.0 == Float.atan2(0.0, -1.0)
    //! assert Float.atan2(-0.0, -1.0) == -Float.atan2(0.0, -1.0)
    //
    pub host fn atan2(y: Float, x: Float) -> Float

    /// `f` as a reader of `locale` writes it, rounded half to even to at
    /// most `max_fraction` digits and padded to at least `min_fraction`
    /// (0 <= min_fraction <= max_fraction <= 100, else a trap). Rounding
    /// works on the shortest decimal that reads back as `f`, so `1.015`
    /// rounds to `1.02`. Infinity and NaN are the locale's symbols.
    //! assert Float.format(1234567.891, Locale`en`) == "1,234,567.891"
    //! assert Float.format(1234567.89, Locale`de`) == "1.234.567,89"
    //! assert Float.format(1.5, Locale`fr`, 2) == "1,50"
    //! assert Float.format(2.5, Locale`en`, 0, 0) == "2"
    //! assert Float.format(-1234.5, Locale`en`, 0, 3, False) == "-1234.5"
    //
    pub fn format(
        f: Float,
        locale: Locale,
        min_fraction: Int = 0,
        max_fraction: Int = 3,
        grouping: Bool = True,
    ) -> String {
        float_format(locale, f, min_fraction, max_fraction, grouping)
    }

    /// `f` as a percentage in `locale`: `f` times 100, with the locale's
    /// percent sign where the locale puts it.
    //! assert Float.format_percent(0.256, Locale`en`) == "26%"
    //! assert Float.format_percent(0.256, Locale`fr`) == "26\u{a0}%"
    //! assert Float.format_percent(0.256, Locale`tr`) == "%26"
    //! assert Float.format_percent(0.1234, Locale`en`, 1) == "12.3%"
    //
    pub fn format_percent(f: Float, locale: Locale, max_fraction: Int = 0) -> String {
        float_format_percent(locale, f, max_fraction)
    }

    /// Read text a reader of `locale` wrote as a `Float`, strictly unless
    /// `lenient: True`, as `Int.parse_in` reads an `Int`.
    //! assert Float.parse_in("1.234,5", Locale`de`) == Ok(1234.5)
    //! assert Float.parse_in("1.234,5", Locale`en`) == Err(#NumberParseError.Unexpected{at: 5, text: ","})
    //
    pub fn parse_in(
        text: String,
        locale: Locale,
        lenient: Bool = False,
    ) -> Result<Float, NumberParseError> {
        float_parse_in(text, locale, lenient)
    }

    /// Read a percentage a reader of `locale` wrote, as a fraction:
    /// `12,5 %` is `0.125`. The percent sign is required, where the locale
    /// puts it unless `lenient: True`, as `Decimal.parse_percent_in` reads
    /// one.
    //! assert Float.parse_percent_in("12,5\u{a0}%", Locale`de`) == Ok(0.125)
    //! assert Float.parse_percent_in("%50", Locale`tr`) == Ok(0.5)
    //!
    //! assert Float.parse_percent_in("12.5", Locale`en`) == Err(
    //!     #NumberParseError.Unexpected{at: 4, text: ""}
    //! )
    //
    pub fn parse_percent_in(
        text: String,
        locale: Locale,
        lenient: Bool = False,
    ) -> Result<Float, NumberParseError> {
        float_parse_percent_in(text, locale, lenient)
    }
}

host fn float_round(x: Float, scale: Int, mode: RoundingMode) -> Float

host fn float_format(
    locale: Locale,
    f: Float,
    min_fraction: Int,
    max_fraction: Int,
    grouping: Bool,
) -> String

host fn float_format_percent(locale: Locale, f: Float, max_fraction: Int) -> String

host fn float_parse_in(
    text: String,
    locale: Locale,
    lenient: Bool,
) -> Result<Float, NumberParseError>

host fn float_parse_percent_in(
    text: String,
    locale: Locale,
    lenient: Bool,
) -> Result<Float, NumberParseError>

/// Returns the IEEE 754 bit-pattern of `x` reinterpreted as an Int (as if by
/// Go's `math.Float64bits`). Backs the `Hashable` impl. Two Float values
/// that are `==` and not NaN agree on `float_bits`. NaN values can have
/// multiple bit patterns; this returns the actual bits.
host fn float_bits(x: Float) -> Int

impl Display for Float {
    /// Returns the canonical string form of `x`, matching the runtime
    /// stringifier used by `io.print` and string interpolation. NaN renders as
    /// `NaN`, ±Infinity as `+Inf` / `-Inf`.
    //! assert Float.to_string(3.14) == "3.14"
    //! assert Float.to_string(1e20) == "100000000000000000000.0"
    //
    host fn to_string(x: Float) -> String
}

impl Add<Float, Float> for Float {
    host fn add(lhs: Float, rhs: Float) -> Float
}

impl Summable for Float {
    /// The sum of no Floats: `0.0`. `x + 0.0` is `x` for every Float but
    /// `-0.0`, which it turns into `0.0` (equal under `==`).
    //! assert Float.empty_sum() == 0.0
    //! assert 2.5 + Float.empty_sum() == 2.5
    //
    fn empty_sum() -> Float {
        0.0
    }
}

impl Subtract<Float, Float> for Float {
    host fn subtract(lhs: Float, rhs: Float) -> Float
}

impl Multiply<Float, Float> for Float {
    host fn multiply(lhs: Float, rhs: Float) -> Float
}

impl Productable for Float {
    /// The product of no Floats: `1.0`. `x * 1.0` is `x` for every Float,
    /// NaN and the infinities included.
    //! assert Float.empty_product() == 1.0
    //! assert 2.5 * Float.empty_product() == 2.5
    //
    fn empty_product() -> Float {
        1.0
    }
}

impl Divide<Float, Float> for Float {
    host fn divide(lhs: Float, rhs: Float) -> Float
}

impl Debug for Float {
    fn inspect(x: Float) -> String {
        to_string(x)
    }
}

impl Equatable for Float {
    fn equal?(a: Float, b: Float) -> Bool {
        a == b
    }
}

impl Hashable for Float {
    // Hash must agree with `==`: equal values hash equally. Two cases need
    // normalizing before taking the raw bits, because `==` treats them as equal
    // but their bit patterns differ: signed zero (`-0.0 == 0.0`) and NaN (which
    // is reflexively equal under Nomi's structural `==`, yet has many encodings).
    fn hash(x: Float) -> Int {
        if Float.nan?(x) {
            float_bits(Float.nan())
        } else if x == 0.0 {
            0
        } else {
            float_bits(x)
        }
    }
}

impl Comparable for Float {
    // A total order. NaN is placed at the top: all NaNs compare Equal to each
    // other and Greater than every non-NaN Float, including +Infinity. For
    // non-NaN operands the IEEE order applies; -0.0 and +0.0 compare Equal.
    //
    // Float has THREE comparison behaviours, and they do not all agree. Read
    // this before "fixing" any one of them, because two of the three are forced:
    //
    //   `==` / `equal?`   reflexive on NaN    `nan == nan` is True
    //   `compare` (here)  a total order       `compare(nan, nan)` is Equal
    //   `<` `<=` `>` `>=` IEEE                `nan <= nan` is False
    //
    // `==` is reflexive because `impl Hashable for Float` above requires it:
    // equal values must hash equally, so a NaN key would otherwise be
    // unretrievable from a Map. That law is what makes it non-negotiable, not
    // taste. `compare` agrees with `==` so that sorting is deterministic and
    // `Iter.sort` terminates with NaNs collected at one end.
    //
    // The ordering OPERATORS stay IEEE, which is the one place the three
    // disagree: `a == b` does not imply `a <= b` when both are NaN. That is
    // deliberate — IEEE ordering is what numeric code expects, and routing the
    // operators through this function to buy the implication would surprise more
    // often than it helps. Java splits the same three behaviours across three
    // spellings (`==`, `.equals()`, `Double.compare`) for the same reason and
    // with the same hashing motivation; Nomi's `==` is Java's `.equals()`.
    fn compare(a: Float, b: Float) -> Ordering {
        case {
            Float.nan?(a) and Float.nan?(b) -> Equal
            Float.nan?(a) -> Greater
            Float.nan?(b) -> Less
            a < b -> Less
            a == b -> Equal
            _ -> Greater
        }
    }
}
