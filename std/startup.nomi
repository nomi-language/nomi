import
    lists.List
    maps.Map
end

//# The inputs a program or a test starts with: its environment variables
//# and its arguments.

/// The inputs a program starts with. `env` holds the environment variables;
/// read one with `Map.get(startup.env, name)`. `args` holds the program's
/// arguments, without the executable or source path. Both fields default to
/// empty, so `Startup{}` is a Startup with no
/// environment and no arguments, and a test writes only the inputs it sets:
/// `Startup{args: ["-v"]}` or `Startup{env: {"PORT" => "8080"}}`.
pub struct Startup
    env:  Map<String, String> = {}
    args: List<String> = []
end
