//# Pseudo-random values from a seed. A `random.Generator<T>` describes how
//# to produce a `T`. `Generator.step` runs it with a `random.Seed` and
//# returns the value and the next seed. The same seed always gives the
//# same value, so a draw can be repeated and tested. There is no global
//# generator and nothing is mutated: a program passes the seed along
//# itself, or composes generators with `map` and `flat_map`. Two functions
//# read the operating system's entropy instead: `Seed.from_os`, for a
//# starting seed, and `random.secure_bytes`, for keys, tokens and salts,
//# which a seeded generator must never make.
//#
//# ```nomi
//# seed = Seed.from_int(42)
//#
//# die = Generator.int(1..=6)
//#
//# (roll, seed) = die |> Generator.step(seed)
//#
//# (next, _) = die |> Generator.step(seed) // the new seed gives a new draw
//# ```
//#
//# When several draws are known up front, compose them into one generator
//# and `step` once. Pass the `random.Seed` along by hand only when other
//# work happens between the draws, such as across turns of an interactive
//# loop. There are no `map2` or `map3` functions: `flat_map` and `map`
//# build any composite generator.

import
    bool.Bool.{self, False, True}
    bytes.Bytes
    display.Display
    equatable.Equatable
    float.{Float, NonNegativeFloat}
    int.{Int, NonNegativeInt}
    iter.Iter
    lists.{List, NonEmptyList}
    maybe.Maybe.{self, None, Some}
    ranges.{BoundedRange, Range}
    results.Result.{self, Err, Ok}
    strings.String
    vectors.Vector
end

/// A range of Floats that holds a value and has an end, both ends finite:
/// what `Generator.float` draws from, since an infinite end has no uniform
/// draw. It narrows `BoundedRange<Float>` to finite ends, so it has no NaN
/// end either, and a backwards or empty literal breaks `NonEmptyRange`'s
/// rule. A literal with finite ends, `0.0..1.0`, is checked when the
/// program is compiled; `FiniteRange.try_from(r)` checks a range computed
/// when it runs.
//! import std::random.FiniteRange
//!
//! r: FiniteRange = 0.0..=1.0
//! assert Range.contains(r, 0.5)
//! assert FiniteRange.try_from(Float.negative_infinity()..1.0) == None
//! assert FiniteRange.try_from(0.0..Float.positive_infinity()) == None
//! assert FiniteRange.try_from(1.0..0.0) == None
//! assert FiniteRange.try_from(0.0..1.0) == Some(0.0..1.0)
//
pub subtype FiniteRange BoundedRange<Float> when fn r ->
    Float.is_finite(Range.start(r))
        and Float.is_finite(Maybe.with_default(Range.stop(r), Float.nan()))
end

/// Errors returned when weights cannot make a generator, or when OS entropy is
/// unavailable.
pub enum Error
    InvalidWeight {weight: Float}
    ZeroWeightTotal
    OsEntropy {reason: String}
end

derive Equatable for Error

impl Display for Error
    fn to_string(e: Error) -> String
        case e
            Error.InvalidWeight{weight:} -> "invalid random weight: ${weight}"
            Error.ZeroWeightTotal -> "random weights must include at least one positive weight"
            Error.OsEntropy{reason:} -> "OS entropy unavailable: ${reason}"
        end
    end
end

/// The state of the pseudo-random sequence (a splitmix64 register). It is
/// never mutated: `Generator.step` takes one and returns the next.
/// `Seed.from_int` makes a seed that repeats, and `Seed.from_os` one that
/// does not.
pub opaque type Seed Int

impl Seed
    /// A seed from an integer. The same `n` gives the same sequence on
    /// every platform and in every release, since splitmix64 is fully
    /// specified.
    //! seed = Seed.from_int(123)
    //! (roll, _) = Generator.step(Generator.int(1..=6), seed)
    //! assert roll == 2
    //
    pub fn from_int(n: Int) -> Seed
        Seed(n)
    end

    /// A seed from the operating system's entropy, different on every run.
    /// It is the only function of `Seed` that is not pure. A program seeded
    /// with it cannot repeat its draws, so tests use `from_int`.
    pub fn from_os() -> Result<Seed, Error>
        case os_state()
            Ok(state)   -> Ok(Seed(state))
            Err(reason) -> Err(Error.OsEntropy{reason:})
        end
    end
end

/// Unbiased integer in the inclusive range `[from, to]` plus the advanced
/// state (host rejection sampling over the span, so a range of any width
/// draws). The Go function returns two values, which the host projection
/// maps element by element into this tuple.
host fn between_state(state: Int, from: Int, to: Int) -> (Int, Int)

/// Float in `[0.0, 1.0)` plus the advanced state.
host fn unit_float_state(state: Int) -> (Float, Int)

host fn os_state() -> Result<Int, String>

/// `count` bytes from the operating system's cryptographically secure
/// random source, for keys, tokens, salts and nonces. Unlike a `Generator`
/// it takes no seed and never repeats, so a test cannot predict its bytes.
/// `count` is a `NonNegativeInt`.
//! import std::random
//!
//! key = random.secure_bytes(32)
//! assert Bytes.length(key) == 32
//! assert Bytes.length(random.secure_bytes(0)) == 0
//
pub host fn secure_bytes(count: NonNegativeInt) -> Bytes

/// Unbiased integer in `[from, to]` plus the next seed. The public integer
/// generators draw with it.
fn between(Seed(state), from: Int, to: Int) -> (Int, Seed)
    (value, next) = between_state(state, from, to)
    (value, Seed(next))
end

/// Float in `[0.0, 1.0)` plus the next seed.
fn unit_float(Seed(state)) -> (Float, Seed)
    (value, next) = unit_float_state(state)
    (value, Seed(next))
end

/// A description of how to produce a `T` from a seed. Build one with
/// `Generator.int`, `Generator.float`, `Generator.bool`,
/// `Generator.uniform` or `Generator.weighted`, change it with `map` and
/// `flat_map`, then run it with `Generator.step`. `Generator.weighted`
/// returns a `Result`, since its weights may come from data: unwrap it with
/// `?` or `case` before composing.
pub opaque struct Generator<T>
    run: (Seed) -> (T, Seed)
end

impl Generator<T>
    /// Produces a value and the next seed. The same generator and seed
    /// always give the same pair.
    ///
    /// ```nomi
    /// die = Generator.int(1..=6)
    ///
    /// (n, _) = die |> Generator.step(Seed.from_int(42))
    /// ```
    //! gen = Generator.constant("heads")
    //! (value, _) = Generator.step(gen, Seed.from_int(1))
    //! assert value == "heads"
    //
    pub fn step<T>(gen: Generator<T>, seed: Seed) -> (T, Seed)
        gen.run(seed)
    end

    /// Uniform integer in `range`, a `BoundedRange`: `1..=6` draws 1 to 6
    /// and `0..10` draws 0 to 9. A backwards or empty range (`6..=1`,
    /// `4..4`) is an error when the program is compiled, and a range
    /// computed when it runs goes through `BoundedRange.try_from`. Any range
    /// draws uniformly, the whole of `Int` included.
    //! die = Generator.int(1..=6)
    //! (roll, _) = Generator.step(die, Seed.from_int(123))
    //! assert roll >= 1 and roll <= 6
    //! (only, _) = Generator.step(Generator.int(4..=4), Seed.from_int(123))
    //! assert only == 4
    //! (below, _) = Generator.step(Generator.int(4..5), Seed.from_int(123))
    //! assert below == 4
    //! (n, _) = Generator.step(Generator.int(-5..=9_223_372_036_854_775_807), Seed.from_int(7))
    //! assert n >= -5
    //! huge = Int.pow(10, 30)
    //! wide = BoundedRange.try_from(huge..=huge * 2)!
    //! (big, _) = Generator.step(Generator.int(wide), Seed.from_int(7))
    //! assert big >= huge and big <= huge * 2
    //
    pub fn int(range: BoundedRange<Int>) -> Generator<Int>
        // A BoundedRange has an end, so the `!` holds.
        to = Range.stop(range)!
        unsafe_int(Range.start(range), if Range.is_inclusive(range) then to else to - 1)
    end

    /// Uniform float in `range`, a `FiniteRange`: `1.5..2.5` draws from 1.5
    /// up to but not including 2.5. An inclusive range draws the same way,
    /// so `x..=x` always draws `x`. A backwards or empty range is an error
    /// when the program is compiled, and a range computed when it runs goes
    /// through `FiniteRange.try_from`, which also refuses a NaN or an
    /// infinite end. Ends whose difference is too large for a Float still
    /// draw uniformly.
    //! import std::random.FiniteRange
    //!
    //! gen = Generator.float(1.5..2.5)
    //! (x, _) = Generator.step(gen, Seed.from_int(123))
    //! assert x >= 1.5 and x < 2.5
    //! (same, _) = Generator.step(Generator.float(0.5..=0.5), Seed.from_int(123))
    //! assert same == 0.5
    //! (wide, _) = Generator.step(Generator.float(-1.0e308..1.0e308), Seed.from_int(7))
    //! assert Float.is_finite(wide)
    //! low = 0.25
    //! (y, _) = Generator.step(Generator.float(FiniteRange.try_from(low..1.0)!), Seed.from_int(7))
    //! assert y >= low and y < 1.0
    //
    pub fn float(range: FiniteRange) -> Generator<Float>
        // A FiniteRange has an end, so the `!` holds.
        unsafe_float(Range.start(range), Range.stop(range)!)
    end

    /// `True` or `False` with equal probability.
    //! (value, _) = Generator.step(Generator.bool(), Seed.from_int(123))
    //! assert value == True or value == False
    //
    pub fn bool() -> Generator<Bool>
        unsafe_int(0, 1) |> map(&(&1 == 1))
    end

    /// Always produces `value`, and returns the seed it was given.
    //! (value, _) = Generator.step(Generator.constant("fixed"), Seed.from_int(123))
    //! assert value == "fixed"
    //
    pub fn constant<T>(value: T) -> Generator<T>
        Generator{run: fn seed -> (value, seed)}
    end

    /// Uniform choice among `options`, a `NonEmptyList`, which a list
    /// literal with an element is; a list built while the program runs goes
    /// through `NonEmptyList.try_from`.
    ///
    /// ```nomi
    /// Generator.uniform(["rock", "paper", "scissors"])
    /// ```
    //! (choice, _) =
    //!     Generator.uniform(["rock", "paper", "scissors"])
    //!     |> Generator.step(Seed.from_int(123))
    //!
    //! assert choice == "paper" or choice == "rock" or choice == "scissors"
    //
    pub fn uniform<T>(options: NonEmptyList<T>) -> Generator<T>
        all = Iter.to_vector(options)

        unsafe_int(0, Vector.length(all) - 1) |> map(&Vector.get(all, &1)!)
    end

    /// Weighted choice among `options`, a `NonEmptyList`; each option carries
    /// a relative weight, a `NonNegativeFloat`, and the weights need not sum
    /// to 1. The result is `Err(Error.ZeroWeightTotal)` when every weight is
    /// zero, and `Err(Error.InvalidWeight{...})` when a weight or their sum
    /// is infinite.
    //! assert Ok(gen) = Generator.weighted([(1.0, "always")])
    //! (choice, _) = Generator.step(gen, Seed.from_int(123))
    //! assert choice == "always"
    //! assert Err(Error.ZeroWeightTotal) = Generator.weighted([(0.0, "never")])
    //! endless = NonNegativeFloat.try_from(Float.positive_infinity())!
    //! assert Err(Error.InvalidWeight{weight: _}) = Generator.weighted([(endless, "all")])
    //
    pub fn weighted<T>(options: NonEmptyList<(NonNegativeFloat, T)>) -> Result<Generator<T>, Error>
        total = total_weight(options, 0.0)?
        first = NonEmptyList.first(options)
        rest = NonEmptyList.tail(options)

        Ok(
            unsafe_float(0.0, total)
            |> map(&pick_weighted(first, rest, &1))
        )
    end

    /// A generator of `f` applied to each value `gen` produces.
    //! gen = Generator.constant(21) |> Generator.map(&(&1 * 2))
    //!
    //! (value, _) = Generator.step(gen, Seed.from_int(123))
    //! assert value == 42
    //
    pub fn map<T, U>(gen: Generator<T>, f: (T) -> U) -> Generator<U>
        Generator{
            run:
                fn seed ->
                    (value, seed) = Generator.step(gen, seed)
                    (f(value), seed)
                end,
        }
    end

    /// A generator that draws from `gen`, then from the generator `f`
    /// returns for that value: a draw that depends on an earlier one.
    ///
    /// ```nomi
    /// gen = Generator.int(1..=6)
    ///
    /// gen |> Generator.flat_map(fn n -> Generator.list(Generator.bool(), n))
    /// ```
    //! gen =
    //!     Generator.constant(3)
    //!     |> Generator.flat_map(fn n -> Generator.constant(n * 10))
    //!
    //! (value, _) = Generator.step(gen, Seed.from_int(123))
    //! assert value == 30
    //
    pub fn flat_map<T, U>(gen: Generator<T>, f: (T) -> Generator<U>) -> Generator<U>
        Generator{
            run:
                fn seed ->
                    (value, seed) = Generator.step(gen, seed)
                    Generator.step(f(value), seed)
                end,
        }
    end

    /// A list of `length` independent draws from `gen`. `length` is a
    /// `NonNegativeInt`, and a length of 0 is an empty list.
    //! (hand, _) =
    //!     Generator.int(1..=6)
    //!     |> Generator.list(5)
    //!     |> Generator.step(Seed.from_int(7))
    //!
    //! assert hand == [4, 1, 1, 4, 5]
    //!
    //! gen = Generator.constant("ha") |> Generator.list(3)
    //!
    //! (values, _) = Generator.step(gen, Seed.from_int(123))
    //! assert values == ["ha", "ha", "ha"]
    //
    pub fn list<T>(gen: Generator<T>, length: NonNegativeInt) -> Generator<List<T>>
        Generator{run: &draw_list(gen, length, &1, [])}
    end
end

fn unsafe_int(from: Int, to: Int) -> Generator<Int>
    Generator{
        run:
            fn seed ->
                between(seed, from, to)
            end,
    }
end

fn unsafe_float(from: Float, to: Float) -> Generator<Float>
    Generator{
        run:
            fn seed ->
                (f, seed) = unit_float(seed)
                span = to - from

                // Finite bounds whose difference overflows (`-1.0e308` to
                // `1.0e308`) interpolate instead, where no term exceeds a bound.
                if Float.is_finite(span) then
                    (from + f * span, seed)
                else
                    (from * (1.0 - f) + to * f, seed)
                end
            end,
    }
end

/// Tail-recursive accumulator for `Generator.list`.
fn draw_list<T>(gen: Generator<T>, remaining: Int, seed: Seed, acc: List<T>) -> (List<T>, Seed)
    if remaining == 0 then
        (Iter.reverse(acc), seed)
    else
        (x, seed) = Generator.step(gen, seed)
        draw_list(gen, remaining - 1, seed, [x, ..acc])
    end
end

/// Walk cumulative weights to land `target` on an option. Total by construction
/// (the first option is always present, so the last arm returns a real `T`).
fn pick_weighted<T>(
    first:  (NonNegativeFloat, T),
    rest:   List<(NonNegativeFloat, T)>,
    target: Float,
) -> T
    (w, x) = first

    if target < w then
        x
    else
        case rest
            []             -> x
            [next, ..tail] -> pick_weighted(next, tail, target - w)
        end
    end
end

fn total_weight<T>(items: List<(NonNegativeFloat, T)>, acc: Float) -> Result<Float, Error>
    case items
        [] ->
            if Float.is_finite(acc) == False then
                Err(Error.InvalidWeight{weight: acc})
            else if acc > 0.0 then
                Ok(acc)
            else
                Err(Error.ZeroWeightTotal)
            end

        [(w, _), ..tail] ->
            if Float.is_finite(w) == False then
                Err(Error.InvalidWeight{weight: w})
            else
                total_weight(tail, acc + w)
            end
    end
end
