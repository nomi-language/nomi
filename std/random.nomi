//# Pure pseudo-random generation. A `random.Generator<T>` is an immutable
//# recipe for producing a `T`; run it against a `random.Seed` with
//# `Generator.step` to get back the value paired with the next seed.
//# Same seed in -> same value out, so every draw is reproducible and testable.
//# The only impurity is `Seed.from_os`, which reads OS entropy for a fresh
//# starting seed.

import {
    bool.Bool.{self, False, True}
    display.Display
    equatable.Equatable
    float.Float
    int.Int
    iter.Iter
    lists.List
    results.Result.{self, Err, Ok}
    strings.String
}

/// Errors returned when constructing a generator whose invariants can be
/// checked before any random draw happens, or when OS entropy is unavailable.
pub enum Error {
    InvalidIntRange {from: Int, to: Int}
    InvalidFloatRange {from: Float, to: Float}
    InvalidWeight {weight: Float}
    ZeroWeightTotal
    OsEntropy {reason: String}
}

derive Equatable for Error

impl Display for Error {
    fn to_string(e: Error): String {
        case e {
            Error.InvalidIntRange{from, to} -> "invalid integer range: ${from}..=${to}"
            Error.InvalidFloatRange{from, to} -> "invalid float range: [${from}, ${to})"
            Error.InvalidWeight{weight} -> "invalid random weight: ${weight}"
            Error.ZeroWeightTotal -> "random weights must include at least one positive weight"
            Error.OsEntropy{reason} -> "OS entropy unavailable: ${reason}"
        }
    }
}

/// Opaque PRNG state (a splitmix64 register). Thread it explicitly through
/// `Generator.step`; never mutated. Seed reproducibly with `Seed.from_int`, or
/// pull a non-deterministic one with `Seed.from_os`.
pub opaque type Seed Int

impl Seed {
    /// A reproducible seed from an integer. Same `n` -> same sequence, forever.
    //! seed = Seed.from_int(123)
    //! assert Ok(die) = Generator.int(1, 6)
    //! (roll, _) = Generator.step(die, seed)
    //! assert roll == 2
    //
    pub fn from_int(n: Int): Seed {
        Seed(n)
    }

    /// A non-deterministic seed from OS entropy. The one impure call on `Seed`
    /// -- the entry point when you want real randomness.
    pub fn from_os(): Result<Seed, Error> {
        case os_state() {
            Ok(state) -> Ok(Seed(state))
            Err(reason) -> Err(Error.OsEntropy{reason})
        }
    }
}

/// Unbiased integer in `[0, n)` plus the advanced state (host rejection
/// sampling). The Go adapter returns two values, which the FFI boundary
/// projects element-by-element into this tuple.
host fn below_state(state: Int, n: Int): (Int, Int)

/// Float in `[0.0, 1.0)` plus the advanced state.
host fn unit_float_state(state: Int): (Float, Int)

host fn os_state(): Result<Int, String>

/// Unbiased integer in `[0, n)` plus the next seed (host rejection sampling).
/// Module-private -- the building block the public generators draw on.
fn below(Seed(state), n: Int): (Int, Seed) {
    (value, next) = below_state(state, n)
    (value, Seed(next))
}

/// Float in `[0.0, 1.0)` plus the next seed. Module-private.
fn unit_float(Seed(state)): (Float, Seed) {
    (value, next) = unit_float_state(state)
    (value, Seed(next))
}

/// An immutable recipe for producing a `T`. Build one with a constructor
/// (`Generator.int`, ...), reshape it with `map` / `flat_map`, then run it with
/// `Generator.step`. Constructors whose invariants can be invalid return
/// `Result`; unwrap them with `try` or `case` before composing.
pub opaque struct Generator<T> {
    run: (Seed) -> (T, Seed)
}

impl Generator<T> {
    /// Produce a value and the next seed. The pure core of `Generator`.
    ///
    /// ```nomi
    /// die = try Generator.int(1, 6)
    /// (n, _) = die |> Generator.step(Seed.from_int(42))
    /// ```
    //! gen = Generator.constant("heads")
    //! (value, _) = Generator.step(gen, Seed.from_int(1))
    //! assert value == "heads"
    //
    pub fn step<T>(gen: Generator<T>, seed: Seed): (T, Seed) {
        gen.run(seed)
    }

    /// Uniform integer in the inclusive range `[from, to]`. Returns Err when
    /// `from > to`.
    //! assert Ok(die) = Generator.int(1, 6)
    //! (roll, _) = Generator.step(die, Seed.from_int(123))
    //! assert roll >= 1 and roll <= 6
    //! assert Err(Error.InvalidIntRange{from: 6, to: 1}) = Generator.int(6, 1)
    //
    pub fn int(from: Int, to: Int): Result<Generator<Int>, Error> {
        if from <= to {
            Ok(unsafe_int(from, to))
        } else {
            Err(Error.InvalidIntRange{from, to})
        }
    }

    /// Uniform float in the half-open range `[from, to)`. Returns Err when
    /// `from >= to`.
    //! assert Ok(gen) = Generator.float(1.5, 2.5)
    //! (x, _) = Generator.step(gen, Seed.from_int(123))
    //! assert x >= 1.5 and x < 2.5
    //! assert Err(Error.InvalidFloatRange{from: 2.5, to: 1.5}) = Generator.float(2.5, 1.5)
    //
    pub fn float(from: Float, to: Float): Result<Generator<Float>, Error> {
        if from < to {
            Ok(unsafe_float(from, to))
        } else {
            Err(Error.InvalidFloatRange{from, to})
        }
    }

    /// `True` or `False` with equal probability.
    //! (value, _) = Generator.step(Generator.bool(), Seed.from_int(123))
    //! assert value == True or value == False
    //
    pub fn bool(): Generator<Bool> {
        unsafe_int(0, 1) |> map(|n| n == 1)
    }

    /// Always produces `value` (consuming no randomness, seed unchanged).
    //! (value, _) = Generator.step(Generator.constant("fixed"), Seed.from_int(123))
    //! assert value == "fixed"
    //
    pub fn constant<T>(value: T): Generator<T> {
        Generator{run: |seed| (value, seed)}
    }

    /// Uniform choice among `first` and `rest` -- non-empty by construction.
    ///
    /// ```nomi
    /// Generator.uniform("rock", ["paper", "scissors"])
    /// ```
    //! (choice, _) =
    //!     Generator.uniform("rock", ["paper", "scissors"])
    //!     |> Generator.step(Seed.from_int(123))
    //!
    //! assert choice == "paper" or choice == "rock" or choice == "scissors"
    //
    pub fn uniform<T>(first: T, rest: List<T>): Generator<T> {
        all = [first, ..rest]

        unsafe_int(0, Iter.count(rest))
        |> map(|i|
            case Iter.at(all, i) {
                .Some(x) -> x
                .None -> first
            }
        )
    }

    /// Weighted choice; each option carries a relative weight. Non-empty.
    /// Weights must be non-negative, and at least one weight must be positive;
    /// they need not sum to 1.
    //! assert Ok(gen) = Generator.weighted((1.0, "always"), [])
    //! (choice, _) = Generator.step(gen, Seed.from_int(123))
    //! assert choice == "always"
    //! assert Err(Error.ZeroWeightTotal) = Generator.weighted((0.0, "never"), [])
    //
    pub fn weighted<T>(first: (Float, T), rest: List<(Float, T)>): Result<Generator<T>, Error> {
        total = try total_weight([first, ..rest], 0.0)

        Ok(
            unsafe_float(0.0, total)
            |> map(|target| pick_weighted(first, rest, target))
        )
    }

    /// Transform the produced value.
    //! gen = Generator.constant(21) |> Generator.map(|n| n * 2)
    //!
    //! (value, _) = Generator.step(gen, Seed.from_int(123))
    //! assert value == 42
    //
    pub fn map<T, U>(gen: Generator<T>, f: (T) -> U): Generator<U> {
        Generator{
            run: |seed| {
                (value, seed) = Generator.step(gen, seed)
                (f(value), seed)
            },
        }
    }

    /// Sequence a dependent generator -- the bind operation.
    ///
    /// ```nomi
    /// gen = try Generator.int(1, 6)
    /// gen |> Generator.flat_map(|n|
    ///     Generator.list(Generator.bool(), n)
    /// )
    /// ```
    //! gen =
    //!     Generator.constant(3)
    //!     |> Generator.flat_map(|n| Generator.constant(n * 10))
    //!
    //! (value, _) = Generator.step(gen, Seed.from_int(123))
    //! assert value == 30
    //
    pub fn flat_map<T, U>(gen: Generator<T>, f: (T) -> Generator<U>): Generator<U> {
        Generator{
            run: |seed| {
                (value, seed) = Generator.step(gen, seed)
                Generator.step(f(value), seed)
            },
        }
    }

    /// A list of `length` independent draws from `gen`. A non-positive length
    /// produces an empty list.
    //! gen = Generator.constant("ha") |> Generator.list(3)
    //!
    //! (values, _) = Generator.step(gen, Seed.from_int(123))
    //! assert values == ["ha", "ha", "ha"]
    //
    pub fn list<T>(gen: Generator<T>, length: Int): Generator<List<T>> {
        Generator{run: |seed| draw_list(gen, length, seed, [])}
    }
}

fn unsafe_int(from: Int, to: Int): Generator<Int> {
    Generator{
        run: |seed| {
            (offset, seed) = below(seed, to - from + 1)
            (from + offset, seed)
        },
    }
}

fn unsafe_float(from: Float, to: Float): Generator<Float> {
    Generator{
        run: |seed| {
            (f, seed) = unit_float(seed)
            (from + f * (to - from), seed)
        },
    }
}

/// Tail-recursive accumulator for `Generator.list`.
fn draw_list<T>(gen: Generator<T>, remaining: Int, seed: Seed, acc: List<T>): (List<T>, Seed) {
    if remaining <= 0 {
        (Iter.reverse(acc), seed)
    } else {
        (x, seed) = Generator.step(gen, seed)
        draw_list(gen, remaining - 1, seed, [x, ..acc])
    }
}

/// Walk cumulative weights to land `target` on an option. Total by construction
/// (the first option is always present, so the last arm returns a real `T`).
fn pick_weighted<T>(first: (Float, T), rest: List<(Float, T)>, target: Float): T {
    (w, x) = first

    if target < w {
        x
    } else {
        case rest {
            [] -> x
            [next, ..tail] -> pick_weighted(next, tail, target - w)
        }
    }
}

fn total_weight<T>(items: List<(Float, T)>, acc: Float): Result<Float, Error> {
    case items {
        [] ->
            if Float.finite?(acc) == False {
                Err(Error.InvalidWeight{weight: acc})
            } else if acc > 0.0 {
                Ok(acc)
            } else {
                Err(Error.ZeroWeightTotal)
            }

        [(w, _), ..tail] ->
            if Float.finite?(w) == False {
                Err(Error.InvalidWeight{weight: w})
            } else if w < 0.0 {
                Err(Error.InvalidWeight{weight: w})
            } else {
                total_weight(tail, acc + w)
            }
    }
}
