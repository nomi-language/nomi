import {
    bool.Bool.{self, False, True}
    display.Display
    equatable.Equatable
    hashable.Hashable
    iter.Iter
    lists.List
    maybe.Maybe.{self, None, Some}
}

/// Uninhabited type — no values can be constructed. Useful as the error type
/// of a `Result` that cannot fail.
pub host type Infallible

/// A value that is either a success (Ok) or a failure (Err).
//! parse = |s: String|
//!     if s == "" {
//!         Result.Err("empty")
//!     } else {
//!         Result.Ok(s)
//!     }
//!
//! value = case parse("hi") {
//!     .Ok(v) -> v
//!     .Err(_) -> "?"
//! }
//!
//! assert value == "hi"
//
pub enum Result<T, E> {
    Ok T
    Err E
}

impl Result<T, E> {
    /// Returns True when the value is Ok.
    //! assert Result.ok?(Result.Ok(3))
    //! refute Result.ok?(Result.Err("bad"))
    //
    pub fn ok?<T, E>(result: Result<T, E>): Bool {
        case result {
            Ok(_) -> True
            Err(_) -> False
        }
    }

    /// Returns True when the value is Err.
    //! refute Result.err?(Result.Ok(3))
    //! assert Result.err?(Result.Err("bad"))
    //
    pub fn err?<T, E>(result: Result<T, E>): Bool {
        case result {
            Ok(_) -> False
            Err(_) -> True
        }
    }

    /// Transforms the Ok value, passes Err through.
    //! assert Result.map(Result.Ok(3), |x| x * 2) == Result.Ok(6)
    //! assert Result.map(Result.Err("bad"), |x| x * 2) == Result.Err("bad")
    //
    pub fn map<T, E, U>(result: Result<T, E>, f: (T) -> U): Result<U, E> {
        case result {
            Ok(v) -> Result.Ok(f(v))
            Err(e) -> Result.Err(e)
        }
    }

    /// Returns the Ok value, or the default if Err.
    //! assert Result.with_default(Result.Ok(5), 0) == 5
    //! assert Result.with_default(Result.Err("bad"), 0) == 0
    //
    pub fn with_default<T, E>(result: Result<T, E>, default: T): T {
        case result {
            Ok(v) -> v
            Err(_) -> default
        }
    }

    /// Like map, but the function returns a Result. Flattens the result.
    //! parse_int = |s: String|
    //!     if s == "1" {
    //!         Result.Ok(1)
    //!     } else {
    //!         Result.Err("nope")
    //!     }
    //!
    //! assert Result.flat_map(Result.Ok("1"), |s| parse_int(s)) == Result.Ok(1)
    //! assert Result.flat_map(Result.Ok("x"), |s| parse_int(s)) == Result.Err("nope")
    //
    pub fn flat_map<T, E, U>(result: Result<T, E>, f: (T) -> Result<U, E>): Result<U, E> {
        case result {
            Ok(v) -> f(v)
            Err(e) -> Result.Err(e)
        }
    }

    /// Transforms the Err value, passes Ok through.
    //! assert Result.map_err(Result.Err("bad"), |e| "error: " + e) == Result.Err("error: bad")
    //! assert Result.map_err(Result.Ok(3), |e| "error: " + e) == Result.Ok(3)
    //
    pub fn map_err<T, E, F>(result: Result<T, E>, f: (E) -> F): Result<T, F> {
        case result {
            Ok(v) -> Result.Ok(v)
            Err(e) -> Result.Err(f(e))
        }
    }

    /// Converts Result to Maybe. Err becomes None; the error value is discarded.
    //! assert Result.to_maybe(Result.Ok(3)) == Some(3)
    //! assert Result.to_maybe(Result.Err("bad")) == None
    //
    pub fn to_maybe<T, E>(result: Result<T, E>): Maybe<T> {
        case result {
            Ok(v) -> Maybe.Some(v)
            Err(_) -> Maybe.None
        }
    }

    /// Returns Ok of every value in order when every result is Ok, and otherwise
    /// the first Err. It stops consuming the iterator at that Err.
    //! import std/ranges.Range
    //!
    //! assert Result.collect([Result.Ok(1), Result.Ok(2)]) == Result.Ok([1, 2])
    //! assert Result.collect([Result.Ok(1), Result.Err("a"), Result.Err("b")]) == Result.Err("a")
    //! none: List<Result<Int, String>> = []
    //! assert Result.collect(none) == Result.Ok([])
    //!
    //! checked =
    //!     [3, 1, 2]
    //!     |> Iter.map(|n|
    //!         if n > 0 {
    //!             Result.Ok(n * 10)
    //!         } else {
    //!             Result.Err(n)
    //!         }
    //!     )
    //!     |> Result.collect()
    //!
    //! assert checked == Result.Ok([30, 10, 20])
    //!
    //! // An infinite source ends: collect stops pulling at the first Err.
    //! stopped =
    //!     Range.naturals()
    //!     |> Iter.map(|n| if n < 3 { Result.Ok(n) } else { Result.Err(n) })
    //!     |> Result.collect()
    //!
    //! assert stopped == Result.Err(3)
    //
    pub fn collect<T, E>(results: Iter<Result<T, E>>): Result<List<T>, E> {
        reversed = Iter.reduce(results, |acc: Result<List<T>, E> = Result.Ok([]), item|
            case item {
                Ok(v) -> Result.map(acc, |vs| [v, ..vs])
                Err(e) -> break Result.Err(e)
            }
        )

        Result.map(reversed, |vs| Iter.reverse(vs))
    }

    /// Splits results into every Ok value and every Err value, each list in
    /// input order. It consumes the whole iterator.
    //! mixed = [Result.Ok(1), Result.Err("a"), Result.Ok(2), Result.Err("b")]
    //! assert Result.partition(mixed) == ([1, 2], ["a", "b"])
    //! oks: List<Result<Int, String>> = [Result.Ok(1), Result.Ok(2)]
    //! (all_oks, no_errs) = Result.partition(oks)
    //! assert all_oks == [1, 2]
    //! assert no_errs == []
    //!
    //! none: List<Result<Int, String>> = []
    //! (no_oks, still_no_errs) = Result.partition(none)
    //! assert no_oks == []
    //! assert still_no_errs == []
    //!
    //! split =
    //!     [1, -2, 3, -4]
    //!     |> Iter.map(|n| if n > 0 { Result.Ok(n) } else { Result.Err(n) })
    //!     |> Result.partition()
    //!
    //! assert split == ([1, 3], [-2, -4])
    //
    pub fn partition<T, E>(results: Iter<Result<T, E>>): (List<T>, List<E>) {
        state = Iter.reduce(results, |state: (List<T>, List<E>) = ([], []), item| {
            (oks, errs) = state

            case item {
                Ok(v) -> ([v, ..oks], errs)
                Err(e) -> (oks, [e, ..errs])
            }
        })

        (oks, errs) = state
        (Iter.reverse(oks), Iter.reverse(errs))
    }
}

derive Display for Result<T, E>
derive Equatable for Result<T, E>
derive Hashable for Result<T, E>
