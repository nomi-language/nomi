//# The Go-backed half of std::embed: reading an embedded file's contents
//# through the handle the machine gave it (rt.EmbeddedRead). It is
//# internal; a program reads embedded files through std::embed's `Files`.

import {
    bytes.Bytes
    int.Int
    strings.String
}

/// The contents of the embedded file `handle` names, whose path in its
/// tree is `path`. A built program reads them from its image; `nomi run`
/// reads them from the file, and stops with an error naming it when the
/// file changed after the program was compiled.
pub host fn read(handle: Int, path: String) -> Bytes
