//# Stream connections: TCP, and Unix-domain sockets. `net.dial` opens a
//# connection, and `net.listen` with `net.serve` handles the connections
//# that arrive, each as a task of a supervisor, as `http.serve` handles
//# requests. A connection is read and written through std::io's streams:
//#
//# ```nomi
//# conn = net.dial("example.com:7")?
//#
//# _ = Writer.write_text(Connection.writer(conn), "ping\n")
//#
//# reply = Reader.read_line(Connection.reader(conn))
//#
//# Connection.close(conn)
//# ```
//#
//# `net.dial_unix` and `net.listen_unix` do the same over a Unix socket's
//# path, which a local server such as Postgres or Docker listens on, and
//# give the same `Connection` and `Listener`, and `net.inherited_listeners`
//# gives the listeners a service manager such as systemd started the
//# program with. Dialing runs under the context in force, and a
//# connection's reads and writes stop when the task that opened it is
//# cancelled. std::tls runs TLS over the same `Connection`. Datagrams, UDP
//# and Unix, are std::udp's.

import
    bool.Bool.{self, False, True}
    display.Display
    duration.Duration
    equatable.Equatable
    http::host as http_host
    instant.Instant
    int.{Int, NonNegativeInt}
    io.{Reader, Writer}
    iter.Iter
    lists.List
    option.Option.{self, None, Some}
    results.Result.{self, Err, Ok}
    strings.String
    supervisors.Supervisor
    tls
    unit.Unit
end

/// An open stream connection: TCP or a Unix socket, or TLS over either.
pub opaque struct Connection
    handle: http_host.Conn
end

impl Connection
    /// What the peer sends, as a stream. The same reader each call. A read
    /// or write fails with `io.Error.Reset` when the peer resets the
    /// connection or, over TLS, sends an alert, and with `Corrupt` when a
    /// TLS record does not decode or authenticate.
    pub fn reader(conn: Connection) -> Reader
        http_host.conn_reader(conn.handle)
    end

    /// What goes to the peer: each write is sent as it is made.
    pub fn writer(conn: Connection) -> Writer
        http_host.conn_writer(conn.handle)
    end

    /// Closes both directions. A read or write after it fails.
    pub fn close(conn: Connection) -> Unit
        http_host.conn_close(conn.handle)
    end

    /// Closes the sending direction, so the peer reads the end of its
    /// input, while this side can still read.
    pub fn close_write(conn: Connection) -> Unit
        http_host.conn_close_write(conn.handle)
    end

    /// This side's address, `host:port`, or a Unix socket's path: the
    /// listener's for an accepted connection, "" for a dialed one.
    pub fn local_address(conn: Connection) -> String
        http_host.conn_local(conn.handle)
    end

    /// The peer's address, `host:port`, or a Unix socket's path: the one
    /// dialed, or "" for an accepted connection, whose peer has none.
    pub fn remote_address(conn: Connection) -> String
        http_host.conn_remote(conn.handle)
    end

    /// Reads and writes past `at` fail with a timeout; `None` clears it.
    pub fn set_deadline(conn: Connection, at: Option<Instant>) -> Unit
        http_host.conn_deadline(conn.handle, 0, unix(at))
    end

    pub fn set_read_deadline(conn: Connection, at: Option<Instant>) -> Unit
        http_host.conn_deadline(conn.handle, 1, unix(at))
    end

    pub fn set_write_deadline(conn: Connection, at: Option<Instant>) -> Unit
        http_host.conn_deadline(conn.handle, 2, unix(at))
    end

    /// Closes the receiving direction.
    pub fn close_read(conn: Connection) -> Unit
        http_host.conn_close_read(conn.handle)
    end

    /// Asks the system to hold up to `bytes` of what arrives before it is
    /// read (`SO_RCVBUF`); the system may round or cap it.
    pub fn set_read_buffer(conn: Connection, bytes: Int) -> Result<Unit, Error>
        http_host.socket_set(conn.handle, "read_buffer", bytes) |> Result.map_err(Error.from_parts)
    end

    /// Asks the system to hold up to `bytes` of what is written before it
    /// is sent (`SO_SNDBUF`); the system may round or cap it.
    pub fn set_write_buffer(conn: Connection, bytes: Int) -> Result<Unit, Error>
        http_host.socket_set(conn.handle, "write_buffer", bytes) |> Result.map_err(Error.from_parts)
    end

    /// How many bytes the system holds of what arrives before it is read
    /// (`SO_RCVBUF`). It may differ from what `set_read_buffer` asked:
    /// Linux doubles it.
    pub fn read_buffer(conn: Connection) -> Result<Int, Error>
        http_host.socket_get(conn.handle, "read_buffer") |> Result.map_err(Error.from_parts)
    end

    /// How many bytes the system holds of what is written before it is
    /// sent (`SO_SNDBUF`), as `read_buffer` reads.
    pub fn write_buffer(conn: Connection) -> Result<Int, Error>
        http_host.socket_get(conn.handle, "write_buffer") |> Result.map_err(Error.from_parts)
    end

    /// Whether small writes go out at once (`True`, the default) or wait
    /// to be combined (Nagle's algorithm).
    pub fn set_no_delay(conn: Connection, on: Bool) -> Unit
        http_host.conn_no_delay(conn.handle, on)
    end

    /// How long `close` waits to send what is unsent: `None` is the
    /// system's default, zero discards it.
    pub fn set_linger(conn: Connection, wait: Option<Duration>) -> Unit
        http_host.conn_linger(
            conn.handle,
            wait
            |> Option.map(Duration.as_seconds)
            |> Option.with_default(-1),
        )
    end

    /// The connection's keep-alive probes.
    pub fn set_keep_alive(conn: Connection, keep_alive: KeepAlive) -> Unit
        http_host.conn_keep_alive(
            conn.handle,
            keep_alive.enabled,
            nanos(keep_alive.idle),
            nanos(keep_alive.interval),
            Option.with_default(keep_alive.count, 0),
        )
    end

    /// Whether the connection runs Multipath TCP.
    pub fn is_multipath(conn: Connection) -> Bool
        http_host.conn_multipath(conn.handle)
    end

    /// For std::tls: the connection a handle holds.
    fn of_handle(handle: http_host.Conn) -> Connection
        Connection{handle:}
    end

    /// For std::tls: the handle a connection holds.
    fn handle_of(conn: Connection) -> http_host.Conn
        conn.handle
    end
end

fn unix(at: Option<Instant>) -> Int
    at |> Option.map(Instant.as_nanos) |> Option.with_default(0)
end

/// TCP keep-alive probes on a connection.
pub struct KeepAlive
    enabled: Bool = True
    /// How long a connection is idle before the first probe; `None` is
    /// 15 seconds.
    idle: Option<Duration> = None
    /// How long between probes; `None` is 15 seconds.
    interval: Option<Duration> = None
    /// How many probes go unanswered before the connection is dropped;
    /// `None` is 9.
    count: Option<Int> = None
end

/// How `dial` and `dial_unix` connect. A timeout past about 292 years, the
/// longest wait the clock counts, never fires. A Unix dial reads only the
/// timeout, the local address (a path) and the reuse options.
pub struct DialOptions
    /// The longest connecting may take; the context's deadline applies too.
    timeout:    Option<Duration> = None
    keep_alive: KeepAlive = KeepAlive{}
    /// The local address to connect from, `host:port`.
    local_address: Option<String> = None
    /// How long to wait for IPv6 before trying IPv4 too ("Happy
    /// Eyeballs"); `None` is 300 milliseconds.
    fallback_delay: Option<Duration> = None
    /// Asks for Multipath TCP where the system has it.
    multipath: Bool = False
    /// Sets `SO_REUSEADDR` before binding `local_address`.
    reuse_address: Bool = False
    /// Sets `SO_REUSEPORT` before binding `local_address`. Windows has
    /// none: asking there fails with `Error.Unsupported`.
    reuse_port: Bool = False
end

/// How `listen` and `listen_unix` bind. A Unix listener reads only the
/// reuse options.
pub struct ListenOptions
    /// Keep-alive for the connections it accepts.
    keep_alive: KeepAlive = KeepAlive{}
    multipath:  Bool = False
    /// Sets `SO_REUSEADDR`, so the address binds while connections an
    /// earlier listener on it closed are waiting out their end. Every TCP
    /// listener outside Windows has it set already.
    reuse_address: Bool = False
    /// Sets `SO_REUSEPORT`, so several listeners can bind the same address
    /// and the system spreads the connections among them. Windows has
    /// none: asking there fails with `Error.Unsupported`.
    reuse_port: Bool = False
end

/// Why a connection could not be made or used.
pub enum Error
    /// Nothing listens at `address`.
    Refused {address: String}
    Unreachable {address: String}
    /// The peer closed the connection under a read or write.
    Reset {address: String}
    AddressInUse {address: String}
    /// A deadline passed: the context's, an option's or the connection's.
    Timeout {address: String}
    /// The listener or connection is closed, or the task waiting was
    /// stopped.
    Closed
    /// An address that does not parse.
    InvalidAddress {address: String, reason: String}
    /// A name the resolver could not resolve.
    Dns {host: String, reason: String, server: Option<String>, not_found: Bool}
    /// A datagram longer than the `max` a receive asked for, from
    /// `address`, or "" where the system does not say (Windows). Its bytes
    /// are dropped.
    Truncated {address: String, max: Int}
    /// This system, or this kind of socket, lacks what `op` asked for.
    Unsupported {op: String, reason: String}
    /// Any other failure of `op` (`dial`, `listen`, `lookup`, `bind`,
    /// `send`, `receive`) on `address`.
    Other {op: String, address: String, reason: String}
    Tls {error: tls.Error}
end

derive Equatable for Error

impl Error
    /// The error for the parts a crossing returns: a net variant, or a
    /// tls.Error's.
    fn from_parts(parts: List<String>) -> Error
        case parts
            ["Refused", address] ->
                Error.Refused{address:}

            ["Unreachable", address] ->
                Error.Unreachable{address:}

            ["Reset", address] ->
                Error.Reset{address:}

            ["AddressInUse", address] ->
                Error.AddressInUse{address:}

            ["Timeout", address] ->
                Error.Timeout{address:}

            ["Closed"] ->
                Error.Closed

            ["InvalidAddress", address, reason] ->
                Error.InvalidAddress{address:, reason:}

            ["Dns", host, reason, server, not_found, timeout] ->
                if timeout == "true" then
                    Error.Timeout{address: host}
                else
                    Error.Dns{
                        host:,
                        reason:,
                        server:    if server == "" then None else Some(server),
                        not_found: not_found == "true",
                    }
                end

            ["Truncated", address, max] ->
                Error.Truncated{address:, max: int(max)}

            ["Unsupported", op, reason] ->
                Error.Unsupported{op:, reason:}

            ["Other", op, address, reason] ->
                Error.Other{op:, address:, reason:}

            _ ->
                Error.Tls{error: tls.Error.from_parts(parts)}
        end
    end

    /// A TLS failure as a net error.
    pub fn of_tls(error: tls.Error) -> Error
        Error.Tls{error:}
    end

    /// Whether the error is a timeout: `Error.Timeout`.
    pub fn is_timeout(error: Error) -> Bool
        case error
            .Timeout{address: _} -> True
            _                    -> False
        end
    end
end

impl Display for Error
    //! assert "${Error.Refused{address: "a:1"}}" == "connection refused by a:1"
    //
    fn to_string(error: Error) -> String
        case error
            .Refused{address:} -> "connection refused by ${address}"
            .Unreachable{address:} -> "${address} is unreachable"
            .Reset{address:} -> "the connection to ${address} was reset"
            .AddressInUse{address:} -> "${address} is already in use"
            .Timeout{address:} -> "timed out on ${address}"
            .Closed -> "the connection is closed"
            .InvalidAddress{address:, reason:} -> "invalid address ${address}: ${reason}"
            .Dns{host:, reason:, server: _, not_found: _} -> "looking up ${host}: ${reason}"
            .Truncated{address: "", max:} -> "a datagram is longer than ${max} bytes"
            .Truncated{address:, max:} -> "a datagram from ${address} is longer than ${max} bytes"
            .Unsupported{op:, reason:} -> "${op}: ${reason}"
            .Other{op:, address:, reason:} -> "${op} ${address}: ${reason}"
            .Tls{error:} -> "${error}"
        end
    end
end

/// A TCP connection to `address`, `host:port`.
pub fn dial(address: String, options: DialOptions = DialOptions{}) -> Result<Connection, Error>
    dial_on("tcp", address, options)
end

/// A connection to the Unix socket at `path`. On Linux a path that starts
/// with `@` names an abstract socket, which has no file.
pub fn dial_unix(path: String, options: DialOptions = DialOptions{}) -> Result<Connection, Error>
    dial_on("unix", path, options)
end

fn dial_on(network: String, address: String, options: DialOptions) -> Result<Connection, Error>
    k = options.keep_alive

    handle =
        http_host.dial_with(
            network,
            address,
            nanos(options.timeout),
            Option.with_default(options.local_address, ""),
            nanos(options.fallback_delay),
            k.enabled,
            nanos(k.idle),
            nanos(k.interval),
            Option.with_default(k.count, 0),
            options.multipath,
            options.reuse_address,
            options.reuse_port,
        )
        |> Result.map_err(Error.from_parts)?

    Ok(Connection{handle:})
end

/// For std::tls: a timeout in nanoseconds, 0 for `None`, held to the
/// longest wait the clock counts, about 292 years either way: a longer
/// timeout waits that long, so it never fires.
fn nanos(d: Option<Duration>) -> Int
    d
    |> Option.map(fn d ->
        Duration.as_nanos(d) |> Int.clamp(-9_223_372_036_854_775_808..=9_223_372_036_854_775_807)
    end)
    |> Option.with_default(0)
end

/// Two connections joined in memory, each end's writes the other's
/// reads, with no buffer, so a write waits for the other end to read it.
/// For tests of code that talks over a connection.
//! (a, b) = net.pipe()
//! _ = Connection.close(a)
//! assert Connection.remote_address(b) == "pipe"
//
pub fn pipe() -> (Connection, Connection)
    case http_host.pipe()
        [a, b] -> (Connection{handle: a}, Connection{handle: b})
        _      -> unreachable "host.pipe answers the two ends of one net.Pipe"
    end
end

/// Splits `host:port` (or `[host]:port`) into its host and port,
/// unbracketed.
//! assert net.split_host_port("[::1]:80") == Ok(("::1", "80"))
//
pub fn split_host_port(address: String) -> Result<(String, String), Error>
    case (http_host.split_host_port(address) |> Result.map_err(Error.from_parts)?)
        [host, port] -> Ok((host, port))
        _            -> Err(Error.InvalidAddress{address:, reason: "no host and port"})
    end
end

/// Joins a host and port into an address, bracketing an IPv6 host
/// (one that holds a `:`).
//! assert net.join_host_port("::1", "80") == "[::1]:80"
//
pub fn join_host_port(host: String, port: String) -> String
    http_host.join_host_port(host, port)
end

/// A mail exchanger a domain names.
pub struct Mx
    host:       String
    preference: NonNegativeInt
end

/// A service location a domain names.
pub struct Srv
    target:   String
    port:     NonNegativeInt
    priority: NonNegativeInt
    weight:   NonNegativeInt
end

fn lookup(kind: String, name: String) -> Result<List<String>, Error>
    http_host.lookup(kind, name) |> Result.map_err(Error.from_parts)
end

// A count or a DNS field the resolver wrote as digits, 0 for none.
fn int(text: String) -> NonNegativeInt
    String.to_int(text)
    |> Option.flat_map(fn n -> NonNegativeInt.try_from(n))
    |> Option.with_default(0)
end

/// The addresses of `host`, as the system resolver returns.
//! assert net.lookup_host("localhost")
//! |> Result.map(fn xs -> Iter.any_match(xs, fn a -> a == "127.0.0.1" or a == "::1")) == Ok(True)
//
pub fn lookup_host(host: String) -> Result<List<String>, Error>
    lookup("host", host)
end

/// The IP addresses of `host`.
pub fn lookup_ip(host: String) -> Result<List<String>, Error>
    lookup("ip", host)
end

/// The names that map to the address `ip`.
pub fn lookup_address(ip: String) -> Result<List<String>, Error>
    lookup("address", ip)
end

/// The canonical name of `host`.
pub fn lookup_cname(host: String) -> Result<String, Error>
    case lookup("cname", host)?
        [name] -> Ok(name)
        _      -> Ok("")
    end
end

/// The name servers of `domain`.
pub fn lookup_ns(domain: String) -> Result<List<String>, Error>
    lookup("ns", domain)
end

/// The TXT records of `domain`.
pub fn lookup_txt(domain: String) -> Result<List<String>, Error>
    lookup("txt", domain)
end

/// The mail exchangers of `domain`, most preferred first.
pub fn lookup_mx(domain: String) -> Result<List<Mx>, Error>
    Ok(mx_records(lookup("mx", domain)?))
end

fn mx_records(parts: List<String>) -> List<Mx>
    case parts
        [host, preference, ..rest] -> [Mx{host:, preference: int(preference)}, ..mx_records(rest)]
        _                          -> []
    end
end

/// The port number of a TCP service name, such as `"http"`.
//! assert net.lookup_port("http") == Ok(80)
//
pub fn lookup_port(service: String) -> Result<NonNegativeInt, Error>
    case lookup("port", service)?
        [port] -> Ok(int(port))
        _      -> Ok(0)
    end
end

/// The SRV records for `_service._protocol.domain`, with the canonical
/// name they were found under.
pub fn lookup_srv(
    service:  String,
    protocol: String,
    domain:   String,
) -> Result<(String, List<Srv>), Error>
    case lookup("srv", "${service} ${protocol} ${domain}")?
        [cname, ..rest] -> Ok((cname, srv_records(rest)))
        []              -> Ok(("", []))
    end
end

fn srv_records(parts: List<String>) -> List<Srv>
    case parts
        [target, port, priority, weight, ..rest] ->
            [Srv{
                target:,
                port:     int(port),
                priority: int(priority),
                weight:   int(weight),
            }, ..srv_records(rest)]

        _ ->
            []
    end
end

/// A listening socket. Close it with `Listener.close`; a program that is
/// shutting down closes every listener when its supervisors start draining.
pub opaque struct Listener
    handle: http_host.TcpListener
end

impl Listener
    /// The address it is bound to, with the port it picked for port 0, or
    /// a Unix listener's path.
    pub fn address(listener: Listener) -> String
        http_host.net_listener_address(listener.handle)
    end

    /// The next connection. `Error.Closed` once the listener is closed or
    /// the calling task is stopped.
    pub fn accept(listener: Listener) -> Result<Connection, Error>
        handle = http_host.net_accept(listener.handle) |> Result.map_err(Error.from_parts)?
        Ok(Connection{handle:})
    end

    /// An `accept` still waiting at `at` fails with `Error.Timeout`;
    /// `None` clears it.
    pub fn set_deadline(listener: Listener, at: Option<Instant>) -> Unit
        http_host.net_listener_deadline(listener.handle, unix(at))
    end

    /// Stops listening. A connection already accepted stays open.
    pub fn close(listener: Listener) -> Unit
        http_host.net_listener_close(listener.handle)
    end

    /// For std::tls: the listener a handle holds.
    fn of_handle(handle: http_host.TcpListener) -> Listener
        Listener{handle:}
    end

    /// For std::tls: the handle a listener holds.
    fn handle_of(listener: Listener) -> http_host.TcpListener
        listener.handle
    end
end

/// Binds `address`, `host:port`; port 0 picks a free one.
pub fn listen(address: String, options: ListenOptions = ListenOptions{}) -> Result<Listener, Error>
    listen_on("tcp", address, options)
end

/// Binds a Unix socket at `path`, which must not exist yet. Closing the
/// listener removes the socket file; a program that ends without closing
/// it, as a crash does, leaves the file, and binding the path again fails
/// with `Error.AddressInUse` until it is removed. On Linux a path that
/// starts with `@` names an abstract socket, which has no file.
//! import std::fs
//! import std::io.{Reader, Writer}
//! import std::path
//!
//! dir = fs.make_temp_dir()!
//! socket = path.join(dir, "echo.sock")
//! listener = net.listen_unix(socket)!
//! client = net.dial_unix(socket)!
//! server = Listener.accept(listener)!
//! _ = Writer.write_text(Connection.writer(client), "ping\n")
//! assert Reader.read_line(Connection.reader(server)) == Ok(Some("ping"))
//! assert Connection.remote_address(client) == socket
//! assert Err(Error.AddressInUse{address: socket}) = net.listen_unix(socket)
//!
//! Connection.close(client)
//! Connection.close(server)
//! Listener.close(listener)
//! assert fs.exists(socket) == Ok(False)
//! fs.remove_all_quietly(dir)
//
pub fn listen_unix(
    path:    String,
    options: ListenOptions = ListenOptions{},
) -> Result<Listener, Error>
    listen_on("unix", path, options)
end

fn listen_on(network: String, address: String, options: ListenOptions) -> Result<Listener, Error>
    k = options.keep_alive

    handle =
        http_host.net_listen_with(
            network,
            address,
            k.enabled,
            nanos(k.idle),
            nanos(k.interval),
            Option.with_default(k.count, 0),
            options.multipath,
            options.reuse_address,
            options.reuse_port,
        )
        |> Result.map_err(Error.from_parts)?

    Ok(Listener{handle:})
end

/// The listening sockets a service manager started the program with, in
/// the order it passed them. The protocol is systemd's socket activation,
/// which a parent that restarts the program without closing its sockets
/// can follow too: `LISTEN_PID` is this process's id, `LISTEN_FDS` counts
/// the sockets from descriptor 3 on, and `LISTEN_FDNAMES` names them. With
/// `name`, only those named so (systemd's `FileDescriptorName`, by default
/// the socket unit's name; `"unknown"` when nothing names them). The
/// variables are read from the process's environment, not from
/// `Startup.env`, since the sockets belong to the process.
///
/// An empty list when none were passed, or when `LISTEN_PID` names another
/// process, and always on Windows, which has no such protocol. A datagram
/// socket among them is `udp.inherited_sockets`'. Each socket is taken
/// once for the process: every call returns the same listeners, so no
/// socket is opened twice, and one closed stays closed. A Unix socket's
/// file stays when it closes, since the service manager made it. Pass one
/// to `http.Server`'s `listener` to serve HTTP on it.
//! assert net.inherited_listeners() |> Result.map(List.length) == Ok(0)
//! assert net.inherited_listeners(name: Some("web")) |> Result.map(List.length) == Ok(0)
//
pub fn inherited_listeners(name: Option<String> = None) -> Result<List<Listener>, Error>
    http_host.inherited_listeners(name)
    |> Result.map(fn handles -> handles |> Iter.map(Listener.of_handle) |> Iter.to_list())
    |> Result.map_err(Error.from_parts)
end

/// Handles each connection `listener` accepts with `handler`, each as a
/// task of `supervisor`, and closes the connection when the handler
/// returns. Returns when the listener is closed or the calling task is
/// stopped, as at shutdown, after closing the listener.
pub fn serve(listener: Listener, handler: (Connection) -> Unit, supervisor: Supervisor) -> Unit
    defer Listener.close(listener)
    accept_each(listener, handler, supervisor)
end

fn accept_each(listener: Listener, handler: (Connection) -> Unit, supervisor: Supervisor) -> Unit
    case Listener.accept(listener)
        Ok(conn) ->
            _ = Supervisor.spawn(supervisor, fn ->
                defer Connection.close(conn)
                handler(conn)
            end)

            accept_each(listener, handler, supervisor)

        Err(_) ->
            Unit
    end
end
