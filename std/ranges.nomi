import
    bool.Bool.{self, False, True}
    comparable.Comparable
    contains.Contains
    debug.Debug
    discrete.Discrete
    display.Display
    int.Int
    iter.Iter
    lists.List
    option.Option.{self, None, Some}
    steppable.Steppable
    strings.String
end

//# Ranges: `1..5` holds 1 to 4, `1..=5` holds 1 to 5, and `Range.from(n)`
//# has no end. A range's own functions are `contains`, `start`, `stop`,
//# `is_inclusive`, `is_bounded`, `from`, `naturals` and `step_by`.
//#
//# A range over a type that implements `Discrete`, such as `Int`, is also
//# an `Iter`, so every `Iter` function works on it: `Iter.to_list(1..=3)`
//# is `[1, 2, 3]` and `Iter.count(1..5)` is 4. An unbounded range is
//# `Iter.is_infinite`. Limit it with `Iter.take` or `Iter.take_while`
//# before collecting it: `Iter.to_list` of one never finishes, which is a
//# compile error where the compiler can see the range is unbounded and an
//# error when the program runs otherwise. `Iter.known_count(r)` is
//# `Some(n)` for a bounded range and `None` for an unbounded one.

/// A range of values of a `Comparable` type. A range literal makes one:
/// `1..5`, `"a".."z"` and `0.0..=1.0` hold their start, their end and
/// whether the range includes its end. A range from `Range.from(n)` or
/// `Range.naturals()` has no end.
///
/// A `Range<T>` is an `Iter<T>` when `T` is also `Discrete`. A range over
/// any other comparable type, such as `Float` or `String`, still answers
/// `contains`.
//! assert Iter.to_list(1..=3) == [1, 2, 3]
//! assert Iter.count(1..5) == 4
//! assert Range.from(10) |> Iter.take(3) |> Iter.to_list() == [10, 11, 12]
//! assert Iter.known_count(1..5) == Some(4)
//! assert Iter.known_count(Range.from(1)) == None
//
pub opaque struct Range<T> where T: Comparable
    start:     T
    stop:      Option<T>
    inclusive: Bool
end

/// A range that holds at least one value: `a..b` with `a < b`, `a..=b` with
/// `a <= b`, or an unbounded `Range.from(n)`. It is the parent of
/// `ClosedRange` and `BoundedRange`, so an error for a backwards literal
/// names this rule. A Float range with a NaN end holds nothing, since no
/// value is `<=` NaN, so it is no NonEmptyRange. It is in the prelude.
//! import std::float.Float
//!
//! r: NonEmptyRange<Int> = 3..4
//! assert Range.contains(r, Range.start(r))
//! assert NonEmptyRange.try_from(4..4) == None
//! assert NonEmptyRange.try_from(4..=4) == Some(4..=4)
//! assert NonEmptyRange.try_from(0.0..=Float.nan()) == None
//
pub refine NonEmptyRange<T> Range<T> where T: Comparable when fn r ->
    Range.contains(r, Range.start(r))
end

/// A non-empty range that holds its end, `a..=b` with `a <= b`, or an
/// unbounded `Range.from(n)`, which has no end. It is what `clamp` takes: a
/// value past an exclusive end has no last value in the range to go to. It
/// is in the prelude.
//! assert Int.clamp(15, 0..=10) == 10
//! assert ClosedRange.try_from(0..10) == None
//! assert ClosedRange.try_from(Range.from(0)) == Some(Range.from(0))
//
pub refine ClosedRange<T> NonEmptyRange<T> where T: Comparable when fn r ->
    Range.is_inclusive(r) or not Range.is_bounded(r)
end

/// A non-empty range with an end, `a..b` with `a < b` or `a..=b` with
/// `a <= b`. It is what `random` draws from. It is in the prelude.
//! assert BoundedRange.try_from(1..=6) == Some(1..=6)
//! assert BoundedRange.try_from(Range.from(1)) == None
//
pub refine BoundedRange<T> NonEmptyRange<T> where T: Comparable when fn r -> Range.is_bounded(r)

impl Range<T>
    /// Returns the range that starts at `n` and has no end, a ClosedRange of
    /// `n`'s type. Where a `ClosedRange<NonNegativeInt>` is expected,
    /// `Range.from(2)` is one, and its literal start is checked when the
    /// program is compiled. As an iterator it is `Iter.is_infinite`: limit
    /// it with `Iter.take` before `Iter.to_list` or any other function that
    /// must reach the end, which never finishes on it. An Int has no largest
    /// value, so the range goes on past 64 bits.
    //! assert Range.contains(Range.from(1), 100)
    //! refute Range.is_bounded(Range.from(1))
    //! assert Iter.is_infinite(Range.from(1))
    //! assert Range.from(1) |> Range.step_by(2) |> Iter.is_infinite()
    //! top = 9_223_372_036_854_775_807
    //! assert Range.from(top) |> Iter.take(2) |> Iter.to_list() == [top, top + 1]
    //! assert Range.contains(Range.from(0.5), 2.25)
    //! refute Range.contains(Range.from("m"), "a")
    //
    pub fn from<T>(n: T) -> ClosedRange<T> where T: Comparable
        ClosedRange.unchecked(Range{start: n, stop: None, inclusive: False})
    end

    /// Returns the range of Ints that starts at 0 and has no end. Limit it
    /// with `Iter.take` before collecting it.
    //! assert Range.contains(Range.naturals(), 0)
    //! refute Range.contains(Range.naturals(), -1)
    //! assert Range.naturals() |> Iter.take(3) |> Iter.to_list() == [0, 1, 2]
    //
    pub fn naturals() -> ClosedRange<Int>
        ClosedRange.unchecked(Range{start: 0, stop: None, inclusive: False})
    end

    /// Returns a lazy `Iter` that walks the range in steps of `by`.
    ///
    /// A range iterates by itself only when its type is `Discrete`.
    /// `step_by` walks any range whose type is `Steppable` by the step's
    /// type: a `Range<Int>` steps by an `Int`, a `Range<Decimal>` by a
    /// `Decimal`, exactly, and a calendar type steps by `Days` when it
    /// implements `Steppable<Days>`.
    ///
    /// The walk goes the way `by` moves the start. A step that moves it down
    /// counts down from the start to the end, so `Range.step_by(5..=1, -1)`
    /// is 5, 4, 3, 2, 1, and `5..1` leaves out 1 as any exclusive range
    /// leaves out its end. A range whose end lies the other way from the
    /// step yields nothing (`Range.step_by(1..=5, -1)`), and so does a step
    /// that does not move. A plain `5..=1` is empty: only a step counts down.
    //! assert 1.0d..=1.3d
    //!     |> Range.step_by(0.1d)
    //!     |> Iter.to_list()
    //!     |> List.equal([1.0d, 1.1d, 1.2d, 1.3d])
    //!
    //! assert 5..=1 |> Range.step_by(-1) |> Iter.to_list() == [5, 4, 3, 2, 1]
    //! assert 10..0 |> Range.step_by(-3) |> Iter.to_list() == [10, 7, 4, 1]
    //! assert 1..=5 |> Range.step_by(-1) |> Iter.to_list() == []
    //! assert 1..=5 |> Range.step_by(0) |> Iter.to_list() == []
    //! assert 5..=1 |> Iter.to_list() == []
    //
    pub fn step_by<T, S>(r: Range<T>, by: S) -> Iter<T> where T: Comparable and Steppable<S>
        StepByRange{range: r, by:}
    end

    /// True if the range has an end. Check it before passing a range that
    /// may be unbounded to `Iter.to_list`.
    //! assert Range.is_bounded(1..5)
    //! refute Range.is_bounded(Range.from(1))
    //
    pub fn is_bounded<T>(r: Range<T>) -> Bool
        case r.stop
            Some(_) -> True
            None    -> False
        end
    end

    /// The value the range starts at, which it always contains unless it is
    /// empty.
    //! assert Range.start(2..5) == 2
    //! assert Range.start(Range.from(7)) == 7
    //
    pub fn start<T>(r: Range<T>) -> T
        r.start
    end

    /// The range's end, `None` for an unbounded range. Whether the range
    /// holds it is `Range.is_inclusive`.
    //! assert Range.stop(2..5) == Some(5)
    //! assert Range.stop(2..=5) == Some(5)
    //! assert Range.stop(Range.from(7)) == None
    //
    pub fn stop<T>(r: Range<T>) -> Option<T>
        r.stop
    end

    /// Whether the range holds its end: `True` for `a..=b`, `False` for
    /// `a..b` and for an unbounded range, which has no end to hold.
    //! assert Range.is_inclusive(2..=5)
    //! refute Range.is_inclusive(2..5)
    //! refute Range.is_inclusive(Range.from(7))
    //
    pub fn is_inclusive<T>(r: Range<T>) -> Bool
        r.inclusive
    end
end

impl Contains for Range<T> where T: Comparable
    /// Whether `x` is in the range: two comparisons. An exclusive range
    /// leaves out its end, and an unbounded range checks only the start.
    //! assert Range.contains(1..5, 1)
    //! assert Range.contains(1..5, 3)
    //! refute Range.contains(1..5, 5)
    //! refute Range.contains(1..5, 0)
    //! assert Range.contains(1..=5, 5)
    //! refute Range.contains(1..=5, 6)
    //! assert Range.contains(1.25d..=2.50d, 1.50d)
    //
    fn contains(c: Range<T>, x: T) -> Bool
        case c.stop
            Some(e) ->
                if c.inclusive then
                    x >= c.start and x <= e
                else
                    x >= c.start and x < e
                end

            None ->
                x >= c.start
        end
    end
end

impl Display for Range<T> where T: Debug
    // Use Debug for endpoints so every comparable value can be rendered, even
    // if it has no user-facing Display impl.
    /// The range as its literal, each endpoint in its `Debug` form:
    /// `start..end`, `start..=end`, or `start..` for an unbounded range.
    /// `Debug` renders a range the same way.
    //! assert Display.to_string(1..5) == "1..5"
    //! assert Display.to_string("a"..="z") == "\"a\"..=\"z\""
    //! assert Display.to_string(Range.from(3)) == "3.."
    //! assert Debug.inspect(1..=5) == Display.to_string(1..=5)
    //
    fn to_string(r: Range<T>) -> String
        start_str = Debug.inspect(r.start)

        case r.stop
            Some(e) ->
                sep = if r.inclusive then "..=" else ".."
                start_str + sep + Debug.inspect(e)

            None ->
                start_str + ".."
        end
    end
end

impl Debug for Range<T> where T: Debug
    fn inspect(r: Range<T>) -> String
        to_string(r)
    end
end

opaque struct StepByRange<T, S> where T: Comparable
    range: Range<T>
    by:    S
end

impl Iter for StepByRange<T, S> where T: Comparable and Steppable<S>
    fn each_while(s: StepByRange<T, S>, yield: (T) -> Bool) -> Bool
        r = s.range
        step = T.step_by(r.start, s.by)

        // The walk goes the way the step goes: down to the end when it moves
        // the start down, up to it otherwise.
        down =
            case step
                Some(next) -> next < r.start
                None       -> False
            end

        in_bounds =
            case r.stop
                Some(e) ->
                    if down and r.inclusive then
                        r.start >= e
                    else if down then
                        r.start > e
                    else if r.inclusive then
                        r.start <= e
                    else
                        r.start < e
                    end

                None ->
                    True
            end

        if in_bounds == False then
            True
        else
            case step
                // No further step exists (the element type saturated): `r.start` is
                // the last element.
                None ->
                    yield(r.start)

                Some(next) ->
                    moved = next < r.start or next > r.start

                    if moved == False then
                        // A zero step would spin forever; stop without emitting, which is
                        // what the pull form's `None` meant here.
                        True
                    else
                        if yield(r.start) then
                            each_while(StepByRange{
                                range: Range{
                                    start:     next,
                                    stop:      r.stop,
                                    inclusive: r.inclusive,
                                },
                                by: s.by,
                            }, yield)
                        else
                            False
                        end
                    end
            end
        end
    end
end

// `is_infinite` is returned by the Range's view rather than written here: an
// unbounded Range is endless, a rule over Int that a body generic in `T`
// cannot state.
impl Iter for Range<T> where T: Discrete
    fn known_count(r: Range<T>) -> Option<Int>
        case r.stop
            Some(e) ->
                if r.start > e then
                    Some(0)
                else
                    case Discrete.steps_between(r.start, e)
                        Some(n) -> Some(if r.inclusive then n + 1 else n)
                        None    -> None
                    end
                end

            None ->
                None
        end
    end

    fn each_while(r: Range<T>, yield: (T) -> Bool) -> Bool
        done =
            case r.stop
                Some(e) -> if r.inclusive then r.start > e else r.start >= e
                None    -> False
            end

        if done then
            True
        else
            case Discrete.next(r.start)
                // The element type saturated: `r.start` is the last element.
                None ->
                    yield(r.start)

                Some(next) ->
                    if yield(r.start) then
                        each_while(Range{start: next, stop: r.stop, inclusive: r.inclusive}, yield)
                    else
                        False
                    end
            end
        end
    end
end
