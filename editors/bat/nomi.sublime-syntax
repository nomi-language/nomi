%YAML 1.2
---
name: Nomi
file_extensions: [nomi]
scope: source.nomi

variables:
  ident: '[a-z_][a-zA-Z0-9_]*\??'
  type_ident: '[A-Z][a-zA-Z0-9_]*'
  import_path_keyword: 'and|as|assert|break|case|continue|dbg|defer|else|enum|export|extern|fn|for|go|gopkg|if|impl|import|interface|once|opaque|or|pub|refute|return|self|setup|struct|tap|test|then|todo|try|type(alias)?|where|with'

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: keywords
    - include: operators
    - include: identifiers
    - include: punctuation

  comments:
    # A `#!` interpreter line. The compiler accepts it only as the first
    # line; syntect matches line by line, so this cannot tell line 1 apart.
    - match: '^#!.*$'
      scope: comment.line.shebang.nomi
    - match: '///.*$'
      scope: comment.block.documentation.nomi
    - match: '//.*$'
      scope: comment.line.double-slash.nomi

  strings:
    - match: '`'
      scope: punctuation.definition.string.begin.nomi
      push: raw_string
    - match: '"""'
      scope: punctuation.definition.string.begin.nomi
      push: triple_string
    # A codepoint literal: one character or one escape in single quotes,
    # `'a'`, `'\n'`, `'\''`, `'\u{7F}'`.
    - match: '('')(?:(\\(?:[nrt\\'']|u\{[0-9a-fA-F]+\}))|[^''\\\n])('')'
      scope: constant.character.nomi
      captures:
        1: punctuation.definition.string.begin.nomi
        2: constant.character.escape.nomi
        3: punctuation.definition.string.end.nomi
    - match: '"'
      scope: punctuation.definition.string.begin.nomi
      push: string

  string:
    - meta_scope: string.quoted.double.nomi
    - match: '\\u\{[0-9a-fA-F]+\}'
      scope: constant.character.escape.unicode.nomi
    - match: '\\([nrt\\"]|\$\{)'
      scope: constant.character.escape.nomi
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.nomi
      push: interpolation
    - match: '"'
      scope: punctuation.definition.string.end.nomi
      pop: true

  triple_string:
    - meta_scope: string.quoted.triple.nomi
    # No escape processing except `\${`, a literal `${`.
    - match: '\\\$\{'
      scope: constant.character.escape.nomi
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.nomi
      push: interpolation
    - match: '"""'
      scope: punctuation.definition.string.end.nomi
      pop: true

  raw_string:
    - meta_scope: string.quoted.other.nomi
    - match: '`'
      scope: punctuation.definition.string.end.nomi
      pop: true

  interpolation:
    - meta_scope: meta.interpolation.nomi
    - match: '\}'
      scope: punctuation.section.interpolation.end.nomi
      pop: true
    - include: main

  numbers:
    - match: '\b0x[0-9a-fA-F][0-9a-fA-F_]*\b'
      scope: constant.numeric.integer.hex.nomi
    - match: '\b0b[01][01_]*\b'
      scope: constant.numeric.integer.binary.nomi
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?[dD]\b'
      scope: constant.numeric.decimal.nomi
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\b'
      scope: constant.numeric.float.nomi
    - match: '\b[0-9][0-9_]*\b'
      scope: constant.numeric.integer.nomi

  keywords:
    - match: '(^\s*)(//!)(\s*)'
      captures:
        2: comment.line.prompt.nomi
        3: comment.line.prompt.nomi
    # Keyword-shaped import path segments are filenames, not language syntax:
    # `std/structs.Struct` should color `structs` like a path segment while the
    # `as` after the path still colors as a keyword.
    - match: '\b({{import_path_keyword}})\b(?=/)|(?<=/)\b({{import_path_keyword}})\b'
      scope: variable.other.nomi
    - match: '\bhost\b(?=\s+(fn|type)\b)'
      scope: keyword.declaration.nomi
    # A keyword declaration Nomi builds in (`message cart_items(...)`,
    # `noun item`): its keyword and its name, at the start of a line.
    - match: '^(?:(pub)\s+)?(message|noun|macro)\s+([a-z_][A-Za-z0-9_?]*)'
      captures:
        1: keyword.declaration.nomi
        2: keyword.declaration.nomi
        3: entity.name.function.nomi
    # A declaration written with a macro's keyword, marked with `!` and
    # qualified by its file or bare (`sqlkit.query! orders`, `query! orders`):
    # the keyword and its `!` read as a macro.
    - match: '^(?:(pub)\s+)?(?:([a-z_][A-Za-z0-9_]*)(\.))?([a-z_][A-Za-z0-9_]*!)\s+([a-z_][A-Za-z0-9_?]*)'
      captures:
        1: keyword.declaration.nomi
        2: entity.name.namespace.nomi
        3: punctuation.accessor.nomi
        4: entity.name.function.macro.nomi
        5: entity.name.function.nomi
    # One that declares a type (`choices.one_of! Size`): its name reads as
    # a type's.
    - match: '^(?:(pub)\s+)?(?:([a-z_][A-Za-z0-9_]*)(\.))?([a-z_][A-Za-z0-9_]*!)\s+([A-Z][A-Za-z0-9_]*)'
      captures:
        1: keyword.declaration.nomi
        2: entity.name.namespace.nomi
        3: punctuation.accessor.nomi
        4: entity.name.function.macro.nomi
        5: entity.name.type.nomi
    # `variant`, `open`, and `derive` are CONTEXTUAL keywords in Nomi
    # — `variant` and `open` only carry meaning inside interface bodies, and
    # `derive` in `derive Iface for T`.
    # Sublime-syntax is
    # regex-based with no easy body context-stack, so we match them
    # globally as keywords. Bare uses outside those bodies (e.g.
    # `open = 42`) are conventionally rare; the test programs only
    # mention them inside comments, which the `comments` context already
    # swallows before this rule can fire.
    - match: '\b(pub|opaque|export|once|fn|type|struct|enum|interface|impl|derive|for|go|gopkg|extends|embeds|typealias|extern|import|as|where|with|defer|test|setup|self|variant|open)\b'
      scope: keyword.declaration.nomi
    # `clock` and `boot` are keywords only as a test group's lines
    # (`clock Clock.Virtual`, `boot server.boot(startup())`); `MyApp.clock`,
    # `server.boot` and a `clock` binding stay names.
    - match: '^\s*(clock|boot)\b(?=[ \t]+[A-Za-z_(])'
      captures:
        1: keyword.declaration.nomi
    # `subtests` is a keyword only where a statement starts with it and its
    # rows follow (`subtests cases, #(a, b) { ... }`); `subtests = 3` and
    # `subtests(2)` stay names.
    - match: '^\s*(subtests)\b(?=[ \t]+[^\s=.,:|)\]}-])'
      captures:
        1: keyword.control.nomi
    # `group` is a keyword only where a top-level line starts with it and the
    # group's name string follows (`group "parsing" { ... }`), or its `{`
    # with the name missing (`group { ... }`, which the compiler reports);
    # `group = 3` and `group(2)` stay names.
    - match: '^(group)\b(?=[ \t]*["{])'
      captures:
        1: keyword.declaration.nomi
    # `internal` path segment in imports — the packaging convention
    # for sub-tree access barriers. Matches `internal` only when
    # followed by `/`, so bare `internal` identifiers (rare; not a
    # reserved word in Nomi) aren't affected. Scope chosen for
    # visual distinctness in common bat themes; semantically it's
    # access-scope metadata, not a namespace name.
    - match: '\binternal(?=/)'
      scope: entity.other.attribute-name.nomi
    - match: '\b(if|else|case|when|break|continue|return|concurrent|try|then|tap|assert|refute|dbg|todo)\b'
      scope: keyword.control.nomi
    - match: '\b(and|or)\b'
      scope: keyword.operator.word.nomi
    - match: '\b(true|false)\b'
      scope: constant.language.nomi

  operators:
    # A map or set literal starts with `%` written right before its bracket
    # or its type name: `%{`, `%[`, `%Kvs{`, `%.Obj{`, `%geo.Tags[`. A `%`
    # with a space after it is the remainder operator.
    - match: '%(?=[\{\[.A-Z]|{{ident}}\.[A-Z])'
      scope: punctuation.section.nomi
    - match: '\|>|->|=>|==|!=|<=|>=|\.\.=|\.\.'
      scope: keyword.operator.nomi
    - match: '[+\-*/%<>!=]'
      scope: keyword.operator.nomi

  identifiers:
    # Dot-leading variant shorthand: `.Red`, `.Circle(1.0)`, `#.Circle{...}`.
    # Listed first (first-wins per the syntect priority order) so the
    # leading dot + identifier pair is scoped together, with the
    # identifier itself reading as a type/constructor consistent with
    # the qualified `Color.Red` form below. The dot is scoped as
    # punctuation to match other separator tokens.
    - match: '(\.)({{type_ident}})\b'
      captures:
        1: punctuation.separator.nomi
        2: storage.type.nomi
    - match: '\b{{type_ident}}\b'
      scope: storage.type.nomi
    # A capture's parameter, `&1`, and the capture's `&`, written against
    # the function's body: `&(&1 > 2)`, `&f(&1)`, `&#Point{x: &1}`.
    - match: '&[1-9][0-9]*'
      scope: variable.parameter.nomi
    - match: '&(?=[(\[#%.A-Za-z])'
      scope: keyword.other.capture.nomi
    - match: '\b_(?!_)[a-zA-Z0-9_]*\??\b'
      scope: comment.discard.nomi
    - match: '\b{{ident}}(?=\s*\()'
      scope: variable.function.nomi
    - match: '\b{{ident}}'
      scope: variable.other.nomi

  punctuation:
    # `#` starts a struct, tuple or vector literal: `#{`, `#(`, `#[`, or
    # with the type name right after it, `#Point{`, `#.Circle{`,
    # `#geo.Point{`.
    - match: '#(?=[\{(\[.A-Z]|{{ident}}\.[A-Z])'
      scope: punctuation.section.nomi
    - match: '[,.:;]'
      scope: punctuation.separator.nomi
    - match: '[(){}\[\]]'
      scope: punctuation.section.nomi
