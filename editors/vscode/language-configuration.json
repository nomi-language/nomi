{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"],
    ["'", "'"]
  ],
  "wordPattern": "\\d[\\d_]*(?:\\.\\d[\\d_]*)?[dD]?|[A-Za-z_][A-Za-z0-9_]*\\??",
  "indentationRules": {
    "increaseIndentPattern": "^(?:\\s*(?:pub\\s+)?(?:opaque\\s+)?(?:fn|struct|enum|interface|impl|test|group|subtests)\\b(?!.*\\bend\\s*(?://.*)?$).*|\\s*(?:pub\\s+)?import|.*(?:\\bthen|\\belse|\\bbegin|\\bconcurrent|->|[\\{\\(\\[])|(?:\\s*|.*[=(,]\\s*|.*\\|>\\s*)case\\b.*)\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else\\b|[\\}\\)\\]])"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*///",
      "action": { "indent": "none", "appendText": "/// " }
    },
    {
      "beforeText": "^\\s*//!",
      "action": { "indent": "none", "appendText": "//! " }
    },
    {
      "beforeText": "^\\s*//#",
      "action": { "indent": "none", "appendText": "//# " }
    }
  ]
}
