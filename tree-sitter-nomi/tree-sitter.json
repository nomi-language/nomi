{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nomi",
      "camelcase": "Nomi",
      "title": "Nomi",
      "scope": "source.nomi",
      "file-types": ["nomi"],
      "injection-regex": "^nomi$",
      "class-name": "TreeSitterNomi",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Tree-sitter grammar for the Nomi programming language",
    "authors": [
      {
        "name": "David Baldwin"
      }
    ],
    "links": {
      "repository": "https://github.com/nomi-language/tree-sitter-nomi"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
