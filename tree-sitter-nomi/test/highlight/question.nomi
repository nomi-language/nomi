// A postfix `?` can return from the function, as `return` does, so it reads
// as a keyword. The caret lines below each line name the highlight of the
// token they point at.
pub fn half(n: Int) -> Result<Int, String>
    if n % 2 == 0 then Ok(n / 2) else Err("odd")
end

pub fn quarter(n: Int) -> Result<Int, String>
    half(half(n)?)
    //          ^ keyword
    // <- function.call
end

pub fn parsed(text: String) -> Maybe<Int>
    n = String.to_int(text)?
    //                     ^ keyword
    Some(n + 1)
end

pub fn halved(n: Int) -> Result<Int, String>
    m = n |> then? &half(&1)
    //           ^ keyword
    Ok(m)
end
