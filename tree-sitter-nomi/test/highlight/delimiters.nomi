// The delimiters of data shape are highlighted as type, the colour of a struct
// name: a literal that builds a value (struct, anonymous struct, map and
// update braces, list, vector and set brackets, tuple parentheses, and the
// `#` or `%` a literal starts with), a constructor call's parentheses
// (`Some(1)`, `Shape.Circle(2)`, `Balance(5)`), and every pattern's
// delimiters, including a pattern spelled as the expression it looks like. Program structure keeps punctuation.bracket: function
// calls, grouping, parameter lists and types; bodies are closed by the keyword `end`. A
// string interpolation keeps punctuation.special. The caret lines below each
// line name the highlight of the token they point at.
import std::json

struct Point
    x: Int
    y: Int
end

struct Geo
    city: String
    zip: String
end

struct User
    name: String
    geo: Geo
    tags: List<Int>
end

enum Shape
    Rect {w: Int, h: Int}
    //   ^ punctuation.bracket
    //                  ^ punctuation.bracket
    Dot
    Circle Int
end

type Kvs Map<String, Int>

type Items List<Int>

interface Named
    fn name(value: self) -> String
    //     ^ punctuation.bracket
    //                 ^ punctuation.bracket
end

impl Named for Point
    fn name(_value: Point) -> String
        // ^ punctuation.bracket
        "point"
    end
end

fn struct_literal() -> Point
    //           ^ punctuation.bracket
    Point{x: 1, y: 2}
    // <- type
    //   ^ type
    //              ^ type
end

fn interpolation() -> String
    n = 1
    "n is ${n}"
    //    ^ punctuation.special
    //       ^ punctuation.special
end

fn variant_literal() -> Shape
    Shape.Rect{w: 2, h: 3}
    //        ^ type
    //                   ^ type
end

fn dot_variant_literal() -> Shape
    .Rect{w: 2, h: 3}
    //   ^ type
    //              ^ type
end

fn record() -> {a: Int, b: Int}
    //         ^ punctuation.bracket
    //                        ^ punctuation.bracket
    {a: 1, b: 2}
    // <- type
    //         ^ type
end

fn take(r: {a: Int}) -> Int
    r.a
end

fn record_argument() -> Int
    take({a: 1})
    //  ^ punctuation.bracket
    //   ^ type
    //        ^ type
    //         ^ punctuation.bracket
end

fn record_binding() -> Int
    r = {a: 1, b: 2}
    //  ^ type
    //             ^ type
    r.a + r.b
end

fn map_literal() -> Map<String, Int>
    {"k" => 1, "j" => 2}
    // <- type
    //                 ^ type
end

fn map_construction() -> Kvs
    Kvs{"k" => 1}
    // <- type
    // ^ type
    //          ^ type
end

fn struct_update(user: User) -> User
    {..user, name: "x"}
    // <- type
    //                ^ type
end

fn bare_update(user: User) -> User
    {..user, geo: {.., city: "NYC"}, tags: [0, ..]}
    // <- type
    //            ^ type
    //                            ^ type
    //                                     ^ type
    //                                           ^ type
    //                                            ^ type
end

fn map_update(m: Map<String, Int>) -> Map<String, Int>
    {..m, "k" => 3}
    // <- type
    //            ^ type
end

fn list_literal(xs: List<Int>) -> List<Int>
    [1, ..xs]
    // <- type
    //      ^ type
end

fn typed_list() -> Items
    Items[1, 2]
    //   ^ type
    //        ^ type
end

fn vector_literal() -> Vector<Int>
    [1, 2]
    // <- type
    //   ^ type
end

fn set_literal(s: Set<Int>) -> Set<Int>
    [..s, 3]
    // <- type
    //     ^ type
