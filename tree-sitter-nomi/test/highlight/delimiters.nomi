type Path Vector<Int>

type Tags Set<String>

type Pair (Int, Int)

fn named_literals() -> (Path, Tags, Int)
    path = Path[1, 2]
    //     ^ type
    //         ^ type
    //              ^ type
    tags = Tags["a"]
    //     ^ type
    //         ^ type
    //             ^ type
    pair = Pair(1, 2)
    //         ^ type
    //              ^ type
    Pair(a, b) = pair
    //  ^ type
    //       ^ type
    (path, tags, a + b)
end

fn shape_arms(v: Vector<Int>, s: Set<String>) -> Int
    from_v = case v
        [a, ..] -> a
        // <- type
        //    ^ type
        _ -> 0
    end

    from_s = case s
        ["a", ..] -> 1
        // <- type
        //      ^ type
        _ -> 0
    end

    from_v + from_s
end

fn tuple_literal() -> (Int, String)
    //                ^ punctuation.bracket
    //                            ^ punctuation.bracket
    (1, "x")
    // <- type
    //     ^ type
end

fn nested_tuples() -> ((Int, Int), List<(Int, Int)>)
    ((1, 2), [(3, 4)])
    // <- type
    //       ^ type
    //        ^ type
    //             ^ type
    //               ^ type
end

fn grouping(p: Point) -> Int
    (p.x + p.y) * (Named.name(p) |> String.length())
    // <- punctuation.bracket
    //        ^ punctuation.bracket
    //            ^ punctuation.bracket
    //                       ^ punctuation.bracket
    //                                             ^ punctuation.bracket
end

fn if_block(flag: Bool) -> Int
    if flag then 1 else 2
    //      ^ keyword
    //             ^ keyword
end

fn blocks(xs: List<Int>, n: Int) -> Int
    total =
        xs
        |> Iter.map(fn x ->
            //     ^ punctuation.bracket
            x + n
        end)
        // <- keyword
        |> Iter.reduce(0, fn a, b -> a + b)

    case total
        100 -> n
        _ -> total
    end
end

fn tuple_param((a, b): (Int, Int), Point{x:, y:}) -> Int
    //         ^ type
    //              ^ type
    //                 ^ punctuation.bracket
    //                                  ^ type
    //                                         ^ type
    a + b + x + y
end

fn tuple_lambda(pairs: List<(Int, Int)>) -> Int
    pairs |> Iter.map(fn (a, _b) -> a) |> Iter.reduce(0, fn s, n -> s + n)
    //                   ^ type
    //                         ^ type
end

fn struct_lambda(points: List<Point>) -> Int
    points |> Iter.map(fn Point{x:, y: _y} -> x) |> Iter.reduce(0, fn s, n -> s + n)
    //                         ^ type
    //                                   ^ type
end

fn bindings(pair: (Int, Int), user: User, m: Map<String, Int>) -> Int
    (a, b) = pair
    // <- type
    //   ^ type
    {name:, geo:} = user
    // <- type
    //          ^ type
    {"k" => v} = m else return 0
    //       ^ type
    a + b + v + String.length(name) + String.length(geo.city)
end

fn nested_bindings(nested: ((Int, Int), Int), p: Point) -> Int
    ((a, b), c) = nested
    // <- type
    //    ^ type
    //        ^ type
    {x: _c, y:} as q = p
    // <- type
    //        ^ type
    a + b + c + y + q.x
end

fn else_bindings(found: Maybe<(Int, List<Int>)>, r: Result<{a: Int}, String>) -> Int
    Some((n, [first, .._rest])) = found else
        //   ^ type
        //                  ^ type
        //                   ^ type
        return 0
    end

    Ok({a: 1} as whole) = r else
        //  ^ type
        _ -> return 1
    end

    n + first + whole.a
end

fn case_arms(r: Result<(Int, Point), String>, v: List<Int>, m: Map<String, Int>) -> Int
    from_r = case r
        Ok((0, Point{x:, y:})) -> x + y
        // ^ type
        //          ^ type
        //                 ^ type
        //                  ^ type
        Ok((n, _)) -> n
        // ^ type
        //      ^ type
        Err(_) -> 0
    end

    from_v = case v
        [a, b] -> a + b
        // <- type
        //   ^ type
        _ -> 0
    end

    from_m = case m
        {"k" => k} -> k
        // <- type
        //       ^ type
        _ -> 0
    end

    from_r + from_v + from_m
end

fn guard_arms(found: Maybe<(Int, Int)>) -> Int
    found |> case
        Some((a, b)) when a > b -> a
        //  ^ type
        //         ^ type
        //   ^ type
        //        ^ type
        Some((_, b)) -> b
        //  ^ type
        //         ^ type
        //   ^ type
        //        ^ type
        None -> 0
    end
end

test "pattern assertion"
    r: Result<(Int, List<Int>), String> = Ok((1, [2]))
    //        ^ punctuation.bracket
    //                                       ^ type
    //                                           ^ type
    //                                             ^ type
    //                                              ^ type
    assert Ok((1, [n])) = r
    //        ^ type
    //            ^ type
    //              ^ type
    //               ^ type
    assert n == 2
    found: Maybe<(Int, List<Int>)> = Some((1, [2, 3]))
    //                                   ^ type
    //                                    ^ type
    //                                        ^ type
    //                                              ^ type
    //                                               ^ type
    assert Some((m, [first, .._rest])) = found
    //          ^ type
    //              ^ type
    //                             ^ type
    //                              ^ type
    assert m + first == 3
    rec: Result<{a: Int, b: Int}, String> = Ok({a: 1, b: 2})
    assert Ok({a: 1, b:}) = rec
    //       ^ type
    //        ^ type
    //                 ^ type
    assert b == 2
    e: Result<Int, String> = Err("no")
    //                          ^ type
    //                               ^ type
    assert Err(_) = e
    //        ^ type
    //          ^ type
end

type Balance Int

enum Two
    Both (Int, String)
end

fn variant_call() -> Result<Int, String>
    Err("x")
    // ^ type
    //     ^ type
end

fn some_call() -> Maybe<Int>
    Some(1)
    //  ^ type
    //    ^ type
end

fn qualified_variant_call() -> Shape
    Shape.Circle(2)
    //          ^ type
    //            ^ type
end

fn module_variant_call() -> json.Json
    json.Json.Int(1)
    //           ^ type
    //             ^ type
end

fn dot_variant_call() -> Shape
    .Circle(2)
    //     ^ type
    //       ^ type
end

fn distinct_call() -> Balance
    Balance(5)
    //     ^ type
    //       ^ type
end

fn print_balance(_account: Balance) -> String
    //          ^ punctuation.bracket
    //                            ^ punctuation.bracket
    "balance"
end

fn function_calls(n: Int) -> String
    print_balance(Balance(n)) + Int.to_string(n)
    //           ^ punctuation.bracket
    //                   ^ type
    //                     ^ type
    //                      ^ punctuation.bracket
    //                                       ^ punctuation.bracket
    //                                         ^ punctuation.bracket
end

fn pipe_constructs(n: Int) -> (Maybe<Int>, Result<Int, String>)
    pair = (n |> Some(), n |> then &Ok(&1))
    //     ^ type
    //               ^ type
    //                ^ type
    //                                ^ type
    //                                   ^ type
    //                                    ^ type
    pair
end

// A partial capture of a constructor is @type too: its call parses as the
// pattern `Two.Both(_, "c")` does.
fn partial_constructor() -> Two
    make = &Two.Both(&1, "c")
    //              ^ type
    //                      ^ type
    make(1)
    //  ^ punctuation.bracket
    //    ^ punctuation.bracket
end

fn constructor_patterns(input: String, r: Result<Int, String>, s: Shape) -> Int
    Some(number) = String.to_int(input) else
        // <- type
        //     ^ type
        //                      ^ punctuation.bracket
        //                            ^ punctuation.bracket
        return 0
    end

    from_r = case r
        Result.Ok(n) -> n
        //       ^ type
        //         ^ type
        Result.Err(_) -> 0
        //        ^ type
        //          ^ type
    end

    from_s = case s
        .Circle(c) -> c
        //     ^ type
        //       ^ type
        _ -> 0
    end

    number + from_r + from_s
end

// A variant a pattern names through its file: the file is a module, the
// names between it and the variant the variant's type.
fn module_variant_patterns(r: Result<Int, json.Json>, c: json.Json.Case) -> Int
    from_r = case r
        Err(json.Json.Null) -> 1
        //  ^ module
        //       ^ type
        //            ^ constructor
        Err(json.Json.Int(n)) -> n
        //  ^ module
        //            ^ constructor
        //               ^ type
        //                 ^ type
        Err(json.Json.Arr[_first, .._rest]) -> 2
        //               ^ type
        //                               ^ type
        _ -> 0
    end

    from_c = case c
        json.Json.Case.Snake -> 1
        // <- module
        //   ^ type
        //        ^ type
        //             ^ constructor
        json.Json.Case.Camel or json.Json.Case.Kebab -> 2
        //                      ^ module
        //                                     ^ constructor
        _ -> 0
    end

    if Err(json.Json.Bool(b)) = r then
        // ^ module
        //               ^ type
        //                 ^ type
        return if b then 1 else 0
    end

    from_r + from_c
end

fn as_pattern(found: Maybe<(Int, Int)>) -> Int
    Some((a, b)) as m = found else
        // <- type
        //    ^ type
        //     ^ type
        return 0
    end

    case m
        Some(_) -> a + b
        None -> 0
    end
end

fn unwrap_balance(Balance(v)) -> Int
    //           ^ punctuation.bracket
    //                   ^ type
    //                     ^ type
    //                      ^ punctuation.bracket
    v
end

fn balance_lambda(xs: List<Balance>) -> Int
    xs |> Iter.map(fn Balance(v) -> v) |> Iter.reduce(0, fn s, n -> s + n)
    //            ^ punctuation.bracket
    //                       ^ type
    //                         ^ type
    //                               ^ punctuation.bracket
end

group "group"
    setup (1, 2)

    test "setup pattern", (a, b)
        //                ^ type
        //                     ^ type
        assert (a, b) == (1, 2)
        //     ^ type
        //               ^ type
        //                    ^ type
    end
end

// A declaration's return arrow and a lambda's arrow are operators, and a
// lambda's tuple pattern takes type like every pattern's delimiters.
fn arrows(pairs: List<(Int, Int)>) -> Int
    //                             ^ operator
    sums = Iter.map(pairs, fn (a, b) -> a + b)
    //                     ^ keyword
    //                        ^ type
    //                               ^ operator
    Iter.count(sums)
end
