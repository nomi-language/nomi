// A module path's segments read as modules, in an import and where a file
// is named through a directory import, and the `::` between them as a
// delimiter. The caret lines below each line name the highlight of the
// token they point at.
import {
    std
    std::uuid
    // ^ punctuation.delimiter
    //   ^ module
}

fn show(j: std::json.Json) -> std::json.Json {
    //     ^ module
    //          ^ module
    //               ^ type
    //                        ^ module
    //                             ^ module
    case j {
        std::json.Json.Null -> std::json.Json.Int(1)
        //   ^ module
        //             ^ constructor
        //                                    ^ constructor
        _ -> j
    }
}

fn say(u: uuid.Uuid) {
    std::io.print(u)
    // ^ punctuation.delimiter
    //   ^ module
    //      ^ function.call
}
