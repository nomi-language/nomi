// A postfix `!` can stop the program, as `unreachable` does, so it reads as a
// keyword, and so does `not`. The caret lines below each line name the
// highlight of the token they point at.
pub fn half(n: Int) -> Result<Int, String>
    if n % 2 == 0 then Ok(n / 2) else Err("odd")
end

pub fn quarter(n: Int) -> Int
    half(half(n)!)!
    //          ^ keyword
    // <- function.call
end

pub fn parsed(text: String) -> Int
    text |> String.to_int()!
    //                     ^ keyword
end

pub fn odd(n: Int) -> Bool
    not Result.is_ok(half(n))
    // <- keyword
end

pub fn even(n: Int) -> Bool
    n |> not odd()
    //   ^^^ keyword
end
