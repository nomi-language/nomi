test "vector literals construct vectors" {
    v = #[1, 2, 3]

    assert v == #[1, 2, 3]
    assert Vector.length(v) == 3
    assert Iter.count(v) == 3
}

test "vectors convert to lists" {
    assert Iter.to_list(#[1, 2, 3]) == [1, 2, 3]
}

test "vectors convert from lists" {
    v = Iter.to_vector([1, 2, 3])

    assert v == #[1, 2, 3]
}

test "vectors support random access" {
    v = #["a", "b", "c"]

    assert Vector.at(v, 0) == Some("a")
    assert Vector.at(v, 2) == Some("c")
    assert Vector.at(v, -1) == None
    assert Vector.at(v, 3) == None
}

test "vectors push set and concat return new vectors" {
    original = #[1, 2]
    pushed = Vector.push(original, 3)
    assert Some(updated) = Vector.set(pushed, 1, 20)
    concatenated = Vector.concat(updated, #[4, 5])

    assert original == #[1, 2]
    assert pushed == #[1, 2, 3]
    assert updated == #[1, 20, 3]
    assert concatenated == #[1, 20, 3, 4, 5]
    assert Vector.set(pushed, 9, 99) == None
}

test "empty vectors need type context" {
    empty: Vector<Int> = #[]

    assert empty == #[]
    assert Vector.length(empty) == 0
    assert Vector.at(empty, 0) == None
}

test "vectors iterate with generic Iter operations" {
    doubled =
        #[1, 2, 3]
        |> Iter.map(|n| n * 2)
        |> Iter.to_list()

    found =
        #["ada", "grace", "katherine"]
        |> Iter.find(|name| String.contains?(name, "ace"))

    assert doubled == [2, 4, 6]
    assert found == Some("grace")
}

test "vectors compare display debug and hash structurally" {
    a = #[1, 2, 3]
    b = #[1, 2, 3]
    c = #[1, 2, 4]

    assert a == b
    assert Vector.equal?(a, b)
    refute Vector.equal?(a, c)
    assert Vector.compare(a, c) == Ordering.Less
    assert Vector.to_string(a) == "#[1, 2, 3]"
    assert Vector.inspect(#["a", "b"]) == "#[\"a\", \"b\"]"
    assert Vector.hash(a) == Vector.hash(b)
}

test "vectors concatenate with +" {
    a = #[1, 2]

    assert a + #[3, 4] == #[1, 2, 3, 4]
    assert a + #[] == a
    assert #["x"] + #["y"] == Vector.concat(#["x"], #["y"])
}

struct Countdown {
    from: Int
}

impl Iter for Countdown {
    fn each_while(c: Countdown, yield: (Int) -> Bool): Bool {
        if c.from <= 0 {
            True
        } else {
            if yield(c.from) {
                each_while(Countdown{from: c.from - 1}, yield)
            } else {
                False
            }
        }
    }
}

fn collect<T>(source: Iter<T>): Vector<T> {
    Iter.to_vector(source)
}

test "Iter.to_vector materializes any iterator into a vector" {
    assert [1, 2, 3] |> Iter.to_vector() == #[1, 2, 3]
    assert #["a", "b"] |> Iter.to_vector() == #["a", "b"]
    assert #{3, 1, 3} |> Iter.to_vector() == #[3, 1]
    assert {"a" => 1, "b" => 2} |> Iter.to_vector() == #[("a", 1), ("b", 2)]
    assert "héllo" |> Iter.to_vector() == #["h", "é", "l", "l", "o"]
    assert 1..=4 |> Iter.to_vector() == #[1, 2, 3, 4]
    assert String.to_bytes("ab") |> Iter.to_vector() |> Vector.length() == 2
    assert Countdown{from: 3} |> Iter.to_vector() == #[3, 2, 1]

    tens =
        Iter.from(1)
        |> Iter.filter(|x| x % 2 == 0)
        |> Iter.map(|x| x * 10)
        |> Iter.take(3)
        |> Iter.to_vector()

    assert tens == #[20, 40, 60]

    empty: List<Int> = []

    assert Iter.to_vector(empty) == #[]
    assert collect([1, 2]) == #[1, 2]
    assert collect(1..3) == #[1, 2]
    assert collect(Countdown{from: 2}) == #[2, 1]
    assert collect(#{"x"}) == #["x"]
}
