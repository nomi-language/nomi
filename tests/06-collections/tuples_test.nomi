test "tuples expose positional fields"
    pair = ("hello", 42)

    assert pair.first == "hello"
    assert pair.second == 42
end

test "tuple destructuring binds positional values"
    (x, y) = (10, 20)

    assert x + y == 30
end

test "functions can return tuples for destructuring"
    (quotient, remainder) = divide(17, 5)

    assert quotient == 3
    assert remainder == 2
end

test "tuple patterns match positional shapes"
    assert classify((0, 0)) == "origin"
    assert classify((0, 7)) == "y-axis"
    assert classify((3, 0)) == "x-axis"
    assert classify((1, 2)) == "other"
end

test "tuple equality compares positional values"
    assert (1, 2) == (1, 2)
    refute (1, 2) == (1, 3)
end

fn divide(a: Int, b: Int) -> (Int, Int)
    (a / b, a % b)
end

fn classify(point: (Int, Int)) -> String
    case point
        (0, 0) -> "origin"
        (0, _) -> "y-axis"
        (_, 0) -> "x-axis"
        _      -> "other"
    end
end
