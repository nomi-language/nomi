import std::compiler

test "an unwrapped Vector.get traps on an index past the end"
    result =
        """
        fn main()
          _ = Vector.get(Vector[1, 2, 3, 4, 5], 7)!
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 2: `Vector.get(Vector[1, 2, 3, 4, 5], 7)` found nothing")
end

test "an unwrapped Vector.get traps on a negative index"
    result =
        """
        fn main()
          _ = Vector.get(Vector[1, 2], -1)!
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 2: `Vector.get(Vector[1, 2], -1)` found nothing")
end

test "an unwrapped Vector.set traps on an index outside the vector"
    result =
        """
        fn main()
          _ = Vector.set(Vector["a"], 1, "b")!
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 2: `Vector.set(Vector[\"a\"], 1, \"b\")` found nothing")
end

test "an unwrapped Bytes.get traps on an index outside the buffer"
    result =
        """
        fn main()
          _ = Bytes.get(String.to_bytes("hi"), 2)!
        end
        """
        |> compiler.run()

    assert Err(message) = result

    assert String.contains(message, "line 2: `Bytes.get(String.to_bytes(\"hi\"), 2)` found nothing")
end

test "an unwrapped set in a lambda a std call runs traps at the lambda"
    result =
        """
        fn main()
          rows = [Vector[1, 2], Vector[3]]
          _ = rows |> Iter.map(&Vector.set(&1, 1, 0)!) |> Iter.to_list()
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 3: `Vector.set(&1, 1, 0)` found nothing")
end

test "get, set and remove_at answer None where their unwrapping traps"
    assert Vector.get([1, 2, 3, 4, 5], 7) == None
    assert Bytes.get(String.to_bytes("hi"), 2) == None
    assert Vector.set([1, 2], 2, 0) == None
    assert Vector.set([1, 2], -1, 0) == None
    assert List.remove_at([1, 2, 3], 3) == None
    assert List.remove_at([1, 2, 3], -1) == None
end

test "an unwrapped List.remove_at traps on an index outside the list"
    result =
        """
        fn main()
          _ = List.remove_at([1, 2, 3], 3)!
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 2: `List.remove_at([1, 2, 3], 3)` found nothing")
end

test "an unwrapped Map.get traps on a missing key and names the call"
    result =
        """
        fn main()
          _ = Map.get({"a" => 1}, "z")!
        end
        """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 2: `Map.get({\"a\" => 1}, \"z\")` found nothing")
end
