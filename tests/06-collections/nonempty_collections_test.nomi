// The prelude's non-empty collections: literals checked when compiled,
// try_from and the constructors that cannot fail, functions that need no
// Maybe, and functions that keep the guarantee.
interface Named
    fn name(value: self) -> String
end

struct Cat
    called: String
end

impl Named for Cat
    fn name(cat: Cat) -> String
        cat.called
    end
end

fn names(xs: NonEmptyList<Named>) -> String
    xs |> Iter.map(fn n -> Named.name(n)) |> String.join(", ")
end

fn sizes(xs: List<Int>) -> Int
    Iter.sum(xs)
end

test "NonEmptyList"
    xs: NonEmptyList<Int> = [3, 1, 4]
    empty: List<Int> = []

    assert NonEmptyList.first(xs) == 3
    assert NonEmptyList.last(xs) == 4
    assert NonEmptyList.tail(xs) == [1, 4]
    assert NonEmptyList.length(xs) == 3
    assert NonEmptyList.max(xs) == 4
    assert NonEmptyList.min(xs) == 1
    assert NonEmptyList.max_by(["ab", "c"], String.length) == "ab"
    assert NonEmptyList.min_by(["ab", "c"], String.length) == "c"
    assert NonEmptyList.reduce(xs, fn a, b -> a * b) == 12
    assert NonEmptyList.mean([1.0, 2.0]) == 1.5
    assert NonEmptyList.map(xs, &(&1 + 1)) == [4, 2, 5]
    assert NonEmptyList.with_index(["a"]) == [(0, "a")]
    assert NonEmptyList.reverse(xs) == [4, 1, 3]
    assert NonEmptyList.sort(xs) == [1, 3, 4]
    assert NonEmptyList.prepend(empty, 9) == [9]
    assert NonEmptyList.push(empty, 9) == [9]
    assert NonEmptyList.concat(xs, empty) == [3, 1, 4]
    assert NonEmptyList.of(0, xs) == [0, 3, 1, 4]
    assert NonEmptyList.try_from(empty) == None
    assert NonEmptyList.try_from([5]) == Some([5])
    assert sizes(xs) == 8

    cats: NonEmptyList<Cat> = NonEmptyList.of(Cat{called: "Tom"}, [Cat{called: "Kit"}])
    assert names(cats) == "Tom, Kit"
end

test "NonEmptyVector"
    v: NonEmptyVector<Int> = [5, 2, 8]
    empty: Vector<Int> = []

    assert NonEmptyVector.first(v) == 5
    assert NonEmptyVector.last(v) == 8
    assert NonEmptyVector.length(v) == 3
    assert NonEmptyVector.max(v) == 8
    assert NonEmptyVector.min(v) == 2
    assert NonEmptyVector.reduce(v, fn a, b -> a + b) == 15
    assert NonEmptyVector.mean(v) == 5.0
    assert NonEmptyVector.map(v, &(&1 * 2)) == Vector[10, 4, 16]
    assert NonEmptyVector.with_index(v) |> NonEmptyVector.last() == (2, 8)
    assert NonEmptyVector.push(empty, 1) == Vector[1]
    assert NonEmptyVector.concat(v, empty) == Vector[5, 2, 8]
    assert NonEmptyVector.of(1, empty) == Vector[1]
    assert NonEmptyVector.try_from(empty) == None
    assert Vector.get(v, 2) == Some(8)
end

test "NonEmptyMap"
    m: NonEmptyMap<String, Int> = {"a" => 1, "b" => 2}
    empty: Map<String, Int> = {}

    assert NonEmptyMap.size(m) == 2
    assert NonEmptyMap.first_entry(m) == ("a", 1)
    assert NonEmptyMap.last_entry(m) == ("b", 2)
    assert NonEmptyMap.max_by(m, fn (_, v) -> v) == ("b", 2)
    assert NonEmptyMap.min_by(m, fn (_, v) -> v) == ("a", 1)
    assert NonEmptyMap.keys(m) == ["a", "b"]
    assert NonEmptyMap.values(m) |> NonEmptyList.max() == 2
    assert NonEmptyMap.map_values(m, &(&1 * 10)) == {"a" => 10, "b" => 20}
    assert NonEmptyMap.put(empty, "z", 26) == {"z" => 26}
    assert NonEmptyMap.merge(m, {"a" => 7}) == {"a" => 7, "b" => 2}
    assert NonEmptyMap.of("k", 0, empty) == {"k" => 0}
    assert NonEmptyMap.try_from(empty) == None
    assert Map.get(m, "a") == Some(1)
end

test "NonEmptySet"
    s: NonEmptySet<Int> = [3, 1]
    empty: Set<Int> = []

    assert NonEmptySet.size(s) == 2
    assert NonEmptySet.max(s) == 3
    assert NonEmptySet.min(s) == 1
    assert NonEmptySet.map(s, &(&1 % 2)) == Set[1]
    assert NonEmptySet.to_list(s) |> NonEmptyList.first() == 3
    assert NonEmptySet.insert(empty, 4) == Set[4]
    assert NonEmptySet.union(s, empty) == Set[3, 1]
    assert NonEmptySet.of(2, empty) == Set[2]
    assert NonEmptySet.try_from(empty) == None
    assert 3 in s
end

test "groups and runs are NonEmptyLists"
    words = ["ant", "bee", "cat", "dodo"]
    by_length = Iter.group_by(words, String.length)
    firsts = Iter.chunks([1, 2, 3], 2) |> Iter.map(&NonEmptyList.first(&1))
    lasts = Iter.windows([1, 2, 3], 2) |> Iter.map(&NonEmptyList.last(&1))
    runs = Iter.chunk_equal([1, 1, 2]) |> Iter.map(&NonEmptyList.length(&1))
    n = 4

    assert Map.get(by_length, 3) |> Maybe.map(&NonEmptyList.last(&1)) == Some("cat")
    assert Iter.to_list(firsts) == [1, 3]
    assert Iter.to_list(lasts) == [2, 3]
    assert Iter.to_list(runs) == [2, 1]
    assert Iter.chunks([1, 2, 3, 4], 3) |> Iter.to_list() == [[1, 2, 3], [n]]
end

test "a literal with an element is non-empty whatever its elements are"
    n = 4
    rest = [5]
    xs: NonEmptyList<Int> = [n, n + 1]
    v: NonEmptyVector<Int> = Vector[n]
    s: NonEmptySet<Int> = Set[n, n]
    m: NonEmptyMap<String, Int> = {"n" => n}
    spread: NonEmptyList<Int> = [..rest, n]
    again: NonEmptyList<Int> = [..rest, ..xs]

    assert NonEmptyList.first(xs) == 4
    assert NonEmptyVector.first(v) == 4
    assert NonEmptySet.size(s) == 1
    assert NonEmptyMap.first_entry(m) == ("n", 4)
    assert NonEmptyList.last(spread) == 4
    assert NonEmptyList.length(again) == 3
end
