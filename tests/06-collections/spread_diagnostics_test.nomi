// A spread in a list, vector or set literal is any Iter of the literal's
// elements; one that is no Iter, or an Iter of other elements, is refused.
import std::compiler.{self, Diagnostic}

// whether a diagnostic at line:col reads exactly message, before any help
fn at(diagnostics: List<Diagnostic>, line: Int, col: Int, message: String) -> Bool
    Iter.any_match(diagnostics, fn d ->
        d.line == line
            and d.col == col
            and (d.message == message or String.starts_with(d.message, message + "\nhelp: "))
    end)
end

test "a spread that is no Iter, or an Iter of other elements, is refused"
    diagnostics = compiler.check(
        """
        fn main()
          n = 3
          words = ["a"] |> Iter.map(fn w -> w + "!")
          _a = [1, ..n]
          _b = [1, ..words]
          _c = Vector[..Vector[1], ..Some("x")]
          _d = Set[..Set[1], ..n]
        end
        """
    )

    assert at(
        diagnostics,
        4,
        14,
        "list spread `..` requires an Iter of the list's elements, got Int",
    )

    assert at(diagnostics, 5, 14, "list spread element type mismatch: Int vs String")
    assert at(diagnostics, 6, 28, "vector spread element type mismatch: expected Int, got String")
    assert at(diagnostics, 7, 22, "set spread `..` requires an Iter of the set's elements, got Int")
end
