// std/fs inside std::fs::testing.run: every file operation goes to an in-memory
// sandbox, tasks started inside reach the same one, a nested run takes over
// for its own call, and injected failures fail the operation they name.
import
    std::fs.{self, Entry, Kind, WriteMode}
    std::fs::testing.{self, Failure, Operation, Sandbox}
    std::io.{self, Reader, Writer}
    std::tasks.Task
end

fn sort_file(input: String, output: String) -> Result<Int, io.Error>
    lines = Result.collect(fs.lines(input))?
    sorted = Iter.sort(lines)
    fs.write_text(output, String.join(sorted, "\n") + "\n", mode: .ReplaceAtomically)?
    Ok(Iter.count(sorted))
end

test "sorts the lines into the output file"
    ran = testing.run(Sandbox{files: {"in.txt" => "pear\napple\n"}}, fn ->
        sort_file("in.txt", "out.txt")
    end)

    assert ran.value == Ok(2)
    assert testing.text(ran, "/work/out.txt") == Some("apple\npear\n")
    assert ran.open == []
    assert ran.log == ["read /work/in.txt", "write /work/out.txt"]
end

test "a missing input is NotFound"
    ran = testing.run(Sandbox{}, fn -> sort_file("in.txt", "out.txt"))

    assert ran.value == Err(io.Error.NotFound{path: "in.txt"})
    assert ran.files == {}
end

test "a full disk leaves the old output in place"
    sandbox = Sandbox{
        files: {"in.txt" => "b\na\n", "out.txt" => "old\n"},
        failures: [
            Failure{path: "out.txt", operation: .Write, error: io.Error.NoSpace{path: "out.txt"}},
        ],
    }

    ran = testing.run(sandbox, fn -> sort_file("in.txt", "out.txt"))

    assert ran.value == Err(io.Error.NoSpace{path: "out.txt"})
    assert testing.text(ran, "/work/out.txt") == Some("old\n")
end

test "a failure can name only the nth operation"
    sandbox = Sandbox{
        failures: [
            Failure{
                path:      "log.txt",
                operation: .Create,
                error:     io.Error.TooManyOpen,
                nth:       Some(2),
            },
        ],
    }

    ran = testing.run(sandbox, fn ->
        [
            fs.write_text("log.txt", "1", mode: .Append),
            fs.write_text("log.txt", "2", mode: .Append),
            fs.write_text("log.txt", "3", mode: .Append),
        ]
    end)

    assert ran.value == [Ok(Unit), Err(io.Error.TooManyOpen), Ok(Unit)]
    assert testing.text(ran, "/work/log.txt") == Some("13")
end

test "tasks started inside the run reach its sandbox"
    ran = testing.run(Sandbox{}, fn ->
        concurrent
            a = Task.spawn(fn -> fs.write_text("a.txt", "from a"))
            b = Task.spawn(fn -> fs.write_text("b.txt", "from b"))
            (Task.await(a), Task.await(b))
        end
    end)

    assert ran.value == (Ok(Unit), Ok(Unit))

    assert ran.files == {
        "/work/a.txt" => String.to_bytes("from a"),
        "/work/b.txt" => String.to_bytes("from b"),
    }
end

test "two tasks in two sandboxes do not see each other's files"
    both = concurrent
        a = Task.spawn(fn -> testing.run(Sandbox{}, fn -> fs.write_text("x.txt", "a")))
        b = Task.spawn(fn -> testing.run(Sandbox{}, fn -> fs.write_text("x.txt", "b")))

        (
            testing.text(Task.await(a), "/work/x.txt"),
            testing.text(Task.await(b), "/work/x.txt"),
        )
    end

    assert both == (Some("a"), Some("b"))
end

test "a nested run takes over for its own call"
    outer = testing.run(Sandbox{files: {"who.txt" => "outer"}}, fn ->
        inner = testing.run(Sandbox{files: {"who.txt" => "inner"}}, fn ->
            fs.read_text("who.txt")
        end)

        (inner.value, fs.read_text("who.txt"))
    end)

    assert outer.value == (Ok("inner"), Ok("outer"))
end

test "a reader left open shows in open"
    ran = testing.run(Sandbox{files: {"a.txt" => "x"}}, fn -> fs.open("a.txt"))

    assert ran.open == ["/work/a.txt"]
end

test "a writer streams a copy with a header"
    ran = testing.run(Sandbox{files: {"in.txt" => "body\n"}}, fn ->
        prepend_header("in.txt", "out.txt")
    end)

    assert ran.value == Ok(5)
    assert testing.text(ran, "/work/out.txt") == Some("# generated\nbody\n")
    assert ran.open == []
end

fn prepend_header(input: String, output: String) -> Result<Int, io.Error>
    r = fs.open(input)?
    defer Reader.close_quietly(r)

    w = fs.create(output, mode: .ReplaceAtomically)?
    defer Writer.discard(w)

    Writer.write_text(w, "# generated\n")?
    copied = Reader.copy_to(r, w)?
    Writer.close(w)?
    Ok(copied)
end

test "directories list sorted, and remove and rename act on them"
    ran = testing.run(Sandbox{
        files: {"d/b.txt" => "b", "d/a.txt" => "a"},
        dirs:  ["d/e"],
    }, fn ->
        before = fs.list("d")
        _ = fs.rename("d/a.txt", "d/e/a.txt")
        _ = fs.remove("d/b.txt")
        (before, fs.list("d"), fs.list("d/e"))
    end)

    assert ran.value == (
        Ok([
            Entry{path: "d/a.txt", name: "a.txt", kind: Kind.File},
            Entry{path: "d/b.txt", name: "b.txt", kind: Kind.File},
            Entry{path: "d/e", name: "e", kind: Kind.Directory},
        ]),
        Ok([Entry{path: "d/e", name: "e", kind: Kind.Directory}]),
        Ok([Entry{path: "d/e/a.txt", name: "a.txt", kind: Kind.File}]),
    )
end

test "the sandbox's rules are the disk's"
    assert testing.run(Sandbox{}, fn -> testing.conformance("/work")).value == []
end

test "WriteMode is a value"
    assert WriteMode.Append != WriteMode.New
end

test "an injected failure's operation is a value"
    assert Operation.Read != Operation.Write
end

test "walk and glob find the files under a directory"
    files = {"src/main.nomi" => "", "src/lib/a.nomi" => "", "src/lib/notes.txt" => ""}

    ran = testing.run(Sandbox{files:, links: {"src/back" => ".."}}, fn ->
        walked =
            fs.walk("src")
            |> Iter.map(fn e -> Result.map(e, fn e -> e.path))
            |> Result.collect()

        (walked, fs.glob("src/**/*.nomi"), fs.glob("*/*.txt"))
    end)

    assert ran.value == (
        Ok(["src/back", "src/lib", "src/lib/a.nomi", "src/lib/notes.txt", "src/main.nomi"]),
        Ok(["src/lib/a.nomi", "src/main.nomi"]),
        Ok([]),
    )
end

test "a task inside within is confined too"
    ran = testing.run(Sandbox{files: {"site/a.txt" => "a", "secret.txt" => "s"}}, fn ->
        fs.within("site", fn ->
            concurrent
                t = Task.spawn(fn -> (fs.read_text("a.txt"), fs.read_text("../secret.txt")))
                Ok(Task.await(t))
            end
        end)
    end)

    case ran.value
        Ok((inside, outside)) ->
            assert inside == Ok("a")
            assert Result.is_ok(outside) == False

        Err(e) ->
            assert Display.to_string(e) == "no error"
    end
end

test "a File handle left open is in ran.open"
    ran = testing.run(Sandbox{files: {"db" => ""}}, fn ->
        fs.open_file("db", access: .ReadWrite)
    end)

    assert ran.open == ["/work/db"]
end
