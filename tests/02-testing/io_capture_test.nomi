// `io.capture(input, run)` calls `run` with `input` as its stdin and answers
// what it returned and everything it printed.
import {
    std/duration.Duration
    std/io.{self, Reader, Writer}
    std/tasks.Task
    std/timer
}

fn read_words(acc: List<String>) -> List<String> {
    case io.read_line() {
        Ok(Some(line)) -> read_words(acc + String.split(line, " "))
        _ -> acc
    }
}

fn main() -> Result<Unit, String> {
    words = read_words([])
    io.print("words: ${Iter.count(words)}")
    Ok(Unit)
}

fn write_n(s: String, n: Int) -> Unit {
    if n > 0 {
        io.write(s)
        // Yield, so two tasks writing at once interleave.
        timer.sleep(Duration.milliseconds(0))
        write_n(s, n - 1)
    }
}

test "a program's main runs against the given input" {
    run = io.capture("the fox\nthe dog", main)
    assert run.value == Ok(Unit)
    assert run.output == "words: 4\n"
}

test "print, write and inspect are captured byte for byte" {
    run = io.capture("", fn -> {
        io.print("line")
        io.write("no newline ")
        io.inspect([1, 2])
        io.print(3)
    })

    assert run.output == "line\nno newline [1, 2]\n3\n"
}

test "read_line reads the input a line at a time, then None at the end" {
    run = io.capture("one\n\nlast", fn -> {
        [io.read_line(), io.read_line(), io.read_line(), io.read_line()]
    })

    assert run.value == [Ok(Some("one")), Ok(Some("")), Ok(Some("last")), Ok(None)]
    assert run.output == ""
}

test "an inner capture keeps its own output" {
    outer = io.capture("outer", fn -> {
        io.write("a")

        inner = io.capture("inner", fn -> {
            io.write("b")
            io.read_line()
        })

        io.write(inner.output)
        #(inner.value, io.read_line())
    })

    assert outer.value == #(Ok(Some("inner")), Ok(Some("outer")))
    assert outer.output == "ab"
}

test "tasks started inside the capture are captured" {
    run = io.capture("", fn -> {
        concurrent {
            t = Task.spawn(fn -> {
                io.print("from task")
                2
            })

            Task.await(t)
        }
    })

    assert run.value == 2
    assert run.output == "from task\n"
}

test "two tasks capturing at once do not see each other's output" {
    both = concurrent {
        a = Task.spawn(fn -> io.capture("", fn -> write_n("a", 20)))
        b = Task.spawn(fn -> io.capture("", fn -> write_n("b", 20)))
        #(Task.await(a).output, Task.await(b).output)
    }

    assert both == #(String.repeat("a", 20), String.repeat("b", 20))
}

test "stderr is captured apart from stdout and the transcript" {
    run = io.capture("Ada", fn -> {
        io.eprint("warning: first")
        io.write("name: ")

        case io.read_line() {
            Ok(Some(name)) -> io.print("hi ${name}")
            _ -> io.ewrite("no name")
        }
    })

    assert run.output == "name: hi Ada\n"
    assert run.errors == "warning: first\n"
    assert run.transcript == "name: \n    > Ada\nhi Ada\n"
}

test "the stream handles reach the capture" {
    run = io.capture("one\n", fn -> {
        _ = Writer.print(io.stdout, "to stdout")
        _ = Writer.write(io.stderr, String.to_bytes("to stderr"))
        Reader.read_line(io.stdin)
    })

    assert run.value == Ok(Some("one"))
    assert run.output == "to stdout\n"
    assert run.errors == "to stderr"
}

test "a replay ignores what the program writes to stderr" {
    warned = fn -> {
        io.eprint("warning: no config file")
        io.print("ready")
    }

    assert io.replay(
        """
        ready
        """,
        warned,
    )
}

test "an inner capture keeps its own errors" {
    outer = io.capture("", fn -> {
        io.eprint("outer")
        inner = io.capture("", fn -> io.eprint("inner"))
        inner.errors
    })

    assert outer.value == "inner\n"
    assert outer.errors == "outer\n"
}

test "a stream read before a capture writes into the capture" {
    out = io.stdout
    input = io.stdin

    run = io.capture("typed\n", fn -> {
        _ = Writer.print(out, "before")

        concurrent {
            t = Task.spawn(fn -> {
                _ = Writer.print(out, "from a task")
                Reader.read_line(input)
            })

            Task.await(t)
        }
    })

    assert run.value == Ok(Some("typed"))
    assert run.output == "before\nfrom a task\n"
}
