import std/assertions.AssertionFailure

struct Point {
    x: Int
    y: Int
}

fn palindrome?(s: String): Bool {
    String.reverse(s) == s
}

test "each row runs the body once" {
    cases = [("abba", True), ("abc", False), ("x", True), ("", True)]

    subtests cases, (line, known_palindrome) {
        assert palindrome?(line) == known_palindrome
    }
}

test "rows from a range" {
    subtests 1..=5, n {
        assert n * n >= n
        refute n == 0
    }
}

test "rows of structs bound by a struct pattern" {
    points = [Point{x: 1, y: 2}, Point{x: 3, y: 5}]

    subtests points, Point{x, y} {
        assert x < y
    }
}

test "rows from a map are its entries" {
    lengths = {"a" => 1, "bb" => 2}

    subtests lengths, (word, length) {
        assert String.length(word) == length
    }
}

test "no rows run no body" {
    rows: List<Int> = []

    subtests rows, n {
        assert n == 99
    }
}

test "a row may bind and assert several times" {
    subtests [2, 4, 6], n {
        half = n / 2
        assert half * 2 == n
        assert n % 2 == 0
    }
}

fn all_ordered(points: List<Point>): Result<Unit, AssertionFailure> {
    subtests points, Point{x, y} {
        assert x < y
    }

    Ok(Unit)
}

test "in a function, the failed rows are its Err" {
    assert all_ordered([Point{x: 1, y: 2}]) == Ok(Unit)

    assert Err(failure) = all_ordered([Point{x: 1, y: 2}, Point{x: 4, y: 3}, Point{x: 6, y: 5}])

    assert failure.keyword == "subtests"
    assert failure.reason == "2 of 3 subtests failed"
    assert Iter.count(failure.subtests) == 2
    assert Some(first) = List.head(failure.subtests)
    assert first.row == "Point{x: 4, y: 3}"
    assert first.failure.expression == "x < y"

    assert AssertionFailure.format(failure) == """
        subtest Point{x: 4, y: 3}: line 61: assertion failed
          assert x < y
          values:
            x
              = 4
            y
              = 3
        subtest Point{x: 6, y: 5}: line 61: assertion failed
          assert x < y
          values:
            x
              = 6
            y
              = 5
        2 of 3 subtests failed
        """
}

fn subtests(n: Int): Int {
    n + 1
}

test "subtests is a name everywhere else" {
    assert subtests(1) == 2

    subtests = [10, 20]

    assert Iter.count(subtests) == 2

    subtests subtests, n {
        assert n >= 10
    }
}

fn check_palindrome(line: String, known_palindrome: Bool): Result<Unit, AssertionFailure> {
    assert palindrome?(line) == known_palindrome

    Ok(Unit)
}

test "a row may end with a helper that asserts" {
    subtests [("abba", True), ("abc", False)], (line, known_palindrome) {
        check_palindrome(line, known_palindrome)
    }
}
