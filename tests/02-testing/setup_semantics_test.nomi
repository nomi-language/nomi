fn parent_fixture() -> {inherited: String, value: String}
    {inherited: "parent", value: "parent"}
end

group "setup semantics"
    setup parent_fixture()

    test "setup value is bound by the test's pattern", {inherited:, value:}
        assert inherited == "parent"
        assert value == "parent"
    end

    test "a sibling group's setup does not leak into this group", {inherited:, value:}
        assert inherited == "parent"
        assert value == "parent"
    end
end

group "derived setup"
    setup begin
        parent = parent_fixture()
        {inherited: parent.inherited, value: "child", child_only: "ready"}
    end

    test "a sibling group derives its setup from a shared function", {
        inherited:,
        value:,
        child_only:,
    }
        assert inherited == "parent"
        assert value == "child"
        assert child_only == "ready"
    end
end
