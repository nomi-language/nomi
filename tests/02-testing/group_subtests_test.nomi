// A group's `subtests` block runs the group's boot line, setup and tests once
// per row, with the row bound in each. Each row's tests are cases of their
// own, named `group [row] / test`.
import
    std::duration.Duration
    std::io
    std::testing.Clock
    std::timer
end

struct Config
    store: String
end

fn boot(startup: Startup) -> Result<Config, String>
    Ok(Config{store: Map.get(startup.env, "STORE") |> Maybe.with_default("none")})
end

fn main()
    io.print("store: ${Config.store}")
end

fn describe() -> String
    "a ${Config.store} store"
end

group "stores"
    subtests ["memory", "sqlite"], store
        boot boot(Startup{env: {"STORE" => store}})

        test "each row boots its own store"
            assert Config.store == store
        end

        test "code that reads the app sees the row's boot"
            assert describe() == "a ${store} store"
        end
    end
end

group "row in the setup"
    subtests [2, 3], n
        setup n * 10

        test "the setup reads the row", tens
            assert tens == n * 10
        end
    end
end

group "named rows"
    subtests [("one", 1, 3), ("three", 3, 5)], (word, n, length), word
        test "a tuple row binds every column"
            assert String.length(word) == length
            assert n > 0
        end
    end
end

group "rows of tests with their own subtests"
    subtests [(1, 2), (2, 4)], (n, doubled)
        test "each statement row is a case"
            subtests [1, 2, 3], k
                assert n * 2 * k == doubled * k
            end
        end
    end
end

group "a virtual clock per row"
    subtests [1, 5], minutes
        clock Clock.Virtual

        test "waits without taking time"
            timer.sleep(Duration.minutes(minutes))
            assert minutes > 0
        end
    end
end
