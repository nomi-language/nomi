// std/fs on the real disk, inside a temporary directory fs.make_temp_dir
// makes and a deferred fs.remove_all_quietly removes: each WriteMode,
// streams, listings, metadata and the errors that name their path.
import {
    std::fs.{self, Kind}
    std::fs_testing
    std::io.{self, File, Reader, Writer}
    std::path
}

test "the disk keeps the rules the sandbox models" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    assert fs_testing.conformance(dir) == []
}

test "a temporary directory is gone afterwards" {
    made = made_and_removed()?

    assert fs.exists(made) == Ok(False)
}

fn made_and_removed() -> Result<String, io.Error> {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    fs.write_text(path.join(dir, "x.txt"), "x")?
    Ok(dir)
}

test "each write mode" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    p = path.join(dir, "notes.txt")
    fs.write_text(p, "milk\n")?
    fs.write_text(p, "eggs\n", mode: .Append)?
    refused = fs.write_text(p, "x", mode: .New)
    fs.write_text(path.join(dir, "atomic.txt"), "whole", mode: .ReplaceAtomically)?

    assert fs.read_text(p) == Ok("milk\neggs\n")
    assert refused == Err(io.Error.AlreadyExists{path: p})
    assert fs.read_text(path.join(dir, "atomic.txt")) == Ok("whole")
}

test "a writer buffers until it closes, and a reader reads it back" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    p = path.join(dir, "out.txt")
    w = fs.create(p)?
    defer Writer.discard(w)

    Writer.print(w, "one")?
    Writer.write(w, String.to_bytes("two\n"))?
    Writer.close(w)?

    r = fs.open(p)?
    defer Reader.close_quietly(r)

    assert Reader.read_line(r) == Ok(Some("one"))
    assert Reader.read_all_text(r) == Ok("two\n")
}

test "a discarded atomic writer leaves the old file and nothing beside it" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    p = path.join(dir, "a.txt")
    fs.write_text(p, "old")?
    w = fs.create(p, mode: .ReplaceAtomically)?
    defer Writer.discard(w)
    Writer.write_text(w, "half")?
    Writer.discard(w)

    assert fs.read_text(p) == Ok("old")
    assert fs.list(dir) |> Result.map(fn entries -> Iter.count(entries)) == Ok(1)
}

test "a listing is sorted and names each entry's kind" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    fs.write_text(path.join(dir, "b.txt"), "")?
    fs.create_dir(path.join(dir, "a"))?

    entries = fs.list(dir)?

    assert entries
    |> Iter.map(fn e -> (e.name, e.kind))
    |> Iter.to_list() == [("a", Kind.Directory), ("b.txt", Kind.File)]
}

test "metadata answers the size, and copy and rename move contents" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    a = path.join(dir, "a.txt")
    fs.write_text(a, "four")?
    fs.copy(a, path.join(dir, "b.txt"))?
    fs.rename(a, path.join(dir, "c.txt"))?

    assert (fs.metadata(path.join(dir, "b.txt"))?).size == 4
    assert fs.exists(a) == Ok(False)
    assert fs.read_text(path.join(dir, "c.txt")) == Ok("four")
}

test "errors name the path the program passed" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    missing = path.join(dir, "none/x.txt")
    fs.write_text(path.join(dir, "kept.txt"), "")?

    assert fs.read_text(missing) == Err(io.Error.NotFound{path: missing})
    assert fs.write_text(missing, "x") == Err(io.Error.NotFound{path: path.join(dir, "none")})
    assert fs.remove(dir) == Err(io.Error.DirectoryNotEmpty{path: dir})
    assert fs.read_text(dir) == Err(io.Error.IsADirectory{path: dir})
}

test "symlinks, modes, a File and within on the disk" {
    dir = fs.make_temp_dir()?
    defer fs.remove_all_quietly(dir)

    fs.create_dir(path.join(dir, "site/pages"), parents: True)?
    fs.write_text(path.join(dir, "site/pages/a.txt"), "a")?
    fs.write_text(path.join(dir, "secret.txt"), "s")?
    fs.create_symlink(path.join(dir, "site/current"), target: "pages")?
    fs.set_mode(path.join(dir, "secret.txt"), 0o444)?

    walked =
        fs.walk(path.join(dir, "site"))
        |> Iter.map(fn e -> Result.map(e, fn e -> (e.name, e.kind)))
        |> Result.collect()

    f = fs.open_file(path.join(dir, "site/pages/a.txt"), access: .ReadWrite)?
    defer File.close_quietly(f)

    File.write_at(f, 1, String.to_bytes("bc"))?
    patched = File.size(f)
    File.close(f)?

    inside = fs.within(path.join(dir, "site"), fn -> {
        Ok((fs.read_text("current/a.txt"), Result.is_ok(fs.read_text("../secret.txt"))))
    })

    assert walked
        == Ok([("current", Kind.Symlink), ("pages", Kind.Directory), ("a.txt", Kind.File)])

    assert patched == Ok(3)
    assert inside == Ok((Ok("abc"), False))
    assert (fs.metadata(path.join(dir, "secret.txt"))?).mode == 0o444
}
