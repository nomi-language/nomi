fn double(x: Int) -> Int
    x * 2
end

test "option and result values render their variant shapes"
    assert Some(42)
        |> Debug.inspect()
        |> String.equal("Some(42)")

    assert None
        |> Debug.inspect()
        |> String.equal("None")

    assert Ok("success")
        |> Debug.inspect()
        |> String.equal("Ok(\"success\")")

    assert Err("fail")
        |> Debug.inspect()
        |> String.equal("Err(\"fail\")")
end

test "option helpers map and default values"
    some =
        Some(5)
        |> Option.map(double)
        |> Option.with_default(0)

    none =
        None
        |> Option.with_default(99)

    assert some == 10
    assert none == 99
end

test "result helpers map and default values"
    ok =
        Ok(7)
        |> Result.map(double)
        |> Result.with_default(0)

    err =
        Err("oops")
        |> Result.with_default(0)

    assert ok == 14
    assert err == 0
end
