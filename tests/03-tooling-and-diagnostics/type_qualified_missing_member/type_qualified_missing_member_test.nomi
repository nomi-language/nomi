import
    std::compiler
    test_helpers
end

test "type-qualified missing member reports a diagnostic"
    diagnostics = compiler.check(
        """
          import
            std::io
          end


          fn main()
            io.print(List.empty())
          end
        """
    )

    assert Iter.count(diagnostics) == 1
    assert test_helpers.has_diagnostic(diagnostics, "type 'List' has no member 'empty'")
end
