import {
    std/compiler.{self, Project}
    std/toml.Toml
    test_helpers
}

test "compiler can check diagnostics across an in-memory project" {
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        files: {
            "main" => """
                import api.{make, secret}

                fn main(): String {
                  w = make("Ada")
                  secret(w)
                }
                """,
            "api" => """
                pub struct Widget {
                  name: String
                }

                pub fn label(w: Widget): String {
                  w.name
                }

                fn secret(w: Widget): String {
                  "secret " + w.name
                }

                pub fn make(name: String): Widget {
                  Widget{name}
                }
                """,
        },
    })

    assert Iter.count(diagnostics) == 1
    assert test_helpers.has_diagnostic?(diagnostics, "'secret' is private and cannot be imported")
}

test "compiler project checks manifest entry points" {
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        manifest: Some(
            Toml"""
            [module]
            name = "demo"
            entry_points = ["other"]
            """
        ),
        files: {
            "main" => """
                import other

                fn main() {
                  other.helper()
                  Unit
                }
                """,
            "other" => """
                pub fn helper(): Unit {
                  Unit
                }
                """,
        },
    })

    assert Iter.count(diagnostics) == 2

    assert test_helpers.has_diagnostic?(
        diagnostics,
        "entry callback in main but file is not declared in nomi.toml entry_points",
    )

    assert test_helpers.has_diagnostic?(
        diagnostics,
        "other is declared in nomi.toml entry_points but has no entry callback",
    )
}
