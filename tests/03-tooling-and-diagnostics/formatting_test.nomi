// Formatter showcase. The examples below demonstrate the layout rules the
// formatter applies to declarations, expressions, comments, and tests. Each
// section is intentionally small so the formatted output stays easy to scan.
//
// Section dividers and headers are part of the showcase; they make the file a
// compact reference for readers comparing different syntactic shapes.
// ---------------------------------------------------------------------------
// Once bindings (file-level)
// ---------------------------------------------------------------------------
once max_retries: Int = 3
once default_host = "localhost"

// ---------------------------------------------------------------------------
// Struct declarations — always multi-line, trailing commas
// ---------------------------------------------------------------------------
// Point's impl block names Drawable2, which is declared later in the file.
// Declarations can refer to types and interfaces that appear below them.
pub struct Point {
    x: Int
    y: Int
}

impl Drawable2 for Point {
    fn draw(_p: Point): String {
        "point"
    }
}

pub struct User {
    name: String
    age: Int = 0
    email: String = ""
}

pub opaque struct UserId {
    raw: Int
}

pub struct Pair<A, B> {
    first: A
    second: B
}

// ---------------------------------------------------------------------------
// Enum declarations
// ---------------------------------------------------------------------------
//
// Single-line when fits; multi-line preserved when source had it that way;
// width-decided otherwise. Variant kinds: bare, positional, struct, embedded.
enum Color {
    Red
    Green
    Blue
}

pub enum Maybe2<T> {
    None
    Some T
}

pub enum Shape {
    Circle Float
    Rectangle {width: Float, height: Float}
    Point2
}

pub opaque enum Status {
    Active
    Inactive
    Pending Int
}

pub enum Drawable {
    embeds Point
    embeds Shape
}

// Struct-shaped variant payload — short stays flat.
enum Event {
    Click {x: Int, y: Int}
    Scroll Int
}

// Struct-shaped variant payload — user-written multi-line preserved.
enum ParseError {
    Invalid {
        line: Int,
        col: Int,
        message: String,
    }
    Unexpected String
}

// ---------------------------------------------------------------------------
// Type declarations and aliases
// ---------------------------------------------------------------------------
pub type Email String
pub type Coord (Int, Int)
pub type Handler (String, String) -> Result<String, String>
pub type Expired
pub opaque type Counter Int

pub typealias UserList List<User>
pub typealias UserMap Map<String, User>

// ---------------------------------------------------------------------------
// Interfaces and impls
// ---------------------------------------------------------------------------
pub interface Drawable2 {
    fn draw(s: self): String
}

pub interface Container<T> {
    fn empty(): self
    fn add(c: self, item: T): self

    fn size(_c: self): Int {
        0
    }
}

// ---------------------------------------------------------------------------
// Function declarations
// ---------------------------------------------------------------------------
//
// Bodies always render multi-line (empty stays flat as `{}`).
// Signatures break onto multiple lines when too long for 100 cols.
// Doc comments preserved above the declaration.
fn noop() {}

fn add(x: Int, y: Int): Int {
    x + y
}

/// Doc comment attaches to the next declaration.
/// Multiple lines preserved.
pub fn greet(name: String, greeting: String = "Hello"): String {
    greeting + ", " + name
}

fn map_pair<A, B, C>(p: Pair<A, B>, f: (A) -> C): Pair<C, B> {
    Pair{first: f(p.first), second: p.second}
}

fn bounded<T>(_items: List<T>): String where T: Drawable2 {
    "drawn"
}

fn process(_opts: List<{retries: Int, timeout: Int, on_error: (String) -> Int}>): Int {
    0
}

// Long signature — params break one per line; body always breaks.
pub fn process_all_the_users(
    users: List<User>,
    _config: Pair<String, Int>,
    _retry_count: Int,
    _more_options: List<String>,
): Result<List<User>, String> {
    Ok(users)
}

// ---------------------------------------------------------------------------
// Bindings — local, destructuring forms
// ---------------------------------------------------------------------------
fn binding_forms() {
    // Simple
    _x = 1
    _y: Int = 2

    // Tuple destructure
    (_, _) = (10, 20)

    // Distinct destructure
    Email(_) = Email("a@b.com")

    // Anon struct literal — short stays flat
    _short_anon = {a: 1, b: 2}

    // Anon struct literal — user-written multi-line preserved
    _long_anon = {
        a: 1,
        b: 2,
        c: 3,
    }

    // Named struct literal — short stays flat
    _short_lit = Point{x: 1, y: 2}

    // Named struct literal — user-written multi-line preserved
    _long_lit = User{
        name: "Bob",
        age: 42,
        email: "b@x.com",
    }
}

// ---------------------------------------------------------------------------
// Control flow — if/else, case, with
// ---------------------------------------------------------------------------
fn control_flow(n: Int): String {
    // Inline if/else with atomic bodies stays flat.
    _sign = if n > 0 { 1 } else { 0 }

    // Guard form — single-line return stays flat.
    _abs_or_zero = if n < 0 { 0 - n } else { n }

    // Long if-else — branches break.
    _classification = if n > 100 {
        "big"
    } else if n > 0 {
        "small"
    } else {
        "non-positive"
    }

    // Case expression — always multi-line, one arm per line.
    shape_label = case n {
        0 -> "zero"
        1 -> "one"
        _ -> "many"
    }

    shape_label
}

// ---------------------------------------------------------------------------
// Lambdas
// ---------------------------------------------------------------------------
fn lambda_forms() {
    // Short lambda — flat. Type annotation on the binding so type
    // inference picks up the param shape.
    _inc: (Int) -> Int = |x| x + 1

    // Lambda with parameter annotations.
    _typed = |x: Int, y: Int| x + y

    // Lambda with default param.
    _add_with_default: (Int, Int) -> Int = |x = 1, y| x + y
}

// ---------------------------------------------------------------------------
// Pipes — one |> stays inline; two or more break one stage per line
// ---------------------------------------------------------------------------
fn pipe_chain(xs: List<Int>): List<Int> {
    Iter.map(xs, |x| x + 1)
    |> Iter.filter(|x| x > 0)
    |> Iter.take(10)
    |> Iter.to_list()
}

// ---------------------------------------------------------------------------
// Type expressions in nested positions
// ---------------------------------------------------------------------------
//
// Anon struct types break at their column when long; outer container
// (tuple, generic) stays inline. Function-type-with-Return wraps its
// param list in a Group so a too-long signature breaks at the param list.
pub type Tagged (String, {tag: String, payload: Int})

pub type LongTuple (String, {
    status: Int,
    message: String,
    retryable: Bool,
    more_info: String,
})

pub typealias Pages List<{
    status: Int,
    message: String,
    retryable: Bool,
    a_long_field: String,
}>

pub typealias Endpoint ({
    req: String,
    headers: Map<String, String>,
    body: String,
}) -> Result<String, Int>

// ---------------------------------------------------------------------------
// Trivia comments — invisible to width budget
// ---------------------------------------------------------------------------
//
// Trailing comments do not force structural breaks. The formatter prefers
// to let a comment spill past 100 cols rather than uglify the code.
fn trivia_examples(): Int {
    config = {"host" => "localhost", "port" => "8080", "mode" => "debug"} // explanatory
    short_struct = Point{x: 1, y: 2} // a 2D point
    Map.size(config) + short_struct.x
}

// ---------------------------------------------------------------------------
// Long-line cases — tail-aware fits
// ---------------------------------------------------------------------------
//
// Each Group's flat-vs-broken decision considers what follows on the line.
// A Group whose own content fits but whose trailing siblings overflow
// still breaks (no silent overflow).
fn tail_aware(): Int {
    _long_call = process_all_the_users([], Pair{first: "a", second: 1}, 3, [])
    0
}

// ---------------------------------------------------------------------------
// Nomi test coverage
// ---------------------------------------------------------------------------
test "formatter showcase declarations remain executable" {
    assert add(2, 3) == 5
    assert greet("Ada") == "Hello, Ada"
    assert control_flow(0) == "zero"
    assert pipe_chain([1, -2, 3]) == [2, 4]
    assert trivia_examples() == 4
    assert tail_aware() == 0
}
