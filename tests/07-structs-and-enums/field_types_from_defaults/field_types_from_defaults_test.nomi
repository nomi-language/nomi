// A field with a default may leave out its type when the default's type
// is known from the expression alone (spec §4 *Structs*): `misses = 0` is
// an Int field. A default whose type only an expected type tells (`%[]`,
// `[]`, `None`, a `.Variant`) is an error at the field, with help that
// writes the annotation.
import {
    std::compiler.{self, Diagnostic}
    std::http.Route
    models.Settings
}

fn has_diagnostic(diagnostics: List<Diagnostic>, text: String) -> Bool {
    Iter.any_match(diagnostics, fn diagnostic -> text in diagnostic.message)
}

struct Game {
    word: String
    misses = 0
    guessed: Set<String> = %[]
    hint = "none"
}

derive Equatable for Game
derive Display for Game

enum Shape {
    Circle {radius = 1.0}
    Square {side: Float}
}

test "a field takes its default's type" {
    game = Game{word: "nomi"}
    assert game.misses == 0
    assert game.hint == "none"
    assert game.guessed == %[]
    more = .{..game, misses: game.misses + 1}
    assert more.misses == 1
    assert more != game
}

test "a record variant's field takes its default's type" {
    radius = case (Shape.Circle{}) {
        .Circle{radius} -> radius
        .Square{side} -> side
    }

    assert radius == 1.0
}

test "another file reads a field's inferred type" {
    settings = Settings{}
    assert settings.retries + 1 == 4
    assert settings.ratio == 0.5
    assert settings.name == "app"
    assert settings.started.x == 1
    assert settings.limit == 100
    home: Route = settings.home
    assert "${home}" == "GET /admin/{$}"
}

test "a default whose type needs an expected type is refused" {
    diagnostics = compiler.check(
        """
        struct Bad {
            guessed = %[]
            later = None
        }
        """
    )

    assert has_diagnostic(diagnostics, "can't tell this field's type from `%[]`")
    assert has_diagnostic(diagnostics, "can't tell this field's type from `None`")
}
