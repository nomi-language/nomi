// Fields whose type comes from their default, read from another file.
import std::http.Route

pub struct Settings
    retries = 3
    ratio = 0.5
    name = "app"
    started = Point{x: 1, y: 2}
    home = Route"GET /admin/{$}"
    limit = default_limit()
end

pub struct Point
    x: Int
    y: Int
end

fn default_limit() -> Int
    100
end
