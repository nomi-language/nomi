// A hand-written `impl Equatable` on an ENUM must answer `==`, not just
// `Equatable.equal?`.
//
// An operator dispatch path that only consulted the impl for structs would
// make an enum's hand-written impl reachable by name and unreachable by
// operator: one question with two answers, and no diagnostic. The impl
// below is deliberately COARSER than structural equality (it compares the
// sign, not the payload), so a structural fallback cannot pass these tests by
// accident: `Sign.Raw(3) == Sign.Raw(9)` is False structurally and True here.
fn positive?(s: Sign): Bool {
    case s {
        Sign.Plus -> True
        Sign.Minus -> False
        Sign.Raw(n) -> n >= 0
    }
}

enum Sign {
    Plus
    Minus
    Raw Int
}

impl Equatable for Sign {
    fn equal?(a: Sign, b: Sign): Bool {
        positive?(a) == positive?(b)
    }
}

test "a hand-written Equatable on an enum answers ==" {
    assert Sign.Raw(3) == Sign.Raw(9)
    assert Sign.Plus == Sign.Raw(1)
    refute Sign.Plus == Sign.Minus
    refute Sign.Raw(-1) == Sign.Raw(1)
}

test "the operator and the by-name call agree" {
    assert Equatable.equal?(Sign.Raw(3), Sign.Raw(9)) == (Sign.Raw(3) == Sign.Raw(9))

    assert Equatable.equal?(Sign.Plus, Sign.Minus) == (Sign.Plus == Sign.Minus)
}

test "!= is the negation of the hand-written impl" {
    refute Sign.Raw(3) != Sign.Raw(9)
    assert Sign.Plus != Sign.Minus
}

enum Color {
    Red
    Green
}

derive Equatable for Color

// A DERIVED enum keeps comparing structurally. This is not an oversight: the
// prelude's `Maybe` and `Result` both carry `derive Equatable`, and routing a
// synthesized impl through a Nomi function call would put one on the two
// hottest comparisons in the language for no change in answer.
test "a derived enum still compares structurally, both ways" {
    assert Color.Red == Color.Red
    refute Color.Red == Color.Green
    assert Equatable.equal?(Color.Red, Color.Red)
    refute Equatable.equal?(Color.Red, Color.Green)
}

test "the prelude enums keep their answers" {
    assert Some(1) == Some(1)
    refute Some(1) == Some(2)
    assert None == None
    refute Some(1) == None
    assert Ok(1) == Ok(1)
    refute Ok(1) == Ok(2)
}
