// A bare struct used where an `embeds` enum is expected must MATCH the
// positional variant pattern, and bind.
//
// The type checker admits a bare `Circle` wherever a `Shape` is wanted:
// `TypesEqual` accepts embed-subtyping (T <= E) and says so in its own comment.
// So a `Shape`-typed value can reach a pattern either as the variant or as the
// bare struct, and every site that consumes a variant pattern has to handle
// both. Getting one wrong fails loudly rather than as a wrong answer:
//
//   - `case s { Shape.Circle(c) -> ... }` would match NO arm and TRAP with
//     `no matching case branch`, from source the front end accepts. The
//     `Shape.Circle{r}` spelling is a StructPattern with its own coercion, so
//     the two spellings of one pattern are handled in two places.
//   - `assert Shape.Circle(c) = value` would MATCH and bind NOTHING, surfacing
//     one line later as `undefined variable 'c'`, which points at the use
//     rather than at the pattern that declined.
//
// Both spellings and both representations are asserted here, so a failure in
// either spelling, for either representation, shows up in this file rather
// than somewhere downstream.
struct Circle {
    r: Int
}

enum Shape {
    embeds Circle
    Line
}

fn positional(s: Shape): Int {
    case s {
        Shape.Circle(c) -> c.r
        Shape.Line -> 0
    }
}

fn struct_form(s: Shape): Int {
    case s {
        Shape.Circle{r} -> r
        Shape.Line -> 0
    }
}

tests "a bare struct reaching an embeds enum" {
    test "the positional pattern matches the bare spelling" {
        coerced: Shape = Circle{r: 1}

        assert positional(coerced) == 1
    }

    test "the positional pattern matches the enum spelling" {
        spelled = Shape.Circle{r: 2}

        assert positional(spelled) == 2
    }

    test "the struct-field pattern matches the bare spelling" {
        coerced: Shape = Circle{r: 3}

        assert struct_form(coerced) == 3
    }

    test "the struct-field pattern matches the enum spelling" {
        spelled = Shape.Circle{r: 4}

        assert struct_form(spelled) == 4
    }

    test "a destructure of the bare spelling binds its payload" {
        coerced: Shape = Circle{r: 5}

        assert Shape.Circle(c) = coerced
        assert c.r == 5
    }

    test "the other variant still selects its own arm" {
        assert positional(Shape.Line) == 0
        assert struct_form(Shape.Line) == 0
    }
}
