import
    std::assertions.AssertionFailure
    std::compiler
    test_helpers
end

test "if else is an expression"
    x = 42
    label = if x > 50 then "big" else "small"
    assert label == "small"
end

test "if without else returns Unit either way"
    when_true = if True then Unit
    when_false = if False then Unit

    assert when_true == Unit
    assert when_false == Unit
end

test "else None makes an if a Maybe"
    when_true = if True then Some(1) else None
    when_false = if False then Some(1) else None

    assert when_true == Some(1)
    assert when_false == None
end

test "an else if chain ending in else None is its branches' Maybe"
    pick = fn n: Int ->
        if n > 0 then
            Some("positive")
        else if n < 0 then
            Some("negative")
        else
            None
        end
    end

    assert pick(1) == Some("positive")
    assert pick(-1) == Some("negative")
    assert pick(0) == None
end

test "if without else whose branch is a Maybe is an error"
    diagnostics = compiler.check(
        """
          fn one() -> Maybe<Int>
            if True then Some(1)
          end
        """
    )

    assert test_helpers.has_diagnostic(
        diagnostics,
        "an `if` without `else` is a statement, so its branch must be `Unit`; this branch is a `Maybe<Int>`. Add `else None` to make the `if` a `Maybe<Int>`",
    )
end

test "a forgotten else names the branch's type"
    diagnostics = compiler.check(
        """
          fn label(n: Int) -> String
            if n > 0 then "positive"
          end
        """
    )

    assert test_helpers.has_diagnostic(
        diagnostics,
        "an `if` without `else` is a statement, so its branch must be `Unit`; this branch is a `String`. Add an `else` to give the `if` a value",
    )
end

test "if without else allows Unit side effects"
    fake_side_effect = fn ->
        // Imagine an io.print side effect here
        Unit
    end

    result = if True then fake_side_effect()

    assert result == Unit
end

test "if without else allows early return branches"
    assert parse_id("") == Err("empty")
    assert parse_id("42") == Ok(42)
end

test "nested if expressions return branch values"
    x = 42

    result = if x == 42 then "the answer" else "not the answer"

    assert result == "the answer"
end

test "if can match and bind a pattern"
    maybe_name = Some("Ada")

    label = if Some(name) = maybe_name then
        name
    else
        "unknown"
    end

    assert label == "Ada"
end

test "if pattern mismatch evaluates else"
    maybe_name: Maybe<String> = None

    label = if Some(name) = maybe_name then
        name
    else
        "unknown"
    end

    assert label == "unknown"
end

test "if pattern bindings are scoped to the then branch"
    diagnostics = compiler.check(
        """
          fn main()
            maybe_name = Some("Ada")
            if Some(name) = maybe_name then Unit
            name
          end
        """
    )

    assert test_helpers.has_diagnostic(diagnostics, "undefined variable 'name'")
end

test "else if chains select the first matching branch"
    x = 42

    bucket = if x < 0 then
        "negative"
    else if x < 10 then
        "small"
    else if x < 100 then
        "medium"
    else
        "large"
    end

    assert bucket == "medium"
end

fn parse_id(input: String) -> Result<Int, String>
    if String.length(input) == 0 then return Err("empty")

    Ok(42)
end

test "a branch that ends in assert or dbg keeps the if a statement"
    n = 3

    if n > 0 then
        assert n == 3
    end

    if n > 5 then
        assert n == 9
    end

    assert in_range(4) == Ok(4)
    assert Result.is_err(in_range(40))
    shown(2)
end

test "an if without else whose value a statement drops says to write _ ="
    diagnostics = compiler.check(
        """
          fn label(n: Int) -> Int
            if n > 0 then n + 1
            n
          end
        """
    )

    assert test_helpers.has_diagnostic(
        diagnostics,
        "this branch is an `Int`, which this statement drops. Write `_ = n + 1` in the branch, or add an `else`",
    )
end

fn in_range(n: Int) -> Result<Int, AssertionFailure>
    if n > 0 then
        assert n < 10
    end

    Ok(n)
end

fn shown(n: Int)
    if n > 0 then dbg n
end
