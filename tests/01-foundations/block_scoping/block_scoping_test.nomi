import
    std::compiler
    test_helpers
end

test "block-scoped declarations are visible inside their enclosing block"
    fn double(n: Int) -> Int
        n * 2
    end

    assert double(21) == 42

    scale_factor = 10

    fn scale(n: Int) -> Int
        n * scale_factor
    end

    assert scale(7) == 70

    struct Point
        x: Int
        y: Int
    end

    fn make_point() -> Point
        Point{x: 3, y: 4}
    end

    p = make_point()
    assert p.x + p.y == 7

    struct Defaulted
        v: Int = 99
    end

    d = Defaulted{}
    assert d.v == 99

    typealias Count Int

    fn make_count(n: Int) -> Count
        n
    end

    assert make_count(5) == 5

    type UserId Int
    UserId(n) = UserId(42)
    assert n == 42

    enum Color
        Red
        Green
        Blue
    end

    fn pick() -> Color
        Color.Green
    end

    result = case pick()
        Color.Red   -> "red"
        Color.Green -> "green"
        Color.Blue  -> "blue"
    end

    assert result == "green"

    base = 100

    fn add_base(n: Int) -> Int
        n + base
    end

    assert add_base(5) == 105
end

test "nested functions do not leak outside their enclosing function"
    diagnostics = compiler.check(
        """
          fn main()
            fn helper() -> Int
              1
            end

            _ = helper()
          end

          fn other() -> Int
            helper()
          end
        """
    )

    assert test_helpers.has_diagnostic(diagnostics, "undefined variable 'helper'")
end

test "imports can be declared inside function bodies"
    fn first() -> Maybe<Int>
        import std::maybe.Maybe as Local

        Local.Some(1)
    end

    fn second() -> Result<Int, String>
        import std::results.Result as Local

        Local.Ok(2)
    end

    assert first() == Some(1)
    assert second() == Ok(2)
end
