test "bindings can shadow earlier bindings in the same scope"
    greeting = "Jane"
    assert greeting == "Jane"

    greeting = "John"
    assert greeting == "John"
end

test "bindings can shadow parameters and locals"
    fn double_then_inc(x: Int) -> Int
        x = x + x
        x = x + 1
        x
    end

    assert double_then_inc(10) == 21
end

test "bindings can shadow with a different type"
    value = 1
    assert value == 1

    value = "one"
    assert value == "one"
end
