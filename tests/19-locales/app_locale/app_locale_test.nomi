import {
    std/locale.Locale
    main.{self, App}
}

group "Polish from LANG" {
    boot main.boot(#Startup{env: %{"LANG" => "pl_PL.UTF-8"}})

    test "the boot reads the POSIX value" {
        assert App.locale == Locale`pl-PL`
        assert main.greeting(App.locale) == "Cześć"
    }
}

group "no LANG" {
    boot main.boot(#Startup{})

    test "the boot falls back to English" {
        assert App.locale == Locale`en`
    }
}

group "pinned in setup" {
    boot main.boot(#Startup{env: %{"LANG" => "pl_PL.UTF-8"}})

    setup {
        with App.locale = Locale`en-US`
    }

    test "a with line in setup holds for the test" {
        assert main.greeting(App.locale) == "Hello"
    }
}
