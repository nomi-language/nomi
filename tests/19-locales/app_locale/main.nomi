// An application keeps its locale in an application field, read from LANG
// at boot, and passes it to whatever formats text.
import {
    std/io
    std/locale.Locale
}

pub struct App {
    locale: Locale
}

pub fn boot(startup: Startup) -> App {
    locale =
        Map.get(startup.env, "LANG")
        |> Maybe.flat_map(fn value -> Locale.from_posix(value) |> Result.to_maybe())
        |> Maybe.with_default(Locale`en`)

    #App{locale}
}

pub fn greeting(locale: Locale) -> String {
    case Locale.language(locale) {
        "pl" -> "Cześć"
        _ -> "Hello"
    }
}

// main pins the locale with a `with` line, so what it prints does not
// depend on the LANG of the machine running the corpus.
fn main() {
    with App.locale = Locale`pl-PL`
    io.print("${App.locale}: ${greeting(App.locale)}")
}
