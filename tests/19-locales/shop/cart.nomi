/// Where an order is.
pub enum Status
    Pending
    Shipped
    Delivered
end

/// How many items the cart holds.
pub phrase cart_items(count: Int) `
    .input {$count :integer}
    .match $count
    one {{{$count} item in your cart}}
    * {{{$count} items in your cart}}
    `

/// Where the customer's order is.
pub phrase order_status(status: Status) `
    .input {$status :string}
    .match $status
    Pending {{Your order is waiting to ship}}
    Shipped {{Your order is on its way}}
    Delivered {{Your order was delivered}}
    * {{Your order is on its way}}
    `

/// Who is looking at an item: a list of names, already joined.
pub phrase watching(names: String) `{$names} are watching this item`

/// A greeting before the cart's contents, another phrase.
pub phrase cart_summary(name: String, items: Phrase) `{$name}, you have {$items}`
