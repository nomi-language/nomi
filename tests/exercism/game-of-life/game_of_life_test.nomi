import game_of_life.tick

test "tick"
    [
        ("empty matrix", Vector[], Vector[]),
        (
            "live cells with zero live neighbors die",
            Vector[Vector[0, 0, 0], Vector[0, 1, 0], Vector[0, 0, 0]],
            Vector[Vector[0, 0, 0], Vector[0, 0, 0], Vector[0, 0, 0]],
        ),
        (
            "live cells with only one live neighbor die",
            Vector[Vector[0, 0, 0], Vector[0, 1, 0], Vector[0, 1, 0]],
            Vector[Vector[0, 0, 0], Vector[0, 0, 0], Vector[0, 0, 0]],
        ),
        (
            "live cells with two live neighbors stay alive",
            Vector[Vector[1, 0, 1], Vector[1, 0, 1], Vector[1, 0, 1]],
            Vector[Vector[0, 0, 0], Vector[1, 0, 1], Vector[0, 0, 0]],
        ),
        (
            "live cells with three live neighbors stay alive",
            Vector[Vector[0, 1, 0], Vector[1, 0, 0], Vector[1, 1, 0]],
            Vector[Vector[0, 0, 0], Vector[1, 0, 0], Vector[1, 1, 0]],
        ),
        (
            "dead cells with three live neighbors become alive",
            Vector[Vector[1, 1, 0], Vector[0, 0, 0], Vector[1, 0, 0]],
            Vector[Vector[0, 0, 0], Vector[1, 1, 0], Vector[0, 0, 0]],
        ),
        (
            "live cells with four or more neighbors die",
            Vector[Vector[1, 1, 1], Vector[1, 1, 1], Vector[1, 1, 1]],
            Vector[Vector[1, 0, 1], Vector[0, 0, 0], Vector[1, 0, 1]],
        ),
        (
            "bigger matrix",
            Vector[
                Vector[1, 1, 0, 1, 1, 0, 0, 0],
                Vector[1, 0, 1, 1, 0, 0, 0, 0],
                Vector[1, 1, 1, 0, 0, 1, 1, 1],
                Vector[0, 0, 0, 0, 0, 1, 1, 0],
                Vector[1, 0, 0, 0, 1, 1, 0, 0],
                Vector[1, 1, 0, 0, 0, 1, 1, 1],
                Vector[0, 0, 1, 0, 1, 0, 0, 1],
                Vector[1, 0, 0, 0, 0, 0, 1, 1],
            ],
            Vector[
                Vector[1, 1, 0, 1, 1, 0, 0, 0],
                Vector[0, 0, 0, 0, 0, 1, 1, 0],
                Vector[1, 0, 1, 1, 1, 1, 0, 1],
                Vector[1, 0, 0, 0, 0, 0, 0, 1],
                Vector[1, 1, 0, 0, 1, 0, 0, 1],
                Vector[1, 1, 0, 1, 0, 0, 0, 1],
                Vector[1, 0, 0, 0, 0, 0, 0, 0],
                Vector[0, 0, 0, 0, 0, 0, 1, 1],
            ],
        ),
    ]
    |> subtests (description, board, expected), description
        assert tick(board) == expected
    end
end
