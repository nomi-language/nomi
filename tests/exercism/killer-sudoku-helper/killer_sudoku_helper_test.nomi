import killer_sudoku_helper.combinations

test "Trivial 1-digit cages" {
    subtests 1..=9, digit {
        assert combinations(digit, 1) == [[digit]]
    }
}

test "Cage with sum 45 contains all digits 1:9" {
    assert combinations(45, 9) == [[1, 2, 3, 4, 5, 6, 7, 8, 9]]
}

test "Cage with only 1 possible combination" {
    assert combinations(7, 3) == [[1, 2, 4]]
}

test "Cage with several combinations" {
    assert combinations(10, 2) == [[1, 9], [2, 8], [3, 7], [4, 6]]
}

test "Cage with several combinations that is restricted" {
    assert combinations(10, 2, exclude: [1, 4]) == [[2, 8], [3, 7]]
}
