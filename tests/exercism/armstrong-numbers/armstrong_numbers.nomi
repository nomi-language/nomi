/// Reports whether `number` is the sum of its own digits, each raised to
/// the power of the number of digits: `153 == 1^3 + 5^3 + 3^3`.
pub fn armstrong?(number: Int) -> Bool {
    digits = digits_of(number)
    width = Iter.count(digits)

    total =
        digits
        |> Iter.map(&power(&1, width))
        |> Iter.sum()

    total == number
}

/// The decimal digits of a non-negative `number`, least significant first.
fn digits_of(number: Int) -> List<Int> {
    if number == 0 { return [0] }

    Iter.iterate(number, &(&1 / 10))
    |> Iter.take_while(&(&1 > 0))
    |> Iter.map(&(&1 % 10))
    |> Iter.to_list()
}

fn power(base: Int, exponent: Int) -> Int {
    Iter.repeat(base) |> Iter.take(exponent) |> Iter.reduce(fn product = 1, n -> product * n)
}
