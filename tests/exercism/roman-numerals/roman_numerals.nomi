once numerals = [
    (1000, "M"),
    (900, "CM"),
    (500, "D"),
    (400, "CD"),
    (100, "C"),
    (90, "XC"),
    (50, "L"),
    (40, "XL"),
    (10, "X"),
    (9, "IX"),
    (5, "V"),
    (4, "IV"),
    (1, "I"),
]

/// `number` in Roman numerals. Each numeral, largest first, is written as
/// many times as it fits into what is left.
pub fn roman(number: Int): String {
    (_, text) = Iter.reduce(numerals, |(left, text) = (number, ""), (value, symbol)| {
        (left % value, text + String.repeat(symbol, left / value))
    })

    text
}
