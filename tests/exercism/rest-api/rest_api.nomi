import std/json.{FromJson, Json, ToJson}

/// A roommate: who they owe and how much, who owes them, and the
/// difference, what they are owed less what they owe.
pub struct User {
    name: String
    owes: Map<String, Float> = %{}
    owed_by: Map<String, Float> = %{}
    balance: Float = 0.0
}

derive Equatable for User
derive ToJson for User
derive FromJson for User

/// The body of a `/users` answer and of the database: users by name.
pub struct Users {
    users: List<User>
}

derive Equatable for Users
derive ToJson for Users
derive FromJson for Users

/// The payload of `GET /users`: the users to list.
struct UserNames {
    users: List<String>
}

derive FromJson for UserNames

/// The payload of `POST /add`.
struct NewUser {
    user: String
}

derive FromJson for NewUser

/// The payload of `POST /iou`: `borrower` owes `lender` `amount` more.
struct Iou {
    lender: String
    borrower: String
    amount: Float
}

derive FromJson for Iou

/// Why a request has no answer.
pub enum Error {
    /// The payload or the database is not JSON of the expected shape; the
    /// text says where.
    InvalidJson String
    /// No method answers this URL.
    NotFound String
    UnknownUser String
    UserExists String
}

/// The IOU tracker: every user by name. Each request answers JSON text, and
/// a `POST` answers the tracker after it too.
pub opaque struct RestApi {
    users: Map<String, User>
}

impl RestApi {
    /// The tracker over `database`, a JSON object `{"users": [...]}`.
    pub fn new(database: String) -> Result<RestApi, Error> {
        database: Users = try read(database)

        Ok(
            #RestApi{
                users: database.users |> Iter.map(fn user -> #(user.name, user)) |> Iter.to_map(),
            }
        )
    }

    /// Answers a `GET` of `url`: `/users` lists every user, or the users
    /// `payload` names, by name.
    pub fn get(api: RestApi, url: String, payload: Maybe<String> = None) -> Result<String, Error> {
        if url != "/users" { return Err(.NotFound(url)) }

        names = case payload {
            Some(text) -> {
                query: UserNames = try read(text)
                query.users
            }

            None ->
                Map.keys(api.users)
        }

        users = names |> Iter.map(&find(api, &1)) |> try Result.collect()
        Ok(write(#Users{users: Iter.sort_by(users, .name)}))
    }

    /// Answers a `POST` of `payload` to `url`, and the tracker after it.
    /// `/add` adds a user and answers it; `/iou` records a loan and answers
    /// the lender and the borrower, by name.
    pub fn post(api: RestApi, url: String, payload: String) -> Result<#(String, RestApi), Error> {
        case url {
            "/add" -> {
                request: NewUser = try read(payload)

                if Map.contains?(api.users, request.user) {
                    return Err(.UserExists(request.user))
                }

                user = #User{name: request.user}
                Ok(#(write(user), #RestApi{users: Map.put(api.users, user.name, user)}))
            }

            "/iou" -> {
                iou: Iou = try read(payload)
                lender = try find(api, iou.lender)
                borrower = try find(api, iou.borrower)
                net = net_owed(lender, borrower.name) + iou.amount
                lender = with_net(lender, borrower.name, net)
                borrower = with_net(borrower, lender.name, -net)

                users =
                    api.users |> Map.put(lender.name, lender) |> Map.put(borrower.name, borrower)

                answer = #Users{users: Iter.sort_by([lender, borrower], .name)}
                Ok(#(write(answer), #RestApi{users}))
            }

            _ ->
                Err(.NotFound(url))
        }
    }
}

fn find(api: RestApi, name: String) -> Result<User, Error> {
    Map.get(api.users, name) |> Maybe.to_result(Error.UnknownUser(name))
}

/// What `other` owes `user`, less what `user` owes `other`.
fn net_owed(user: User, other: String) -> Float {
    owed = Map.get(user.owed_by, other) |> Maybe.with_default(0.0)
    owing = Map.get(user.owes, other) |> Maybe.with_default(0.0)
    owed - owing
}

/// `user` with `other` owing them `net`, or owed `-net` by them when `net`
/// is negative, and nothing either way at zero.
fn with_net(user: User, other: String, net: Float) -> User {
    owes = Map.remove(user.owes, other)
    owed_by = Map.remove(user.owed_by, other)

    owes = if net < 0.0 {
        Map.put(owes, other, -net)
    } else {
        owes
    }

    owed_by = if net > 0.0 {
        Map.put(owed_by, other, net)
    } else {
        owed_by
    }

    balance = Iter.sum(Map.values(owed_by)) - Iter.sum(Map.values(owes))
    #{..user, owes, owed_by, balance}
}

/// `text` read as JSON into a `T`.
fn read<T>(text: String) -> Result<T, Error> where T: FromJson {
    json = Json.decode(text) |> try Result.map_err(&Error.InvalidJson(Display.to_string(&1)))
    T.from_json(json) |> Result.map_err(&Error.InvalidJson(Display.to_string(&1)))
}

/// `value` written as JSON text.
fn write<T>(value: T) -> String where T: ToJson {
    Json.encode(ToJson.to_json(value))
}
