import {
    resistor_color
    resistor_color.Color
}

test "Color codes" {
    cases = [
        #("Black", Color.Black, 0),
        #("White", .White, 9),
        #("Orange", .Orange, 3),
    ]

    subtests cases, #(description, color, expected), description {
        assert resistor_color.color_code(color) == expected
    }
}

test "Colors" {
    assert resistor_color.colors() == [
        Color.Black,
        .Brown,
        .Red,
        .Orange,
        .Yellow,
        .Green,
        .Blue,
        .Violet,
        .Grey,
        .White,
    ]
}
