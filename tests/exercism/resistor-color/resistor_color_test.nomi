import
    resistor_color
    resistor_color.Color
end

test "Color codes"
    [
        ("Black", Color.Black, 0),
        ("White", .White, 9),
        ("Orange", .Orange, 3),
    ]
    |> subtests (description, color, expected), description
        assert resistor_color.color_code(color) == expected
    end
end

test "Colors"
    assert resistor_color.colors() == [
        .Black,
        .Brown,
        .Red,
        .Orange,
        .Yellow,
        .Green,
        .Blue,
        .Violet,
        .Grey,
        .White,
    ]
end
