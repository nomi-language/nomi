//# A small `grep`: searches files for lines that match a string, with the
//# canonical flags.

import {
    std/fs
    std/io
}

/// The canonical flags.
pub enum Flag {
    /// `-n`: put each line's number, from 1, before it.
    LineNumbers
    /// `-l`: answer the names of the files with a match, not the lines.
    FileNames
    /// `-i`: compare without regard to case.
    IgnoreCase
    /// `-v`: answer the lines that do not match.
    Invert
    /// `-x`: match only a line that is the whole pattern.
    WholeLine
}

derive Equatable for Flag
derive Hashable for Flag

/// The lines of `files` that contain `pattern`, in file order, as `flags`
/// say. With more than one file each line starts with its file's name.
/// A file that cannot be read is the error reading it gave.
pub fn grep(
    pattern: String,
    flags: Set<Flag>,
    files: List<String>,
) -> Result<List<String>, io.Error> {
    named = Iter.count(files) > 1

    files
    |> Iter.map(&search(&1, pattern, flags, named))
    |> Result.collect()?
    |> Iter.flatten()
    |> Ok()
}

/// What `grep` answers for one file.
fn search(
    file: String,
    pattern: String,
    flags: Set<Flag>,
    named: Bool,
) -> Result<List<String>, io.Error> {
    text = fs.read_text(file)?

    found =
        String.lines(text)
        |> Iter.with_index()
        |> Iter.filter(fn #(_index, line) -> matches(line, pattern, flags))
        |> Iter.to_list()

    if Set.contains(flags, .FileNames) {
        Ok(if Iter.is_empty(found) { [] } else { [file] })
    } else {
        found
        |> Iter.map(fn #(index, line) -> {
            file_part = if named { "${file}:" } else { "" }

            number_part = if Set.contains(flags, .LineNumbers) {
                "${index + 1}:"
            } else {
                ""
            }

            file_part + number_part + line
        })
        |> Iter.to_list()
        |> Ok()
    }
}

fn matches(line: String, pattern: String, flags: Set<Flag>) -> Bool {
    #(line, pattern) = if Set.contains(flags, .IgnoreCase) {
        #(String.fold_case(line), String.fold_case(pattern))
    } else {
        #(line, pattern)
    }

    found = if Set.contains(flags, .WholeLine) {
        line == pattern
    } else {
        String.contains(line, pattern)
    }

    found != Set.contains(flags, .Invert)
}
