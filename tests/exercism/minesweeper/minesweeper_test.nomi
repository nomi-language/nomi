import minesweeper

test "no rows" {
    assert minesweeper.annotate([]) == []
}

test "no columns" {
    minefield = [""]

    assert minesweeper.annotate(minefield) == [""]
}

test "no mines" {
    minefield = ["   ", "   ", "   "]

    assert minesweeper.annotate(minefield) == ["   ", "   ", "   "]
}

test "minefield with only mines" {
    minefield = ["***", "***", "***"]

    assert minesweeper.annotate(minefield) == ["***", "***", "***"]
}

test "mine surrounded by spaces" {
    minefield = ["   ", " * ", "   "]

    assert minesweeper.annotate(minefield) == ["111", "1*1", "111"]
}

test "space surrounded by mines" {
    minefield = ["***", "* *", "***"]

    assert minesweeper.annotate(minefield) == ["***", "*8*", "***"]
}

test "horizontal line" {
    minefield = [" * * "]

    assert minesweeper.annotate(minefield) == ["1*2*1"]
}

test "horizontal line, mines at edges" {
    minefield = ["*   *"]

    assert minesweeper.annotate(minefield) == ["*1 1*"]
}

test "vertical line" {
    minefield = [" ", "*", " ", "*", " "]

    assert minesweeper.annotate(minefield) == ["1", "*", "2", "*", "1"]
}

test "vertical line, mines at edges" {
    minefield = ["*", " ", " ", " ", "*"]

    assert minesweeper.annotate(minefield) == ["*", "1", " ", "1", "*"]
}

test "cross" {
    minefield = ["  *  ", "  *  ", "*****", "  *  ", "  *  "]

    assert minesweeper.annotate(minefield) == [" 2*2 ", "25*52", "*****", "25*52", " 2*2 "]
}

test "large minefield" {
    minefield = [" *  * ", "  *   ", "    * ", "   * *", " *  * ", "      "]

    assert minesweeper.annotate(minefield) == [
        "1*22*1",
        "12*322",
        " 123*2",
        "112*4*",
        "1*22*2",
        "111111",
    ]
}

