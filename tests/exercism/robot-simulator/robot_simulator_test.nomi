import robot_simulator.{Direction, Robot}

group "Create robot" {
    test "at origin facing north" {
        robot = Robot{position: {x: 0, y: 0}, direction: .North}
        assert robot.position == {x: 0, y: 0}
        assert robot.direction == .North
    }

    test "at negative position facing south" {
        robot = Robot{position: {x: -1, y: -1}, direction: .South}
        assert robot.position == {x: -1, y: -1}
        assert robot.direction == .South
    }
}

group "Rotating clockwise" {
    test "move" {
        cases: List<(String, (Int, Int), Direction, String, (Int, Int), Direction)> = [
            ("changes north to east", (0, 0), .North, "R", (0, 0), .East),
            ("changes east to south", (0, 0), .East, "R", (0, 0), .South),
            ("changes south to west", (0, 0), .South, "R", (0, 0), .West),
            ("changes west to north", (0, 0), .West, "R", (0, 0), .North),
        ]

        subtests cases, (
            description,
            (x, y),
            facing,
            instructions,
            (to_x, to_y),
            to_facing
        ), description {
            robot = Robot{position: {x, y}, direction: facing}
            expected = Robot{position: {x: to_x, y: to_y}, direction: to_facing}
            assert Robot.move(robot, instructions) == Ok(expected)
        }
    }
}

group "Rotating counter-clockwise" {
    test "move" {
        cases: List<(String, (Int, Int), Direction, String, (Int, Int), Direction)> = [
            ("changes north to west", (0, 0), .North, "L", (0, 0), .West),
            ("changes west to south", (0, 0), .West, "L", (0, 0), .South),
            ("changes south to east", (0, 0), .South, "L", (0, 0), .East),
            ("changes east to north", (0, 0), .East, "L", (0, 0), .North),
        ]

        subtests cases, (
            description,
            (x, y),
            facing,
            instructions,
            (to_x, to_y),
            to_facing
        ), description {
            robot = Robot{position: {x, y}, direction: facing}
            expected = Robot{position: {x: to_x, y: to_y}, direction: to_facing}
            assert Robot.move(robot, instructions) == Ok(expected)
        }
    }
}

group "Moving forward one" {
    test "move" {
        cases: List<(String, (Int, Int), Direction, String, (Int, Int), Direction)> = [
            ("facing north increments Y", (0, 0), .North, "A", (0, 1), .North),
            ("facing south decrements Y", (0, 0), .South, "A", (0, -1), .South),
            ("facing east increments X", (0, 0), .East, "A", (1, 0), .East),
            ("facing west decrements X", (0, 0), .West, "A", (-1, 0), .West),
        ]

        subtests cases, (
            description,
            (x, y),
            facing,
            instructions,
            (to_x, to_y),
            to_facing
        ), description {
            robot = Robot{position: {x, y}, direction: facing}
            expected = Robot{position: {x: to_x, y: to_y}, direction: to_facing}
            assert Robot.move(robot, instructions) == Ok(expected)
        }
    }
}

group "Follow series of instructions" {
    test "move" {
        cases: List<(String, (Int, Int), Direction, String, (Int, Int), Direction)> = [
            ("moving east and north from README", (7, 3), .North, "RAALAL", (9, 4), .West),
            ("moving west and north", (0, 0), .North, "LAAARALA", (-4, 1), .West),
            ("moving west and south", (2, -7), .East, "RRAAAAALA", (-3, -8), .South),
            ("moving east and north", (8, 4), .South, "LAAARRRALLLL", (11, 5), .North),
        ]

        subtests cases, (
            description,
            (x, y),
            facing,
            instructions,
            (to_x, to_y),
            to_facing
        ), description {
            robot = Robot{position: {x, y}, direction: facing}
            expected = Robot{position: {x: to_x, y: to_y}, direction: to_facing}
            assert Robot.move(robot, instructions) == Ok(expected)
        }
    }
}

