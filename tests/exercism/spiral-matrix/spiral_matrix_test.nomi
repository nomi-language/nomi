import spiral_matrix.spiral_matrix

test "empty spiral" {
    assert spiral_matrix(0) == #[]
}

test "trivial spiral" {
    assert spiral_matrix(1) == #[#[1]]
}

test "spiral of size 2" {
    assert spiral_matrix(2) == #[#[1, 2], #[4, 3]]
}

test "spiral of size 3" {
    assert spiral_matrix(3) == #[#[1, 2, 3], #[8, 9, 4], #[7, 6, 5]]
}

test "spiral of size 4" {
    assert spiral_matrix(4) == #[#[1, 2, 3, 4], #[12, 13, 14, 5], #[11, 16, 15, 6], #[10, 9, 8, 7]]
}

test "spiral of size 5" {
    assert spiral_matrix(5) == #[
        #[1, 2, 3, 4, 5],
        #[16, 17, 18, 19, 6],
        #[15, 24, 25, 20, 7],
        #[14, 23, 22, 21, 8],
        #[13, 12, 11, 10, 9],
    ]
}
