/// A square grid of numbers, row by row.
pub typealias Grid Vector<Vector<Int>>

/// The `size` by `size` grid holding 1 to `size * size`, starting at the top
/// left corner and spiralling clockwise inwards.
pub fn spiral_matrix(size: Int): Grid {
    empty_row = Iter.repeat(0) |> Iter.take(size) |> Iter.to_vector()
    grid = Iter.repeat(empty_row) |> Iter.take(size) |> Iter.to_vector()

    fill(grid, (0, 0), (0, 1), 1, size * size) |> Maybe.with_default(grid)
}

/// Writes `value` at `position`, then moves on along `heading`, turning
/// clockwise when the next square is off the grid or already written, until
/// `last` is written. `None` if the walk steps off the grid, which it never
/// does.
fn fill(grid: Grid, position: (Int, Int), heading: (Int, Int), value: Int, last: Int): Maybe<Grid> {
    if value > last { return Some(grid) }

    grid = try set_cell(grid, position, value)

    heading = if empty?(grid, step(position, heading)) {
        heading
    } else {
        turn(heading)
    }

    fill(grid, step(position, heading), heading, value + 1, last)
}

fn step((row, column): (Int, Int), (dr, dc): (Int, Int)): (Int, Int) {
    (row + dr, column + dc)
}

fn turn((dr, dc): (Int, Int)): (Int, Int) {
    (dc, -dr)
}

/// Whether `position` is on the grid and not written yet.
fn empty?(grid: Grid, position: (Int, Int)): Bool {
    cell_at(grid, position) == Some(0)
}

fn cell_at(grid: Grid, (row, column): (Int, Int)): Maybe<Int> {
    cells = try Vector.at(grid, row)
    Vector.at(cells, column)
}

/// `grid` with `value` at `position`, or `None` if `position` is off the
/// grid.
fn set_cell(grid: Grid, (row, column): (Int, Int), value: Int): Maybe<Grid> {
    cells = try Vector.at(grid, row)
    cells = try Vector.set(cells, column, value)
    Vector.set(grid, row, cells)
}
