//# Grains of wheat on a chessboard, doubling from one grain on the first
//# square. The 64th square holds 2^63 grains and the board 2^64 - 1, which an
//# `Int` holds exactly, as it holds a whole number of any size.

/// The grains on `square`, numbered from 1 to 64.
pub fn square(square: Int) -> Result<Int, String> {
    if not Range.contains(1..=64, square) { return Err("square must be between 1 and 64") }

    Ok(grains_on(square))
}

/// The grains on the whole board.
pub fn total() -> Int {
    1..=64 |> Iter.map(grains_on) |> Iter.sum()
}

fn grains_on(square: Int) -> Int {
    Int.pow(2, square - 1)
}
