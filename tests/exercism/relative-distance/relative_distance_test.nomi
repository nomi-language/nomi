/// The family of the last complex case: `family` with Elias left out, so
/// Javier's line is a tree of its own.
once split_family = %{
    "Aiko" => ["Bao", "Carlos"],
    "Bao" => ["Dalia"],
    "Carlos" => ["Fatima", "Gustavo"],
    "Dalia" => ["Hassan", "Isla"],
    "Fatima" => ["Khadija", "Liam"],
    "Gustavo" => ["Mina"],
    "Hassan" => ["Noah", "Olga"],
    "Isla" => ["Pedro"],
    "Javier" => ["Quynh", "Ravi"],
    "Khadija" => ["Sofia"],
    "Liam" => ["Tariq", "Uma"],
    "Mina" => ["Viktor", "Wang"],
    "Noah" => ["Xiomara"],
    "Olga" => ["Yuki"],
    "Pedro" => ["Zane", "Aditi"],
    "Quynh" => ["Boris"],
    "Ravi" => ["Celine"],
    "Sofia" => ["Diego", "Elif"],
    "Tariq" => ["Farah"],
    "Uma" => ["Giorgio"],
    "Viktor" => ["Hana", "Ian"],
    "Wang" => ["Jing"],
    "Xiomara" => ["Kaito"],
    "Yuki" => ["Leila"],
    "Zane" => ["Mateo"],
    "Aditi" => ["Nia"],
    "Boris" => ["Oscar"],
    "Celine" => ["Priya"],
    "Diego" => ["Qi"],
    "Elif" => ["Rami"],
    "Farah" => ["Sven"],
    "Giorgio" => ["Tomoko"],
    "Hana" => ["Umar"],
    "Ian" => ["Vera"],
    "Jing" => ["Wyatt"],
    "Kaito" => ["Xia"],
    "Leila" => ["Yassin"],
    "Mateo" => ["Zara"],
