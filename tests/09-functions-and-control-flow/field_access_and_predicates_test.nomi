pub struct Inner
    value: Int
end

pub struct Mid
    inner: Inner
end

pub struct Outer
    mid: Mid
end

pub struct Box<T>
    item: T
end

pub struct Crate<T>
    box: Box<T>
end

fn is_even(n: Int) -> Bool
    n % 2 == 0
end

interface Validatable
    fn is_valid(value: self) -> Bool
end

struct Password
    text: String
end

impl Validatable for Password
    fn is_valid(p: Password) -> Bool
        String.length(p.text) >= 6
    end
end

test "field-access chains resolve through structs and generics"
    o = Outer{
        mid: Mid{inner: Inner{value: 42}},
    }

    c = Crate{
        box: Box{item: Inner{value: 7}},
    }

    p = Outer{
        mid: Mid{inner: Inner{value: 100}},
    }

    pair = (p.mid.inner.value, p.mid.inner.value)

    assert o.mid.inner.value == 42
    assert c.box.item.value == 7
    assert pair == (100, 100)
end

test "predicate-named functions and bindings stay callable"
    nums = [1, 2, 3, 4, 5, 6]

    evens =
        nums
        |> Iter.filter(is_even)
        |> Iter.to_list()

    has_even = Iter.any_match(nums, is_even)
    is_empty = Iter.is_empty(nums)

    assert is_even(4)
    refute is_even(5)
    assert evens == [2, 4, 6]
    assert has_even
    refute is_empty
    assert Validatable.is_valid(Password{text: "hunter2"})
    refute Validatable.is_valid(Password{text: "no"})
end
