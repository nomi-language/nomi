import std/compiler

fn unfinished(flag: Bool, n: Int): Int {
    if flag { todo "handle the flag" } else { n * 2 }
}

test "a todo on a path the run does not take never traps" {
    assert unfinished(False, 4) == 8
}

test "a todo checks wherever a value is expected" {
    diagnostics =
        """
            struct Point {
              x: Int
              y: Int
            }

            fn parse(text: String): Point {
              todo "parse the point"
            }

            fn make(n: Int): Point {
              Point{x: n, y: todo}
            }

            fn main() {
              _ = 1
            }
            """
        |> compiler.check()

    assert diagnostics == []
}

test "reaching a todo stops the program with its place and reason" {
    result =
        """
            fn main(): Int {
              todo "finish main"
            }
            """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains?(message, "todo reached at ")
    assert String.ends_with?(message, ":2: finish main")
}

test "an unannotated binding of a todo asks for a type" {
    diagnostics =
        """
            fn main() {
              x = todo
              _ = x
            }
            """
        |> compiler.check()

    assert Iter.any?(diagnostics, |d|
        String.contains?(d.message, "cannot infer a type for 'x' from `todo`")
    )
}
