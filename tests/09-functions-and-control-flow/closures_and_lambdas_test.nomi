fn make_adder(n: Int): (Int) -> Int {
    |x| n + x
}

fn apply(f: (Int) -> Int, x: Int): Int {
    f(x)
}

fn double(n: Int): Int {
    n * 2
}

test "closures capture values and lambdas infer local parameter types" {
    add5 = make_adder(5)
    square = |n: Int| n * n
    greet = |name = "world"| "hello, " + name + "!"

    assert add5(10) == 15
    assert square(7) == 49
    assert greet("nomi") == "hello, nomi!"
    assert apply(double, 7) == 14
}

test "lambdas compose through iterator pipelines" {
    doubled =
        [1, 2, 3]
        |> Iter.map(|x| x * 2)
        |> Iter.to_list()

    large =
        [1, 2, 3, 4, 5]
        |> Iter.filter(|x| x > 3)
        |> Iter.to_list()

    incremented =
        [10, 20, 30]
        |> Iter.map(|x| x + 1)
        |> Iter.to_list()

    assert doubled == [2, 4, 6]
    assert large == [4, 5]
    assert incremented == [11, 21, 31]
}

test "lambda defaults drive parameter inference" {
    square = Iter.loop(|n = 5|
        if n == 0 {
            break 0
        } else {
            n - 1
        }
    )

    any_pos =
        [-1, -2, 3, -4]
        |> Iter.reduce(|_seen = False, x|
            if x > 0 {
                break True
            } else {
                False
            }
        )

    fib = Iter.loop(|state = (0, 1)| {
        (a, b) = state
        if b > 50 { break state }
        (b, a + b)
    })

    squares =
        [1, 2, 3]
        |> Iter.reduce(|acc = [], x| [x * x, ..acc])
        |> Iter.reverse()

    found =
        [1, 2, 3, 4]
        |> Iter.reduce(|acc = None, x|
            case acc {
                Some(v) -> Some(v)
                None -> if x == 3 { Some(x) } else { None }
            }
        )

    taken = Iter.reduce([10, 20, 30, 40], |state = (0, []), x| {
        (count, acc) = state

        if count >= 2 {
            break (count, acc)
        } else {
            (count + 1, [x, ..acc])
        }
    })

    (_, kept) = taken

    counts =
        [("a", 1), ("b", 2), ("a", 3)]
        |> Iter.reduce(|acc = Map.empty(), (k, v)|
            case Map.get(acc, k) {
                Some(prev) -> Map.put(acc, k, prev + v)
                None -> Map.put(acc, k, v)
            }
        )

    assert square == 0
    assert any_pos
    assert fib == (34, 55)
    assert squares == [1, 4, 9]
    assert found == Some(3)
    assert Iter.reverse(kept) == [10, 20]
    assert Map.get(counts, "a") == Some(4)
    assert Map.get(counts, "b") == Some(2)
}
