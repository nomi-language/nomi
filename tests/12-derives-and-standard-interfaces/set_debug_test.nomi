struct Point {
    x: Int
}

enum Color {
    Red
    Blue
}

struct Palette {
    colors: Set<Color>
}

test "a Set of enum values inspects each member through its Debug" {
    colors = #{Color.Red, Color.Blue}

    assert Debug.inspect(colors) == "#{Red, Blue}"
}

test "a Set of structs inspects each member through its Debug" {
    points = #{Point{x: 1}, Point{x: 2}}

    assert Debug.inspect(points) == "#{Point{x: 1}, Point{x: 2}}"
}

test "a Set of declared members nested in other values inspects" {
    colors = #{Color.Blue}

    assert Debug.inspect([colors]) == "[#{Blue}]"
    assert Debug.inspect(Some(colors)) == "Some(#{Blue})"
    assert Debug.inspect(Palette{colors}) == "Palette{colors: #{Blue}}"
    assert Debug.inspect(#{Some(Color.Red)}) == "#{Some(Red)}"
}
