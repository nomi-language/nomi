type Score Int

fn score_value(score: Score): Int {
    Score(n) = score
    n
}

type Day Int

fn day_value(day: Day): Int {
    Day(n) = day
    n
}

type Day.Hours Int

fn hours_value(hours: Day.Hours): Int {
    Day.Hours(n) = hours
    n
}

type Days Int

fn days_value(days: Days): Int {
    Days(n) = days
    n
}

type Weeks Int

fn weeks_value(weeks: Weeks): Int {
    Weeks(n) = weeks
    n
}

impl Add<Score, Score> for Score {
    fn add(lhs: Score, rhs: Score): Score {
        Score(score_value(lhs) + score_value(rhs))
    }
}

impl Subtract<Score, Score> for Score {
    fn subtract(lhs: Score, rhs: Score): Score {
        Score(score_value(lhs) - score_value(rhs))
    }
}

impl Multiply<Score, Score> for Score {
    fn multiply(lhs: Score, rhs: Score): Score {
        Score(score_value(lhs) * score_value(rhs))
    }
}

impl Divide<Score, Score> for Score {
    fn divide(lhs: Score, rhs: Score): Score {
        Score(score_value(lhs) / score_value(rhs))
    }
}

impl Add<Days, Day> for Day {
    fn add(lhs: Day, rhs: Days): Day {
        Day(day_value(lhs) + days_value(rhs))
    }
}

impl Subtract<Days, Day> for Day {
    fn subtract(lhs: Day, rhs: Days): Day {
        Day(day_value(lhs) - days_value(rhs))
    }
}

impl Add<Weeks, Day> for Day {
    fn add(lhs: Day, rhs: Weeks): Day {
        Day(day_value(lhs) + weeks_value(rhs) * 7)
    }
}

impl Subtract<Weeks, Day> for Day {
    fn subtract(lhs: Day, rhs: Weeks): Day {
        Day(day_value(lhs) - weeks_value(rhs) * 7)
    }
}

impl Add<Day.Hours, Day> for Day {
    fn add(lhs: Day, rhs: Day.Hours): Day {
        Day(day_value(lhs) + hours_value(rhs) / 24)
    }
}

fn plus<L, R, Out>(lhs: L, rhs: R): Out where L: Add<R, Out> {
    lhs + rhs
}

fn minus<L, R, Out>(lhs: L, rhs: R): Out where L: Subtract<R, Out> {
    lhs - rhs
}

fn times<L, R, Out>(lhs: L, rhs: R): Out where L: Multiply<R, Out> {
    lhs * rhs
}

fn divided_by<L, R, Out>(lhs: L, rhs: R): Out where L: Divide<R, Out> {
    lhs / rhs
}

test "Add powers plus for custom types" {
    total = Score(2) + Score(3)

    assert score_value(total) == 5
}

test "operator interfaces power custom arithmetic" {
    score = Score(20)

    assert score_value(score - Score(3)) == 17
    assert score_value(score * Score(2)) == 40
    assert score_value(score / Score(4)) == 5
}

test "primitive operator interface functions dispatch directly" {
    divisor = try Int.to_non_zero(5)

    assert Subtract.subtract(9, 4) == 5
    assert Multiply.multiply(3, 7) == 21
    assert Divide.divide(20, 5) == 4
    assert Int.divide(20, divisor) == 4

    assert Subtract.subtract(9.5, 4.0) == 5.5
    assert Multiply.multiply(1.5d, 2.0d) == 3.00d
    assert Divide.divide(10.00d, 4d) == 2.50d
}

test "Add can choose a different rhs type" {
    day = Day(10) + Days(4)

    assert day_value(day) == 14
}

test "Add impl identity includes rhs type" {
    by_days = Day(10) + Days(4)
    by_weeks = Day(10) + Weeks(2)
    by_hours = Day(10) + Day.Hours(48)
    minus_days = Day(10) - Days(4)
    minus_weeks = Day(10) - Weeks(2)
    explicit_days = Add.add(Day(10), Days(4))
    explicit_weeks = Add.add(Day(10), Weeks(2))
    explicit_hours = Add.add(Day(10), Day.Hours(48))
    explicit_minus_days = Subtract.subtract(Day(10), Days(4))
    explicit_minus_weeks = Subtract.subtract(Day(10), Weeks(2))
    type_qualified_days = Day.add(Day(10), Days(4))
    type_qualified_weeks = Day.add(Day(10), Weeks(2))

    assert day_value(by_days) == 14
    assert day_value(by_weeks) == 24
    assert day_value(by_hours) == 12
    assert day_value(minus_days) == 6
    assert day_value(minus_weeks) == -4
    assert day_value(explicit_days) == 14
    assert day_value(explicit_weeks) == 24
    assert day_value(explicit_hours) == 12
    assert day_value(explicit_minus_days) == 6
    assert day_value(explicit_minus_weeks) == -4
    assert day_value(type_qualified_days) == 14
    assert day_value(type_qualified_weeks) == 24
}

test "generic operators use their interface output type" {
    score: Score = plus(Score(8), Score(5))
    day: Day = plus(Day(20), Days(2))
    later: Day = plus(Day(20), Weeks(1))
    lower: Day = minus(Day(20), Days(2))
    scaled: Score = times(Score(4), Score(3))
    halved: Score = divided_by(Score(20), Score(2))

    assert score_value(score) == 13
    assert day_value(day) == 22
    assert day_value(later) == 27
    assert day_value(lower) == 18
    assert score_value(scaled) == 12
    assert score_value(halved) == 10
}
