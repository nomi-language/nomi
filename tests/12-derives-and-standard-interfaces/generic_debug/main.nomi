import std/io

struct Box<T> {
    value: T
}

derive Display for Box<T>

enum Tree<T> {
    Leaf
    Node {left: Tree<T>, value: T, right: Tree<T>}
}

fn main() {
    box = Box{value: 42}
    io.inspect(box)
    io.print(box)
    io.print("boxed: ${Box{value: "hi"}}")
    leaf: Tree<Int> = Tree.Leaf
    tree: Tree<Int> = Tree.Node{left: leaf, value: 5, right: leaf}
    io.inspect(tree)
    _ = dbg box
}
