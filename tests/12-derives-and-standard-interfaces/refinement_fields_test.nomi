//# A derive over fields whose types are std refinements: a refinement's values
//# are its base's, so it has the base's equality and hash, whether the
//# refinement is the prelude's (PositiveInt) or another module's whose parents
//# this file does not import (PositiveDuration over NonNegativeDuration).

import std::duration.{Duration, PositiveDuration}

struct Pace
    steps:  PositiveInt
    every:  PositiveDuration
    jitter: Option<PositiveDuration>
end

derive Equatable for Pace
derive Hashable for Pace

test "refinement fields compare and hash as their base values do"
    a = Pace{steps: 3, every: Duration"1m", jitter: None}
    assert a == Pace{steps: 3, every: Duration"1m", jitter: None}
    refute a == {..a, jitter: Some(Duration"5s")}
    assert Hashable.hash(a) == Hashable.hash(Pace{steps: 3, every: Duration"1m", jitter: None})
end
