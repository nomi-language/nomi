// `Task.stream(..., ordered: False)` under the virtual clock: results come
// as the calls finish, with the bound, the backpressure and the early stop
// of the ordered stream. An elapsed time says which tasks ran together, and
// a log on a channel says what started when.
import
    std::channels.{Channel, Receiver, Sender}
    std::duration.Duration
    std::instant.Monotonic
    std::tasks.{Failure, Outcome, Task}
    std::testing.Clock
    std::timer
end

// Answers `value` after `seconds` of the clock.
fn after<T>(seconds: Int, value: T) -> T
    timer.sleep(Duration.seconds(seconds))
    value
end

fn tell<T>(out: Sender<T>, value: T)
    _ = Sender.send(out, value)
end

fn elapsed_seconds(start: Monotonic) -> Int
    Duration.as_seconds(Monotonic.elapsed(start))
end

// Says on `log` that the call for `n` started, then answers `n` a second
// later.
fn logged(log: Sender<String>, n: Int) -> Int
    tell(log, "start ${n}")
    after(1, n)
end

// Takes `n` after ten seconds, and says so on `log`.
fn take_slowly(log: Sender<String>, n: Int) -> Int
    timer.sleep(Duration.seconds(10))
    tell(log, "took ${n}")
    n
end

// Sleeps `seconds`, then answers it; it says on `stopped` that it ended,
// however it ended.
fn job(seconds: Int, stopped: Sender<Int>) -> Int
    defer tell(stopped, seconds)
    after(seconds, seconds)
end

// Traps after `seconds` of the clock.
fn trap_after(seconds: Int) -> Int
    timer.sleep(Duration.seconds(seconds))
    Iter.find([1], &(&1 > 5))!
end

fn drained<T>(channel: Channel<T>) -> List<T>
    Sender.close(channel.sender)
    Receiver.iter(channel.receiver) |> Iter.to_list()
end

// How many calls had started at each "took" entry of `log`. Calls that
// start together may log in either order, so only the counts are read.
fn starts_at_each_take(log: List<String>) -> List<Int>
    none: (Int, List<Int>) = (0, [])

    (_, counts) = Iter.reduce(log, none, fn (starts, counts), entry ->
        if String.starts_with(entry, "start") then
            (starts + 1, counts)
        else
            (starts, List.concat(counts, [starts]))
        end
    end)

    counts
end

group "Task.stream with ordered: False"
    clock Clock.Virtual

    test "results come in the order the calls finish"
        start = Monotonic.now()

        got =
            [3, 1, 2]
            |> Task.stream(fn n -> after(n, n * 10), ordered: False, max_running: 3)
            |> Iter.to_list()

        assert got == [10, 20, 30]
        assert elapsed_seconds(start) == 3
    end

    test "a quick call never waits behind a slow one, and at most max_running run"
        start = Monotonic.now()

        // "a" runs four seconds beside "b", then "c", then "d", one at a
        // time, since two run at once.
        got =
            [(4, "a"), (1, "b"), (1, "c"), (1, "d")]
            |> Task.stream(
                fn (seconds, label) -> after(seconds, label),
                ordered:     False,
                max_running: 2,
            )
            |> Iter.to_list()

        assert got == ["b", "c", "d", "a"]
        assert elapsed_seconds(start) == 4
    end

    test "a trailing capture is the function"
        got =
            [1, 2, 3]
            |> Task.stream(&(&1 * 2), ordered: False, max_running: 2)
            |> Iter.to_set()

        assert got == Set[2, 4, 6]
    end

    test "a slow consumer holds the source back"
        log = Channel.buffered<String>(16)

        got =
            Iter.from(1)
            |> Task.stream(fn n -> logged(log.sender, n), ordered: False, max_running: 2)
            |> Iter.map(fn n -> take_slowly(log.sender, n))
            |> Iter.take(3)
            |> Iter.to_list()

        assert Iter.sort(got) == [1, 2, 3]
        // When the consumer has taken k results, k + 1 calls have started,
        // and the source was read no further.
        assert drained(log) |> starts_at_each_take() == [2, 3, 4]
    end

    test "a consumer that stops early cancels the tasks still running"
        stopped = Channel.buffered<Int>(8)
        start = Monotonic.now()

        first =
            [30, 10, 20, 40]
            |> Task.stream(fn n -> job(n, stopped.sender), ordered: False, max_running: 3)
            |> Iter.first()

        assert first == Some(10)
        assert elapsed_seconds(start) == 10
        // 20 and 30 were cancelled and ran their defers; 40 never started.
        assert drained(stopped) |> Iter.sort() == [10, 20, 30]
    end

    test "a task that traps ends the walk when it traps"
        start = Monotonic.now()

        ended =
            concurrent
                walker = Task.spawn(fn ->
                    [1, 2]
                    |> Task.stream(
                        fn n -> if n == 2 then trap_after(1) else after(5, n),
                        ordered:     False,
                        max_running: 2,
                    )
                    |> Iter.to_list()
                end)

                Task.outcome(walker)
            end

        assert Outcome.Failed(Failure.Errored(fault)) = ended
        assert String.contains(fault, "found nothing")
        assert elapsed_seconds(start) == 1
    end

    test "without ordered, results come in the source's order"
        source = [3, 1, 2]

        assert Task.stream(source, fn n -> after(n, n * 10), max_running: 3) |> Iter.to_list() == [
            30, 10, 20,
        ]

        in_order = Task.stream(source, fn n -> after(n, n * 10), ordered: True, max_running: 3)
        assert Iter.to_list(in_order) == [30, 10, 20]
    end
end
