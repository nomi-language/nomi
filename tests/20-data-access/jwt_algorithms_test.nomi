        ),
    ]
end

test "each algorithm verifies a token OpenSSL signed"
    subjects =
        tokens()
        |> Iter.map(fn (algorithm, pem, token) ->
            key = VerifyingKey.with_public(algorithm, PublicKey.from_pem(pem)!)!
            claims = jwt.verify(token, key, jwt.Validation{require_expiry: False})!
            Map.get(claims, "sub")
        end)
        |> Iter.to_list()

    assert subjects == (Iter.repeat(Some(Json.String("ada"))) |> Iter.take(6) |> Iter.to_list())
end

test "a token is refused under a key of another algorithm, even of its kind"
    key = VerifyingKey.with_public(Algorithm.Rs256, PublicKey.from_pem(rsa)!)!
    (_, _, token) = Iter.first(tokens())!

    assert jwt.verify(token, key, jwt.Validation{require_expiry: False})
        == Err(JwtError.WrongAlgorithm("the token's algorithm is RS384, and the key's is RS256"))

    assert VerifyingKey.with_public(Algorithm.Es384, PublicKey.from_pem(p521)!)
        == Err("ES384 signs with an ECDSA P-384 key, not ECDSA P-521")

    assert VerifyingKey.with_public(Algorithm.Hs256, PublicKey.from_pem(rsa)!)
        == Err("HS256 signs with a secret, not a key")
end

test "each algorithm signs a token it then verifies"
    rsa_key = PrivateKey.generate_rsa()!

    keys = [
        (Algorithm.Rs384, rsa_key),
        (Algorithm.Rs512, rsa_key),
        (Algorithm.Ps384, rsa_key),
        (Algorithm.Ps512, rsa_key),
        (Algorithm.Es384, PrivateKey.generate_ecdsa_p384()),
        (Algorithm.Es512, PrivateKey.generate_ecdsa_p521()),
    ]

    checked =
        keys
        |> Iter.map(fn (algorithm, private) ->
            key = SigningKey.with_private(algorithm, private)!
            token = jwt.sign({"sub" => Json.String("ada")}, key)

            jwt.verify(token, SigningKey.verifying_key(key), jwt.Validation{require_expiry: False})
            |> Result.is_ok()
        end)
        |> Iter.to_list()

    assert checked == (Iter.repeat(True) |> Iter.take(6) |> Iter.to_list())
end
