// std::jwt's RS384, RS512, PS384, PS512, ES384 and ES512: each verifies a
// token OpenSSL 3 signed (`openssl dgst -sign` over the header and claims,
// the ECDSA signatures turned from DER into r and s as RFC 7518 writes
// them), refuses it under a key of another algorithm, and signs a token it
// then verifies.
import
    std::json.Json
    std::jwt.{self, Algorithm, JwtError, SigningKey, VerifyingKey}
    std::signatures.{PrivateKey, PublicKey}
end

