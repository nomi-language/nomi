// std::http's middleware: each rule of CORS in its own test, a stack of
// middleware written as a pipe, compression, basic auth and method
// override.
import
    std::duration.Duration
    std::embed.Files
    std::http.{self, Body, Client, Cors, Headers, Method, Origin, Request, Response, Status}
    std::http_testing
    std::io.{Reader, Writer}
end

fn answer(Request) -> Response
    Response{status: Status.accepted, body: Body.Text("handled")}
end

fn from(method: Method, origin: String) -> Request
    {..http_testing.request(method, "/api"), headers: Headers[("Origin", origin)]}
end

fn preflight(origin: String) -> Request
    asking = from(Method.Options, origin)

    {
        ..asking,
        headers: ..
        |> Headers.set("Access-Control-Request-Method", "PUT")
        |> Headers.set("Access-Control-Request-Headers", "content-type"),
    }
end

once app_origin = Origin`https://app.example.com`

test "a preflight from an allowed origin is answered without the handler"
    app =
        answer
        |> http.cors(Cors{
            origins: [app_origin],
            methods: [Method.Get, Method.Put],
            allowed_headers: ["Content-Type"],
            max_age: Some(Duration.minutes(10)),
        })

    r = app(preflight("https://app.example.com"))
    assert r.status == Status.no_content
    assert Response.text(r) == Ok("")
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == Some("https://app.example.com")
    assert Headers.get(r.headers, "Access-Control-Allow-Methods") == Some("GET, PUT")
    assert Headers.get(r.headers, "Access-Control-Allow-Headers") == Some("Content-Type")
    assert Headers.get(r.headers, "Access-Control-Max-Age") == Some("600")

    assert Headers.get(r.headers, "Vary")
        == Some("Origin, Access-Control-Request-Method, Access-Control-Request-Headers")
end

test "a preflight from another origin gets no CORS headers and no handler"
    app = answer |> http.cors(Cors{origins: [app_origin]})
    r = app(preflight("https://evil.example"))
    assert r.status == Status.no_content
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == None
    assert Headers.get(r.headers, "Access-Control-Allow-Methods") == None
    assert String.contains(Headers.get(r.headers, "Vary")!, "Access-Control-Request-Method")
end

test "an OPTIONS request that is no preflight reaches the handler"
    app = answer |> http.cors(Cors{origins: [app_origin]})
    r = app(from(Method.Options, "https://app.example.com"))
    assert r.status == Status.accepted
end

test "an allowed origin is reflected, never a wildcard"
    app = answer |> http.cors(Cors{origins: [app_origin], exposed_headers: ["X-Total"]})
    r = app(from(Method.Get, "https://app.example.com"))
    assert r.status == Status.accepted
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == Some("https://app.example.com")
    assert Headers.get(r.headers, "Access-Control-Expose-Headers") == Some("X-Total")
    assert Headers.get(r.headers, "Access-Control-Allow-Credentials") == None
    assert Headers.get(r.headers, "Vary") == Some("Origin")
end

test "a disallowed origin gets no CORS headers, and the handler still runs"
    app = answer |> http.cors(Cors{origins: [app_origin]})
    r = app(from(Method.Post, "https://evil.example"))
    assert Response.text(r) == Ok("handled")
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == None
    assert Headers.get(r.headers, "Access-Control-Expose-Headers") == None
    assert Headers.get(r.headers, "Vary") == Some("Origin")
end

test "a request with no Origin gets only Vary"
    app = answer |> http.cors(Cors{origins: [app_origin]})
    r = app(http_testing.request(Method.Get, "/api"))
    assert r.status == Status.accepted
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == None
    assert Headers.get(r.headers, "Vary") == Some("Origin")
end

test "credentials go with a reflected origin"
    app = answer |> http.cors(Cors{origins: [app_origin], credentials: True})
    r = app(from(Method.Get, "https://app.example.com"))
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == Some("https://app.example.com")
    assert Headers.get(r.headers, "Access-Control-Allow-Credentials") == Some("true")
    p = app(preflight("https://app.example.com"))
    assert Headers.get(p.headers, "Access-Control-Allow-Credentials") == Some("true")
end

test "any origin is a wildcard, and never with credentials"
    app = answer |> http.cors(Cors{any_origin: True, credentials: True})
    r = app(from(Method.Get, "https://anyone.example"))
    assert Headers.get(r.headers, "Access-Control-Allow-Origin") == Some("*")
    assert Headers.get(r.headers, "Access-Control-Allow-Credentials") == None
    assert Headers.get(r.headers, "Vary") == Some("Origin")
    p = app(preflight("https://anyone.example"))
    assert Headers.get(p.headers, "Access-Control-Allow-Origin") == Some("*")
    assert Headers.get(p.headers, "Access-Control-Allow-Credentials") == None
end

test "an origin matches exactly"
    app = answer |> http.cors(Cors{origins: [app_origin]})

    near = [
        "https://app.example.com:8443",
        "http://app.example.com",
        "https://evil.app.example.com",
        "https://app.example.com.evil.example",
    ]

    assert Iter.all_match(near, fn o ->
        Headers.get(app(from(Method.Get, o)).headers, "Access-Control-Allow-Origin") == None
    end)
end

test "the handler's own Vary is kept"
    varying = fn _: Request -> Response{headers: Headers[("Vary", "Accept-Encoding")]}
    app = varying |> http.cors(Cors{origins: [app_origin]})
    r = app(from(Method.Get, "https://app.example.com"))
    assert Headers.values(r.headers, "Vary") == ["Accept-Encoding", "Origin"]
end

test "a stack reads as a pipe, the last stage outermost"
    app =
        answer
        |> http.cors(Cors{origins: [app_origin]})
        |> http.security_headers()
        |> http.request_id()
        |> http.limit_body(1_000)

    r = app(from(Method.Get, "https://app.example.com"))
    assert r.status == Status.accepted
    assert Headers.has(r.headers, "Access-Control-Allow-Origin")
    assert Headers.get(r.headers, "X-Frame-Options") == Some("DENY")
    assert Headers.has(r.headers, "X-Request-Id")
end

fn gzip_request(method: Method, target: String) -> Request
    {..http_testing.request(method, target), headers: Headers[("Accept-Encoding", "gzip")]}
end

once page = String.repeat("<li>an item</li>", 200)

test "compress gzips a streamed body as it is read"
    app =
        (fn _: Request -> Response{
            headers: Headers[("Content-Type", "text/html"), ("Content-Length", "3200")],
            body: Body.Stream(Reader.from_text(page)),
            content_length: Some(3200),
        })
        |> http.compress()

    r = app(gzip_request(Method.Get, "/"))
    assert Headers.get(r.headers, "Content-Encoding") == Some("gzip")
    assert Headers.get(r.headers, "Content-Length") == None
    assert r.content_length == None
    assert http_testing.decompressed(r) == Ok(String.to_bytes(page))
end

test "compress gzips a produced body, and each flush sends what was written"
    app =
        (fn _: Request -> Response{
            headers: Headers[("Content-Type", "text/event-stream")],
            body: Body.Produce(fn w ->
                _ = Writer.write_text(w, "data: one\n\n")
                _ = Writer.flush(w)
                Writer.write_text(w, "data: two\n\n")
            end),
        })
        |> http.compress()

    r = app(gzip_request(Method.Get, "/events"))
    assert Headers.get(r.headers, "Content-Encoding") == Some("gzip")
    assert Iter.count(http_testing.chunks(r)) == 2
    assert http_testing.decompressed(r) == Ok(String.to_bytes("data: one\n\ndata: two\n\n"))
end

test "compress makes a strong ETag weak, and a weak one stays"
    tagged = fn tag: String ->
        fn _: Request -> Response{headers: Headers[("ETag", tag)], body: Body.Text(page)}
    end

    strong = tagged("\"v1\"") |> http.compress()
    assert Headers.get(strong(gzip_request(Method.Get, "/")).headers, "ETag") == Some("W/\"v1\"")
    weak = tagged("W/\"v1\"") |> http.compress()
    assert Headers.get(weak(gzip_request(Method.Get, "/")).headers, "ETag") == Some("W/\"v1\"")

    assert Headers.get(strong(http_testing.request(Method.Get, "/")).headers, "ETag")
        == Some("\"v1\"")
end

test "compress leaves a body with no content, a HEAD and a 304 alone, with Vary"
    statuses = [Status.no_content, Status.not_modified]

    assert Iter.all_match(statuses, fn status ->
        app = (fn _: Request -> Response{status:}) |> http.compress()
        r = app(gzip_request(Method.Get, "/"))

        Headers.get(r.headers, "Content-Encoding") == None
            and Headers.get(r.headers, "Vary") == Some("Accept-Encoding")
    end)

    app = (fn _: Request -> Response{body: Body.Text(page)}) |> http.compress()
    head = app(gzip_request(Method.Head, "/"))
    assert Headers.get(head.headers, "Content-Encoding") == None
    assert Headers.get(head.headers, "Vary") == Some("Accept-Encoding")
end

test "compress leaves compressed types alone and compresses SVG"
    typed = fn content_type: String ->
        app =
            (fn _: Request -> Response{
                headers: Headers[("Content-Type", content_type)],
                body: Body.Text(page),
            })
            |> http.compress()

        Headers.get(app(gzip_request(Method.Get, "/")).headers, "Content-Encoding")
    end

    assert typed("image/png") == None
    assert typed("video/mp4") == None
    assert typed("application/zip") == None
    assert typed("font/woff2") == None
    assert typed("image/svg+xml") == Some("gzip")
    assert typed("application/json; charset=utf-8") == Some("gzip")
end

test "compress sniffs a body of bytes with no Content-Type first"
    app = (fn _: Request -> Response{body: Body.Bytes(String.to_bytes(page))}) |> http.compress()
    r = app(gzip_request(Method.Get, "/"))
    assert Headers.get(r.headers, "Content-Type") == Some("text/plain; charset=utf-8")
    assert Headers.get(r.headers, "Content-Encoding") == Some("gzip")
end

test "compress keeps a Vary the handler set and adds to it"
    varying = fn vary: String ->
        app =
            (fn _: Request -> Response{headers: Headers[("Vary", vary)], body: Body.Text(page)})
            |> http.compress()

        Headers.values(app(gzip_request(Method.Get, "/")).headers, "Vary")
    end

    assert varying("Origin") == ["Origin", "Accept-Encoding"]
    assert varying("origin, accept-encoding") == ["origin, accept-encoding"]
    assert varying("*") == ["*"]
end

test "compress passes a precompressed file through"
    files = Files.from_bytes([
        ("app.js", String.to_bytes(page)),
        ("app.js.gz", String.to_bytes("zipped")),
    ])

    app = http.file_server_embedded(files) |> http.compress()
    r = app(gzip_request(Method.Get, "/app.js"))
    assert Headers.get(r.headers, "Content-Encoding") == Some("gzip")
    assert Headers.values(r.headers, "Vary") == ["Accept-Encoding"]
    assert Response.text(r) == Ok("zipped")
end

test "a compressed response reaches a client whole"
    app =
        (fn r: Request ->
            if r.url.path == "/produced" then
                Response{
                    headers: Headers[("Content-Type", "text/html")],
                    body: Body.Produce(fn w ->
                        _ = Writer.write_text(w, page)
                        _ = Writer.flush(w)
                        Writer.write_text(w, page)
                    end),
                }
            else
                Response{body: Body.Text(page)}
            end
        end)
        |> http.compress()

    got = http_testing.with_server(app, fn server ->
        fetched = fn path: String ->
            response = Client.get(server.client, {..server.url, path:})!
            (response.uncompressed, Response.text(response))
        end

        (fetched("/"), fetched("/produced"))
    end)

    assert got == ((True, Ok(page)), (True, Ok(page + page)))
end

test "basic_auth quotes its realm and refuses another scheme"
    app = answer |> http.basic_auth("the \"back\" office", fn _, _ -> True)

    bearer = {
        ..http_testing.request(Method.Get, "/"),
        headers: Headers[("Authorization", "Bearer x")],
    }

    r = app(bearer)
    assert r.status == Status.unauthorized

    assert Headers.get(r.headers, "WWW-Authenticate")
        == Some("Basic realm=\"the \\\"back\\\" office\", charset=\"UTF-8\"")

    signed = Request.with_basic_auth(http_testing.request(Method.Get, "/"), "a", "b")
    assert app(signed).status == Status.accepted
end

test "method_override leaves a streamed body for the handler to read"
    echo = fn r: Request -> Response{
        body: Body.Text("${Method.text(r.method)} ${Request.form_value(r, "title")}"),
    }

    app = echo |> http.method_override()

    streamed = {
        ..http_testing.request(Method.Post, "/posts/1"),
        headers: Headers[("Content-Type", "application/x-www-form-urlencoded")],
        body: Body.Stream(Reader.from_text("_method=put&title=Hi")),
    }

    assert Response.text(app(streamed)) == Ok("PUT Some(Hi)")
end

test "method_override reads only a POST, and only within the body limit"
    app =
        (fn r: Request -> Response{body: Body.Text(Method.text(r.method))})
        |> http.method_override()

    assert Response.text(app(http_testing.request(Method.Get, "/?_method=DELETE"))) == Ok("GET")
    put = http_testing.form_request(Method.Put, "/", [("_method", "DELETE")])
    assert Response.text(app(put)) == Ok("PUT")

    header = {
        ..http_testing.request(Method.Post, "/"),
        headers: Headers[("X-HTTP-Method-Override", "DELETE")],
    }

    assert Response.text(app(header)) == Ok("POST")
    limited = app |> http.limit_body(10)
    big = http_testing.form_request(Method.Post, "/", [("_method", "DELETE"), ("pad", page)])
    assert limited(big).status == Status.request_entity_too_large
end
