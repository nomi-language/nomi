test "each RSA-OAEP hash decrypts what OpenSSL encrypted, and only with its label"
    key = PrivateKey.from_pem(rsa_private)!
    secret = String.to_bytes("a secret for ada")
    none = Bytes.from_list([])

    // `openssl pkeyutl -encrypt` with `rsa_padding_mode:oaep`, the hash as
    // both `rsa_oaep_md` and `rsa_mgf1_md`, and the label "nomi" for SHA-256.
    sha256 = hex.decode(
        ""
    )!

    sha384 = hex.decode(
        ""
    )!

    sha512 = hex.decode(
        ""
    )!

    assert signatures.decrypt(key, Encryption.RsaOaepSha256, sha256, String.to_bytes("nomi"))
        == Ok(secret)

    assert signatures.decrypt(key, Encryption.RsaOaepSha384, sha384, none) == Ok(secret)
    assert signatures.decrypt(key, Encryption.RsaOaepSha512, sha512, none) == Ok(secret)

    refused = Err("the ciphertext did not decrypt under this key")
    assert signatures.decrypt(key, Encryption.RsaOaepSha256, sha256, none) == refused
    assert signatures.decrypt(key, Encryption.RsaOaepSha256, sha384, none) == refused

    assert signatures.decrypt(key, Encryption.RsaOaepSha512, Bytes.slice(sha512, 1, 256), none)
        == refused

    assert PrivateKey.public_key(key) == PublicKey.from_pem(rsa)!
end

test "each RSA-OAEP hash decrypts what it encrypted, and other keys refuse"
    key = PrivateKey.from_pem(rsa_private)!
    public = PrivateKey.public_key(key)
    secret = String.to_bytes("a secret for ada")
    label = String.to_bytes("label")

    round_trips =
        [Encryption.RsaOaepSha256, Encryption.RsaOaepSha384, Encryption.RsaOaepSha512]
        |> Iter.map(fn encryption ->
            sealed = signatures.encrypt(public, encryption, secret, label)!
            signatures.decrypt(key, encryption, sealed, label)
        end)
        |> Iter.to_list()

    assert round_trips == [Ok(secret), Ok(secret), Ok(secret)]

    ed = PrivateKey.generate_ed25519()

    assert signatures.encrypt(PrivateKey.public_key(ed), Encryption.RsaOaepSha256, secret, label)
        == Err("an Ed25519 key does not encrypt")

    assert signatures.decrypt(ed, Encryption.RsaOaepSha256, secret, label)
        == Err("an Ed25519 key does not decrypt")
end
