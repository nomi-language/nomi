// std::signatures' ECDSA P-384 and P-521 and RSA SHA-384, SHA-512 and PSS
// schemes, and RSA-OAEP. Each scheme checks a signature OpenSSL 3 made
// (`openssl dgst -sha384 -sign`, PSS with `rsa_padding_mode:pss` and
// `rsa_pss_saltlen:digest`), the ECDSA ones in DER as OpenSSL wrote them
// and as r and s, and signs what it then checks. Each OAEP hash decrypts
// what OpenSSL encrypted and what it encrypted itself.
import
    std::hex
    std::signatures.{self, Encryption, KeyKind, PrivateKey, PublicKey, Scheme}
end

once message = String.to_bytes("Nomi signs this.")

once p384 = """
    -----BEGIN PUBLIC KEY-----
    MHYwEAYHKoZIzj0CAQYFK4EEACIDYgAEBcU7mR4p8hU2apoq6/p7jEIMXkx7iOrW
    fI9kTGRNIW6HEudxcwn4w6GB3Q2CEUkno3kOpqdnU++V3ZtH2PqJXdnBIKCp7L2r
    iOkzcE4KVL3l/L7iCQopFSgzxvzeRw4s
    -----END PUBLIC KEY-----
    """

once p521 = """
    -----BEGIN PUBLIC KEY-----
    MIGbMBAGByqGSM49AgEGBSuBBAAjA4GGAAQAySu9493PJaejkzOu3IGGz8A8UWCL
    bobu0fAXSVRVYcgmZQQfw0FdwubKKjfDwAzHA+FZu4flfkSbF4L82/ck4h4BdgJ/
    JRWMM3y3+tRG1Bo9qNdL3u0xdVA+DQnteXRMpzL333tNP4Ry4ijwBy+POwvdQbgO
    lKmaJ8nP3gLBiQNNYSM=
    -----END PUBLIC KEY-----
    """

once rsa = """
    -----BEGIN PUBLIC KEY-----
    MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAynnKKMkBB882RlXF++Ob
    mDVg4P71n/3OJGmkEdCe2P25rReJQjO+xl29oAPzmAXb0Jb2OwvAW3EXmrG1L1gx
    XNRR/hvgDAu2QsF5UaQPOrjwohm1JgBOs4z9I/ofNnl6XTL3V5SOEmDYYlhGso5n
    HdY+gk+4Twppi/fdCciOgEBm+P1ImjiaNtf3YlheHRthLfsF/gmKkrzziL77wDUc
    70W3D3tGm2HU65vmNjoXon+0nR/QEp+WTyWv4/vQnhF+jt0OCAW9MWm3092suYM0
    /bxPsxMP+z3Ok+wP0CILd26m/G8MRdG7ikvIE12qLXpNd/yq/KRhp0CwEwcB+hPp
    vQIDAQAB
    -----END PUBLIC KEY-----
    """

/// Each fixed signature: the key's PEM, the scheme and the signature.
fn fixtures() -> List<(String, Scheme, String)>
    [
        (
            p384,
            .EcdsaSha384Der,
            "3065023100853b3b3d9ecb4906c17a8d87adaa41e560696a88fe465621fb87abd2b29b614a96cf665b492dc2b602d6e4fcbb4a2b1d02306b9bedc70e912c7bcd1475743d67539c2b770b1f1a71bec057e4c8add5aba762d9ab56a11e3ea7152b0f3fdac45d6347",
        ),
        (
            p384,
            .EcdsaSha384,
            "853b3b3d9ecb4906c17a8d87adaa41e560696a88fe465621fb87abd2b29b614a96cf665b492dc2b602d6e4fcbb4a2b1d6b9bedc70e912c7bcd1475743d67539c2b770b1f1a71bec057e4c8add5aba762d9ab56a11e3ea7152b0f3fdac45d6347",
        ),
        (
            p521,
            .EcdsaSha512Der,
            "308188024200820d14877ff92432e0001e5da75840ec175e24d390639d74871c2083109d1930082fb5f54b0d38a4435d733c9434a73ffeb59a023c9db3f37391e0ad032e5a800a024201e85404b98143f461d777e4d4324d4da6d927543ac3d36bc892b7b39993afa17741e93e8e8f86c57713d95ce30b3553d50ee1465d43b4b0e5e29d0a1f07835cec94",
        ),
        (
            p521,
            .EcdsaSha512,
            "00820d14877ff92432e0001e5da75840ec175e24d390639d74871c2083109d1930082fb5f54b0d38a4435d733c9434a73ffeb59a023c9db3f37391e0ad032e5a800a01e85404b98143f461d777e4d4324d4da6d927543ac3d36bc892b7b39993afa17741e93e8e8f86c57713d95ce30b3553d50ee1465d43b4b0e5e29d0a1f07835cec94",
        ),
        (
            rsa,
            .RsaPkcs1Sha384,
            "",
        ),
        (
            rsa,
            .RsaPkcs1Sha512,
            "",
        ),
        (
            rsa,
            .RsaPssSha256,
            "",
        ),
        (
            rsa,
            .RsaPssSha384,
            "",
        ),
        (
            rsa,
            .RsaPssSha512,
            "",
        ),
    ]
end

test "each scheme checks a signature OpenSSL made, and only for its message"
    checked =
        fixtures()
        |> Iter.map(fn (pem, scheme, signature) ->
            key = PublicKey.from_pem(pem)!
            bytes = hex.decode(signature)!

            (
                signatures.is_valid_with(key, scheme, message, bytes),
                signatures.is_valid_with(key, scheme, String.to_bytes("Nomi signs that."), bytes),
            )
        end)
        |> Iter.to_list()

    assert checked == (Iter.repeat((True, False)) |> Iter.take(9) |> Iter.to_list())
end

test "an ECDSA key's usual scheme is its curve's, and a signature of another hash fails"
    key = PublicKey.from_pem(p384)!
    assert PublicKey.kind(key) == KeyKind.EcdsaP384
    assert PublicKey.kind(PublicKey.from_pem(p521)!) == KeyKind.EcdsaP521

    fixed = hex.decode(
        "853b3b3d9ecb4906c17a8d87adaa41e560696a88fe465621fb87abd2b29b614a96cf665b492dc2b602d6e4fcbb4a2b1d6b9bedc70e912c7bcd1475743d67539c2b770b1f1a71bec057e4c8add5aba762d9ab56a11e3ea7152b0f3fdac45d6347"
    )!

    assert signatures.is_valid(key, message, fixed)
    refute signatures.is_valid_with(key, Scheme.EcdsaSha512, message, fixed)
end

test "each new scheme signs what it then checks"
    p384_key = PrivateKey.generate_ecdsa_p384()
    p521_key = PrivateKey.generate_ecdsa_p521()
    rsa_key = PrivateKey.generate_rsa()!

    pairs = [
        (p384_key, Scheme.EcdsaSha384),
        (p384_key, Scheme.EcdsaSha384Der),
        (p521_key, Scheme.EcdsaSha512),
        (p521_key, Scheme.EcdsaSha512Der),
        (rsa_key,  Scheme.RsaPkcs1Sha384),
        (rsa_key,  Scheme.RsaPkcs1Sha512),
        (rsa_key,  Scheme.RsaPssSha384),
        (rsa_key,  Scheme.RsaPssSha512),
    ]

    checked =
        pairs
        |> Iter.map(fn (key, scheme) ->
            signature = signatures.sign_with(key, scheme, message)!
            signatures.is_valid_with(PrivateKey.public_key(key), scheme, message, signature)
        end)
        |> Iter.to_list()

    assert checked == (Iter.repeat(True) |> Iter.take(8) |> Iter.to_list())
    assert Bytes.length(signatures.sign(p521_key, message)) == 132

    assert signatures.sign_with(p384_key, Scheme.EcdsaSha512, message)
        == Err("an ECDSA P-384 key does not sign with EcdsaSha512")
end

