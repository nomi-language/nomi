import {
    std::io.{Reader, Writer}
    std::xml.{self, Attribute, Element, Error, Name, Namespace, Node, Token, WriteOptions}
}

test "a document reads into a tree and writes back as the same tree" {
    text = """
        <?xml version="1.0" encoding="UTF-8"?>
        <!-- before the root -->
        <feed xmlns="http://www.w3.org/2005/Atom" xmlns:m="urn:media" lang="en">
          <title type="text">News &amp; notes</title>
          <entry m:id="7"><m:thumb src="a.jpg"/><![CDATA[<b>raw</b>]]></entry>
          <?render fast?>
        </feed>
        """

    doc = xml.decode(text)!
    atom = "http://www.w3.org/2005/Atom"

    assert doc.name == Name{local: "feed", space: atom}

    assert doc.namespaces == [
        Namespace{prefix: "", uri: atom},
        Namespace{prefix: "m", uri: "urn:media"},
    ]

    assert Element.attribute(doc, "lang") == Some("en")
    assert Element.child_text(doc, "title") == Some("News & notes")

    entry = Element.child(doc, "entry")!
    assert Element.attribute(entry, "id", space: "urn:media") == Some("7")
    assert Element.text(entry) == "<b>raw</b>"

    thumb = Element.child(entry, "thumb", space: Some("urn:media"))!
    assert thumb.name == Name{local: "thumb", space: "urn:media", prefix: "m"}
    assert Element.child(entry, "thumb", space: Some(atom)) == None

    assert Iter.any(doc.children, fn node -> {
        node == Node.Instruction{target: "render", data: "fast"}
    })

    assert xml.decode(xml.encode(doc)!) == Ok(doc)
}

test "namespaces a hand-built tree names are declared where they are not in scope" {
    tree = Element{
        name: Name{local: "a", space: "urn:a"},
        children: [
            Node.Element(Element{name: Name{local: "b", space: "urn:a"}}),
            Node.Element(Element{name: Name{local: "c", space: "urn:c", prefix: "c"}}),
            Node.Element(Element{name: Name{local: "d"}}),
            Node.Element(
                Element{
                    name: Name{local: "e", space: "urn:a"},
                    attributes: [
                        Attribute{name: Name{local: "x", space: "urn:x"}, value: "1"},
                    ],
                }
            ),
        ],
    }

    assert xml.encode(tree) == Ok(
        "<a xmlns=\"urn:a\"><b/><c:c xmlns:c=\"urn:c\"/><d xmlns=\"\"/><e xmlns:ns1=\"urn:x\" ns1:x=\"1\"/></a>"
    )

    back = xml.decode(xml.encode(tree)!)!

    assert Element.elements(back) |> Iter.map(fn e -> e.name.space) |> Iter.to_list() == [
        "urn:a",
        "urn:c",
        "",
        "urn:a",
    ]
}

test "text and attributes are escaped so they read back as written" {
    awkward = "a < b && c > d \"q\" 'a' ]]> \r\n\ttab"

    tree = Element{
        name: Name{local: "t"},
        attributes: [
            Attribute{name: Name{local: "v"}, value: awkward},
        ],
        children: [Node.Text(awkward)],
    }

    back = xml.decode(xml.encode(tree)!)!
    assert Element.attribute(back, "v") == Some(awkward)
    assert Element.text(back) == awkward
}

test "entities and character references are read, and others refused" {
    assert Element.text(xml.decode("<a>&lt;&gt;&amp;&apos;&quot;&#233;&#x1F642;</a>")!)
        == "<>&'\"é🙂"

    assert xml.decode("<a>&nbsp;</a>") is Err(.Syntax{message: "invalid character entity &nbsp;"})
}

test "an XXE document is refused before it expands anything" {
    xxe = """
        <?xml version="1.0"?>
        <!DOCTYPE foo [<!ENTITY xxe SYSTEM "file:///etc/passwd">]>
        <foo>&xxe;</foo>
        """

    assert xml.decode(xxe) == Err(Error.Syntax{
            message: "a DOCTYPE is refused: std/xml reads no DTD; allow_doctype skips it",
            line: 2,
            column: 1,
        })

    // With the DOCTYPE skipped, the entity it declares is still unknown.
    assert xml.decode(xxe, allow_doctype: True) is Err(.Syntax{
        message: "invalid character entity &xxe;",
    })
}

test "a billion laughs document is refused, and inert even with its DOCTYPE skipped" {
    laughs = """
        <!DOCTYPE lolz [
          <!ENTITY lol "lol">
          <!ENTITY lol2 "&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;">
        ]>
        <lolz>&lol2;</lolz>
        """

    assert xml.decode(laughs) is Err(.Syntax{})

    assert xml.decode(laughs, allow_doctype: True) is Err(.Syntax{
        message: "invalid character entity &lol2;",
    })

    assert xml.decode("<!DOCTYPE html><html/>", allow_doctype: True) == Ok(Element.new("html"))
}

test "malformed documents name their line and column" {
    assert xml.decode("<a>\n  <b></c>\n</a>") == Err(Error.Syntax{
            message: "<b> is closed by </c>",
            line: 2,
            column: 6,
        })

    assert xml.decode("<a><b>") == Err(Error.Syntax{
            message: "unexpected end of input: <b> is not closed",
            line: 1,
            column: 7,
        })

    assert xml.decode("") is Err(.Syntax{message: "the document has no root element"})
    assert xml.decode("<a/><b/>") is Err(.Syntax{message: "a second root element <b>"})
    assert xml.decode("<a/>text") is Err(.Syntax{message: "text outside the root element"})
    assert xml.decode("<p:a/>") is Err(.Syntax{message: "the prefix p is not declared"})
    assert xml.decode("<a x='1' x='2'/>") is Err(.Syntax{message: "the attribute x appears twice"})
    assert xml.decode("<a/><?xml version='1.0'?>") is Err(.Syntax{})
    assert xml.decode("<?xml version='1.0' encoding='ISO-8859-1'?><a/>") is Err(.Syntax{})
    assert xml.decode_bytes(Bytes.from_list([60, 97, 62, 255, 60, 47, 97, 62])) is Err(.Syntax{})
}

test "a byte order mark before the document is dropped" {
    assert xml.decode("\u{feff}<a/>") == Ok(Element.new("a"))
}

test "a stream is read a token at a time" {
    r = Reader.from_text_chunks(["<list><it", "em n='1'/>", "<item n='2'/></list>"])

    numbers =
        xml.tokens(r)
        |> Iter.flat_map(fn token -> {
            case token {
                Ok(.Start{name, attributes}) when name.local == "item" ->
                    attributes |> Iter.map(fn a -> a.value) |> Iter.to_list()

                _ ->
                    []
            }
        })
        |> Iter.to_list()

    assert numbers == ["1", "2"]
}

test "a stream's failure is its last token" {
    tokens = Iter.to_list(xml.tokens(Reader.from_text("<a>x</b>")))

    assert tokens == [
        Ok(Token.Start{name: Name{local: "a"}, attributes: [], namespaces: []}),
        Ok(Token.Text("x")),
        Err(Error.Syntax{message: "<a> is closed by </b>", line: 1, column: 5}),
    ]

    closed = Reader.from_text("<a/>")
    _ = Reader.close(closed)
    assert Iter.to_list(xml.tokens(closed)) is [Err(.Io{})]
}

test "indentation lays out element-only content and leaves mixed content alone" {
    doc = xml.decode("<a> <b>1</b>\n<c><d/></c><p>mixed <i>text</i></p></a>")!

    assert xml.encode(doc, WriteOptions{indent: "  "}) == Ok(
        """
        <a>
          <b>1</b>
          <c>
            <d/>
          </c>
          <p>mixed <i>text</i></p>
        </a>
        """
    )
}

test "a tree that cannot be written is refused" {
    assert xml.encode(Element.new("1a")) is Err(.Invalid{})
    assert xml.encode(Element.new("a", [Node.Comment("a -- b")])) is Err(.Invalid{})

    assert xml.encode(
        Element.new("a", [Node.Instruction{target: "xml", data: ""}])
    ) is Err(.Invalid{})

    assert xml.encode(Element{name: Name{local: "a", prefix: "p"}}) is Err(.Invalid{})
}

test "writing goes to a writer with a declaration" {
    (written, data) = Writer.collect(fn w -> {
        xml.write(w, Element.new("a", [Node.Text("é")]), WriteOptions{declaration: True})
    })

    assert written == Ok(Unit)
    assert Bytes.to_string(data) == Ok("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<a>é</a>")
}
