// std::passwords: hashing, verifying, rehashing at sign-in, and a hasher a
// module adds beside the default one.
import std::passwords.{self, PasswordHasher, Pbkdf2, Phc}

// Fewer iterations than the default, so the tests run quickly.
fn fast() -> Pbkdf2 {
    Pbkdf2{iterations: 1_000}
}

test "a hash verifies its password and no other" {
    stored = passwords.hash("correct horse battery staple", hasher: fast())!
    assert passwords.verify("correct horse battery staple", stored) == Ok(True)
    assert passwords.verify("correct horse battery stapler", stored) == Ok(False)
    assert passwords.verify("", stored) == Ok(False)

    phc = Phc.parse(stored)!
    assert phc.id == "pbkdf2-sha256"
    assert Bytes.length(phc.salt) == 16
    assert Bytes.length(phc.hash) == 32
}

test "the default hasher is PBKDF2-SHA256 at 600,000 iterations" {
    stored = passwords.hash("hunter2")!
    assert String.starts_with(stored, "$pbkdf2-sha256$i=600000$")
    assert passwords.verify("hunter2", stored) == Ok(True)
    refute passwords.needs_rehash(stored)
}

test "a hash made with old parameters verifies and asks to be rehashed" {
    old = passwords.hash("hunter2", hasher: fast())!
    assert passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 2_000})

    // At sign-in, the one time the app holds the password.
    if passwords.verify("hunter2", old) == Ok(True)
        and passwords.needs_rehash(old, hasher: Pbkdf2{iterations: 2_000}) {
        new = passwords.hash("hunter2", hasher: Pbkdf2{iterations: 2_000})!
        assert String.starts_with(new, "$pbkdf2-sha256$i=2000$")
        refute passwords.needs_rehash(new, hasher: Pbkdf2{iterations: 2_000})
        assert passwords.verify("hunter2", new) == Ok(True)
    }
}

test "a malformed stored hash is an Err, not a mismatch" {
    assert passwords.verify("x", "") |> Result.is_err()
    assert passwords.verify("x", "$pbkdf2-sha256$i=1000$c2FsdA") |> Result.is_err()

    assert passwords.verify("x", "$pbkdf2-sha256$i=lots$c2FsdA$aGFzaA")
        == Err("a PHC `i` parameter is a decimal number, got `lots`")

    assert passwords.verify("x", "$pbkdf2-sha256$m=1$c2FsdA$aGFzaA")
        == Err("the PHC string has no `i` parameter")
}

// A hasher another module could add: it stores the password reversed,
// which no app should do, under its own algorithm id.
struct Reversed {}

impl PasswordHasher for Reversed {
    fn recognizes(Reversed, id: String) -> Bool {
        id == "reversed"
    }

    fn hash(Reversed, password: String) -> Result<String, String> {
        Ok("$reversed$${String.reverse(password)}")
    }

    fn verify(Reversed, password: String, stored: String) -> Result<Bool, String> {
        case String.strip_prefix(stored, "$reversed$") {
            Some(rest) -> Ok(rest == String.reverse(password))
            None -> Err("not a reversed hash")
        }
    }

    fn needs_rehash(Reversed, String) -> Bool {
        False
    }
}

test "verify picks the hasher that reads the stored algorithm" {
    hashers: List<PasswordHasher> = [fast(), Reversed{}]
    legacy = passwords.hash("hunter2", hasher: Reversed{})!
    current = passwords.hash("hunter2", hasher: fast())!
    assert passwords.verify("hunter2", legacy, hashers) == Ok(True)
    assert passwords.verify("hunter2", current, hashers) == Ok(True)
    assert passwords.verify("hunter2", legacy) == Err("no hasher given reads `reversed` hashes")

    // An app moving off the old algorithm rehashes at sign-in.
    assert passwords.needs_rehash(legacy, hasher: fast())
}
