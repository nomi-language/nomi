import std/compiler

test "a reversed integer range traps at the program's call" {
    result =
        """
            import std/random.Generator

            fn main() {
              _ = Generator.int(6, 1)
            }
            """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 4: Generator.int: from 6 is greater than to 1")
}

test "an empty float range traps at the program's call" {
    result =
        """
            import std/random.Generator

            fn main() {
              _ = Generator.float(2.5, 1.5)
            }
            """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 4: Generator.float: from 2.5 is not less than to 1.5")
}

test "equal float bounds trap" {
    result =
        """
            import std/random.Generator

            fn main() {
              _ = Generator.float(1.0, 1.0)
            }
            """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 4: Generator.float: from 1.0 is not less than to 1.0")
}

test "a range trap inside a lambda names the lambda's line" {
    result =
        """
            import std/random.{Generator, Seed}

            fn main() {
              gen = Generator.int(1, 3)
                |> Generator.flat_map(fn n ->
                  Generator.int(n, 0)
                )
              _ = Generator.step(gen, Seed.from_int(1))
            }
            """
        |> compiler.run()

    assert Err(message) = result
    assert String.contains(message, "line 6: Generator.int: from ")
    assert String.contains(message, " is greater than to 0")
}

test "equal integer bounds make a constant draw" {
    result =
        """
            import std/io
            import std/random.{Generator, Seed}

            fn main() {
              #(n, _) = Generator.step(Generator.int(4, 4), Seed.from_int(9))
              io.print(n)
            }
            """
        |> compiler.run()

    assert Ok(output) = result
    assert String.contains(output, "4")
}

test "an infinite float bound traps" {
    result =
        """
            import std/random.Generator

            fn main() {
              _ = Generator.float(Float.negative_infinity(), 1.0)
            }
            """
        |> compiler.run()

    assert Err(message) = result

    assert String.contains(
        message,
        "line 4: Generator.float: bounds must be finite, got -Inf and 1.0",
    )
}
