import
    std::compiler
    std::random.FiniteRange
end

test "equal bounds of an inclusive range make a constant draw"
    result =
        """
        import std::io
        import std::random.{Generator, Seed}

        fn main()
          (n, _) = Generator.step(Generator.int(4..=4), Seed.from_int(9))
          (x, _) = Generator.step(Generator.float(2.5..=2.5), Seed.from_int(9))
          io.print(n)
          io.print(x)
        end
        """
        |> compiler.run()

    assert Ok(output) = result
    assert output == "4\n2.5\n"
end

test "an infinite float bound is no FiniteRange, so Generator.float never sees one"
    assert FiniteRange.try_from(Float.negative_infinity()..1.0) == None
    assert FiniteRange.try_from(0.0..Float.positive_infinity()) == None
    assert FiniteRange.try_from(Float.nan()..1.0) == None
    assert FiniteRange.try_from(-1.0..1.0) == Some(-1.0..1.0)
end
