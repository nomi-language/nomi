test "codepoints convert to and from integers and strings" {
    assert Some(a) = Int.to_codepoint(65)

    assert Codepoint.to_int(a) == 65
    assert Codepoint.to_string(a) == "A"
}

test "codepoint construction rejects surrogate values" {
    assert Int.to_codepoint(55_296) == None
}

test "codepoint ranges iterate over scalar values" {
    assert Some(start) = Int.to_codepoint(97)
    assert Some(end) = Int.to_codepoint(100)

    exclusive_values =
        start..end
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()

    inclusive_values =
        start..=end
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()

    stepped_values =
        Range.step_by(start..=end, 2)
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()

    assert exclusive_values == [97, 98, 99]
    assert inclusive_values == [97, 98, 99, 100]
    assert stepped_values == [97, 99]
}

test "codepoint ranges skip surrogate values" {
    assert Some(before_surrogates) = Int.to_codepoint(55_295)
    assert Some(after_surrogates) = Int.to_codepoint(57_344)

    inclusive_values =
        before_surrogates..=after_surrogates
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()

    stepped_values =
        Range.step_by(before_surrogates..=after_surrogates, 1)
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()

    assert inclusive_values == [55_295, 57_344]
    assert stepped_values == [55_295, 57_344]
}

test "is_letter is Unicode general category L" {
    // ASCII, Latin-1, Cyrillic, CJK and title-case letters.
    assert String.to_codepoints("Azéжд中ǅ") |> Iter.all(Codepoint.is_letter)
    // A digit, a space and an emoji.
    refute String.to_codepoints("7 🙂") |> Iter.any(Codepoint.is_letter)

    assert Some(combining_acute) = Int.to_codepoint(0x0301)

    refute Codepoint.is_letter(combining_acute)
}

test "is_digit and to_digit read ASCII digits only" {
    assert String.to_codepoints("0459") |> Iter.all(Codepoint.is_digit)

    assert String.to_codepoints("0459") |> Iter.map(Codepoint.to_digit) |> Iter.to_list() == [
        Some(0),
        Some(4),
        Some(5),
        Some(9),
    ]

    // Full-width ０ and １, Arabic-Indic ٣, a letter and a space.
    refute String.to_codepoints("０１٣a ") |> Iter.any(Codepoint.is_digit)

    assert String.to_codepoints("０１٣a ")
        |> Iter.map(Codepoint.to_digit)
        |> Iter.all(Maybe.is_none)
}

test "is_whitespace is Unicode White_Space" {
    // Space, tab, newline, carriage return, no-break space U+00A0 and the
    // ideographic space U+3000.
    assert String.to_codepoints(" \t\n\r\u{a0}\u{3000}") |> Iter.all(Codepoint.is_whitespace)
    // A letter, a digit, an emoji and the zero-width space U+200B.
    refute String.to_codepoints("a7🙂\u{200b}") |> Iter.any(Codepoint.is_whitespace)
}

test "is_upper and is_lower are general categories Lu and Ll" {
    assert String.to_codepoints("AÉЖ") |> Iter.all(Codepoint.is_upper)
    refute String.to_codepoints("AÉЖ") |> Iter.any(Codepoint.is_lower)
    assert String.to_codepoints("aéжß") |> Iter.all(Codepoint.is_lower)
    refute String.to_codepoints("aéжß") |> Iter.any(Codepoint.is_upper)
    // CJK has no case, nor do digits and emoji, and title-case ǅ (category
    // Lt) is neither upper nor lower.
    refute String.to_codepoints("中7🙂ǅ") |> Iter.any(Codepoint.is_upper)
    refute String.to_codepoints("中7🙂ǅ") |> Iter.any(Codepoint.is_lower)
}
