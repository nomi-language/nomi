test "floats convert to ints by truncating toward zero" {
    assert Float.to_int(3.7) == Some(3)
    assert Float.to_int(-3.7) == Some(-3)
    assert Float.to_int(42.0) == Some(42)
    assert Float.to_int(0.0) == Some(0)
}

test "float to int rejects overflow and special values" {
    assert Float.to_int(1000000000000000000000000000000.0) == None
    assert Float.to_int(-1000000000000000000000000000000.0) == None
    assert Float.to_int(Float.nan()) == None
    assert Float.to_int(Float.positive_infinity()) == None
    assert Float.to_int(Float.negative_infinity()) == None
}

test "float rounding helpers return integer-valued floats" {
    assert Float.round(3.5) == 4.0
    assert Float.round(2.5) == 2.0
    assert Float.round(3.7) == 4.0
    assert Float.floor(3.7) == 3.0
    assert Float.floor(-3.2) == -4.0
    assert Float.ceil(3.2) == 4.0
    assert Float.ceil(-3.7) == -3.0
    assert Float.trunc(3.7) == 3.0
    assert Float.trunc(-3.7) == -3.0
}

test "float rounding can feed int conversion through pipes" {
    assert 3.7
        |> Float.round()
        |> Float.to_int()
        |> Maybe.equal?(Some(4))

    assert 3.7
        |> Float.floor()
        |> Float.to_int()
        |> Maybe.equal?(Some(3))

    assert 3.2
        |> Float.ceil()
        |> Float.to_int()
        |> Maybe.equal?(Some(4))
}

test "float special values can be produced and classified" {
    assert Float.nan?(0.0 / 0.0)
    assert 1.0 / 0.0 == Float.positive_infinity()
    assert -(1.0 / 0.0) == Float.negative_infinity()

    assert Float.nan?(Float.nan())
    refute Float.nan?(3.14)
    assert Float.infinite?(Float.positive_infinity())
    assert Float.infinite?(Float.negative_infinity())
    refute Float.infinite?(3.14)
    assert Float.finite?(3.14)
    refute Float.finite?(Float.nan())
    refute Float.finite?(Float.positive_infinity())
}

test "float equality treats NaN reflexively" {
    assert Float.nan() == Float.nan()
    assert Float.positive_infinity() == 1.0 / 0.0
    refute Float.nan() == 3.14
}

test "float special values propagate through arithmetic and rounding" {
    assert Float.nan?(5.0 + Float.nan())
    assert Float.infinite?(1.0 + Float.positive_infinity())

    assert Float.nan()
        |> Float.round()
        |> Float.nan?()

    assert Float.positive_infinity()
        |> Float.floor()
        |> Float.infinite?()
}

// True for -0.0 alone: `==` cannot tell the zeros apart, but dividing by them
// gives infinities of opposite signs.
fn negative_zero?(x: Float) -> Bool {
    x == 0.0 and 1.0 / x < 0.0
}

test "float abs clears the sign" {
    assert Float.abs(-2.5) == 2.5
    assert Float.abs(2.5) == 2.5
    assert Float.abs(0.0) == 0.0
    refute negative_zero?(Float.abs(-0.0))
    refute negative_zero?(Float.abs(0.0))
    assert Float.abs(Float.negative_infinity()) == Float.positive_infinity()
    assert Float.abs(Float.positive_infinity()) == Float.positive_infinity()
    assert Float.nan?(Float.abs(Float.nan()))
    assert Float.nan?(Float.abs(-Float.nan()))
}

test "float sign is -1, 0 or 1, and 0 for both zeros and NaN" {
    assert Float.sign(-2.5) == -1
    assert Float.sign(2.5) == 1
    assert Float.sign(0.0) == 0
    assert Float.sign(-0.0) == 0
    assert Float.sign(Float.negative_infinity()) == -1
    assert Float.sign(Float.positive_infinity()) == 1
    assert Float.sign(Float.nan()) == 0
}

test "float min and max order the two zeros and propagate NaN" {
    assert Float.min(1.5, -2.0) == -2.0
    assert Float.max(1.5, -2.0) == 1.5
    assert Float.min(-2.0, 1.5) == -2.0
    assert Float.max(-2.0, 1.5) == 1.5
    assert Float.min(3.0, 3.0) == 3.0
    assert Float.max(3.0, 3.0) == 3.0

    assert negative_zero?(Float.min(-0.0, 0.0))
    assert negative_zero?(Float.min(0.0, -0.0))
    refute negative_zero?(Float.max(-0.0, 0.0))
    refute negative_zero?(Float.max(0.0, -0.0))
    assert negative_zero?(Float.min(-0.0, -0.0))
    assert negative_zero?(Float.max(-0.0, -0.0))

    assert Float.min(Float.negative_infinity(), -1.0) == Float.negative_infinity()
    assert Float.max(Float.positive_infinity(), 1.0) == Float.positive_infinity()

    assert Float.nan?(Float.min(Float.nan(), 1.0))
    assert Float.nan?(Float.min(1.0, Float.nan()))
    assert Float.nan?(Float.max(Float.nan(), 1.0))
    assert Float.nan?(Float.max(1.0, Float.nan()))
    assert Float.nan?(Float.min(Float.nan(), Float.negative_infinity()))
    assert Float.nan?(Float.max(Float.positive_infinity(), Float.nan()))
}
