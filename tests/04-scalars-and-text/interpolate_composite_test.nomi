//# Interpolating a tuple or an anonymous record whose parts are not all
//# scalars.
//#
//# `"${t}"` renders a tuple as `#(Display(a), Display(b), ...)` and a record as
//# `#{f: Display(v), ...}`: each part through its own Display impl, std's for
//# `Maybe`, `Result`, `Set` and the collections, the program's for its own
//# types. `Display.to_string(t)` and `io.print(t)` give the same text.

struct Point {
    x: Int
    m: Maybe<Int>
}

derive Display for Point

struct Greeter {
    name: String
}

impl Display for Greeter {
    fn to_string(g: Greeter) -> String {
        "hi ${g.name}"
    }
}

struct Box<T> {
    value: T
}

impl<T> Display for Box<T> where T: Display {
    fn to_string(b: Box<T>) -> String {
        "box of ${b.value}"
    }
}

enum Color {
    Red
    Green
}

derive Display for Color

type Id Int

derive Display for Id

fn show<T>(x: T) -> String where T: Display {
    "[${x}]"
}

fn always() -> Result<Int, Infallible> {
    Ok(3)
}

test "a tuple holding a Maybe renders the variant" {
    none: #(Int, Maybe<Int>) = #(1, None)
    some: #(Int, Maybe<Int>) = #(1, Some(2))
    assert "${none}" == "#(1, None)"
    assert "${some}" == "#(1, Some(2))"
    assert Display.to_string(none) == "#(1, None)"
}

test "a tuple holding a Result renders the variant" {
    bad: #(Int, Result<Int, String>) = #(1, Err("bad"))
    good: #(Int, Result<Int, String>) = #(1, Ok(5))
    assert "${bad}" == "#(1, Err(bad))"
    assert "${good}" == "#(1, Ok(5))"
    assert "${#(1, always())}" == "#(1, Ok(3))"
}

test "a tuple holding a collection renders its elements by Display" {
    assert "${#(1, [2, 3])}" == "#(1, [2, 3])"
    assert "${#(1, %{"a" => 2})}" == "#(1, %{a => 2})"
    assert "${#(1, %[2])}" == "#(1, %[2])"
    maybes: #(List<Maybe<Int>>, String) = #([Some(1), None], "x")
    assert "${maybes}" == "#([Some(1), None], x)"
}

test "a tuple holding a declared type renders through its impl" {
    assert "${#(1, #Point{x: 2, m: None})}" == "#(1, #Point{x: 2, m: None})"
    assert "${#(#Greeter{name: "Ada"}, 2)}" == "#(hi Ada, 2)"
    assert "${#(#Box{value: 4}, #Box{value: "s"})}" == "#(box of 4, box of s)"
    assert "${#(1, Color.Red)}" == "#(1, Red)"
    assert "${#(1, Id(4))}" == "#(1, Id(4))"
    assert Display.to_string(#(#Greeter{name: "Bo"}, Color.Green)) == "#(hi Bo, Green)"
}

test "a nested tuple renders each level by Display" {
    nested: #(Int, #(Maybe<Int>, String)) = #(1, #(Some(2), "x"))
    assert "${nested}" == "#(1, #(Some(2), x))"
    assert "${#([#Greeter{name: "Cy"}], 2)}" == "#([hi Cy], 2)"
}

test "an anonymous record holding a Maybe renders the variant" {
    r: #{a: Int, b: Maybe<Int>} = #{a: 1, b: None}
    assert "${r}" == "#{a: 1, b: None}"
    assert "${#{g: #Greeter{name: "Di"}, n: 3}}" == "#{g: hi Di, n: 3}"
}

test "a list of tuples holding a Maybe renders each tuple" {
    pairs: List<#(Int, Maybe<Int>)> = [#(1, None), #(2, Some(3))]
    assert "${pairs}" == "[#(1, None), #(2, Some(3))]"
}

test "a type parameter bounded by Display renders a tuple" {
    assert show(#(1, Some(2))) == "[#(1, Some(2))]"
    nested: Maybe<#(Int, Maybe<Int>)> = Some(#(1, None))
    assert show(nested) == "[Some(#(1, None))]"
}
