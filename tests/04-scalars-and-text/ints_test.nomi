import std/int.PositiveInt

test "ints convert to floats" {
    assert Int.to_float(5) == 5.0
    assert Int.to_float(-7) == -7.0
    assert Int.to_float(0) == 0.0
}

test "non-zero refinement validates divisors" {
    assert Int.to_non_zero(5)
    assert Int.to_non_zero(-3)
    assert Int.to_non_zero(0) == None
}

test "non-zero integers make division and modulo total" {
    assert Some(divisor) = Int.to_non_zero(3)
    assert Some(negative_divisor) = Int.to_non_zero(2)

    assert Int.divide(10, divisor) == 3
    assert Int.divide(-7, negative_divisor) == -3
    assert Int.modulo(10, divisor) == 1
}

test "positive refinement is stricter than non-zero" {
    assert Int.to_positive(5)
    assert Int.to_positive(0) == None
    assert Int.to_positive(-3) == None
}

fn divide_by_positive(x: Int, divisor: Int): Int {
    case Int.to_positive(divisor) {
        .Some(p) -> Int.divide(x, PositiveInt.to_non_zero(p))
        .None -> 0
    }
}

test "positive integers can be used as non-zero divisors" {
    assert divide_by_positive(20, 6) == 3
}

test "positive refinement rejects zero divisors" {
    assert divide_by_positive(20, 0) == 0
}

test "int abs and sign" {
    assert Int.abs(-5) == 5
    assert Int.abs(5) == 5
    assert Int.abs(0) == 0
    assert Int.abs(Int.max_value) == Int.max_value
    assert Int.abs(Int.min_value + 1) == Int.max_value

    assert Int.sign(-5) == -1
    assert Int.sign(0) == 0
    assert Int.sign(5) == 1
    assert Int.sign(Int.min_value) == -1
    assert Int.sign(Int.max_value) == 1
}

test "int min and max" {
    assert Int.min(3, -2) == -2
    assert Int.max(3, -2) == 3
    assert Int.min(-2, 3) == -2
    assert Int.max(-2, 3) == 3
    assert Int.min(4, 4) == 4
    assert Int.max(4, 4) == 4
    assert Int.min(Int.min_value, Int.max_value) == Int.min_value
    assert Int.max(Int.min_value, Int.max_value) == Int.max_value
}
