import {
    std/compiler
    std/matcher.Matcher
    std/regex.Regex
}

test "split takes a string or a regex" {
    assert String.split("a,b,,c", ",") == ["a", "b", "", "c"]
    assert String.split("a,b,,c", Regex`,+`) == ["a", "b", "c"]
    assert "one  two\tthree" |> String.split(" ") == ["one", "", "two\tthree"]
    assert "one  two\tthree" |> String.split(Regex`\s+`) == ["one", "two", "three"]
}

test "contains takes a string or a regex" {
    digits = Regex`\d+`

    assert String.contains("order 66", "66")
    refute String.contains("order", "66")
    assert String.contains("order 66", digits)
    refute String.contains("order", digits)
    assert "aisle 7" |> String.contains(digits)

    assert "aisle 7" |> String.contains("7")
}

test "starts_with and ends_with anchor a regex to that end" {
    digits = Regex`\d+`

    assert String.starts_with("42 apples", "42")
    assert String.starts_with("42 apples", digits)
    refute String.starts_with("apples 42", digits)
    assert String.ends_with("apples 42", "42")
    assert String.ends_with("apples 42", digits)
    refute String.ends_with("42 apples", digits)
    assert "x.PDF" |> String.ends_with(Regex`(?i)\.pdf`)

    assert "x.pdf" |> String.ends_with(".pdf")
}

test "ends_with finds a match ending at the end, not only the leftmost one" {
    assert String.ends_with("ab", Regex`a|ab`)
    assert String.ends_with("xab", Regex`b|xab`)
}

test "replace takes a string or a regex and replaces every match" {
    assert String.replace("a.b.c", ".", "-") == "a-b-c"
    assert String.replace("call 555-0100", Regex`\d`, "#") == "call ###-####"
    assert "x1y22" |> String.replace(Regex`(\d)+`, "<$1>") == "x<1>y<2>"
    assert "x1y22" |> String.replace("1", "$") == "x$y22"
}

test "find_all lists every match" {
    assert String.find_all("order 66, aisle 7", Regex`\d+`) == ["66", "7"]
    assert "banana" |> String.find_all("an") == ["an", "an"]
    assert String.find_all("banana", "x") == []
    assert "banana" |> String.find_all(Regex`x`) == []
}

test "find returns the first match, from a string or a regex" {
    assert String.find("order 66, aisle 7", Regex`\d+`) == Some("66")
    assert "order 66" |> String.find(Regex`\d+`) == Some("66")
    assert String.find("order", Regex`\d+`) == None
    assert String.find("banana", "an") == Some("an")
    assert "banana" |> String.find("x") == None
}

test "find with an empty needle or an empty regex match finds the empty string" {
    assert String.find("abc", "") == Some("")
    assert String.find("", "") == Some("")
    assert String.find("baaa", Regex`a*`) == Some("")
    assert String.find("", Regex`x*`) == Some("")
    assert String.find("abc", Regex`^`) == Some("")
}

test "find works over Unicode text" {
    assert String.find("café crème", Regex`\p{L}*é`) == Some("café")
    assert String.find("na🙂ve 🙂", "🙂") == Some("🙂")
    assert String.find("ééé", Regex`é+`) == Some("ééé")
    assert String.find("héllo", "e") == None
}

test "find is the first element find_all returns" {
    texts = ["", "abc", "banana", "order 66, aisle 7", "café crème", "a1b22c"]

    assert Iter.all(texts, &first_agrees(&1, "an"))
    assert Iter.all(texts, &first_agrees(&1, ""))
    assert Iter.all(texts, &first_agrees(&1, "z"))
    assert Iter.all(texts, fn t -> first_agrees(t, Regex`\d+`))
    assert Iter.all(texts, fn t -> first_agrees(t, Regex`a*`))
    assert Iter.all(texts, fn t -> first_agrees(t, Regex`a|an`))
    assert Iter.all(texts, fn t -> first_agrees(t, Regex`\p{L}+`))
}

fn first_agrees<M>(text: String, m: M) -> Bool where M: Matcher {
    String.find(text, m) == (String.find_all(text, m) |> List.head())
}

test "a function of your own takes any matcher" {
    assert count("a,b,c", ",") == 2
    assert count("a1b22", Regex`\d`) == 3
}

fn count<M>(text: String, m: M) -> Int where M: Matcher {
    String.find_all(text, m) |> Iter.count()
}

test "a matcher prints what each call finds" {
    output = compiler.run(
        """
        import {
            std/io
            std/regex.Regex
        }

        fn main() -> Result<Unit, String> {
            text = "a1b22c"
            digits = Regex`[0-9]+`

            io.inspect(String.split(text, digits))
            text |> String.split("b") |> io.inspect()
            io.inspect(String.contains(text, digits))
            io.inspect(String.replace(text, digits, "#"))
            text |> String.find_all(digits) |> io.inspect()
            Ok(Unit)
        }
        """
    )

    assert output == Ok(
        """
        ["a", "b", "c"]
        ["a1", "22c"]
        True
        "a#b#c"
        ["1", "22"]

        """
    )
}

test "a value that is not a matcher is rejected" {
    diagnostics = compiler.check(
        """
        fn main() {
            dbg String.split("a1b", 1)
        }
        """
    )

    assert [diagnostic] = diagnostics

    assert String.contains(
        diagnostic.message,
        "Int does not implement Matcher (required by `where M: Matcher`)",
    )
}

test "a regex replacement expands group references" {
    date = Regex`(?P<year>\d{4})-(?P<month>\d{2})`

    assert String.replace("2026-10 and 2027-01", date, "$2/$1") == "10/2026 and 01/2027"
    assert String.replace("2026-10", date, `${month}/${year}`) == "10/2026"
    assert String.replace("2026-10", date, `${2}x`) == "10x"
    assert String.replace("2026-10", date, "$2x") == ""
    assert String.replace("cost 5", Regex`(\d)`, "$$$1") == "cost $5"
    assert String.replace("cost 5", Regex`\d`, "$0$0") == "cost 55"
}

test "a string or codepoint matcher keeps the replacement literal" {
    assert String.replace("a1b1", "1", "$1") == "a$1b$1"
    assert String.replace("a-b", '-', `${x}$$`) == `a${x}$$b`
}

