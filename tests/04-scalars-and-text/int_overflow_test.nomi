import std/compiler

// A trap inside std is reported at the program's call into std: both
// programs name their own line 2, never a line of std/int.nomi.
test "int abs of the minimum overflows as negating it does" {
    negated =
        """
            fn main() {
              _ = -Int.min_value
            }
            """
        |> compiler.run()

    absolute =
        """
            fn main() {
              _ = Int.abs(Int.min_value)
            }
            """
        |> compiler.run()

    assert Err(negated_message) = negated
    assert Err(absolute_message) = absolute
    assert negated_message == "line 2: integer overflow: 0 - -9223372036854775808"
    assert absolute_message == "line 2: integer overflow: 0 - -9223372036854775808"
}

test "int modulo by zero traps as the remainder does" {
    remainder =
        """
            fn main() {
              _ = 7 % 0
            }
            """
        |> compiler.run()

    modulo =
        """
            fn main() {
              _ = Int.modulo(7, 0)
            }
            """
        |> compiler.run()

    assert Err(remainder_message) = remainder
    assert Err(modulo_message) = modulo
    assert remainder_message == "line 2: division by zero"
    assert modulo_message == "line 2: division by zero"
}
