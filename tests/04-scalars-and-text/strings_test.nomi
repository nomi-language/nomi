import {
    std/regex.Regex
    std/strings.NormalForm.{NFC, NFD}
}

test "strings report length containment and slices" {
    assert String.length("hello") == 5
    assert String.contains?("hello world", "world")
    refute String.contains?("hello world", "nomi")
    assert String.slice("hello world", 0, 5) == "hello"
}

test "strings join and split text" {
    assert String.join(["a", "b", "c"], "-") == "a-b-c"
    assert String.join([], "-") == ""

    assert String.split("a,b,c", ",") == ["a", "b", "c"]
    assert String.split("a, b, c", ", ") == ["a", "b", "c"]
    assert String.split("hello", "") == ["h", "e", "l", "l", "o"]
    assert String.split(",a,", ",") == ["", "a", ""]
}

test "strings expose bytes, graphemes, and codepoints" {
    assert String.to_bytes("hello")
    |> Iter.map(Byte.to_int)
    |> Iter.to_list() == [104, 101, 108, 108, 111]

    assert String.to_bytes("café")
    |> Iter.map(Byte.to_int)
    |> Iter.to_list() == [99, 97, 102, 195, 169]

    assert Iter.to_list("abc") == ["a", "b", "c"]

    assert "abc"
        |> String.to_codepoints()
        |> Iter.map(Codepoint.to_int)
        |> Iter.to_list()
        |> List.equal?([97, 98, 99])
}

test "prefixes and suffixes can be stripped when present" {
    assert String.strip_prefix("hello world", "hello ") == Some("world")
    assert String.strip_prefix("hello", "xyz") == None
    assert String.strip_suffix("file.txt", ".txt") == Some("file")
    assert String.strip_suffix("file.txt", ".md") == None
}

test "trim removes outer whitespace and preserves inner whitespace" {
    assert String.trim("  hello  ") == "hello"
    assert String.trim("\n\tworld\n") == "world"
    assert String.trim("a  b") == "a  b"
}

test "strings parse signed integers or return none" {
    assert String.to_int("42") == Some(42)
    assert String.to_int("-7") == Some(-7)
    assert String.to_int("  3  ") == Some(3)
    assert String.to_int("abc") == None
    assert String.to_int("") == None
}

test "grapheme transforms materialize back to strings" {
    assert "abc"
        |> Iter.map(fn g -> g + g)
        |> String.join()
        |> String.equal?("aabbcc")

    assert "a1b2c3"
        |> Iter.filter(fn g -> g == "1" or g == "2" or g == "3")
        |> String.join()
        |> String.equal?("123")
}

test "normalization is explicit before byte-based equality" {
    nfc = "é"
    nfd = "é"

    refute nfc == nfd
    assert String.normalize(nfc, NFC) == String.normalize(nfd, NFC)
    assert String.normalize(nfc, NFD) == nfd
}

fn slash_joined(parts: Iter<String>) -> String {
    String.join(parts, "/")
}

test "join reads any iterator of strings and defaults to no separator" {
    assert String.join(["he", "llo"]) == "hello"
    assert #{"solo"} |> String.join(", ") == "solo"
    assert #["x", "y", "z"] |> String.join("+") == "x+y+z"
    assert "héllo" |> String.join(".") == "h.é.l.l.o"
    assert "héllo" |> Iter.map(String.to_upper) |> String.join() == "HÉLLO"
    assert 1..=3 |> Iter.map(Int.to_string) |> String.join("-") == "1-2-3"

    assert Iter.from(1)
        |> Iter.filter(fn n -> n % 2 == 0)
        |> Iter.map(Int.to_string)
        |> Iter.take(3)
        |> String.join(" ")
        |> String.equal?("2 4 6")

    assert %{"k" => 1}
    |> Iter.map(fn #(k, v) -> k + "=" + Int.to_string(v))
    |> String.join("&") == "k=1"

    assert slash_joined(["p", "q"]) == "p/q"
    assert slash_joined(#{"r"}) == "r"
}

test "captures lists the groups of the first match, without the whole match" {
    pair = Regex`(\w+)@(\w+)`

    assert String.captures("mail ann@home now", pair) == Some([Some("ann"), Some("home")])
    assert String.captures("no address", pair) == None
    assert String.captures("x", Regex`x`) == Some([])
}

test "a group that does not take part is None, and an empty one is Some(\"\")" {
    assert String.captures("b", Regex`(a)|(b)`) == Some([None, Some("b")])
    assert String.captures("y", Regex`(x*)(y)`) == Some([Some(""), Some("y")])
    assert String.captures("ac", Regex`a(b)?c`) == Some([None])
}

test "captures_all lists the groups of every match, left to right" {
    assert String.captures_all("a=1, b=22", Regex`(\w)=(\d+)`) == [
        [Some("a"), Some("1")],
        [Some("b"), Some("22")],
    ]

    assert "ab b" |> String.captures_all(Regex`(a)|(b)`) == [
        [Some("a"), None],
        [None, Some("b")],
        [None, Some("b")],
    ]

    assert String.captures_all("none", Regex`(\d)`) == []
}

test "captures work over Unicode text" {
    assert String.captures("café crème", Regex`(\p{L}+) (\p{L}+)`) == Some(
        [Some("café"), Some("crème")]
    )

    assert String.captures_all("🙂=1 é=2", Regex`(\S)=(\d)`) == [
        [Some("🙂"), Some("1")],
        [Some("é"), Some("2")],
    ]
}

test "captures_all finds the matches find_all finds" {
    re = Regex`(\d)(\d)?`
    text = "1 23 456"

    assert Iter.count(String.captures_all(text, re)) == Iter.count(String.find_all(text, re))

    assert String.captures_all(text, re) == [
        [Some("1"), None],
        [Some("2"), Some("3")],
        [Some("4"), Some("5")],
        [Some("6"), None],
    ]
}
