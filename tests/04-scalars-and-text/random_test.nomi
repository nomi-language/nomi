import std/random.{Generator, Seed}

test "seeded generators produce deterministic values" {
    seed = Seed.from_int(123)
    die = Generator.int(1, 6)

    #(roll, seed) = die |> Generator.step(seed)

    assert roll == 2

    #(hand, seed) =
        die
        |> Generator.list(3)
        |> Generator.step(seed)

    assert hand == [1, 5, 2]

    #(choice, _) =
        Generator.uniform("rock", ["paper", "scissors"])
        |> Generator.step(seed)

    assert choice == "scissors"
}

test "random generators compose dependent draws" {
    seed = Seed.from_int(123)
    size = Generator.int(1, 4)

    #(sized, _) =
        size
        |> Generator.flat_map(fn n -> Generator.list(Generator.bool(), n))
        |> Generator.step(seed)

    assert sized == [False, False, True, False]
}

test "weighted generators require positive total weight" {
    assert Generator.weighted(#(0.0, "never"), [])
        |> Result.err?()
}

test "weighted generators reject negative weights" {
    assert Generator.weighted(#(-1.0, "bad"), [])
        |> Result.err?()
}

test "an integer range as wide as Int draws in range" {
    seed = Seed.from_int(2026)

    #(all, _) =
        Generator.int(Int.min_value, Int.max_value)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert Iter.count(all) == 8
    assert all |> Iter.any?(fn n -> n < 0)
    assert all |> Iter.any?(fn n -> n > 0)

    #(wide, _) =
        Generator.int(-5, Int.max_value)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert wide |> Iter.all?(fn n -> n >= -5)
    assert wide |> Iter.any?(fn n -> n > Int.max_value / 2)

    #(low, _) =
        Generator.int(Int.min_value, 0)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert low |> Iter.all?(fn n -> n <= 0)

    #(top, _) = Generator.int(Int.max_value, Int.max_value) |> Generator.step(seed)
    assert top == Int.max_value
}

test "a float range wider than a Float can span draws in range" {
    #(xs, _) =
        Generator.float(-1.0e308, 1.0e308)
        |> Generator.list(8)
        |> Generator.step(Seed.from_int(2026))

    assert xs |> Iter.all?(fn x -> Float.finite?(x) and x >= -1.0e308 and x < 1.0e308)
    assert xs |> Iter.any?(fn x -> x < 0.0)
    assert xs |> Iter.any?(fn x -> x > 0.0)
}
