import std/random.{Generator, Seed}

test "seeded generators produce deterministic values" {
    seed = Seed.from_int(123)
    die = Generator.int(1, 6)

    #(roll, seed) = die |> Generator.step(seed)

    assert roll == 2

    #(hand, seed) =
        die
        |> Generator.list(3)
        |> Generator.step(seed)

    assert hand == [1, 5, 2]

    #(choice, _) =
        Generator.uniform("rock", ["paper", "scissors"])
        |> Generator.step(seed)

    assert choice == "scissors"
}

test "random generators compose dependent draws" {
    seed = Seed.from_int(123)
    size = Generator.int(1, 4)

    #(sized, _) =
        size
        |> Generator.flat_map(fn n -> Generator.list(Generator.bool(), n))
        |> Generator.step(seed)

    assert sized == [False, False, True, False]
}

test "weighted generators require positive total weight" {
    assert Generator.weighted(#(0.0, "never"), [])
        |> Result.is_err()
}

test "weighted generators reject negative weights" {
    assert Generator.weighted(#(-1.0, "bad"), [])
        |> Result.is_err()
}

test "an integer range of any width draws in range" {
    seed = Seed.from_int(2026)
    top = Int.pow(2, 63) - 1

    #(all, _) =
        Generator.int(-top - 1, top)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert Iter.count(all) == 8
    assert all |> Iter.any(&(&1 < 0))
    assert all |> Iter.any(&(&1 > 0))

    #(wide, _) =
        Generator.int(-5, top)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert wide |> Iter.all(&(&1 >= -5))
    assert wide |> Iter.any(&(&1 > top / 2))

    #(low, _) =
        Generator.int(-top - 1, 0)
        |> Generator.list(8)
        |> Generator.step(seed)

    assert low |> Iter.all(&(&1 <= 0))

    #(one, _) = Generator.int(top, top) |> Generator.step(seed)
    assert one == top

    huge = Int.pow(10, 40)

    #(past, _) =
        Generator.int(-huge, huge)
        |> Generator.list(16)
        |> Generator.step(seed)

    assert past |> Iter.all(&(&1 >= -huge and &1 <= huge))
    assert past |> Iter.any(&(&1 > Int.pow(10, 30)))
    assert past |> Iter.any(&(&1 < -Int.pow(10, 30)))
}

test "a float range wider than a Float can span draws in range" {
    #(xs, _) =
        Generator.float(-1.0e308, 1.0e308)
        |> Generator.list(8)
        |> Generator.step(Seed.from_int(2026))

    assert xs |> Iter.all(fn x -> Float.is_finite(x) and x >= -1.0e308 and x < 1.0e308)
    assert xs |> Iter.any(&(&1 < 0.0))
    assert xs |> Iter.any(&(&1 > 0.0))
}
