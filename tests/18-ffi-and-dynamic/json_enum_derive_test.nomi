import std/json.{FromJson, Json, ToJson}

struct Circle {
    radius: Float
}

derive Equatable for Circle
derive ToJson for Circle
derive FromJson for Circle

enum Shape {
    embeds Circle
    Rect {width_px: Int, height_px: Int}
    Pair #(Int, String)
    Label String
    Dot
}

derive Equatable for Shape
derive ToJson for Shape with #ToJson.Options{rename_all: Json.Case.Camel}
derive FromJson for Shape with #FromJson.Options{rename_all: Json.Case.Camel}

fn decoded(text: String) -> Result<Shape, String> {
    case Json.decode(text) {
        Ok(json) -> Shape.from_json(json) |> Result.map_err(fn e -> Display.to_string(e))
        Err(e) -> Err(Display.to_string(e))
    }
}

test "a derived enum's FromJson reads what its ToJson writes" {
    shapes = [
        #Shape.Circle{radius: 2.5},
        #Shape.Rect{width_px: 3, height_px: 4},
        Shape.Pair(#(1, "one")),
        Shape.Label("hi"),
        Shape.Dot,
    ]

    texts = Iter.map(shapes, fn s -> Json.encode(ToJson.to_json(s))) |> Iter.to_list()

    assert texts == [
        "{\"Circle\":{\"radius\":2.5}}",
        "{\"Rect\":{\"widthPx\":3,\"heightPx\":4}}",
        "{\"Pair\":[1,\"one\"]}",
        "{\"Label\":\"hi\"}",
        "\"Dot\"",
    ]

    back = Iter.map(texts, fn t -> decoded(t)) |> Iter.to_list()
    assert back == Iter.map(shapes, fn s -> Ok(s)) |> Iter.to_list()
}

test "a derived enum's FromJson names what it could not read" {
    assert decoded("\"Square\"") == Err("expected Shape, got \"Square\"")
    assert decoded("{\"Label\":3}") == Err("Label: expected string, got int")
    assert decoded("{\"Pair\":[1]}") == Err("Pair: expected array of 2, got array")
    assert decoded("{\"Pair\":[1,2]}") == Err("Pair.[1]: expected string, got int")
    assert decoded("{\"Rect\":{\"widthPx\":3}}") == Err("Rect.heightPx: expected Int, got missing")
    assert decoded("{\"Hexagon\":1}") == Err("expected Shape, got object")
    assert decoded("7") == Err("expected string or object, got int")
}

test "vectors and sets cross as JSON arrays" {
    v = #[1, 2, 3]
    assert Json.encode(ToJson.to_json(v)) == "[1,2,3]"
    back: Result<Vector<Int>, Json.ShapeError> = FromJson.from_json(ToJson.to_json(v))
    assert back == Ok(v)

    s = %["a"]
    assert Json.encode(ToJson.to_json(s)) == "[\"a\"]"

    twice: Result<Set<Int>, Json.ShapeError> = FromJson.from_json(
        Json.Arr([Json.Int(2), Json.Int(2)])
    )

    assert twice == Ok(%[2])
}

test "a whole JSON number reads as a Float" {
    assert Float.from_json(Json.Int(2)) == Ok(2.0)
}
