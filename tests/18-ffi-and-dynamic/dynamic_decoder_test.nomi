import std/dynamic.{self, PathSegment}

test "dynamic.Error display renders root field and index paths" {
    empty = #dynamic.Error{path: [], expected: "Object", got: "List"}
    assert dynamic.Error.to_string(empty) == "decode error at <root>: expected Object, got List"

    single = #dynamic.Error{
        path: [PathSegment.Field("age")],
        expected: "Int",
        got: "String",
    }

    assert dynamic.Error.to_string(single) == "decode error at age: expected Int, got String"

    nested = #dynamic.Error{
        path: [PathSegment.Field("user"), PathSegment.Field("emails"), PathSegment.Index(0)],
        expected: "String",
        got: "Null",
    }

    assert dynamic.Error.to_string(
        nested
    ) == "decode error at user.emails[0]: expected String, got Null"
}
