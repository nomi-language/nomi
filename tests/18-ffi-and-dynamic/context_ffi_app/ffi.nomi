import std::int.Int64

gopkg "contextffiapp" as ffi

// The Go functions take a `context.Context` first, which the binding leaves
// out: Go receives the calling task's context. The Go limit is an int64, so
// the binding declares a range that fits it.
pub fn wait_for_cancel(limit_ms: NonNegativeInt and Int64) -> String go ffi.WaitForCancel

pub fn has_deadline() -> Bool go ffi.HasDeadline
