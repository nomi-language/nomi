import
    std::embed.Files
    std::http.{self, Request, Response}
end

/// The site's static files and its page templates, read when the program
/// is compiled. Patterns name files from the module root, as import paths
/// do, so this file in web/ names web/public as `web/public`.
pub embed assets `
    web/public
    web/templates/*.html
    `

/// The static files, served at the root.
pub fn static_files() -> (Request) -> Response
    http.file_server_embedded(Files.sub(assets, "web/public")!)
end
