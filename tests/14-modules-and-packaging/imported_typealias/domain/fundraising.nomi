// Names an imported typealias in a struct field and an enum payload.
import domain::models.Reaction

pub struct Form {
    kind: Maybe<Reaction>
}

pub enum Event {
    Reacted Reaction
    Cleared
}

pub fn kind_of(form: Form) -> Maybe<Reaction> {
    form.kind
}

pub fn event_of(form: Form) -> Event {
    case form.kind {
        Some(kind) -> .Reacted(kind)
        None -> .Cleared
    }
}
