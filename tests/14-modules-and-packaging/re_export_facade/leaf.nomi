/// "leaf" file that defines the public items the facade re-exports.
/// Consumers don't import leaf directly; they go through facade.
pub fn double(x: Int) -> Int
    x * 2
end

pub fn add(a: Int, b: Int) -> Int
    a + b
end

pub struct Box
    value: Int
end

pub fn make_box(n: Int) -> Box
    Box{value: n}
end

pub fn open_box(b: Box) -> Int
    b.value
end
