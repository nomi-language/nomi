import facade.{add, double, greet, make_box, open_box, shout}

test "re-export facade exposes leaf and parser items" {
    b = make_box(7)

    assert double(21) == 42
    assert add(10, 20) == 30
    assert open_box(b) == 7
    assert b.value == 7
    assert greet("Alice") == "Hello, Alice"
    assert shout("Bob") == "Bob!"
}
