import
    std::compiler.{self, Project}
    test_helpers
end

test "private functions cannot be imported"
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        files: {
            "main" => """
                import api.ping

                fn main()
                  _ = ping()
                end
                """,
            "api" => """
                fn ping() -> String
                  "pong"
                end
                """,
        },
    })

    assert Iter.count(diagnostics) == 1
    assert test_helpers.has_diagnostic(diagnostics, "ping' is private and cannot be imported")
end

test "private types cannot be imported through public modules"
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        files: {
            "main" => """
                import api.Hidden

                fn main()
                  _ = Hidden{name: "Ada"}
                end
                """,
            "api" => """
                struct Hidden
                  name: String
                end
                """,
        },
    })

    assert Iter.count(diagnostics) == 1
    assert test_helpers.has_diagnostic(diagnostics, "Hidden' is private and cannot be imported")
end

test "private helpers are hidden from imported modules"
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        files: {
            "main" => """
                import api.{self, Widget}

                fn main()
                  w: Widget = api.make("Ada")
                  _ = api.secret(w)
                end
                """,
            "api" => """
                pub struct Widget
                  name: String
                end

                pub fn label(w: Widget) -> String
                  w.name
                end

                fn secret(w: Widget) -> String
                  "secret " + w.name
                end

                pub fn make(name: String) -> Widget
                  Widget{name:}
                end
                """,
        },
    })

    assert Iter.count(diagnostics) == 1
    assert test_helpers.has_diagnostic(diagnostics, "file 'api' has no member 'secret'")
end
