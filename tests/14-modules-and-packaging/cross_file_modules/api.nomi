pub struct Widget {
    name: String
}

pub fn label(w: Widget): String {
    w.name
}

pub fn make(name: String): Widget {
    Widget{name}
}

pub opaque struct Token {
    value: String
}

pub fn reveal(t: Token): String {
    t.value
}

pub fn make_token(value: String): Token {
    Token{value}
}
