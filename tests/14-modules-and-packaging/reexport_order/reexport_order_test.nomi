// A name a file re-exports with `pub import` is importable from a file that
// comes before it in the order of their paths, and so is a re-export of
// that re-export.
import {
    domain::aliases.Kind
    domain::fundraising.{self, Form}
}

test "a struct field typed with a re-exported enum" {
    form = Form{kind: Some(.Heart)}

    assert fundraising.kind_of(form) == Some(.Heart)
}

test "a re-export of a re-export is the same enum" {
    kind: Kind = .Pray
    form = Form{kind: Some(kind)}

    assert form.kind == Some(Kind.Pray)
}
