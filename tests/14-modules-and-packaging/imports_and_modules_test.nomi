import {
    std/maybe.Maybe.{None as Nothing, Some as Just}
    std/strings.String.{contains? as has, length as len}
}

once default_greeting: String = "Hello"

struct Account {
    owner: String
    balance: Int
}

struct Person {
    name: String
}

impl Greeter for Person {
    fn greet(p: Person): String {
        default_greeting + ", " + p.name
    }
}

interface Greeter {
    fn greet(value: self): String
}

fn build_person(name: String): Person {
    Person{name}
}

struct GeometryPoint {
    x: Int
    y: Int
}

enum Axis {
    X
    Y
}

fn origin(): GeometryPoint {
    GeometryPoint{x: 0, y: 0}
}

fn vertical_axis(): Axis {
    Axis.Y
}

fn axis_name(axis: Axis): String {
    case axis {
        Axis.X -> "x"
        Axis.Y -> "y"
    }
}

once default_point: GeometryPoint = origin()

fn canonical_header_name(name: String): String {
    name
}

once default_header_name: String = canonical_header_name("content-type")

test "import aliases rename modules functions and variant constructors" {
    acct = Account{owner: "Ada", balance: 100}

    assert Iter.count([acct.balance, 200, 300]) == 3
    assert Just(7) == Some(7)
    assert Nothing == None
    assert len("nomi") == 4
    assert has("nomi", "om")
}

test "inline visibility keeps private helpers usable within the file" {
    alice = build_person("Alice")

    assert Greeter.greet(alice) == "Hello, Alice"
    assert default_greeting == "Hello"
}

test "file-scope declarations can contain types functions and once values" {
    point = origin()
    default: GeometryPoint = default_point

    assert point.x == 0
    assert axis_name(vertical_axis()) == "y"
    assert default.y == 0
    assert canonical_header_name("accept") == "accept"
    assert default_header_name == "content-type"
}
