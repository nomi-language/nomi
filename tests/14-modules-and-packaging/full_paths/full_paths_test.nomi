// A file is used by its short name, the last segment of its path, or by its
// full path. The full path is needed where two imports share a short name
// (`notifications` here) or a local or a declaration takes it (`users`), and
// it may be written wherever the short name may: a call, a type, a pattern, a
// struct literal, an owner function and a variant.
import {
    db::notifications
    db::schema
    jobs::notifications
    views::admin::users
}

fn users() -> List<String> {
    ["ada", "grace"]
}

fn describe(kind: db::schema.Kind) -> String {
    case kind {
        db::schema.Kind.Draft -> "draft"
        schema.Kind.Published(n) -> "published ${n}"
    }
}

fn title(post: db::schema.Post) -> String {
    case post {
        db::schema.Post{id, title} -> "${id}: ${title}"
    }
}

test "a short name and a full path name the same file" {
    post: schema.Post = db::schema.post(1)

    assert title(post) == "1: post 1"
    assert title(db::schema.Post{id: 2, title: "two"}) == "2: two"
    assert db::schema.Post.blank() == schema.Post.blank()
}

test "a full path names a variant" {
    assert describe(db::schema.Kind.Published(4)) == "published 4"
    assert describe(schema.Kind.Draft) == "draft"
}

test "two files of one short name are each reached by full path" {
    args = jobs::notifications.EmailArgs{to: "a@example.com"}

    assert db::notifications.pending() + jobs::notifications.pending() == 10
    assert args.to == "a@example.com"
}

test "a declaration keeps its name, and the file is reached by full path" {
    detail: views::admin::users.UserDetail = views::admin::users.UserDetail{name: "ada"}

    assert users() == ["ada", "grace"]
    assert views::admin::users.render(detail) == "<ada>"
}
