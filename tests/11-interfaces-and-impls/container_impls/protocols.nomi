// The interfaces, and their impls for the builtin scalars.
pub interface Show
    fn show(value: self) -> String

    fn loud(value: self) -> String
        "${Show.show(value)}!"
    end
end

pub interface Zero
    fn zero(n: Int) -> self
end

pub interface Holds<T>
    fn holds(c: self, x: T) -> Bool
end

impl Show for Int
    fn show(n: Int) -> String
        "i${n}"
    end
end

impl Show for String
    fn show(s: String) -> String
        "'${s}'"
    end
end

impl Zero for Int
    fn zero(n: Int) -> Int
        n
    end
end
