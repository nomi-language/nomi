// A local type may share its name with a stdlib one. Both keep their own
// impls: identity is (declaring file, name), so `Seed` here and
// `random.Seed` never share a dispatch slot.
import std/random.{self, Generator}

struct Seed {
    flavor: String
}

impl Display for Seed {
    fn to_string(seed: Seed): String {
        "seed(${seed.flavor})"
    }
}

test "a local type and a stdlib type may share a name" {
    mine = Seed{flavor: "sunflower"}
    die = try Generator.int(1, 6)
    (roll, _) = Generator.step(die, random.Seed.from_int(123))

    assert Display.to_string(mine) == "seed(sunflower)"
    assert roll == 2
}

enum Error {
    Open
}

impl Display for Error {
    fn to_string(error: Error): String {
        case error {
            Error.Open -> "open"
        }
    }
}

test "a local type does not shadow a stdlib type's members" {
    assert Display.to_string(Error.Open) == "open"
    assert Display.to_string(random.Error.OsEntropy{reason: "x"}) == "OS entropy unavailable: x"
}

// A local type may also declare a TYPE-OWNED FUNCTION on a name the stdlib
// type already uses. `Seed.from_int` here and `random.Seed.from_int` are two
// functions on two types, so both are declarable and neither shadows the
// other. The inherent-impl manifest keys type-owned functions by (declaring
// file, name); keyed by BARE receiver name, `import std/random` alone would
// make `from_int` un-declarable in this file (`duplicate type-owned function:
// Seed.from_int is defined 2 times`), blamed on the line below for a collision
// the author could not see.
//
// The two `from_int`s take the same argument shape on purpose — the
// discriminator is the RESULT. `flavor` is a field of this file's `Seed` and
// of no other type, so a manifest that resolved to std's function could not
// type-check this.
impl Seed {
    pub fn from_int(n: Int): Seed {
        Seed{flavor: "pumpkin ${n}"}
    }
}

test "a local type-owned function may share a stdlib one's name" {
    assert Seed.from_int(3).flavor == "pumpkin 3"
    die = try Generator.int(1, 6)
    (roll, _) = Generator.step(die, random.Seed.from_int(123))
    assert roll == 2
    assert Display.to_string(Seed.from_int(7)) == "seed(pumpkin 7)"
}
