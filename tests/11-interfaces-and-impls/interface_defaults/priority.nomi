// Priority lives in a sibling file so the main example exercises
// constrained interface defaults across imports.
pub struct Priority {
    level: Int
}

/// Constructs a Priority value for the constrained-default example.
pub fn make(level: Int): Priority {
    Priority{level}
}

impl Comparable for Priority {
    fn compare(a: Priority, b: Priority): Ordering {
        Int.compare(a.level, b.level)
    }
}
