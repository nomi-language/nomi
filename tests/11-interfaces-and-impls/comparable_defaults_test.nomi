struct Version
    major: Int
    minor: Int
end

derive Comparable for Version

// Ordered by key alone, so two entries with one key tie.
struct Entry
    key:   Int
    label: String
end

impl Comparable for Entry
    fn compare(a: Entry, b: Entry) -> Ordering
        Int.compare(a.key, b.key)
    end
end

fn bounded<T>(value: T, range: ClosedRange<T>) -> T where T: Comparable
    Comparable.clamp(value, range)
end

test "a derived Comparable has min, max and clamp"
    old = Version{major: 1, minor: 4}
    new = Version{major: 2, minor: 0}
    assert Version.min(new, old) == old
    assert Version.max(old, new) == new
    releases = ClosedRange.try_from(old..=new)!
    assert Version.clamp(Version{major: 3, minor: 1}, releases) == new
    assert Comparable.min(old, new) == old
    assert ClosedRange.try_from(new..=old) == None
end

test "a tie returns the first argument"
    first = Entry{key: 1, label: "first"}
    second = Entry{key: 1, label: "second"}
    assert Entry.min(first, second).label == "first"
    assert Entry.max(first, second).label == "first"
    assert Entry.clamp(first, ClosedRange.try_from(second..=second)!).label == "first"
    assert Float.to_string(Float.min(0.0, -0.0)) == "-0.0"
end

test "clamp through a generic bound"
    assert bounded(15, 0..=10) == 10
    assert bounded("m", "a"..="k") == "k"
    assert bounded(-4, Range.from(0)) == 0
    assert bounded(40, Range.from(0)) == 40

    low = Version{major: 1, minor: 0}
    high = Version{major: 2, minor: 0}
    assert bounded(Version{major: 0, minor: 9}, ClosedRange.try_from(low..=high)!) == low
end

test "a NaN value stays NaN, and a range with a NaN end is no ClosedRange"
    assert Float.is_nan(Float.clamp(Float.nan(), 0.0..=1.0))
    assert ClosedRange.try_from(Float.nan()..=1.0) == None
    assert ClosedRange.try_from(0.0..=Float.nan()) == None
    assert Float.to_string(Float.clamp(-0.0, 0.0..=1.0)) == "-0.0"
end
