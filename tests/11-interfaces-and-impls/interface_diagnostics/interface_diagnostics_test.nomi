import
    std::compiler.{self, Project}
    test_helpers
end

test "duplicate impl blocks report coherence diagnostics"
    diagnostics = compiler.check(
        """
        struct Dog
          name: String
        end

        impl Display for Dog
          fn to_string(d: Dog) -> String
            d.name
          end
        end

        impl Display for Dog
          fn to_string(d: Dog) -> String
            "duplicate " + d.name
          end
        end
        """
    )

    assert Iter.count(diagnostics) == 1

    assert test_helpers.has_diagnostic(
        diagnostics,
        "duplicate impl: `Display` is implemented for `Dog`",
    )
end

test "package-local types can use impl blocks"
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        manifest: Some(
            """
            [module]
            name = "demo"
            entry_points = ["main"]
            """
        ),
        files: {
            "main" => """
                interface Label
                  fn label(value: self) -> String
                end

                struct Thing
                  name: String
                end

                impl Label for Thing
                  fn label(value: Thing) -> String
                      value.name
                  end
                end

                fn main()
                  Unit
                end
                """,
        },
    })

    assert Iter.count(diagnostics) == 0
end

// The NEGATIVE CONTROL for nominal identity in the inherent-impl manifest.
// Keying that manifest by `(declaring file, name)` rather than by bare name
// let a local `Seed.from_int` coexist with `random.Seed.from_int` (the positive
// direction, pinned by same_named_stdlib_type/) — and it must NOT have
// disabled this: two type-owned functions of one name on ONE type are still
// one ambiguous slot, and are still rejected.
test "duplicate type-owned functions report coherence diagnostics"
    diagnostics = compiler.check_project(Project{
        entry_point: "main",
        files: {
            "main" => """
                struct Cookie
                  flavor: String
                end

                impl Cookie
                  pub fn new(flavor: String) -> Cookie
                    Cookie{flavor:}
                  end

                  pub fn new(other: String) -> Cookie
                    Cookie{flavor: other}
                  end
                end

                fn main()
                  Unit
                end
                """,
        },
    })

    assert test_helpers.has_diagnostic(
        diagnostics,
        "duplicate type-owned function: `Cookie.new` is defined 2 times",
    )
end
