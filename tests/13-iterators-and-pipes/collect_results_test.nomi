enum ParseError
    Blank
    NotANumber String
end

struct Point
    x: Int
    y: Int
end

fn parse(text: String) -> Result<Int, ParseError>
    if text == "" then
        Err(.Blank)
    else
        case String.to_int(text)
            .Some(n) -> Ok(n)
            .None -> Err(.NotANumber(text))
        end
    end
end

fn parse_message(text: String) -> Result<Int, String>
    Result.map_err(parse(text), fn _e -> "bad: " + text)
end

fn point_at(n: Int) -> Maybe<Point>
    if n >= 0 then
        Some(Point{x: n, y: n * 2})
    else
        None
    end
end

fn sum_all(texts: List<String>) -> Result<Int, ParseError>
    numbers = texts |> Iter.map(&parse(&1)) |> Result.collect()?

    Ok(Iter.sum(numbers))
end

test "Result.collect keeps every Ok value in order"
    parsed = ["3", "1", "2"] |> Iter.map(&parse_message(&1)) |> Result.collect()

    assert parsed == Ok([3, 1, 2])
end

test "Result.collect returns the first Err"
    parsed = ["1", "x", "", "y"] |> Iter.map(&parse(&1)) |> Result.collect()

    assert parsed == Err(ParseError.NotANumber("x"))
end

test "Result.collect accepts a list, a vector and an empty input"
    assert Result.collect([Ok(1), Err("a")]) == Err("a")
    assert Result.collect(Vector[Ok(1), Ok(2)]) == Ok([1, 2])

    none: List<Result<Int, String>> = []
    assert Result.collect(none) == Ok([])
end

test "Result.collect stops pulling at the first Err"
    stopped =
        Range.naturals()
        |> Iter.map(fn n -> if n < 3 then Ok(n) else Err(n))
        |> Result.collect()

    assert stopped == Err(3)
end

test "Result.collect under `?`"
    assert sum_all(["1", "2", "3"]) == Ok(6)
    assert sum_all(["1", "", "3"]) == Err(ParseError.Blank)
end

test "Result.partition keeps input order on both sides"
    (numbers, errors) =
        ["1", "x", "2", "", "3"]
        |> Iter.map(&parse(&1))
        |> Result.partition()

    assert numbers == [1, 2, 3]
    assert errors == [ParseError.NotANumber("x"), ParseError.Blank]

    (oks, messages) = Vector["4", "z"] |> Iter.map(&parse_message(&1)) |> Result.partition()

    assert oks == [4]
    assert messages == ["bad: z"]
end

test "Maybe.collect of a user struct"
    points = [0, 1, 2] |> Iter.map(&point_at(&1)) |> Maybe.collect()

    assert points == Some([Point{x: 0, y: 0}, Point{x: 1, y: 2}, Point{x: 2, y: 4}])

    missing = [0, -1, 2] |> Iter.map(&point_at(&1)) |> Maybe.collect()

    assert missing == None
end

test "Maybe.collect stops pulling at the first None"
    stopped =
        Range.naturals()
        |> Iter.map(fn n -> point_at(2 - n))
        |> Maybe.collect()

    assert stopped == None
end

test "Maybe.values drops every None"
    xs = Vector[0, -1, 2, -3] |> Iter.map(&point_at(&1)) |> Maybe.values()

    assert xs == [Point{x: 0, y: 0}, Point{x: 2, y: 4}]
end
