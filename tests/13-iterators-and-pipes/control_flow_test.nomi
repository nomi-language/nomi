test "reduce supports break and continue"
    partial_sum =
        [10, 20, 30, 40, 50]
        |> Iter.reduce(0, fn total, x ->
            if total + x > 60 then break
            total + x
        end)

    partial_sum_with_break_value =
        [10, 20, 30, 40, 50]
        |> Iter.reduce(0, fn total, x ->
            new_total = total + x
            if new_total > 60 then break new_total
            new_total
        end)

    sum_positives =
        [1, -2, 3, -4, 5]
        |> Iter.reduce(0, fn total, x ->
            if x < 0 then continue
            total + x
        end)

    processed =
        [5, -1, 3, -2, 0, 7, 8]
        |> Iter.reduce(0, fn total, x ->
            if x < 0 then continue
            if x == 0 then break
            total + x
        end)

    assert partial_sum == 60
    assert partial_sum_with_break_value == 100
    assert sum_positives == 9
    assert processed == 8
end

test "map supports break and continue"
    taken =
        [1, 2, 3, 4, 5]
        |> Iter.map(fn x ->
            if x > 3 then break
            x * 10
        end)
        |> Iter.to_list()

    taken_with_value =
        [1, 2, 3, 4, 5]
        |> Iter.map(fn x ->
            if x == 3 then break 999
            x * 10
        end)
        |> Iter.to_list()

    evens_doubled =
        [1, 2, 3, 4, 5]
        |> Iter.map(fn x ->
            if x % 2 != 0 then continue
            x * 2
        end)
        |> Iter.to_list()

    assert taken == [10, 20, 30]
    assert taken_with_value == [10, 20, 999]
    assert evens_doubled == [4, 8]
end

test "filter supports break values"
    first_few_evens =
        [1, 2, 3, 4, 5, 6, 7, 8]
        |> Iter.filter(fn x ->
            if x > 5 then break
            x % 2 == 0
        end)
        |> Iter.to_list()

    include_until =
        [1, 2, 3, 4, 5]
        |> Iter.filter(fn x ->
            if x == 3 then break True
            x % 2 == 0
        end)
        |> Iter.to_list()

    exclude_last =
        [1, 2, 3, 4, 5]
        |> Iter.filter(fn x ->
            if x == 3 then break False
            x % 2 != 0
        end)
        |> Iter.to_list()

    assert first_few_evens == [2, 4]
    assert include_until == [2, 3]
    assert exclude_last == [1]
end

test "find returns Maybe values"
    found =
        [1, 2, 3, 4, 5]
        |> Iter.find(&(&1 == 3))

    not_found =
        [1, 2, 3]
        |> Iter.find(&(&1 > 10))

    assert found == Some(3)
    assert not_found == None
end

test "each accepts break continue and return in callbacks"
    stop_at_sentinel =
        ["hello", "world", "STOP", "ignored"]
        |> Iter.each(fn s ->
            if s == "STOP" then
                break
            end
        end)

    skip_even =
        [1, 2, 3, 4, 5]
        |> Iter.each(fn x ->
            if x % 2 == 0 then
                continue
            end
        end)

    return_from_callback =
        [1, 2, 3]
        |> Iter.each(fn x ->
            if x == 2 then return
            _ = x + 1
        end)

    assert stop_at_sentinel == Unit
    assert skip_even == Unit
    assert return_from_callback == Unit
end

test "return inside iter callbacks is lambda scoped"
    special_mapped =
        [1, 2, 3, 4, 5]
        |> Iter.map(fn x ->
            if x == 3 then return 300
            x * 10
        end)
        |> Iter.to_list()

    fn classify(n: Int) -> Int
        if n < 0 then return 0
        if n > 100 then return 100
        n
    end

    sum_classified =
        [5, -10, 50, 200, 30]
        |> Iter.reduce(0, fn acc, x -> acc + classify(x))

    assert special_mapped == [10, 20, 300, 40, 50]
    assert sum_classified == 185
end

test "reduce with a pattern seed supports continue"
    kept =
        [1, 2, 3]
        |> Iter.reduce((0, []), fn (n, xs), x ->
            if x == 2 then continue
            (n + x, xs + [x])
        end)

    assert kept == (4, [1, 3])
end

fn checked_score(n: Int) -> Int
    if n < 0 then continue
    if n > 100 then break n
    n * 2
end

fn add_checked(acc: Int, n: Int) -> Int
    if n < 0 then continue
    acc + n
end

test "an iter-sensitive function is passed as the callback itself"
    doubled =
        [3, -1, 4, 500, 6]
        |> Iter.map(checked_score)
        |> Iter.to_list()

    total =
        [3, -1, 4]
        |> Iter.reduce(0, add_checked)

    assert doubled == [6, 8, 500]
    assert total == 7
end
