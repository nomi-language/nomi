test "take drop and take_while materialize expected values" {
    assert Iter.take([1, 2, 3, 4], 2)
        |> Iter.to_list()
        |> List.equal?([1, 2])

    assert Iter.drop([1, 2, 3, 4], 2)
        |> Iter.to_list()
        |> List.equal?([3, 4])

    assert Iter.take_while([1, 2, 3, 4, 5], |x| x < 4)
        |> Iter.to_list()
        |> List.equal?([1, 2, 3])
}

test "take_while callbacks can continue or break with keep decisions" {
    skipped =
        Iter.take_while([1, 2, 3, 4, 5], |x|
            if x == 2 {
                continue
            } else {
                x < 4
            }
        )
        |> Iter.to_list()

    kept_then_stopped =
        Iter.take_while([1, 2, 3, 4, 5], |x|
            if x == 2 {
                break True
            } else {
                x < 4
            }
        )
        |> Iter.to_list()

    stopped_without_taking =
        Iter.take_while([1, 2, 3, 4, 5], |x|
            if x == 2 {
                break False
            } else {
                x < 4
            }
        )
        |> Iter.to_list()

    assert skipped == [1, 3]
    assert kept_then_stopped == [1, 2]
    assert stopped_without_taking == [1]
}

test "filter break values decide whether to keep the current element" {
    keep_then_stop =
        Iter.filter([1, 2, 3, 4], |x|
            if x == 3 {
                break True
            } else {
                x > 1
            }
        )
        |> Iter.to_list()

    drop_then_stop =
        Iter.filter([1, 2, 3, 4], |x|
            if x == 3 {
                break False
            } else {
                x > 1
            }
        )
        |> Iter.to_list()

    stop_without_decision =
        Iter.filter([1, 2, 3, 4], |x|
            if x == 3 {
                break
            } else {
                x > 1
            }
        )
        |> Iter.to_list()

    assert keep_then_stop == [2, 3]
    assert drop_then_stop == [2]
    assert stop_without_decision == [2]
}
