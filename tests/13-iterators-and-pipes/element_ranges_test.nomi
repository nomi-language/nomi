import std::compiler

// A callback a std Iter function calls with a source's elements takes their
// range: every element of `1..=n` is 1 or more, so `%` and `/` take it as a
// divisor with no check.
fn divisors(n: PositiveInt) -> List<Int>
    1..=n |> Iter.filter(fn d -> n % d == 0) |> Iter.to_list()
end

fn bits(byte: Int) -> List<Int>
    Iter.map(0..8, &(byte >>> (7 - &1) &&& 1)) |> Iter.to_list()
end

fn is_prime(number: Int) -> Bool
    number > 1
        and Iter.from(2)
        |> Iter.take_while(fn d -> d * d <= number)
        |> Iter.all_match(fn d -> number % d != 0)
end

fn half(n: Int, by: PositiveInt) -> Int
    n / by
end

test "a range's elements divide"
    assert divisors(12) == [1, 2, 3, 4, 6, 12]
    assert bits(5) == [0, 0, 0, 0, 0, 1, 0, 1]
    assert Iter.filter(2..=20, is_prime) |> Iter.to_list() == [2, 3, 5, 7, 11, 13, 17, 19]
end

test "the fact passes through adapters and into captures"
    assert 0..4 |> Iter.map(&(&1 + 1)) |> Iter.map(&half(12, &1)) |> Iter.to_list() == [12, 6, 4, 3]
    assert [3, 5, 7] |> Iter.filter(&(105 % &1 == 0)) |> Iter.count() == 3
    assert Iter.with_index(1..=3) |> Iter.map(fn (i, d) -> i + 6 / d) |> Iter.to_list() == [6, 4, 4]
end

test "an element that may be zero is refused"
    from_zero =
        """
        fn f(n: Int) -> List<Int>
          0..=n |> Iter.filter(fn d -> n % d == 0) |> Iter.to_list()
        end
        """
        |> compiler.check()

    assert [d] = from_zero
    assert "`%` divides by a NonZeroInt; `d` is an Int" in d.message
end
