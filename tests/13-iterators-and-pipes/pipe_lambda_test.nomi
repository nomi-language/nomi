test "then stages apply a lambda to the previous value" {
    doubled =
        21
        |> then fn n -> n * 2

    assert doubled == 42
}

test "then stages compose with regular pipe stages" {
    value =
        10
        |> then fn n -> n + 5
        |> then fn n -> n * 2

    assert value == 30
}

test "a then stage's braced body holds its own pipe" {
    count =
        [1, 2, 3, 4]
        |> then fn xs -> { xs |> Iter.filter(fn x -> x > 2) |> Iter.count() }
        |> then fn n -> n * 10

    assert count == 20
}

test "a then stage destructures its parameter" {
    sum =
        #(3, 4)
        |> then fn #(a, b) -> a + b

    assert sum == 7
}

test "a lambda's body runs past a pipe inside call parentheses" {
    numbers =
        ["1", "x", "3"]
        |> Iter.map(fn s -> String.to_int(s) |> Maybe.with_default(0))
        |> Iter.to_list()

    assert numbers == [1, 0, 3]
}
