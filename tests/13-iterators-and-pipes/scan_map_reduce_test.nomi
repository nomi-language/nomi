test "scan yields each state after the seed" {
    running = [3, 1, 4] |> Iter.scan(0, fn total, x -> total + x) |> Iter.to_list()
    peaks = [2, 5, 3, 7] |> Iter.scan(0, fn peak, x -> Int.max(peak, x)) |> Iter.to_list()
    words = ["a", "b", "c"] |> Iter.scan("", fn text, s -> text + s) |> Iter.to_list()

    assert running == [3, 4, 8]
    assert peaks == [2, 5, 5, 7]
    assert words == ["a", "ab", "abc"]
}

test "scan over an empty source yields nothing" {
    none: List<Int> = []

    assert none |> Iter.scan(100, fn total, x -> total + x) |> Iter.to_list() == []
}

test "scan is lazy" {
    // An unbounded source ends because `take` stops the scan after three.
    triangular =
        Iter.from(1)
        |> Iter.scan(0, fn total, x -> total + x)
        |> Iter.take(3)
        |> Iter.to_list()

    // A stop in the callback past the third element is never reached.
    first_three =
        [1, 2, 3, 4, 5]
        |> Iter.scan(0, fn total, x -> {
            if x > 3 { break -1 }
            total + x
        })
        |> Iter.take(3)
        |> Iter.to_list()

    assert triangular == [1, 3, 6]
    assert first_three == [1, 3, 6]
}

test "a scan replays from its seed" {
    running = [1, 2, 3] |> Iter.scan(0, fn total, x -> total + x)

    assert Iter.to_list(running) == [1, 3, 6]
    assert Iter.to_list(running) == [1, 3, 6]
}

test "scan supports break and continue" {
    skipped =
        [1, -2, 3, -4, 5]
        |> Iter.scan(0, fn total, x -> {
            if x < 0 { continue }
            total + x
        })
        |> Iter.to_list()

    last_value =
        [10, 20, 30, 40]
        |> Iter.scan(0, fn total, x -> {
            if total + x > 50 { break total * 100 }
            total + x
        })
        |> Iter.to_list()

    stopped =
        [10, 20, 30, 40]
        |> Iter.scan(0, fn total, x -> {
            if total + x > 50 { break }
            total + x
        })
        |> Iter.to_list()

    assert skipped == [1, 4, 9]
    assert last_value == [10, 30, 3000]
    assert stopped == [10, 30]
}

test "map_reduce answers the final state and the outputs" {
    #(total, labels) =
        ["a", "bb", "c"]
        |> Iter.map_reduce(0, fn offset, word -> {
            #(offset + String.length(word), "${offset}:${word}")
        })

    #(width, rows) =
        ["a", "abc", "ab"]
        |> Iter.reverse()
        |> Iter.map_reduce(0, fn width, line -> {
            width = Int.max(width, String.length(line))
            #(width, String.pad_end(line, width))
        })

    assert labels == ["0:a", "1:bb", "3:c"]
    assert total == 4
    assert rows == ["ab", "abc", "a  "]
    assert width == 3
}

test "map_reduce over an empty source answers the seed and no outputs" {
    none: List<String> = []

    assert Iter.map_reduce(none, 7, fn count, s -> #(count + 1, s)) == #(7, [])
}

test "map_reduce supports break and continue" {
    #(sum, kept) =
        [1, -2, 3, -4, 5]
        |> Iter.map_reduce(0, fn total, x -> {
            if x < 0 { continue }
            #(total + x, x * 10)
        })

    #(last, until_big) =
        [10, 20, 30, 40]
        |> Iter.map_reduce(0, fn total, x -> {
            if total + x > 50 { break #(-1, x) }
            #(total + x, x)
        })

    #(so_far, before) =
        [10, 20, 30, 40]
        |> Iter.map_reduce(0, fn total, x -> {
            if total + x > 50 { break }
            #(total + x, x)
        })

    assert kept == [10, 30, 50]
    assert sum == 9
    assert until_big == [10, 20, 30]
    assert last == -1
    assert before == [10, 20]
    assert so_far == 30
}
