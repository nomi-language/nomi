import
    std::comparable.Direction
    std::duration.Duration
end

struct Row
    name: String
    tags: List<String>
end

fn row(name: String, tags: List<String>) -> Row
    Row{name:, tags:}
end

fn names(rows: List<Row>) -> List<String>
    rows |> Iter.map(.name) |> Iter.to_list()
end

test "sort_by takes a container key"
    rows = [row("b", ["z"]), row("a", ["y", "x"])]
    by_tags = Iter.sort_by(rows, .tags)

    assert names(by_tags) == ["a", "b"]
    assert Iter.sort_by([[3, 1], [2]], fn l -> l) == [[2], [3, 1]]
    assert Iter.sort_by(["bb", "a"], fn s -> Vector[s]) == ["a", "bb"]
    assert Iter.sort_by(Set[3, 1], fn n -> [n]) == [1, 3]
    assert Iter.sort_by([2, 1], Direction.Descending, fn n -> [[n]]) == [2, 1]
end

test "sort_by takes a scalar key of any ordered type"
    assert Iter.sort_by([3, 1, 2], fn n -> Int.to_float(0 - n)) == [3, 2, 1]
    assert Iter.sort_by([1, 2, 3], &(&1 != 2)) == [2, 1, 3]
    assert Iter.sort_by([3, 1, 2], fn n -> Int.to_decimal(0 - n)) == [3, 2, 1]
end

test "sort and sort_by take a std type's own compare"
    one = Duration.seconds(1)
    two = Duration.seconds(2)

    assert Iter.sort_by([2, 1], &Duration.seconds(&1)) == [1, 2]
    assert Iter.sort([two, one]) == [one, two]
end

test "positional terminals answer a declared element type"
    a = row("a", [])
    b = row("b", ["t"])
    rows = [a, b]

    assert Iter.first(rows) == Some(a)
    assert Iter.last(rows) == Some(b)
    assert Iter.get(rows, 1) == Some(b)
    assert Iter.find(rows, fn r -> r.tags == ["t"]) == Some(b)
end
