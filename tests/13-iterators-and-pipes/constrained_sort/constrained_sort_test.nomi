import {
    std/comparable.Direction
    named_widget.{self, NamedWidget}
    sort_widget.{self, SortWidget}
}

fn sort_widget_weights(ws: List<SortWidget>): List<Int> {
    ws
    |> Iter.sort()
    |> Iter.map(.weight)
    |> Iter.to_list()
}

fn named_widget_names(ws: List<NamedWidget>): List<String> {
    ws
    |> Iter.map(.name)
    |> Iter.to_list()
}

test "sort records Comparable demands for imported element impls" {
    ws = [sort_widget.make(3), sort_widget.make(1), sort_widget.make(2)]

    assert sort_widget_weights(ws) == [1, 2, 3]

    assert ws
        |> Iter.sort()
        |> Iter.map(.weight)
        |> Iter.to_list()
        |> List.equal?([1, 2, 3])
}

test "sort_by records Comparable demands for imported key impls" {
    ws = [named_widget.make("c", 3), named_widget.make("a", 1), named_widget.make("b", 2)]

    direct =
        Iter.sort_by(ws, .weight)
        |> named_widget_names()

    piped =
        ws
        |> Iter.sort_by(.weight)
        |> named_widget_names()

    explicit_desc =
        Iter.sort_by(ws, Direction.Descending, .weight)
        |> named_widget_names()

    assert direct == ["a", "b", "c"]
    assert piped == ["a", "b", "c"]
    assert explicit_desc == ["c", "b", "a"]
}
