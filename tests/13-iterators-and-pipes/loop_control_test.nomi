import std::iter.Iter.loop

test "loop advances state through callback return values"
    result = loop(1, fn n ->
        if n % 3 != 0 then return n + 1
        break n
    end)

    (_, steps) = loop((27, 0), fn state ->
        (n, count) = state
        if n == 1 then break state

        if n % 2 == 0 then
            (n / 2, count + 1)
        else
            (n * 3 + 1, count + 1)
        end
    end)

    assert result == 3
    assert steps == 111
end

test "bare loop break returns Unit"
    assert loop(fn ->
        break
    end) == Unit
end

test "loop break value returns the break value"
    countdown = loop(5, fn n ->
        if n == 0 then break n
        n - 1
    end)

    fib = loop((0, 1), fn state ->
        (a, b) = state
        if b > 100 then break (a, b)
        (b, a + b)
    end)

    assert countdown == 0
    assert fib == (89, 144)
end

test "a loop answers a break value computed from its state"
    answer = loop(40, fn n ->
        break n + 2
    end)

    assert answer == 42
end

test "a generic seed pins the loop state type"
    assert first(7) == 7
    assert first("value") == "value"
end

fn first<T>(x: T) -> T
    loop(x, fn v ->
        break v
    end)
end
