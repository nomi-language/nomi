test "iter constructors produce lazy values that can be bounded" {
    assert Iter.from(0)
        |> Iter.take(5)
        |> Iter.to_list()
        |> List.equal?([0, 1, 2, 3, 4])

    assert Iter.iterate(1, |x| x * 2)
        |> Iter.take(6)
        |> Iter.to_list()
        |> List.equal?([1, 2, 4, 8, 16, 32])

    repeated =
        Iter.repeat("ab")
        |> Iter.take(3)
        |> String.join()

    assert repeated == "ababab"
}

test "iter terminals inspect positions and size" {
    xs = [1, 2, 3, 4, 5]

    assert Iter.at(xs, 2) == Some(3)
    assert Iter.first(xs) == Some(1)
    assert Iter.last(xs) == Some(5)
    assert Iter.count(xs) == 5
    assert Iter.empty?([])
    refute Iter.empty?(xs)
    assert Iter.not_empty?(xs)
}

test "lazy adapters fuse over bounded infinite sources" {
    assert Iter.from(1)
        |> Iter.map(|x| x * 2)
        |> Iter.filter(|x| x > 4)
        |> Iter.take(3)
        |> Iter.to_list()
        |> List.equal?([6, 8, 10])
}

test "drop take and while adapters preserve order" {
    assert [1, 2, 3, 4, 5]
        |> Iter.drop(2)
        |> Iter.to_list()
        |> List.equal?([3, 4, 5])

    assert Iter.from(0)
        |> Iter.drop_while(|x| x < 3)
        |> Iter.take_while(|x| x < 8)
        |> Iter.to_list()
        |> List.equal?([3, 4, 5, 6, 7])

    assert [1, 2, 3, 4, 5]
        |> Iter.take(3)
        |> Iter.to_list()
        |> List.equal?([1, 2, 3])

    assert [1, 2, 3, 4, 1]
        |> Iter.take_while(|x| x < 3)
        |> Iter.to_list()
        |> List.equal?([1, 2])

    assert [1, 2, 3, 4, 1]
        |> Iter.drop_while(|x| x < 3)
        |> Iter.to_list()
        |> List.equal?([3, 4, 1])
}

test "cycle concat and with_index materialize expected sequences" {
    assert [1, 2, 3]
        |> Iter.cycle()
        |> Iter.take(7)
        |> Iter.to_list()
        |> List.equal?([1, 2, 3, 1, 2, 3, 1])

    assert [1, 2]
        |> Iter.concat([3, 4])
        |> Iter.to_list()
        |> List.equal?([1, 2, 3, 4])

    assert ["a", "b", "c"]
        |> Iter.with_index()
        |> Iter.to_list()
        |> List.equal?([(0, "a"), (1, "b"), (2, "c")])
}

test "zip pairs values and stops at the shorter input" {
    assert [1, 2, 3]
        |> Iter.zip(["x", "y", "z"])
        |> Iter.to_list()
        |> List.equal?([(1, "x"), (2, "y"), (3, "z")])

    assert [1, 2, 3]
        |> Iter.zip(["a", "b"])
        |> Iter.to_list()
        |> List.equal?([(1, "a"), (2, "b")])
}

test "iter mapping filtering flat mapping and reducing work over lists" {
    assert [1, 2, 3]
        |> Iter.map(|x| x * 2)
        |> Iter.to_list()
        |> List.equal?([2, 4, 6])

    assert [1, 2, 3, 4, 5]
        |> Iter.filter(|x| x > 3)
        |> Iter.to_list()
        |> List.equal?([4, 5])

    assert [1, 2, 3]
        |> Iter.flat_map(|x| [x, x * 10])
        |> Iter.to_list()
        |> List.equal?([1, 10, 2, 20, 3, 30])

    total =
        [1, 2, 3, 4]
        |> Iter.reduce(|acc = 0, x| acc + x)

    assert total == 10
}

test "iter search predicates short circuit" {
    found =
        Iter.from(0)
        |> Iter.find(|x| x > 100)

    assert found == Some(101)

    assert Iter.from(0)
        |> Iter.any?(|x| x == 50)

    assert [2, 4, 6]
        |> Iter.all?(|x| x % 2 == 0)

    refute [2, 3, 4]
        |> Iter.all?(|x| x % 2 == 0)
}

test "iter flattening materializes nested lists" {
    assert [[1, 2], [3, 4]]
        |> Iter.flatten()
        |> List.equal?([1, 2, 3, 4])
}

test "iter chunking groups adjacent values" {
    assert [1, 2, 3, 4, 5]
        |> Iter.chunks(2)
        |> Iter.to_list()
        |> List.equal?([[1, 2], [3, 4], [5]])

    assert [1, 2, 3]
        |> Iter.chunks(0)
        |> Iter.to_list()
        |> List.equal?([])

    assert []
        |> Iter.chunks(2)
        |> Iter.to_list()
        |> List.equal?([])

    assert [1, 1, 2, 2, 1, 3]
        |> Iter.chunk_by(|x| x)
        |> Iter.to_list()
        |> List.equal?([[1, 1], [2, 2], [1], [3]])

    assert ["ant", "ape", "bee", "bat", "cat"]
        |> Iter.chunk_by(|s| String.contains?(s, "a"))
        |> Iter.to_list()
        |> List.equal?([["ant", "ape"], ["bee"], ["bat", "cat"]])
}

test "iter materializers collect to maps strings and sorted lists" {
    pairs =
        [("a", 1), ("b", 2)]
        |> Iter.to_map()

    sorted =
        [3, 1, 2]
        |> Iter.sort()

    custom_sorted =
        [3, 1, 2]
        |> Iter.sort_with(|a, b| Int.compare(a, b))

    lazy_sorted =
        Iter.map([3, 1, 2], |x| x * 2)
        |> Iter.sort_with(|a, b| Int.compare(a, b))

    assert Map.get(pairs, "a") == Some(1)
    assert Map.get(pairs, "b") == Some(2)
    assert sorted == [1, 2, 3]
    assert custom_sorted == [1, 2, 3]
    assert lazy_sorted == [2, 4, 6]
}

test "iter partition and group_by collect list values" {
    split =
        [1, 2, 3, 4, 5]
        |> Iter.partition(|x| x % 2 == 0)

    grouped =
        [1, 2, 3, 4, 5, 6]
        |> Iter.group_by(|x| x % 2)

    assert split == ([2, 4], [1, 3, 5])
    assert Map.get(grouped, 1) == Some([1, 3, 5])
    assert Map.get(grouped, 0) == Some([2, 4, 6])
}

test "iter pipelines can combine lazy adapters and terminals" {
    total =
        [1, 2, 3, 4, 5]
        |> Iter.filter(|x| x > 2)
        |> Iter.map(|x| x * 10)
        |> Iter.reduce(|acc = 0, x| acc + x)

    assert total == 120
}

test "iter loop supports explicit state and break values" {
    countdown = Iter.loop(|n = 5|
        if n == 0 {
            break n
        } else {
            n - 1
        }
    )

    assert countdown == 0
}

test "iterators are replayable values" {
    x = [1, 2, 3, 4, 5] |> Iter.filter(|x| x > 2)

    assert Iter.to_list(x) == [3, 4, 5]
    assert Iter.to_list(x) == [3, 4, 5]
}

/// A tree, so `each_while` has to walk a shape no built-in source has: the
/// implementor drives its own recursion and threads the consumer's stop
/// decision back out through it.
enum Tree {
    Leaf
    Node (Tree, Int, Tree)
}

impl Iter for Tree {
    fn each_while(t: Tree, yield: (Int) -> Bool): Bool {
        case t {
            .Leaf ->
                True

            .Node(left, value, right) ->
                if each_while(left, yield) {
                    if yield(value) {
                        each_while(right, yield)
                    } else {
                        False
                    }
                } else {
                    False
                }
        }
    }
}

fn leaf_node(value: Int): Tree {
    Tree.Node(Tree.Leaf, value, Tree.Leaf)
}

test "a custom type implements Iter by pushing its own elements" {
    tree = Tree.Node(Tree.Node(leaf_node(1), 2, leaf_node(3)), 4, leaf_node(5))

    // Every generic adapter and terminal works on it with no other conformance.
    assert Iter.to_list(tree) == [1, 2, 3, 4, 5]
    assert tree |> Iter.map(|x| x * 10) |> Iter.to_list() == [10, 20, 30, 40, 50]
    assert Iter.count(tree) == 5
    assert Iter.find(tree, |x| x > 3) == Some(4)

    // `each_while` reports which side ended the walk: True when the source ran
    // out, False when the consumer refused another element.
    assert Iter.each_while(tree, |_x| True)
    refute Iter.each_while(tree, |x| x < 3)
    assert Iter.each_while(Tree.Leaf, |_x| False)
}

test "zip advances two unbounded sources in lockstep" {
    // Neither side can drive the other's loop, so zip pulls its right operand.
    // Both operands unbounded is the case that pins it: a materializing right
    // side would never return, and an abandoned cursor would hang the left.
    assert Iter.from(0)
        |> Iter.zip(Iter.iterate(1, |x| x * 2))
        |> Iter.take(4)
        |> Iter.to_list()
        |> List.equal?([(0, 1), (1, 2), (2, 4), (3, 8)])

    // Stopping after one pair must not strand the pulled side.
    assert Iter.zip(Iter.from(0), Iter.from(100)) |> Iter.first() == Some((0, 100))

    // An unbounded left with a finite right still stops at the right's end.
    assert Iter.from(0)
        |> Iter.zip(["a", "b"])
        |> Iter.to_list()
        |> List.equal?([(0, "a"), (1, "b")])
}

test "a range pushes a long run without exhausting the stack" {
    // Range walks itself by recursing per element, so a long drive is only
    // stack-safe because the recursive `each_while` call is in tail position.
    assert Iter.count(1..=200_000) == 200_000

    assert 1..=200_000
    |> Iter.map(|x| x)
    |> Iter.reduce(|acc = 0, x| acc + x) == 20_000_100_000
}
