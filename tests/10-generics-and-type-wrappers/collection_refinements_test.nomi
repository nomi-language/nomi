// A refinement of a collection or a String is its base at run time, so
// every operation on the base works on a refined value as on the base.
type Pair List<Int> when fn xs -> List.length(xs) == 2

type Scores Map<String, Int> when fn m -> Map.size(m) > 0

type Word String when fn s -> String.length(s) > 0 and not String.contains(s, " ")

type Row Vector<Int> when fn v -> Vector.length(v) == 3

type Tags Set<String> when fn s -> Set.size(s) > 0

type SmallPair Pair when fn xs -> Iter.all_match(xs, &(&1 < 10))

type OneScore Scores when fn m -> Map.size(m) == 1

fn total(xs: List<Int>) -> Int
    Iter.sum(xs)
end

fn names(m: Map<String, Int>) -> List<String>
    m |> Map.keys() |> Iter.sort() |> Iter.to_list()
end

fn shout(s: String) -> String
    String.uppercase(s)
end

fn width(v: Vector<Int>) -> Int
    Vector.length(v)
end

fn sum_of(xs: Iter<Int>) -> Int
    Iter.sum(xs)
end

fn sum_bound<C>(c: C) -> Int where C: Iter<Int>
    Iter.sum(c)
end

test "a List refinement iterates, matches and passes as its List"
    p: Pair = [3, 4]
    assert Iter.sum(p) == 7
    assert p |> Iter.map(&(&1 * 10)) |> Iter.to_list() == [30, 40]
    assert p |> Iter.filter(&(&1 > 3)) |> Iter.count() == 1
    assert Iter.reduce(p, 1, fn acc, x -> acc * x) == 12
    assert List.length(p) == 2
    assert List.head(p) == Some(3)
    assert total(p) == 7
    assert 4 in p
    refute 5 in p
    assert p == [3, 4]
    assert Debug.inspect(p) == "[3, 4]"
    assert [..p, 5] == [3, 4, 5]

    case p
        [a, b] -> assert a + b == 7
        _      -> assert False
    end
end

test "a Map refinement iterates, looks up and passes as its Map"
    s: Scores = {"ann" => 3, "bo" => 5}
    assert s |> Iter.map(.second) |> Iter.sum() == 8
    assert Iter.count(s) == 2
    assert Map.get(s, "bo") == Some(5)
    assert Map.size(s) == 2
    assert names(s) == ["ann", "bo"]
    assert "ann" in s
    refute "cy" in s
    assert s == {"ann" => 3, "bo" => 5}
    assert Debug.inspect(s) == "{\"ann\" => 3, \"bo\" => 5}"
    assert {..s, "cy" => 1} |> Map.size() == 3
    shown: Display = s
    assert "${shown}" == "${s}"
end

test "a String refinement iterates, calls String and passes as its String"
    w: Word = "abc"
    assert w |> Iter.map(String.uppercase) |> String.join("-") == "A-B-C"
    assert Iter.count(w) == 3
    assert String.length(w) == 3
    assert shout(w) == "ABC"
    assert "b" in w
    assert w == "abc"
    assert Debug.inspect(w) == "\"abc\""
    assert "${w}!" == "abc!"
end

test "a Vector refinement iterates, calls Vector and passes as its Vector"
    r: Row = [1, 2, 3]
    assert Iter.sum(r) == 6
    assert r |> Iter.map(&(&1 + 1)) |> Iter.to_vector() == Vector[2, 3, 4]
    assert Vector.length(r) == 3
    assert width(r) == 3
    assert 2 in r
    assert r == Vector[1, 2, 3]
    assert Debug.inspect(r) == "Vector[1, 2, 3]"

    case r
        [first, ..rest] -> assert first + Iter.sum(rest) == 6
        _               -> assert False
    end
end

test "a Set refinement iterates and spreads as its Set"
    t: Tags = ["a", "b"]
    assert Iter.count(t) == 2
    assert "a" in t
    assert Set[..t, "c"] |> Set.size() == 3
    assert t |> Iter.sort() |> String.join(",") == "a,b"
end

test "a refinement passes where an Iter is expected"
    p: Pair = [3, 4]
    assert sum_of(p) == 7
    assert sum_bound(p) == 7
    pairs: List<Pair> = [[1, 2], [3, 4]]
    assert pairs |> Iter.flat_map(fn q -> q) |> Iter.sum() == 10
    assert pairs |> Iter.map(&Iter.sum(&1)) |> Iter.to_list() == [3, 7]
    assert p |> Iter.zip([5, 6]) |> Iter.to_list() == [(3, 5), (4, 6)]
    shown: List<Display> = [p]
    assert "${List.head(shown)}" == "Some([3, 4])"
end

test "a literal builds a refinement of a refined collection, and its call form takes one"
    small: SmallPair = [1, 2]
    assert Iter.sum(small) == 3
    one: OneScore = {"a" => 1}
    assert Iter.count(one) == 1
    assert Pair([5, 6]) |> Iter.sum() == 11
    assert Scores({"x" => 2}) |> Map.get("x") == Some(2)
end

test "a value made by try_from iterates as its base"
    case Pair.try_from([1, 2])
        Some(p) -> assert Iter.sum(p) == 3
        None    -> assert False
    end
end
