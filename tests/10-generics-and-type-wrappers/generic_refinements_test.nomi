// A generic refinement's rule holds at every instance, its literals are
// checked at their type arguments, and its values convert as its parents'
// do.
refine Many<T> List<T> when fn xs -> not Iter.is_empty(xs)

refine Ascending<T> List<T> where T: Comparable when fn xs ->
    Iter.zip(xs, Iter.drop(xs, 1)) |> Iter.all_match(fn (a, b) -> a <= b)
end

refine Run<T> Many<T> and Ascending<T> where T: Comparable when fn xs -> List.length(xs) <= 4

refine Filled<K, V> Map<K, V> when fn m -> Map.size(m) > 0

refine IntPair List<Int> when fn xs -> List.length(xs) == 2

interface Shape
    fn area(shape: self) -> Float
end

struct Square
    side: Float
end

impl Shape for Square
    fn area(s: Square) -> Float
        s.side * s.side
    end
end

impl Many<T>
    fn head<T>(xs: Many<T>) -> T
        List.first(xs)!
    end
end

fn total_area(shapes: Many<Shape>) -> Float
    shapes |> Iter.map(fn s -> Shape.area(s)) |> Iter.sum()
end

fn largest<T>(xs: Ascending<T>) -> Option<T> where T: Comparable
    Iter.last(xs)
end

fn widen(xs: Many<PositiveInt>) -> Many<Int>
    xs
end

test "literals are checked at their type arguments"
    names: Many<String> = ["ada", "bo"]
    run: Run<Int> = [1, 2, 5]
    pair: IntPair = [3, 4]
    ages: Filled<String, Int> = {"ada" => 36}

    assert Many.head(names) == "ada"
    assert Iter.sum(run) == 8
    assert List.length(pair) == 2
    assert Map.get(ages, "ada") == Some(36)
end

test "try_from checks every rule at its type arguments"
    empty: List<String> = []

    assert Many.try_from(["x"]) == Some(["x"])
    assert Many.try_from(empty) == None
    assert Ascending.try_from(["a", "b"]) == Some(["a", "b"])
    assert Ascending.try_from([2, 1]) == None
    assert Run.try_from([1, 2]) == Some([1, 2])
    assert Run.try_from([2, 1]) == None
    assert Run.try_from([1, 2, 3, 4, 5]) == None
    assert Filled.try_from({"a" => 1.5}) == Some({"a" => 1.5})
end

test "values convert as their parents do"
    squares: Many<Square> = Many.try_from([Square{side: 2.0}, Square{side: 1.0}])!
    run: Run<Int> = [1, 4]
    positives: Many<PositiveInt> = [3, 4]

    assert total_area(squares) == 5.0
    assert largest(run) == Some(4)
    assert widen(positives) == [3, 4]

    joined =
        if Iter.count(run) > 1 then
            run
        else
            Ascending.try_from([7])!
        end

    assert largest(joined) == Some(4)
end
