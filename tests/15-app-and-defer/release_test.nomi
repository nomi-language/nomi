// A type of the program's own that implements Release and Commit. The checker
// holds a function that acquires one to a deferred release, and a deferred
// discard to a commit on each path that returns normally (spec §9 *Releasing
// resources*).
import std::io

struct Draft
    name: String
end

impl Release for Draft
    fn release(d: Draft)
        Draft.discard(d)
    end
end

impl Commit for Draft
    fn commit(d: Draft) -> Result<Unit, String>
        Draft.publish(d)
    end
end

impl Draft
    fn open(name: String) -> Result<Draft, String>
        if name == "" then return Err("no name")
        io.print("open ${name}")
        Ok(Draft{name:})
    end

    fn discard(d: Draft)
        io.print("discard ${d.name}")
    end

    fn publish(d: Draft) -> Result<Unit, String>
        io.print("publish ${d.name}")
        Ok(Unit)
    end
end

fn save(name: String, fail: Bool) -> Result<Unit, String>
    d = Draft.open(name)?
    defer Draft.discard(d)

    if fail then return Err("failed")
    Draft.publish(d)?
    Ok(Unit)
end

fn opened(name: String) -> Result<Draft, String>
    d = Draft.open(name)?
    Ok(d)
end

test "the deferred discard runs however the function ends, after the publish"
    saved = io.capture("", fn -> save("a", False))
    assert saved.value == Ok(Unit)
    assert saved.output == "open a\npublish a\ndiscard a\n"

    failed = io.capture("", fn -> save("b", True))
    assert failed.value == Err("failed")
    assert failed.output == "open b\ndiscard b\n"
end

test "a draft handed on is released by the caller"
    ran = io.capture("", fn ->
        d = opened("c")?
        defer Draft.discard(d)
        Draft.publish(d)
    end)

    assert ran.value == Ok(Unit)
    assert ran.output == "open c\npublish c\ndiscard c\n"
end

test "an open that fails acquires nothing"
    assert save("", False) == Err("no name")
end

// A call that returns a Draft outside a Result acquires one too, so the
// caller defers its release.
fn scratch(name: String) -> Draft
    io.print("open ${name}")
    Draft{name:}
end

test "a draft returned directly is released by the caller"
    ran = io.capture("", fn ->
        d = scratch("d")
        defer Draft.discard(d)
        Draft.publish(d)
    end)

    assert ran.value == Ok(Unit)
    assert ran.output == "open d\npublish d\ndiscard d\n"
end
