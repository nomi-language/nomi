// Console implementations. The Console interface itself lives in
// effects.nomi.
import {
    std/io
    effects.Console
}

// StdConsole writes through io.print to actual stdout. EffectsApp stores it
// behind `console: Console`; callers read the active console as
// `EffectsApp.console`.
pub type StdConsole

impl Console for StdConsole {
    fn writeln(_value: StdConsole, msg: String): Unit {
        io.print(msg)
    }
}
