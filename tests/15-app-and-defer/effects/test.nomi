import {
    // test app wiring. Tweaks data-field defaults and uses TaggedLogger so output
    // is visibly tagged.
    app.EffectsApp
    clocks.FakeClock
    console.StdConsole
    log.TaggedLogger
}

pub fn build(context: Context): EffectsApp {
    EffectsApp{
        context,
        deployment: "test",
        database_url: "postgres://localhost/myapp_test",
        max_connections: 2,
        logger: TaggedLogger{tag: "test"},
        clock: FakeClock{at: 0},
        console: StdConsole,
    }
}
