import {
    // Production app wiring. Overrides data-field defaults
    // that matter at deploy time and supplies the production dependency
    // handlers (ProdLogger, SystemClock, StdConsole).
    app.EffectsApp
    clocks.SystemClock
    console.StdConsole
    log.ProdLogger
}

pub fn build(context: Context): EffectsApp {
    EffectsApp{
        context,
        deployment: "prod",
        port: 8080,
        database_url: "postgres://prod-host/myapp",
        max_connections: 20,
        logger: ProdLogger,
        clock: SystemClock,
        console: StdConsole,
    }
}
