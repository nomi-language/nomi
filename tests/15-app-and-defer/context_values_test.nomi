type TraceId String

type Marker

test "context values are keyed by their Nomi type"
    root = Context.root()

    // A fresh root has no TraceId.
    assert Context.value(root, TraceId) == None

    // `with_value` returns a child context; the stored value keeps its domain
    // type instead of becoming a raw String.
    traced = Context.with_value(root, TraceId("trace-123"))

    assert case Context.value(traced, TraceId)
        Some(TraceId(id)) -> id == "trace-123"
        None -> False
    end

    // Storing another TraceId shadows the parent value for the child only.
    shadowed = Context.with_value(traced, TraceId("trace-456"))

    assert case Context.value(shadowed, TraceId)
        Some(TraceId(id)) -> id == "trace-456"
        None -> False
    end

    // Parent contexts are immutable; adding values to children does not mutate
    // the original root.
    assert Context.value(root, TraceId) == None
end

fn accepts_marker(marker: Marker) -> Bool
    marker == Marker
end

fn lookup_marker(c: Context, marker_type: Type<Marker>) -> Maybe<Marker>
    Context.value(c, marker_type)
end

test "type witnesses do not replace zero-sized values"
    assert accepts_marker(Marker)

    context = Context.with_value(Context.root(), Marker)
    assert lookup_marker(context, Marker) == Some(Marker)
end

struct Keys
    trace: Type<TraceId>
end

fn trace_key() -> Type<TraceId>
    TraceId
end

test "a witness is a value: a field, an element, a call's result"
    traced = Context.with_value(Context.root(), TraceId("t"))
    keys = Keys{trace: TraceId}
    assert Context.value(traced, keys.trace) == Some(TraceId("t"))
    assert Context.value(traced, trace_key()) == Some(TraceId("t"))
    witnesses: List<Type<TraceId>> = [TraceId]
    assert Context.value(traced, List.head(witnesses)!) == Some(TraceId("t"))
end
