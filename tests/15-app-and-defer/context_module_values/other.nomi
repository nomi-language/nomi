/// A second `Token`, so the sibling test can show that two same-named
/// module-declared types keep separate slots in one Context. Shortening the key
/// to `Token` on both sides would also make `Context.value` find something —
/// and would make these two collide.
pub type Token String

pub fn make(value: String): Token {
    Token(value)
}

/// The round-trip written INSIDE the declaring module, where the spelling and
/// the identity coincide. A third route to the witness resolver, and the one
/// that has to keep agreeing with the two the sibling test exercises.
pub fn stored(c: Context): Maybe<Token> {
    Context.value(c, Token)
}
