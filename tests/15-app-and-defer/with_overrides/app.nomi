// The entry whose boot the tests name. `main` shows one override lasting to
// the end of its block.
import std::io

pub enum Level
    Info
    Debug
end

pub struct App
    context: Context
    level: Level
    label: String
    n: Int
end

pub fn boot() -> Result<App, String>
    Ok(App{context: Context.root(), level: .Info, label: "base", n: 1})
end

fn main()
    begin
        with App.label = "inner"
        io.print(App.label)
    end

    io.print(App.label)
end
