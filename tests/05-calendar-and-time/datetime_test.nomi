import {
    std/calendar.{Hours, Minutes, Nanoseconds, Seconds}
    std/calendar.DateTime
    std/calendar.NaiveDateTime
    std/calendar.OffsetDateTime
    std/duration.Duration
    std/instant.Instant
}

test "zoned datetimes parse and display RFC 9557 bracket form" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`

    assert DateTime.to_string(dt) == "2026-06-15T12:00:00-04:00[America/New_York]"
}

test "zoned datetimes can be built from wall readings and zones" {
    naive = NaiveDateTime`2026-06-15T12:00:00`
    built = DateTime.in_zone(naive, "America/New_York")?
    rendered = DateTime.to_string(built)

    assert rendered == "2026-06-15T12:00:00-04:00[America/New_York]"
}

test "zoned datetime components project through the stored zone" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`

    assert DateTime.year(dt) == 2026
    assert DateTime.month(dt) == 6
    assert DateTime.day(dt) == 15
    assert DateTime.hour(dt) == 12
}

test "zoned datetimes expose their instant and effective offset" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`

    seconds =
        dt
        |> DateTime.to_instant()
        |> Instant.to_seconds()

    assert seconds == 1781539200
    assert DateTime.offset(dt) == Duration.hours(-4)
}

test "zoned datetime equality is instant-only" {
    ny = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`
    paris = DateTime`2026-06-15T18:00:00+02:00[Europe/Paris]`

    assert ny == paris
    assert DateTime.to_string(ny) == "2026-06-15T12:00:00-04:00[America/New_York]"

    assert DateTime.to_string(paris) == "2026-06-15T18:00:00+02:00[Europe/Paris]"
}

test "zoned datetimes can be projected to fixed offset datetimes" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`
    odt = DateTime.to_offset(dt)

    assert OffsetDateTime.to_string(odt) == "2026-06-15T12:00:00-04:00"
}

test "zoned datetimes add durations as physical elapsed time" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`

    assert dt + Duration.hours(2) == DateTime`2026-06-15T14:00:00-04:00[America/New_York]`

    assert dt - Duration.minutes(45) == DateTime`2026-06-15T11:15:00-04:00[America/New_York]`
}

test "zoned datetimes support civil sub-day arithmetic" {
    dt = DateTime`2026-06-15T12:00:00-04:00[America/New_York]`

    assert dt + Hours(2) == DateTime`2026-06-15T14:00:00-04:00[America/New_York]`

    assert dt + Minutes(45) == DateTime`2026-06-15T12:45:00-04:00[America/New_York]`

    assert dt + Seconds(90) == DateTime`2026-06-15T12:01:30-04:00[America/New_York]`

    assert dt + Nanoseconds(500_000_000) == DateTime`2026-06-15T12:00:00.5-04:00[America/New_York]`

    assert dt - Hours(2) == DateTime`2026-06-15T10:00:00-04:00[America/New_York]`
}
