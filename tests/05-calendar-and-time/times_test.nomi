import {
    std/calendar.Error
    std/calendar.Time
    std/duration.Duration
}

test "times parse and expose components" {
    t = Time`09:30:00`

    assert Time.to_string(t) == "09:30:00"
    assert Time.hour(t) == 9
    assert Time.minute(t) == 30
    assert Time.second(t) == 0
}

test "time display preserves meaningful subsecond precision" {
    frac = Time`23:45:12.5`

    assert Time.to_string(frac) == "23:45:12.5"
}

test "times support duration arithmetic with midnight wrapping" {
    base = Time`09:30:00`
    late = Time`23:30:00`
    early = Time`00:30:00`
    morning = Time`11:30:00`
    after_midnight = Time`01:30:00`
    before_midnight = Time`23:30:00`

    assert base + Duration.hours(2) == morning
    assert late + Duration.hours(2) == after_midnight
    assert early + Duration.hours(-1) == before_midnight
    assert base - Duration.minutes(45) == Time`08:45:00`
}

test "time equality uses time of day" {
    a = Time`09:30:00`
    b = Time`09:30:00`

    assert a == b
}

test "times sort chronologically" {
    t1 = Time`09:30:00`
    t2 = Time`08:15:00`
    t3 = Time`10:00:00`

    sorted = Iter.sort([t1, t2, t3])
    assert List.head(sorted) == Some(t2)
}

test "time construction rejects invalid components" {
    assert Err(Error.InvalidValue(_)) = Time.new(25, 0, 0)
}
