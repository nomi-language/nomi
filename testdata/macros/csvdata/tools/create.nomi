// `nomi tool csvdata create <file.csv>...`: write each table that does
// not exist yet with a header and no rows, what the quick fix for a
// missing table runs.
import {
    std/fs
    std/io
}

struct App {
    files: List<String>
}

fn boot(startup: Startup) -> Result<App, String> {
    Ok(#App{files: startup.args})
}

fn main() -> Result<Unit, String> {
    create(App.files)
}

fn create(paths: List<String>) -> Result<Unit, String> {
    case paths {
        [] ->
            Ok(Unit)

        [path, ..rest] -> {
            if fs.exists?(path) == Ok(True) {
                io.print("${path} exists")
            } else {
                written =
                    fs.write_text(path, "key,value\n", mode: .New)
                    |> Result.map_err(fn e -> "${path}: ${e}")

                try written
                io.print("created ${path}")
            }

            create(rest)
        }
    }
}
