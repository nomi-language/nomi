// `nomi tool csvdata rows <file.csv>...`: how many rows each table has. A
// tool runs with every effect a program has: this one reads files, which
// the macro may not do itself.
import std/io

struct App {
    files: List<String>
}

fn boot(startup: Startup) -> App {
    #App{files: startup.args}
}

fn main() -> Result<Unit, String> {
    report(App.files)
}

fn report(paths: List<String>) -> Result<Unit, String> {
    case paths {
        [] ->
            Ok(Unit)

        [path, ..rest] -> {
            text = case io.read_file(path) {
                Ok(t) -> t
                Err(e) -> return Err("${path}: ${e}")
            }

            rows =
                text
                |> String.lines()
                |> Iter.drop(1)
                |> Iter.filter(fn line -> line != "")
                |> Iter.count()

            io.print("${path}: ${rows} rows")
            report(rest)
        }
    }
}
