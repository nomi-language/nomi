// `table`: a lookup function whose rows are a CSV file's, checked
// when the program is checked.
//
//     import csvdata
//
//     /// Exchange rates to the euro, in basis points.
//     pub csvdata.table! rate(code: String) -> Maybe<Int> `rates.csv`
//
// expands to
//
//     pub fn rate(code: String) -> Maybe<Int> {
//         case code {
//             "usd" -> Some(9200)
//             _ -> None
//         }
//     }
//
// and the compiler gives the function the declaration's doc comment. The
// body names the file, under the directory `dir` of the module's
// `[csvdata]` table, and takes no tag: it is a path, not CSV. Its first
// row is a header; every other row is a key and a value. The declaration
// states the function's type, so its result is a `Maybe`: `None` for a key
// the file does not have. A key is a String when the parameter is one, and
// a value when the result is `Maybe<String>`; any other key or value is
// written into the code as it is in the file, so the checker checks it
// against the declared type and reports a mistake at its cell. A String
// is written as a string literal, so a cell holds any text.
//
// This module is written against std/macro alone.
import {
    std/json.Json
    std/macro.{Action, ActionsCall, Body, CheckCall, Completion, Declaration, Diagnostic, Edit}
    std/macro.{ExpandCall, Expansion, Input, Macro, Navigation, NavigationCall, ProgramCheck}
    std/macro.{Request, RequestCall, Source, Span, Tool}
}

/// A lookup function over the rows of a CSV file.
pub macro table: CsvTable

type CsvTable

/// One row of a table: its line, its key and value cells and their text.
struct Row {
    line: Int
    key: String
    value: String
    text: String
}

impl Macro for CsvTable {
    fn request(call: RequestCall) -> Request {
        case table_path(call.decl, call.config) {
            Some(path) -> #Request{files: [path]}
            None -> #Request{}
        }
    }

    fn expand(call: ExpandCall) -> Expansion {
        decl = call.decl

        param = case decl.params {
            [p] -> p
            _ -> return Declaration.error(decl, "a table takes one parameter, its key")
        }

        result = case decl.result {
            Some(t) -> t
            None -> return Declaration.error(decl, "a table names its result type: `-> Maybe<Int>`")
        }

        value_type = case maybe_argument(result.text) {
            Some(t) ->
                t

            None ->
                return Expansion.error(
                    result.span,
                    "a table answers `None` for a missing key, so write `-> Maybe<${result.text}>`",
                )
        }

        path = case table_path(decl, call.config) {
            Some(p) -> p
            None -> return Declaration.error(decl, "a table names its CSV file in backticks")
        }

        case decl.body {
            Some(#Body{tag: Some(tag), tag_span: Some(span)}) ->
                return Expansion.error(
                    span,
                    "a table's body is the path of its CSV file and takes no tag: remove `${tag}`",
                )

            _ -> {}
        }

        input = case Input.find(call.inputs, path) {
            Some(i) -> i
            None -> return #Expansion{
                diagnostics: [
                    #Diagnostic{
                        span: body_span(decl),
                        message: "no file ${path}",
                        hints: ["the path is under the module root, after `[csvdata].dir`"],
                    },
                ],
            }
        }

        #(rows, problems) = read_rows(input)

        if !Iter.empty?(problems) {
            return #Expansion{diagnostics: problems}
        }

        quote_keys = param.type_text.text == "String"
        quote_values = value_type == "String"

        visibility = if decl.public { "pub " } else { "" }

        header =
            Source.new()
            |> Source.add("${visibility}fn ${decl.name}(")
            |> Source.mapped(param.name, param.span)
            |> Source.add(": ")
            |> Source.mapped(param.type_text.text, param.type_text.span)
            |> Source.add(") -> ")
            |> Source.mapped(result.text, result.span)
            |> Source.add(" {\n    case ${param.name} {\n")

        arms = Iter.reduce(
            rows,
            fn src, row -> {
                key_end = String.length(row.key)
                key_span = Span.on_line(input.path, row.line, row.text, 0, key_end)
                value_start = key_end + 1
                value_end = value_start + String.length(row.value)
                value_span = Span.on_line(input.path, row.line, row.text, value_start, value_end)
                key_hint = Some("keys of `${decl.name}` are of type `${param.type_text.text}`")

                value = if quote_values {
                    String.to_literal(row.value)
                } else {
                    row.value
                }

                src
                |> Source.add("        ")
                |> key_cell(quote_keys, row.key, key_span, key_hint)
                |> Source.add(" -> ")
                |> Source.mapped(
                    "Some(${value})",
                    value_span,
                    hint: Some("values of `${decl.name}` are of type `${value_type}`"),
                )
                |> Source.add("\n")
            },
            from: header,
        )

        arms
        |> Source.add("        _ -> None\n    }\n}\n")
        |> Source.expansion()
    }
}

impl ProgramCheck for CsvTable {
    fn check_all(call: CheckCall) -> List<Diagnostic> {
        #(_, problems) = Iter.reduce(
            call.decls,
            fn acc: #(Map<String, String>, List<Diagnostic>), decl -> {
                #(seen, problems) = acc

                case table_path(decl, call.config) {
                    None ->
                        acc

                    Some(path) ->
                        case Map.get(seen, path) {
                            Some(other) -> #(seen, problems + [
                                #Diagnostic{
                                    span: body_span(decl),
                                    message: "`${other}` reads ${path} too; each file is read by one table",
                                },
                            ])
                            None -> #(Map.put(seen, path, decl.name), problems)
                        }
                }
            },
            from: #(%{}, []),
        )

        problems
    }
}

impl Navigation for CsvTable {
    fn hover(call: NavigationCall) -> Maybe<String> {
        Iter.first(call.inputs)
        |> Maybe.map(fn input -> {
            #(rows, _) = read_rows(input)
            "`${call.decl.name}`: ${Iter.count(rows)} rows from ${input.path}"
        })
    }

    fn definition(call: NavigationCall) -> Maybe<Span> {
        Iter.first(call.inputs)
        |> Maybe.map(fn input -> #Span{file: input.path, line: 1, col: 1, end_line: 1, end_col: 1})
    }

    fn complete(call: NavigationCall) -> List<Completion> {
        call.inputs
        |> Iter.map(fn input -> #Completion{
            label: input.path,
            detail: "CSV table",
            insert: input.path,
        })
        |> Iter.to_list()
    }

    fn actions(call: ActionsCall) -> List<Action> {
        diagnostic = call.diagnostic

        if String.starts_with?(diagnostic.message, "duplicate key") {
            span = diagnostic.span

            [
                #Action{
                    title: "Remove the duplicate row",
                    edits: [
                        #Edit{
                            span: #Span{
                                file: span.file,
                                line: span.line,
                                col: 1,
                                end_line: span.line + 1,
                                end_col: 1,
                            },
                            text: "",
                        },
                    ],
                },
            ]
        } else if String.starts_with?(diagnostic.message, "no file ") {
            path = String.strip_prefix(diagnostic.message, "no file ") |> Maybe.with_default("")

            [
                #Action{
                    title: "Create ${path} with `nomi tool csvdata create`",
                    tool: Some(#Tool{name: "create", args: [path]}),
                },
            ]
        } else {
            []
        }
    }
}

/// source followed by the key `text`, made from `span`: a string literal
/// when `quoted`, else the text as it is.
fn key_cell(source: Source, quoted: Bool, text: String, span: Span, hint: Maybe<String>) -> Source {
    if quoted {
        Source.string_literal(source, text, span, hint)
    } else {
        Source.mapped(source, text, span, hint)
    }
}

/// The file decl reads: its body, under the configuration's `dir`.
fn table_path(decl: Declaration, config: Json) -> Maybe<String> {
    dir = case config {
        Json.Obj(fields) ->
            case Map.get(fields, "dir") {
                Some(Json.String(d)) -> d + "/"
                _ -> ""
            }

        _ ->
            ""
    }

    decl.body
    |> Maybe.map(fn body -> String.trim(body.text))
    |> Maybe.flat_map(fn text -> if text == "" { None } else { Some(dir + text) })
}

/// The type argument of `text` when it is `Maybe<T>`: `T`.
fn maybe_argument(text: String) -> Maybe<String> {
    text
    |> String.strip_prefix("Maybe<")
    |> Maybe.flat_map(fn rest -> String.strip_suffix(rest, ">"))
}

/// The span of decl's body, or of decl when it has none.
fn body_span(decl: Declaration) -> Span {
    case decl.body {
        Some(body) -> body.span
        None -> decl.span
    }
}

/// The rows of a CSV input after its header, and what is wrong with them.
fn read_rows(input: Input) -> #(List<Row>, List<Diagnostic>) {
    #(rows, problems, _) =
        input.text
        |> String.lines()
        |> Iter.with_index()
        |> Iter.drop(1)
        |> Iter.reduce(
            fn acc: #(List<Row>, List<Diagnostic>, Map<String, Int>), #(index, text) -> {
                #(rows, problems, keys) = acc
                line = index + 1
                cells = String.split(text, ",")

                case cells {
                    [""] ->
                        acc

                    [key, value] ->
                        case Map.get(keys, key) {
                            Some(first) -> {
                                problem = #Diagnostic{
                                    span: Span.on_line(
                                        input.path,
                                        line,
                                        text,
                                        0,
                                        String.length(key),
                                    ),
                                    message: "duplicate key ${key}: line ${first} has it already",
                                }

                                #(rows, [problem, ..problems], keys)
                            }

                            None ->
                                #(
                                    [#Row{line, key, value, text}, ..rows],
                                    problems,
                                    Map.put(keys, key, line),
                                )
                        }

                    _ -> {
                        count = Iter.count(cells)

                        problem = #Diagnostic{
                            span: Span.line(input.path, line, text),
                            message: "this row has ${count} cells; a table row is a key and a value",
                        }

                        #(rows, [problem, ..problems], keys)
                    }
                }
            },
            from: #([], [], %{}),
        )

    // Each list was built last first.
    #(Iter.reverse(rows), Iter.reverse(problems))
}
