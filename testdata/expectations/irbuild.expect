S }
S
S fn short_fail(): Result<Int, String> {
S   Err("boom")
S }
S
S tests "virtual clock" {
S   clock Clock.Virtual
S
S   test "a short-circuit cancels its siblings" {
S     before = Instant.now()
S
S     outcome = concurrent {
S       short = Task.spawn(|| short_fail())
S       long = Task.spawn(|| long_sleep())
S       _l = long
S       Ok(try Task.await(short))
S     }
S
S     elapsed = Instant.to_seconds(Instant.now()) - Instant.to_seconds(before)
S     failed: Result<Int, String> = Err("boom")
S
S     assert outcome == failed
S     assert elapsed == 0
S   }
S
S   test "time passes in the bubble" {
S     before = Instant.now()
S     timer.sleep(Duration.seconds(7))
S     assert Instant.to_seconds(Instant.now()) - Instant.to_seconds(before) == 7
S   }
S }
S
