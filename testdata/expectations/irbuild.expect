S -- control_test.nomi 818 --
S import std/calendar
S import std/json.Json
S
S pub enum Probe.Reading {
S   Steady
S   Spike Int
S }
S
S fn severity(r: Probe.Reading): Int {
S   case r {
S     Probe.Reading.Steady -> 0
S     Probe.Reading.Spike(n) -> n
S   }
S }
S
S fn decode_error(src: String): String {
S   case Json.decode(src) {
S     Ok(_) -> "parsed"
S     Err(e) -> Json.DecodeError.to_string(e)
S   }
S }
S
S test "a namespaced variant, bare and with a payload" {
S   assert severity(Probe.Reading.Steady) == 0
S   assert severity(Probe.Reading.Spike(3)) == 3
S }
S
S test "a namespaced type's impl function" {
S   assert decode_error("not json") == "json decode error at line 1, col 2: unexpected character 'o'"
S }
S
S test "a stdlib module's type-owned function" {
S   got = case calendar.Date.parse("05/04/2026") {
S     Ok(_) -> "parsed"
S     Err(_) -> "rejected"
S   }
S   assert got == "rejected"
S }
S
