S -- control_test.nomi 848 --
S fn greet(name: String, greeting: String = "Hello", mark: String = "!"): String {
S   greeting + ", " + name + mark
S }
S
S fn skip(req: Int, opt: String = "a", scale: Int = 2, cb: (Int) -> Int): Int {
S   cb(req) * scale + String.length(opt)
S }
S
S fn double(n: Int): Int {
S   n * 2
S }
S
S test "an omitted default" {
S   assert greet("World") == "Hello, World!"
S   assert greet("World", "Hi") == "Hi, World!"
S }
S
S test "named arguments and a trailing function" {
S   assert greet("Ada", mark: "?") == "Hello, Ada?"
S   assert skip(5, double) == 21
S   assert skip(5, scale: 3, double) == 31
S   assert skip(req: 5, |n| n + 1) == 13
S }
S
S test "a failing short call reports its written arguments" {
S   who = "World"
S   assert greet(who) == "Hi, World!"
S }
S
S test "a failing named call reports positional rows then named rows" {
S   n = 5
S   s = 3
S   assert skip(n, scale: s, double) == 0
S }
S
