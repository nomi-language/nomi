S pub struct Box {
S     n: Int
S }
S
S impl Box {
S     pub fn total(boxes: Iter<Box>) -> Int {
S         Iter.reduce(boxes, fn acc = 0, b -> acc + b.n)
S     }
S
S     pub fn count_of<T>(items: Iter<T>) -> Int {
S         Iter.count(items)
S     }
S }
S
