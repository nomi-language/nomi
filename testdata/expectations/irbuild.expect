S test "a list into another file's Iter parameter" {
S     boxes = [#Box{n: 1}, #Box{n: 2}]
S     assert Box.total(boxes) == 3
S     assert Box.total(%[#Box{n: 4}]) == 4
S     assert [5] |> Iter.map(fn n -> #Box{n}) |> Box.total() == 5
S }
S
S test "a list into another file's generic Iter parameter" {
S     assert Box.count_of([1, 2, 3]) == 3
S     assert Box.count_of(%["a"]) == 1
S     assert [1, 2, 3, 4] |> Iter.filter(fn n -> n > 2) |> Box.count_of() == 2
S }
