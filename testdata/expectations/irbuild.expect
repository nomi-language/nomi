S   assert via() == "announce(user:Alice)"
S }
S
S test "from a test body" {
S   assert announce(User{name: "Bob"}) == "announce(user:Bob)"
S   assert same(3) == 3
S   assert same("x") == "x"
S }
S
S test "a failing generic call reports its argument" {
