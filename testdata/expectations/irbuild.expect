S import {
S   std/channels.{Channel, Receiver, Sender}
S   std/duration.Duration
S   std/supervisors.{Restart, Supervisor}
S   std/testing.Clock
S }
S
S pub struct App {
S   context: Context
S   done: Channel<Int>
S }
S
S fn group(timeout: Duration): Supervisor {
S   Supervisor.new(shutdown_timeout: timeout, max_running: 2, restart: Restart.Temporary)
S }
S
S fn start(done: Channel<Int>): Unit {
S   _ = Supervisor.spawn(group(Duration.seconds(1)), || report(done, 1))
S   _ = group(Duration.seconds(2)) |> Supervisor.spawn(|| report(done, 2))
S   Unit
S }
S
S fn report(done: Channel<Int>, n: Int): Unit {
S   _ = Sender.send(done.sender, n)
S   Unit
S }
S
S pub fn boot(): App {
S   done = Channel.buffered<Int>(4)
S   start(done)
S   App{context: Context.root(), done}
S }
S
S fn main() {}
S
S tests "spawn over a called supervisor" {
S   clock Clock.Virtual
S
S   boot boot()
S
S   test "both tasks report" {
S     a = Receiver.receive(App.done.receiver)
S     b = Receiver.receive(App.done.receiver)
S     assert a != b
S   }
S }
S
S
