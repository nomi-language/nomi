S -- pattern_test.nomi 1266 --
S import {
S   std/duration.Duration
S   std/instant.Instant
S   std/tasks.Task
S   std/testing.Clock
S   std/timer
S }
S
S fn long_sleep(): Unit {
S   timer.sleep(Duration.seconds(5))
S }
S
S fn short_fail(): Result<Int, String> {
S   Err("boom")
S }
S
S fn pair_of(): (Int, String) {
S   (1, "one")
S }
S
S tests "sibling cancellation under a virtual clock" {
S   clock Clock.Virtual
S
S   test "a short-circuit cancels its siblings instead of waiting for them" {
S     before = Instant.now()
S
S     outcome = concurrent {
S       short = Task.spawn(|| short_fail())
S       long = Task.spawn(|| long_sleep())
S       _l = long
S       Ok(try Task.await(short))
S     }
S
S     elapsed = Instant.to_seconds(Instant.now()) - Instant.to_seconds(before)
S
S     assert Err(e) = outcome
S     assert e == "boom"
S     assert elapsed == 0
S   }
S
S   test "a failing pattern over a concurrent block shows its definition" {
S     outcome = concurrent {
S       short = Task.spawn(|| short_fail())
S       Ok(try Task.await(short))
S     }
S
S     assert Ok(n) = outcome
S     assert n == 1
S   }
S
S   test "a tuple pattern binds both parts" {
S     pair = pair_of()
S     assert (n, word) = pair
S     assert n == 1
S     assert word == "one"
S   }
S
S   test "a list pattern that does not match shows the whole list" {
S     assert [a, b] = ["one"]
S     assert a == b
S   }
S }
S
S
