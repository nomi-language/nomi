S   }
S
S   fn double(n: Int): Int {
S     n * 2
S   }
S }
S
S fn add(a: Int, b: Int): Int {
S   a + b
S }
S
S fn longer(a: String, b: String): String {
S   if String.length(b) > String.length(a) { b } else { a }
S }
S
S fn is_even(n: Int): Bool {
S   n % 2 == 0
S }
S
S test "a top-level fn as a reduction" {
S   assert Iter.reduce([1, 2, 3], add) == 6
S   assert [1, 2, 3, 4] |> Iter.reduce(add) == 10
S   assert Iter.reduce(["a", "ccc", "bb"], longer) == "ccc"
S }
S
S test "a top-level fn as an adapter" {
S   assert Iter.filter([1, 2, 3, 4], is_even) |> Iter.to_list() == [2, 4]
S }
S
S test "an imported fn" {
S   assert Iter.reduce([1, 2, 3], plus) == 6
S   assert Iter.reduce([1, 2, 3], util.plus) == 6
S   assert Iter.filter([1, 2, 3, 4], util.small?) |> Iter.to_list() == [1, 2]
S }
S
S test "an owner-qualified impl fn" {
S   assert Iter.reduce([Money{cents: 1}, Money{cents: 2}], Money.sum).cents == 3
S   assert Iter.map([1, 2], Money.double) |> Iter.to_list() == [2, 4]
S }
S
