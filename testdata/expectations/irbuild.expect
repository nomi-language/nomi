S -- context_value_test.nomi 1507 --
S type UserId Int
S
S type RequestId Int
S
S type Flag
S
S struct Tag {
S   name: String
S }
S
S fn user_of(c: Context): Maybe<UserId> {
S   Context.value(c, UserId)
S }
S
S fn find_in(c: Context, witness: Type<Tag>): Maybe<Tag> {
S   Context.value(c, witness)
S }
S
S test "two distincts over one scalar keep two slots" {
S   c = Context.with_value(Context.root(), UserId(1))
S   both = Context.with_value(c, RequestId(2))
S   assert user_of(both) == Some(UserId(1))
S   assert Context.value(both, RequestId) == Some(RequestId(2))
S }
S
S test "a primitive is keyed by its own type" {
S   c = Context.with_value(Context.root(), 5)
S   assert Context.value(c, Int) == Some(5)
S   assert Context.value(c, String) == None
S }
S
S test "a child shadows and the parent is unchanged" {
S   parent = Context.with_value(Context.root(), Tag{name: "a"})
S   child = Context.with_value(parent, Tag{name: "b"})
S   assert find_in(child, Tag) == Some(Tag{name: "b"})
S   assert find_in(parent, Tag) == Some(Tag{name: "a"})
S }
S
S test "markers compare equal and are values" {
S   c = Context.with_value(Context.root(), Flag)
S   assert Flag == Flag
S   refute Flag != Flag
S   assert Context.value(c, Flag) == Some(Flag)
S }
S
S test "a failing lookup reports its operands" {
S   c = Context.with_value(Context.root(), UserId(3))
S   assert Context.value(c, UserId) == Some(UserId(4))
S }
S
S test "a case subject records its scrutinee and the arm that ran" {
S   c = Context.with_value(Context.root(), UserId(3))
S   assert case Context.value(c, UserId) {
S     Some(UserId(id)) -> id == 4
S     None -> False
S   }
S }
S
S
