S -- control_test.nomi 1400 --
S import std/io
S
S fn skip_odd(n: Int): Int {
S   if n % 2 == 1 {
S     continue
S   }
S   n * 10
S }
S
S fn keep_until_big(n: Int): Bool {
S   if n > 3 {
S     break
S   }
S   n % 2 == 0
S }
S
S fn below_five(n: Int): Bool {
S   if n >= 5 {
S     break False
S   }
S   True
S }
S
S fn sum_small(total: Int, n: Int): Int {
S   if n < 0 {
S     continue
S   }
S   if total > 10 {
S     break total
S   }
S   total + n
S }
S
S fn stop_at_zero(total: Int, n: Int): Int {
S   if n == 0 {
S     break
S   }
S   total + n
S }
S
S fn show_until_three(n: Int): Unit {
S   if n == 3 {
S     break
S   }
S   io.print("each ${n}")
S }
S
S fn double_until(n: Int): Int {
S   if n > 20 {
S     break
S   }
S   n * 2
S }
S
S test "map skips with continue" {
S   assert Iter.map([1, 2, 3, 4], skip_odd) |> Iter.to_list() == [20, 40]
S   assert [1, 2, 3, 4] |> Iter.map(skip_odd) |> Iter.to_list() == [20, 40]
S }
S
S test "filter stops with a bare break" {
S   assert Iter.filter([1, 2, 3, 4, 5, 6], keep_until_big) |> Iter.to_list() == [2]
S }
S
S test "take_while stops with break False" {
S   assert Iter.take_while([1, 2, 7, 3], below_five) |> Iter.to_list() == [1, 2]
S }
S
S test "reduce continues and breaks with the accumulator" {
S   assert Iter.reduce([1, -5, 2, 3, 20, 4], sum_small) == 26
S   assert Iter.reduce([1, 2, 0, 4], stop_at_zero) == 3
S }
S
S test "each stops" {
S   Iter.each([1, 2, 3, 4], show_until_three)
S   assert True
S }
S
S test "iterate stops" {
S   assert Iter.iterate(1, double_until) |> Iter.to_list() == [1, 2, 4, 8, 16]
S }
S
S
