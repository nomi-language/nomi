S -- control_test.nomi 576 --
S fn parse(n: Int): Result<Int, String> {
S   if n < 0 {
S     Err("negative")
S   } else {
S     Ok(n)
S   }
S }
S
S fn half(n: Int): Maybe<Int> {
S   if n % 2 == 0 {
S     Some(n / 2)
S   } else {
S     None
S   }
S }
S
S test "an Ok passes through" {
S   v = try parse(3)
S   assert v == 3
S }
S
S test "an Err ends the case" {
S   v = try parse(-1)
S   assert v == 1
S }
S
S test "a None ends the case" {
S   h = try half(3)
S   assert h == 1
S }
S
S test "a piped try" {
S   v = -1 |> try parse()
S   assert v == 0
S }
S
S test "a try after an assertion that passed" {
S   assert 1 == 1
S   _ = try half(4)
S   _ = try half(5)
S   assert 2 == 3
S }
S
S
