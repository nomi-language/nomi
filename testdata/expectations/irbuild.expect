S fn double(n: Int): Int {
S   n * 2
S }
S
S test "a count in a subject" {
S   xs = [1, 2, 3]
S   assert Iter.count(xs) == 3
S }
S
S test "a pipeline bound before the assertion" {
S   total = [1, 2, 3, 4] |> Iter.filter(|x| x % 2 == 0) |> Iter.reduce(|a = 0, x| a + x)
S   assert total == 6
S }
S
S test "a predicate call records its source" {
S   xs = [2, 4, 5]
S   assert Iter.all?(xs, |x| x % 2 == 0)
S }
S
S test "a multi-line call leaves the cursor on its last line" {
S   assert double(
S     3
S   ) == 7
S }
S
S test "a call through a function value shows its argument" {
S   small? = |n: Int| n > 90
S   w = 5
S   assert small?(w)
S }
S
S test "a folded count in a subject" {
S   assert Iter.count(
S     [1, 2] |> Iter.map(|x| x + 1)
S   ) == 2
S }
S
S
