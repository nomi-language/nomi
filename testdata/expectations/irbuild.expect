S   assert Iter.reduce([1, 2, 3], fn acc = 0, n -> util.plus(acc, n)) == 6
S   assert Iter.filter([1, 2, 3, 4], util.is_small) |> Iter.to_list() == [1, 2]
S }
S
S test "an owner-qualified impl fn" {
S   assert Iter.reduce([#Money{cents: 1}, #Money{cents: 2}], fn acc = #Money{cents: 0}, m -> Money.sum(acc, m)).cents == 3
S   assert Iter.map([1, 2], Money.double) |> Iter.to_list() == [2, 4]
S }
