S -- counter_app.nomi 6147 --
S //# A single long-lived worker owning mutable state, driven by messages.
S //#
S //# This is the shape you reach for when several callers need to share
S //# state that has to change: instead of guarding it, give it to one task
S //# and talk to that task. Nothing else can reach the state, and one task
S //# handles one message at a time, so there is nothing to guard.
S //#
S //# **The server is a value started by a helper.** `start()` builds
S //# the inbox, the group, and the worker, and hands back the one field the
S //# app's config struct stores. Callers touch neither a channel nor a group.
S //#
S //# Owning its group is what lets the server declare `Restart.Permanent`
S //# — a worker meant to run until something stops it has failed if it
S //# returns on its own. A group shared with one-shot work could not say
S //# that, since for that work returning is exactly the point.
S //#
S //# The state lives in `Iter.loop`'s accumulator, inside the task. That is
S //# what makes it private: a binding inside a running task is not
S //# reachable from anywhere else, so "who else might be writing this?" has
S //# one answer, and it is nobody.
S
S import {
S     std/channels.{Channel, Receiver, Sender}
S     std/duration.Duration
S     std/io
S     std/supervisors.{Backoff, Restart, Supervisor}
S }
S
S /// What callers can ask the worker to do.
S ///
S /// `Increment` is fire-and-forget. `Get` needs an answer, so it carries
S /// the channel to answer on — a request wanting a reply brings its own
S /// return address, since a channel only goes one way.
S pub enum Request {
S     Increment Int
S     Get {reply: Channel<Int>}
S     Explode
S }
S
S /// A running counter. Holding one is how you address the worker; the
S /// channel inside is an implementation detail callers never see.
S pub struct Counter {
S     inbox: Channel<Request>
S }
S
S /// Create the inbox, the group, and the worker. One call, and the
S /// caller stores one field.
S ///
S /// Creating the group here is legal because `boot` calls this — the
S /// rule is that groups are created *during* boot, not that the call is
S /// written inside it. Calling `start()` from anywhere boot does not reach is a
S /// compile error.
S ///
S /// Owning its own group is what lets the server set
S /// `Restart.Permanent`. A shared group cannot: permanence says
S /// returning is a failure, which is right for this worker and wrong for
S /// the one-shot work that would sit beside it.
S fn start() -> Counter {
S     inbox = Channel.buffered<Request>(16)
S
S     // The group handle is not kept. Every group is registered with the
S     // runtime when it is created, and shutdown drains all of them, so
S     // holding one only matters if you want to `Supervisor.flush` on it —
S     // which for a permanent worker you cannot do anyway, since it never
S     // finishes.
S     _ =
S         Supervisor.new(
S             shutdown_timeout: Duration.seconds(5),
S             max_running: 1,
S             restart: Restart.Permanent,
S             backoff: #Backoff.Exponential{
S                 max_restarts: 3,
S                 max_elapsed: Duration.minutes(5),
S             },
S         )
S         |> Supervisor.spawn(fn -> serve(inbox))
S
S     #Counter{inbox}
S }
S
S /// The worker. Runs until its inbox closes or shutdown cancels it.
S ///
S /// `count` is the state. It is an ordinary loop accumulator, so each
S /// branch returns the next value: updating the state and returning from
S /// the handler are the same act, and there is no way to forget one.
S ///
S /// What serializes the work is that exactly one of these runs per
S /// inbox — not the group's `max_running`, which is about how much of
S /// the group's whole workload runs at once.
S fn serve(inbox: Channel<Request>) -> Unit {
S     _final = Iter.loop(fn count = 0 -> {
S         case Receiver.receive(inbox.receiver) {
S             Some(Request.Increment(n)) ->
S                 count + n
S
S             Some(#Request.Get{reply}) -> {
S                 // Best-effort: a caller that gave up is not worth crashing over.
S                 _ = Sender.send(reply.sender, count)
S                 count
S             }
S
S             // Stands in for a handler with a bug in it.
S             Some(Request.Explode) ->
S                 count / 0
S
S             // The inbox closed and drained: no more work is coming.
S             None ->
S                 break count
S         }
S     })
S
S     Unit
S }
S
S /// Fire-and-forget: returns as soon as the message is queued.
S pub fn increment(counter: Counter, n: Int) -> Unit {
S     case Sender.send(counter.inbox.sender, Request.Increment(n)) {
S         Ok(_) -> Unit
S         Err(_) -> Unit
S     }
S }
S
S /// Ask and wait. The reply channel is made per call, so two callers in
S /// flight can never take each other's answer.
S ///
S /// Capacity 1 so the worker never blocks handing the reply back, even
S /// if this caller has already given up and stopped listening.
S pub fn get(counter: Counter) -> Int {
S     reply = Channel.buffered<Int>(1)
S     _ = Sender.send(counter.inbox.sender, #Request.Get{reply})
S
S     case Receiver.receive(reply.receiver) {
S         Some(v) -> v
S         None -> 0
S     }
S }
S
S pub fn explode(counter: Counter) -> Unit {
S     case Sender.send(counter.inbox.sender, Request.Explode) {
S         Ok(_) -> Unit
S         Err(_) -> Unit
S     }
S }
S
S // There is deliberately no `flush` here.
S //
S // `Supervisor.flush` waits for a group's tasks to *finish*, and a
S // permanent worker never does — waiting on this server's group blocks
S // until shutdown cancels it, which under a virtual clock is reported as
S // a deadlock. It is the right answer to the wrong question.
S //
S // `get` is the synchronisation point instead: it round-trips through
S // the worker, so everything queued before it has necessarily been
S // handled by the time it returns. A request that wants an answer is
S // also a barrier.
S pub struct Config {
S     context: Context
S
S     // One field. The server owns its inbox, its group, and its policy, so
S     // adding a second server adds one more field and nothing else.
S     counter: Counter
S }
S
S pub fn boot() -> Result<Config, String> {
S     Ok(#Config{context: Context.root(), counter: start()})
S }
S
S fn main() {
S     increment(Config.counter, 5)
S     increment(Config.counter, 7)
S     io.print("count=${get(Config.counter)}")
S }
S
S -- group_test.nomi 2354 --
S // Exercises the message-driven counter in counter_app.nomi, booted as that
S // entry file boots it.
S import {
S     std/testing.Clock
S     counter_app.{self, Config, explode, get, increment}
S }
S
S group "a message-driven worker" {
S     // Nothing here sleeps, but the worker blocks on its inbox and the group
S     // drains at the end of every case — all of which a virtual clock makes
S     // instant and repeatable.
S     clock Clock.Virtual
S
S     boot counter_app.boot()
S
S     test "messages accumulate into state a caller can read back" {
S         increment(Config.counter, 5)
S         increment(Config.counter, 7)
S
S         assert get(Config.counter) == 12
S     }
S
S     test "each caller gets its own reply" {
S         increment(Config.counter, 1)
S         first = get(Config.counter)
S         increment(Config.counter, 1)
S         second = get(Config.counter)
S
S         assert first == 1
S         assert second == 2
S     }
S
S     test "a handler that breaks restarts the worker with fresh state" {
S         increment(Config.counter, 5)
S         explode(Config.counter) // the handler divides by zero
S         increment(Config.counter, 7)
S
S         // The group re-invoked the spawn's closure, so the loop started over
S         // from 0 and only the message after the crash counts. Restarting
S         // rebuilds state, exactly as re-running the function would — there is
S         // nothing else it could do, since the closure is the only description
S         // of the work.
S         //
S         // Note what survived: the inbox. The closure captured it, so the
S         // restarted worker reads the same channel and messages queued during
S         // the crash are still there. The failed message itself is gone,
S         // consumed before the handler broke, so a poison message cannot loop.
S         assert get(Config.counter) == 7
S     }
S
S     test "a call observes every cast queued before it" {
S         // Casts return as soon as the message is queued, so nothing here has
S         // necessarily run yet.
S         increment(Config.counter, 1)
S         increment(Config.counter, 2)
S         increment(Config.counter, 3)
S
S         // The inbox is FIFO and one worker drains it, so this reply cannot
S         // come back before all three have been applied. That ordering is the
S         // whole reason to put state behind a single task.
S         assert get(Config.counter) == 6
S     }
S }
S
S
