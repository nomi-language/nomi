S -- control_test.nomi 729 --
S import std/io
S
S fn get(ok: Bool) -> Result<String, String> {
S   if ok {
S     Ok("x")
S   } else {
S     Err("no")
S   }
S }
S
S fn bye() {
S   io.print("deferred")
S }
S
S test "a return arm ends the case" {
S   defer bye()
S   assert case get(False) {
S     Ok(d) -> d
S     Err(_) -> return
S   } == "y"
S   io.print("not reached")
S }
S
S test "the other arm is the subject" {
S   assert case get(True) {
S     Ok(d) -> d
S     Err(_) -> return
S   } == "y"
S }
S
S test "an arm's block that leaves" {
S   assert case get(False) {
S     Ok(d) -> d
S     Err(e) -> {
S       {
S         io.print("left with ${e}")
S         return
S       }
S     }
S   } == "y"
