S import std/io
S
S fn main() {}
S
S tests "plain return" {
S   setup {
S     x = 1
S     return x + 1
S   }
S
S   test "binds the returned value", v {
S     assert v == 2
S   }
S }
S
S tests "early return" {
S   setup {
S     flag = True
S     if flag {
S       io.print("early")
S       return "early"
S     }
S     io.print("late")
S     "late"
S   }
S
S   test "binds the early value", v {
S     io.print("body sees ${v}")
S     assert v == "early"
S   }
S }
S
S tests "falls past an early return" {
S   setup {
S     flag = False
S     if flag {
S       return (1, "one")
S     }
S     (2, "two")
S   }
S
S   test "binds the tail value", (n, s) {
S     assert n == 2
S     assert s == "two"
S   }
S }
S
S tests "return in a case arm" {
S   setup {
S     case Some(3) {
S       Some(n) -> return n * 10
S       None -> {}
S     }
S     0
S   }
S
S   test "binds the arm's value", v {
S     assert v == 30
S   }
S }
S
S tests "return from a block" {
S   setup {
S     {
S       defer io.print("block closed")
S       io.print("in block")
S       return 7
S     }
S   }
S
S   test "runs the block's defer first", v {
S     io.print("body")
S     assert v == 7
S   }
S }
S
S tests "bare return in a Unit setup" {
S   setup {
S     io.print("before")
S     if True {
S       return
S     }
S     io.print("never")
S   }
S
S   test "runs the body" {
S     io.print("body after a bare return")
S     assert True
S   }
S }
