S -- control_test.nomi 669 --
S interface Showable {
S   fn show(value: self) -> String
S }
S
S struct User {
S   name: String
S }
S
S impl Showable for User {
S   fn show(u: User) -> String {
S     "user:" + u.name
S   }
S }
S
S fn announce<T>(value: T) -> String where T: Showable {
S   "announce(" + Showable.show(value) + ")"
S }
S
S fn same<T>(value: T) -> T {
S   value
S }
S
S fn via() -> String {
S   announce(#User{name: "Alice"})
S }
S
S test "from a named function" {
S   assert via() == "announce(user:Alice)"
S }
S
S test "from a test body" {
S   assert announce(#User{name: "Bob"}) == "announce(user:Bob)"
S   assert same(3) == 3
S   assert same("x") == "x"
S }
S
S test "a failing generic call reports its argument" {
S   n = 4
S   assert same(n) == 5
S }
S
S
