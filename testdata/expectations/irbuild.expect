S   n % 2 == 0
S }
S
S test "a top-level fn as a reduction" {
S   assert Iter.reduce([1, 2, 3], fn acc = 0, n -> add(acc, n)) == 6
S   assert [1, 2, 3, 4] |> Iter.reduce(fn acc = 0, n -> add(acc, n)) == 10
S   assert Iter.reduce(["a", "ccc", "bb"], fn acc = "", s -> longer(acc, s)) == "ccc"
S }
S
S test "a top-level fn as an adapter" {
