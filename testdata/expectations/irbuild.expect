S -- control_test.nomi 2320 --
S import std/io
S
S enum Code {
S   Num(Int)
S   Word(String)
S   Blank
S }
S
S fn parse(s: String): Result<Int, String> {
S   case s {
S     "one" -> Ok(1)
S     _ -> Err("not a number: " + s)
S   }
S }
S
S fn found(n: Int): Maybe<Int> {
S   if n > 0 { Some(n) } else { None }
S }
S
S fn three(): Code {
S   Code.Num(3)
S }
S
S test "an if statement asserts in its taken arm" {
S   n = 4
S   if n > 3 {
S     assert n * 2 == 8
S     io.print("then")
S   } else {
S     assert n == 0
S     io.print("else")
S   }
S   io.print("after if")
S }
S
S test "a failing assertion inside an else arm" {
S   n = 1
S   if n > 3 {
S     assert n == 4
S   } else {
S     doubled = n * 2
S     matches = doubled == 3
S     assert matches
S   }
S }
S
S test "an if without else and an else-if chain" {
S   n = 7
S   if n == 7 {
S     io.print("seven")
S   }
S   if n < 5 {
S     io.print("small")
S   } else if n < 10 {
S     io.print("medium")
S     assert n < 9
S     io.print("checked")
S   } else {
S     io.print("large")
S   }
S }
S
S test "a case statement over an Int" {
S   n = 2
S   case n {
S     1 -> False
S     2 -> {
S       label = "two"
S       assert label == "three"
S     }
S     _ -> True
S   }
S }
S
S test "a case statement over a user enum" {
S   c = Code.Word("hi")
S   case c {
S     Code.Num(n) -> {
S       assert n == 3
S       io.print("num")
S     }
S     Code.Word(w) -> {
S       io.print(w)
S       assert String.length(w) == 2
S       io.print("word")
S     }
S     Code.Blank -> io.print("blank")
S   }
S   io.print("after case")
S }
S
S test "a case statement over Maybe and Result constructors" {
S   case found(5) {
S     Some(v) -> {
S       assert v == 5
S       io.print("some")
S     }
S     None -> io.print("none")
S   }
S   case parse("x") {
S     Ok(v) -> assert v == 1
S     Err(e) -> assert e == "not a number: y"
S   }
S }
S
S test "constructors compared in assertions" {
S   assert found(2) == Some(2)
S   assert parse("one") == Ok(1)
S   assert Code.Word(_) = three()
S }
S
S test "a pattern if statement and a pattern if value" {
S   c = three()
S   if Code.Num(n) = c {
S     io.print(n)
S   }
S   got = if Code.Num(n) = c {
S     n
S   } else {
S     0
S   }
S   assert got == 4
S }
S
S test "a case statement over a list" {
S   xs = [1, 2, 3]
S   case xs {
S     [] -> io.print("empty")
S     [h, ..t] -> {
S       assert h == 1
S       assert t == [3]
S       io.print("unreached")
S     }
S   }
S }
S
S test "a case value binding" {
S   n = 3
S   word = case n {
S     1 -> "one"
S     3 -> "three"
S     _ -> "many"
S   }
S   assert word == "tree"
S }
S
