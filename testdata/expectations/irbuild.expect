S   fn from_fragments(fragments: List<Fragment<String>>): Upper {
S     text = Iter.reduce(fragments, |acc = "", frag|
S       case frag {
S         .Static(s) -> acc + String.to_upper(s)
S         .Dynamic(v) -> acc + v
S       }
