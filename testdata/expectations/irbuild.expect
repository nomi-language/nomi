S -- main_test.nomi 552 --
S import shapes.{self, Box}
S
S test "a struct with a record field from another file" {
S   b = shapes.make(3)
S   assert shapes.width(b) == 4
S   assert b.at.y == 6
S   assert shapes.width(#Box{at: #{x: 1, y: 0}, size: 5}) == 6
S }
S
S test "records in another file's signatures" {
S   assert shapes.corner(shapes.make(2)) == #{x: 2, y: 4}
S   assert shapes.px(#{x: 1, y: 2}) == 12
S   assert shapes.px(shapes.corner(shapes.make(1))) == 12
S }
S
S test "Infallible in another file's signature" {
S   v = case shapes.ok_only(3) {
S     Ok(n) -> n
S     Err(_) -> 0
S   }
S   assert v == 3
S }
S
S -- shapes.nomi 506 --
S pub struct Box {
S   at: #{x: Int, y: Int}
S   size: Int = 1
S }
S
S pub fn make(x: Int) -> Box {
S   #Box{at: #{x, y: x * 2}}
S }
S
S pub fn width(b: Box) -> Int {
S   b.at.x + b.size
S }
S
S pub fn corner(b: Box) -> #{x: Int, y: Int} {
S   b.at
S }
S
S pub fn px(p: #{x: Int, y: Int}) -> Int {
S   p.x * 10 + p.y
S }
S
S pub fn ok_only(n: Int) -> Result<Int, Infallible> {
S   Ok(n)
S }
S
S pub fn evens(n: Int) -> Iter<Int> {
S   0..n |> Iter.map(fn x -> x * 2)
S }
S
S pub fn sum_of(xs: Iter<Int>) -> Int {
S   Iter.reduce(xs, fn acc = 0, x -> acc + x)
S }
S
S
