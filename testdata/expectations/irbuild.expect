S -- assert_subject_test.nomi 1109 --
S
S import {
S   std/assertions.AssertionFailure
S   std/testing
S }
S
S fn find(n: Int) -> Maybe<String> {
S   if n == 1 { Some("Ada") } else { None }
S }
S
S fn ensure_small(n: Int) -> Result<Int, AssertionFailure> {
S   limit = 10
S   assert n < limit
S   assert find(1)
S   Ok(n)
S }
S
S fn checked(xs: List<Int>) -> Result<Bool, AssertionFailure> {
S   held = testing.check(xs |> Iter.any(fn x -> x > 2))?
S   Ok(held)
S }
S
S test "an assert in an ordinary fn is its Err" {
S   assert Ok(3) = ensure_small(3)
S   assert Err(failure) = ensure_small(12)
S   assert failure.reason == "assertion failed"
S   assert failure.expression == "n < limit"
S }
S
S test "a failing assert in an ordinary fn reports through the caller" {
S   assert Ok(12) = ensure_small(12)
S }
S
S test "a check over a pipe inside an ordinary fn" {
S   assert checked([1, 2, 3]) == Ok(True)
S   assert Err(failure) = checked([1, 2])
S   assert failure.keyword == "check"
S }
S
S test "a failing piped check reports its pipeline" {
S   result = testing.check(
S     [1, 2]
S     |> Iter.any(fn x -> x > 2)
S   )
S   assert result == Ok(True)
S }
S
S test "a failing shape assertion shows the value" {
S   refute find(1)
S }
S
S
