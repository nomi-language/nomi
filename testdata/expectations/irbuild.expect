S     {
S       defer io.print("block closed")
S       io.print("in block")
S       return 7
S     }
S   }
S
S   test "runs the block's defer first", v {
S     io.print("body")
S     assert v == 7
S   }
S }
S
S group "bare return in a Unit setup" {
S   setup {
S     io.print("before")
S     if True {
S       return
S     }
S     io.print("never")
S   }
S
S   test "runs the body" {
S     io.print("body after a bare return")
S     assert True
S   }
S }
