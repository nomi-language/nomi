S -- group_test.nomi 1903 --
S import {
S   std/channels.{Channel, Receiver, Sender}
S   std/duration.Duration
S   std/supervisors.Supervisor
S   std/tasks.{Outcome, Task}
S   std/testing.Clock
S   std/timer
S }
S
S pub struct App {
S   context: Context
S   work: Supervisor
S   alerts: Channel<String>
S }
S
S fn report(message: String) -> Unit {
S   case Sender.send(App.alerts.sender, message) {
S     Ok(_) -> Unit
S     Err(_) -> Unit
S   }
S }
S
S fn slow() -> Unit {
S   timer.sleep(Duration.seconds(30))
S   report("SHOULD NOT ARRIVE")
S }
S
S fn drain() -> List<String> {
S   Sender.close(App.alerts.sender)
S   Iter.loop(fn seen = [] ->
S     case Receiver.receive(App.alerts.receiver) {
S       Some(message) -> [message, ..seen]
S       None -> break seen
S     }
S   )
S }
S
S pub fn boot() -> Result<App, String> {
S   Ok(#App{
S     context: Context.root(),
S     work: Supervisor.new(max_running: 2),
S     alerts: Channel.buffered<String>(8),
S   })
S }
S
S fn main() {}
S
S group "tasks" {
S   clock Clock.Virtual
S
S   boot boot()
S
S   test "a cancelled task reports Cancelled" {
S     doomed = Supervisor.spawn(App.work, fn -> slow())
S     Task.cancel(doomed)
S     cancelled: Outcome<Unit> = .Cancelled
S     assert Task.outcome(doomed) == cancelled
S   }
S
S   test "a failing outcome comparison shows its rows" {
S     done = Supervisor.spawn(App.work, fn -> report("quick"))
S     _ = Supervisor.flush(App.work)
S     cancelled: Outcome<Unit> = .Cancelled
S     assert Task.outcome(done) == cancelled
S   }
S
S   test "any and all over a drained list" {
S     _ = Supervisor.spawn(App.work, fn -> report("audited 7"))
S     _ = Supervisor.flush(App.work)
S     seen = drain()
S     assert Iter.any(seen, fn m -> m == "audited 7")
S     assert Iter.all(seen, fn m -> String.contains(m, "audited"))
S     refute Iter.any(seen, fn m -> m == "missing")
S   }
S
S   test "a failing any shows its operand" {
S     _ = Supervisor.spawn(App.work, fn -> report("x"))
S     _ = Supervisor.flush(App.work)
S     assert drain() |> Iter.all(fn m -> m == "y")
S   }
S }
S
