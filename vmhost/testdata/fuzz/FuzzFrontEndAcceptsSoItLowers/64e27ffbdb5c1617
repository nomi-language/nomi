string("import std/random.{Generator, Seed}\n\ntest \"seeded generators produce deterministic values\" {\n    seed = Seed.from_int(123)\n    die = Generator.int(1, 6)\n\n    #(roll, seed) = die |> Generator.step(seed)\n\n    assert roll == 2\n\n    #(hand, seed) =\n        die\n        |> Generator.list(3)\n        |> Generator.step(seed)\n\n    assert hand == [1, 5, 2]\n\n    #(choice, _) =\n        Generator.uniform(\"rock\", [\"paper\", \"scissors\"])\n        |> Generator.step(seed)\n\n    assert choice == \"scissors\"\n}\n\ntest \"random generators compose dependent draws\" {\n    seed = Seed.from_int(123)\n    size = Generator.int(1, 4)\n\n    #(sized, _) =\n        size\n        |> Generator.flat_map(fn n -> Generator.list(Generator.bool(), n))\n        |> Generator.step(seed)\n\n    assert sized == [False, False, True, False]\n}\n\ntest \"weighted generators require positive total weight\" {\n    assert Generator.weighted(#(0.0, \"never\"), [])\n        |> Result.err?()\n}\n\ntest \"weighted generators reject negative weights\" {\n    assert Generator.weighted(#(-10, \"bad\"), [])\n        |> Result.err?()\n}\n\ntest \"an integer range as wide as Int draws in range\" {\n    seed = Seed.from_int(2026)\n\n    #(all, _) =\n        Generator.int(Int.min_value, Int.max_value)\n        |> Generator.list(8)\n        |> Generator.step(seed)\n\n    assert Iter.count(all) == 8\n    assert all |> Iter.any?(&(&1 < 0))\n    assert all |> Iter.any?(&(&1 > 0))\n\n    #(wide, _) =\n        Generator.int(-5, Int.max_value)\n        |> Generator.list(8)\n        |> Generator.step(seed)\n\n    assert wide |> Iter.all?(&(&1 >= -5))\n    assert wide |> Iter.any?(&(&1 > Int.max_value / 2))\n\n    #(low, _) =\n        Generator.int(Int.min_value, 0)\n        |> Generator.list(8)\n        |> Generator.step(seed)\n\n    assert low |> Iter.all?(&(&1 <= 0))\n\n    #(top, _) = Generator.int(Int.max_value, Int.max_value) |> Generator.step(seed)\n    assert top == Int.max_value\n}\n\ntest \"a float range wider than a Float can span draws in range\" {\n    #(xs, _) =\n        Generator.float(-1.0e308, 1.0e308)\n        |> Generator.list(8)\n        |> Generator.step(Seed.from_int(2026))\n\n    assert xs |> Iter.all?(fn x -> Float.finite?(x) and x >= -1.0e308 and x < 1.0e308)\n    assert xs |> Iter.any?(&(&1 < 0.0))\n    assert xs |> Iter.any?(&(&1 > 0.0))\n}\n")
