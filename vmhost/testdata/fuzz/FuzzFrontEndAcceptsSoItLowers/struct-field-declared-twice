string("// FILE: block_scoping_test.nomi\nimport {\n    std/compiler\n    test_helpers\n}\n\ntest \"block-scoped declarations are visible inside their enclosing block\" {\n    fn double(n: Int) -> Int {\n        n * 2\n    }\n\n    assert double(21) == 42\n\n    scale_factor = 10\n\n    fn scale(n: Int) -> Int {\n        n * scale_factor\n    }\n\n    assert scale(7) == 70\n\n    struct Point {\n   x: Int       x: Int\n        y: Int\n    }\n\n    fn make_point() -> Point {\n        #Point{x: 3, y: 4}\n    }\n\n    p = make_point()\n    assert p.x + p.y == 7\n\n    struct Defaulted {\n        v: Int = 99\n    }\n\n    d = #Defaulted{}\n    assert d.v == 99\n\n    typealias Count Int\n\n    fn make_count(n: Int) -> Count {\n        n\n    }\n\n    assert make_count(5) == 5\n\n    type UserId Int\n    UserId(n) = UserId(42)\n    assert n == 42\n\n    enum Color {\n        Red\n        Green\n        Blue\n    }\n\n    fn pick() -> Color {\n        Color.Green\n    }\n\n    result = case pick() {\n        Color.Red -> \"red\"\n        Color.Green -> \"green\"\n        Color.Blue -> \"blue\"\n    }\n\n    assert result == \"green\"\n\n    base = 100\n\n    fn add_base(n: Int) -> Int {\n        n + base\n    }\n\n    assert add_base(5) == 105\n}\n\ntest \"nested functions do not leak outside their enclosing function\" {\n    diagnostics = compiler.check(\n        \"\"\"\n          fn main() {\n            fn helper(): Int {\n              1\n            }\n\n            _ = helper()\n          }\n\n          fn other(): Int {\n            helper()\n          }\n        \"\"\"\n    )\n\n    assert test_helpers.has_diagnostic?(diagnostics, \"undefined variable 'helper'\")\n}\n\ntest \"imports can be declared inside function bodies\" {\n    fn first() -> Maybe<Int> {\n        import std/maybe.Maybe as Local\n\n        Local.Some(1)\n    }\n\n    fn second() -> Result<Int, String> {\n        import std/results.Result as Local\n\n        Local.Ok(2)\n    }\n\n    assert first() == Some(1)\n    assert second() == Ok(2)\n}\n// FILE: test_helpers.nomi\nimport std/compiler.{self, Diagnostic}\n\npub fn has_diagnostic?(diagnostics: List<Diagnostic>, text: String) -> Bool {\n    Iter.any?(diagnostics, fn diagnostic -> String.contains?(diagnostic.message, text))\n}\n\npub fn hover_signature(source: String) -> String {\n    case compiler.hover(source) {\n        Ok(hover) -> hover.signature\n        Err(message) -> message\n    }\n}\n")
