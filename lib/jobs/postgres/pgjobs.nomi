//# A durable `std::jobs` queue in a Postgres table. `pgjobs.queue(db, url)`
//# returns a `Queue` whose jobs live in the `nomi_jobs` table of the
//# database `db` points at; an enqueue writes on the caller's `Conn`, so it
//# commits or rolls back with the caller's transaction.
//#
//# ```nomi
//# fn boot() -> Result<App, String> {
//#     url = "postgres://localhost/app"
//#     db = postgres.pool(url)
//#     defer on error sql.close_quietly(db)
//#     queue = pgjobs.queue(db, url) |> Result.map_err(fn e -> "${e}")?
//#     Ok(App{..., db, queue, worker: Worker.new(queue, max_running: 4)})
//# }
//# ```
//#
//# `schema.sql` beside this file is the table, for a project's migrations to
//# copy, and `schema_upgrade.sql` brings a table made from an earlier
//# `schema.sql` up to it; `pgjobs.install(conn)` does both where needed, for
//# tests and small apps. `queue` checks the table first and returns an
//# error naming what an older table lacks.
//#
//# A worker claims due jobs with `FOR UPDATE SKIP LOCKED`, so workers in any
//# number of processes never take the same job. A claimed job holds a lease
//# its worker renews; when a worker dies, any other worker rescues its jobs
//# once their leases run out, so no process leads. An enqueue sends `NOTIFY`
//# on the table's name, which Postgres delivers at commit, and each worker
//# listens on it, so a job starts at once rather than at the next poll.
//# Finished jobs are kept for `retention`, 7 days unless given, then
//# deleted by any worker.
//#
//# A unique key is a partial unique index over the jobs that hold one, and
//# a unique enqueue is an `INSERT ... ON CONFLICT DO NOTHING` on the
//# caller's `Conn`, so a key taken in a transaction that rolls back is free
//# again. Each schedule's latest tick is a row of `nomi_jobs_schedules`,
//# written in the same transaction as the tick's job.

import {
    std::channels.{Arm, Channel, Receiver, Sender}
    std::duration.Duration
    std::instant.Instant
    std::jobs.{self, Claimed, Enqueued, JobId, NewJob, Queue, Settle}
    std::json.Json
    std::matcher.Matcher
    std::regex.Regex
    std::sql.{self, Conn, Row, Sql, Statement, Value}
    std::supervisors.Supervisor
    std::tasks.Task
    postgres.{self, Listener, Notification}
}

/// A queue in `table` of the database `db` points at. `url` names the same
/// database for the connection each worker listens on. Finished jobs are
/// deleted once they are older than `retention`.
///
/// It checks `table` on `db` first, and is an error when the table lacks a
/// column, index or table this version needs, as one made from an earlier
/// `schema.sql` does. The error names what is missing; `install`, or
/// `schema_upgrade.sql` run as a new migration, adds it. A table name that
/// is not lowercase letters, digits and `_` is an error too.
pub fn queue(
    db: Conn,
    url: String,
    table: String = "nomi_jobs",
    retention: Duration = Duration.hours(24 * 7),
) -> Result<Queue, sql.Error> {
    name =
        valid_table(table)
        |> Result.map_err(fn message -> sql.Error.Database{code: "42602", message})?

    check_schema(db, name)?
    Ok(Table{db, url, table: name, retention})
}

// The columns of the jobs table the queue's statements read or write.
once required_columns = [
    "id",
    "queue",
    "kind",
    "args",
    "state",
    "attempt",
    "max_attempts",
    "run_at",
    "locked_until",
    "locked_by",
    "errors",
    "inserted_at",
    "finished_at",
    "priority",
    "unique_key",
    "unique_states",
]

// An error naming what `table` lacks of what the queue's statements need:
// its columns, the unique index an enqueue's ON CONFLICT names, and the
// schedules table. Names resolve through the search path, as the queue's
// statements do. The other indexes only make it faster, and are not checked.
fn check_schema(db: Conn, table: String) -> Result<Unit, sql.Error> {
    schedules = "${table}_schedules"
    unique = "${table}_unique"

    statement = Sql"""
        SELECT 'column' AS kind, attname::text AS name FROM pg_attribute
        WHERE attrelid = to_regclass(${table}) AND attnum > 0 AND NOT attisdropped
        UNION ALL
        SELECT 'relation', relname::text FROM pg_class
        WHERE oid = to_regclass(${schedules}) OR oid = to_regclass(${unique})
        """

    rows = Conn.query(db, statement)?

    seed: Result<(List<String>, List<String>), sql.Error> = Ok(([], []))

    (columns, relations) = Iter.reduce(rows, seed, fn acc, row -> {
        (cs, rs) = acc?
        name = Row.get<String>(row, "name")?

        if Row.get<String>(row, "kind")? == "column" {
            Ok((cs + [name], rs))
        } else {
            Ok((cs, rs + [name]))
        }
    })?

    if columns == [] {
        return Err(
            sql.Error.Database{
                code: "42P01",
                message: "pgjobs: the jobs table ${table} does not exist. Call pgjobs.install(conn) before pgjobs.queue, or create it in a migration from lib/jobs/postgres's schema.sql${renamed(
                    table
                )}.",
            }
        )
    }

    missing_columns =
        required_columns
        |> Iter.filter(fn c -> not (c in columns))
        |> Iter.to_list()

    lacks =
        [
            if missing_columns != [] {
                "the columns ${String.join(missing_columns, ", ")}"
            } else {
                ""
            },
            if not (unique in relations) {
                "the index ${unique}"
            } else {
                ""
            },
            if not (schedules in relations) {
                "the table ${schedules}"
            } else {
                ""
            },
        ]
        |> Iter.filter(fn s -> s != "")
        |> Iter.to_list()

    if lacks == [] { return Ok(Unit) }

    Err(
        sql.Error.Database{
            code: "42703",
            message: "pgjobs: the jobs table ${table} is older than this version of pgjobs and lacks ${String.join(
                lacks,
                "; ",
            )}. Call pgjobs.install(conn) before pgjobs.queue, or add lib/jobs/postgres's schema_upgrade.sql to your migrations as a new migration${renamed(
                table
            )}.",
        }
    )
}

fn renamed(table: String) -> String {
    if table == "nomi_jobs" {
        ""
    } else {
        ", with nomi_jobs replaced by ${table}"
    }
}

/// Create `table`, its indexes and its schedules table, as `schema.sql`
/// declares them, where they are missing, and bring a table made from an
/// earlier `schema.sql` up to it, as `schema_upgrade.sql` does.
pub fn install(conn: Conn, table: String = "nomi_jobs") -> Result<Unit, sql.Error> {
    name =
        valid_table(table)
        |> Result.map_err(fn message -> sql.Error.Database{code: "42602", message})?

    statements = [
        Sql"""
        CREATE TABLE IF NOT EXISTS nomi_jobs (
            id           bigserial   PRIMARY KEY,
            queue        text        NOT NULL DEFAULT 'default',
            kind         text        NOT NULL,
            args         jsonb       NOT NULL,
            state        text        NOT NULL DEFAULT 'available'
                         CHECK (state IN ('available', 'running', 'completed', 'discarded')),
            attempt      integer     NOT NULL DEFAULT 0,
            max_attempts integer     NOT NULL,
            run_at       timestamptz NOT NULL DEFAULT now(),
            locked_until timestamptz,
            locked_by    text,
            errors       jsonb       NOT NULL DEFAULT '[]',
            inserted_at  timestamptz NOT NULL DEFAULT now(),
            finished_at  timestamptz,
            priority     integer     NOT NULL DEFAULT 0,
            unique_key   text,
            unique_states text       CHECK (unique_states IN ('live', 'kept'))
        )
        """,
        Sql"ALTER TABLE nomi_jobs ADD COLUMN IF NOT EXISTS priority integer NOT NULL DEFAULT 0",
        Sql"ALTER TABLE nomi_jobs ADD COLUMN IF NOT EXISTS unique_key text",
        Sql"ALTER TABLE nomi_jobs ADD COLUMN IF NOT EXISTS unique_states text CHECK (unique_states IN ('live', 'kept'))",
        Sql"DROP INDEX IF EXISTS nomi_jobs_due",
        Sql"CREATE INDEX IF NOT EXISTS nomi_jobs_ready ON nomi_jobs (queue, priority DESC, run_at, id) WHERE state = 'available'",
        Sql"CREATE INDEX IF NOT EXISTS nomi_jobs_lease ON nomi_jobs (locked_until) WHERE state = 'running'",
        Sql"CREATE INDEX IF NOT EXISTS nomi_jobs_done ON nomi_jobs (finished_at) WHERE state IN ('completed', 'discarded')",
        Sql"""
        CREATE UNIQUE INDEX IF NOT EXISTS nomi_jobs_unique ON nomi_jobs (unique_key)
        WHERE unique_key IS NOT NULL AND (unique_states = 'kept' OR state IN ('available', 'running'))
        """,
        Sql"CREATE TABLE IF NOT EXISTS nomi_jobs_schedules (name text PRIMARY KEY, last_tick timestamptz NOT NULL)",
    ]

    Iter.reduce(statements, Ok(Unit), fn done, statement -> {
        _ = done?
        _ = Conn.exec(conn, in_table(name, statement))?
        Ok(Unit)
    })
}

/// A job no worker has claimed for a while: its kind is one no running
/// worker handles, or no worker runs its queue.
pub struct StuckJob {
    id: JobId
    queue: String
    kind: String
    run_at: Instant
}

derive Equatable for StuckJob

/// The available jobs that have been due for longer than `older_than`, oldest
/// first, up to 100.
pub fn stuck(
    conn: Conn,
    older_than: Duration,
    table: String = "nomi_jobs",
) -> Result<List<StuckJob>, sql.Error> {
    name =
        valid_table(table)
        |> Result.map_err(fn message -> sql.Error.Database{code: "42602", message})?

    statement = Sql"""
        SELECT id, queue, kind, run_at FROM nomi_jobs
        WHERE state = 'available' AND run_at < now() - ${millis(older_than)} * interval '1 millisecond'
        ORDER BY run_at, id LIMIT 100
        """

    rows = Conn.query(conn, in_table(name, statement))?

    seed: Result<List<StuckJob>, sql.Error> = Ok([])

    Iter.reduce(rows, seed, fn acc, row -> {
        found = acc?
        id = Row.get<Int>(row, "id")?

        job = StuckJob{
            id: JobId(id),
            queue: Row.get<String>(row, "queue")?,
            kind: Row.get<String>(row, "kind")?,
            run_at: Row.get<Instant>(row, "run_at")?,
        }

        Ok(found + [job])
    })
}

struct Table {
    db: Conn
    url: String
    table: String
    retention: Duration
}

impl Queue for Table {
    fn insert(t: Table, conn: Conn, job: NewJob) -> Result<Enqueued, sql.Error> {
        insert_job(t, conn, job, 3)
    }

    fn claim(
        t: Table,
        worker: String,
        queues: List<String>,
        kinds: List<String>,
        limit: Int,
        lease: Duration,
    ) -> Result<List<Claimed>, sql.Error> {
        statement = Sql"""
            WITH picked AS (
                SELECT id FROM nomi_jobs
                WHERE state = 'available' AND run_at <= now()
                  AND queue = ANY(${queues}) AND kind = ANY(${kinds})
                ORDER BY priority DESC, run_at, id
                LIMIT ${limit}
                FOR UPDATE SKIP LOCKED
            )
            UPDATE nomi_jobs j
            SET state = 'running', attempt = j.attempt + 1,
                locked_until = now() + ${millis(
                                           lease
                                       )} * interval '1 millisecond', locked_by = ${worker}
            FROM picked WHERE j.id = picked.id
            RETURNING j.id, j.queue, j.kind, j.args, j.attempt, j.max_attempts, j.run_at, j.priority
            """

        rows = Conn.query(t.db, in_table(t.table, statement))?

        seed: Result<List<((Int, Int, Int), Claimed)>, sql.Error> = Ok([])

        claimed = Iter.reduce(rows, seed, fn acc, row -> {
            found = acc?
            run_at = Row.get<Instant>(row, "run_at")?
            c = claimed_of(row)?
            order = (0 - Row.get<Int>(row, "priority")?, Instant.as_nanos(run_at), id_of(c.id))
            Ok(found + [(order, c)])
        })?

        claimed
        |> Iter.sort_by(fn (order, _) -> order)
        |> Iter.map(fn (_, c) -> c)
        |> Iter.to_list()
        |> Ok()
    }

    fn renew(t: Table, worker: String, job: Claimed, lease: Duration) -> Result<Bool, sql.Error> {
        statement = Sql"""
            UPDATE nomi_jobs SET locked_until = now() + ${millis(lease)} * interval '1 millisecond'
            WHERE id = ${id_of(
                           job.id
                       )} AND attempt = ${job.attempt} AND locked_by = ${worker} AND state = 'running'
            """

        changed = Conn.exec(t.db, in_table(t.table, statement))?
        Ok(changed == 1)
    }

    fn settle(t: Table, worker: String, job: Claimed, how: Settle) -> Result<Bool, sql.Error> {
        id = id_of(job.id)

        statement = case how {
            .Completed -> Sql"""
                UPDATE nomi_jobs SET state = 'completed', finished_at = now(), locked_by = NULL, locked_until = NULL
                WHERE id = ${id} AND attempt = ${job.attempt} AND locked_by = ${worker} AND state = 'running'
                """

            .Retry{at, error} -> Sql"""
                UPDATE nomi_jobs SET state = 'available', run_at = ${at}, locked_by = NULL, locked_until = NULL,
                    errors = errors || jsonb_build_array(jsonb_build_object('attempt', attempt, 'at', now(), 'error', ${error}::text))
                WHERE id = ${id} AND attempt = ${job.attempt} AND locked_by = ${worker} AND state = 'running'
                """

            .Snoozed{at, error} -> Sql"""
                UPDATE nomi_jobs SET state = 'available', run_at = ${at}, attempt = attempt - 1,
                    locked_by = NULL, locked_until = NULL,
                    errors = errors || jsonb_build_array(jsonb_build_object('attempt', attempt, 'at', now(), 'error', ${error}::text))
                WHERE id = ${id} AND attempt = ${job.attempt} AND locked_by = ${worker} AND state = 'running'
                """

            .Discarded(error) -> Sql"""
                UPDATE nomi_jobs SET state = 'discarded', finished_at = now(), locked_by = NULL, locked_until = NULL,
                    errors = errors || jsonb_build_array(jsonb_build_object('attempt', attempt, 'at', now(), 'error', ${error}::text))
                WHERE id = ${id} AND attempt = ${job.attempt} AND locked_by = ${worker} AND state = 'running'
                """
        }

        changed = Conn.exec(t.db, in_table(t.table, statement))?
        Ok(changed == 1)
    }

    fn release(t: Table, worker: String) -> Result<Int, sql.Error> {
        statement = Sql"""
            UPDATE nomi_jobs SET state = 'available', attempt = attempt - 1, run_at = now(),
                locked_by = NULL, locked_until = NULL
            WHERE state = 'running' AND locked_by = ${worker}
            """

        Conn.exec(t.db, in_table(t.table, statement))
    }

    fn rescue(t: Table) -> Result<Int, sql.Error> {
        statement = Sql"""
            UPDATE nomi_jobs SET
                state = CASE WHEN attempt >= max_attempts THEN 'discarded' ELSE 'available' END,
                finished_at = CASE WHEN attempt >= max_attempts THEN now() END,
                run_at = now(), locked_by = NULL, locked_until = NULL,
                errors = errors || jsonb_build_array(jsonb_build_object('attempt', attempt, 'at', now(), 'error', 'lease expired'))
            WHERE state = 'running' AND locked_until < now()
            """

        Conn.exec(t.db, in_table(t.table, statement))
    }

    fn prune(t: Table) -> Result<Int, sql.Error> {
        statement = Sql"""
            DELETE FROM nomi_jobs WHERE id IN (
                SELECT id FROM nomi_jobs
                WHERE state IN ('completed', 'discarded')
                  AND finished_at < now() - ${millis(t.retention)} * interval '1 millisecond'
                LIMIT 1000
            )
            """

        Conn.exec(t.db, in_table(t.table, statement))
    }

    fn watch(t: Table, supervisor: Supervisor, wake: Sender<Unit>) -> Unit {
        stop: Channel<Unit> = Channel.buffered(1)
        Sender.close_on_drain(stop.sender)
        _ = Supervisor.spawn(supervisor, fn -> listen(t, wake, stop.receiver))
    }

    fn last_tick(t: Table, schedule: String) -> Result<Maybe<Instant>, sql.Error> {
        statement = Sql"SELECT last_tick FROM nomi_jobs_schedules WHERE name = ${schedule}"
        rows = Conn.query(t.db, in_table(t.table, statement))?

        case rows {
            [row, ..] -> Row.get<Instant>(row, "last_tick") |> Result.map(&Some(&1))
            [] -> Ok(None)
        }
    }

    fn record_tick(
        t: Table,
        schedule: String,
        tick: Instant,
        job: Maybe<NewJob>,
    ) -> Result<Maybe<Enqueued>, sql.Error> {
        statement = Sql"""
            INSERT INTO nomi_jobs_schedules (name, last_tick) VALUES (${schedule}, ${tick})
            ON CONFLICT (name) DO UPDATE
            SET last_tick = GREATEST(nomi_jobs_schedules.last_tick, EXCLUDED.last_tick)
            """

        sql.transaction(t.db, fn tx -> {
            _ = Conn.exec(tx, in_table(t.table, statement))?

            case job {
                Some(new_job) -> insert_job(t, tx, new_job, 3) |> Result.map(&Some(&1))
                None -> Ok(None)
            }
        })
    }
}

// Insert `job`, or find the job that holds its unique key. A holder that is
// gone by the time it is looked for, finished and pruned, frees the key, so
// the insert is tried again, up to `tries` times.
fn insert_job(t: Table, conn: Conn, job: NewJob, tries: Int) -> Result<Enqueued, sql.Error> {
    states = Maybe.map(job.unique_key, fn _ -> {
        case job.unique_across {
            .Live -> "live"
            .Kept -> "kept"
        }
    })

    statement = Sql"""
        INSERT INTO nomi_jobs (queue, kind, args, max_attempts, run_at, priority, unique_key, unique_states)
        VALUES (${job.queue}, ${job.kind}, ${Value.Json(job.args)}, ${job.max_attempts},
            COALESCE(${job.run_at}, now()), ${job.priority}, ${job.unique_key}, ${states})
        ON CONFLICT (unique_key)
            WHERE unique_key IS NOT NULL AND (unique_states = 'kept' OR state IN ('available', 'running'))
            DO NOTHING
        RETURNING id
        """

    rows = Conn.query(conn, in_table(t.table, statement))?

    case rows {
        [row, ..] -> {
            id = Row.get<Int>(row, "id")?
            _ = Conn.query(conn, Sql"SELECT pg_notify(${t.table}, ${job.queue})")?
            Ok(Enqueued{id: JobId(id), duplicate: False})
        }

        [] -> {
            holder = Sql"""
                SELECT id FROM nomi_jobs
                WHERE unique_key = ${job.unique_key}
                  AND (unique_states = 'kept' OR state IN ('available', 'running'))
                """

            case Conn.query(conn, in_table(t.table, holder))? {
                [row, ..] ->
                    Ok(Enqueued{id: JobId(Row.get<Int>(row, "id")?), duplicate: True})

                [] when tries > 1 ->
                    insert_job(t, conn, job, tries - 1)

                [] ->
                    Err(
                        sql.Error.Database{
                            code: "40001",
                            message: "the job holding the unique key kept changing",
                        }
                    )
            }
        }
    }
}

// Listen on the table's channel and wake the worker on each notification,
// until `stop` closes as shutdown starts. A connection that fails is opened
// again after a pause; the worker also claims on a timer, so a notification
// lost meanwhile costs at most a poll.
fn listen(t: Table, wake: Sender<Unit>, stop: Receiver<Unit>) {
    stopped = case postgres.listen(t.url, t.table) {
        Ok(listener) -> relay(listener, wake, stop)
        Err(_) -> False
    }

    if stopped { return }

    pause = Channel.select([
        Arm.receive(stop, fn got -> Maybe.is_none(got)),
        Arm.after(Duration.seconds(5), fn -> False),
    ])

    if not pause { listen(t, wake, stop) }
}

// Wake the worker for each notification `listener` hears. True when `stop`
// closed; False when the connection failed. Either way the listener is
// closed, which ends its forwarding task.
fn relay(listener: Listener, wake: Sender<Unit>, stop: Receiver<Unit>) -> Bool {
    heard: Channel<Result<Notification, sql.Error>> = Channel.buffered(4)

    concurrent {
        forwarding = Task.spawn(fn -> Listener.forward(listener, heard.sender))
        stopped = relay_until(heard.receiver, wake, stop)
        _ = Listener.close(listener)
        _ = Task.outcome(forwarding)
        stopped
    }
}

fn relay_until(
    heard: Receiver<Result<Notification, sql.Error>>,
    wake: Sender<Unit>,
    stop: Receiver<Unit>,
) -> Bool {
    next = Channel.select([
        Arm.receive(heard, fn got -> {
            case got {
                Some(Ok(_)) -> Relay.Heard
                _ -> Relay.Failed
            }
        }),
        Arm.receive(stop, fn got -> {
            if Maybe.is_none(got) {
                Relay.Stopped
            } else {
                Relay.Again
            }
        }),
    ])

    case next {
        .Heard -> {
            jobs.wake(wake)
            relay_until(heard, wake, stop)
        }

        .Again ->
            relay_until(heard, wake, stop)

        .Failed ->
            False

        .Stopped ->
            True
    }
}

enum Relay {
    Heard
    Again
    Failed
    Stopped
}

fn claimed_of(row: Row) -> Result<Claimed, sql.Error> {
    Ok(Claimed{
        id: JobId(Row.get<Int>(row, "id")?),
        queue: Row.get<String>(row, "queue")?,
        kind: Row.get<String>(row, "kind")?,
        args: Row.get<Json>(row, "args")?,
        attempt: Row.get<Int>(row, "attempt")?,
        max_attempts: Row.get<Int>(row, "max_attempts")?,
    })
}

fn id_of(JobId(n)) -> Int {
    n
}

fn millis(d: Duration) -> Int {
    Duration.as_millis(d)
}

// The statement against `table` in place of `nomi_jobs`, in its SQL text,
// never its parameters. The name is checked by valid_table.
fn in_table(table: String, statement: Statement) -> Statement {
    if table == "nomi_jobs" { return statement }

    Statement{
        parts: statement.parts
        |> Iter.map(&String.replace(&1, "nomi_jobs", table))
        |> Iter.to_list(),
        params: statement.params,
    }
}

fn valid_table(table: String) -> Result<String, String> {
    if Matcher.is_contained_in(Regex`^[a-z_][a-z0-9_]*$`, table) {
        Ok(table)
    } else {
        Err("table name ${table} is not lowercase letters, digits and _")
    }
}
