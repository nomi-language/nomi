//# Inputs that make a careless Markdown parser quadratic: long runs of
//# delimiters, brackets and backticks, unclosed constructs, and deep
//# nesting. Each is built at a size and at eight times it. One rendering
//# of the larger is timed against eight renderings of the smaller, which
//# is the same work for a linear parser, and it must take less than three
//# times as long: a quadratic parser takes eight.
//#
//# The rows of a `subtests` table share one test's time limit, so the
//# inputs are split by construct into tests that each take under half a
//# second on an idle machine, and stay inside the limit on one twenty times
//# slower.
//#
//# Timing the same amount of work at both sizes keeps a busy machine out of
//# the ratio: each measurement runs about as long, so the scheduler slows
//# both alike. The two are timed in turn, and each one's time is the least
//# of its runs so far, so a burst that slows one run is outlasted by the
//# next pair. The check passes at the first pair whose least times are
//# within the margin and fails after eight pairs that are not.

import
    std::duration.Duration
    std::instant.Instant
    markdown
end

/// The time `times` renderings of `source` take, in nanoseconds.
fn cost(source: String, times: Int) -> Int
    start = Instant.now()

    1..=times
    |> Iter.each(fn _ ->
        _ = markdown.render(source)
    end)

    Duration.as_nanos(Instant.between(start, Instant.now()))
end

/// Whether rendering what `make` builds at eight times `n` is linear in its
/// length, as `within` measures it.
fn scales_linearly(make: (NonNegativeInt) -> String, n: NonNegativeInt) -> Bool
    within(make(n), make(n * 8))
end

/// Whether one rendering of `large`, eight times as long as `small`, costs
/// less than three times eight renderings of `small`, in one of at most
/// eight pairs of runs. `small` is rendered once first, untimed, so its
/// first timed run does not include the machine compiling the renderer's
/// functions.
fn within(small: String, large: String) -> Bool
    _ = markdown.render(small)
    settles(small, large, 8, cost(small, 8), cost(large, 1))
end

/// Whether the least times so far, `least_small` and `least_large`, are
/// within the margin, or are after one more pair of runs, `pairs` counting
/// the pairs left including the one they came from.
fn settles(small: String, large: String, pairs: Int, least_small: Int, least_large: Int) -> Bool
    if least_large < 3 * Int.max(1, least_small) then
        True
    else if pairs <= 1 then
        False
    else
        s = Int.min(least_small, cost(small, 8))
        l = Int.min(least_large, cost(large, 1))
        settles(small, large, pairs - 1, s, l)
    end
end

test "brackets and links render in time linear in their length"
    [
        (
            "nested brackets",
            fn n: NonNegativeInt -> String.repeat("[", n) + "a" + String.repeat("]", n),
        ),
        ("open brackets",   fn n -> String.repeat("[", n) + "a"),
        ("links",           fn n -> String.repeat("[a](b) ", n)),
        ("unclosed titles", fn n -> String.repeat("[a](b \"", n)),
    ]
    |> subtests (name, make), name
        assert scales_linearly(make, 250)
    end
end

test "nested brackets render in time linear in their depth under a definition"
    // Each `]` of the nest may name a definition. A label over 999 bytes
    // names none, so a nest deeper than about 500 adds no `]` that looks
    // one up: the larger nest here, 480 deep, stays inside that cap. The
    // definition names no label of the nest, since a link made inside would
    // keep every label around it from looking.
    assert scales_linearly(
        fn n -> "[x]: /u\n\n" + String.repeat("[", n) + "a" + String.repeat("]", n),
        60,
    )
end

test "emphasis delimiters render in time linear in their length"
    [
        ("stars",               fn n: NonNegativeInt -> String.repeat("*", n)),
        ("stars between words", fn n -> String.repeat("*a ", n)),
        ("nested emphasis",     fn n -> String.repeat("*a **b ", n) + String.repeat(" c**", n)),
        ("underscores",         fn n -> String.repeat("_a_ ", n)),
    ]
    |> subtests (name, make), name
        assert scales_linearly(make, 250)
    end
end

test "backticks render in time linear in their length"
    [
        ("a run of backticks",  fn n: NonNegativeInt -> String.repeat("`", n)),
        ("unmatched backticks", fn n -> String.repeat("`a ", n)),
        (
            "backtick runs of many lengths",
            fn n ->
                Iter.map(1..n, fn k -> String.repeat("`", Int.max(0, k % 50 + 1)) + " x ")
                |> String.join("")
            end,
        ),
    ]
    |> subtests (name, make), name
        assert scales_linearly(make, 250)
    end
end

test "raw HTML, entities and addresses render in time linear in their length"
    [
        ("unclosed comments", fn n: NonNegativeInt -> String.repeat("<!-- ", n)),
        ("unclosed tags",     fn n -> String.repeat("<a ", n)),
        ("entities",          fn n -> String.repeat("&amp;", n)),
        ("addresses",         fn n -> String.repeat("a@b ", n)),
    ]
    |> subtests (name, make), name
        assert scales_linearly(make, 250)
    end
end

test "long runs of block lines render in time linear in their length"
    [
        (
            "table rows",
            fn n: NonNegativeInt -> "| a | b |\n|---|---|\n" + String.repeat("| x | y |\n", n),
        ),
        ("definitions",  fn n -> Iter.map(0..n, fn k -> "[l${k}]: /u${k}\n") |> String.join("")),
        ("quoted lines", fn n -> String.repeat("> a\n", n)),
    ]
    |> subtests (name, make), name
        assert scales_linearly(make, 250)
    end
end

test "deep nesting renders in time linear in the input's length"
    // A quote nested n deep on one line is n long; a list nested n deep is
    // about n * n long, so a list eight times as long is nearly three times
    // as deep.
    assert scales_linearly(fn n -> String.repeat("> ", n) + "a", 250)

    nested_list =
        fn depth: NonNegativeInt ->
            0..depth
            |> Iter.map(fn k -> String.repeat("  ", Int.max(0, k)) + "- a\n")
            |> String.join("")
        end

    assert within(nested_list(30), nested_list(85))
end
