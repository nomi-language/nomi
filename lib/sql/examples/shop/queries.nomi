/// A user's orders, newest first, each with the user's email.
pub fn orders_for_user(conn: sql.Conn, user_id: Int, limit: Int) -> Result<List<#{
    id: Int,
    status: OrderStatus,
    total: Decimal,
    placed_at: Instant,
    email: String,
}>, sql.Error> {
