// Generated by `nomi tool sqlkit generate` from db/migrations and db/queries.
// Do not edit: change the SQL and generate again.
// inputs sha256: 04f94ea8f0823ac07dba2fce670d1509139b0fae7df9a7ceadaf5b4ca0fd9ec0
// sqlkit release: unreleased
import sqlkit::inputs

// Fails when a migration or a query changed after the last
// `nomi tool sqlkit generate`: run it again. The paths are under the
// package root, where `nomi test` resolves a test's relative paths.
test "generated sql is current"
    assert inputs.current("db/migrations", "db/queries")
        == Ok("04f94ea8f0823ac07dba2fce670d1509139b0fae7df9a7ceadaf5b4ca0fd9ec0")
end

// Fails when a release of sqlkit other than the one that wrote these
// files is running: run `nomi tool sqlkit generate` again, since the
// running release may write other code or find problems in the SQL.
test "generated sql is from the running sqlkit"
    assert inputs.mismatch("unreleased", inputs.release(), "sqlkit") == None
end
