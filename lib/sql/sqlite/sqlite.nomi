//# SQLite for `std::sql`: `sqlite.open(path)`, `sqlite.open_in(dir, name)`
//# and `sqlite.memory()` return a `Conn` to one SQLite database. SQLite
//# runs inside the program, compiled to WebAssembly and run by std::wasm;
//# its file layer is Nomi over a std::fs `Dir`
//# (README.md, "How it runs").
//#
//# Parameters are bound as `?1`, `?2`, ..., never spliced into the SQL.
//# Values cross by SQLite's storage classes, and a column's declared type
//# picks the `Value` it reads as: `BOOLEAN` reads as `Bool`, `DATE`, `TIME`,
//# `DATETIME`/`TIMESTAMP` and `TIMESTAMPTZ` as the calendar values and
//# `Instant`, `DECIMAL`/`NUMERIC` as `Decimal`, `UUID` as `Uuid` and `JSON`
//# as `Json`. A value is written as the text or integer that type reads
//# back; an `Instant` as SQLite's own timestamps are, in UTC with no offset
//# (`2026-10-24 16:59:52`), so it compares in time order with
//# `CURRENT_TIMESTAMP`. A transaction is `BEGIN`; a transaction inside one
//# is a savepoint. One `Conn` may be shared by every task: tasks take turns
//# on the connection, and a transaction has it to itself until it ends, so
//# a statement from another task waits for the transaction (as long as
//# that task runs) and never runs inside it. A statement stops when its
//# task does. Foreign keys are enforced, and a constraint error names the
//# constraint as Postgres does (`users_email_key`). A file database waits
//# up to 5 seconds for a lock another connection holds. A trap in the
//# engine, a fault in SQLite's C code that its sandbox held, is
//# `Error.Engine` with the trap's text. The engine is dead after it: every
//# later operation of the connection that reaches the engine, `ping` and
//# `close` included, is `Error.Engine` too (a transaction's `rollback`
//# still ends it), and after the `close` every one is `Error.Closed`.
//#
//# SQLite has no decimal type: it stores a `DECIMAL(p, s)` column's values
//# as 64-bit floats, exact to 15 digits. A `Decimal` reads back from one at
//# the column's scale (`12.50d`, not `12.5d`), and the driver refuses, with
//# `Error.Database` coded `SQLITE_MISMATCH`, a `Decimal` of more than 15
//# digits it would write and a stored value that is not exactly a decimal
//# of the column's scale.

import
    std::channels.{Channel, Receiver, Sender}
    std::duration.Duration
    std::fs.{self, Dir}
    std::io
    std::path as file_path
    std::sql.{self, Conn, Dialect, Row, Statement}
    sqlite::internal::constraints
    sqlite::internal::engine.{self, Cell, Engine, Failure}
    sqlite::internal::values
    sqlite::internal::vfs
end

/// What every `Conn` of one connection shares: the engine and the
/// connection in it, the connection's turn, and its state.
///
/// Tasks share a connection by taking turns. SQLite has one transaction
/// per connection, so a statement sent through the connection while
/// another task's transaction is open would run inside that transaction.
/// Instead the connection has one turn: a statement sent through it holds
/// the turn while it runs, and a transaction holds it from its begin until
/// it ends. The statements of an open transaction and its savepoints need
/// no turn. Each statement holds the state while it runs, so one runs at a
/// time. A task waits for the turn before it takes the state, and nothing
/// waits for the turn while holding the state.
struct Shared
    engine: Engine
    handle: Int
    turn:   Channel<Unit>
    state:  Channel<State>
end

/// Whether the connection is closed, the token of each open level (the
/// transaction's first, then each savepoint's), and the last token given.
struct State
    closed: Bool
    stack:  List<Int>
    last:   Int
end

/// A connection to one SQLite database, or a transaction or savepoint on
/// it: what `open` and `memory` return, and what `Conn.begin_transaction`
/// returns on one. `depth` is 0 for the connection, 1 for a transaction and
/// more for each savepoint inside it; a level is open while its token is
/// on the stack at its depth.
pub opaque struct SqliteConn
    shared: Shared
    depth:  Int
    token:  Int
end

/// How many rows `each_row` takes from SQLite at a time.
once batch = 64

/// Open the SQLite database at `path`, creating it when it does not
/// exist. `":memory:"` is a fresh in-memory database, as `memory()` is.
/// A path that cannot be opened is `Err(.Connection)`. The connection opens
/// the directory the file is in as a `Dir` of its own, as `open_in` takes
/// one, and keeps its temporary files in `fs.temp_dir()`, or beside the
/// database when that cannot be opened.
pub fn open(path: String) -> Result<Conn, sql.Error>
    if path == ":memory:" then return memory()

    dir =
        fs.open_dir(
            file_path.parent(path)
            |> Option.with_default(".")
        )
        |> Result.map_err(unopened)?

    defer on error Dir.close(dir)
    temp = fs.open_dir(fs.temp_dir()) |> Result.to_option()
    connected(vfs.Place{dir: Some(dir), temp:, owned: True}, file_path.base(path))
end

/// Open the SQLite database `name` under `dir`, creating it when it does
/// not exist: what a program hands a library that should reach no file but
/// the database's. Its journal is beside it under `dir`, and its temporary
/// files are made in `temp`, or in `dir` when `temp` is `None`. The
/// connection reaches no other file, so a module that opens a database
/// this way, from a `Dir` it was passed, needs no `std::fs` in an effects
/// list. The `Dir`s stay the caller's: closing the connection leaves them
/// open. A name that cannot be opened is `Err(.Connection)`.
///
/// ```nomi
/// data = fs.open_dir("data")?
/// defer Dir.close(data)
///
/// db = sqlite.open_in(data, "todos.db")?
/// defer sql.close_quietly(db)
/// ```
pub fn open_in(dir: Dir, name: String, temp: Option<Dir> = None) -> Result<Conn, sql.Error>
    connected(vfs.Place{dir: Some(dir), temp:}, name)
end

/// A fresh in-memory database, which lives as long as its connection:
/// what a test opens for each case. Its temporary files are in
/// `fs.temp_dir()`.
pub fn memory() -> Result<Conn, sql.Error>
    temp = fs.open_dir(fs.temp_dir()) |> Result.to_option()
    connected(vfs.Place{temp:, owned: True}, ":memory:")
end

fn unopened(e: io.Error) -> sql.Error
    sql.Error.Connection{message: "unable to open database file: ${e}"}
end

/// The `sql.Error` a failure to open, ping or close the database is:
/// `Engine` when the engine failed, else `Connection`.
fn unconnected(f: Failure) -> sql.Error
    case f
        .Fault{message:}    -> sql.Error.Engine{message:}
        .Reported{message:} -> sql.Error.Connection{message:}
    end
end

/// A connection to the database `name`, whose files are in `place`.
fn connected(place: vfs.Place, name: String) -> Result<Conn, sql.Error>
    e = engine.start(place) |> Result.map_err(fn message -> sql.Error.Engine{message:})?
    defer on error engine.stop(e)
    handle = engine.open(e, name) |> Result.map_err(unconnected)?

    // A file another connection holds locked is waited for, up to 5 seconds.
    pragmas =
        if name == ":memory:" then
            "PRAGMA foreign_keys = ON"
        else
            "PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 5000"
        end

    _ = engine.exec(e, handle, pragmas, []) |> Result.map_err(unconnected)?

    turn = Channel.buffered<Unit>(1)
    _ = Sender.send(turn.sender, Unit)
    state = Channel.buffered<State>(1)
    _ = Sender.send(state.sender, State{closed: False, stack: [], last: 0})
    Ok(SqliteConn{shared: Shared{engine: e, handle:, turn:, state:}, depth: 0, token: 0})
end

impl Conn for SqliteConn
    fn query(conn: SqliteConn, statement: Statement) -> Result<List<Row>, sql.Error>
        params = values.params(statement)?
        answer = run(conn, sql_text(statement.parts), params)?
        query = "${statement}"
        answer.rows |> Iter.map(&values.row(query, answer.columns, &1)) |> Result.collect()
    end

    fn each_row(conn: SqliteConn, statement: Statement, f: (Row) -> Bool) -> Result<Unit, sql.Error>
        params = values.params(statement)?
        text = sql_text(statement.parts)
        query = "${statement}"

        entered(conn, fn _ ->
            prepared =
                engine.prepare(conn.shared.engine, conn.shared.handle, text, params)
                |> Result.map_err(&failure(conn.shared, &1, text, params))?

            if prepared.handle == 0 then return Ok(Unit)
            defer engine.finalize(conn.shared.engine, prepared.handle)
            batches(conn.shared, prepared, query, f)
        end)
    end

    fn exec(conn: SqliteConn, statement: Statement) -> Result<Int, sql.Error>
        params = values.params(statement)?
        answer = run(conn, sql_text(statement.parts), params)?
        Ok(answer.changed)
    end

    fn begin_transaction(conn: SqliteConn) -> Result<Conn, sql.Error>
        level =
            if conn.depth == 0 then
                begin_with_turn(conn)?
            else
                opened(conn)?
            end

        Ok(level)
    end

    fn commit(tx: SqliteConn) -> Result<Unit, sql.Error>
        update(tx.shared, fn state ->
            if tx.depth == 0 then
                return (
                    state,
                    Err(
                        if state.closed then
                            sql.Error.Closed
                        else
                            misuse("commit on a connection that is not a transaction")
                        end
                    ),
                )
            end

            if Err(e) = usable(tx, state) then return (state, Err(e))

            command =
                if tx.depth == 1 then
                    "COMMIT"
                else
                    "RELEASE SAVEPOINT sp${tx.depth}"
                end

            ended = {..state, stack: kept(state.stack, tx.depth - 1)}

            // A transaction whose COMMIT failed is still open (a deferred
            // foreign key, a lock): its rollback ends it.
            case statement(tx.shared, command)
                Ok(_)  -> (ended, Ok(Unit))
                Err(e) -> (state, Err(e))
            end
        end)
    end

    fn rollback(tx: SqliteConn) -> Result<Unit, sql.Error>
        update(tx.shared, fn state ->
            if tx.depth == 0 then
                return (
                    state,
                    Err(
                        if state.closed then
                            sql.Error.Closed
                        else
                            misuse("rollback on a connection that is not a transaction")
                        end
                    ),
                )
            end

            case usable(tx, state)
                Err(sql.Error.Finished) -> return (state, Ok(Unit))
                Err(e)                  -> return (state, Err(e))
                Ok(_)                   -> Unit
            end

            ended = {..state, stack: kept(state.stack, tx.depth - 1)}

            if tx.depth == 1 then
                // The transaction ends even when ROLLBACK fails: SQLite has
                // then rolled it back itself (after SQLITE_FULL,
                // SQLITE_IOERR or SQLITE_NOMEM, ROLLBACK finds no
                // transaction), and a transaction kept open would keep the
                // turn from every other task.
                case engine.exec(tx.shared.engine, tx.shared.handle, "ROLLBACK", [])
                    Ok(_) ->
                        (ended, Ok(Unit))

                    Err(.Reported{message:}) when String.contains(
                        message,
                        "no transaction is active",
                    ) ->
                        (ended, Ok(Unit))

                    Err(f) ->
                        (ended, Err(failure(tx.shared, f, "", [])))
                end
            else
                name = "sp${tx.depth}"

                case statement(tx.shared, "ROLLBACK TO SAVEPOINT ${name}")
                    Err(e) ->
                        (state, Err(e))

                    Ok(_) ->
                        case statement(tx.shared, "RELEASE SAVEPOINT ${name}")
                            Ok(_)  -> (ended, Ok(Unit))
                            Err(e) -> (state, Err(e))
                        end
                end
            end
        end)
    end

    fn ping(conn: SqliteConn) -> Result<Unit, sql.Error>
        locked(conn.shared, fn state ->
            if state.closed then
                Err(sql.Error.Closed)
            else
                engine.alive(conn.shared.engine) |> Result.map_err(unconnected)
            end
        end)
    end

    fn dialect(conn: SqliteConn) -> Dialect
        _ = conn
        Dialect.Sqlite
    end

    // Closes the connection, rolling back a transaction still open.
    // Closing it again does nothing.
    fn close(conn: SqliteConn) -> Result<Unit, sql.Error>
        update(conn.shared, fn state ->
            if state.closed then return (state, Ok(Unit))

            rolled =
                if state.stack != [] then
                    engine.exec(conn.shared.engine, conn.shared.handle, "ROLLBACK", [])
                    |> Result.map(fn _ -> Unit)
                else
                    Ok(Unit)
                end

            shut = engine.close(conn.shared.engine, conn.shared.handle)
            engine.stop(conn.shared.engine)
            closed = {..state, closed: True, stack: []}

            case (rolled, shut)
                (Err(f), _) ->
                    (closed, Err(unconnected(f)))

                (Ok(_), Err(.Reported{code:})) ->
                    (
                        closed,
                        Err(
                            sql.Error.Connection{
                                message: "SQLite could not close the database: ${code_name(code)}",
                            }
                        ),
                    )

                (Ok(_), Err(f)) ->
                    (closed, Err(unconnected(f)))

                (Ok(_), Ok(_)) ->
                    (closed, Ok(Unit))
            end
        end)
    end
end

/// The SQL of a statement's parts, with `?1`, `?2`, ... between them.
fn sql_text(parts: List<String>) -> String
    parts
    |> Iter.with_index()
    |> Iter.map(fn (index, part) -> if index == 0 then part else "?${index}${part}")
    |> String.join()
end

/// The first `n` tokens of `stack`.
fn kept(stack: List<Int>, n: Int) -> List<Int>
    stack
    |> Iter.take(
        NonNegativeInt.try_from(n)
        |> Option.with_default(0)
    )
    |> Iter.to_list()
end

fn misuse(message: String) -> sql.Error
    sql.Error.Database{code: "SQLITE_MISUSE", message:}
end

/// Runs `text` on the connection at `conn`'s level.
fn run(conn: SqliteConn, text: String, params: List<Cell>) -> Result<engine.Answer, sql.Error>
    entered(conn, fn _ ->
        engine.exec(conn.shared.engine, conn.shared.handle, text, params)
        |> Result.map_err(&failure(conn.shared, &1, text, params))
    end)
end

/// A statement of the driver's own, such as `COMMIT`, on the connection.
fn statement(shared: Shared, text: String) -> Result<Unit, sql.Error>
    engine.exec(shared.engine, shared.handle, text, [])
    |> Result.map(fn _ -> Unit)
    |> Result.map_err(&failure(shared, &1, "", []))
end

/// Runs `work` as a statement on `conn` runs: on the connection, with its
/// turn; on a transaction or savepoint, inside the transaction that holds
/// it. Either holds the state while it runs, and runs only on a level
/// that may run a statement.
fn entered<T>(conn: SqliteConn, work: (State) -> Result<T, sql.Error>) -> Result<T, sql.Error>
    checked =
        fn state: State ->
            runnable(conn, state)?
            work(state)
        end

    if conn.depth == 0 then
        turned(conn.shared, fn -> locked(conn.shared, checked))
    else
        locked(conn.shared, checked)
    end
end

/// `body` run while holding the connection's turn.
fn turned<T>(shared: Shared, body: () -> T) -> T
    _ = Receiver.receive(shared.turn.receiver)
    defer give(shared)
    body()
end

fn give(shared: Shared)
    _ = Sender.send(shared.turn.sender, Unit)
end

/// `body` run on the connection's state, which it holds while it runs.
fn locked<T>(shared: Shared, body: (State) -> T) -> T
    held = take(shared)
    defer put(shared, held)
    body(held)
end

fn take(shared: Shared) -> State
    case Receiver.receive(shared.state.receiver)
        Some(state) -> state
        None        -> unreachable "nothing closes a connection's state"
    end
end

fn put(shared: Shared, state: State)
    _ = Sender.send(shared.state.sender, state)
end

/// `body` run on the connection's state, which it holds while it runs, and
/// the state it answers put back; when `body` does not return, the state it
/// was given. A transaction that ends gives the connection's turn back.
fn update<T>(shared: Shared, body: (State) -> (State, T)) -> T
    after = Channel.buffered<State>(1)
    held = take(shared)
    defer settle(shared, after.receiver, held)
    (next, answer) = body(held)
    _ = Sender.send(after.sender, next)
    answer
end

fn settle(shared: Shared, after: Receiver<State>, held: State)
    next =
        case Receiver.receive_within(after, Duration.seconds(0))
            Ok(Some(answered)) -> answered
            _                  -> held
        end

    put(shared, next)
    if held.stack != [] and next.stack == [] then give(shared)
end

/// A transaction begun on the connection: it waits for the connection's
/// turn and holds it until it ends.
fn begin_with_turn(conn: SqliteConn) -> Result<Conn, sql.Error>
    _ = Receiver.receive(conn.shared.turn.receiver)
    defer on error give_unless_open(conn.shared)
    opened(conn)
end

/// Gives the turn back, unless a transaction holds it.
fn give_unless_open(shared: Shared)
    open = locked(shared, fn state -> state.stack != [])
    if not open then give(shared)
end

/// A transaction on the connection (depth 0), or a savepoint inside the
/// transaction or savepoint at `conn`'s depth.
fn opened(conn: SqliteConn) -> Result<Conn, sql.Error>
    update(conn.shared, fn state ->
        if Err(e) = usable(conn, state) then return (state, Err(e))

        if List.length(state.stack) != conn.depth then
            return (state, Err(misuse("a savepoint is already open inside this transaction")))
        end

        depth = conn.depth + 1
        token = state.last + 1
        opened = {..state, stack: List.concat(state.stack, [token]), last: token}

        command =
            if conn.depth == 0 then
                "BEGIN"
            else
                "SAVEPOINT sp${depth}"
            end

        case statement(conn.shared, command)
            Ok(_)  -> (opened, Ok(SqliteConn{shared: conn.shared, depth:, token:}))
            Err(e) -> (state, Err(e))
        end
    end)
end

/// Whether `conn`'s level may be used: `Closed` after a close, `Finished`
/// when its transaction or savepoint has ended.
fn usable(conn: SqliteConn, state: State) -> Result<Unit, sql.Error>
    if state.closed then return Err(sql.Error.Closed)
    if conn.depth == 0 then return Ok(Unit)

    case Iter.get(state.stack, conn.depth - 1)
        Some(token) when token == conn.token -> Ok(Unit)
        _                                    -> Err(sql.Error.Finished)
    end
end

/// `usable` for a statement, which must run on the innermost open
/// transaction or savepoint: SQLite has one transaction per connection, so
/// a statement sent through an outer transaction while a savepoint is open
/// would belong to the savepoint, and roll back with it. (One sent through
/// the connection waits for its turn, so no transaction is open when it
/// runs.)
fn runnable(conn: SqliteConn, state: State) -> Result<Unit, sql.Error>
    usable(conn, state)?

    if List.length(state.stack) > conn.depth then
        return Err(
            misuse(
                "a savepoint is open inside this transaction; run the statement on the Conn its begin answered"
            )
        )
    end

    Ok(Unit)
end

/// Each row of the prepared statement handed to `f`, a batch at a time,
/// until `f` returns `False` or the rows end.
fn batches(
    shared:   Shared,
    prepared: engine.Prepared,
    query:    String,
    f:        (Row) -> Bool,
) -> Result<Unit, sql.Error>
    width = Iter.count(prepared.columns.names)

    stepped =
        engine.step(shared.engine, prepared.handle, batch, width)
        |> Result.map_err(&failure(shared, &1, "", []))?

    more = each(stepped.rows, query, prepared.columns, f)?

    if more and not stepped.ended then
        batches(shared, prepared, query, f)
    else
        Ok(Unit)
    end
end

/// Each of `rows` handed to `f`: `False` when `f` stopped.
fn each(
    rows:    List<List<Cell>>,
    query:   String,
    columns: engine.Columns,
    f:       (Row) -> Bool,
) -> Result<Bool, sql.Error>
    case rows
        [] ->
            Ok(True)

        [cells, ..rest] ->
            row = values.row(query, columns, cells)?

            if f(row) then
                each(rest, query, columns, f)
            else
                Ok(False)
            end
    end
end

/// The `sql.Error` a failure of the engine is. The engine's own fault is
/// `Engine`. Of what SQLite reports, a constraint error keeps the
/// constraint, named as Postgres names it (internal/constraints.nomi); a
/// statement its task's stop interrupted is a `Timeout`; a file that cannot
/// be opened or read is a `Connection` error.
fn failure(shared: Shared, f: Failure, text: String, params: List<Cell>) -> sql.Error
    case f
        .Fault{message:} ->
            sql.Error.Engine{message:}

        .Reported{code:, message:} ->
            db = constraints.Db{engine: shared.engine, handle: shared.handle}

            case constraints.error(db, code, message, text, params)
                Some(e) ->
                    e

                None ->
                    case code &&& 0xff
                        9  -> sql.Error.Timeout
                        10 -> sql.Error.Connection{message:}
                        14 -> sql.Error.Connection{message:}
                        26 -> sql.Error.Connection{message:}
                        _  -> sql.Error.Database{code: code_name(code), message:}
                    end
            end
    end
end

/// SQLite's name for a result code: `SQLITE_CONSTRAINT_UNIQUE` for 2067,
/// the primary code's name for an extended code this does not name, or the
/// number.
fn code_name(code: Int) -> String
    named =
        fn c: Int ->
            case c
                1    -> Some("SQLITE_ERROR")
                2    -> Some("SQLITE_INTERNAL")
                3    -> Some("SQLITE_PERM")
                4    -> Some("SQLITE_ABORT")
                5    -> Some("SQLITE_BUSY")
                6    -> Some("SQLITE_LOCKED")
                7    -> Some("SQLITE_NOMEM")
                8    -> Some("SQLITE_READONLY")
                9    -> Some("SQLITE_INTERRUPT")
                10   -> Some("SQLITE_IOERR")
                11   -> Some("SQLITE_CORRUPT")
                13   -> Some("SQLITE_FULL")
                14   -> Some("SQLITE_CANTOPEN")
                17   -> Some("SQLITE_SCHEMA")
                18   -> Some("SQLITE_TOOBIG")
                19   -> Some("SQLITE_CONSTRAINT")
                20   -> Some("SQLITE_MISMATCH")
                21   -> Some("SQLITE_MISUSE")
                25   -> Some("SQLITE_RANGE")
                26   -> Some("SQLITE_NOTADB")
                275  -> Some("SQLITE_CONSTRAINT_CHECK")
                787  -> Some("SQLITE_CONSTRAINT_FOREIGNKEY")
                1299 -> Some("SQLITE_CONSTRAINT_NOTNULL")
                1555 -> Some("SQLITE_CONSTRAINT_PRIMARYKEY")
                2067 -> Some("SQLITE_CONSTRAINT_UNIQUE")
                _    -> None
            end
        end

    named(code) |> Option.or_else(fn -> named(code &&& 0xff)) |> Option.with_default("${code}")
end
