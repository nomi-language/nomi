//# Asking SQLite about a schema and its statements, for tools such as
//# `nomi tool sqlkit generate`: `describe.describe(migrations, statements)`
//# applies the migrations to a fresh in-memory database and returns its
//# tables and, for each statement, its result columns (with the table
//# column each one reads, from SQLite's column metadata), its parameter
//# count and query plan, or the error that stopped it from preparing and
//# the byte SQLite gave for it.

import
    sqlite::internal::engine.{self, Cell, Engine, Failure}
    sqlite::internal::vfs
end

/// One migration: its path and its SQL.
pub struct Migration
    path: String
    text: String
end

/// A column of a table as the schema declares it, and the migration that
/// last created or changed it.
pub struct TableColumn
    name:        String
    declared:    String
    not_null:    Bool
    primary_key: Bool
    has_default: Bool
    migration:   String
end

/// A table: its name, the `CREATE TABLE` statement SQLite keeps for it,
/// its columns, and the migration that created it.
pub struct Table
    name:      String
    sql:       String
    columns:   List<TableColumn>
    migration: String
end

/// A result column: its name, the declared type of the table column it
/// reads (`""` for an expression), that table and column, and whether that
/// column is `NOT NULL` (or an `INTEGER PRIMARY KEY`).
pub struct Column
    name:     String
    declared: String
    table:    String
    origin:   String
    not_null: Bool
end

/// What SQLite says of a statement: its columns, parameter count and query
/// plan lines, or its error and the byte the error is at (-1 for none).
pub struct Statement
    columns: List<Column>
    params:  Int
    plan:    List<String>
    error:   String
    offset:  Int
end

/// The tables the migrations build and each statement's description; or,
/// when a migration fails, its error (with `migration` naming it and
/// `offset` the byte of its text) and nothing else.
pub struct Description
    tables:     List<Table>
    statements: List<Statement>
    error:      String
    migration:  String
    offset:     Int
end

/// Apply `migrations` in order to a fresh in-memory database and describe
/// each of `statements` against the schema they build.
pub fn describe(migrations: List<Migration>, statements: List<String>) -> Description
    none = Description{tables: [], statements: [], error: "", migration: "", offset: -1}

    case engine.start(vfs.Place{})
        Err(message) ->
            {..none, error: message}

        Ok(e) ->
            defer engine.stop(e)

            case engine.open(e, ":memory:")
                Err(f) -> {..none, error: reason(f).first}
                Ok(db) -> described(e, db, migrations, statements, none)
            end
    end
end

fn described(
    e:          Engine,
    db:         Int,
    migrations: List<Migration>,
    statements: List<String>,
    none:       Description,
) -> Description
    _ = engine.exec(e, db, "PRAGMA foreign_keys = ON", [])

    // Each table's first migration, and each column's (by its table, name
    // and declared type) first.
    applied = Iter.try_reduce(migrations, ({}, {}), fn (created, changed), m ->
        case engine.exec(e, db, m.text, [])
            Err(f) ->
                (error, offset) = reason(f)
                Err({..none, error:, migration: m.path, offset:})

            Ok(_) ->
                Ok(
                    tables(e, db)
                    |> Iter.reduce((created, changed), fn (made, columns), t ->
                        (
                            if Map.get(made, t.name) is Some(_) then
                                made
                            else
                                Map.put(made, t.name, m.path)
                            end,
                            t.columns
                            |> Iter.reduce(columns, fn acc, c ->
                                k = key(t.name, c)

                                if Map.get(acc, k) is Some(_) then
                                    acc
                                else
                                    Map.put(acc, k, m.path)
                                end
                            end),
                        )
                    end)
                )
        end
    end)

    case applied
        Err(failed) ->
            failed

        Ok((created, changed)) ->
            built =
                tables(e, db)
                |> Iter.map(fn t ->
                    {
                        ..t,
                        migration: Map.get(created, t.name) |> Option.with_default(""),
                        columns: t.columns
                        |> Iter.map(fn c -> {
                            ..c,
                            migration: Map.get(changed, key(t.name, c)) |> Option.with_default(""),
                        })
                        |> Iter.to_list(),
                    }
                end)
                |> Iter.to_list()

            {
                ..none,
                tables:     built,
                statements: statements |> Iter.map(&statement(e, db, &1)) |> Iter.to_list(),
            }
    end
end

fn key(table: String, c: TableColumn) -> (String, String, String)
    (table, c.name, c.declared)
end

/// The rows of a query, each value as text (`""` for NULL), or none when
/// it fails.
fn rows(e: Engine, db: Int, sql: String) -> List<List<String>>
    case engine.exec(e, db, sql, [])
        Ok(answer) ->
            answer.rows
            |> Iter.map(fn row -> row |> Iter.map(text) |> Iter.to_list())
            |> Iter.to_list()

        Err(_) ->
            []
    end
end

fn text(c: Cell) -> String
    case c
        .Integer(n) -> "${n}"
        .Real(x)    -> "${x}"
        .Text(s)    -> s
        .Blob(b)    -> Bytes.to_string_lossy(b)
        .Null       -> ""
    end
end

/// The tables of the database, by name, with their columns.
fn tables(e: Engine, db: Int) -> List<Table>
    rows(
        e,
        db,
        "SELECT name, sql FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name",
    )
    |> Iter.flat_map(fn row ->
        case row
            [name, sql] -> [Table{name:, sql:, columns: columns(e, db, name), migration: ""}]
            _           -> []
        end
    end)
    |> Iter.to_list()
end

fn columns(e: Engine, db: Int, table: String) -> List<TableColumn>
    quoted = "'${String.replace(table, "'", "''")}'"

    rows(
        e,
        db,
        "SELECT name, type, \"notnull\", pk, dflt_value IS NOT NULL FROM pragma_table_info(${quoted}) ORDER BY cid",
    )
    |> Iter.flat_map(fn row ->
        case row
            [name, declared, not_null, pk, has_default] ->
                [
                    TableColumn{
                        name:,
                        declared:,
                        not_null:    not_null == "1",
                        primary_key: pk != "0",
                        has_default: has_default == "1",
                        migration:   "",
                    },
                ]

            _ ->
                []
        end
    end)
    |> Iter.to_list()
end

/// One statement prepared and described, with its query plan.
fn statement(e: Engine, db: Int, sql: String) -> Statement
    none = Statement{columns: [], params: 0, plan: [], error: "", offset: -1}

    case engine.describe(e, db, sql)
        Err(f) ->
            (error, offset) = reason(f)
            {..none, error:, offset:}

        Ok(d) ->
            columns =
                d.columns
                |> Iter.map(fn c ->
                    Column{
                        name:     c.name,
                        declared: c.declared,
                        table:    c.table,
                        origin:   c.origin,
                        not_null: c.not_null,
                    }
                end)
                |> Iter.to_list()

            if d.more then
                return {
                    ..none,
                    columns:,
                    params: d.params,
                    error:  "a query is one statement; this one has more after it",
                    offset: 0,
                }
            end

            plan =
                rows(e, db, "EXPLAIN QUERY PLAN ${sql}")
                |> Iter.flat_map(fn row ->
                    case row
                        [_, _, _, detail] -> [detail]
                        _                 -> []
                    end
                end)
                |> Iter.to_list()

            {..none, columns:, params: d.params, plan:}
    end
end

/// A failure's message, and the byte of the SQL it is at (-1 for none).
fn reason(f: Failure) -> (String, Int)
    case f
        .Reported{message:, at:} -> (message, at)
        .Fault{message:}         -> ("the SQLite engine failed: ${message}", -1)
    end
end
