import
    std::calendar.{Date, NaiveDateTime, Time}
    std::channels.{Channel, Receiver, Sender}
    std::duration.Duration
    std::instant.Instant
    std::json.Json
    std::sql.{self, Conn, ConstraintKind, Dialect, Row, Sql, Value}
    std::sql::testing
    std::tasks.Task
    std::timer
    std::uuid.Uuid
    sqlite
end

test "the driver passes std/sql/testing's conformance suite"
    failures = testing.conformance(fn -> sqlite.memory())
    assert failures == []
end

test "the conformance suite runs every rule"
    assert Iter.count(testing.rules()) == 29
end

test "a connection says it is SQLite"
    db = sqlite.memory()?
    defer sql.close_quietly(db)
    assert Conn.dialect(db) == Dialect.Sqlite
end

fn values_db() -> Result<Conn, sql.Error>
    db = sqlite.memory()?
    defer on error sql.close_quietly(db)

    _ = Conn.exec(
        db,
        Sql"""
        CREATE TABLE v (
            i INTEGER, f REAL, d DECIMAL(12, 2), t TEXT, b BOOLEAN, x BLOB,
            day DATE, at TIME, ts DATETIME, tz TIMESTAMPTZ, id UUID, j JSON
        )
        """,
    )?

    Ok(db)
end

test "every Value reads back as the Value it was written as"
    db = values_db()?
    defer sql.close_quietly(db)
    day = Date"2026-10-19"
    at = Time"12:30:05"
    ts = NaiveDateTime"2026-10-19T12:30:05"
    tz = Instant.from_seconds(1_760_000_000)
    id = Uuid"0192f4c8-6f0e-7b39-9d6a-3c1f2b5e8a10"
    j = Json.decode("{\"a\":[1,2]}")?
    bytes = String.to_bytes("hi")

    _ = Conn.exec(
        db,
        Sql"""
        INSERT INTO v VALUES (${7}, ${2.5}, ${12.25d}, ${"text"}, ${True}, ${bytes},
        ${day}, ${at}, ${ts}, ${tz}, ${id}, ${j})
        """,
    )?

    rows = Conn.query(db, Sql"SELECT * FROM v")?

    Some(row) = Iter.first(rows) else
        None -> return Err(sql.Error.Database{code: "", message: "no row"})
    end

    assert Row.values(row) == [
        Value.Int(7),
        Value.Float(2.5),
        Value.Decimal(12.25d),
        Value.Text("text"),
        Value.Bool(True),
        Value.Bytes(bytes),
        Value.Date(day),
        Value.Time(at),
        Value.Timestamp(ts),
        Value.Timestamptz(tz),
        Value.Uuid(id),
        Value.Json(j),
    ]
end

test "NULL reads back as Null in a column of every type"
    db = values_db()?
    defer sql.close_quietly(db)
    nothing: Maybe<Int> = None
    _ = Conn.exec(db, Sql"INSERT INTO v (i, day) VALUES (${nothing}, ${nothing})")?
    rows = Conn.query(db, Sql"SELECT i, day, j FROM v")?
    assert rows |> Iter.map(Row.values) |> Iter.to_list() == [[Value.Null, Value.Null, Value.Null]]
end

test "an expression's column has no declared type and keeps its storage class"
    db = sqlite.memory()?
    defer sql.close_quietly(db)
    rows = Conn.query(db, Sql"SELECT count(*) AS n, 'x' || ${"y"} AS s, 1.5 AS f")?

    assert rows |> Iter.map(Row.values) |> Iter.to_list() == [
        [Value.Int(1), Value.Text("xy"), Value.Float(1.5)],
    ]
end

fn money_db() -> Result<Conn, sql.Error>
    db = sqlite.memory()?
    defer on error sql.close_quietly(db)
    _ = Conn.exec(db, Sql"CREATE TABLE m (id INTEGER PRIMARY KEY, amount DECIMAL(12, 2))")?
    Ok(db)
end

// The text of each amount, which shows its scale: `==` on Decimal does not.
fn amounts(db: Conn) -> Result<List<String>, sql.Error>
    rows = Conn.query(db, Sql"SELECT amount FROM m ORDER BY id")?

    rows
    |> Iter.map(fn row -> Row.get<Decimal>(row, "amount") |> Result.map(fn d -> "${d}"))
    |> Result.collect()
end

// The message of a SQLITE_MISMATCH error, or what the result was instead.
fn mismatch<T>(result: Result<T, sql.Error>) -> String
    case result
        Err(sql.Error.Database{code: "SQLITE_MISMATCH", message:}) -> message
        Err(e) -> "another error: ${e}"
        Ok(_) -> "Ok"
    end
end

test "a Decimal reads back at its column's scale"
    db = money_db()?
    defer sql.close_quietly(db)

    _ = Conn.exec(
        db,
        Sql"INSERT INTO m (amount) VALUES (${12.50d}), (${12.5d}), (${7d}), (${0.10d}), (${-3.05d})",
    )?

    // SQLite keeps them as the REALs 12.5, 7 and 0.1: the scale is the column's.
    assert amounts(db)? == ["12.50", "12.50", "7.00", "0.10", "-3.05"]
    _ = Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (${9_999_999_999_999.99d})")?
    assert amounts(db)? |> Iter.last() == Some("9999999999999.99")
end

test "a Decimal SQLite would round is refused when it is written"
    db = money_db()?
    defer sql.close_quietly(db)
    big = 123_456_789_012_345_678.91d

    assert mismatch(
        Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (${big})")
    ) == "parameter ?1 is the Decimal 123456789012345678.91, of 20 digits: SQLite stores a decimal as a 64-bit float, exact to 15 digits, and would round it; keep the amount as INTEGER minor units (cents), or write its text as a String into a TEXT column"

    // 2^53 + 1 cents: one digit too many for a float to hold.
    assert mismatch(Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (${90_071_992_547_409.93d})"))
        |> String.starts_with("parameter ?1 is the Decimal 90071992547409.93, of 16 digits")

    assert amounts(db)? == []
end

test "an Int past 64 bits is refused when it is written"
    db = money_db()?
    defer sql.close_quietly(db)
    top = 9_223_372_036_854_775_807

    assert mismatch(
        Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (${top + 1})")
    ) == "parameter ?1 is the Int 9223372036854775808, past the signed 64-bit range of an SQLite INTEGER; write its text as a String into a TEXT column"

    assert mismatch(Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (${-top - 2})"))
        |> String.starts_with("parameter ?1 is the Int -9223372036854775809,")

    assert amounts(db)? == []
end

test "the Ints at the ends of the 64-bit range are written and read back"
    db = sqlite.memory()?
    defer sql.close_quietly(db)
    _ = Conn.exec(db, Sql"CREATE TABLE n (v INTEGER NOT NULL)")?

    _ = Conn.exec(
        db,
        Sql"INSERT INTO n (v) VALUES (${9_223_372_036_854_775_807}), (${-9_223_372_036_854_775_808})",
    )?

    rows = Conn.query(db, Sql"SELECT v FROM n ORDER BY v")?
    values = rows |> Iter.map(&Row.value(&1, "v")) |> Iter.to_list()

    assert values == [
        Ok(Value.Int(-9_223_372_036_854_775_808)),
        Ok(Value.Int(9_223_372_036_854_775_807)),
    ]
end

test "a stored value that is not exactly a decimal of the column's scale is refused"
    db = money_db()?
    defer sql.close_quietly(db)
    _ = Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (12.555)")?

    assert mismatch(
        amounts(db)
    ) == "the column `amount` is DECIMAL(12, 2) and holds 12.555, which has more than 2 decimals: SQLite does not round a DECIMAL column to its scale, so round the value before writing it"

    // Written by SQL the driver did not bind: SQLite rounds it to a float.
    _ = Conn.exec(db, Sql"DELETE FROM m")?
    _ = Conn.exec(db, Sql"INSERT INTO m (amount) VALUES (90071992547409.93)")?

    assert mismatch(amounts(db))
        |> String.starts_with("the column `amount` is DECIMAL(12, 2) and holds 90071992547409.94")
end

fn users_db() -> Result<Conn, sql.Error>
    db = sqlite.memory()?
    defer on error sql.close_quietly(db)

    _ = Conn.exec(
        db,
        Sql"""
        CREATE TABLE users (
            id INTEGER PRIMARY KEY,
            email TEXT NOT NULL UNIQUE,
            handle TEXT,
            age INTEGER CONSTRAINT age_positive CHECK (age > 0)
        )
        """,
    )?

    _ = Conn.exec(db, Sql"CREATE UNIQUE INDEX users_handle_key ON users (handle)")?

    _ = Conn.exec(
        db,
        Sql"""
        CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users (id))
        """,
    )?

    _ = Conn.exec(db, Sql"INSERT INTO users (email, handle) VALUES ('a@example.com', 'a')")?
    Ok(db)
end

fn constraint(result: Result<Int, sql.Error>) -> Maybe<sql.Error>
    case result
        Err(e) -> Some(e)
        Ok(_)  -> None
    end
end

test "a UNIQUE column's violation has Postgres's name for it, and names the table and column"
    db = users_db()?
    defer sql.close_quietly(db)
    e = constraint(Conn.exec(db, Sql"INSERT INTO users (email) VALUES ('a@example.com')"))

    assert e == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.Unique,
            name:   "users_email_key",
            table:  Some("users"),
            column: Some("email"),
        }
    )
end

test "a unique index's violation names the index"
    db = users_db()?
    defer sql.close_quietly(db)

    e = constraint(
        Conn.exec(db, Sql"INSERT INTO users (email, handle) VALUES ('b@example.com', 'a')")
    )

    assert e == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.Unique,
            name:   "users_handle_key",
            table:  Some("users"),
            column: Some("handle"),
        }
    )
end

test "NOT NULL, CHECK and foreign key violations are constraint errors"
    db = users_db()?
    defer sql.close_quietly(db)
    nothing: Maybe<String> = None

    assert constraint(Conn.exec(db, Sql"INSERT INTO users (email) VALUES (${nothing})")) == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.NotNull,
            name:   "users_email_not_null",
            table:  Some("users"),
            column: Some("email"),
        }
    )

    assert constraint(
        Conn.exec(db, Sql"INSERT INTO users (email, age) VALUES ('c@example.com', 0)")
    ) == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.Check,
            name:   "age_positive",
            table:  Some("users"),
            column: Some("age"),
        }
    )

    assert constraint(Conn.exec(db, Sql"INSERT INTO orders (user_id) VALUES (99)")) == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.ForeignKey,
            name:   "orders_user_id_fkey",
            table:  Some("orders"),
            column: Some("user_id"),
        }
    )

    assert constraint(
        Conn.exec(db, Sql"INSERT INTO users (id, email) VALUES (1, 'd@example.com')")
    ) == Some(
        sql.Error.Constraint{
            kind:   ConstraintKind.Unique,
            name:   "users_pkey",
            table:  Some("users"),
            column: Some("id"),
        }
    )
end

test "SQL the engine rejects is a Database error with its message"
    db = sqlite.memory()?
    defer sql.close_quietly(db)

    assert Conn.query(db, Sql"SELECT nope FROM nowhere")
        == Err(sql.Error.Database{code: "SQLITE_ERROR", message: "no such table: nowhere"})
end

test "exec answers the rows a statement changed"
    db = users_db()?
    defer sql.close_quietly(db)

    _ = Conn.exec(db, Sql"INSERT INTO users (email) VALUES ('b@example.com'), ('c@example.com')")?

    assert Conn.exec(db, Sql"UPDATE users SET age = 30") == Ok(3)
end

fn events_db() -> Result<Conn, sql.Error>
    db = sqlite.memory()?
    defer on error sql.close_quietly(db)

    _ = Conn.exec(
        db,
        Sql"CREATE TABLE events (n INTEGER, at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP)",
    )?

    Ok(db)
end

fn ns(db: Conn, statement: sql.Statement) -> Result<List<Int>, sql.Error>
    rows = Conn.query(db, statement)?
    rows |> Iter.map(fn row -> Row.get<Int>(row, "n")) |> Result.collect()
end

test "an Instant compares in time order with CURRENT_TIMESTAMP"
    db = events_db()?
    defer sql.close_quietly(db)
    now = Instant.now()
    hour_ago = now - Duration.hours(1)
    hour_later = now + Duration.hours(1)
    _ = Conn.exec(db, Sql"INSERT INTO events (n, at) VALUES (1, ${hour_ago})")?
    _ = Conn.exec(db, Sql"INSERT INTO events (n) VALUES (2)")?
    _ = Conn.exec(db, Sql"INSERT INTO events (n, at) VALUES (3, ${hour_later})")?
    assert ns(db, Sql"SELECT n FROM events WHERE at > ${hour_ago} ORDER BY n")? == [2, 3]
    assert ns(db, Sql"SELECT n FROM events WHERE at < ${hour_later} ORDER BY n")? == [1, 2]
    assert ns(db, Sql"SELECT n FROM events ORDER BY at")? == [1, 2, 3]
    assert ns(db, Sql"SELECT n FROM events ORDER BY at DESC")? == [3, 2, 1]
end

test "an Instant is written as SQLite writes a timestamp, and either form reads back"
    db = events_db()?
    defer sql.close_quietly(db)
    whole = Instant.from_seconds(1_760_000_000)
    half = whole + Duration.milliseconds(500)
    _ = Conn.exec(db, Sql"INSERT INTO events (n, at) VALUES (1, ${whole}), (2, ${half})")?
    _ = Conn.exec(db, Sql"INSERT INTO events (n, at) VALUES (3, '2025-10-09T08:53:20+00:00')")?
    texts = Conn.query(db, Sql"SELECT '' || at AS text FROM events ORDER BY n")?

    assert texts |> Iter.map(fn row -> Row.get<String>(row, "text")) |> Iter.to_list() == [
        Ok("2025-10-09 08:53:20"),
        Ok("2025-10-09 08:53:20.5"),
        Ok("2025-10-09T08:53:20+00:00"),
    ]

    rows = Conn.query(db, Sql"SELECT at FROM events ORDER BY n")?

    assert rows |> Iter.map(fn row -> Row.get<Instant>(row, "at")) |> Iter.to_list() == [
        Ok(whole),
        Ok(half),
        Ok(whole),
    ]
end

test "a path that cannot be opened is a Connection error"
    opened = case sqlite.open("/nonexistent/dir/x.db")
        Err(sql.Error.Connection{message: _}) -> "Connection"
        Err(e) -> "${e}"
        Ok(_) -> "Ok"
    end

    assert opened == "Connection"
end

test "an Array parameter is refused, since SQLite has no arrays"
    db = sqlite.memory()?
    defer sql.close_quietly(db)

    assert Conn.query(db, Sql"SELECT 1 WHERE 1 IN (${[1, 2]})") == Err(
        sql.Error.Database{
            code:    "SQLITE_MISMATCH",
            message: "parameter ?1 is an Array, and SQLite has no array type; bind one parameter per element, as in `IN (?1, ?2)`, or the elements as JSON text",
        }
    )
end

// One task holds a transaction open until told to end it, with `outcome`;
// meanwhile another writes and reads through the shared connection. The
// other's statements wait for the transaction and run outside it.
fn beside_a_transaction(
    outcome: Result<Unit, sql.Error>,
) -> Result<(Result<Unit, sql.Error>, Result<Int, sql.Error>, List<Int>, List<Int>), sql.Error>
    db = sqlite.memory()?
    defer sql.close_quietly(db)
    _ = Conn.exec(db, Sql"CREATE TABLE t (n INTEGER)")?
    opened: Channel<Unit> = Channel.buffered(1)
    finish: Channel<Unit> = Channel.buffered(1)

    (held, wrote, read) = concurrent
        holder = Task.spawn(fn ->
            sql.transaction(db, fn tx ->
                _ = Conn.exec(tx, Sql"INSERT INTO t VALUES (1)")?
                _ = Sender.send(opened.sender, Unit)
                _ = Receiver.receive(finish.receiver)
                outcome
            end)
        end)

        _ = Receiver.receive(opened.receiver)

        other = Task.spawn(fn ->
            wrote = Conn.exec(db, Sql"INSERT INTO t VALUES (2)")
            read = Conn.query(db, Sql"SELECT n FROM t ORDER BY n")
            (wrote, read)
        end)

        // The other task's statements are waiting by now.
        timer.sleep(Duration.milliseconds(50))
        _ = Sender.send(finish.sender, Unit)
        (wrote, read) = Task.await(other)
        (Task.await(holder), wrote, read)
    end

    seen =
        read?
        |> Iter.map(fn row -> Row.get<Int>(row, "n") |> Result.with_default(0))
        |> Iter.to_list()

    after =
        Conn.query(db, Sql"SELECT n FROM t ORDER BY n")?
        |> Iter.map(fn row -> Row.get<Int>(row, "n") |> Result.with_default(0))
        |> Iter.to_list()

    Ok((held, wrote, seen, after))
end

test "a statement from another task waits for an open transaction, then runs outside it"
    assert beside_a_transaction(Ok(Unit)) == Ok((Ok(Unit), Ok(1), [1, 2], [1, 2]))
end

test "a rolled-back transaction leaves another task's write standing"
    failed = Err(sql.Error.Database{code: "X", message: "undo"})
    assert beside_a_transaction(failed) == Ok((failed, Ok(1), [2], [2]))
end
