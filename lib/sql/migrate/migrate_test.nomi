import {
    std::fs
    std::sql.{self, Conn, Row, Sql, Statement}
    std::tasks.Task
    migrate.{self, Error, Migration, Status}
    migrate::checksum
    postgres
    sqlite
}

// A migration in db/migrations.
fn m(name: String, text: String) -> Migration {
    Migration{path: "db/migrations/${name}", sql: text}
}

// Runs body on a fresh database of each engine: SQLite in memory, and a
// database of the process's scratch Postgres server (which needs `initdb`
// and `postgres` on PATH). Answers each engine's name and result.
fn on_each<T>(body: (Conn) -> Result<T, Error>) -> List<#(String, Result<T, Error>)> {
    opens: List<#(String, () -> Result<Conn, sql.Error>)> = [
        #("sqlite", fn -> sqlite.memory()),
        #("postgres", fn -> postgres.connect(postgres.scratch()?)),
    ]

    opens
    |> Iter.map(fn #(name, open) -> {
        result = case open() {
            Ok(db) -> {
                answer = body(db)
                sql.close_quietly(db)
                answer
            }

            Err(error) ->
                Err(Error.Database{error})
        }

        #(name, result)
    })
    |> Iter.to_list()
}

// The same answer from both engines.
fn both<T>(answer: Result<T, Error>) -> List<#(String, Result<T, Error>)> {
    [#("sqlite", answer), #("postgres", answer)]
}

fn db_error(error: sql.Error) -> Error {
    Error.Database{error}
}

// The recorded versions, in order.
fn recorded(db: Conn) -> Result<List<String>, Error> {
    rows =
        Conn.query(db, Sql"SELECT version FROM nomi_migrations ORDER BY version")
        |> Result.map_err(db_error)?

    rows
    |> Iter.map(fn row -> Row.get<String>(row, "version"))
    |> Result.collect()
    |> Result.map_err(db_error)
}

fn count(db: Conn, table: String) -> Result<Int, Error> {
    statement = Statement{parts: ["SELECT count(*) AS n FROM ${table}"], params: []}
    rows = Conn.query(db, statement) |> Result.map_err(db_error)?

    case rows {
        [row, ..] -> Row.get<Int>(row, "n") |> Result.map_err(db_error)
        [] -> Ok(0)
    }
}

once users: Migration = m(
    "1_users.sql",
    "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL);\nCREATE INDEX users_email ON users (email);\n",
)

once orders: Migration = m(
    "2_orders.sql",
    "CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users (id))",
)

once seed: Migration = m(
    "3_seed.sql",
    "INSERT INTO users (id, email) VALUES (1, 'ada@example.com')",
)

test "read lists a directory's migrations in name order, without down files or subdirectories" {
    got = fs.with_temp_dir(fn dir -> {
        fs.write_text("${dir}/000002_orders.up.sql", "B")?
        fs.write_text("${dir}/000001_users.up.sql", "A")?
        fs.write_text("${dir}/000001_users.down.sql", "DROP TABLE users")?
        fs.write_text("${dir}/README.md", "notes")?
        fs.create_dir("${dir}/old")?
        fs.write_text("${dir}/old/9.sql", "S")?

        Ok(
            migrate.read(dir)
            |> Result.map(fn ms -> {
                ms
                |> Iter.map(fn mig -> #(String.replace(mig.path, "${dir}/", ""), mig.sql))
                |> Iter.to_list()
            })
        )
    })?

    assert got == Ok([#("000001_users.up.sql", "A"), #("000002_orders.up.sql", "B")])
}

test "read refuses a directory that does not exist" {
    refused = case migrate.read("no/such/migrations") {
        Err(Error.Read{path, message: _}) -> path
        Err(e) -> "${e}"
        Ok(_) -> "Ok"
    }

    assert refused == "no/such/migrations"
}

test "apply runs each migration once, in order, and records it with its checksum" {
    answers = on_each(fn db -> {
        first = migrate.apply(db, [users, orders, seed])?
        again = migrate.apply(db, [users, orders, seed])?

        sums =
            Conn.query(db, Sql"SELECT version, checksum FROM nomi_migrations ORDER BY version")
            |> Result.map_err(db_error)?
            |> Iter.map(fn row -> Row.get<String>(row, "checksum"))
            |> Result.collect()
            |> Result.map_err(db_error)?

        Ok(#(first, again, sums, count(db, "users")?))
    })

    assert answers == both(
        Ok(
            #(
                ["1_users.sql", "2_orders.sql", "3_seed.sql"],
                [],
                [checksum.of(users.sql), checksum.of(orders.sql), checksum.of(seed.sql)],
                1,
            )
        )
    )
}

test "a migration whose text changed is refused before anything runs" {
    answers = on_each(fn db -> {
        _ = migrate.apply(db, [users, orders])?
        edited = #{..users, sql: "CREATE TABLE users (id INTEGER PRIMARY KEY, mail TEXT)"}
        refused = migrate.apply(db, [edited, orders, seed])
        Ok(#(refused, recorded(db)?, count(db, "users")?))
    })

    assert answers == both(
        Ok(
            #(
                Err(Error.Changed{path: "db/migrations/1_users.sql"}),
                ["1_users.sql", "2_orders.sql"],
                0,
            )
        )
    )
}

test "a failing migration keeps the ones before it and leaves itself and the rest out" {
    broken = #{..orders, sql: "CREATE TABL orders (id INTEGER)"}

    answers = on_each(fn db -> {
        failed = case migrate.apply(db, [users, broken, seed]) {
            Err(Error.Failed{path, error: _}) -> path
            Err(e) -> "${e}"
            Ok(ran) -> "ran ${ran}"
        }

        after_failure = recorded(db)?
        fixed = migrate.apply(db, [users, orders, seed])?
        Ok(#(failed, after_failure, fixed))
    })

    assert answers == both(
        Ok(#("db/migrations/2_orders.sql", ["1_users.sql"], ["2_orders.sql", "3_seed.sql"]))
    )
}

test "status sorts the migrations by where they stand, and creates nothing" {
    edited = #{..orders, sql: "CREATE TABLE orders (id INTEGER PRIMARY KEY)"}

    answers = on_each(fn db -> {
        fresh = migrate.status(db, [users, orders])?
        still_fresh = migrate.status(db, [users, orders])?
        _ = migrate.apply(db, [users, orders])?
        later = migrate.status(db, [edited, seed])?
        Ok(#(fresh == still_fresh, fresh, later))
    })

    assert answers == both(
        Ok(
            #(
                True,
                Status{
                    applied: [],
                    pending: ["db/migrations/1_users.sql", "db/migrations/2_orders.sql"],
                    changed: [],
                    missing: [],
                },
                Status{
                    applied: [],
                    pending: ["db/migrations/3_seed.sql"],
                    changed: ["db/migrations/2_orders.sql"],
                    missing: ["1_users.sql"],
                },
            )
        )
    )
}

// golang-migrate's own table, as it leaves it at `version`.
fn golang_migrate_at(db: Conn, version: Int, dirty: Bool) -> Result<Unit, Error> {
    _ =
        Conn.exec(
            db,
            Sql"CREATE TABLE schema_migrations (version BIGINT NOT NULL PRIMARY KEY, dirty BOOLEAN NOT NULL)",
        )
        |> Result.map_err(db_error)?

    _ =
        Conn.exec(
            db,
            Sql"INSERT INTO schema_migrations (version, dirty) VALUES (${version}, ${dirty})",
        )
        |> Result.map_err(db_error)?

    Ok(Unit)
}

once g1: Migration = m("000001_users.up.sql", "CREATE TABLE users (id INTEGER PRIMARY KEY)")

once g2: Migration = m("000002_orders.up.sql", "CREATE TABLE orders (id INTEGER PRIMARY KEY)")

once g3: Migration = m("000003_notes.up.sql", "CREATE TABLE notes (id INTEGER PRIMARY KEY)")

test "adopting golang-migrate's state records its migrations without running them" {
    answers = on_each(fn db -> {
        // What golang-migrate left: the first two applied.
        _ =
            Conn.exec(db, Sql"CREATE TABLE users (id INTEGER PRIMARY KEY)")
            |> Result.map_err(db_error)?

        _ =
            Conn.exec(db, Sql"CREATE TABLE orders (id INTEGER PRIMARY KEY)")
            |> Result.map_err(db_error)?

        golang_migrate_at(db, 2, False)?

        adopted = migrate.adopt_golang_migrate(db, [g1, g2, g3])?
        again = migrate.adopt_golang_migrate(db, [g1, g2, g3])?
        ran = migrate.apply(db, [g1, g2, g3])?
        Ok(#(adopted, again, ran))
    })

    assert answers
        == both(Ok(#(["000001_users.up.sql", "000002_orders.up.sql"], [], ["000003_notes.up.sql"])))
}

// The message of an adoption refused, or what came back instead.
fn adopt_refusal(db: Conn, migrations: List<Migration>) -> Result<String, Error> {
    case migrate.adopt_golang_migrate(db, migrations) {
        Err(Error.Adopt{message}) -> Ok(message)
        Err(e) -> Err(e)
        Ok(versions) -> Ok("adopted ${versions}")
    }
}

test "adoption refuses a dirty version, a version with no file, and a database golang-migrate never ran" {
    answers = on_each(fn db -> {
        none = adopt_refusal(db, [g1])?
        golang_migrate_at(db, 2, True)?
        dirty = adopt_refusal(db, [g1, g2])?

        _ =
            Conn.exec(db, Sql"UPDATE schema_migrations SET version = 5, dirty = ${False}")
            |> Result.map_err(db_error)?

        unknown = adopt_refusal(db, [g1, g2])?
        // A refusal rolls back, so nothing was recorded.
        left = migrate.status(db, [g1, g2])?
        Ok(#(none, dirty, unknown, left.applied))
    })

    assert answers == both(
        Ok(
            #(
                "no `schema_migrations` table: there is no golang-migrate state to adopt",
                "golang-migrate marked version 2 dirty: a migration it left half-applied; resolve it with golang-migrate (`migrate force`) first",
                "golang-migrate is at version 5, and no migration has that number",
                [],
            )
        )
    )
}

// Opens its own connection to url, applies, and closes.
fn apply_at(url: String, migrations: List<Migration>) -> Result<List<String>, Error> {
    db = postgres.connect(url) |> Result.map_err(db_error)?
    defer sql.close_quietly(db)
    migrate.apply(db, migrations)
}

test "two processes that migrate one Postgres database at once run each migration once" {
    url = postgres.scratch()?

    slow = [
        m("1_slow.sql", "SELECT pg_sleep(0.3); CREATE TABLE t (n INTEGER)"),
        m("2_row.sql", "INSERT INTO t VALUES (1)"),
    ]

    runs = concurrent {
        a = Task.spawn(fn -> apply_at(url, slow))
        b = Task.spawn(fn -> apply_at(url, slow))
        [Task.await(a), Task.await(b)]
    }

    // One run did both; the other waited for its lock and found nothing to do.
    assert runs |> Iter.all(fn r -> Result.is_ok(r))

    ran =
        runs
        |> Iter.map(fn r -> r |> Result.map(fn vs -> Iter.count(vs)) |> Result.with_default(-1))
        |> Iter.sort()
        |> Iter.to_list()

    assert ran == [0, 2]

    db = postgres.connect(url)?
    defer sql.close_quietly(db)
    assert count(db, "t") == Ok(1)
}
