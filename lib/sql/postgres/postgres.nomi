//# Postgres for `std::sql`, written in Nomi over std::net and std::tls:
//# `postgres.pool(url)` returns a `Conn` over a pool of connections, and
//# `postgres.connect(url)` one over a single connection. `postgres.scratch()`
//# makes a fresh empty database on a throwaway server, for tests, and
//# `postgres.listen(url, channel)` hears `NOTIFY`.
//#
//# Parameters are bound as `$1`, `$2`, ..., never spliced into the SQL.
//# Each `Value` is sent as the type the server inferred for its parameter,
//# and a column reads back by its type: `BIGINT` and the other integers as
//# `Int`, `NUMERIC` as `Decimal`, `TIMESTAMPTZ` as `Timestamptz`, `JSON`
//# and `JSONB` as `Json`, an array as `Array`, and a type with no `Value`
//# of its own (an interval, an enum) as its text. A time is kept to the
//# microsecond, as Postgres stores it.
//#
//# A task stopped while a statement runs (a cancelled task, a passed
//# `Context.with_timeout` deadline) stops at the next wait, within a tenth
//# of a second; the statement is cancelled on the server and the
//# connection stays usable. A transaction holds one connection of the pool
//# until it ends; a transaction inside one is a savepoint. A constraint
//# error names the constraint as Postgres does, and a not-null violation as
//# Postgres 18 names it (`users_email_not_null`). How the protocol is
//# spoken is in `wire.nomi`, `session.nomi` and `pool.nomi`.

import
    std::channels.{Arm, Channel, Receiver, Sender}
    std::duration.Duration
    std::sql.{self, Conn, Dialect, Row, Statement}
    std::supervisors.Supervisor
    postgres::cell.Cell
    postgres::config
    postgres::pooled.{self, Db, Level}
    postgres::scratch as scratch_server
    postgres::session
    postgres::wire.{self, Link}
end

/// A pool of connections to a Postgres database, or a transaction or
/// savepoint on it: what `pool` and `connect` return, and what
/// `Conn.begin_transaction` returns on one.
pub opaque struct PgConn
    db:    Db
    level: Maybe<Level>
end

/// A pool of connections to the database at `url`
/// (`postgres://user:password@host:5432/name`, or `host=... dbname=...`).
/// It connects lazily: an unreachable server, or a `url` that does not
/// parse, is `Err(.Connection)` from the first statement, so a program that
/// must fail early calls `Conn.ping` on it. Statements run on any
/// connection of the pool, and a transaction on one it holds until it
/// ends.
pub fn pool(url: String) -> Conn
    PgConn{db: pooled.pool(config.parse(url)), level: None}
end

/// One connection to the database at `url`, opened now: an unreachable
/// server is `Err(.Connection)`. A transaction has the whole connection
/// to itself until it ends, so a statement another task sends through the
/// connection meanwhile waits for it; inside the transaction, use the
/// `Conn` its `begin` returned. What a temporary table needs, since it
/// lives on one connection.
pub fn connect(url: String) -> Result<Conn, sql.Error>
    parsed = config.parse(url) |> Result.map_err(fn message -> sql.Error.Connection{message:})?
    Ok(PgConn{db: pooled.single(parsed)?, level: None})
end

/// The URL of a fresh empty database on a throwaway server, for tests:
/// `postgres.connect(postgres.scratch()?)`. The first call in a process
/// starts the server, with the `initdb` and `postgres` on `PATH`, in a
/// temporary directory and on a free local port; it stops and its directory
/// is removed when the process ends. Each call makes another database on
/// it. A machine with no `initdb` or `postgres` on `PATH`, or no POSIX
/// shell, returns `Err(.Connection)` saying so.
pub fn scratch() -> Result<String, sql.Error>
    scratch_server.database()
end

/// A connection of its own that listens on one channel, from `listen`.
pub opaque struct Listener
    handle: ListenHandle
end

// The listener's link, the turn a `wait` holds while it reads, and what
// `close` and the tests read.
struct ListenHandle
    link:  Link
    turn:  Cell<Unit>
    state: Cell<ListenState>
end

struct ListenState
    closing:  Bool
    waiting:  Bool
    received: Int
end

/// A notification: the channel it was sent on and its payload, as
/// `NOTIFY channel, 'payload'` or `pg_notify(channel, payload)` sent it.
pub struct Notification
    channel: String
    payload: String
end

derive Equatable for Notification

/// A `Listener` on `channel` of the database at `url`, over a connection
/// of its own, opened now: an unreachable server is `Err(.Connection)`. A
/// notification sent on the channel from then on waits for the listener's
/// next `wait`, in the order they were sent.
pub fn listen(url: String, channel: String) -> Result<Listener, sql.Error>
    parsed = config.parse(url) |> Result.map_err(fn message -> sql.Error.Connection{message:})?
    link = wire.open(parsed)?

    case session.simple(link, "LISTEN ${identifier(channel)}")
        Ok(_) ->
            Ok(
                Listener{
                    handle: ListenHandle{
                        link:,
                        turn:  Cell.new(Unit),
                        state: Cell.new(ListenState{closing: False, waiting: False, received: 0}),
                    },
                }
            )

        Err(e) ->
            wire.close(link)
            Err(e)
    end
end

// `name` quoted as an SQL identifier.
fn identifier(name: String) -> String
    "\"${String.replace(name, "\"", "\"\"")}\""
end

impl Listener
    /// The next notification, waiting for one as long as it takes. A
    /// `Context.with_timeout` deadline or a cancelled task stops the wait,
    /// and the listener still works. After `close` it is `Err(.Closed)`.
    pub fn wait(listener: Listener) -> Result<Notification, sql.Error>
        h = listener.handle
        if Cell.read(h.state).closing then return Err(sql.Error.Closed)
        Cell.update(h.turn, fn _ -> (Unit, heard(h)))
    end

    /// Closes the listener's connection. A `wait` running on another task
    /// ends with `Err(.Closed)`. Closing it again does nothing.
    pub fn close(listener: Listener) -> Result<Unit, sql.Error>
        h = listener.handle
        first = Cell.update(h.state, fn state -> ({..state, closing: True}, not state.closing))

        // Once the running wait, if any, has seen the listener closing.
        Cell.update(h.turn, fn _ ->
            if first then wire.close(h.link)

            (Unit, Unit)
        end)

        Ok(Unit)
    end

    /// The listener's notifications as a channel, so one can be an arm of
    /// `Channel.select` beside a timer or another channel: `forward` runs
    /// in a task under `supervisor`, which an app creates in `boot`, and the
    /// channel holds up to `capacity` notifications the reader has not
    /// taken yet. Call it once per listener.
    pub fn receiver(
        listener:   Listener,
        supervisor: Supervisor,
        capacity:   PositiveInt = 16,
    ) -> Receiver<Result<Notification, sql.Error>>
        channel = Channel.buffered<Result<Notification, sql.Error>>(capacity)
        _ = Supervisor.spawn(supervisor, fn -> Listener.forward(listener, channel.sender))
        channel.receiver
    end

    /// Waits for each notification and sends it on `sender`, until the
    /// listener closes, the calling task is cancelled (as a supervisor's
    /// drain does at shutdown), or the connection fails. Then it closes
    /// `sender` and returns. A failure is sent first, as the last value,
    /// `Err(e)`: a reader that receives `None` knows the listener was
    /// closed or the task was stopped, and one that receives `Err` knows
    /// the connection failed. `forward` must be `sender`'s only sender,
    /// since it closes the channel. While the channel is full it looks
    /// every 200 milliseconds at whether the listener was closed, so
    /// `close` ends it even when nothing reads the channel. Two tasks
    /// forwarding one listener take turns, and each notification goes to
    /// one of them.
    pub fn forward(listener: Listener, sender: Sender<Result<Notification, sql.Error>>)
        case Listener.wait(listener)
            Ok(notification) ->
                if deliver(listener, sender, Ok(notification)) then
                    Listener.forward(listener, sender)
                else
                    Sender.close(sender)
                end

            Err(.Closed) ->
                Sender.close(sender)

            Err(.Timeout) ->
                Sender.close(sender)

            Err(e) ->
                _ = deliver(listener, sender, Err(e))
                Sender.close(sender)
        end
    end
end

// One wait, holding the listener's turn: the next notification its link
// hears, or `Closed` once the listener is closing.
fn heard(h: ListenHandle) -> Result<Notification, sql.Error>
    if Cell.read(h.state).closing then return Err(sql.Error.Closed)
    mark_waiting(h, True)
    defer mark_waiting(h, False)

    case wire.hear(h.link, fn -> Cell.read(h.state).closing)?
        Some(note) ->
            Cell.update(h.state, fn state -> ({..state, received: state.received + 1}, Unit))
            Ok(Notification{channel: note.channel, payload: note.payload})

        None ->
            Err(sql.Error.Closed)
    end
end

fn mark_waiting(h: ListenHandle, waiting: Bool)
    Cell.update(h.state, fn state -> ({..state, waiting:}, Unit))
end

// Whether `close` has been called on the listener.
fn listener_closed_raw(h: ListenHandle) -> Bool
    Cell.read(h.state).closing
end

// Whether a `wait` is waiting on the server now; for this module's tests.
fn listener_waiting_raw(h: ListenHandle) -> Bool
    Cell.read(h.state).waiting
end

// How many notifications `wait` has returned; for this module's tests.
fn listener_received_raw(h: ListenHandle) -> Int
    Cell.read(h.state).received
end

// How often a send blocked on a full channel looks again at whether its
// listener was closed. A closed listener otherwise keeps the task until
// the reader takes a value or the program stops.
once forward_recheck = Duration.milliseconds(200)

// Sends `value`, looking again every `forward_recheck` at whether the
// listener was closed while the channel stays full. False when it was.
fn deliver(
    listener: Listener,
    sender:   Sender<Result<Notification, sql.Error>>,
    value:    Result<Notification, sql.Error>,
) -> Bool
    sent = Channel.select([
        Arm.send(sender, value, fn _ -> Some(True)),
        Arm.after(forward_recheck, fn -> None),
    ])

    case sent
        Some(_) ->
            True

        None ->
            if listener_closed_raw(listener.handle) then
                False
            else
                deliver(listener, sender, value)
            end
    end
end

impl Conn for PgConn
    fn query(conn: PgConn, statement: Statement) -> Result<List<Row>, sql.Error>
        sql = text(statement)
        label = "${statement}"

        (rows, _) = pooled.statement(conn.db, conn.level, fn link ->
            session.run(link, sql, label, statement.params, [], fn rows, row ->
                ([row, ..rows], True)
            end)
        end)?

        Ok(Iter.reverse(rows))
    end

    fn each_row(conn: PgConn, statement: Statement, f: (Row) -> Bool) -> Result<Unit, sql.Error>
        sql = text(statement)
        label = "${statement}"

        pooled.statement(conn.db, conn.level, fn link ->
            session.run(link, sql, label, statement.params, Unit, fn _, row -> (Unit, f(row)))
        end)
        |> Result.map(fn _ -> Unit)
    end

    fn exec(conn: PgConn, statement: Statement) -> Result<Int, sql.Error>
        sql = text(statement)
        label = "${statement}"

        pooled.statement(conn.db, conn.level, fn link ->
            if statement.params == [] then
                session.simple(link, sql)
            else
                session.run(link, sql, label, statement.params, Unit, fn _, _ -> (Unit, True))
                |> Result.map(.second)
            end
        end)
    end

    fn begin_transaction(conn: PgConn) -> Result<Conn, sql.Error>
        level =
            case conn.level
                None     -> pooled.start(conn.db)?
                Some(at) -> pooled.savepoint(conn.db, at)?
            end

        Ok(PgConn{db: conn.db, level: Some(level)})
    end

    fn commit(tx: PgConn) -> Result<Unit, sql.Error>
        case tx.level
            Some(at) -> pooled.commit(tx.db, at)
            None     -> not_a_transaction(tx, "commit")
        end
    end

    fn rollback(tx: PgConn) -> Result<Unit, sql.Error>
        case tx.level
            Some(at) -> pooled.rollback(tx.db, at)
            None     -> not_a_transaction(tx, "rollback")
        end
    end

    fn ping(conn: PgConn) -> Result<Unit, sql.Error>
        pooled.ping(conn.db, conn.level)
    end

    fn dialect(conn: PgConn) -> Dialect
        _ = conn
        Dialect.Postgres
    end

    fn close(conn: PgConn) -> Result<Unit, sql.Error>
        pooled.close(conn.db)
    end
end

fn not_a_transaction(conn: PgConn, what: String) -> Result<Unit, sql.Error>
    if pooled.is_closed(conn.db) then return Err(sql.Error.Closed)

    Err(
        sql.Error.Database{
            code:    "25P01",
            message: "${what} on a connection that is not a transaction",
        }
    )
end

// The statement's SQL with `$1`, `$2`, ... between its parts.
fn text(statement: Statement) -> String
    statement.parts
    |> Iter.with_index()
    |> Iter.map(fn (i, part) -> if i == 0 then part else "$${i}${part}")
    |> String.join("")
end
