//# Answering the server's password challenge: SCRAM-SHA-256 (RFC 5802
//# and RFC 7677), which Postgres asks for by default, bound to the TLS
//# connection under it as SCRAM-SHA-256-PLUS when the server offers that,
//# and the older MD5 hash. Each step is a function from what the server sent to what the
//# client sends, so the exchange is checked against the RFC's recorded
//# messages; the connection sends them.
//#
//# The password is used as it is written, with no SASLprep: Postgres
//# accepts that for every password made of printable ASCII, and for
//# others where the server stored it the same way.

import
    std::base64
    std::hash
end

/// How the client binds its SCRAM exchange to the connection under it:
/// the GS2 header of its first message (RFC 5802, section 7), and the data
/// its final message's `c=` carries.
pub enum Binding
    /// The connection is not TLS, so the client binds nothing: `n`.
    Unsupported
    /// The connection is TLS and the server offered no -PLUS mechanism:
    /// `y`, which a server that did offer one takes as a sign that its offer
    /// was taken out on the way, and refuses.
    NotOffered
    /// SCRAM-SHA-256-PLUS: `p=` and the binding's name, with the binding
    /// data std::tls computed for the connection.
    Bound {name: String, data: Bytes}
end

/// What the client keeps between its first SCRAM message and its last:
/// its first message without the GS2 header, its nonce, the header and
/// the channel binding data.
pub struct Scram
    first_bare: String
    nonce:      String
    header:     String = "n,,"
    binding:    Bytes = Bytes.from_list([])
end

/// What the client sends for the server's challenge, and the server
/// signature the server's final message must carry.
pub struct ScramProof
    message:   String
    signature: Bytes
end

impl Scram
    /// The client's first message, with `nonce` and `binding`, and no user
    /// name, since Postgres takes the startup message's.
    //! s = Scram.start("rOprNGfwEbeRWgbNEkqO")
    //! assert Scram.first_message(s) == "n,,n=,r=rOprNGfwEbeRWgbNEkqO"
    //! assert Scram.mechanism(s) == "SCRAM-SHA-256"
    //!
    //! bound = Scram.start("abc", Binding.Bound{name: "tls-server-end-point", data: Bytes.from_list([1])})
    //! assert Scram.first_message(bound) == "p=tls-server-end-point,,n=,r=abc"
    //! assert Scram.mechanism(bound) == "SCRAM-SHA-256-PLUS"
    //! assert Scram.first_message(Scram.start("abc", Binding.NotOffered)) == "y,,n=,r=abc"
    //
    pub fn start(nonce: String, binding: Binding = Binding.Unsupported) -> Scram
        (header, data) =
            case binding
                .Unsupported         -> ("n,,", Bytes.from_list([]))
                .NotOffered          -> ("y,,", Bytes.from_list([]))
                .Bound{name:, data:} -> ("p=${name},,", data)
            end

        Scram{first_bare: "n=,r=${nonce}", nonce:, header:, binding: data}
    end

    /// The text of the first message.
    pub fn first_message(scram: Scram) -> String
        "${scram.header}${scram.first_bare}"
    end

    /// The SASL mechanism the exchange is: SCRAM-SHA-256-PLUS when it binds
    /// to the connection, SCRAM-SHA-256 otherwise.
    pub fn mechanism(scram: Scram) -> String
        if String.starts_with(scram.header, "p=") then
            "SCRAM-SHA-256-PLUS"
        else
            "SCRAM-SHA-256"
        end
    end

    /// The client's final message for the server's first, `server_first`,
    /// and the signature the server must answer with, or why the server's
    /// message is not a SCRAM challenge for this client.
    ///
    /// RFC 7677's example, with the first message's user name as Postgres
    /// leaves it out:
    //! s = {..Scram.start("rOprNGfwEbeRWgbNEkqO"), first_bare: "n=user,r=rOprNGfwEbeRWgbNEkqO"}
    //! server = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    //! proof = Scram.answer(s, "pencil", server)!
    //!
    //! assert proof.message == "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
    //!
    //! assert Scram.verify(proof, "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=") == Ok(Unit)
    //! assert Scram.verify(proof, "v=AAAA") |> Result.is_err()
    //!
    //! assert Scram.verify(proof, "e=invalid-proof")
    //!     == Err("the server refused the password: invalid-proof")
    //
    /// The same exchange bound to a connection whose `tls-server-end-point`
    /// data is the bytes 0 to 31, and with `y`, its messages computed apart
    /// with Python's hashlib and hmac:
    //! import std::hex
    //!
    //! data = hex.decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")!
    //!
    //! server = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    //!
    //! bound = {
    //!     ..Scram.start("rOprNGfwEbeRWgbNEkqO", Binding.Bound{name: "tls-server-end-point", data:}),
    //!     first_bare: "n=user,r=rOprNGfwEbeRWgbNEkqO",
    //! }
    //!
    //! proof = Scram.answer(bound, "pencil", server)!
    //!
    //! assert proof.message == "c=cD10bHMtc2VydmVyLWVuZC1wb2ludCwsAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=nY1Wus9a+gM2DrbQ1msXFgyhW6KM5ktOxWiU+/P/EGY="
    //!
    //! assert Scram.verify(proof, "v=RwppMGddhz/J0lFYaRReBjXcQeNUFP5Qc76Lo5Exrig=") == Ok(Unit)
    //!
    //! offered = {
    //!     ..Scram.start("rOprNGfwEbeRWgbNEkqO", Binding.NotOffered),
    //!     first_bare: "n=user,r=rOprNGfwEbeRWgbNEkqO",
    //! }
    //!
    //! answered = Scram.answer(offered, "pencil", server)!
    //!
    //! assert answered.message == "c=eSws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=FoqiHTtQEDE8lz1CdaEe3tK4mS+iMDTl77SPyDS53DY="
    //!
    //! assert Scram.verify(answered, "v=dI4KpiQJwBr1+V+K6U1dA6l6I4I9DUNXWND4pcpRU3U=") == Ok(Unit)
    //
    pub fn answer(
        scram:        Scram,
        password:     String,
        server_first: String,
    ) -> Result<ScramProof, String>
        fields = attributes(server_first)
        nonce = field(fields, "r")?

        salt =
            field(fields, "s")?
            |> base64.decode()
            |> Result.map_err(fn _ -> "the server's salt is not base64")?

        iterations =
            field(fields, "i")?
            |> String.to_int()
            |> Option.flat_map(PositiveInt.try_from)
            |> Option.to_result("the server's iteration count is not a positive number")?

        if not String.starts_with(nonce, scram.nonce) then
            return Err("the server's nonce does not extend the client's")
        end

        salted = hash.pbkdf2_sha256(String.to_bytes(password), salt, iterations, 32)
        client_key = hash.hmac_sha256(salted, String.to_bytes("Client Key"))
        stored_key = hash.sha256(client_key)
        channel = base64.encode(String.to_bytes(scram.header) + scram.binding)
        without_proof = "c=${channel},r=${nonce}"
        signed = String.to_bytes("${scram.first_bare},${server_first},${without_proof}")
        client_signature = hash.hmac_sha256(stored_key, signed)
        proof = xor(client_key, client_signature)
        server_key = hash.hmac_sha256(salted, String.to_bytes("Server Key"))

        Ok(
            ScramProof{
                message:   "${without_proof},p=${base64.encode(proof)}",
                signature: hash.hmac_sha256(server_key, signed),
            }
        )
    end

    /// `Ok` when the server's final message carries the signature `proof`
    /// expects, which proves the server knows the password too.
    pub fn verify(proof: ScramProof, server_final: String) -> Result<Unit, String>
        fields = attributes(server_final)

        case (field(fields, "v"), field(fields, "e"))
            (Ok(signature), _) ->
                sent =
                    base64.decode(signature)
                    |> Result.map_err(fn _ -> "the server's signature is not base64")?

                if hash.equal_in_constant_time(sent, proof.signature) then
                    Ok(Unit)
                else
                    Err("the server's signature does not match: it does not know the password")
                end

            (_, Ok(reason)) ->
                Err("the server refused the password: ${reason}")

            _ ->
                Err("the server's final SCRAM message carries no signature")
        end
    end
end

/// The password an MD5 challenge asks for: `md5`, then the MD5 of the MD5
/// of the password and the user name, and the salt, in hex.
//! salt = Bytes.from_list([0x01, 0x02, 0x03, 0x04])
//! assert md5_password("postgres", "secret", salt) == "md5bb41a296aab6baccb36ff243a562abff"
//!
//! assert md5_password("u", "p", Bytes.from_list([0, 0, 0, 0]))
//!     == "md5d6afbb2a4840883e3273ff8563b82bf4"
//
pub fn md5_password(user: String, password: String, salt: Bytes) -> String
    inner = hash.md5_hex(String.to_bytes(password + user))
    "md5" + hash.md5_hex(String.to_bytes(inner) + salt)
end

// The `name=value` attributes of a SCRAM message, by name.
fn attributes(message: String) -> List<(String, String)>
    String.split(message, ",")
    |> Iter.flat_map(fn part ->
        case String.split(part, "=")
            [name, ..rest] when rest != [] -> [(name, String.join(rest, "="))]
            _                              -> []
        end
    end)
    |> Iter.to_list()
end

fn field(fields: List<(String, String)>, name: String) -> Result<String, String>
    fields
    |> Iter.find(fn (key, _) -> key == name)
    |> Option.map(.second)
    |> Option.to_result("the server's SCRAM message has no `${name}`")
end

fn xor(a: Bytes, b: Bytes) -> Bytes
    Iter.zip(a, b) |> Iter.map(fn (x, y) -> x ^^^ y) |> Iter.to_list() |> Bytes.from_list()
end
