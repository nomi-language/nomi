//# The code `query` and `database` declarations expand to. The generated
//# code states each fact about a query as code that checks only when the
//# fact holds (a column of the `INTEGER` family is read by a function
//# bounded by `SqlInt`, a nullable one answers a `Maybe`), and maps it to
//# the SQL it is about, so the checker's error lands on the column or the
//# parameter in the body.

import {
    std/macro.{Body, Declaration, Diagnostic, ExpandCall, Expansion, Input, Site, Source, Span}
    databases.{self, Database}
    snapshot.{self, Column, Snapshot, Table, TableColumn}
    sqltext.{self, Override, Token}
    types.{self, Family}
}

/// The result a query declares.
enum Shape {
    /// `-> T`: exactly one row.
    One

    /// `-> Maybe<T>`.
    Optional

    /// `-> List<T>`, and a query with no result type, whose rows are
    /// anonymous structs.
    Many

    /// `-> Rows<T>`.
    Stream

    /// `-> Changed` on SQL that returns no rows: the number of rows it
    /// changed.
    Changed

    /// `-> Unit` on SQL that returns no rows: the count is ignored.
    Ignored
}

derive Equatable for Shape

/// The row type a query names inside its shape, and where it is.
struct RowType {
    text: String
    span: Span
}

/// One column as the generated code reads it.
struct Field {
    name: String
    position: Int
    reader: String
    // What the reader takes after the row and position: the scale of a
    // DECIMAL(p, s) column, `, 2`.
    args: String
    type_text: Maybe<String>
    of_enum: Bool
    nullable: Bool
    span: Span

    // The note added to an error the checker finds in the column's
    // reader: for a field of a row struct, and for a one-column query's
    // result.
    hint: String
    result_hint: String
}

fn diagnostic(span: Span, message: String, hints: List<String>) -> Diagnostic {
    #Diagnostic{span, message, hints}
}

fn failed(diagnostics: List<Diagnostic>) -> Expansion {
    #Expansion{source: "", spans: [], diagnostics}
}

fn prepare_hint() -> String {
    "run `nomi tool sqlkit prepare` to describe the queries again"
}

fn first_prepare_hint() -> String {
    "run `nomi tool sqlkit prepare` to write it from the migrations"
}

/// The span of `tokens` in the body: from the first one to the last.
fn span_of(body: Body, first: Token, last: Token) -> Span {
    Body.span_at(body, first.start, last.end)
}

fn token_span(body: Body, token: Token) -> Span {
    span_of(body, token, token)
}

/// The snapshot of db, or the diagnostic that says why there is none.
fn read_snapshot(
    decl: Declaration,
    db: Database,
    inputs: List<Input>,
) -> Result<Snapshot, Diagnostic> {
    input = case Input.find(inputs, db.snapshot) {
        Some(i) ->
            i

        None ->
            return Err(
                diagnostic(
                    decl.span,
                    "the database `${db.name}` has no snapshot at ${db.snapshot}",
                    [first_prepare_hint()],
                )
            )
    }

    case Snapshot.parse(input.text) {
        Ok(s) ->
            Ok(s)

        Err(why) ->
            Err(
                diagnostic(
                    Span.line(input.path, 1, ""),
                    "${db.snapshot} cannot be read: ${why}",
                    [prepare_hint()],
                )
            )
    }
}

// --- query -----------------------------------------------------------
/// What is wrong with a query whose body is not tagged `Sql`, at the
/// body's first line. The tag is what tells an editor the body is SQL, so
/// a query requires it.
fn untagged(body: Body) -> Diagnostic {
    message = case body.tag {
        Some(tag) -> "a query's body is SQL, tagged `Sql`, not `${tag}`"
        None -> "a query's body is SQL, tagged `Sql`"
    }

    first = String.split(body.text, "\n") |> Iter.first() |> Maybe.with_default("")
    lead = first |> Iter.take_while(fn c -> c == " " or c == "\t") |> String.join()

    diagnostic(
        Body.span_at(
            body,
            String.length(lead),
            String.length(lead) + String.length(String.trim(first)),
        ),
        message,
        ["write `Sql` right before the opening backtick: ``Sql`SELECT ...` ``"],
    )
}

/// The expansion of a `query` declaration.
pub fn query(call: ExpandCall) -> Expansion {
    decl = call.decl

    declared = call.sites |> Iter.map(fn site -> site.name) |> Iter.to_list()

    found =
        databases.of_module(call.config, declared)
        |> Result.flat_map(fn dbs -> databases.for_file(dbs, decl.file))

    db = case found {
        Ok(d) -> d
        Err(why) -> return Declaration.error(decl, why)
    }

    body = case decl.body {
        Some(b) ->
            b

        None ->
            return Declaration.error(
                decl,
                "a query's SQL goes in backticks after its signature: `sqlkit.query! ${decl.name}() Sql`SELECT ...``",
            )
    }

    if body.tag != Some("Sql") {
        return failed([untagged(body)])
    }

    tokens = sqltext.tokens(body.text)
    markers = sqltext.markers(tokens)

    #(shape, row) = case shape_of(decl) {
        Ok(s) -> s
        Err(d) -> return failed([d])
    }

    marker_problems = check_markers(decl, body, markers, sqltext.interpolations(tokens))

    snap = case read_snapshot(decl, db, call.inputs) {
        Ok(s) -> s
        Err(d) -> return stub(decl, shape, row, None, [d, ..marker_problems])
    }

    described = Snapshot.query(snap, decl.file, decl.name)

    // The query as the snapshot last described it, for a function that
    // keeps its signature while the SQL is wrong or not described yet.
    earlier = fn diagnostics: List<Diagnostic> -> {
        old =
            described
            |> Maybe.flat_map(fn q -> {
                if q.error != None { return None }

                s = case described_shape(decl, shape, row, q.columns) {
                    Ok(s) -> s
                    Err(_) -> return None
                }

                #(fields, problems) = fields_of(
                    decl,
                    body,
                    tokens,
                    q.columns,
                    snap,
                    db,
                    row == None,
                )

                if Iter.empty?(problems) {
                    Some(#(s, fields, enum_module(decl, call.sites)))
                } else {
                    None
                }
            })

        case old {
            Some(#(s, fields, enum_import)) ->
                stub(decl, s, row, Some(#(fields, enum_import)), diagnostics)

            None ->
                stub(decl, shape, row, None, diagnostics)
        }
    }

    if !Iter.empty?(marker_problems) {
        return earlier(marker_problems)
    }

    parts = sqltext.parts(tokens)
    sql = sqltext.sqlite_sql(parts)

    described = case described {
        Some(q) -> q
        None -> return earlier([
            diagnostic(decl.span, "`${decl.name}` is not in ${db.snapshot}", [prepare_hint()]),
        ])
    }

    if described.sql != sql {
        return earlier([
            diagnostic(
                sql_span(body, tokens),
                "`${decl.name}` is not in ${db.snapshot}: its SQL changed after the last `nomi tool sqlkit prepare`",
                [prepare_hint()],
            ),
        ])
    }

    case described.error {
        Some(e) -> {
            span =
                sqltext.token_at_offset(tokens, e.offset)
                |> Maybe.map(fn t -> token_span(body, t))
                |> Maybe.with_default(sql_span(body, tokens))

            return stub(decl, shape, row, None, [
                diagnostic(
                    span,
                    e.message,
                    ["reported by SQLite when `nomi tool sqlkit prepare` described `${decl.name}`"],
                ),
            ])
        }

        None -> {}
    }

    columns = described.columns

    final_shape = case described_shape(decl, shape, row, columns) {
        Ok(s) -> s
        Err(d) -> return failed([d])
    }

    #(fields, problems) = fields_of(decl, body, tokens, columns, snap, db, row == None)

    if !Iter.empty?(problems) {
        return stub(decl, final_shape, row, None, problems)
    }

    enum_import = enum_module(decl, call.sites)
    function(decl, body, final_shape, row, parts, markers, fields, enum_import)
}

/// Every `@name` names a parameter, every parameter is used, and no
/// `${...}` is left in the body.
fn check_markers(
    decl: Declaration,
    body: Body,
    markers: List<Token>,
    interpolations: List<Token>,
) -> List<Diagnostic> {
    names = decl.params |> Iter.map(fn p -> p.name) |> Iter.to_list()

    // A `${name}` the author meant as a parameter counts as using it, so
    // its own error is the only one.
    meant = interpolations |> Iter.map(fn t -> interpolated_name(t.text)) |> Iter.to_list()
    used = markers |> Iter.map(fn m -> sqltext.marker_name(m.text)) |> Iter.to_list()

    left =
        interpolations
        |> Iter.map(fn t -> {
            name = interpolated_name(t.text)

            suggestion = if sqltext.name?(name) {
                "write `@${name}`: a query binds a parameter with SQL's `@name`"
            } else {
                "a query binds a parameter with SQL's `@name`"
            }

            diagnostic(
                token_span(body, t),
                "a query body is raw SQL, so `${"$"}{...}` is not interpolated",
                [suggestion],
            )
        })

    unknown =
        markers
        |> Iter.filter(fn m -> !Iter.contains?(names, sqltext.marker_name(m.text)))
        |> Iter.map(fn m -> {
            name = sqltext.marker_name(m.text)

            hint = if Iter.empty?(names) {
                "`${decl.name}` takes no parameters; declare one: `sqlkit.query! ${decl.name}(${name}: String)`"
            } else {
                "its parameters are ${names |> Iter.map(fn n -> "`${n}`") |> String.join(", ")}"
            }

            diagnostic(
                token_span(body, m),
                "`${name}` is not a parameter of `${decl.name}`",
                [hint],
            )
        })

    unused =
        decl.params
        |> Iter.filter(fn p -> !Iter.contains?(used, p.name) and !Iter.contains?(meant, p.name))
        |> Iter.map(fn p -> {
            diagnostic(
                p.span,
                "the parameter `${p.name}` is not used in the SQL of `${decl.name}`",
                ["write `@${p.name}` where it is bound, or remove it"],
            )
        })

    left |> Iter.concat(unknown) |> Iter.concat(unused) |> Iter.to_list()
}

/// The name inside a `${...}`, trimmed.
fn interpolated_name(text: String) -> String {
    text
    |> sqltext.cut_prefix("\${")
    |> sqltext.cut_suffix("}")
    |> String.trim()
}

/// The shape the declared result type names, and its row type.
fn shape_of(decl: Declaration) -> Result<#(Shape, Maybe<RowType>), Diagnostic> {
    case decl.result {
        None ->
            Ok(#(Shape.Many, None))

        Some(result) -> {
            text = String.trim(result.text)

            if text == "Unit" {
                return Ok(#(Shape.Ignored, None))
            }

            if text == "Changed" or text == "sqlkit.Changed" {
                return Ok(#(Shape.Changed, None))
            }

            #(shape, inner, prefix) = if wrapped?(text, "Maybe") {
                #(Shape.Optional, unwrap(text, "Maybe"), "Maybe<")
            } else if wrapped?(text, "List") {
                #(Shape.Many, unwrap(text, "List"), "List<")
            } else if wrapped?(text, "Rows") {
                #(Shape.Stream, unwrap(text, "Rows"), "Rows<")
            } else {
                #(Shape.One, text, "")
            }

            if inner == "" {
                return Err(
                    diagnostic(
                        result.span,
                        "a query's result names its row type: `-> ${prefix}User>`",
                        [],
                    )
                )
            }

            col = result.span.col + Bytes.length(String.to_bytes(prefix))
            span = #{..result.span, col, end_col: col + Bytes.length(String.to_bytes(inner))}
            Ok(#(shape, Some(#RowType{text: inner, span})))
        }
    }
}

fn wrapped?(text: String, name: String) -> Bool {
    String.starts_with?(text, name + "<") and String.ends_with?(text, ">")
}

fn unwrap(text: String, name: String) -> String {
    text |> sqltext.cut_prefix(name + "<") |> sqltext.cut_suffix(">") |> String.trim()
}

/// How each column is read, or what is wrong with the columns.
fn fields_of(
    decl: Declaration,
    body: Body,
    tokens: List<Token>,
    columns: List<Column>,
    snap: Snapshot,
    db: Database,
    anonymous: Bool,
) -> #(List<Field>, List<Diagnostic>) {
    items = sqltext.select_items(tokens) |> Iter.to_vector()
    overrides = sqltext.overrides(tokens)
    one_item_per_column = Vector.length(items) == Iter.count(columns)

    #(fields, problems, _) = Iter.reduce(
        Iter.with_index(columns),
        fn acc, #(position, column) -> {
            #(fields, problems, seen) = acc

            span = if one_item_per_column {
                case Vector.get(items, position) {
                    Some(item) -> item_span(body, item)
                    None -> body.span
                }
            } else {
                body.span
            }

            override = Iter.find(overrides, fn o -> o.column == column.name)

            if !sqltext.name?(column.name) {
                problem = diagnostic(
                    span,
                    "the column `${column.name}` has no name a field can take",
                    ["name it with `AS`: `${column.name} AS \"total\"`"],
                )

                return #(fields, [problem, ..problems], seen)
            }

            if Iter.contains?(seen, column.name) {
                problem = diagnostic(
                    span,
                    "`${decl.name}` has two columns named `${column.name}`",
                    ["rename one with `AS`"],
                )

                return #(fields, [problem, ..problems], seen)
            }

            #(field, problem) = field_of(
                decl,
                column,
                position,
                span,
                override,
                snap,
                db,
                anonymous,
            )

            #([field, ..fields], sqltext.listed(problem) + problems, [column.name, ..seen])
        },
        from: #([], [], []),
    )

    #(Iter.reverse(fields), Iter.reverse(problems))
}

fn item_span(body: Body, item: List<Token>) -> Span {
    case #(Iter.first(item), Iter.last(item)) {
        #(Some(first), Some(last)) -> span_of(body, first, last)
        _ -> body.span
    }
}

fn field_of(
    decl: Declaration,
    column: Column,
    position: Int,
    span: Span,
    override: Maybe<Override>,
    snap: Snapshot,
    db: Database,
    anonymous: Bool,
) -> #(Field, Maybe<Diagnostic>) {
    nullable = override |> Maybe.flat_map(fn o -> o.nullable) |> Maybe.with_default(column.nullable)
    type_override = override |> Maybe.flat_map(fn o -> o.type_text)
    enum_name = enum_of(snap, db, column)

    family = if enum_name != None {
        Some(types.text_family())
    } else {
        types.of(column.type_name)
    }

    scale = types.scale(column.type_name)

    #(reader, args) = case #(type_override, family, scale) {
        #(Some(_), _, _) -> #("value", "")
        #(None, Some(f), Some(s)) when f.reader == "numeric" -> #("numeric_scaled", ", ${s}")
        #(None, Some(f), _) -> #(f.reader, "")
        #(None, None, _) -> #("value", "")
    }

    type_text = case #(type_override, enum_name, family) {
        #(Some(t), _, _) -> Some(t)
        #(None, Some(e), _) -> Some(e)
        #(None, None, Some(f)) -> Some(f.nomi)
        #(None, None, None) -> None
    }

    field = #Field{
        name: column.name,
        position,
        reader,
        args,
        type_text,
        of_enum: type_override == None and enum_name != None,
        nullable,
        span,
        hint: hint(column, nullable, family, enum_name, "the field"),
        result_hint: hint(column, nullable, family, enum_name, "the row type"),
    }

    problem = if anonymous and type_text == None {
        Some(
            diagnostic(
                span,
                "SQLite reports no type for the column `${column.name}` of `${decl.name}`: it is an expression",
                [
                    "give its type in its name: `AS \"${column.name}: Int\"`, or declare the row type: `-> List<MyRow>`",
                ],
            )
        )
    } else {
        None
    }

    #(field, problem)
}

/// The note added to an error the checker finds in a column's reader: the
/// type `subject` (the field the column is read into) should be, from the
/// column's SQL type.
fn hint(
    column: Column,
    nullable: Bool,
    family: Maybe<Family>,
    enum_name: Maybe<String>,
    subject: String,
) -> String {
    wanted = case #(enum_name, family) {
        #(Some(e), _) -> Some(e)
        #(None, Some(f)) -> Some(unqualified(f.nomi))
        #(None, None) -> None
    }

    what = case enum_name {
        Some(e) -> "holds the values of the enum `${e}`"
        None -> "is ${type_name(column)}"
    }

    case #(wanted, nullable) {
        #(Some(t), False) ->
            "`${column.name}` ${what}, so ${subject} should be `${t}`"

        #(Some(t), True) ->
            "`${column.name}` ${what} and may be NULL, so ${subject} should be `Maybe<${t}>`; or assert it is never NULL with `AS \"${column.name}!\"`"

        #(None, False) ->
            "`${column.name}` is an expression, so ${subject}'s type implements `FromSql`"

        #(None, True) ->
            "`${column.name}` is an expression that may be NULL, so ${subject} is a `Maybe` of a type that implements `FromSql`; or assert it is never NULL with `AS \"${column.name}!\"`"
    }
}

/// A Nomi type as a reader names it, without the file it is from:
/// `calendar.Date` is `Date`.
fn unqualified(text: String) -> String {
    String.split(text, ".") |> Iter.last() |> Maybe.with_default(text)
}

fn type_name(column: Column) -> String {
    if column.type_name == "" {
        "an expression"
    } else {
        column.type_name
    }
}

/// The enum a column of a table with a `CHECK (column IN (...))` reads
/// as, by its name in the generated code.
fn enum_of(snap: Snapshot, db: Database, column: Column) -> Maybe<String> {
    if column.table == "" { return None }

    Snapshot.column(snap, column.table, column.column)
    |> Maybe.flat_map(fn c -> {
        if Iter.empty?(c.values) or !enum_values_ok?(c.values) {
            None
        } else {
            Some(enum_name(row_name(db, column.table), column.column))
        }
    })
}

/// The import path of the file whose `database` declaration generates the
/// enums, and the name the generated code calls it by; `None` when it is
/// the declaring file.
fn enum_module(decl: Declaration, sites: List<Site>) -> Maybe<String> {
    case Iter.first(sites) {
        Some(site) when site.file != decl.file -> Some(sqltext.cut_suffix(site.file, ".nomi"))
        _ -> None
    }
}

fn last_segment(path: String) -> String {
    String.split(path, "/") |> Iter.last() |> Maybe.with_default(path)
}

/// The function a query generates, with a body that answers the
/// diagnostics' failure: so a query that is not described yet still has
/// its signature, and its callers check. A query with no row type has one
/// only when `known` gives its columns (the snapshot's earlier description
/// of it) and the file the enums are in.
fn stub(
    decl: Declaration,
    shape: Shape,
    row: Maybe<RowType>,
    known: Maybe<#(List<Field>, Maybe<String>)>,
    diagnostics: List<Diagnostic>,
) -> Expansion {
    #(fields, enum_import) = case #(row, known) {
        #(Some(_), _) -> #([], None)
        #(None, _) when shape == Shape.Ignored or shape == Shape.Changed -> #([], None)
        #(None, Some(k)) -> k
        #(None, None) -> return failed(diagnostics)
    }

    src =
        header(decl, shape, row, fields, enum_import)
        |> Source.add("    _ = conn\n")

    src =
        decl.params
        |> Iter.reduce(fn s, p -> Source.add(s, "    _ = ${p.name}\n"), from: src)

    answer = if shape == Shape.Stream {
        "runtime.undescribed_rows(conn, ${quote(decl.name)})"
    } else {
        "Err(runtime.undescribed(${quote(decl.name)}))"
    }

    e = src |> Source.add("    ${answer}\n}\n") |> Source.expansion()
    #{..e, diagnostics}
}

/// The shape a query takes once the snapshot gives its columns, or what is
/// wrong with its result type. SQL that returns no rows answers the number
/// of rows it changed (`-> Changed`) or nothing (`-> Unit`), and only SQL
/// that returns rows can leave its result type out or name a row type.
fn described_shape(
    decl: Declaration,
    shape: Shape,
    row: Maybe<RowType>,
    columns: List<Column>,
) -> Result<Shape, Diagnostic> {
    count_hint = "write `-> Changed` for the count, or `-> Unit` to ignore it"

    result_span =
        decl.result
        |> Maybe.map(fn r -> r.span)
        |> Maybe.with_default(decl.span)

    rows_hint = "name their type, `-> List<MyRow>`, or leave the result type out to read them as anonymous structs"

    case #(shape, row, Iter.empty?(columns)) {
        #(.Many, None, True) ->
            Err(
                diagnostic(
                    decl.name_span,
                    "`${decl.name}` returns no rows, so its result is the number of rows it changed: write `-> Changed`",
                    [count_hint],
                )
            )

        #(.Ignored, _, False) ->
            Err(
                diagnostic(
                    result_span,
                    "`${decl.name}` returns rows, so its result cannot be `Unit`",
                    [rows_hint],
                )
            )

        #(.Changed, _, False) ->
            Err(
                diagnostic(
                    result_span,
                    "`${decl.name}` returns rows, so its result cannot be `Changed`",
                    [rows_hint],
                )
            )

        #(.One, Some(r), True) when r.text == "Int" ->
            Err(
                diagnostic(
                    r.span,
                    "`${decl.name}` returns no rows, so it cannot answer an `Int`; write `-> Changed` for the number of rows it changed, or `-> Unit`",
                    [],
                )
            )

        #(_, Some(r), True) ->
            Err(
                diagnostic(
                    r.span,
                    "`${decl.name}` returns no rows, so it has no row type",
                    [count_hint],
                )
            )

        #(s, _, _) ->
            Ok(s)
    }
}

/// The span of a body's SQL: from its first token to its last, without
/// the space around it.
fn sql_span(body: Body, tokens: List<Token>) -> Span {
    solid = tokens |> Iter.filter(fn t -> t.kind != sqltext.Kind.Space) |> Iter.to_list()

    case #(Iter.first(solid), Iter.last(solid)) {
        #(Some(first), Some(last)) -> span_of(body, first, last)
        _ -> body.span
    }
}

/// The imports and signature of the generated function, through its `{`.
fn header(
    decl: Declaration,
    shape: Shape,
    row: Maybe<RowType>,
    fields: List<Field>,
    enum_import: Maybe<String>,
) -> Source {
    modules = imports(shape, row, fields, enum_import)
    src = Iter.reduce(modules, fn s, m -> Source.add(s, "import ${m}\n"), from: Source.new())

    visibility = if decl.public { "pub " } else { "" }

    src =
        src
        |> Source.add("\n${visibility}fn ")
        |> Source.mapped(decl.name, decl.name_span)
        |> Source.add("(conn: sql.Conn")

    src = Iter.reduce(
        decl.params,
        fn s, p -> {
            s
            |> Source.add(", ")
            |> Source.mapped(p.name, p.span)
            |> Source.add(": ")
            |> Source.mapped(p.type_text.text, p.type_text.span)
        },
        from: src,
    )

    src |> Source.add(") -> ") |> result_type(shape, row, fields, enum_import) |> Source.add(" {\n")
}

fn imports(
    shape: Shape,
    row: Maybe<RowType>,
    fields: List<Field>,
    enum_import: Maybe<String>,
) -> List<String> {
    anonymous = row == None and shape != Shape.Ignored and shape != Shape.Changed

    field_modules = if anonymous {
        fields
        |> Iter.flat_map(fn f -> {
            types.of_nomi(
                f.type_text
                |> Maybe.with_default("")
            )
            |> sqltext.listed()
        })
        |> Iter.to_list()
    } else {
        []
    }

    enum_modules = case enum_import {
        Some(m) when anonymous and Iter.any?(fields, fn f -> f.of_enum) -> [m]
        _ -> []
    }

    base = ["sqlkit", "sqlkit/runtime", "std/sql"]

    Iter.concat(base, Iter.concat(field_modules, enum_modules))
    |> Iter.to_set()
    |> Iter.to_list()
    |> Iter.sort()
}

fn result_type(
    src: Source,
    shape: Shape,
    row: Maybe<RowType>,
    fields: List<Field>,
    enum_import: Maybe<String>,
) -> Source {
    row_text = fn s: Source -> {
        case row {
            Some(r) -> Source.mapped(s, r.text, r.span)
            None -> Source.add(s, anonymous_type(fields, enum_import))
        }
    }

    case shape {
        .One -> src |> Source.add("Result<") |> row_text() |> Source.add(", sql.Error>")
        .Optional -> src |> Source.add("Result<Maybe<") |> row_text() |> Source.add(">, sql.Error>")
        .Many -> src |> Source.add("Result<List<") |> row_text() |> Source.add(">, sql.Error>")
        .Stream -> src |> Source.add("sqlkit.Rows<") |> row_text() |> Source.add(">")
        .Changed -> src |> Source.add("Result<sqlkit.Changed, sql.Error>")
        .Ignored -> src |> Source.add("Result<Unit, sql.Error>")
    }
}

fn field_type(field: Field, enum_import: Maybe<String>) -> String {
    base = qualified(field, enum_import)

    if field.nullable {
        "Maybe<${base}>"
    } else {
        base
    }
}

// The field's type as the generated code names it: an enum of another file
// through the import of that file.
fn qualified(field: Field, enum_import: Maybe<String>) -> String {
    text = field.type_text |> Maybe.with_default("sql.Value")

    case enum_import {
        Some(m) when field.of_enum -> "${last_segment(m)}.${text}"
        _ -> text
    }
}

fn anonymous_type(fields: List<Field>, enum_import: Maybe<String>) -> String {
    inner =
        fields |> Iter.map(fn f -> "${f.name}: ${field_type(f, enum_import)}") |> String.join(", ")

    "#{${inner}}"
}

/// The generated function.
fn function(
    decl: Declaration,
    body: Body,
    shape: Shape,
    row: Maybe<RowType>,
    parts: List<String>,
    markers: List<Token>,
    fields: List<Field>,
    enum_import: Maybe<String>,
) -> Expansion {
    src = header(decl, shape, row, fields, enum_import)
    quoted_parts = parts |> Iter.map(quote) |> String.join(", ")

    src =
        src
        |> Source.add("    statement = runtime.statement(\n        [${quoted_parts}],\n        [")

    src = Iter.reduce(
        Iter.with_index(markers),
        fn s, #(i, marker) -> {
            name = sqltext.marker_name(marker.text)

            s
            |> Source.add(if i == 0 { "" } else { ", " })
            |> Source.mapped(
                "runtime.bind(${name})",
                token_span(body, marker),
                hint: Some("a parameter's type implements std/sql's `ToSql`"),
            )
        },
        from: src,
    )

    src = src |> Source.add("],\n    )\n")
    name = quote(decl.name)

    case shape {
        .Changed ->
            src
            |> Source.add("    runtime.exec(conn, statement)\n}\n")
            |> Source.expansion()

        .Ignored ->
            src
            |> Source.add("    runtime.run(conn, statement)\n}\n")
            |> Source.expansion()

        _ -> {
            reader = case shape {
                .One -> "one"
                .Optional -> "optional"
                .Stream -> "rows"
                _ -> "list"
            }

            open = case row {
                Some(r) -> "#${r.text}{"
                None -> "#{"
            }

            scalar = case #(row, fields) {
                #(Some(r), [only]) when scalar?(r.text) -> Some(only)
                _ -> None
            }

            case scalar {
                Some(field) -> {
                    suffix = if field.nullable { "_null" } else { "" }
                    code = "runtime.${field.reader}${suffix}(${name}, row, 0${field.args})"

                    return src
                    |> Source.add("    runtime.${reader}(conn, ${name}, statement, fn row -> ")
                    |> Source.mapped(code, field.span, hint: Some(field.result_hint))
                    |> Source.add(")\n}\n")
                    |> Source.expansion()
                }

                None -> {}
            }

            src = src |> Source.add("    runtime.${reader}(conn, ${name}, statement, fn row -> Ok(")

            src = case row {
                Some(r) ->
                    Source.mapped(
                        src,
                        open,
                        r.span,
                        hint: Some("`${decl.name}`'s columns are ${columns_text(fields)}"),
                    )

                None ->
                    Source.add(src, open)
            }

            src = src |> Source.add("\n")

            src = Iter.reduce(
                fields,
                fn s, f -> field_line(s, f, name, row == None, enum_import),
                from: src,
            )

            src |> Source.add("    }))\n}\n") |> Source.expansion()
        }
    }
}

/// Whether a row type names one of std's value types (or a `Maybe` of
/// one), which a query of one column reads the column as, rather than a
/// struct.
//! assert generate.scalar?("Int")
//! assert generate.scalar?("Maybe<String>")
//! refute generate.scalar?("User")
//
pub fn scalar?(text: String) -> Bool {
    inner = if String.starts_with?(text, "Maybe<") {
        text |> sqltext.cut_prefix("Maybe<") |> sqltext.cut_suffix(">")
    } else {
        text
    }

    Iter.contains?(
        [
            "Int",
            "Float",
            "Decimal",
            "String",
            "Bool",
            "Bytes",
            "Date",
            "Time",
            "NaiveDateTime",
            "Instant",
            "Uuid",
            "Json",
        ],
        String.trim(inner),
    )
}

fn columns_text(fields: List<Field>) -> String {
    fields |> Iter.map(fn f -> "`${f.name}`") |> String.join(", ")
}

fn field_line(
    src: Source,
    field: Field,
    name: String,
    anonymous: Bool,
    enum_import: Maybe<String>,
) -> Source {
    suffix = if field.nullable { "_null" } else { "" }

    type_args = case #(anonymous, field.type_text, field.reader) {
        #(True, Some(_), _) -> "<${qualified(field, enum_import)}>"
        #(False, Some(_), "value") -> "<${qualified(field, enum_import)}>"
        _ -> ""
    }

    code = "${field.name}: try runtime.${field.reader}${suffix}${type_args}(${name}, row, ${field.position}${field.args})"

    src
    |> Source.add("        ")
    |> Source.mapped(code, field.span, hint: Some(field.hint))
    |> Source.add(",\n")
}

/// s as a Nomi string literal.
pub fn quote(s: String) -> String {
    escaped =
        s
        |> String.replace("\\", "\\\\")
        |> String.replace("\"", "\\\"")
        |> String.replace("\${", "\\\${")
        |> String.replace("\n", "\\n")
        |> String.replace("\t", "\\t")
        |> String.replace("\r", "\\r")

    "\"${escaped}\""
}

// --- database --------------------------------------------------------
/// The expansion of a `database` declaration.
pub fn database(call: ExpandCall) -> Expansion {
    decl = call.decl

    db = case databases.named(databases.read(call.config), decl.name) {
        Ok(d) -> d
        Err(why) -> return Declaration.error(decl, why)
    }

    snap = case read_snapshot(decl, db, call.inputs) {
        Ok(s) -> s
        Err(d) -> return failed([d])
    }

    names = case row_names(decl, db, snap) {
        Ok(n) -> n
        Err(problems) -> return failed(problems)
    }

    migrations =
        call.inputs
        |> Iter.filter(fn i -> i.path != db.snapshot and String.ends_with?(i.path, ".sql"))
        |> Iter.sort_by(fn i -> i.path)

    sum =
        migrations
        |> Iter.map(fn m -> #(m.path, m.text))
        |> Iter.to_list()
        |> snapshot.migrations_checksum()

    // The code still comes from the snapshot, so the files that use it check
    // against the schema it describes until prepare runs.
    stale = if sum == snap.migrations {
        []
    } else {
        [
            diagnostic(
                decl.span,
                "${db.snapshot} is out of date: the migrations changed after the last `nomi tool sqlkit prepare`",
                ["run `nomi tool sqlkit prepare` to describe the migrations again"],
            ),
        ]
    }

    modules =
        snap.tables
        |> Iter.flat_map(fn t -> t.columns)
        |> Iter.flat_map(fn c -> {
            types.of(c.type_name) |> Maybe.flat_map(fn f -> f.module) |> sqltext.listed()
        })
        |> Iter.to_set()
        |> Iter.to_list()

    all_modules =
        Iter.concat(["sqlkit", "sqlkit/runtime", "std/sql"], modules)
        |> Iter.to_set()
        |> Iter.to_list()
        |> Iter.sort()

    src = Iter.reduce(all_modules, fn s, m -> Source.add(s, "import ${m}\n"), from: Source.new())
    src = Iter.reduce(snap.tables, fn s, t -> table_source(s, decl, names, t), from: src)

    src = Iter.reduce(
        snap.tables,
        fn s, t -> {
            Iter.reduce(t.columns, fn s2, c -> enum_source(s2, decl, names, t, c), from: s)
        },
        from: src,
    )

    visibility = if decl.public { "pub " } else { "" }

    src =
        src
        |> Source.add(
            "\n/// The migrations of the database `${decl.name}`, in the order they apply.\n${visibility}once "
        )
        |> Source.mapped("migrations", decl.name_span)
        |> Source.add(": List<sqlkit.Migration> = [\n")

    src = Iter.reduce(
        migrations,
        fn s, m -> {
            Source.add(s, "    #sqlkit.Migration{path: ${quote(m.path)}, sql: ${quote(m.text)}},\n")
        },
        from: src,
    )

    e = src |> Source.add("]\n") |> Source.expansion()
    #{..e, diagnostics: stale + unknown_tables(decl, db, snap)}
}

fn table_source(
    src: Source,
    decl: Declaration,
    names: Map<String, String>,
    table: Table,
) -> Source {
    row = Map.get(names, table.name) |> Maybe.with_default(singular_pascal(table.name))
    visibility = if decl.public { "pub " } else { "" }
    span = Span.line(table.migration, Int.max(table.line, 1), "")

    src =
        src
        |> Source.add("\n/// A row of the table `${table.name}`.\n${visibility}struct ")
        |> Source.mapped(row, span)
        |> Source.add(" {\n")

    src = Iter.reduce(
        table.columns,
        fn s, c -> {
            base = if Iter.empty?(c.values) or !enum_values_ok?(c.values) {
                types.of(c.type_name)
                |> Maybe.map(fn f -> f.nomi)
                |> Maybe.with_default("sql.Value")
            } else {
                enum_name(row, c.name)
            }

            ty = if c.nullable { "Maybe<${base}>" } else { base }
            column_span = Span.line(c.migration, Int.max(c.line, 1), "")

            s
            |> Source.add("    ")
            |> Source.mapped("${c.name}: ${ty}", column_span)
            |> Source.add("\n")
        },
        from: src,
    )

    src |> Source.add("}\n")
}

fn enum_source(
    src: Source,
    decl: Declaration,
    names: Map<String, String>,
    table: Table,
    column: TableColumn,
) -> Source {
    if Iter.empty?(column.values) or !enum_values_ok?(column.values) {
        return src
    }

    row = Map.get(names, table.name) |> Maybe.with_default(singular_pascal(table.name))
    name = enum_name(row, column.name)
    visibility = if decl.public { "pub " } else { "" }
    span = Span.line(column.migration, Int.max(column.line, 1), "")

    variants = column.values |> Iter.map(fn v -> "    ${pascal(v)}\n") |> String.join()

    to_text =
        column.values
        |> Iter.map(fn v -> "            .${pascal(v)} -> ${quote(v)}\n")
        |> String.join()

    from_text =
        column.values
        |> Iter.map(fn v -> "            Some(${quote(v)}) -> Ok(${name}.${pascal(v)})\n")
        |> String.join()

    src
    |> Source.add(
        "\n/// The values `CHECK (${column.name} IN (...))` allows in `${table.name}.${column.name}`.\n${visibility}enum "
    )
    |> Source.mapped(name, span)
    |> Source.add(" {\n${variants}}\n\nderive Equatable for ${name}\n")
    |> Source.add(
        "\nimpl Display for ${name} {\n    fn to_string(value: ${name}) -> String {\n        case value {\n${to_text}        }\n    }\n}\n"
    )
    |> Source.add(
        "\nimpl sql.ToSql for ${name} {\n    fn to_sql(value: ${name}) -> sql.Value {\n        sql.Value.Text(Display.to_string(value))\n    }\n}\n"
    )
    |> Source.add(
        "\nimpl sql.FromSql for ${name} {\n    fn from_sql(value: sql.Value) -> Result<${name}, String> {\n        case runtime.text_of(value) {\n${from_text}            _ -> Err(${quote(
            name
        )})\n        }\n    }\n}\n"
    )
    |> Source.add("\nimpl sqlkit.SqlText for ${name} {}\n")
}

/// The enum a `CHECK (column IN (...))` column reads as: its table's row
/// struct and the column, so `orders.status` is `OrderStatus`.
//! assert generate.enum_name("Order", "status") == "OrderStatus"
//! assert generate.enum_name("OrderItem", "kind") == "OrderItemKind"
//
pub fn enum_name(row: String, column: String) -> String {
    row + pascal(column)
}

/// A table's name in the singular, by a plain English rule: `ies` is `y`,
/// `ses` is `s`, a name ending in `ss` stays, and an `s` at the end goes.
/// A name the rule gets wrong takes its row's name from nomi.toml.
//! assert generate.singular("users") == "user"
//! assert generate.singular("order_items") == "order_item"
//! assert generate.singular("categories") == "category"
//! assert generate.singular("addresses") == "address"
//! assert generate.singular("statuses") == "status"
//! assert generate.singular("glass") == "glass"
//! assert generate.singular("people") == "people"
//
pub fn singular(name: String) -> String {
    if String.ends_with?(name, "ies") {
        sqltext.cut_suffix(name, "ies") + "y"
    } else if String.ends_with?(name, "ses") {
        sqltext.cut_suffix(name, "es")
    } else if String.ends_with?(name, "ss") or !String.ends_with?(name, "s") {
        name
    } else {
        sqltext.cut_suffix(name, "s")
    }
}

fn singular_pascal(table: String) -> String {
    pascal(singular(table))
}

/// The row struct of `table` in db: the name nomi.toml's `tables` gives it,
/// or the table's name in the singular.
//! db = databases.defaults("main")
//! assert generate.row_name(db, "users") == "User"
//! assert generate.row_name(#{..db, tables: %{"people" => "Person"}}, "people") == "Person"
//
pub fn row_name(db: Database, table: String) -> String {
    Map.get(db.tables, table) |> Maybe.with_default(singular_pascal(table))
}

/// The row struct of each of the snapshot's tables, by table, or what is
/// wrong with the names: one nomi.toml gives that is not a type's name,
/// and two tables whose rows have one name.
fn row_names(
    decl: Declaration,
    db: Database,
    snap: Snapshot,
) -> Result<Map<String, String>, List<Diagnostic>> {
    names = snap.tables |> Iter.map(fn t -> #(t.name, row_name(db, t.name))) |> Iter.to_list()
    section = "[sqlkit.database.${db.name}.tables]"

    misnamed =
        db.tables
        |> Map.keys()
        |> Iter.sort()
        |> Iter.flat_map(fn table -> {
            given = Map.get(db.tables, table) |> Maybe.with_default("")

            if type_name?(given) {
                []
            } else {
                [
                    diagnostic(
                        decl.span,
                        "`${section}` names the row of `${table}` `${given}`, which is not a type's name",
                        [
                            "a type's name starts with a capital letter, then letters, digits and `_`: `${pascal(
                                given
                            )}`",
                        ],
                    ),
                ]
            }
        })
        |> Iter.to_list()

    clashes =
        names
        |> Iter.with_index()
        |> Iter.flat_map(fn #(i, #(table, row)) -> {
            earlier = names |> Iter.take(i) |> Iter.find(fn #(_, r) -> r == row)

            case earlier {
                Some(#(other, _)) ->
                    [
                        diagnostic(
                            decl.span,
                            "the tables `${other}` and `${table}` both have the row struct `${row}`",
                            ["name one in nomi.toml: `${section}`, `${table} = \"...\"`"],
                        ),
                    ]

                None ->
                    []
            }
        })
        |> Iter.to_list()

    problems = misnamed + clashes

    if Iter.empty?(problems) {
        Ok(Iter.to_map(names))
    } else {
        Err(problems)
    }
}

/// Whether text is a type's name: a capital letter, then letters, digits
/// and `_`.
fn type_name?(text: String) -> Bool {
    first = String.slice(text, 0, 1)

    String.contains?(
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        first,
    ) and first != "" and Iter.all?(text, fn c -> {
        String.contains?("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c)
    })
}

/// A table nomi.toml names a row for that the snapshot does not hold: a
/// misspelled name, which would otherwise be ignored.
fn unknown_tables(decl: Declaration, db: Database, snap: Snapshot) -> List<Diagnostic> {
    known = snap.tables |> Iter.map(fn t -> t.name) |> Iter.to_list()

    db.tables
    |> Map.keys()
    |> Iter.sort()
    |> Iter.filter(fn table -> !Iter.contains?(known, table))
    |> Iter.map(fn table -> {
        diagnostic(
            decl.span,
            "`[sqlkit.database.${db.name}.tables]` names the table `${table}`, which ${db.snapshot} does not hold",
            ["its tables are ${known |> Iter.map(fn t -> "`${t}`") |> String.join(", ")}"],
        )
    })
    |> Iter.to_list()
}

/// Whether each value makes a distinct variant name.
fn enum_values_ok?(values: List<String>) -> Bool {
    names = values |> Iter.map(pascal) |> Iter.to_list()

    Iter.count(Iter.to_set(names)) == Iter.count(names) and Iter.all?(names, fn n -> {
        n != "" and !String.contains?("0123456789", String.slice(n, 0, 1))
    })
}

/// `order_items` as `OrderItems`, `in-transit` as `InTransit`.
//! assert generate.pascal("order_items") == "OrderItems"
//! assert generate.pascal("in-transit") == "InTransit"
//
pub fn pascal(text: String) -> String {
    text
    |> String.replace("-", "_")
    |> String.replace(" ", "_")
    |> String.split("_")
    |> Iter.filter(fn w -> w != "")
    |> Iter.map(fn w -> {
        String.to_upper(String.slice(w, 0, 1)) + String.to_lower(
            String.slice(w, 1, String.length(w))
        )
    })
    |> String.join()
}

/// Two `database` declarations of one name.
pub fn duplicate_databases(decls: List<Declaration>) -> List<Diagnostic> {
    #(_, problems) = Iter.reduce(
        decls,
        fn acc, decl -> {
            #(seen, problems) = acc

            if Iter.contains?(seen, decl.name) {
                #(
                    seen,
                    [diagnostic(
                        decl.span,
                        "the database `${decl.name}` is declared twice",
                        [],
                    ), ..problems],
                )
            } else {
                #([decl.name, ..seen], problems)
            }
        },
        from: #([], []),
    )

    Iter.reverse(problems)
}
