//# The Nomi source `nomi tool sqlkit generate` writes: a database's schema
//# file (a row struct per table, an enum per `CHECK (column IN (...))`
//# column, and the migrations as data), one file of functions per query
//# file, and a test that the generated files are current. The generated
//# code states each fact about a query as code that checks only when the
//# fact holds: a column of the `INTEGER` family is read by a function
//# bounded by `SqlInt`, and a nullable one answers a `Maybe`.

import {
    databases.{self, Database}
    described.{self, Column, QueryError, Table, TableColumn}
    queryfile.{self, File, Problem, Query}
    sqltext.{self, Override, Token}
    types
}

/// The result a query declares.
enum Shape {
    /// `-> T`: exactly one row.
    One

    /// `-> Maybe<T>`.
    Optional

    /// `-> List<T>`, and a query with no result type, whose rows are
    /// anonymous structs.
    Many

    /// `-> Rows<T>`.
    Stream

    /// `-> Changed` on SQL that returns no rows: the number of rows it
    /// changed.
    Changed

    /// `-> Unit` on SQL that returns no rows: the count is ignored.
    Ignored
}

derive Equatable for Shape

/// One column as the generated code reads it.
struct Field {
    name: String
    position: Int
    reader: String

    // What the reader takes after the row and position: the scale of a
    // DECIMAL(p, s) column, `, 2`.
    args: String
    type_text: Maybe<String>
    nullable: Bool
}

/// A database's schema as the generated code names it: the database, its
/// tables, each table's row struct by table, and the file that declares
/// them.
pub struct Schema {
    db: Database
    tables: List<Table>
    rows: Map<String, String>
    module: String
}

fn problem_at(query: Query, line: Int, col: Int, message: String, hints: List<String>) -> Problem {
    #Problem{file: query.file, line, col, message, hints}
}

fn at_token(query: Query, token: Token, message: String, hints: List<String>) -> Problem {
    #(line, col) = queryfile.place(query, token.start)
    problem_at(query, line, col, message, hints)
}

fn at_annotation(query: Query, col: Int, message: String, hints: List<String>) -> Problem {
    problem_at(query, query.line, col, message, hints)
}

// --- the files -------------------------------------------------------
/// The comment a generated file starts with: what it was generated from,
/// and the digest of the inputs, which its test checks.
//! assert codegen.header(
//!     "db/migrations",
//!     "ab12",
//! ) == "// Generated by `nomi tool sqlkit generate` from db/migrations. Do not edit:\n// change the SQL and generate again.\n// inputs sha256: ab12\n"
//
pub fn header(sources: String, digest: String) -> String {
    text = "Generated by `nomi tool sqlkit generate` from ${sources}. Do not edit: change the SQL and generate again."
    "${wrap(text)}// inputs sha256: ${digest}\n"
}

// text as `//` comment lines of at most 76 characters of text each.
fn wrap(text: String) -> String {
    #(lines, last) = Iter.reduce(
        String.split(text, " "),
        fn acc, word -> {
            #(lines, line) = acc

            if line == "" {
                #(lines, word)
            } else if String.length(line) + 1 + String.length(word) > 76 {
                #([line, ..lines], word)
            } else {
                #(lines, "${line} ${word}")
            }
        },
        from: #([], ""),
    )

    [last, ..lines] |> Iter.reverse() |> Iter.map(fn line -> "// ${line}\n") |> String.join()
}

/// The digest a generated file's header records, if it is one.
//! text = codegen.header("x", "ab12") + "import sqlkit\n"
//! assert codegen.recorded(text) == Some("ab12")
//! assert codegen.recorded("import sqlkit\n") == None
//
pub fn recorded(text: String) -> Maybe<String> {
    if !String.starts_with(text, "// Generated by `nomi tool sqlkit generate`") { return None }

    String.split(text, "\n")
    |> Iter.take(4)
    |> Iter.flat_map(fn line -> String.strip_prefix(line, "// inputs sha256: ") |> sqltext.listed())
    |> Iter.first()
}

fn migrations_source(db: Database) -> String {
    db.migrations
}

/// The import block of a file.
//! imports = %{"sqlkit" => %["self"], "std/sql" => %["self"], "schema" => %["User", "Order"]}
//!
//! assert codegen.import_block(imports)
//!     == "import {\n    std/sql\n    schema.{Order, User}\n    sqlkit\n}\n"
//!
//! assert codegen.import_block(%{"sqlkit/inputs" => %["self"]}) == "import sqlkit/inputs\n"
//
/// The imports a generated file needs are each module path with the
/// names it imports from it, `self` for the module itself.
pub fn import_block(imports: Map<String, Set<String>>) -> String {
    map = imports

    entries =
        map
        |> Map.keys()
        |> Iter.sort_by(fn path -> {
            if String.starts_with(path, "std/") or path == "std" {
                "0${path}"
            } else {
                "1${path}"
            }
        })
        |> Iter.map(fn path -> {
            names = Map.get(map, path) |> Maybe.with_default(%[])
            others = names |> Iter.filter(fn n -> n != "self") |> Iter.sort()

            listed = if Iter.contains(names, "self") {
                ["self", ..others]
            } else {
                others
            }

            case listed {
                ["self"] -> path
                [one] -> "${path}.${one}"
                many -> "${path}.{${String.join(many, ", ")}}"
            }
        })
        |> Iter.to_list()

    case entries {
        [one] -> "import ${one}\n"
        _ -> "import {\n${entries |> Iter.map(fn e -> "    ${e}\n") |> String.join()}}\n"
    }
}

fn imports_of(entries: List<#(String, String)>) -> Map<String, Set<String>> {
    Iter.reduce(
        entries,
        fn acc: Map<String, Set<String>>, #(path, name) -> {
            names = Map.get(acc, path) |> Maybe.with_default(%[])
            Map.put(acc, path, Set.insert(names, name))
        },
        from: %{},
    )
}

/// The module path and the names an import entry as written imports:
/// `shop.Report`, `std/calendar.{Date, Time}`, `shop` (the module).
//! assert codegen.entry("shop.Report") == #("shop", ["Report"])
//! assert codegen.entry("std/calendar.{Date, Time}") == #("std/calendar", ["Date", "Time"])
//! assert codegen.entry("shop") == #("shop", ["self"])
//
pub fn entry(text: String) -> #(String, List<String>) {
    segments = String.split(text, "/") |> Iter.to_list()
    last = Iter.last(segments) |> Maybe.with_default("")

    dir =
        segments
        |> Iter.take(Iter.count(segments) - 1)
        |> Iter.map(fn s -> s + "/")
        |> String.join()

    case String.split(last, ".") |> Iter.to_list() {
        [module] ->
            #(dir + module, ["self"])

        [module, ..rest] -> {
            items = String.join(rest, ".") |> sqltext.cut_prefix("{") |> sqltext.cut_suffix("}")

            names =
                String.split(items, ",")
                |> Iter.map(String.trim)
                |> Iter.filter(fn n -> n != "")
                |> Iter.to_list()

            #(dir + module, names)
        }

        [] ->
            #(text, ["self"])
    }
}

// --- the schema file -------------------------------------------------
/// The schema of db's tables: each table's row struct, or what is wrong
/// with the names `[sqlkit.database.<name>.tables]` gives.
pub fn schema(db: Database, tables: List<Table>, module: String) -> Result<Schema, List<Problem>> {
    names = tables |> Iter.map(fn t -> #(t.name, row_name(db, t.name))) |> Iter.to_list()
    section = "[sqlkit.database.${db.name}.tables]"

    toml = fn message: String, hints: List<String> -> {
        #Problem{file: "nomi.toml", line: 0, col: 0, message, hints}
    }

    misnamed =
        db.tables
        |> Map.keys()
        |> Iter.sort()
        |> Iter.flat_map(fn table -> {
            given = Map.get(db.tables, table) |> Maybe.with_default("")

            if is_type_name(given) {
                []
            } else {
                [
                    toml(
                        "`${section}` names the row of `${table}` `${given}`, which is not a type's name",
                        [
                            "a type's name starts with a capital letter, then letters, digits and `_`: `${String.pascal_case(
                                given
                            )}`",
                        ],
                    ),
                ]
            }
        })
        |> Iter.to_list()

    known = tables |> Iter.map(fn t -> t.name) |> Iter.to_list()

    unknown =
        db.tables
        |> Map.keys()
        |> Iter.sort()
        |> Iter.filter(fn table -> !Iter.contains(known, table))
        |> Iter.map(fn table -> {
            toml(
                "`${section}` names the table `${table}`, which the migrations do not create",
                ["its tables are ${known |> Iter.map(fn t -> "`${t}`") |> String.join(", ")}"],
            )
        })
        |> Iter.to_list()

    clashes =
        names
        |> Iter.with_index()
        |> Iter.flat_map(fn #(i, #(table, row)) -> {
            earlier = names |> Iter.take(i) |> Iter.find(fn #(_, r) -> r == row)

            case earlier {
                Some(#(other, _)) ->
                    [
                        toml(
                            "the tables `${other}` and `${table}` both have the row struct `${row}`",
                            ["name one in nomi.toml: `${section}`, `${table} = \"...\"`"],
                        ),
                    ]

                None ->
                    []
            }
        })
        |> Iter.to_list()

    problems = misnamed + unknown + clashes

    if Iter.is_empty(problems) {
        Ok(#Schema{db, tables, rows: Iter.to_map(names), module})
    } else {
        Err(problems)
    }
}

/// The names of the types the schema file declares: the row structs and
/// the enums.
pub fn schema_types(s: Schema) -> List<String> {
    s.tables
    |> Iter.flat_map(fn t -> {
        row = row_of(s, t.name)

        enums =
            t.columns
            |> Iter.filter(fn c -> is_enum_column(c))
            |> Iter.map(fn c -> enum_name(row, c.name))

        Iter.concat([row], enums)
    })
    |> Iter.to_list()
}

fn row_of(s: Schema, table: String) -> String {
    Map.get(s.rows, table) |> Maybe.with_default(singular_pascal(table))
}

fn is_enum_column(c: TableColumn) -> Bool {
    !Iter.is_empty(c.values) and has_valid_enum_values(c.values)
}

/// The schema file: the row structs, the enums and the migrations.
pub fn schema_file(s: Schema, migrations: List<#(String, String)>, digest: String) -> String {
    columns = s.tables |> Iter.flat_map(fn t -> t.columns) |> Iter.to_list()
    any_enum = Iter.any(columns, is_enum_column)

    plain =
        columns
        |> Iter.filter(fn c -> !is_enum_column(c))
        |> Iter.map(fn c -> types.of(c.type_name))
        |> Iter.to_list()

    family_imports =
        plain
        |> Iter.flat_map(fn f -> {
            case f |> Maybe.flat_map(fn x -> x.module |> Maybe.map(fn m -> #(m, x.nomi))) {
                Some(pair) -> [pair]
                None -> []
            }
        })
        |> Iter.to_list()

    sql_value = Iter.any(plain, fn f -> f == None)

    base = if any_enum {
        [#("sqlkit", "self"), #("sqlkit/runtime", "self"), #("std/sql", "self")]
    } else if sql_value {
        [#("sqlkit", "self"), #("std/sql", "self")]
    } else {
        [#("sqlkit", "self")]
    }

    structs = s.tables |> Iter.map(fn t -> table_source(s, t)) |> String.join()

    enums =
        s.tables
        |> Iter.flat_map(fn t -> {
            t.columns
            |> Iter.filter(is_enum_column)
            |> Iter.map(fn c -> enum_source(row_of(s, t.name), t, c))
        })
        |> String.join()

    list = migrations |> Iter.map(fn #(path, text) -> migration_source(path, text)) |> String.join()

    header(migrations_source(s.db), digest) + import_block(
        imports_of(base + family_imports)
    ) + structs + enums + "\n/// The migrations of the database `${s.db.name}`, in the order they apply.\npub once migrations: List<sqlkit.Migration> = [\n${list}]\n"
}

fn migration_source(path: String, text: String) -> String {
    "    #sqlkit.Migration{\n        path: ${quote(path)},\n        sql: ${quote(text)},\n    },\n"
}

fn table_source(s: Schema, table: Table) -> String {
    row = row_of(s, table.name)

    fields =
        table.columns
        |> Iter.map(fn c -> {
            base = if is_enum_column(c) {
                enum_name(row, c.name)
            } else {
                types.of(c.type_name)
                |> Maybe.map(fn f -> f.nomi)
                |> Maybe.with_default("sql.Value")
            }

            ty = if c.nullable { "Maybe<${base}>" } else { base }
            "    ${c.name}: ${ty}\n"
        })
        |> String.join()

    "\n/// A row of the table `${table.name}`.\npub struct ${row} {\n${fields}}\n"
}

fn enum_source(row: String, table: Table, column: TableColumn) -> String {
    name = enum_name(row, column.name)
    variants = column.values |> Iter.map(fn v -> "    ${String.pascal_case(v)}\n") |> String.join()

    to_text =
        column.values
        |> Iter.map(fn v -> "            .${String.pascal_case(v)} -> ${quote(v)}\n")
        |> String.join()

    from_text =
        column.values
        |> Iter.map(fn v -> {
            "            Some(${quote(v)}) -> Ok(${name}.${String.pascal_case(v)})\n"
        })
        |> String.join()

    "\n/// The values `CHECK (${column.name} IN (...))` allows in `${table.name}.${column.name}`.\npub enum ${name} {\n${variants}}\n\nderive Equatable for ${name}\n" + "\nimpl Display for ${name} {\n    fn to_string(value: ${name}) -> String {\n        case value {\n${to_text}        }\n    }\n}\n" + "\nimpl sql.ToSql for ${name} {\n    fn to_sql(value: ${name}) -> sql.Value {\n        sql.Value.Text(Display.to_string(value))\n    }\n}\n" + "\nimpl sql.FromSql for ${name} {\n    fn from_sql(value: sql.Value) -> Result<${name}, String> {\n        case runtime.text_of(value) {\n${from_text}            _ -> Err(${quote(
        name
    )})\n        }\n    }\n}\n" + "\nimpl sqlkit.SqlText for ${name}\n"
}

/// The test file: that the inputs are still the ones the files were
/// generated from.
pub fn test_file(db: Database, digest: String) -> String {
    header(
        "${migrations_source(db)} and ${db.queries}",
        digest,
    ) + "import sqlkit/inputs\n\n" + "// Fails when a migration or a query changed after the last\n" + "// `nomi tool sqlkit generate`: run it again. The paths are under the\n" + "// module root, where `nomi test` resolves a test's relative paths.\n" + "test \"generated sql is current\" {\n" + "    assert inputs.current(${quote(
        db.migrations
    )}, ${quote(db.queries)})\n" + "        == Ok(${quote(digest)})\n" + "}\n"
}

// --- the queries files -----------------------------------------------
/// The file of functions a query file generates, or what is wrong with its
/// queries. `described` is each query's description, in order.
pub fn queries_file(
    s: Schema,
    file: File,
    described: List<Result<List<Column>, QueryError>>,
    digest: String,
) -> Result<String, List<Problem>> {
    explicit =
        file.imports
        |> Iter.flat_map(fn e -> {
            #(path, names) = entry(e)
            names |> Iter.map(fn n -> #(path, n))
        })
        |> Iter.to_list()

    resolver = #Resolver{
        explicit: explicit
        |> Iter.map(fn #(_, n) -> String.split(n, " as ") |> Iter.last() |> Maybe.with_default(n))
        |> Iter.map(String.trim)
        |> Iter.to_list(),
        schema: schema_types(s),
        schema_module: s.module,
    }

    results =
        Iter.zip(file.queries, described)
        |> Iter.map(fn #(q, d) -> function(s, resolver, q, d))
        |> Iter.to_list()

    problems =
        results
        |> Iter.flat_map(fn r -> {
            case r {
                Err(ps) -> ps
                Ok(_) -> []
            }
        })
        |> Iter.to_list()

    if !Iter.is_empty(problems) { return Err(problems) }

    made =
        results
        |> Iter.flat_map(fn r -> {
            case r {
                Ok(m) -> [m]
                Err(_) -> []
            }
        })
        |> Iter.to_list()

    needs = made |> Iter.flat_map(fn m -> m.imports) |> Iter.to_list()
    base = [#("std/sql", "self"), #("sqlkit/runtime", "self")]
    imports = imports_of(base + needs + explicit)
    functions = made |> Iter.map(fn m -> "\n" + m.text) |> String.join()

    Ok(
        header("${file.path} and ${migrations_source(s.db)}", digest) + import_block(
            imports
        ) + functions
    )
}

/// What a type name in a query's signature resolves to: a name the file
/// imports itself, a type of the schema, or one of std's.
struct Resolver {
    explicit: List<String>
    schema: List<String>
    schema_module: String
}

/// A generated function and the imports it needs.
struct Made {
    text: String
    imports: List<#(String, String)>
}

// The names the prelude gives every file.
once prelude: List<String> = [
    "Bool",
    "Byte",
    "Bytes",
    "Codepoint",
    "Decimal",
    "Float",
    "Int",
    "List",
    "Map",
    "Maybe",
    "Ordering",
    "Result",
    "Set",
    "String",
    "Unit",
    "Vector",
]

// std's types a query may name, and the module each is in.
once std_types: Map<String, String> = %{
    "Date" => "std/calendar",
    "Duration" => "std/duration",
    "Instant" => "std/instant",
    "Json" => "std/json",
    "NaiveDateTime" => "std/calendar",
    "Time" => "std/calendar",
    "Uuid" => "std/uuid",
}

/// The type names a type as written names, outside a qualified name:
/// `Maybe<User>` names `Maybe` and `User`, `sql.Value` none.
//! assert codegen.type_names("Map<String, List<User>>") == ["Map", "String", "List", "User"]
//! assert codegen.type_names("sql.Value") == []
//
pub fn type_names(text: String) -> List<String> {
    solid =
        sqltext.tokens(text)
        |> Iter.filter(fn t -> t.kind != sqltext.Kind.Space)
        |> Iter.to_vector()

    solid
    |> Iter.with_index()
    |> Iter.flat_map(fn #(i, t) -> {
        before = if i == 0 {
            ""
        } else {
            Vector.get(solid, i - 1) |> Maybe.map(fn b -> b.text) |> Maybe.with_default("")
        }

        first = String.slice(t.text, 0, 1)
        upper = first != "" and String.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", first)

        if t.kind == sqltext.Kind.Word and upper and before != "." {
            [t.text]
        } else {
            []
        }
    })
    |> Iter.to_list()
}

// The imports the types in `text` need, or the problem with the first
// type nothing gives.
fn resolve(r: Resolver, text: String) -> Result<List<#(String, String)>, String> {
    type_names(text)
    |> Iter.filter(fn n -> !Iter.contains(prelude, n) and !Iter.contains(r.explicit, n))
    |> Iter.map(fn n -> {
        if Iter.contains(r.schema, n) {
            Ok(#(r.schema_module, n))
        } else {
            case Map.get(std_types, n) {
                Some(m) -> Ok(#(m, n))
                None -> Err(n)
            }
        }
    })
    |> Result.collect()
}

fn unknown_type(q: Query, col: Int, name: String) -> Problem {
    at_annotation(
        q,
        col,
        "`${name}` is not a type of the schema, the prelude or std",
        ["import it at the top of the file: `-- import: path/to/file.${name}`"],
    )
}

// The function a query generates, or what is wrong with it.
fn function(
    s: Schema,
    r: Resolver,
    q: Query,
    d: Result<List<Column>, QueryError>,
) -> Result<Made, List<Problem>> {
    tokens = sqltext.tokens(q.sql)
    markers = sqltext.markers(tokens)
    marker_problems = check_markers(q, markers, sqltext.interpolations(tokens))

    #(shape, row) = case shape_of(q) {
        Ok(found) -> found
        Err(p) -> return Err([p, ..marker_problems])
    }

    signature_imports =
        q.params
        |> Iter.map(fn p -> {
            resolve(r, p.type_text) |> Result.map_err(fn n -> unknown_type(q, p.col, n))
        })
        |> Iter.concat([
            row
            |> Maybe.map(fn t -> resolve(r, t))
            |> Maybe.with_default(Ok([]))
            |> Result.map_err(fn n -> unknown_type(q, q.result_col, n)),
        ])
        |> Iter.to_list()

    type_problems =
        signature_imports
        |> Iter.flat_map(fn x -> {
            case x {
                Err(p) -> [p]
                Ok(_) -> []
            }
        })
        |> Iter.to_list()

    if !Iter.is_empty(marker_problems + type_problems) {
        return Err(marker_problems + type_problems)
    }

    columns = case d {
        Ok(cs) ->
            cs

        Err(e) -> {
            p = case sqltext.token_at_offset(tokens, e.offset) {
                Some(t) -> at_token(q, t, e.message, ["reported by SQLite for `${q.name}`"])
                None -> at_annotation(q, 1, e.message, ["reported by SQLite for `${q.name}`"])
            }

            return Err([p])
        }
    }

    final_shape = case described_shape(q, shape, row, columns) {
        Ok(found) -> found
        Err(p) -> return Err([p])
    }

    #(fields, field_imports, problems) = fields_of(s, r, q, tokens, columns, row == None)

    if !Iter.is_empty(problems) { return Err(problems) }

    shape_imports = if final_shape == Shape.Stream or final_shape == Shape.Changed {
        [#("sqlkit", "self")]
    } else {
        []
    }

    found_imports =
        signature_imports
        |> Iter.flat_map(fn x -> {
            case x {
                Ok(is) -> is
                Err(_) -> []
            }
        })
        |> Iter.to_list()

    text = function_source(q, final_shape, row, sqltext.parts(tokens), markers, fields)
    Ok(#Made{text, imports: found_imports + field_imports + shape_imports})
}

/// Every `@name` names a parameter, every parameter is used, and no
/// `${...}` is left in the SQL.
fn check_markers(q: Query, markers: List<Token>, interpolations: List<Token>) -> List<Problem> {
    names = q.params |> Iter.map(fn p -> p.name) |> Iter.to_list()

    // A `${name}` the author meant as a parameter counts as using it, so
    // its own error is the only one.
    meant = interpolations |> Iter.map(fn t -> interpolated_name(t.text)) |> Iter.to_list()
    used = markers |> Iter.map(fn m -> sqltext.marker_name(m.text)) |> Iter.to_list()

    left =
        interpolations
        |> Iter.map(fn t -> {
            name = interpolated_name(t.text)

            suggestion = if sqltext.is_name(name) {
                "write `@${name}`: a query binds a parameter with `@name`"
            } else {
                "a query binds a parameter with `@name`"
            }

            at_token(q, t, "a query's SQL has no `${"$"}{...}`", [suggestion])
        })

    unknown =
        markers
        |> Iter.filter(fn m -> !Iter.contains(names, sqltext.marker_name(m.text)))
        |> Iter.map(fn m -> {
            name = sqltext.marker_name(m.text)

            hint = if Iter.is_empty(names) {
                "`${q.name}` takes no parameters; declare one: `-- query: ${q.name}(${name}: String)`"
            } else {
                "its parameters are ${names |> Iter.map(fn n -> "`${n}`") |> String.join(", ")}"
            }

            at_token(q, m, "`${name}` is not a parameter of `${q.name}`", [hint])
        })

    unused =
        q.params
        |> Iter.filter(fn p -> !Iter.contains(used, p.name) and !Iter.contains(meant, p.name))
        |> Iter.map(fn p -> {
            at_annotation(
                q,
                p.col,
                "the parameter `${p.name}` is not used in the SQL of `${q.name}`",
                ["write `@${p.name}` where it is bound, or remove it"],
            )
        })

    left |> Iter.concat(unknown) |> Iter.concat(unused) |> Iter.to_list()
}

/// The name inside a `${...}`, trimmed.
fn interpolated_name(text: String) -> String {
    text
    |> sqltext.cut_prefix("\${")
    |> sqltext.cut_suffix("}")
    |> String.trim()
}

/// The shape the declared result type names, and its row type.
fn shape_of(q: Query) -> Result<#(Shape, Maybe<String>), Problem> {
    case q.result {
        None ->
            Ok(#(Shape.Many, None))

        Some(text) -> {
            if text == "Unit" { return Ok(#(Shape.Ignored, None)) }

            if text == "Changed" or text == "sqlkit.Changed" { return Ok(#(Shape.Changed, None)) }

            #(shape, inner, prefix) = if is_wrapped(text, "Maybe") {
                #(Shape.Optional, unwrap(text, "Maybe"), "Maybe<")
            } else if is_wrapped(text, "List") {
                #(Shape.Many, unwrap(text, "List"), "List<")
            } else if is_wrapped(text, "Rows") {
                #(Shape.Stream, unwrap(text, "Rows"), "Rows<")
            } else {
                #(Shape.One, text, "")
            }

            if inner == "" {
                return Err(
                    at_annotation(
                        q,
                        q.result_col,
                        "a query's result names its row type: `-> ${prefix}User>`",
                        [],
                    )
                )
            }

            Ok(#(shape, Some(inner)))
        }
    }
}

fn is_wrapped(text: String, name: String) -> Bool {
    String.starts_with(text, name + "<") and String.ends_with(text, ">")
}

fn unwrap(text: String, name: String) -> String {
    text |> sqltext.cut_prefix(name + "<") |> sqltext.cut_suffix(">") |> String.trim()
}

/// The shape a query takes once SQLite gives its columns, or what is wrong
/// with its result type. SQL that returns no rows answers the number of
/// rows it changed (`-> Changed`) or nothing (`-> Unit`), and only SQL
/// that returns rows can leave its result type out or name a row type.
fn described_shape(
    q: Query,
    shape: Shape,
    row: Maybe<String>,
    columns: List<Column>,
) -> Result<Shape, Problem> {
    count_hint = "write `-> Changed` for the count, or `-> Unit` to ignore it"
    rows_hint = "name their type, `-> List<MyRow>`, or leave the result type out to read them as anonymous structs"
    result_col = if q.result == None { 1 } else { q.result_col }

    case #(shape, row, Iter.is_empty(columns)) {
        #(.Many, None, True) ->
            Err(
                at_annotation(
                    q,
                    1,
                    "`${q.name}` returns no rows, so its result is the number of rows it changed: write `-> Changed`",
                    [count_hint],
                )
            )

        #(.Ignored, _, False) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns rows, so its result cannot be `Unit`",
                    [rows_hint],
                )
            )

        #(.Changed, _, False) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns rows, so its result cannot be `Changed`",
                    [rows_hint],
                )
            )

        #(.One, Some("Int"), True) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns no rows, so it cannot answer an `Int`; write `-> Changed` for the number of rows it changed, or `-> Unit`",
                    [],
                )
            )

        #(_, Some(_), True) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns no rows, so it has no row type",
                    [count_hint],
                )
            )

        #(found, _, _) ->
            Ok(found)
    }
}

/// How each column is read, the imports its type needs, or what is wrong
/// with the columns.
fn fields_of(
    s: Schema,
    r: Resolver,
    q: Query,
    tokens: List<Token>,
    columns: List<Column>,
    anonymous: Bool,
) -> #(List<Field>, List<#(String, String)>, List<Problem>) {
    items = sqltext.select_items(tokens) |> Iter.to_vector()
    overrides = sqltext.overrides(tokens)
    one_item_per_column = Vector.length(items) == Iter.count(columns)

    #(fields, imports, problems, _) = Iter.reduce(
        Iter.with_index(columns),
        fn acc, #(position, column) -> {
            #(fields, imports, problems, seen) = acc

            at = fn message: String, hints: List<String> -> {
                item = if one_item_per_column {
                    Vector.get(items, position)
                } else {
                    None
                }

                case item |> Maybe.flat_map(Iter.first) {
                    Some(t) -> at_token(q, t, message, hints)
                    None -> at_annotation(q, 1, message, hints)
                }
            }

            override = Iter.find(overrides, fn o -> o.column == column.name)

            if !sqltext.is_name(column.name) {
                problem = at(
                    "the column `${column.name}` has no name a field can take",
                    ["name it with `AS`: `${column.name} AS \"total\"`"],
                )

                return #(fields, imports, [problem, ..problems], seen)
            }

            if Iter.contains(seen, column.name) {
                problem = at(
                    "`${q.name}` has two columns named `${column.name}`",
                    ["rename one with `AS`"],
                )

                return #(fields, imports, [problem, ..problems], seen)
            }

            #(field, needs, problem) = field_of(s, r, q, column, position, override, anonymous, at)

            #(
                [field, ..fields],
                needs + imports,
                sqltext.listed(problem) + problems,
                [column.name, ..seen],
            )
        },
        from: #([], [], [], []),
    )

    #(Iter.reverse(fields), imports, Iter.reverse(problems))
}

fn field_of(
    s: Schema,
    r: Resolver,
    q: Query,
    column: Column,
    position: Int,
    override: Maybe<Override>,
    anonymous: Bool,
    at: (String, List<String>) -> Problem,
) -> #(Field, List<#(String, String)>, Maybe<Problem>) {
    nullable = override |> Maybe.flat_map(fn o -> o.nullable) |> Maybe.with_default(column.nullable)
    type_override = override |> Maybe.flat_map(fn o -> o.type_text)
    enum_name = enum_of(s, column)

    family = if enum_name != None {
        Some(types.text_family())
    } else {
        types.of(column.type_name)
    }

    scale = types.scale(column.type_name)

    #(reader, args) = case #(type_override, family, scale) {
        #(Some(_), _, _) -> #("value", "")
        #(None, Some(f), Some(n)) when f.reader == "numeric" -> #("numeric_scaled", ", ${n}")
        #(None, Some(f), _) -> #(f.reader, "")
        #(None, None, _) -> #("value", "")
    }

    type_text = case #(type_override, enum_name, family) {
        #(Some(t), _, _) -> Some(t)
        #(None, Some(e), _) -> Some(e)
        #(None, None, Some(f)) -> Some(f.nomi)
        #(None, None, None) -> None
    }

    field = #Field{name: column.name, position, reader, args, type_text, nullable}

    // Only an anonymous row names a column's type in the generated code.
    if !anonymous { return #(field, [], None) }

    case type_text {
        None -> {
            problem = at(
                "SQLite reports no type for the column `${column.name}` of `${q.name}`: it is an expression",
                [
                    "give its type in its name: `AS \"${column.name}: Int\"`, or declare the row type: `-> List<MyRow>`",
                ],
            )

            #(field, [], Some(problem))
        }

        Some(t) ->
            case resolve(r, t) {
                Ok(needs) ->
                    #(field, needs, None)

                Err(n) ->
                    #(
                        field,
                        [],
                        Some(
                            at(
                                "`${n}` is not a type of the schema, the prelude or std",
                                [
                                    "import it at the top of the file: `-- import: path/to/file.${n}`",
                                ],
                            )
                        ),
                    )
            }
    }
}

/// The enum a column of a table with a `CHECK (column IN (...))` reads
/// as, by its name.
fn enum_of(s: Schema, column: Column) -> Maybe<String> {
    if column.table == "" { return None }

    described.column(s.tables, column.table, column.column)
    |> Maybe.flat_map(fn c -> {
        if is_enum_column(c) {
            Some(enum_name(row_of(s, column.table), column.column))
        } else {
            None
        }
    })
}

fn result_type(shape: Shape, row: Maybe<String>, fields: List<Field>) -> String {
    row_text = case row {
        Some(t) -> t
        None -> anonymous_type(fields)
    }

    case shape {
        .One -> "Result<${row_text}, sql.Error>"
        .Optional -> "Result<Maybe<${row_text}>, sql.Error>"
        .Many -> "Result<List<${row_text}>, sql.Error>"
        .Stream -> "sqlkit.Rows<${row_text}>"
        .Changed -> "Result<sqlkit.Changed, sql.Error>"
        .Ignored -> "Result<Unit, sql.Error>"
    }
}

fn field_type(field: Field) -> String {
    base = field.type_text |> Maybe.with_default("sql.Value")

    if field.nullable {
        "Maybe<${base}>"
    } else {
        base
    }
}

fn anonymous_type(fields: List<Field>) -> String {
    inner = fields |> Iter.map(fn f -> "${f.name}: ${field_type(f)}") |> String.join(", ")
    "#{${inner}}"
}

/// The generated function's text.
fn function_source(
    q: Query,
    shape: Shape,
    row: Maybe<String>,
    parts: List<String>,
    markers: List<Token>,
    fields: List<Field>,
) -> String {
    doc =
        q.doc
        |> Iter.map(fn line -> if line == "" { "///\n" } else { "/// ${line}\n" })
        |> String.join()

    params = q.params |> Iter.map(fn p -> "${p.name}: ${p.type_text}") |> Iter.to_list()
    signature = signature_source(q.name, ["conn: sql.Conn", ..params], shape, row, fields)
    quoted_parts = parts |> Iter.map(quote) |> Iter.to_list()

    binds =
        markers
        |> Iter.map(fn m -> "runtime.bind(${sqltext.marker_name(m.text)})")
        |> Iter.to_list()

    statement = statement_source(quoted_parts, binds)
    name = quote(q.name)

    body = case shape {
        .Changed ->
            "    runtime.exec(conn, statement)\n"

        .Ignored ->
            "    runtime.run(conn, statement)\n"

        _ -> {
            reader = case shape {
                .One -> "one"
                .Optional -> "optional"
                .Stream -> "rows"
                _ -> "list"
            }

            scalar = case #(row, fields) {
                #(Some(t), [only]) when is_scalar(t) -> Some(only)
                _ -> None
            }

            case scalar {
                Some(field) -> {
                    suffix = if field.nullable { "_null" } else { "" }

                    call = "runtime.${reader}(conn, ${name}, statement, fn row -> "
                    read = "runtime.${field.reader}${suffix}(${name}, row, 0${field.args})"

                    if fits("    ${call}${read})") {
                        "    ${call}${read})\n"
                    } else {
                        "    ${call}{\n        ${read}\n    })\n"
                    }
                }

                None -> {
                    open = case row {
                        Some(t) -> "#${t}{"
                        None -> "#{"
                    }

                    lines =
                        fields
                        |> Iter.map(fn f -> field_line(f, name, row == None))
                        |> String.join()

                    "    runtime.${reader}(conn, ${name}, statement, fn row -> Ok(${open}\n${lines}        }))\n"
                }
            }
        }
    }

    doc + signature + statement + body + "}\n"
}

// Whether a line fits the formatter's width.
fn fits(line: String) -> Bool {
    String.length(line) <= 100
}

// `items` as the formatter lays out a list of them after `head` and before
// `tail` at `indent`: on one line when it fits, else one item a line.
fn listed_source(indent: String, head: String, items: List<String>, tail: String) -> String {
    one = "${indent}${head}${String.join(items, ", ")}${tail}"

    if fits(one) or Iter.is_empty(items) {
        "${one}\n"
    } else {
        lines = items |> Iter.map(fn item -> "${indent}    ${item},\n") |> String.join()

        "${indent}${head}\n${lines}${indent}${String.slice(tail, 0, 1)}${String.slice(
            tail,
            1,
            String.length(tail),
        )}\n"
    }
}

// The statement a function binds, laid out as the formatter does.
fn statement_source(parts: List<String>, binds: List<String>) -> String {
    one = "    statement = runtime.statement([${String.join(parts, ", ")}], [${String.join(
        binds,
        ", ",
    )}])"

    if fits(one) {
        "${one}\n\n"
    } else {
        "    statement = runtime.statement(\n" + listed_source(
            "        ",
            "[",
            parts,
            "],",
        ) + listed_source("        ", "[", binds, "],") + "    )\n\n"
    }
}

// A generated function's signature through its `{`, laid out as the
// formatter does: on one line when it fits; else an anonymous row's fields
// one a line when the rest fits, and else the parameters one a line.
fn signature_source(
    name: String,
    params: List<String>,
    shape: Shape,
    row: Maybe<String>,
    fields: List<Field>,
) -> String {
    result = result_type(shape, row, fields)
    head = "pub fn ${name}(${String.join(params, ", ")})"
    one = "${head} -> ${result} {"

    if fits(one) { return "${one}\n" }

    anonymous = row == None and !Iter.is_empty(fields)
    opened = "-> ${result_open(shape)}#{"

    if anonymous and fits("${head} ${opened}") {
        return "${head} ${opened}\n${broken_fields(fields)}}${result_close(shape)} {\n"
    }

    lines = params |> Iter.map(fn p -> "    ${p},\n") |> String.join()
    close = ") -> ${result} {"

    if fits(close) or !anonymous {
        "pub fn ${name}(\n${lines}${close}\n"
    } else {
        "pub fn ${name}(\n${lines}) ${opened}\n${broken_fields(fields)}}${result_close(shape)} {\n"
    }
}

fn broken_fields(fields: List<Field>) -> String {
    fields |> Iter.map(fn f -> "    ${f.name}: ${field_type(f)},\n") |> String.join()
}

// The result type before and after an anonymous row's `#{...}`.
fn result_open(shape: Shape) -> String {
    case shape {
        .One -> "Result<"
        .Optional -> "Result<Maybe<"
        .Stream -> "sqlkit.Rows<"
        _ -> "Result<List<"
    }
}

fn result_close(shape: Shape) -> String {
    case shape {
        .One -> ", sql.Error>"
        .Optional -> ">, sql.Error>"
        .Stream -> ">"
        _ -> ">, sql.Error>"
    }
}

fn field_line(field: Field, name: String, anonymous: Bool) -> String {
    suffix = if field.nullable { "_null" } else { "" }

    type_args = case #(anonymous, field.type_text, field.reader) {
        #(True, Some(t), _) -> "<${t}>"
        #(False, Some(t), "value") -> "<${t}>"
        _ -> ""
    }

    args = [name, "row", "${field.position}"] + (field.args
    |> sqltext.cut_prefix(", ")
    |> String.split(", ")
    |> Iter.filter(fn a -> a != "")
    |> Iter.to_list())

    listed_source(
        "            ",
        "${field.name}: runtime.${field.reader}${suffix}${type_args}(",
        args,
        ")?,",
    )
}

/// Whether a row type names one of std's value types (or a `Maybe` of
/// one), which a query of one column reads the column as, rather than a
/// struct.
//! assert codegen.is_scalar("Int")
//! assert codegen.is_scalar("Maybe<String>")
//! refute codegen.is_scalar("User")
//
pub fn is_scalar(text: String) -> Bool {
    inner = if String.starts_with(text, "Maybe<") {
        text |> sqltext.cut_prefix("Maybe<") |> sqltext.cut_suffix(">")
    } else {
        text
    }

    Iter.contains(
        [
            "Int",
            "Float",
            "Decimal",
            "String",
            "Bool",
            "Bytes",
            "Date",
            "Time",
            "NaiveDateTime",
            "Instant",
            "Uuid",
            "Json",
        ],
        String.trim(inner),
    )
}

/// s as a Nomi string literal.
pub fn quote(s: String) -> String {
    escaped =
        s
        |> String.replace("\\", "\\\\")
        |> String.replace("\"", "\\\"")
        |> String.replace("\${", "\\\${")
        |> String.replace("\n", "\\n")
        |> String.replace("\t", "\\t")
        |> String.replace("\r", "\\r")

    "\"${escaped}\""
}

// --- names -----------------------------------------------------------
/// The enum a `CHECK (column IN (...))` column reads as: its table's row
/// struct and the column, so `orders.status` is `OrderStatus`.
//! assert codegen.enum_name("Order", "status") == "OrderStatus"
//! assert codegen.enum_name("OrderItem", "kind") == "OrderItemKind"
//
pub fn enum_name(row: String, column: String) -> String {
    row + String.pascal_case(column)
}

/// A table's name in the singular, by a plain English rule: `ies` is `y`,
/// `ses` is `s`, a name ending in `ss` stays, and an `s` at the end goes.
/// A name the rule gets wrong takes its row's name from nomi.toml.
//! assert codegen.singular("users") == "user"
//! assert codegen.singular("order_items") == "order_item"
//! assert codegen.singular("categories") == "category"
//! assert codegen.singular("addresses") == "address"
//! assert codegen.singular("statuses") == "status"
//! assert codegen.singular("glass") == "glass"
//! assert codegen.singular("people") == "people"
//
pub fn singular(name: String) -> String {
    if String.ends_with(name, "ies") {
        sqltext.cut_suffix(name, "ies") + "y"
    } else if String.ends_with(name, "ses") {
        sqltext.cut_suffix(name, "es")
    } else if String.ends_with(name, "ss") or !String.ends_with(name, "s") {
        name
    } else {
        sqltext.cut_suffix(name, "s")
    }
}

fn singular_pascal(table: String) -> String {
    String.pascal_case(singular(table))
}

/// The row struct of `table` in db: the name nomi.toml's `tables` gives it,
/// or the table's name in the singular.
//! db = databases.defaults("main")
//! assert codegen.row_name(db, "users") == "User"
//! assert codegen.row_name(#{..db, tables: %{"people" => "Person"}}, "people") == "Person"
//
pub fn row_name(db: Database, table: String) -> String {
    Map.get(db.tables, table) |> Maybe.with_default(singular_pascal(table))
}

/// Whether text is a type's name: a capital letter, then letters, digits
/// and `_`.
fn is_type_name(text: String) -> Bool {
    first = String.slice(text, 0, 1)

    String.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", first)
        and first != ""
        and Iter.all(text, fn c -> {
            String.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c)
        })
}

/// Whether each value makes a distinct variant name.
fn has_valid_enum_values(values: List<String>) -> Bool {
    names = values |> Iter.map(String.pascal_case) |> Iter.to_list()

    Iter.count(Iter.to_set(names)) == Iter.count(names)
        and Iter.all(names, fn n -> {
            n != "" and !String.contains("0123456789", String.slice(n, 0, 1))
        })
}
