//# The Nomi source `nomi tool sqlkit generate` writes: a database's schema
//# file (a row struct per table, an enum per `CHECK (column IN (...))`
//# column, and the migrations as data), one file of functions per query
//# file, and a test that the generated files are current. The generated
//# code states each fact about a query as code that checks only when the
//# fact holds: a column of the `INTEGER` family is read by a function
//# bounded by `SqlInt`, and a nullable one returns a `Maybe`.

import
    databases.{self, Database}
    described.{self, Column, QueryError, Table, TableColumn}
    queryfile.{self, File, Problem, Query}
    sqltext.{self, Override, Token}
    types
end

/// The result a query declares.
enum Shape
    /// `-> T`: exactly one row.
    One

    /// `-> Maybe<T>`.
    Optional

    /// `-> List<T>`, and a query with no result type, whose rows are
    /// anonymous structs.
    Many

    /// `-> Rows<T>`.
    Stream

    /// `-> Changed` on SQL that returns no rows: the number of rows it
    /// changed.
    Changed

    /// `-> Unit` on SQL that returns no rows: the count is ignored.
    Ignored
end

derive Equatable for Shape

/// One column as the generated code reads it.
struct Field
    name:     String
    position: Int
    reader:   String

    // What the reader takes after the row and position: the scale of a
    // DECIMAL(p, s) column, `, 2`.
    args:      String
    type_text: Maybe<String>
    nullable:  Bool
end

/// A database's schema as the generated code names it: the database, its
/// tables, each table's row struct by table, and the file that declares
/// them.
pub struct Schema
    db:     Database
    tables: List<Table>
    rows:   Map<String, String>
    module: String
end

fn problem_at(query: Query, line: Int, col: Int, message: String, hints: List<String>) -> Problem
    Problem{file: query.file, line:, col:, message:, hints:}
end

fn at_token(query: Query, token: Token, message: String, hints: List<String>) -> Problem
    (line, col) = queryfile.place(query, token.start)
    problem_at(query, line, col, message, hints)
end

fn at_annotation(query: Query, col: Int, message: String, hints: List<String>) -> Problem
    problem_at(query, query.line, col, message, hints)
end

// --- the files -------------------------------------------------------
/// The comment a generated file starts with: what it was generated from,
/// and the digest of the inputs, which its test checks.
//! assert codegen.header(
//!     "db/migrations",
//!     "ab12",
//! ) == "// Generated by `nomi tool sqlkit generate` from db/migrations. Do not edit:\n// change the SQL and generate again.\n// inputs sha256: ab12\n"
//
pub fn header(sources: String, digest: String) -> String
    text = "Generated by `nomi tool sqlkit generate` from ${sources}. Do not edit: change the SQL and generate again."
    "${wrap(text)}// inputs sha256: ${digest}\n"
end

// text as `//` comment lines of at most 76 characters of text each.
fn wrap(text: String) -> String
    (lines, last) = Iter.reduce(String.split(text, " "), ([], ""), fn acc, word ->
        (lines, line) = acc

        if line == "" then
            (lines, word)
        else if String.length(line) + 1 + String.length(word) > 76 then
            ([line, ..lines], word)
        else
            (lines, "${line} ${word}")
        end
    end)

    [last, ..lines] |> Iter.reverse() |> Iter.map(fn line -> "// ${line}\n") |> String.join()
end

/// The digest a generated file's header records, if it is one.
//! text = codegen.header("x", "ab12") + "import sqlkit\n"
//! assert codegen.recorded(text) == Some("ab12")
//! assert codegen.recorded("import sqlkit\n") == None
//
pub fn recorded(text: String) -> Maybe<String>
    if not String.starts_with(text, "// Generated by `nomi tool sqlkit generate`") then return None

    String.split(text, "\n")
    |> Iter.take(4)
    |> Iter.flat_map(fn line -> String.strip_prefix(line, "// inputs sha256: ") |> sqltext.listed())
    |> Iter.first()
end

fn migrations_source(db: Database) -> String
    db.migrations
end

/// The import block of a file.
//! imports = {"sqlkit" => Set["self"], "std::sql" => Set["self"], "schema" => Set["User", "Order"]}
//!
//! assert codegen.import_block(imports)
//!     == "import\n    std::sql\n    schema.{Order, User}\n    sqlkit\nend\n"
//!
//! assert codegen.import_block({"sqlkit::inputs" => Set["self"]}) == "import sqlkit::inputs\n"
//
/// The imports a generated file needs are each module path with the
/// names it imports from it, `self` for the module itself.
pub fn import_block(imports: Map<String, Set<String>>) -> String
    map = imports

    entries =
        map
        |> Map.keys()
        |> Iter.sort_by(fn path ->
            if String.starts_with(path, "std::") or path == "std" then
                "0${path}"
            else
                "1${path}"
            end
        end)
        |> Iter.map(fn path ->
            names = Map.get(map, path) |> Maybe.with_default(Set[])
            others = names |> Iter.filter(fn n -> n != "self") |> Iter.sort()

            listed = if Iter.contains(names, "self") then ["self", ..others] else others

            case listed
                ["self"] -> path
                [one]    -> "${path}.${one}"
                many     -> "${path}.{${String.join(many, ", ")}}"
            end
        end)
        |> Iter.to_list()

    case entries
        [one] -> "import ${one}\n"
        _     -> "import\n${entries |> Iter.map(fn e -> "    ${e}\n") |> String.join()}end\n"
    end
end

fn imports_of(entries: List<(String, String)>) -> Map<String, Set<String>>
    Iter.reduce(entries, {}, fn acc: Map<String, Set<String>>, (path, name) ->
        names = Map.get(acc, path) |> Maybe.with_default(Set[])
        Map.put(acc, path, Set.insert(names, name))
    end)
end

/// The module path and the names an import entry as written imports:
/// `shop.Report`, `std::calendar.{Date, Time}`, `shop` (the module).
//! assert codegen.entry("shop.Report") == ("shop", ["Report"])
//! assert codegen.entry("std::calendar.{Date, Time}") == ("std::calendar", ["Date", "Time"])
//! assert codegen.entry("shop") == ("shop", ["self"])
//
pub fn entry(text: String) -> (String, List<String>)
    segments = String.split(text, "::") |> Iter.to_list()
    last = Iter.last(segments) |> Maybe.with_default("")

    dir =
        segments
        |> Iter.take(Iter.count(segments) - 1)
        |> Iter.map(fn s -> s + "::")
        |> String.join()

    case String.split(last, ".") |> Iter.to_list()
        [module] ->
            (dir + module, ["self"])

        [module, ..rest] ->
            items = String.join(rest, ".") |> sqltext.cut_prefix("{") |> sqltext.cut_suffix("}")

            names =
                String.split(items, ",")
                |> Iter.map(String.trim)
                |> Iter.filter(fn n -> n != "")
                |> Iter.to_list()

            (dir + module, names)

        [] ->
            (text, ["self"])
    end
end

// --- the schema file -------------------------------------------------
/// The schema of db's tables: each table's row struct, or what is wrong
/// with the names `[sqlkit.database.<name>.tables]` gives.
pub fn schema(db: Database, tables: List<Table>, module: String) -> Result<Schema, List<Problem>>
    names = tables |> Iter.map(fn t -> (t.name, row_name(db, t.name))) |> Iter.to_list()
    section = "[sqlkit.database.${db.name}.tables]"

    toml = fn message: String, hints: List<String> ->
        Problem{file: "nomi.toml", line: 0, col: 0, message:, hints:}
    end

    misnamed =
        db.tables
        |> Map.keys()
        |> Iter.sort()
        |> Iter.flat_map(fn table ->
            given = Map.get(db.tables, table) |> Maybe.with_default("")

            if is_type_name(given) then
                []
            else
                [
                    toml(
                        "`${section}` names the row of `${table}` `${given}`, which is not a type's name",
                        [
                            "a type's name starts with a capital letter, then letters, digits and `_`: `${String.pascal_case(
                                given
                            )}`",
                        ],
                    ),
                ]
            end
        end)
        |> Iter.to_list()

    known = tables |> Iter.map(fn t -> t.name) |> Iter.to_list()

    unknown =
        db.tables
        |> Map.keys()
        |> Iter.sort()
        |> Iter.reject(&Iter.contains(known, &1))
        |> Iter.map(fn table ->
            toml(
                "`${section}` names the table `${table}`, which the migrations do not create",
                ["its tables are ${known |> Iter.map(fn t -> "`${t}`") |> String.join(", ")}"],
            )
        end)
        |> Iter.to_list()

    clashes =
        names
        |> Iter.with_index()
        |> Iter.flat_map(fn (i, (table, row)) ->
            earlier = names |> Iter.take(i) |> Iter.find(fn (_, r) -> r == row)

            case earlier
                Some((other, _)) ->
                    [
                        toml(
                            "the tables `${other}` and `${table}` both have the row struct `${row}`",
                            ["name one in nomi.toml: `${section}`, `${table} = \"...\"`"],
                        ),
                    ]

                None ->
                    []
            end
        end)
        |> Iter.to_list()

    problems = misnamed + unknown + clashes

    if Iter.is_empty(problems) then
        Ok(Schema{db:, tables:, rows: Iter.to_map(names), module:})
    else
        Err(problems)
    end
end

/// The names of the types the schema file declares: the row structs and
/// the enums.
pub fn schema_types(s: Schema) -> List<String>
    s.tables
    |> Iter.flat_map(fn t ->
        row = row_of(s, t.name)

        enums =
            t.columns
            |> Iter.filter(fn c -> is_enum_column(c))
            |> Iter.map(fn c -> enum_name(row, c.name))

        Iter.concat([row], enums)
    end)
    |> Iter.to_list()
end

fn row_of(s: Schema, table: String) -> String
    Map.get(s.rows, table) |> Maybe.with_default(singular_pascal(table))
end

fn is_enum_column(c: TableColumn) -> Bool
    not Iter.is_empty(c.values) and has_valid_enum_values(c.values)
end

/// The schema file: the row structs, the enums and the migrations.
pub fn schema_file(s: Schema, migrations: List<(String, String)>, digest: String) -> String
    columns = s.tables |> Iter.flat_map(fn t -> t.columns) |> Iter.to_list()
    any_enum = Iter.any_match(columns, is_enum_column)

    plain =
        columns
        |> Iter.reject(is_enum_column)
        |> Iter.map(fn c -> types.of(c.type_name))
        |> Iter.to_list()

    family_imports =
        plain
        |> Iter.flat_map(fn f ->
            // The names a family's type mentions that its module declares:
            // `Uuid` of `List<Uuid>`.
            case f |> Maybe.flat_map(fn x -> x.module |> Maybe.map(fn m -> (m, x.nomi)))
                Some((m, nomi)) ->
                    type_names(nomi)
                    |> Iter.reject(&Iter.contains(prelude, &1))
                    |> Iter.map(fn n -> (m, n))
                    |> Iter.to_list()

                None ->
                    []
            end
        end)
        |> Iter.to_list()

    sql_value = Iter.any_match(plain, fn f -> f == None)

    base = if any_enum then
        [("sqlkit", "self"), ("sqlkit::runtime", "self"), ("std::sql", "self")]
    else if sql_value then
        [("sqlkit", "self"), ("std::sql", "self")]
    else
        [("sqlkit", "self")]
    end

    structs = s.tables |> Iter.map(fn t -> table_source(s, t)) |> String.join()

    enums =
        s.tables
        |> Iter.flat_map(fn t ->
            t.columns
            |> Iter.filter(is_enum_column)
            |> Iter.map(fn c -> enum_source(row_of(s, t.name), t, c))
        end)
        |> String.join()

    list = migrations |> Iter.map(fn (path, text) -> migration_source(path, text)) |> String.join()

    header(migrations_source(s.db), digest) + import_block(
        imports_of(base + family_imports)
    ) + structs + enums + "\n/// The migrations of the database `${s.db.name}`, in the order they apply.\npub once migrations: List<sqlkit.Migration> = [\n${list}]\n"
end

fn migration_source(path: String, text: String) -> String
    "    sqlkit.Migration{\n        path: ${quote(path)},\n        sql: ${sql_literal(text, "            ")},\n    },\n"
end

fn table_source(s: Schema, table: Table) -> String
    row = row_of(s, table.name)

    fields =
        table.columns
        |> Iter.map(fn c ->
            base = if is_enum_column(c) then
                enum_name(row, c.name)
            else
                types.of(c.type_name)
                |> Maybe.map(fn f -> f.nomi)
                |> Maybe.with_default("sql.Value")
            end

            ty = if c.nullable then "Maybe<${base}>" else base
            "    ${c.name}: ${ty}\n"
        end)
        |> String.join()

    "\n/// A row of the table `${table.name}`.\npub struct ${row}\n${fields}end\n"
end

fn enum_source(row: String, table: Table, column: TableColumn) -> String
    name = enum_name(row, column.name)
    variants = column.values |> Iter.map(fn v -> "    ${String.pascal_case(v)}\n") |> String.join()

    to_text =
        column.values
        |> Iter.map(fn v -> "            .${String.pascal_case(v)} -> ${quote(v)}\n")
        |> String.join()

    from_text =
        column.values
        |> Iter.map(fn v ->
            "            Some(${quote(v)}) -> Ok(${name}.${String.pascal_case(v)})\n"
        end)
        |> String.join()

    "\n/// The values `CHECK (${column.name} IN (...))` allows in `${table.name}.${column.name}`.\npub enum ${name}\n${variants}end\n\nderive Equatable for ${name}\n" + "\nimpl Display for ${name}\n    fn to_string(value: ${name}) -> String\n        case value\n${to_text}        end\n    end\nend\n" + "\nimpl sql.ToSql for ${name}\n    fn to_sql(value: ${name}) -> sql.Value\n        sql.Value.Text(Display.to_string(value))\n    end\nend\n" + "\nimpl sql.FromSql for ${name}\n    fn from_sql(value: sql.Value) -> Result<${name}, String>\n        case runtime.text_of(value)\n${from_text}            _ -> Err(${quote(
        name
    )})\n        end\n    end\nend\n" + "\nimpl sqlkit.SqlText for ${name} end\n"
end

/// The test file: that the inputs are still the ones the files were
/// generated from.
pub fn test_file(db: Database, digest: String) -> String
    header(
        "${migrations_source(db)} and ${db.queries}",
        digest,
    ) + "import sqlkit::inputs\n\n" + "// Fails when a migration or a query changed after the last\n" + "// `nomi tool sqlkit generate`: run it again. The paths are under the\n" + "// module root, where `nomi test` resolves a test's relative paths.\n" + "test \"generated sql is current\"\n" + "    assert inputs.current(${quote(
        db.migrations
    )}, ${quote(db.queries)})\n" + "        == Ok(${quote(digest)})\n" + "end\n"
end

// --- the queries files -----------------------------------------------
/// The file of functions a query file generates, or what is wrong with its
/// queries. `described` is each query's description, in order.
pub fn queries_file(
    s:         Schema,
    file:      File,
    described: List<Result<List<Column>, QueryError>>,
    digest:    String,
) -> Result<String, List<Problem>>
    explicit =
        file.imports
        |> Iter.flat_map(fn e ->
            (path, names) = entry(e)
            names |> Iter.map(fn n -> (path, n))
        end)
        |> Iter.to_list()

    imported =
        explicit
        |> Iter.filter(fn (_, n) -> n != "self")
        |> Iter.map(fn (path, n) -> (used_as(n), (path, n)))
        |> Iter.to_map()

    modules =
        explicit
        |> Iter.filter(fn (_, n) -> n == "self")
        |> Iter.map(fn (path, _) -> (last_segment(path), path))
        |> Iter.to_map()

    resolver = Resolver{
        imported:,
        modules:,
        schema:        schema_types(s),
        rows:          s.rows,
        schema_module: s.module,
        qualifier:     last_segment(s.module),
        file:          file.path,
    }

    results =
        Iter.zip(file.queries, described)
        |> Iter.map(fn (q, d) -> function(s, resolver, q, d))
        |> Iter.to_list()

    problems =
        results
        |> Iter.flat_map(fn r ->
            case r
                Err(ps) -> ps
                Ok(_)   -> []
            end
        end)
        |> Iter.to_list()

    if not Iter.is_empty(problems) then return Err(problems)

    made =
        results
        |> Iter.flat_map(fn r ->
            case r
                Ok(m)  -> [m]
                Err(_) -> []
            end
        end)
        |> Iter.to_list()

    // An `-- import:` no signature uses is left out, since an unused
    // import is an error.
    needs = made |> Iter.flat_map(fn m -> m.imports) |> Iter.to_list()
    base = [("std::sql", "self"), ("sqlkit::runtime", "self")]
    imports = imports_of(base + needs)
    functions = made |> Iter.map(fn m -> "\n" + m.text) |> String.join()

    Ok(
        header("${file.path} and ${migrations_source(s.db)}", digest) + import_block(
            imports
        ) + functions
    )
end

/// What a type name in a query's signature resolves to: a name the file
/// imports itself, a type of the schema, or one of std's, in that order.
/// A type of the schema that an import shadows is written qualified by
/// the schema's module, `schema.Post`.
struct Resolver
    // Each type the file imports, by the name it is used as, with the
    // module path and the name as the import entry writes it: `Post` from
    // `-- import: models.{Post}` is `("models", "Post")`.
    imported: Map<String, (String, String)>

    // Each module the file imports itself, by its last segment.
    modules: Map<String, String>
    schema:  List<String>

    // Each table's row struct, by table.
    rows:          Map<String, String>
    schema_module: String

    // The name the schema module is used as: its path's last segment.
    qualifier: String

    // The query file, as its problems name it.
    file: String
end

/// The name an import entry's name is used as: `Post as Model` is used as
/// `Model`.
fn used_as(name: String) -> String
    String.split(name, " as ") |> Iter.last() |> Maybe.with_default(name) |> String.trim()
end

/// The last segment of a module path, the name the module is used as:
/// `db::schema` is used as `schema`.
//! assert codegen.last_segment("db::schema") == "schema"
//! assert codegen.last_segment("schema") == "schema"
//
pub fn last_segment(path: String) -> String
    String.split(path, "::") |> Iter.last() |> Maybe.with_default(path)
end

/// A generated function and the imports it needs.
struct Made
    text:    String
    imports: List<(String, String)>
end

// The names the prelude gives every file.
once prelude: List<String> = [
    "Bool",
    "Byte",
    "Bytes",
    "Codepoint",
    "Decimal",
    "Float",
    "Int",
    "List",
    "Map",
    "Maybe",
    "Ordering",
    "Result",
    "Set",
    "String",
    "Unit",
    "Vector",
]

// std's types a query may name, and the module each is in.
once std_types: Map<String, String> = {
    "Date"          => "std::calendar",
    "Duration"      => "std::duration",
    "Instant"       => "std::instant",
    "Json"          => "std::json",
    "NaiveDateTime" => "std::calendar",
    "Time"          => "std::calendar",
    "Uuid"          => "std::uuid",
}

/// The type names a type as written names, outside a qualified name:
/// `Maybe<User>` names `Maybe` and `User`, `sql.Value` none.
//! assert codegen.type_names("Map<String, List<User>>") == ["Map", "String", "List", "User"]
//! assert codegen.type_names("sql.Value") == []
//
pub fn type_names(text: String) -> List<String>
    solid =
        sqltext.tokens(text)
        |> Iter.filter(fn t -> t.kind != sqltext.Kind.Space)
        |> Iter.to_vector()

    solid
    |> Iter.with_index()
    |> Iter.flat_map(fn (i, t) ->
        before = if i == 0 then
            ""
        else
            Vector.get(solid, i - 1) |> Maybe.map(fn b -> b.text) |> Maybe.with_default("")
        end

        first = String.slice(t.text, 0, 1)
        upper = first != "" and first in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

        if t.kind == sqltext.Kind.Word and upper and before != "." then [t.text] else []
    end)
    |> Iter.to_list()
end

/// The qualified type names a type as written names, each as its module's
/// name and the type's: `Maybe<schema.Post>` names `("schema", "Post")`.
//! assert codegen.qualified_names("Map<sql.Value, List<schema.Post>>") == [
//!     ("sql",    "Value"),
//!     ("schema", "Post"),
//! ]
//!
//! assert codegen.qualified_names("Post") == []
//
pub fn qualified_names(text: String) -> List<(String, String)>
    solid =
        sqltext.tokens(text)
        |> Iter.filter(fn t -> t.kind != sqltext.Kind.Space)
        |> Iter.to_vector()

    solid
    |> Iter.with_index()
    |> Iter.flat_map(fn (i, t) ->
        module = text_at(solid, i - 2)

        if text_at(solid, i - 1) == "."
            and t.kind == sqltext.Kind.Word
            and sqltext.is_name(module) then
            [(module, t.text)]
        else
            []
        end
    end)
    |> Iter.to_list()
end

// The text of the token at `i`, or "" when there is none.
fn text_at(tokens: Vector<Token>, i: Int) -> String
    if i < 0 then return ""

    Vector.get(tokens, i) |> Maybe.map(fn t -> t.text) |> Maybe.with_default("")
end

// The imports the types in `text` need, or what is wrong with the first
// type nothing gives, as a message and its hints. A name the file imports
// is the imported type, before a type of the schema of that name.
fn resolve(r: Resolver, text: String) -> Result<List<(String, String)>, (String, List<String>)>
    bare =
        type_names(text)
        |> Iter.reject(&Iter.contains(prelude, &1))
        |> Iter.map(fn n ->
            case Map.get(r.imported, n)
                Some(entry) ->
                    Ok(entry)

                None ->
                    if Iter.contains(r.schema, n) then
                        Ok((r.schema_module, n))
                    else
                        case Map.get(std_types, n)
                            Some(m) ->
                                Ok((m, n))

                            None ->
                                Err(
                                    (
                                        "`${n}` is not a type of the schema, the prelude or std",
                                        [
                                            "import it at the top of the file: `-- import: path::to::file.${n}`",
                                        ],
                                    )
                                )
                        end
                    end
            end
        end)

    qualified = qualified_names(text) |> Iter.map(fn (m, n) -> qualified_import(r, m, n))
    bare |> Iter.concat(qualified) |> Result.collect()
end

// The import a qualified type name needs: `schema.Post` the schema's
// module, `shop.Report` a module the file imports, `sql.Value` std/sql.
fn qualified_import(
    r:      Resolver,
    module: String,
    name:   String,
) -> Result<(String, String), (String, List<String>)>
    if module == r.qualifier then
        if Iter.contains(r.schema, name) then return Ok((r.schema_module, "self"))

        return Err(
            (
                "`${module}.${name}` is not a type of the schema",
                [
                    "the schema's types are each table's row struct and each `CHECK (column IN (...))` enum: ${r.schema
                    |> Iter.map(fn t -> "`${module}.${t}`")
                    |> String.join(", ")}",
                ],
            )
        )
    end

    case (Map.get(r.modules, module), module)
        (Some(path), _) ->
            Ok((path, "self"))

        (None, "sql") ->
            Ok(("std::sql", "self"))

        (None, "sqlkit") ->
            Ok(("sqlkit", "self"))

        _ ->
            hint = if Iter.contains(r.schema, name) then
                "the schema's `${name}` is `${r.qualifier}.${name}`"
            else
                "import it at the top of the file: `-- import: path::to::${module}`"
            end

            Err(("`${module}` in `${module}.${name}` is not a module the file imports", [hint]))
    end
end

/// `text`, a type sqlkit writes for a column, with each type of the schema
/// or std that an import of the file shadows qualified by its module, and
/// the imports it needs: with `Instant` imported from elsewhere, std's is
/// `instant.Instant`.
fn generated(r: Resolver, text: String) -> (String, List<(String, String)>)
    solid = sqltext.tokens(text) |> Iter.to_vector()

    (parts, imports) = Iter.reduce(Iter.with_index(solid), ([], []), fn acc, (i, t) ->
        (parts, imports) = acc

        module = if Iter.contains(r.schema, t.text) then
            Some(r.schema_module)
        else
            Map.get(std_types, t.text)
        end

        case module
            Some(m) when t.kind == sqltext.Kind.Word and text_at(solid, i - 1) != "." ->
                if Maybe.is_none(Map.get(r.imported, t.text)) then
                    ([t.text, ..parts], [(m, t.text), ..imports])
                else
                    (["${last_segment(m)}.${t.text}", ..parts], [(m, "self"), ..imports])
                end

            _ ->
                ([t.text, ..parts], imports)
        end
    end)

    (parts |> Iter.reverse() |> String.join(), imports)
end

fn unresolved(q: Query, col: Int, found: (String, List<String>)) -> Problem
    at_annotation(q, col, found.first, found.second)
end

// The function a query generates, or what is wrong with it.
fn function(
    s: Schema,
    r: Resolver,
    q: Query,
    d: Result<List<Column>, QueryError>,
) -> Result<Made, List<Problem>>
    tokens = sqltext.tokens(q.sql)
    markers = sqltext.markers(tokens)
    marker_problems = check_markers(q, markers, sqltext.interpolations(tokens))

    (shape, row) = case shape_of(r, q)
        Ok(found) -> found
        Err(p)    -> return Err([p, ..marker_problems])
    end

    signature_imports =
        q.params
        |> Iter.map(fn p ->
            resolve(r, p.type_text) |> Result.map_err(fn found -> unresolved(q, p.col, found))
        end)
        |> Iter.concat([
            row
            |> Maybe.map(fn t -> resolve(r, t))
            |> Maybe.with_default(Ok([]))
            |> Result.map_err(fn found -> unresolved(q, q.result_col, found)),
        ])
        |> Iter.to_list()

    type_problems =
        signature_imports
        |> Iter.flat_map(fn x ->
            case x
                Err(p) -> [p]
                Ok(_)  -> []
            end
        end)
        |> Iter.to_list()

    if not Iter.is_empty(marker_problems + type_problems) then
        return Err(marker_problems + type_problems)
    end

    columns = case d
        Ok(cs) ->
            cs

        Err(e) ->
            reported = "reported by ${s.db.dialect} for `${q.name}`"

            p = case sqltext.token_at_offset(tokens, e.offset)
                Some(t) -> at_token(q, t, e.message, [reported])
                None    -> at_annotation(q, 1, e.message, [reported])
            end

            return Err([p])
    end

    // A value type or one of the schema's enums reads the query's one
    // column as itself; any other row type is a struct with a field per
    // column.
    scalar = case row
        Some(t) -> is_scalar(t) or is_schema_enum(r, t)
        None    -> False
    end

    final_shape = case described_shape(q, shape, row, scalar, columns)
        Ok(found) -> found
        Err(p)    -> return Err([p])
    end

    (fields, field_imports, problems) = fields_of(s, r, q, tokens, columns, row == None)

    if not Iter.is_empty(problems) then return Err(problems)

    case (row, fields)
        (Some(t), [only]) when scalar ->
            case nullability_problem(q, final_shape, t, only)
                Some(p) -> return Err([p])
                None    -> Unit
            end

        _ ->
            Unit
    end

    shape_imports = if final_shape is (.Stream or .Changed) then [("sqlkit", "self")] else []

    found_imports =
        signature_imports
        |> Iter.flat_map(fn x ->
            case x
                Ok(imports) -> imports
                Err(_)      -> []
            end
        end)
        |> Iter.to_list()

    text = function_source(
        q,
        final_shape,
        row,
        shadowing(r, row),
        sqltext.parts(tokens),
        markers,
        fields,
        scalar,
    )

    Ok(Made{text:, imports: found_imports + field_imports + shape_imports})
end

/// The comment a function whose row type is an imported type that shadows
/// a table's row struct carries above the row it builds, for whoever reads
/// a type error there: the import wins, and the table's row is qualified.
fn shadowing(r: Resolver, row: Maybe<String>) -> String
    case row
        Some(name) ->
            case (
                Map.get(r.imported, name),
                Map.keys(r.rows)
                |> Iter.sort()
                |> Iter.find(fn t -> Map.get(r.rows, t) == Some(name)),
            )
                (Some((path, entry_name)), Some(table)) ->
                    imported =
                        String.split(entry_name, " as ")
                        |> Iter.first()
                        |> Maybe.with_default(entry_name)
                        |> String.trim()

                    text = "`${name}` is ${last_segment(path)}.${imported}, which ${r.file} imports. The row of the table `${table}` is `${r.qualifier}.${name}`."

                    wrap(text)
                    |> String.split("\n")
                    |> Iter.filter(fn l -> l != "")
                    |> Iter.map(fn l -> "    ${l}\n")
                    |> String.join()

                _ ->
                    ""
            end

        None ->
            ""
    end
end

/// Every `@name` names a parameter, every parameter is used, and no
/// `${...}` is left in the SQL.
fn check_markers(q: Query, markers: List<Token>, interpolations: List<Token>) -> List<Problem>
    names = q.params |> Iter.map(fn p -> p.name) |> Iter.to_list()

    // A `${name}` the author meant as a parameter counts as using it, so
    // its own error is the only one.
    meant = interpolations |> Iter.map(fn t -> interpolated_name(t.text)) |> Iter.to_list()
    used = markers |> Iter.map(fn m -> sqltext.marker_name(m.text)) |> Iter.to_list()

    left =
        interpolations
        |> Iter.map(fn t ->
            name = interpolated_name(t.text)

            suggestion = if sqltext.is_name(name) then
                "write `@${name}`: a query binds a parameter with `@name`"
            else
                "a query binds a parameter with `@name`"
            end

            at_token(q, t, "a query's SQL has no `${"$"}{...}`", [suggestion])
        end)

    unknown =
        markers
        |> Iter.reject(fn m -> Iter.contains(names, sqltext.marker_name(m.text)))
        |> Iter.map(fn m ->
            name = sqltext.marker_name(m.text)

            hint = if Iter.is_empty(names) then
                "`${q.name}` takes no parameters; declare one: `-- query: ${q.name}(${name}: String)`"
            else
                "its parameters are ${names |> Iter.map(fn n -> "`${n}`") |> String.join(", ")}"
            end

            at_token(q, m, "`${name}` is not a parameter of `${q.name}`", [hint])
        end)

    unused =
        q.params
        |> Iter.filter(fn p -> not Iter.contains(used, p.name) and not Iter.contains(meant, p.name))
        |> Iter.map(fn p ->
            at_annotation(
                q,
                p.col,
                "the parameter `${p.name}` is not used in the SQL of `${q.name}`",
                ["write `@${p.name}` where it is bound, or remove it"],
            )
        end)

    left |> Iter.concat(unknown) |> Iter.concat(unused) |> Iter.to_list()
end

/// The name inside a `${...}`, trimmed.
fn interpolated_name(text: String) -> String
    text
    |> sqltext.cut_prefix("\${")
    |> sqltext.cut_suffix("}")
    |> String.trim()
end

/// The shape the declared result type names, and its row type.
fn shape_of(r: Resolver, q: Query) -> Result<(Shape, Maybe<String>), Problem>
    case q.result
        None ->
            Ok((Shape.Many, None))

        Some(text) ->
            if text == "Unit" then return Ok((Shape.Ignored, None))

            if text == "Changed" or text == "sqlkit.Changed" then return Ok((Shape.Changed, None))

            (shape, inner, wrapper) = if is_wrapped(text, "Maybe") then
                (Shape.Optional, unwrap(text, "Maybe"), "Maybe")
            else if is_wrapped(text, "List") then
                (Shape.Many, unwrap(text, "List"), "List")
            else if is_wrapped(text, "Rows") then
                (Shape.Stream, unwrap(text, "Rows"), "Rows")
            else if Iter.contains(["Maybe", "List", "Rows"], text) then
                (Shape.One, "", text)
            else
                (Shape.One, text, "")
            end

            if inner == "" then
                return Err(
                    at_annotation(
                        q,
                        q.result_col,
                        "`-> ${wrapper}` names no row type: write `-> ${wrapper}<MyRow>`",
                        [
                            "or leave the result type out to read the rows as a `List` of anonymous structs",
                        ],
                    )
                )
            end

            if not is_scalar(inner)
                and not is_schema_enum(r, inner)
                and not is_row_name(inner)
                and not is_qualified_row_name(inner) then
                result_hint = if String.starts_with(text, "Result") then
                    [
                        "the generated function already answers a `Result<T, sql.Error>`: write `-> T`",
                    ]
                else
                    []
                end

                return Err(
                    at_annotation(
                        q,
                        q.result_col,
                        "`${inner}` is not a row type: a row type names a struct, or for a query of one column one of std's value types or one of the schema's enums",
                        result_hint + [result_forms],
                    )
                )
            end

            Ok((shape, Some(inner)))
    end
end

/// A scalar row type that disagrees with whether its one column may be
/// NULL: the column is read as a `Maybe` exactly when it may be NULL, so
/// the row type must be a `Maybe` exactly then.
fn nullability_problem(q: Query, shape: Shape, row: String, field: Field) -> Maybe<Problem>
    maybe = String.starts_with(row, "Maybe<") and String.ends_with(row, ">")

    wrapped = fn inner: String ->
        case shape
            .Many   -> "List<${inner}>"
            .Stream -> "Rows<${inner}>"
            _       -> "Maybe<${inner}>"
        end
    end

    if field.nullable and not maybe then
        Some(
            at_annotation(
                q,
                q.result_col,
                "the column `${field.name}` of `${q.name}` may be NULL, so its row type cannot be `${row}`",
                [
                    "write `-> ${wrapped("Maybe<${row}>")}` to read the NULL as `None`",
                    "or assert it is never NULL with `AS \"${field.name}!\"`, or make the column `NOT NULL`",
                ],
            )
        )
    else if not field.nullable and maybe then
        Some(
            at_annotation(
                q,
                q.result_col,
                "the column `${field.name}` of `${q.name}` is never NULL, so its row type cannot be `${row}`",
                [
                    "write `-> ${wrapped(
                        row
                        |> sqltext.cut_prefix("Maybe<")
                        |> sqltext.cut_suffix(">")
                        |> String.trim()
                    )}`",
                    "or say it may be NULL with `AS \"${field.name}?\"`",
                ],
            )
        )
    else
        None
    end
end

// The results a query may declare.
once result_forms: String = "a query's result is `-> T`, `-> Maybe<T>`, `-> List<T>` or `-> Rows<T>`; `-> Changed` or `-> Unit` on SQL that returns no rows; or nothing, for a `List` of anonymous structs"

/// Whether a row type is a struct's name: one capitalized name that is
/// not one of the prelude's other types.
//! assert codegen.is_row_name("User")
//! refute codegen.is_row_name("List")
//! refute codegen.is_row_name("Result<User, String>")
//! refute codegen.is_row_name("user")
//! refute codegen.is_row_name("shop.User")
//
pub fn is_row_name(text: String) -> Bool
    first = String.slice(text, 0, 1)

    first != ""
        and first in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        and Iter.all_match(text, fn c ->
            c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        end)
        and not Iter.contains(prelude, text)
end

/// Whether a row type is a struct's name qualified by its module's:
/// `schema.Post`.
//! assert codegen.is_qualified_row_name("schema.Post")
//! refute codegen.is_qualified_row_name("schema.post")
//! refute codegen.is_qualified_row_name("Schema.Post")
//! refute codegen.is_qualified_row_name("a.b.Post")
//
pub fn is_qualified_row_name(text: String) -> Bool
    case String.split(text, ".") |> Iter.to_list()
        [module, name] -> sqltext.is_name(module) and is_row_name(name)
        _              -> False
    end
end

fn is_wrapped(text: String, name: String) -> Bool
    String.starts_with(text, name + "<") and String.ends_with(text, ">")
end

fn unwrap(text: String, name: String) -> String
    text |> sqltext.cut_prefix(name + "<") |> sqltext.cut_suffix(">") |> String.trim()
end

/// The shape a query takes once SQLite gives its columns, or what is wrong
/// with its result type. SQL that returns no rows returns the number of
/// rows it changed (`-> Changed`) or nothing (`-> Unit`), and only SQL
/// that returns rows can leave its result type out or name a row type.
fn described_shape(
    q:       Query,
    shape:   Shape,
    row:     Maybe<String>,
    scalar:  Bool,
    columns: List<Column>,
) -> Result<Shape, Problem>
    count_hint = "write `-> Changed` for the count, or `-> Unit` to ignore it"
    rows_hint = "name their type, `-> List<MyRow>`, or leave the result type out to read them as anonymous structs"
    result_col = if q.result == None then 1 else q.result_col

    case (shape, row, Iter.is_empty(columns))
        (.Many, None, True) ->
            Err(
                at_annotation(
                    q,
                    1,
                    "`${q.name}` returns no rows, so its result is the number of rows it changed: write `-> Changed`",
                    [count_hint],
                )
            )

        (.Ignored, _, False) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns rows, so its result cannot be `Unit`",
                    [rows_hint],
                )
            )

        (.Changed, _, False) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns rows, so its result cannot be `Changed`",
                    [rows_hint],
                )
            )

        (.One, Some("Int"), True) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns no rows, so it cannot answer an `Int`; write `-> Changed` for the number of rows it changed, or `-> Unit`",
                    [],
                )
            )

        (_, Some(_), True) ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns no rows, so it has no row type",
                    [count_hint],
                )
            )

        (_, Some(t), False) when scalar and Iter.count(columns) != 1 ->
            Err(
                at_annotation(
                    q,
                    result_col,
                    "`${q.name}` returns ${Iter.count(
                        columns
                    )} columns, so its row type cannot be `${t}`",
                    [
                        "a value type reads a query of one column; name a struct with a field per column, `-> List<MyRow>`, or leave the result type out to read the rows as anonymous structs",
                    ],
                )
            )

        (found, _, _) ->
            Ok(found)
    end
end

/// How each column is read, the imports its type needs, or what is wrong
/// with the columns.
fn fields_of(
    s:         Schema,
    r:         Resolver,
    q:         Query,
    tokens:    List<Token>,
    columns:   List<Column>,
    anonymous: Bool,
) -> (List<Field>, List<(String, String)>, List<Problem>)
    items = sqltext.select_items(tokens) |> Iter.to_vector()
    overrides = sqltext.overrides(tokens)
    one_item_per_column = Vector.length(items) == Iter.count(columns)

    (fields, imports, problems, _) = Iter.reduce(Iter.with_index(columns), (
        [],
        [],
        [],
        [],
    ), fn acc, (position, column) ->
        (fields, imports, problems, seen) = acc

        at = fn message: String, hints: List<String> ->
            item = if one_item_per_column then Vector.get(items, position) else None

            case item |> Maybe.flat_map(Iter.first)
                Some(t) -> at_token(q, t, message, hints)
                None    -> at_annotation(q, 1, message, hints)
            end
        end

        override = Iter.find(overrides, fn o -> o.column == column.name)

        if not sqltext.is_name(column.name) then
            problem = at(
                "the column `${column.name}` has no name a field can take",
                ["name it with `AS`: `${column.name} AS \"total\"`"],
            )

            return (fields, imports, [problem, ..problems], seen)
        end

        if Iter.contains(seen, column.name) then
            problem = at(
                "`${q.name}` has two columns named `${column.name}`",
                ["rename one with `AS`"],
            )

            return (fields, imports, [problem, ..problems], seen)
        end

        (field, needs, problem) = field_of(s, r, q, column, position, override, anonymous, at)

        (
            [field, ..fields],
            needs + imports,
            sqltext.listed(problem) + problems,
            [column.name, ..seen],
        )
    end)

    (Iter.reverse(fields), imports, Iter.reverse(problems))
end

fn field_of(
    s:         Schema,
    r:         Resolver,
    q:         Query,
    column:    Column,
    position:  Int,
    override:  Maybe<Override>,
    anonymous: Bool,
    at:        (String, List<String>) -> Problem,
) -> (Field, List<(String, String)>, Maybe<Problem>)
    nullable = override |> Maybe.flat_map(fn o -> o.nullable) |> Maybe.with_default(column.nullable)
    type_override = override |> Maybe.flat_map(fn o -> o.type_text)
    enum_name = enum_of(s, column)

    family = if enum_name != None then
        Some(types.text_family())
    else
        types.of(column.type_name)
    end

    scale = types.scale(column.type_name)

    (reader, args) = case (type_override, family, scale)
        (Some(_), _, _) -> ("value", "")
        (None, Some(f), Some(n)) when f.reader == "numeric" -> ("numeric_scaled", ", ${n}")
        (None, Some(f), _) -> (f.reader, "")
        (None, None, _) -> ("value", "")
    end

    // A type sqlkit picks is qualified where an import shadows it.
    chosen = case (enum_name, family)
        (Some(e), _)    -> Some(e)
        (None, Some(f)) -> Some(f.nomi)
        (None, None)    -> None
    end

    (written, written_imports) = case chosen
        Some(t) ->
            (text, imports) = generated(r, t)
            (Some(text), imports)

        None ->
            (None, [])
    end

    type_text = case type_override
        Some(t) -> Some(t)
        None    -> written
    end

    field = Field{name: column.name, position:, reader:, args:, type_text:, nullable:}

    // Only an anonymous row names a column's type in the generated code.
    if not anonymous then return (field, [], None)

    case (type_override, type_text)
        (_, None) ->
            problem = at(
                "SQLite reports no type for the column `${column.name}` of `${q.name}`: it is an expression",
                [
                    "give its type in its name: `AS \"${column.name}: Int\"`, or declare the row type: `-> List<MyRow>`",
                ],
            )

            (field, [], Some(problem))

        (Some(t), _) ->
            case resolve(r, t)
                Ok(needs)  -> (field, needs, None)
                Err(found) -> (field, [], Some(at(found.first, found.second)))
            end

        (None, Some(_)) ->
            (field, written_imports, None)
    end
end

/// The enum a column of a table with a `CHECK (column IN (...))` reads
/// as, by its name.
fn enum_of(s: Schema, column: Column) -> Maybe<String>
    if column.table == "" then return None

    described.column(s.tables, column.table, column.column)
    |> Maybe.flat_map(fn c ->
        if is_enum_column(c) then Some(enum_name(row_of(s, column.table), column.column)) else None
    end)
end

fn result_type(shape: Shape, row: Maybe<String>, fields: List<Field>) -> String
    row_text = case row
        Some(t) -> t
        None    -> anonymous_type(fields)
    end

    case shape
        .One      -> "Result<${row_text}, sql.Error>"
        .Optional -> "Result<Maybe<${row_text}>, sql.Error>"
        .Many     -> "Result<List<${row_text}>, sql.Error>"
        .Stream   -> "sqlkit.Rows<${row_text}>"
        .Changed  -> "Result<sqlkit.Changed, sql.Error>"
        .Ignored  -> "Result<Unit, sql.Error>"
    end
end

fn field_type(field: Field) -> String
    base = field.type_text |> Maybe.with_default("sql.Value")

    if field.nullable then "Maybe<${base}>" else base
end

fn anonymous_type(fields: List<Field>) -> String
    inner = fields |> Iter.map(fn f -> "${f.name}: ${field_type(f)}") |> String.join(", ")
    "{${inner}}"
end

/// The generated function's text.
fn function_source(
    q:       Query,
    shape:   Shape,
    row:     Maybe<String>,
    note:    String,
    parts:   List<String>,
    markers: List<Token>,
    fields:  List<Field>,
    scalar:  Bool,
) -> String
    doc =
        q.doc
        |> Iter.map(fn line -> if line == "" then "///\n" else "/// ${line}\n")
        |> String.join()

    params = q.params |> Iter.map(fn p -> "${p.name}: ${p.type_text}") |> Iter.to_list()
    signature = signature_source(q.name, ["conn: sql.Conn", ..params], shape, row, fields)
    // A part's lines sit at a list item's indent: a part that spans lines
    // puts the parts one a line (statement_source).
    quoted_parts = parts |> Iter.map(&sql_literal(&1, "            ")) |> Iter.to_list()

    binds =
        markers
        |> Iter.map(fn m -> "runtime.bind(${sqltext.marker_name(m.text)})")
        |> Iter.to_list()

    statement = statement_source(quoted_parts, binds)
    name = quote(q.name)

    body = case shape
        .Changed ->
            "    runtime.exec(conn, statement)\n"

        .Ignored ->
            "    runtime.run(conn, statement)\n"

        _ ->
            reader = case shape
                .One      -> "one"
                .Optional -> "optional"
                .Stream   -> "rows"
                _         -> "list"
            end

            read_as_column = case fields
                [only] when scalar -> Some(only)
                _                  -> None
            end

            case read_as_column
                Some(field) ->
                    suffix = if field.nullable then "_null" else ""

                    call = "runtime.${reader}(conn, ${name}, statement, fn row -> "
                    read = "runtime.${field.reader}${suffix}(${name}, row, 0${field.args})"

                    if fits("    ${call}${read})") then
                        "    ${call}${read})\n"
                    else
                        "    runtime.${reader}(conn, ${name}, statement, fn row ->\n        ${read}\n    end)\n"
                    end

                None ->
                    open = case row
                        Some(t) -> "${t}{"
                        None    -> "{"
                    end

                    lines =
                        fields
                        |> Iter.map(fn f -> field_line(f, name, row == None))
                        |> String.join()

                    "    runtime.${reader}(conn, ${name}, statement, fn row -> Ok(${open}\n${lines}        }))\n"
            end
    end

    doc + signature + statement + note + body + "end\n"
end

// Whether a line fits the formatter's width.
fn fits(line: String) -> Bool
    String.length(line) <= 100
end

// `items` as the formatter lays out a list of them after `head` and before
// `tail` at `indent`: on one line when it fits, else one item a line.
fn listed_source(indent: String, head: String, items: List<String>, tail: String) -> String
    one = "${indent}${head}${String.join(items, ", ")}${tail}"

    if (fits(one) and not Iter.any_match(items, &String.contains(&1, "\n")))
        or Iter.is_empty(items) then
        "${one}\n"
    else
        lines = items |> Iter.map(fn item -> "${indent}    ${item},\n") |> String.join()

        "${indent}${head}\n${lines}${indent}${String.slice(tail, 0, 1)}${String.slice(
            tail,
            1,
            String.length(tail),
        )}\n"
    end
end

// The statement a function binds, laid out as the formatter does.
fn statement_source(parts: List<String>, binds: List<String>) -> String
    one = "    statement = runtime.statement([${String.join(parts, ", ")}], [${String.join(
        binds,
        ", ",
    )}])"

    spans_lines = Iter.any_match(parts, &String.contains(&1, "\n"))

    if fits(one) and not spans_lines then
        "${one}\n\n"
    else
        "    statement = runtime.statement(\n" + listed_source(
            "        ",
            "[",
            parts,
            "],",
        ) + listed_source("        ", "[", binds, "],") + "    )\n\n"
    end
end

// A generated function's signature, laid out as the
// formatter does: on one line when it fits; else an anonymous row's fields
// one a line when the rest fits, and else the parameters one a line.
fn signature_source(
    name:   String,
    params: List<String>,
    shape:  Shape,
    row:    Maybe<String>,
    fields: List<Field>,
) -> String
    result = result_type(shape, row, fields)
    head = "pub fn ${name}(${String.join(params, ", ")})"
    one = "${head} -> ${result}"

    if fits(one) then return "${one}\n"

    anonymous = row == None and not Iter.is_empty(fields)
    opened = "-> ${result_open(shape)}{"

    if anonymous and fits("${head} ${opened}") then
        return "${head} ${opened}\n${broken_fields(fields)}}${result_close(shape)}\n"
    end

    lines = params |> Iter.map(fn p -> "    ${p},\n") |> String.join()
    close = ") -> ${result}"

    if fits(close) or not anonymous then
        "pub fn ${name}(\n${lines}${close}\n"
    else
        "pub fn ${name}(\n${lines}) ${opened}\n${broken_fields(fields)}}${result_close(shape)}\n"
    end
end

fn broken_fields(fields: List<Field>) -> String
    fields |> Iter.map(fn f -> "    ${f.name}: ${field_type(f)},\n") |> String.join()
end

// The result type before and after an anonymous row's `{...}`.
fn result_open(shape: Shape) -> String
    case shape
        .One      -> "Result<"
        .Optional -> "Result<Maybe<"
        .Stream   -> "sqlkit.Rows<"
        _         -> "Result<List<"
    end
end

fn result_close(shape: Shape) -> String
    case shape
        .One      -> ", sql.Error>"
        .Optional -> ">, sql.Error>"
        .Stream   -> ">"
        _         -> ">, sql.Error>"
    end
end

fn field_line(field: Field, name: String, anonymous: Bool) -> String
    suffix = if field.nullable then "_null" else ""

    type_args = case (anonymous, field.type_text, field.reader)
        (True, Some(t), _) -> "<${t}>"
        (False, Some(t), "value") -> "<${t}>"
        _ -> ""
    end

    args = [name, "row", "${field.position}"] + (field.args
    |> sqltext.cut_prefix(", ")
    |> String.split(", ")
    |> Iter.filter(fn a -> a != "")
    |> Iter.to_list())

    listed_source(
        "            ",
        "${field.name}: runtime.${field.reader}${suffix}${type_args}(",
        args,
        ")?,",
    )
end

/// Whether a row type names one of std's value types (or a `Maybe` of
/// one), which a query of one column reads the column as, rather than a
/// struct.
//! assert codegen.is_scalar("Int")
//! assert codegen.is_scalar("Maybe<String>")
//! refute codegen.is_scalar("User")
//
pub fn is_scalar(text: String) -> Bool
    inner = if String.starts_with(text, "Maybe<") and String.ends_with(text, ">") then
        text |> sqltext.cut_prefix("Maybe<") |> sqltext.cut_suffix(">")
    else
        text
    end

    Iter.contains(
        [
            "Int",
            "Float",
            "Decimal",
            "String",
            "Bool",
            "Bytes",
            "Date",
            "Time",
            "NaiveDateTime",
            "Instant",
            "Uuid",
            "Json",
        ],
        String.trim(inner),
    )
end

/// Whether a row type names one of the schema's enums (or a `Maybe` of
/// one), by its name or qualified by the schema module, and no import
/// gives that name another type.
fn is_schema_enum(r: Resolver, text: String) -> Bool
    inner = if String.starts_with(text, "Maybe<") and String.ends_with(text, ">") then
        text |> sqltext.cut_prefix("Maybe<") |> sqltext.cut_suffix(">") |> String.trim()
    else
        text
    end

    qualified = String.strip_prefix(inner, "${r.qualifier}.")

    name = qualified |> Maybe.with_default(inner)
    shadowed = qualified == None and Map.get(r.imported, name) != None

    not shadowed and name in r.schema and not (name in Map.values(r.rows))
end

/// s as a Nomi string literal.
pub fn quote(s: String) -> String
    escaped =
        s
        |> String.replace("\\", "\\\\")
        |> String.replace("\"", "\\\"")
        |> String.replace("\${", "\\\${")
        |> String.replace("\n", "\\n")
        |> String.replace("\t", "\\t")
        |> String.replace("\r", "\\r")

    "\"${escaped}\""
end

/// SQL text as a Nomi string literal that shows it as written: a raw
/// backtick string, and `quote(s)` when a raw string cannot hold it
/// exactly. A raw string that spans lines puts its lines and its
/// closing backtick at `indent`, where `nomi fmt` puts them, so the cut of
/// a multi-line string gives back `s`.
///
/// `quote` writes text with a backtick or a carriage return, a one-line
/// text with a tab, and a multi-line one with a space or tab at the end of
/// a line: an editor that trims trailing spaces would change the SQL.
/// Any literal whose value, cut as the lexer cuts it, is not `s` is
/// written by `quote` too.
//! assert codegen.sql_literal("SELECT 1", "") == "`SELECT 1`"
//! assert codegen.sql_literal("", "") == "``"
//! assert codegen.sql_literal("SELECT \"a\"", "") == "`SELECT \"a\"`"
//! assert codegen.sql_literal("a\nb\n", "  ") == "`\n  a\n  b\n\n  `"
//! assert codegen.sql_literal("a`b", "") == "\"a`b\""
//
pub fn sql_literal(s: String, indent: String) -> String
    quoted = quote(s)

    if String.contains(s, "`") or String.contains(s, "\r") then return quoted

    lines = String.split(s, "\n")

    literal = case lines
        [_] ->
            if String.contains(s, "\t") then
                None
            else
                Some("`${s}`")
            end

        _ ->
            if Iter.any_match(lines, ends_in_blank) then
                None
            else
                body =
                    lines
                    |> Iter.map(fn line -> if line == "" then "" else indent + line)
                    |> String.join("\n")

                Some("`\n${body}\n${indent}`")
            end
    end

    case literal
        Some(raw) when raw_value(raw) == Some(s) -> raw
        _ -> quoted
    end
end

fn ends_in_blank(line: String) -> Bool
    String.ends_with(line, " ") or String.ends_with(line, "\t")
end

/// The value of a raw backtick literal as the lexer reads it, or None for
/// text that is not one. A literal that spans lines is cut as a
/// triple-quoted string is: the line break after the opening backtick
/// goes, the least indentation of its lines that are not blank and of the
/// closing line goes from every line, and the closing line goes.
//! assert codegen.raw_value("`a\"b`") == Some("a\"b")
//! assert codegen.raw_value("`\n    a\n      b\n    `") == Some("a\n  b")
//! assert codegen.raw_value("`\n    a\n  `") == Some("  a")
//! assert codegen.raw_value("\"a\"") == None
//
pub fn raw_value(literal: String) -> Maybe<String>
    body = String.strip_prefix(literal, "`") |> Maybe.flat_map(&String.strip_suffix(&1, "`"))

    case body
        None ->
            None

        Some(b) when String.contains(b, "`") ->
            None

        Some(b) when not String.contains(b, "\n") ->
            Some(b)

        Some(b) ->
            lines = String.split(
                String.strip_prefix(b, "\n")
                |> Maybe.with_default(b),
                "\n",
            )

            last = Iter.count(lines) - 1

            baseline =
                lines
                |> Iter.with_index()
                |> Iter.filter(fn (i, line) -> i == last or blanks_of(line) != line)
                |> Iter.map(fn (_, line) -> blanks_of(line))
                |> Iter.min_by(String.length)
                |> Maybe.with_default("")

            kept = if last == 0 then
                lines
            else
                Iter.take(lines, last) |> Iter.to_list()
            end

            kept |> Iter.map(&cut_blanks(&1, baseline)) |> String.join("\n") |> Some()
    end
end

// The spaces and tabs a line starts with.
fn blanks_of(line: String) -> String
    String.to_codepoints(line)
    |> Iter.take_while(is_blank)
    |> Iter.to_list()
    |> String.from_codepoints()
end

fn is_blank(cp: Codepoint) -> Bool
    Codepoint.to_int(cp) == 32 or Codepoint.to_int(cp) == 9
end

// A line less the start it shares with `baseline`, as the lexer strips it.
fn cut_blanks(line: String, baseline: String) -> String
    points = String.to_codepoints(line)

    shared =
        Iter.zip(points, String.to_codepoints(baseline))
        |> Iter.take_while(fn (a, b) -> a == b)
        |> Iter.count()

    points |> Iter.drop(shared) |> Iter.to_list() |> String.from_codepoints()
end

// --- names -----------------------------------------------------------
/// The enum a `CHECK (column IN (...))` column reads as: its table's row
/// struct and the column, so `orders.status` is `OrderStatus`.
//! assert codegen.enum_name("Order", "status") == "OrderStatus"
//! assert codegen.enum_name("OrderItem", "kind") == "OrderItemKind"
//
pub fn enum_name(row: String, column: String) -> String
    row + String.pascal_case(column)
end

/// A table's name in the singular, by a plain English rule: `ies` is `y`,
/// `ses` is `s`, a name ending in `ss` stays, and an `s` at the end goes.
/// A name the rule gets wrong takes its row's name from nomi.toml.
//! assert codegen.singular("users") == "user"
//! assert codegen.singular("order_items") == "order_item"
//! assert codegen.singular("categories") == "category"
//! assert codegen.singular("addresses") == "address"
//! assert codegen.singular("statuses") == "status"
//! assert codegen.singular("glass") == "glass"
//! assert codegen.singular("people") == "people"
//
pub fn singular(name: String) -> String
    if String.ends_with(name, "ies") then
        sqltext.cut_suffix(name, "ies") + "y"
    else if String.ends_with(name, "ses") then
        sqltext.cut_suffix(name, "es")
    else if String.ends_with(name, "ss") or not String.ends_with(name, "s") then
        name
    else
        sqltext.cut_suffix(name, "s")
    end
end

fn singular_pascal(table: String) -> String
    String.pascal_case(singular(table))
end

/// The row struct of `table` in db: the name nomi.toml's `tables` gives it,
/// or the table's name in the singular.
//! db = databases.defaults("main")
//! assert codegen.row_name(db, "users") == "User"
//! assert codegen.row_name({..db, tables: {"people" => "Person"}}, "people") == "Person"
//
pub fn row_name(db: Database, table: String) -> String
    Map.get(db.tables, table) |> Maybe.with_default(singular_pascal(table))
end

/// Whether text is a type's name: a capital letter, then letters, digits
/// and `_`.
fn is_type_name(text: String) -> Bool
    first = String.slice(text, 0, 1)

    first in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        and first != ""
        and Iter.all_match(text, fn c ->
            c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        end)
end

/// Whether each value makes a distinct variant name.
fn has_valid_enum_values(values: List<String>) -> Bool
    names = values |> Iter.map(String.pascal_case) |> Iter.to_list()

    Iter.count(Iter.to_set(names)) == Iter.count(names)
        and Iter.all_match(names, fn n ->
            n != "" and not String.slice(n, 0, 1) in "0123456789"
        end)
end
