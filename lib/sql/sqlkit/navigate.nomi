//# What the language server asks of a `query` declaration's body: hover
//# shows a table's or column's type and where its migration declared it, or
//# the query's columns as the snapshot describes them; go to definition
//# opens the migration line; completion offers the tables and their
//# columns; and the quick fix for a query the snapshot does not describe
//# runs `nomi tool sqlkit prepare`. Names are found by the SQL tokenizer and
//# the snapshot's tables, not a SQL parser, so a column reached through a
//# subquery's alias may not resolve.

import {
    std/macro.{
        Action,
        ActionsCall,
        Body,
        Completion,
        Declaration,
        Input,
        NavigationCall,
        Span,
        Tool
    }
    snapshot.{Snapshot, Table, TableColumn}
    sqltext.{self, Kind, Token}
    types
}

/// The snapshot among a query's inputs.
fn snapshot_of(inputs: List<Input>) -> Maybe<Snapshot> {
    inputs
    |> Iter.find(fn i -> String.ends_with?(i.path, ".json"))
    |> Maybe.flat_map(fn i -> Snapshot.parse(i.text) |> Result.to_maybe())
}

/// The token of decl's body at line and col of the declaring file.
fn token_at(decl: Declaration, line: Int, col: Int) -> Maybe<#(Body, Token)> {
    body = case decl.body {
        Some(b) -> b
        None -> return None
    }

    index = line - body.start_line
    lines = String.split(body.text, "\n") |> Iter.to_vector()

    text = case Vector.get(lines, index) {
        Some(t) -> t
        None -> return None
    }

    start = if index == 0 {
        body.start_col
    } else {
        body.indent_col
    }

    bytes = col - start
    if bytes < 0 { return None }

    // The grapheme of the line at that byte, counted from the body's start.
    #(at, _) = Iter.reduce(
        text,
        fn acc, c -> {
            #(n, used) = acc
            if used >= bytes { break acc }
            #(n + 1, used + Bytes.length(String.to_bytes(c)))
        },
        from: #(0, 0),
    )

    before = lines |> Iter.take(index) |> Iter.map(fn l -> String.length(l) + 1) |> Iter.sum()
    offset = before + at

    sqltext.tokens(body.text)
    |> Iter.find(fn t -> t.start <= offset and offset < t.end and t.kind != Kind.Space)
    |> Maybe.map(fn t -> #(body, t))
}

fn word(token: Token) -> String {
    token.text |> sqltext.cut_prefix("\"") |> sqltext.cut_suffix("\"")
}

/// The table or column the word names: a table by its name, or a column
/// of a table the query reads.
fn named(snap: Snapshot, decl: Declaration, name: String) -> Maybe<#(Table, Maybe<TableColumn>)> {
    case Snapshot.table(snap, name) {
        Some(table) ->
            Some(#(table, None))

        None -> {
            tokens =
                decl.body |> Maybe.map(fn b -> sqltext.tokens(b.text)) |> Maybe.with_default([])

            tables = sqltext.table_names(tokens) |> Iter.map(fn #(t, _) -> t) |> Iter.to_list()

            tables
            |> Iter.flat_map(fn t -> Snapshot.table(snap, t) |> sqltext.listed())
            |> Iter.flat_map(fn table -> {
                Iter.find(table.columns, fn c -> c.name == name)
                |> Maybe.map(fn c -> #(table, Some(c)))
                |> sqltext.listed()
            })
            |> Iter.first()
        }
    }
}

fn column_text(column: TableColumn) -> String {
    null = if column.nullable { "" } else { " NOT NULL" }

    nomi =
        types.of(column.type_name)
        |> Maybe.map(fn f -> ", read as `${f.nomi}`")
        |> Maybe.with_default("")

    "${column.type_name}${null}${nomi}"
}

/// Hover inside a query's body.
pub fn hover(call: NavigationCall) -> Maybe<String> {
    #NavigationCall{decl, inputs, line, col} = call

    snap = case snapshot_of(inputs) {
        Some(s) -> s
        None -> return None
    }

    on_name =
        token_at(decl, line, col)
        |> Maybe.flat_map(fn #(_, t) -> named(snap, decl, word(t)))

    case on_name {
        Some(#(table, Some(column))) ->
            Some(
                "`${table.name}.${column.name}`: ${column_text(
                    column
                )}\n\nfrom ${column.migration}:${column.line}"
            )

        Some(#(table, None)) -> {
            columns =
                table.columns
                |> Iter.map(fn c -> "- `${c.name}` ${column_text(c)}")
                |> String.join("\n")

            Some("table `${table.name}`, from ${table.migration}:${table.line}\n\n${columns}")
        }

        None ->
            Snapshot.query(snap, decl.file, decl.name)
            |> Maybe.map(fn q -> {
                columns =
                    q.columns
                    |> Iter.map(fn c -> {
                        null = if c.nullable { ", may be NULL" } else { "" }

                        kind = if c.type_name == "" {
                            "an expression"
                        } else {
                            c.type_name
                        }

                        "- `${c.name}`: ${kind}${null}"
                    })
                    |> String.join("\n")

                "`${decl.name}`, as `nomi tool sqlkit prepare` described it:\n\n${columns}"
            })
    }
}

/// Go to definition inside a query's body: the migration line that made
/// the table or column.
pub fn definition(call: NavigationCall) -> Maybe<Span> {
    #NavigationCall{decl, inputs, line, col} = call

    snap = case snapshot_of(inputs) {
        Some(s) -> s
        None -> return None
    }

    token_at(decl, line, col)
    |> Maybe.flat_map(fn #(_, t) -> named(snap, decl, word(t)))
    |> Maybe.map(fn #(table, column) -> {
        case column {
            Some(c) -> Span.line(c.migration, Int.max(c.line, 1), "")
            None -> Span.line(table.migration, Int.max(table.line, 1), "")
        }
    })
}

/// Completion inside a query's body: the tables, then their columns.
pub fn complete(call: NavigationCall) -> List<Completion> {
    snap = case snapshot_of(call.inputs) {
        Some(s) -> s
        None -> return []
    }

    tables =
        snap.tables
        |> Iter.map(fn t -> #Completion{label: t.name, detail: "table", insert: t.name})

    columns =
        snap.tables
        |> Iter.flat_map(fn t -> {
            t.columns
            |> Iter.map(fn c -> #Completion{
                label: c.name,
                detail: "${t.name}: ${column_text(c)}",
                insert: c.name,
            })
        })

    Iter.concat(tables, columns) |> Iter.to_list()
}

/// The quick fix for a query the snapshot does not describe, a database
/// with no snapshot, or one whose migrations changed: run prepare.
pub fn actions(call: ActionsCall) -> List<Action> {
    diagnostic = call.diagnostic

    stale =
        [" is not in ", " has no snapshot at ", " is out of date: "]
        |> Iter.any?(fn text -> String.contains?(diagnostic.message, text))

    if stale {
        [
            #Action{
                title: "Describe the queries with `nomi tool sqlkit prepare`",
                edits: [],
                tool: Some(#Tool{name: "prepare", args: []}),
            },
        ]
    } else {
        []
    }
}
