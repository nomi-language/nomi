//# What a database's generated code is made from: the `.sql` files of its
//# migrations directory and of its queries directory, and the release of
//# sqlkit that ran. Each generated file records the files' SHA-256 digest
//# and the release, and the generated test computes the digest again from
//# the files as they are and compares the release with the running one, so
//# `nomi test` notices a migration or a query changed, or a different
//# sqlkit is running, after the last `nomi tool sqlkit generate`.

import
    std::fs
    std::hash
    std::system
    migrate
end

/// One input: its path from the package root and its text.
pub struct Input
    path: String
    text: String
end

derive Equatable for Input

/// The `.sql` files directly in `dir`, in name order, with their text,
/// without a `.down.sql` file: the files `migrate.read` takes as
/// migrations (`migrate.is_migration_file`), so a directory golang-migrate
/// keeps describes the schema its `.up.sql` files build.
pub fn read(dir: String) -> Result<List<Input>, String>
    pattern = "${sqltext_dir(dir)}*.sql"
    paths = fs.glob(pattern) |> Result.map_err(fn e -> "${dir}: ${e}")?

    paths
    |> Iter.filter(fn path ->
        name = String.split(path, "/") |> NonEmptyList.last()
        migrate.is_migration_file(name)
    end)
    |> Iter.sort()
    |> Iter.map(fn path ->
        fs.read_text(path)
        |> Result.map(fn text -> Input{path:, text:})
        |> Result.map_err(fn e -> "${path}: ${e}")
    end)
    |> Result.collect()
end

// `dir` with one `/` after it, or nothing for the current directory.
fn sqltext_dir(dir: String) -> String
    trimmed = String.strip_suffix(dir, "/") |> Option.with_default(dir)

    if trimmed == "" or trimmed == "." then
        ""
    else
        "${trimmed}/"
    end
end

/// The SHA-256 digest of inputs, each path and text in order: what a
/// generated file records.
//! assert inputs.digest([]) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
//!
//! one = [Input{path: "db/migrations/1.sql", text: "CREATE TABLE t (n INTEGER);\n"}]
//!
//! assert inputs.digest(one)
//!     != inputs.digest([Input{path: "db/migrations/2.sql", text: "CREATE TABLE t (n INTEGER);\n"}])
//
pub fn digest(inputs: List<Input>) -> String
    inputs
    |> Iter.map(fn i -> "${i.path}\u{0}${i.text}\u{0}")
    |> String.join()
    |> String.to_bytes()
    |> hash.sha256_hex()
end

/// The digest of the `.sql` files in `migrations` and then in `queries`,
/// as they are now, by relative paths, which a test resolves under its
/// package root: what the generated test compares with the digest the
/// generated files record.
pub fn current(migrations: String, queries: String) -> Result<String, String>
    m = read(migrations)?
    q = read(queries)?
    Ok(digest(m + q))
end

// The release a sqlkit run by a `nomi` built from source records.
once unreleased: String = "unreleased"

/// The release of sqlkit that is running, which a generated file records:
/// the running `nomi`'s release (`system.nomi_release`), since sqlkit is
/// released with Nomi, or `unreleased` for a `nomi` built from source.
pub fn release() -> String
    system.nomi_release() |> Option.with_default(unreleased)
end

/// What is wrong with code sqlkit `recorded` wrote when sqlkit `running`
/// is running, or None, `kit` being the name the package gives sqlkit. Code
/// one release wrote may not be what another writes, and another may find
/// problems in the SQL, so two releases that differ are a mismatch.
/// `unreleased`, a sqlkit run by a `nomi` built from source, has no
/// release to compare and matches any.
pub fn mismatch(recorded: String, running: String, kit: String) -> Option<String>
    if recorded == running or recorded == unreleased or running == unreleased then
        None
    else
        Some(
            "the code was written by sqlkit ${recorded}, and sqlkit ${running} is running: run `nomi tool ${kit} generate`"
        )
    end
end
