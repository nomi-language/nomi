//# The schema snapshot: what `nomi tool sqlkit prepare` learned from the
//# database, committed beside the migrations, and the only thing the
//# `query` and `database` macros read about the database. It is JSON,
//# written in a stable order (tables by name, queries by file and name, two
//# spaces of indentation), so a change to it reviews as a diff.
//#
//# ```json
//# {
//#   "format": 2,
//#   "database": "main",
//#   "dialect": "sqlite",
//#   "migrations": "3f9c0a7d1e2b4c58",
//#   "tables": [
//#     {
//#       "name": "users",
//#       "migration": "db/migrations/001_users.sql",
//#       "line": 1,
//#       "columns": [
//#         {"name": "id", "type_name": "INTEGER", "nullable": false, "primary_key": true,
//#          "has_default": false, "values": [], "migration": "...", "line": 2}
//#       ]
//#     }
//#   ],
//#   "queries": [
//#     {
//#       "file": "queries.nomi",
//#       "name": "user_by_email",
//#       "sql": "SELECT id, email FROM users WHERE email = ?1",
//#       "params": 1,
//#       "columns": [
//#         {"name": "id", "type_name": "INTEGER", "table": "users", "column": "id", "nullable": false}
//#       ],
//#       "error": null
//#     }
//#   ]
//# }
//# ```
//#
//# `migrations` is the checksum of the migrations' paths and text, in the
//# order they apply, so the `database` declaration tells a migration added
//# or changed since the snapshot was written.
//#
//# A column's `values` are the values a `CHECK (column IN (...))`
//# constraint allows, which the `database` declaration turns into an enum.
//# A query is found by its file and name, and its `sql` is the SQL it sends,
//# so a query whose SQL changed since the last prepare is told apart from
//# one never described.

import {
    std/json.{FromJson, Json}
    checksum
    sqltext
}

/// The snapshot format this version of sqlkit reads and writes.
pub once format: Int = 2

pub struct Snapshot {
    format: Int
    database: String
    dialect: String

    /// The checksum of the migrations the snapshot was prepared from
    /// (`migrations_checksum`), so a migration added or changed since is
    /// told apart.
    migrations: String

    tables: List<Table>
    queries: List<Query>
}

pub struct Table {
    name: String
    migration: String
    line: Int
    columns: List<TableColumn>
}

pub struct TableColumn {
    name: String
    type_name: String
    nullable: Bool
    primary_key: Bool
    has_default: Bool
    values: List<String>
    migration: String
    line: Int
}

pub struct Query {
    file: String
    name: String
    sql: String
    params: Int
    columns: List<Column>
    error: Maybe<QueryError>
}

/// A result column: its name, the declared type of the table column it
/// reads (for an expression, the type one `CAST` gives it, else `""`),
/// that table and column (`""` for an
/// expression), and whether it may be NULL as `prepare` worked it out:
/// a column read from a table is NULL only when the table's column may be
/// or an outer join may leave it out, and an expression always may be.
pub struct Column {
    name: String
    type_name: String
    table: String
    column: String
    nullable: Bool
}

/// The error the database gave for a query it could not prepare, and the
/// byte of the query's SQL it named (-1 for none).
pub struct QueryError {
    message: String
    offset: Int
}

derive Equatable for Snapshot

derive Equatable for Table

derive Equatable for TableColumn

derive Equatable for Query

derive Equatable for Column

derive Equatable for QueryError

derive FromJson for Snapshot

derive FromJson for Table

derive FromJson for TableColumn

derive FromJson for Query

derive FromJson for Column

derive FromJson for QueryError

impl Snapshot {
    /// The snapshot `text` holds, or why it holds none.
    pub fn parse(text: String) -> Result<Snapshot, String> {
        json = case Json.decode(text) {
            Ok(j) -> j
            Err(e) -> return Err("it is not JSON: ${e}")
        }

        // The format first: a snapshot of another format has other fields.
        case json {
            Json.Obj(fields) ->
                case Map.get(fields, "format") {
                    Some(Json.Int(n)) when n != format ->
                        return Err("it is in format ${n}, and this sqlkit reads format ${format}")

                    _ -> {}
                }

            _ -> {}
        }

        case Snapshot.from_json(json) {
            Ok(s) -> Ok(s)
            Err(e) -> Err("it is not a snapshot: ${e}")
        }
    }

    /// The query `name` of `file`.
    pub fn query(snapshot: Snapshot, file: String, name: String) -> Maybe<Query> {
        Iter.find(snapshot.queries, fn q -> q.file == file and q.name == name)
    }

    /// The table `name`.
    pub fn table(snapshot: Snapshot, name: String) -> Maybe<Table> {
        Iter.find(snapshot.tables, fn t -> t.name == name)
    }

    /// The column `column` of table `table`.
    pub fn column(snapshot: Snapshot, table: String, column: String) -> Maybe<TableColumn> {
        Snapshot.table(snapshot, table)
        |> Maybe.flat_map(fn t -> Iter.find(t.columns, fn c -> c.name == column))
    }

    /// The snapshot as the text `prepare` writes.
    pub fn write(snapshot: Snapshot) -> String {
        tables =
            snapshot.tables |> Iter.map(fn t -> fn i: String -> table_json(t, i)) |> Iter.to_list()

        queries =
            snapshot.queries |> Iter.map(fn q -> fn i: String -> query_json(q, i)) |> Iter.to_list()

        obj(
            "",
            [
                #("format", "${snapshot.format}"),
                #("database", string(snapshot.database)),
                #("dialect", string(snapshot.dialect)),
                #("migrations", string(snapshot.migrations)),
                #("tables", arr("  ", tables)),
                #("queries", arr("  ", queries)),
            ],
        ) + "\n"
    }
}

/// The checksum of a database's migrations, each with its path, in the
/// order they apply: what a snapshot records as `migrations`, so a
/// migration added, removed, renamed or edited since `prepare` changes it.
pub fn migrations_checksum(migrations: List<#(String, String)>) -> String {
    migrations
    |> Iter.map(fn #(path, text) -> "${path}\u{0}${text}\u{0}")
    |> String.join()
    |> checksum.of()
}

fn table_json(table: Table, indent: String) -> String {
    columns =
        table.columns |> Iter.map(fn c -> fn i: String -> table_column_json(c, i)) |> Iter.to_list()

    obj(
        indent,
        [
            #("name", string(table.name)),
            #("migration", string(table.migration)),
            #("line", "${table.line}"),
            #("columns", arr(indent + "  ", columns)),
        ],
    )
}

fn table_column_json(column: TableColumn, indent: String) -> String {
    values = column.values |> Iter.map(string) |> String.join(", ")
    _ = indent

    fields = [
        "\"name\": ${string(column.name)}",
        "\"type_name\": ${string(column.type_name)}",
        "\"nullable\": ${boolean(column.nullable)}",
        "\"primary_key\": ${boolean(column.primary_key)}",
        "\"has_default\": ${boolean(column.has_default)}",
        "\"values\": [${values}]",
        "\"migration\": ${string(column.migration)}",
        "\"line\": ${column.line}",
    ]

    "{" + String.join(fields, ", ") + "}"
}

fn query_json(query: Query, indent: String) -> String {
    columns = query.columns |> Iter.map(fn c -> fn i: String -> column_json(c, i)) |> Iter.to_list()

    error = case query.error {
        Some(e) -> "{\"message\": ${string(e.message)}, \"offset\": ${e.offset}}"
        None -> "null"
    }

    obj(
        indent,
        [
            #("file", string(query.file)),
            #("name", string(query.name)),
            #("sql", string(query.sql)),
            #("params", "${query.params}"),
            #("columns", arr(indent + "  ", columns)),
            #("error", error),
        ],
    )
}

fn column_json(column: Column, indent: String) -> String {
    _ = indent

    fields = [
        "\"name\": ${string(column.name)}",
        "\"type_name\": ${string(column.type_name)}",
        "\"table\": ${string(column.table)}",
        "\"column\": ${string(column.column)}",
        "\"nullable\": ${boolean(column.nullable)}",
    ]

    "{" + String.join(fields, ", ") + "}"
}

// An object of fields, one per line, at indent.
fn obj(indent: String, fields: List<#(String, String)>) -> String {
    inner = indent + "  "

    lines =
        fields
        |> Iter.map(fn #(key, value) -> "${inner}${string(key)}: ${value}")
        |> String.join(",\n")

    "{\n${lines}\n${indent}}"
}

// An array of items, each written by its function at the indent inside it.
fn arr(indent: String, items: List<(String) -> String>) -> String {
    if Iter.empty?(items) { return "[]" }
    inner = indent + "  "
    lines = items |> Iter.map(fn item -> inner + item(inner)) |> String.join(",\n")
    "[\n${lines}\n${indent}]"
}

// s as a JSON string. Json.encode escapes `<`, `>` and `&` for HTML, which
// would make the SQL in a snapshot hard to read in a diff.
fn string(s: String) -> String {
    escaped =
        s
        |> Iter.map(fn c -> {
            case c {
                "\"" ->
                    "\\\""

                "\\" ->
                    "\\\\"

                "\n" ->
                    "\\n"

                "\t" ->
                    "\\t"

                _ ->
                    if Bytes.length(String.to_bytes(c)) == 1 and String.to_codepoints(c)
                    |> Iter.all?(fn cp -> Codepoint.to_int(cp) < 32) {
                        Json.encode(Json.String(c))
                        |> sqltext.cut_prefix("\"")
                        |> sqltext.cut_suffix("\"")
                    } else {
                        c
                    }
            }
        })
        |> String.join()

    "\"${escaped}\""
}

fn boolean(b: Bool) -> String {
    if b { "true" } else { "false" }
}
