end

/// A `DECIMAL(p, s)` column, or an expression `CAST` to one, read at its
/// scale `s` (see `at_scale`).
pub fn numeric_scaled<T>(
    query:    String,
    row:      Row,
    position: Int,
    scale:    Int,
) -> Result<T, sql.Error> where T: SqlNumeric and FromSql
    read(query, at_scale(query, row, position, scale)?, position)
end

pub fn numeric_scaled_null<T>(
    query:    String,
    row:      Row,
    position: Int,
    scale:    Int,
) -> Result<Maybe<T>, sql.Error> where T: SqlNumeric and FromSql
    read(query, at_scale(query, row, position, scale)?, position)
end

pub fn numeric_null<T>(
    query:    String,
    row:      Row,
    position: Int,
) -> Result<Maybe<T>, sql.Error> where T: SqlNumeric and FromSql
    read(query, row, position)
end

