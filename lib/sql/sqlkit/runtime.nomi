/// The rows of statement, each read by decode.
fn rows_of<T>(
    conn:      Conn,
    statement: Statement,
    decode:    (Row) -> Result<T, sql.Error>,
) -> Result<List<T>, sql.Error>
    rows = Conn.query(conn, statement)?
    rows |> Iter.map(decode) |> Result.collect()
end

/// `-> T`: exactly one row.
pub fn one<T>(
    conn:      Conn,
    query:     String,
    statement: Statement,
    decode:    (Row) -> Result<T, sql.Error>,
) -> Result<T, sql.Error>
    rows = rows_of(conn, statement, decode)?

    case rows
        [row] -> Ok(row)
        _     -> Err(sql.Error.RowCount{query:, expected: "exactly one", found: Iter.count(rows)})
    end
end

/// `-> Maybe<T>`: at most one row.
pub fn optional<T>(
    conn:      Conn,
    query:     String,
    statement: Statement,
    decode:    (Row) -> Result<T, sql.Error>,
) -> Result<Maybe<T>, sql.Error>
    rows = rows_of(conn, statement, decode)?

    case rows
        []    -> Ok(None)
        [row] -> Ok(Some(row))
        _     -> Err(sql.Error.RowCount{query:, expected: "at most one", found: Iter.count(rows)})
    end
end

/// `-> List<T>`: every row.
pub fn list<T>(
    conn:      Conn,
    query:     String,
    statement: Statement,
    decode:    (Row) -> Result<T, sql.Error>,
) -> Result<List<T>, sql.Error>
    _ = query
    rows_of(conn, statement, decode)
end

/// `-> Rows<T>`: the rows, streamed when folded.
pub fn rows<T>(
    conn:      Conn,
    query:     String,
    statement: Statement,
    decode:    (Row) -> Result<T, sql.Error>,
) -> Rows<T>
    Rows.new(conn, query, statement, decode)
end

/// A statement that returns no rows: the number of rows it changed, what a
/// `-> Changed` query returns.
pub fn exec(conn: Conn, statement: Statement) -> Result<Changed, sql.Error>
    Conn.exec(conn, statement) |> Result.map(fn rows -> Changed{rows:})
end

/// A statement that returns no rows, run for its effect alone: what a
/// `-> Unit` query returns.
pub fn run(conn: Conn, statement: Statement) -> Result<Unit, sql.Error>
    _ = Conn.exec(conn, statement)?
    Ok(Unit)
end

/// The text of a text value: what a generated enum reads.
pub fn text_of(value: Value) -> Maybe<String>
    case value
        .Text(s) -> Some(s)
        _        -> None
    end
end
