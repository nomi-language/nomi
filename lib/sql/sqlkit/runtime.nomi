//# What the functions `nomi tool sqlkit generate` writes call: binding a
//# parameter, reading a column of each SQL type family, and the result
//# shapes. Only generated code needs it.
//#
//# A column reader is generic in the type it reads, which the field it
//# fills decides, and bounded by the column's family, so a field of a type
//# the column cannot hold fails to check at the column.

import
    std::decimal.RoundingMode
    std::sql.{self, Conn, FromSql, Row, Statement, ToSql, Value}
    sqlkit.{
        Changed,
        Rows,
        SqlBool,
        SqlBytes,
        SqlDate,
        SqlFloat,
        SqlInt,
        SqlJson,
        SqlNumeric,
        SqlText,
        SqlTime,
        SqlTimestamp,
        SqlTimestamptz,
        SqlUuid
    }
end

/// The statement of a query: its SQL around each parameter, and the
/// parameters.
pub fn statement(parts: List<String>, params: List<Value>) -> Statement
    Statement{parts:, params:}
end

/// A parameter's value.
pub fn bind(value: ToSql) -> Value
    ToSql.to_sql(value)
end

/// The value of the column at `position` as a `T`, with the error naming
/// `query`, the query's name, rather than its SQL.
fn read<T>(query: String, row: Row, position: Int) -> Result<T, sql.Error> where T: FromSql
    first = Row.get_position<T>(row, position)

    case first
        Ok(v) ->
            Ok(v)

        Err(e) ->
            // An expression's value has whatever storage class SQLite gave it:
            // `sum` over DECIMAL columns may be an integer. A number reads as
            // a wider number type when the type read is one.
            widened =
                Row.value_position(row, position)
                |> Result.to_maybe()
                |> Maybe.map(widenings)
                |> Maybe.with_default([])
                |> Iter.map(fn v -> T.from_sql(v))
                |> Iter.find(Result.is_ok)

            case widened
                Some(Ok(v)) -> Ok(v)
                _           -> Err(named(query, e))
            end
    end
end

/// The values a number may also be read as.
fn widenings(value: Value) -> List<Value>
    case value
        .Int(n) ->
            [Value.Float(Int.to_float(n)), Value.Decimal(Int.to_decimal(n))]

        .Float(x) ->
            shortest(x)
            |> Maybe.map(fn d -> [Value.Decimal(d)])
            |> Maybe.with_default([])

        _ ->
            []
    end
end

/// The digits of d at its scale, from its first nonzero digit before the
/// point through every digit after it: 4 for `12.50d`, 2 for `0.05d`.
//! assert runtime.digits(12.50d) == 4
//! assert runtime.digits(0.05d) == 2
//! assert runtime.digits(-100d) == 3
//! assert runtime.digits(123_456_789_012_345_678_901.5d) == 22
//
pub fn digits(d: Decimal) -> Int
    whole = String.split("${Decimal.abs(d)}", ".") |> Iter.first() |> Maybe.with_default("")
    Iter.count(Iter.drop_while(whole, fn c -> c == "0")) + Decimal.scale(d)
end

/// The decimal of at most 15 digits, at `scale`, that x is the float of, if
/// there is one: what a `DECIMAL(p, s)` value SQLite returned as a float was.
//! assert runtime.exact(12.5, 2) == Some(12.50d)
//! assert runtime.exact(0.1 + 0.2, 2) == None
//! assert runtime.exact(12.555, 2) == None
//
pub fn exact(x: Float, scale: Int) -> Maybe<Decimal>
    case Float.to_decimal(x, scale, RoundingMode.HalfEven)
        Some(d) when Decimal.to_float(d) == x and digits(d) <= exact_digits() -> Some(d)
        _ -> None
    end
end

/// The shortest decimal of at most 15 digits that x is the float of, if
/// there is one.
//! assert runtime.shortest(12.5) == Some(12.5d)
//! assert runtime.shortest(0.1 + 0.2) == None
//
pub fn shortest(x: Float) -> Maybe<Decimal>
    Iter.from(0)
    |> Iter.take(exact_digits() + 1)
    |> Iter.map(fn s -> exact(x, s))
    |> Iter.find(fn d -> d != None)
    |> Maybe.flat_map(fn d -> d)
end

// How many decimal digits a 64-bit float holds exactly: a decimal of at
// most this many digits converts to a float whose shortest decimal form is
// that decimal again. SQLite has no decimal type and keeps a `DECIMAL`
// value, and computes with one, as such a float.
fn exact_digits() -> Int
    15
end

/// The row with the number at `position` as a `Decimal` at `scale`, which a
/// `DECIMAL(p, s)` column or `CAST(... AS DECIMAL(p, s))` declares: SQLite
/// returns an expression's value as an integer or a float, and a float is
/// read only when it is exactly a decimal of that scale and at most 15
/// digits. One that is not is an error rather than a rounded value: it is
/// what SQLite's floating-point arithmetic made of the decimals (a sum of
/// many), or more digits than a float holds.
fn at_scale(query: String, row: Row, position: Int, scale: Int) -> Result<Row, sql.Error>
    value = Row.value_position(row, position) |> Result.map_err(fn e -> named(query, e))?
    columns = Row.columns(row)
    column = columns |> Iter.drop(position) |> Iter.first() |> Maybe.with_default("")
    place = "the column `${column}` of `${query}`, read at scale ${scale},"

    scaled = case value
        .Int(n) ->
            d = Decimal.round(Int.to_decimal(n), scale, RoundingMode.HalfEven)

            if digits(d) <= exact_digits() then
                Ok(d)
            else
                Err(
                    "${place} holds ${n}, of ${digits(
                        d
                    )} digits at that scale, more than the ${exact_digits()} SQLite keeps exactly"
                )
            end

        .Float(x) ->
            case exact(x, scale)
                Some(d) ->
                    Ok(d)

                None ->
                    Err(
                        "${place} holds the float ${x}, which is not exactly a decimal of that scale and at most ${exact_digits()} digits: SQLite computes with DECIMAL values as 64-bit floats; keep amounts you add up in SQL as INTEGER minor units (cents) to add them exactly"
                    )
            end

        .Decimal(d) ->
            rounded = Decimal.round(d, scale, RoundingMode.HalfEven)

            if rounded == d then
                Ok(rounded)
            else
                Err("${place} holds ${d}, which has more decimals than that")
            end

        _ ->
            return Ok(row)
    end

    case scaled
        Ok(d) ->
            values =
                Row.values(row)
                |> Iter.with_index()
                |> Iter.map(fn (i, v) -> if i == position then Value.Decimal(d) else v)

            Ok(
                Row.new(
                    Row.query(row),
                    Iter.zip(columns, values)
                    |> Iter.to_list(),
                )
            )

        Err(message) ->
            Err(sql.Error.Database{code: "sqlkit", message:})
    end
end

fn named(query: String, e: sql.Error) -> sql.Error
    case e
        sql.Error.UnexpectedNull{query: _, column:} ->
            sql.Error.UnexpectedNull{query:, column:}

        sql.Error.Decode{query: _, column:, expected:, found:} ->
            sql.Error.Decode{query:, column:, expected:, found:}

        sql.Error.MissingColumn{query: _, column:} ->
            sql.Error.MissingColumn{query:, column:}

        sql.Error.ColumnPosition{query: _, position:, count:} ->
            sql.Error.ColumnPosition{query:, position:, count:}

        other ->
            other
    end
end

/// An expression's column, of no family: any `FromSql` type.
pub fn value<T>(query: String, row: Row, position: Int) -> Result<T, sql.Error> where T: FromSql
    read(query, row, position)
end

pub fn value_null<T>(
    query:    String,
    row:      Row,
    position: Int,
) -> Result<Maybe<T>, sql.Error> where T: FromSql
    read(query, row, position)
end

pub fn int<T>(
    query:    String,
    row:      Row,
    position: Int,
) -> Result<T, sql.Error> where T: SqlInt and FromSql
    read(query, row, position)
end

pub fn int_null<T>(
    query:    String,
    row:      Row,
    position: Int,
