import {
    std/fs_testing.{self, Sandbox}
    std/json.Json
    std/sql.{self, Conn, Row, Sql, Value}
    std/sql_testing.Fake
    checksum
    codegen.{self, Schema}
    databases.{self, Database}
    described.{Column, QueryError, Table, TableColumn}
    inputs.{self, Input}
    queryfile.{self, File, Param, Problem, Query}
    runtime
    sqlite
    sqlkit.{self, Migration, Rows}
    sqltext
}

gopkg "github.com/nomi-language/nomi/lib/sql/sqlkit/testside"

// --- query files ---------------------------------------------------------
fn parsed(text: String) -> Result<File, List<Problem>> {
    queryfile.parse("db/queries/q.sql", text)
}

fn messages(problems: List<Problem>) -> List<String> {
    problems |> Iter.map(fn p -> p.message) |> Iter.to_list()
}

fn places(problems: List<Problem>) -> List<#(Int, Int)> {
    problems |> Iter.map(fn p -> #(p.line, p.col)) |> Iter.to_list()
}

test "a query file reads each query's annotation, doc lines and SQL" {
    text = "-- The shop's queries.\n-- import: shop.Report\n\n-- query: user_by_email(email: String) -> Maybe<User>\n-- The user with this email,\n--\n-- if any.\nSELECT id\nFROM users\nWHERE email = @email;\n\n-- query: all_users()\nSELECT id FROM users;\n"

    file = case parsed(text) {
        Ok(f) -> f
        Err(ps) -> return Err("${messages(ps)}")
    }

    assert file.imports == ["shop.Report"]

    assert file.queries == [
        #Query{
            file: "db/queries/q.sql",
            line: 4,
            name: "user_by_email",
            params: [#Param{name: "email", type_text: "String", col: 25}],
            result: Some("Maybe<User>"),
            result_col: 43,
            doc: ["The user with this email,", "", "if any."],
            sql: "SELECT id\nFROM users\nWHERE email = @email",
            sql_line: 8,
        },
        #Query{
            file: "db/queries/q.sql",
            line: 12,
            name: "all_users",
            params: [],
            result: None,
            result_col: 0,
            doc: [],
            sql: "SELECT id FROM users",
            sql_line: 13,
        },
    ]
}

test "a parameter's type may hold commas inside brackets" {
    text = "-- query: q(a: Map<String, Int>, b: #(Int, Int)) -> Int\nSELECT @a, @b;\n"

    params = case parsed(text) {
        Ok(f) ->
            f.queries
            |> Iter.flat_map(fn q -> q.params)
            |> Iter.map(fn p -> p.type_text)
            |> Iter.to_list()

        Err(ps) ->
            return Err("${messages(ps)}")
    }

    assert params == ["Map<String, Int>", "#(Int, Int)"]
}

test "a query file's mistakes are problems at their line and column" {
    text = "SELECT 1;\n-- query: Bad()\nSELECT 1;\n-- query: no_parens -> Int\nSELECT 1;\n-- query: twice(a: Int, a: Int)\nSELECT @a;\n-- query: no_end() -> Int\nSELECT 1\n-- query: two() -> Int\nSELECT 1; SELECT 2;\n-- query: empty()\n"

    problems = case parsed(text) {
        Ok(_) -> return Err("no problems")
        Err(ps) -> ps
    }

    assert messages(problems) == [
        "SQL before the first `-- query:` belongs to no query",
        "a query's name is lower case letters, digits and `_`",
        "`no_parens` needs its parameters in parentheses, `()` for none",
        "the parameter `a` is declared twice",
        "the SQL of `no_end` does not end in `;`",
        "`two` has SQL after the `;` that ends it",
        "`empty` has no SQL",
    ]

    assert places(problems) == [#(1, 1), #(2, 11), #(4, 20), #(6, 25), #(8, 1), #(11, 11), #(12, 1)]
}

test "a problem prints as the compiler prints a diagnostic" {
    p = #Problem{
        file: "db/queries/q.sql",
        line: 3,
        col: 7,
        message: "no such column: x",
        hints: ["a hint"],
    }

    assert "${p}" == "db/queries/q.sql:3:7: no such column: x\ndb/queries/q.sql:3:7: help: a hint"
    assert "${#{..p, line: 0, hints: []}}" == "db/queries/q.sql: no such column: x"
}

// --- parameters in SQL ---------------------------------------------------
fn params_of(text: String) -> List<String> {
    sqltext.markers(sqltext.tokens(text)) |> Iter.map(fn t -> t.text) |> Iter.to_list()
}

test "an `@` and an identifier start a parameter: letters, digits and `_`" {
    assert params_of("WHERE a = @user_id2 AND b=@_x AND c = (@C)") == ["@user_id2", "@_x", "@C"]

    // A digit does not start a name.
    assert params_of("SELECT @1, @") == []
}

test "Postgres's `@` operators are SQL text" {
    assert params_of("WHERE tags @> @t AND x <@ y AND d @@ q AND @ x AND v @@name") == ["@t"]
}

test "an `@` in a string, a quoted name or a comment is SQL text" {
    assert params_of("WHERE email = 'a@b.c' AND 'it''s @x' = @y") == ["@y"]
    assert params_of("SELECT \"@x\" FROM t WHERE \"a\"\"@b\" = @y") == ["@y"]
    assert params_of("SELECT 1 -- @x\nFROM t /* @z\n @w */ WHERE a = @y") == ["@y"]
}

test "each `@name` is sent as the next positional parameter" {
    tokens = sqltext.tokens("SELECT a FROM t WHERE a = @x OR b = @y OR c = @x")

    assert sqltext.sqlite_sql(sqltext.parts(tokens))
        == "SELECT a FROM t WHERE a = ?1 OR b = ?2 OR c = ?3"
}

// --- the generated functions ---------------------------------------------
fn column(name: String, type_name: String, nullable: Bool, values: List<String>) -> TableColumn {
    #TableColumn{
        name,
        type_name,
        nullable,
        primary_key: name == "id",
        has_default: False,
        values,
        migration: "db/migrations/1.sql",
        line: 2,
    }
}

fn users_table() -> Table {
    #Table{
        name: "users",
        migration: "db/migrations/1.sql",
        line: 1,
        columns: [
            column("id", "INTEGER", False, []),
            column("name", "TEXT", True, []),
            column("status", "TEXT", False, ["active", "gone"]),
        ],
    }
}

fn schema_with(db: Database, tables: List<Table>) -> Result<Schema, List<Problem>> {
    codegen.schema(db, tables, "schema")
}

fn users_schema() -> Schema {
    case schema_with(databases.defaults("main"), [users_table()]) {
        Ok(s) -> s
        Err(_) -> #Schema{db: databases.defaults("main"), tables: [], rows: %{}, module: "schema"}
    }
}

fn id_column() -> Column {
    #Column{name: "id", type_name: "INTEGER", table: "users", column: "id", nullable: False}
}

fn name_column() -> Column {
    #Column{name: "name", type_name: "TEXT", table: "users", column: "name", nullable: True}
}

// The file q.sql of `text` generates, each query described by `described`.
fn generate(
    text: String,
    described: List<Result<List<Column>, QueryError>>,
) -> Result<String, List<Problem>> {
    file = parsed(text)?
    codegen.queries_file(users_schema(), file, described, "ab12")
}

fn source_of(text: String, columns: List<Column>) -> String {
    case generate(text, [Ok(columns)]) {
        Ok(source) -> source
        Err(ps) -> "${messages(ps)}"
    }
}

fn problems_of(text: String, described: List<Result<List<Column>, QueryError>>) -> List<Problem> {
    case generate(text, described) {
        Ok(_) -> []
        Err(ps) -> ps
    }
}

test "a described query generates a function reading its columns" {
    text = "-- query: user_by_email(email: String) -> Maybe<User>\n-- The user.\nSELECT id, name\nFROM users\nWHERE email = @email;\n"
    source = source_of(text, [id_column(), name_column()])

    assert source == "// Generated by `nomi tool sqlkit generate` from db/queries/q.sql and\n// db/migrations. Do not edit: change the SQL and generate again.\n// inputs sha256: ab12\nimport {\n    std/sql\n    schema.User\n    sqlkit/runtime\n}\n\n/// The user.\npub fn user_by_email(conn: sql.Conn, email: String) -> Result<Maybe<User>, sql.Error> {\n    statement = runtime.statement(\n        [\"SELECT id, name FROM users WHERE email = \", \"\"],\n        [runtime.bind(email)],\n    )\n\n    runtime.optional(conn, \"user_by_email\", statement, fn row -> Ok(#User{\n            id: runtime.int(\"user_by_email\", row, 0)?,\n            name: runtime.text_null(\"user_by_email\", row, 1)?,\n        }))\n}\n"
}

test "a parameter used twice is bound twice" {
    text = "-- query: q(email: String) -> Maybe<User>\nSELECT id, name FROM users WHERE email = @email OR name = @email;\n"
    source = source_of(text, [id_column(), name_column()])
    assert String.contains(source, "[runtime.bind(email), runtime.bind(email)]")
}

test "a parameter the SQL does not use, and an `@name` no parameter names, are problems" {
    problems = problems_of(
        "-- query: user_by_email(email: String)\nSELECT id FROM users WHERE email = @mail;\n",
        [Ok([id_column()])],
    )

    assert messages(problems) == [
        "`mail` is not a parameter of `user_by_email`",
        "the parameter `email` is not used in the SQL of `user_by_email`",
    ]

    assert places(problems) == [#(2, 36), #(1, 25)]

    assert problems |> Iter.map(fn p -> p.hints) |> Iter.to_list() == [
        ["its parameters are `email`"],
        ["write `@email` where it is bound, or remove it"],
    ]
}

test "a `\${...}` in a query's SQL is a problem that suggests `@name`" {
    problems = problems_of(
        "-- query: q(email: String)\nSELECT id FROM users WHERE email = \${email};\n",
        [Ok([id_column()])],
    )

    // Only the `${email}` is reported: the parameter it meant counts as used.
    assert messages(problems) == ["a query's SQL has no `\${...}`"]

    assert problems |> Iter.flat_map(fn p -> p.hints) |> Iter.to_list() == [
        "write `@email`: a query binds a parameter with `@name`",
    ]

    // In a string literal it is SQL text.
    assert sqltext.interpolations(sqltext.tokens("SELECT '\${x}' -- \${y}")) == []
}

test "SQLite's error is a problem at the token it names" {
    rejected = Err(#QueryError{message: "no such column: nmae", offset: 11})

    problems = problems_of(
        "-- query: q() -> User\nSELECT id,\n       nmae FROM users;\n",
        [rejected],
    )

    assert messages(problems) == ["no such column: nmae"]
    assert places(problems) == [#(3, 8)]
}

test "a query with no result type answers anonymous rows, its enums and std types imported" {
    status = #Column{
        name: "status",
        type_name: "TEXT",
        table: "users",
        column: "status",
        nullable: False,
    }

    at = #Column{name: "at", type_name: "TIMESTAMPTZ", table: "", column: "", nullable: True}

    source = source_of(
        "-- query: q()\nSELECT id, status, at FROM users;\n",
        [id_column(), status, at],
    )

    assert String.contains(
        source,
        "import {\n    std/instant.Instant\n    std/sql\n    schema.UserStatus\n    sqlkit/runtime\n}\n",
    )

    assert String.contains(
        source,
        "pub fn q(conn: sql.Conn) -> Result<List<#{\n    id: Int,\n    status: UserStatus,\n    at: Maybe<Instant>,\n}>, sql.Error> {",
    )

    assert String.contains(source, "            id: runtime.int<Int>(\"q\", row, 0)?,\n")

    assert String.contains(
        source,
        "            at: runtime.timestamptz_null<Instant>(\"q\", row, 2)?,\n",
    )
}

test "SQL that returns no rows answers the rows it changed with `-> Changed`, or nothing with `-> Unit`" {
    changed = source_of("-- query: q(id: Int) -> Changed\nDELETE FROM users WHERE id = @id;\n", [])

    assert String.contains(
        changed,
        "pub fn q(conn: sql.Conn, id: Int) -> Result<sqlkit.Changed, sql.Error> {",
    )

    assert String.contains(changed, "    runtime.exec(conn, statement)\n")
    assert String.contains(changed, "\n    sqlkit\n")

    ignored = source_of("-- query: q(id: Int) -> Unit\nDELETE FROM users WHERE id = @id;\n", [])
    assert String.contains(ignored, "-> Result<Unit, sql.Error> {")
    assert String.contains(ignored, "    runtime.run(conn, statement)\n")
    refute String.contains(ignored, "\n    sqlkit\n")
}

test "a query's result must fit whether its SQL returns rows" {
    none = fn result: String -> {
        messages(
            problems_of(
                "-- query: q(id: Int)${result}\nDELETE FROM users WHERE id = @id;\n",
                [Ok([])],
            )
        )
    }

    rows = fn result: String -> {
        messages(
            problems_of("-- query: q()${result}\nSELECT id FROM users;\n", [Ok([id_column()])])
        )
    }

    assert none("") == [
        "`q` returns no rows, so its result is the number of rows it changed: write `-> Changed`",
    ]

    assert none(" -> List<User>") == ["`q` returns no rows, so it has no row type"]

    assert none(" -> Int") == [
        "`q` returns no rows, so it cannot answer an `Int`; write `-> Changed` for the number of rows it changed, or `-> Unit`",
    ]

    assert rows(" -> Unit") == ["`q` returns rows, so its result cannot be `Unit`"]
    assert rows(" -> Changed") == ["`q` returns rows, so its result cannot be `Changed`"]
}

test "a one-column query reads a scalar row type as the column" {
    source = source_of("-- query: q() -> Int\nSELECT id FROM users;\n", [id_column()])

    assert String.contains(
        source,
        "    runtime.one(conn, \"q\", statement, fn row -> runtime.int(\"q\", row, 0))\n",
    )
}

test "an expression's column needs a type in an anonymous row" {
    n = #Column{name: "n", type_name: "", table: "", column: "", nullable: True}

    assert messages(
        problems_of("-- query: q()\nSELECT count(*) AS \"n\" FROM users;\n", [Ok([n])])
    ) == [
        "SQLite reports no type for the column `n` of `q`: it is an expression",
    ]

    typed = source_of("-- query: q()\nSELECT count(*) AS \"n!: Int\" FROM users;\n", [n])
    assert String.contains(typed, "n: runtime.value<Int>(\"q\", row, 0)?,")
}

test "a CAST to DECIMAL(p, s) reads the expression at its scale" {
    sum = #Column{name: "n", type_name: "DECIMAL(12, 2)", table: "", column: "", nullable: False}

    source = source_of(
        "-- query: q()\nSELECT CAST(sum(id) AS DECIMAL(12, 2)) AS \"n\" FROM users;\n",
        [sum],
    )

    assert String.contains(source, "n: runtime.numeric_scaled<Decimal>(\"q\", row, 0, 2)?,")
}

test "a type no import gives is a problem, and `-- import:` gives one" {
    problems = problems_of(
        "-- query: q(r: Report) -> Int\nSELECT id FROM users WHERE id = @r;\n",
        [Ok([id_column()])],
    )

    assert messages(problems) == ["`Report` is not a type of the schema, the prelude or std"]
    assert places(problems) == [#(1, 13)]

    source = source_of(
        "-- import: shop.Report\n-- query: q(r: Report) -> Int\nSELECT id FROM users WHERE id = @r;\n",
        [id_column()],
    )

    assert String.contains(source, "\n    shop.Report\n")
}

test "a long signature and long SQL are laid out as the formatter lays them out" {
    text = "-- query: a_query_with_a_long_name(first_parameter: String, second_parameter: Int) -> Int\nSELECT id FROM users WHERE name = @first_parameter AND id = @second_parameter AND id > 0;\n"
    source = source_of(text, [id_column()])

    assert String.contains(
        source,
        "pub fn a_query_with_a_long_name(\n    conn: sql.Conn,\n    first_parameter: String,\n    second_parameter: Int,\n) -> Result<Int, sql.Error> {\n    statement = runtime.statement(\n        [\"SELECT id FROM users WHERE name = \", \" AND id = \", \" AND id > 0\"],\n        [runtime.bind(first_parameter), runtime.bind(second_parameter)],\n    )\n",
    )

    assert String.contains(
        source,
        "    runtime.one(conn, \"a_query_with_a_long_name\", statement, fn row -> {\n        runtime.int(\"a_query_with_a_long_name\", row, 0)\n    })\n",
    )
}

test "an import entry names its module and what it imports" {
    assert codegen.entry("shop.Report") == #("shop", ["Report"])
    assert codegen.entry("std/calendar.{Date, Time}") == #("std/calendar", ["Date", "Time"])
    assert codegen.entry("reports/monthly") == #("reports/monthly", ["self"])
}

// --- the schema ----------------------------------------------------------
fn many_tables() -> List<Table> {
    table = fn name: String, columns: List<TableColumn> -> {
        #Table{name, migration: "db/migrations/1.sql", line: 1, columns}
    }

    [
        table("categories", [column("id", "INTEGER", False, [])]),
        table("order_items", [column("kind", "TEXT", False, ["gift", "sale"])]),
        table("people", [column("status", "TEXT", False, ["active", "gone"])]),
    ]
}

fn named(tables: Map<String, String>) -> Database {
    #{..databases.defaults("main"), tables}
}

fn schema_source(db: Database) -> String {
    case schema_with(db, many_tables()) {
        Ok(s) ->
            codegen.schema_file(s, [#("db/migrations/1.sql", "CREATE TABLE t (n INT);\n")], "ab12")

        Err(ps) ->
            "${messages(ps)}"
    }
}

test "a table's row struct is its name in the singular, and its enums take that name" {
    source = schema_source(databases.defaults("main"))
    assert String.contains(source, "pub struct Category {")
    assert String.contains(source, "pub struct OrderItem {")
    assert String.contains(source, "pub struct People {")
    assert String.contains(source, "pub enum OrderItemKind {")
    assert String.contains(source, "pub enum PeopleStatus {")
    refute String.contains(source, "struct Categories")

    assert String.contains(
        source,
        "pub once migrations: List<sqlkit.Migration> = [\n    #sqlkit.Migration{\n        path: \"db/migrations/1.sql\",\n        sql: \"CREATE TABLE t (n INT);\\n\",\n    },\n]\n",
    )
}

test "nomi.toml names a table's row struct, and its enums follow" {
    source = schema_source(named(%{"people" => "Person"}))
    assert String.contains(source, "pub struct Person {")
    assert String.contains(source, "pub enum PersonStatus {")
    refute String.contains(source, "People")
}

test "row names in nomi.toml that are not type names, name no table or clash are problems" {
    problems = fn tables: Map<String, String> -> {
        case schema_with(named(tables), many_tables()) {
            Ok(_) -> []
            Err(ps) -> messages(ps)
        }
    }

    assert problems(%{"people" => "person"}) == [
        "`[sqlkit.database.main.tables]` names the row of `people` `person`, which is not a type's name",
    ]

    assert problems(%{"people" => "Category"}) == [
        "the tables `categories` and `people` both have the row struct `Category`",
    ]

    assert problems(%{"peple" => "Person"}) == [
        "`[sqlkit.database.main.tables]` names the table `peple`, which the migrations do not create",
    ]
}

test "with no database table, the module has `main` with the defaults" {
    assert databases.read(Json.Null) == [databases.defaults("main")]
    assert databases.out_file(databases.defaults("main"), "schema") == "schema.nomi"
}

// --- the inputs and the freshness test -----------------------------------
test "the digest of the inputs is SHA-256 over each path and text" {
    one = [#Input{path: "db/migrations/1.sql", text: "CREATE TABLE t (n INTEGER);\n"}]

    // `printf 'db/migrations/1.sql\0CREATE TABLE t (n INTEGER);\n\0' | sha256sum`
    assert inputs.digest(one) == "10b41abfbb8505e08365c73cb420fbef7b05342a9da3a44c37972f372f61c14e"

    assert inputs.digest(one) != inputs.digest(
        [#Input{path: "db/migrations/2.sql", text: "CREATE TABLE t (n INTEGER);\n"}]
    )
}

test "the inputs are the `.sql` files of the two directories, in name order" {
    files = %{
        "db/migrations/2_b.sql" => "B",
        "db/migrations/1_a.sql" => "A",
        "db/migrations/notes.txt" => "not SQL",
        "db/queries/users.sql" => "Q",
    }

    ran = fs_testing.run(#Sandbox{files}, fn -> {
        m = inputs.read("db/migrations")?
        q = inputs.read("db/queries")?

        Ok(
            #(
                m |> Iter.map(fn i -> i.path) |> Iter.to_list(),
                inputs.current("db/migrations", "db/queries")?,
                inputs.digest(m + q),
            )
        )
    })

    case ran.value {
        Ok(#(paths, current, digest)) -> {
            assert paths == ["db/migrations/1_a.sql", "db/migrations/2_b.sql"]
            assert current == digest
        }

        Err(e) ->
            return Err(e)
    }
}

test "a generated file's header records the digest, and the test compares it" {
    db = databases.defaults("main")
    test_source = codegen.test_file(db, "ab12")
    assert codegen.recorded(test_source) == Some("ab12")

    assert String.contains(
        test_source,
        "    assert inputs.current(\"db/migrations\", \"db/queries\")\n        == Ok(\"ab12\")\n",
    )

    assert codegen.recorded("import sqlkit\n") == None
}

// --- the runtime ---------------------------------------------------------
// A fake connection whose every query answers rows of one column `n`.
fn numbers(values: List<Value>) -> Fake {
    Fake.new(
        answer: fn statement, _ -> {
            query = "${statement}"

            Ok(
                values
                |> Iter.map(fn v -> Row.new(query, [#("n", v)]))
                |> Iter.to_list()
            )
        }
    )
}

fn n_rows(conn: Conn) -> Rows<Int> {
    runtime.rows(conn, "n_rows", Sql"SELECT n FROM t", fn row -> runtime.int("n_rows", row, 0))
}

test "Rows.fold folds each row in order" {
    rows = n_rows(numbers([Value.Int(1), Value.Int(2), Value.Int(3)]))
    assert Rows.fold(rows, [], fn acc, n -> acc + [n]) == Ok([1, 2, 3])
    assert Rows.to_list(rows) == Ok([1, 2, 3])
}

test "a row that does not decode stops Rows.fold with its error" {
    rows = n_rows(numbers([Value.Int(1), Value.Text("two"), Value.Int(3)]))

    assert Rows.fold(rows, 0, fn acc, n -> acc + n)
        == Err(#sql.Error.Decode{query: "n_rows", column: "n", expected: "Int", found: "Text"})
}

test "a NULL in a column asserted never NULL names the query and the column" {
    conn = numbers([Value.Null])

    rows = runtime.list(conn, "totals", Sql"SELECT n FROM t", fn row -> {
        runtime.int<Int>("totals", row, 0)
    })

    assert rows == Err(#sql.Error.UnexpectedNull{query: "totals", column: "n"})
}

test "an expression's number reads as a wider number type" {
    conn = numbers([Value.Int(30), Value.Float(2.5)])

    rows = runtime.list(conn, "sums", Sql"SELECT n FROM t", fn row -> {
        runtime.value<Decimal>("sums", row, 0)
    })

    assert rows == Ok([30d, 2.5d])
}

test "a float that is not exactly a short decimal is not read as one" {
    conn = numbers([Value.Float(0.1 + 0.2)])

    rows = runtime.list(conn, "sums", Sql"SELECT n FROM t", fn row -> {
        runtime.value<Decimal>("sums", row, 0)
    })

    assert Result.is_err(rows)
}

// The text of each Decimal read at scale 2, or the error's message.
fn at_scale_2(values: List<Value>) -> List<String> {
    values
    |> Iter.map(fn v -> {
        row = Row.new("SELECT n", [#("n", v)])

        case runtime.numeric_scaled<Decimal>("sums", row, 0, 2) {
            Ok(d) -> "${d}"
            Err(#sql.Error.Database{code: "sqlkit", message}) -> message
            Err(e) -> "${e}"
        }
    })
    |> Iter.to_list()
}

test "a DECIMAL(p, s) column reads at its scale, exactly or not at all" {
    assert at_scale_2(
        [Value.Float(12.5), Value.Int(7), Value.Decimal(0.1d), Value.Float(-3.05)]
    ) == [
        "12.50",
        "7.00",
        "0.10",
        "-3.05",
    ]

    assert at_scale_2([Value.Float(0.1 + 0.2)]) == [
        "the column `n` of `sums`, read at scale 2, holds the float 0.30000000000000004, which is not exactly a decimal of that scale and at most 15 digits: SQLite computes with DECIMAL values as 64-bit floats; keep amounts you add up in SQL as INTEGER minor units (cents) to add them exactly",
    ]

    assert at_scale_2([Value.Decimal(12.555d), Value.Int(9_007_199_254_740_993)]) == [
        "the column `n` of `sums`, read at scale 2, holds 12.555, which has more decimals than that",
        "the column `n` of `sums`, read at scale 2, holds 9007199254740993, of 18 digits at that scale, more than the 15 SQLite keeps exactly",
    ]

    assert at_scale_2([Value.Float(90_071_992_547_409.94)])
        |> Iter.all(fn m -> {
            String.contains(m, "not exactly a decimal")
        })

    null_row = Row.new("SELECT n", [#("n", Value.Null)])
    assert runtime.numeric_scaled_null<Decimal>("sums", null_row, 0, 2) == Ok(None)
}

test "one and optional count the rows" {
    two = numbers([Value.Int(1), Value.Int(2)])
    none = numbers([])
    read = fn row: Row -> runtime.int<Int>("q", row, 0)

    assert runtime.one(two, "q", Sql"SELECT n", read)
        == Err(#sql.Error.RowCount{query: "q", expected: "exactly one", found: 2})

    assert runtime.optional(none, "q", Sql"SELECT n", read) == Ok(None)

    assert runtime.optional(two, "q", Sql"SELECT n", read)
        == Err(#sql.Error.RowCount{query: "q", expected: "at most one", found: 2})
}

// --- migrations ----------------------------------------------------------
test "migrate runs each migration in order, each in a transaction with its record" {
    fake = Fake.new()

    migrations = [
        #Migration{path: "db/migrations/1.sql", sql: "CREATE TABLE a (n INTEGER)"},
        #Migration{path: "db/migrations/2.sql", sql: "CREATE TABLE b (n INTEGER)"},
    ]

    assert sqlkit.migrate(fake, migrations) == Ok(Unit)

    assert Fake.log(fake) == [
        "CREATE TABLE IF NOT EXISTS nomi_migrations (version TEXT PRIMARY KEY, checksum TEXT NOT NULL, applied_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP)",
        "SELECT version, checksum FROM nomi_migrations",
        "BEGIN",
        "CREATE TABLE a (n INTEGER)",
        "INSERT INTO nomi_migrations (version, checksum) VALUES (?1, ?2)",
        "COMMIT",
        "BEGIN",
        "CREATE TABLE b (n INTEGER)",
        "INSERT INTO nomi_migrations (version, checksum) VALUES (?1, ?2)",
        "COMMIT",
    ]

    inserted =
        Fake.statements(fake)
        |> Iter.filter(fn s -> String.starts_with("${s}", "INSERT"))
        |> Iter.map(fn s -> s.params)
        |> Iter.to_list()

    assert inserted == [
        [Value.Text("1.sql"), Value.Text(checksum.of("CREATE TABLE a (n INTEGER)"))],
        [Value.Text("2.sql"), Value.Text(checksum.of("CREATE TABLE b (n INTEGER)"))],
    ]
}

fn temp_dir() -> Result<String, String> go testside.TempDir

fn remove_all(path: String) -> Result<Unit, String> go testside.RemoveAll

fn remove_quietly(path: String) {
    _ = remove_all(path)
}

// Opens the database file at path, migrates it, and closes it.
fn migrate_file(path: String, migrations: List<Migration>) -> Result<Unit, sql.Error> {
    sql.with_connection(fn -> sqlite.open(path), fn db -> sqlkit.migrate(db, migrations))
}

fn applied(path: String) -> Result<List<String>, sql.Error> {
    sql.with_connection(fn -> sqlite.open(path), fn db -> {
        rows = Conn.query(db, Sql"SELECT version FROM nomi_migrations ORDER BY version")?
        rows |> Iter.map(fn row -> Row.get<String>(row, "version")) |> Result.collect()
    })
}

test "migrate runs only the migrations a database file has not run, and refuses a changed one" {
    dir = temp_dir() |> Result.map_err(fn e -> #sql.Error.Connection{message: e})?
    defer remove_quietly(dir)
    path = "${dir}/shop.db"

    users = #Migration{
        path: "db/migrations/1_users.sql",
        sql: "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT)",
    }

    assert migrate_file(path, [users]) == Ok(Unit)

    // A second run on the same file finds the table and runs nothing.
    assert migrate_file(path, [users]) == Ok(Unit)
    assert applied(path) == Ok(["1_users.sql"])

    orders = #Migration{
        path: "db/migrations/2_orders.sql",
        sql: "CREATE TABLE orders (id INTEGER PRIMARY KEY)",
    }

    assert migrate_file(path, [users, orders]) == Ok(Unit)
    assert applied(path) == Ok(["1_users.sql", "2_orders.sql"])

    renamed = #{..users, sql: "CREATE TABLE users (id INTEGER PRIMARY KEY, mail TEXT)"}
    later = #Migration{path: "db/migrations/3_later.sql", sql: "CREATE TABLE later (n INTEGER)"}

    assert migrate_file(path, [renamed, orders, later]) == Err(
        #sql.Error.Database{
            code: "sqlkit",
            message: "the migration `db/migrations/1_users.sql` changed after it was applied: its checksum is not the one `nomi_migrations` recorded; leave an applied migration as it is and write the change as a new one",
        }
    )

    // Nothing ran: the refusal comes before every migration.
    assert applied(path) == Ok(["1_users.sql", "2_orders.sql"])
}
