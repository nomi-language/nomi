//# Checked SQL. `nomi tool sqlkit generate` reads a module's migrations
//# and its query files, asks SQLite to describe each query, and writes
//# ordinary Nomi files: the schema (a row struct per table, named in the
//# singular, an enum per `CHECK (column IN (...))` column, and the
//# migrations as data) and a function per query that runs its SQL on a
//# `Conn` and answers typed rows. This file holds what the generated code
//# and its callers use: `Rows<T>`, `Changed`, `Migration` and `migrate`,
//# and the SQL type families.
//#
//# A Nomi type is read from, or bound to, a column of a SQL type family when
//# it implements that family's interface (`SqlInt`, `SqlText`, ...), and
//# std/sql's `FromSql` and `ToSql`. sqlkit implements them for std's types;
//# implement them for a type of your own (`type Email String`) to read a
//# `TEXT` column as it.

import {
    std/calendar.{Date, NaiveDateTime, Time}
    std/channels.{Channel, Receiver, Sender}
    std/instant.Instant
    std/json.Json
    std/sql.{self, Conn, Row, Sql, Statement}
    std/uuid.Uuid
    checksum
}

/// The rows of a `-> Rows<T>` query, read one at a time with `Rows.fold`.
/// The query runs each time the rows are folded.
pub opaque struct Rows<T> {
    conn: Conn
    query: String
    statement: Statement
    decode: (Row) -> Result<T, sql.Error>
}

impl Rows<T> {
    /// The rows `statement` reads on `conn`, each read by `decode`: what a
    /// generated `-> Rows<T>` function answers. `query` is the query's
    /// name, which its errors carry.
    pub fn new(
        conn: Conn,
        query: String,
        statement: Statement,
        decode: (Row) -> Result<T, sql.Error>,
    ) -> Rows<T> {
        #Rows{conn, query, statement, decode}
    }

    /// Run the query and fold its rows into `initial` with `f`, in order,
    /// one row at a time: the rows are never all in memory. A row that does
    /// not decode stops the fold with its error, and so does the database.
    pub fn fold<A>(rows: Rows<T>, initial: A, f: (A, T) -> A) -> Result<A, sql.Error> {
        // each_row's callback answers only whether to go on, so the
        // accumulator waits in a channel between rows.
        state: Channel<Result<A, sql.Error>> = Channel.buffered(1)
        _ = Sender.send(state.sender, Ok(initial))

        ran = Conn.each_row(rows.conn, rows.statement, fn row -> {
            case Receiver.receive(state.receiver) {
                Some(Ok(acc)) ->
                    case rows.decode(row) {
                        Ok(item) -> {
                            _ = Sender.send(state.sender, Ok(f(acc, item)))
                            True
                        }

                        Err(e) -> {
                            _ = Sender.send(state.sender, Err(e))
                            False
                        }
                    }

                Some(Err(e)) -> {
                    _ = Sender.send(state.sender, Err(e))
                    False
                }

                None ->
                    False
            }
        })

        Sender.close(state.sender)
        try ran

        case Receiver.receive(state.receiver) {
            Some(result) -> result
            None -> Err(#sql.Error.Database{code: "", message: "Rows.fold lost its state"})
        }
    }

    /// Every row, in order: `Rows.fold` into a list.
    pub fn to_list(rows: Rows<T>) -> Result<List<T>, sql.Error> {
        Rows.fold(rows, [], fn acc, item -> [item, ..acc]) |> Result.map(Iter.reverse)
    }
}

/// What a query whose SQL returns no rows answers when it declares
/// `-> Changed`: the number of rows the statement changed. It is a type of
/// its own, not an `Int`, so SQL that stops returning rows (an `INSERT`
/// that loses its `RETURNING id`) fails to check rather than answer a count
/// where a value was meant.
pub struct Changed {
    rows: Int
}

derive Equatable for Changed

/// One migration: its path from the module root and its SQL. The generated
/// schema file holds `migrations`, a list of them in name order.
pub struct Migration {
    path: String
    sql: String
}

derive Equatable for Migration

/// Bring `conn`'s database up to date with `migrations`: run each one it
/// has not run yet, in order, each in a transaction of its own with its
/// record. The records are the table `nomi_migrations` (`version`, the
/// migration's file name; `checksum`, of its text; `applied_at`), which
/// the first run creates, so `migrate` works on a fresh database (what a
/// test builds) and on one that lives on. A migration whose text changed
/// after it ran is refused, before anything runs, with
/// `Error.Database{code: "sqlkit"}` naming its file: write the change as a
/// new migration.
pub fn migrate(conn: Conn, migrations: List<Migration>) -> Result<Unit, sql.Error> {
    _ = try Conn.exec(
        conn,
        Sql"CREATE TABLE IF NOT EXISTS nomi_migrations (version TEXT PRIMARY KEY, checksum TEXT NOT NULL, applied_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP)",
    )

    rows = try Conn.query(conn, Sql"SELECT version, checksum FROM nomi_migrations")

    records =
        rows
        |> Iter.map(fn row -> {
            version = try Row.get<String>(row, "version")
            sum = try Row.get<String>(row, "checksum")
            Ok(#(version, sum))
        })
        |> Result.collect()

    applied = (try records) |> Iter.to_map()

    changed = Iter.find(migrations, fn m -> {
        case Map.get(applied, version_of(m)) {
            Some(sum) -> sum != checksum.of(m.sql)
            None -> False
        }
    })

    case changed {
        Some(m) ->
            return Err(
                #sql.Error.Database{
                    code: "sqlkit",
                    message: "the migration `${m.path}` changed after it was applied: its checksum is not the one `nomi_migrations` recorded; leave an applied migration as it is and write the change as a new one",
                }
            )

        None -> {}
    }

    pending =
        migrations
        |> Iter.filter(fn m -> Maybe.none?(Map.get(applied, version_of(m))))
        |> Iter.to_list()

    apply_each(conn, pending)
}

// Run each migration in its own transaction with its record.
fn apply_each(conn: Conn, migrations: List<Migration>) -> Result<Unit, sql.Error> {
    case migrations {
        [] ->
            Ok(Unit)

        [first, ..rest] -> {
            try sql.transaction(conn, fn tx -> {
                _ = try Conn.exec(tx, #Statement{parts: [first.sql], params: []})
                version = version_of(first)
                sum = checksum.of(first.sql)

                _ = try Conn.exec(
                    tx,
                    Sql"INSERT INTO nomi_migrations (version, checksum) VALUES (${version}, ${sum})",
                )

                Ok(Unit)
            })

            apply_each(conn, rest)
        }
    }
}

// A migration's version: its file name, which the order of the migrations
// goes by.
fn version_of(migration: Migration) -> String {
    String.split(migration.path, "/") |> Iter.last() |> Maybe.with_default(migration.path)
}

/// A type read from, or bound to, an integer column (`INTEGER`).
pub interface SqlInt {}

/// A type read from, or bound to, a floating-point column (`REAL`).
pub interface SqlFloat {}

/// A type read from, or bound to, an exact decimal column (`DECIMAL`,
/// `NUMERIC`).
pub interface SqlNumeric {}

/// A type read from, or bound to, a text column (`TEXT`, `VARCHAR`).
pub interface SqlText {}

/// A type read from, or bound to, a boolean column (`BOOLEAN`).
pub interface SqlBool {}

/// A type read from, or bound to, a binary column (`BLOB`).
pub interface SqlBytes {}

/// A type read from, or bound to, a date column (`DATE`).
pub interface SqlDate {}

/// A type read from, or bound to, a time-of-day column (`TIME`).
pub interface SqlTime {}

/// A type read from, or bound to, a timestamp without a zone
/// (`DATETIME`, `TIMESTAMP`).
pub interface SqlTimestamp {}

/// A type read from, or bound to, a timestamp with a zone
/// (`TIMESTAMPTZ`).
pub interface SqlTimestamptz {}

/// A type read from, or bound to, a UUID column (`UUID`).
pub interface SqlUuid {}

/// A type read from, or bound to, a JSON column (`JSON`).
pub interface SqlJson {}

impl SqlInt for Int

impl SqlFloat for Float

impl SqlNumeric for Decimal

impl SqlText for String

impl SqlBool for Bool

impl SqlBytes for Bytes

impl SqlDate for Date

impl SqlTime for Time

impl SqlTimestamp for NaiveDateTime

impl SqlTimestamptz for Instant

impl SqlUuid for Uuid

impl SqlJson for Json
