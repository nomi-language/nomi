//# The `[sqlkit]` table of a module's `nomi.toml`: its databases, each a
//# `[sqlkit.database.<name>]` table.
//#
//#     [sqlkit.database.main]
//#     migrations = "db/migrations"   # SQL files, applied in name order
//#     queries = "db/queries"         # the query files, `*.sql`
//#     out = "."                      # where the generated files go
//#     schema = "schema"              # the generated schema file's name
//#
//#     [sqlkit.database.main.tables]
//#     people = "Person"              # a table's row struct, when the rule misses
//#
//# Every key may be left out: those are the defaults, and each table's
//# row struct is its name made singular (`users` is `User`). A module with
//# no `[sqlkit.database]` table has one database, `main`, with the
//# defaults.

import {
    std/json.Json
    sqltext
}

/// One database of the module.
pub struct Database {
    name: String
    migrations: String
    queries: String
    out: String
    schema: String

    /// The row struct of each table whose name the `tables` table gives,
    /// by table.
    tables: Map<String, String>
}

derive Equatable for Database

/// The databases a `[sqlkit]` table, as `Json`, declares, by name; with
/// none, `main` with the defaults.
//! c =
//!     Json.decode(
//!         "{\"database\":{\"main\":{\"queries\":\"sql\",\"tables\":{\"people\":\"Person\"}}}}"
//!     )
//!     |> Result.with_default(Json.Null)
//!
//! assert databases.read(c) == [
//!     #Database{
//!         name: "main",
//!         migrations: "db/migrations",
//!         queries: "sql",
//!         out: ".",
//!         schema: "schema",
//!         tables: %{"people" => "Person"},
//!     },
//! ]
//!
//! assert databases.read(Json.Null) == [databases.defaults("main")]
//
pub fn read(config: Json) -> List<Database> {
    tables = case field(config, "database") {
        Some(Json.Obj(tables)) -> tables
        _ -> %{}
    }

    if Map.size(tables) == 0 {
        return [defaults("main")]
    }

    tables
    |> Map.keys()
    |> Iter.sort()
    |> Iter.map(fn name -> {
        table = Map.get(tables, name) |> Maybe.with_default(Json.Null)
        d = defaults(name)

        #Database{
            name,
            migrations: text(table, "migrations") |> Maybe.with_default(d.migrations),
            queries: text(table, "queries") |> Maybe.with_default(d.queries),
            out: text(table, "out") |> Maybe.with_default(d.out),
            schema: text(table, "schema") |> Maybe.with_default(d.schema),
            tables: text_map(table, "tables"),
        }
    })
    |> Iter.to_list()
}

/// The database `name` with every key left out.
//! assert databases.defaults("main").queries == "db/queries"
//
pub fn defaults(name: String) -> Database {
    #Database{
        name,
        migrations: "db/migrations",
        queries: "db/queries",
        out: ".",
        schema: "schema",
        tables: %{},
    }
}

/// The path from the module root of the generated file `name` (without
/// `.nomi`) of db.
//! assert databases.out_file(databases.defaults("main"), "schema") == "schema.nomi"
//! assert databases.out_file(#{..databases.defaults("main"), out: "src/db/"}, "q") == "src/db/q.nomi"
//
pub fn out_file(db: Database, name: String) -> String {
    "${module_of(db, name)}.nomi"
}

/// The import path, from the module root, of the generated file `name`.
pub fn module_of(db: Database, name: String) -> String {
    dir = sqltext.cut_suffix(db.out, "/")

    if dir == "" or dir == "." {
        name
    } else {
        "${sqltext.cut_prefix(dir, "./")}/${name}"
    }
}

fn field(json: Json, key: String) -> Maybe<Json> {
    case json {
        Json.Obj(fields) -> Map.get(fields, key)
        _ -> None
    }
}

fn text(json: Json, key: String) -> Maybe<String> {
    case field(json, key) {
        Some(Json.String(s)) -> Some(s)
        _ -> None
    }
}

fn text_map(json: Json, key: String) -> Map<String, String> {
    case field(json, key) {
        Some(Json.Obj(entries)) ->
            entries
            |> Map.keys()
            |> Iter.flat_map(fn k -> {
                case Map.get(entries, k) {
                    Some(Json.String(s)) -> [#(k, s)]
                    _ -> []
                }
            })
            |> Iter.to_map()

        _ ->
            %{}
    }
}
