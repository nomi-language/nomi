//# Reading a query's SQL without parsing SQL: a tokenizer that knows
//# strings, quoted names, comments and `@name` parameters, and what is read
//# from its tokens. `nomi tool sqlkit generate` describes the SQL these
//# functions write, and the function it generates sends the same SQL.

/// What a token is.
pub enum Kind
    /// A name, a keyword or a number.
    Word

    /// A quoted name, `"order_count!"`.
    Quoted

    /// A string literal, `'paid'`.
    Text

    /// A parameter, `@user_id`.
    Param

    /// A `${...}` in the SQL. A query's SQL has no interpolation, so it is
    /// an error that suggests `@name`.
    Interpolation

    /// Whitespace or a comment.
    Space

    /// Any other character.
    Punct
end

derive Equatable for Kind

/// One token: its kind, its text as written, and where it is in the SQL,
/// by grapheme from the start.
pub struct Token
    kind: Kind
    text: String
    start: Int
    stop: Int
end

derive Equatable for Token

/// The tokens of `text`.
//! tokens = sqltext.tokens("SELECT 'a b' -- c\n, @x")
//! kinds = tokens |> Iter.map(fn t -> t.kind) |> Iter.to_list()
//!
//! // The comment is a space token of its own, and so is the newline after it.
//! assert kinds == [
//!     Kind.Word,
//!     Kind.Space,
//!     Kind.Text,
//!     Kind.Space,
//!     Kind.Space,
//!     Kind.Space,
//!     Kind.Punct,
//!     Kind.Space,
//!     Kind.Param,
//! ]
//
pub fn tokens(text: String) -> List<Token>
    chars = Iter.to_vector(text)
    scan(text, chars, 0, [])
end

fn scan(text: String, chars: Vector<String>, i: Int, acc: List<Token>) -> List<Token>
    case Vector.get(chars, i)
        None ->
            Iter.reverse(acc)

        Some(c) ->
            (kind, stop) = token_at(chars, i, c)
            token = Token{kind:, text: String.slice(text, i, stop), start: i, stop:}
            scan(text, chars, stop, [token, ..acc])
    end
end

fn at(chars: Vector<String>, i: Int) -> String
    Vector.get(chars, i) |> Maybe.with_default("")
end

fn token_at(chars: Vector<String>, i: Int, c: String) -> (Kind, Int)
    next = at(chars, i + 1)

    if is_space(c) then
        (Kind.Space, skip(chars, i + 1, is_space))
    else if c == "-" and next == "-" then
        (Kind.Space, skip(chars, i + 2, fn ch -> ch != "\n" and ch != "\r\n"))
    else if c == "/" and next == "*" then
        (Kind.Space, block_end(chars, i + 2))
    else if c == "'" then
        (Kind.Text, quote_end(chars, i + 1, "'"))
    else if c == "\"" then
        (Kind.Quoted, quote_end(chars, i + 1, "\""))
    else if c == "@" and is_name_start(next) then
        (Kind.Param, skip(chars, i + 2, is_word))
    else if c == "@" and next == "@" then
        // Postgres's `@@` is an operator, so `@@name` is not a parameter.
        (Kind.Punct, i + 2)
    else if c == "$" and next == "{" then
        close = skip(chars, i + 2, fn ch -> ch != "}")
        (Kind.Interpolation, Int.min(close + 1, Vector.length(chars)))
    else if is_word(c) then
        (Kind.Word, skip(chars, i + 1, is_word))
    else
        (Kind.Punct, i + 1)
    end
end

fn is_space(c: String) -> Bool
    c == " " or c == "\n" or c == "\t" or c == "\r\n" or c == "\r"
end

fn is_word(c: String) -> Bool
    c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_" and c != ""
end

fn is_name_start(c: String) -> Bool
    c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" and c != ""
end

fn skip(chars: Vector<String>, i: Int, keep: (String) -> Bool) -> Int
    case Vector.get(chars, i)
        Some(c) when keep(c) -> skip(chars, i + 1, keep)
        _ -> i
    end
end

fn block_end(chars: Vector<String>, i: Int) -> Int
    case Vector.get(chars, i)
        None -> i
        Some("*") when at(chars, i + 1) == "/" -> i + 2
        Some(_) -> block_end(chars, i + 1)
    end
end

// The end of a quoted run whose opening quote is before i; a doubled
// quote is the quote itself.
fn quote_end(chars: Vector<String>, i: Int, quote: String) -> Int
    case Vector.get(chars, i)
        None -> i
        Some(c) when c == quote and at(chars, i + 1) == quote -> quote_end(chars, i + 2, quote)
        Some(c) when c == quote -> i + 1
        Some(_) -> quote_end(chars, i + 1, quote)
    end
end

/// The name a parameter, `@user_id`, holds.
//! assert sqltext.marker_name("@user_id") == "user_id"
//
pub fn marker_name(text: String) -> String
    cut_prefix(text, "@")
end

/// A result column's name override in its quoted alias, as sqlx writes
/// them: `"name!"` asserts the column is never NULL, `"name?"` that it may
/// be, and `"name: Type"` (or `"name!: Type"`) gives its Nomi type.
pub struct Override
    column: String
    nullable: Maybe<Bool>
    type_text: Maybe<String>
    token: Token
end

/// The override a quoted name holds, if it holds one.
//! t = Token{kind: Kind.Quoted, text: "\"n!: Int\"", start: 0, stop: 9}
//! o = sqltext.override(t)
//!
//! assert o |> Maybe.map(fn x -> (x.column, x.nullable, x.type_text)) == Some(
//!     ("n", Some(False), Some("Int"))
//! )
//!
//! assert sqltext.override({..t, text: "\"n\""}) == None
//
pub fn override(token: Token) -> Maybe<Override>
    if token.kind != Kind.Quoted then return None
    inner = token.text |> cut_prefix("\"") |> cut_suffix("\"")

    (head, type_text) = case String.split(inner, ":")
        [name, ty] -> (String.trim(name), Some(String.trim(ty)))
        _ -> (inner, None)
    end

    (column, nullable) = if String.ends_with(head, "!") then
        (cut_suffix(head, "!"), Some(False))
    else if String.ends_with(head, "?") then
        (cut_suffix(head, "?"), Some(True))
    else
        (head, None)
    end

    if nullable == None and type_text == None then
        None
    else
        Some(Override{column:, nullable:, type_text:, token:})
    end
end

/// Every override the SQL's quoted names hold.
pub fn overrides(tokens: List<Token>) -> List<Override>
    tokens |> Iter.flat_map(fn t -> override(t) |> listed()) |> Iter.to_list()
end

/// The text a token is sent as: a quoted name without its override.
fn sent(token: Token) -> String
    case override(token)
        Some(o) -> "\"${o.column}\""
        None -> token.text
    end
end

/// The SQL a query sends, as std::sql's `Statement` keeps it: the text
/// around each `@name` parameter, one more than there are parameters. Runs of
/// whitespace and comments become one space, and the ends are trimmed, so
/// the SQL does not depend on how it is indented.
//! tokens = sqltext.tokens("\n  SELECT id  -- the key\n  FROM t WHERE a = @a AND b = @b\n")
//! assert sqltext.parts(tokens) == ["SELECT id FROM t WHERE a = ", " AND b = ", ""]
//
pub fn parts(tokens: List<Token>) -> List<String>
    pieces = pieces(tokens)

    (done, current) = Iter.reduce(pieces, ([], ""), fn acc, piece ->
        (done, current) = acc
        (token, text) = piece

        if token.kind == Kind.Param then
            ([current, ..done], "")
        else
            (done, current + text)
        end
    end)

    Iter.reverse([current, ..done])
end

/// Each token that is sent and the text it is sent as: a space for a run
/// of spaces between other tokens, nothing at either end.
fn pieces(tokens: List<Token>) -> List<(Token, String)>
    solid = tokens |> Iter.filter(fn t -> t.kind != Kind.Space) |> Iter.to_list()

    (out, _) = Iter.reduce(tokens, ([], 0), fn acc: (List<(Token, String)>, Int), token ->
        (out, seen) = acc

        if token.kind == Kind.Space then
            // A space is sent once between two tokens that are sent.
            case out
                [(last, _), ..] when last.kind != Kind.Space and seen < Iter.count(solid) ->
                    ([(token, " "), ..out], seen)

                _ ->
                    acc
            end
        else
            ([(token, sent(token)), ..out], seen + 1)
        end
    end)

    Iter.reverse(out)
end

/// The SQL a query sends with its parameters written as `?1`, `?2`, ..., as
/// the SQLite driver writes them: what SQLite describes.
//! assert sqltext.sqlite_sql(["SELECT ", " + ", ""]) == "SELECT ?1 + ?2"
//
pub fn sqlite_sql(parts: List<String>) -> String
    numbered(parts, "?")
end

/// The SQL around the parameters with `$1`, `$2`, ... between the parts,
/// as the Postgres driver writes them: what Postgres describes. `$1` is as
/// wide as `?1`, so `token_at_offset` reads an offset in either.
//! assert sqltext.postgres_sql(["SELECT ", " + ", ""]) == "SELECT $1 + $2"
//
pub fn postgres_sql(parts: List<String>) -> String
    numbered(parts, "$")
end

fn numbered(parts: List<String>, mark: String) -> String
    parts
    |> Iter.with_index()
    |> Iter.map(fn (i, part) -> if i == 0 then part else "${mark}${i}" + part)
    |> String.join()
end

/// The token of the SQL `sqlite_sql` writes at byte `offset`: where an
/// error SQLite reports at that offset is in the query's SQL.
//! tokens = sqltext.tokens("SELECT  @x, nope")
//! assert sqltext.token_at_offset(tokens, 11) |> Maybe.map(fn t -> t.text) == Some("nope")
//
pub fn token_at_offset(tokens: List<Token>, offset: Int) -> Maybe<Token>
    (found, _, _) = Iter.reduce(pieces(tokens), (None, 0, 0), fn acc, piece ->
        (found, at, params) = acc
        (token, text) = piece

        (width, next_params) = if token.kind == Kind.Param then
            (byte_length("?${params + 1}"), params + 1)
        else
            (byte_length(text), params)
        end

        if found == None and offset < at + width and token.kind != Kind.Space then
            break (Some(token), at + width, next_params)
        end

        (found, at + width, next_params)
    end)

    case found
        Some(t) -> Some(t)
        None -> tokens |> Iter.filter(fn t -> t.kind != Kind.Space) |> Iter.last()
    end
end

fn byte_length(s: String) -> Int
    Bytes.length(String.to_bytes(s))
end

/// The `@name` parameters, in order.
pub fn markers(tokens: List<Token>) -> List<Token>
    tokens |> Iter.filter(fn t -> t.kind == Kind.Param) |> Iter.to_list()
end

/// The `${...}` in the SQL, in order.
pub fn interpolations(tokens: List<Token>) -> List<Token>
    tokens |> Iter.filter(fn t -> t.kind == Kind.Interpolation) |> Iter.to_list()
end

/// The result columns a query writes after its first `SELECT` (or its
/// `RETURNING`) at the top level, each as the tokens from its first to its
/// last, split at the commas outside parentheses. A `*` is one item, so
/// the list may be shorter than the columns.
//! tokens = sqltext.tokens("SELECT a, f(b, c) AS d FROM t")
//! items = sqltext.select_items(tokens) |> Iter.map(fn i -> sqltext.text_of(i)) |> Iter.to_list()
//! assert items == ["a", "f(b, c) AS d"]
//
pub fn select_items(tokens: List<Token>) -> List<List<Token>>
    (items, current, _, state) = Iter.reduce(tokens, ([], [], 0, 0), fn acc, token ->
        (items, current, depth, state) = acc

        upper = if token.kind == Kind.Word then String.uppercase(token.text) else ""

        case state
            // 0: before the list; 1: in it; 2: after it.
            0 ->
                if depth == 0 and (upper == "SELECT" or upper == "RETURNING") then
                    (items, [], depth, 1)
                else
                    (items, current, depth + nesting(token), 0)
                end

            1 ->
                if depth == 0 and ends_list(upper) then
                    break ([current, ..items], [], depth, 2)
                else if depth == 0 and token.text == "," and token.kind == Kind.Punct then
                    ([current, ..items], [], depth, 1)
                else if upper == "DISTINCT" and Iter.is_empty(solid(current)) then
                    (items, current, depth, 1)
                else
                    (items, [token, ..current], depth + nesting(token), 1)
                end

            _ ->
                acc
        end
    end)

    all = if state == 1 then [current, ..items] else items

    all
    |> Iter.reverse()
    |> Iter.map(fn item -> item |> Iter.reverse() |> trim())
    |> Iter.reject(&Iter.is_empty(&1))
    |> Iter.to_list()
end

fn nesting(token: Token) -> Int
    if token.kind != Kind.Punct then
        0
    else if token.text == "(" then
        1
    else if token.text == ")" then
        -1
    else
        0
    end
end

fn ends_list(upper: String) -> Bool
    Iter.contains(
        [
            "FROM",
            "WHERE",
            "GROUP",
            "ORDER",
            "LIMIT",
            "UNION",
            "EXCEPT",
            "INTERSECT",
            "WINDOW",
            "HAVING",
        ],
        upper,
    )
end

fn solid(tokens: List<Token>) -> List<Token>
    tokens |> Iter.filter(fn t -> t.kind != Kind.Space) |> Iter.to_list()
end

/// The tokens without the spaces at either end.
fn trim(tokens: List<Token>) -> List<Token>
    tokens
    |> Iter.drop_while(fn t -> t.kind == Kind.Space)
    |> Iter.reverse()
    |> Iter.drop_while(fn t -> t.kind == Kind.Space)
    |> Iter.reverse()
end

/// The type a select item casts its whole value to, as written:
/// `DECIMAL(12, 2)` of `CAST(sum(total) AS DECIMAL(12, 2)) AS revenue`. An
/// item that is not one `CAST`, with or without a name, has none.
//! cast = fn text: String ->
//!     sqltext.select_items(sqltext.tokens(text)) |> Iter.first() |> Maybe.flat_map(sqltext.cast_type)
//! end
//!
//! assert cast("SELECT CAST(sum(o.total) AS DECIMAL(12, 2)) AS \"revenue!\" FROM o")
//!     == Some("DECIMAL(12, 2)")
//!
//! assert cast("SELECT cast(x as numeric(5,1)) r FROM o") == Some("numeric(5,1)")
//! assert cast("SELECT CAST(x AS INTEGER) + 1 FROM o") == None
//! assert cast("SELECT total FROM o") == None
//
pub fn cast_type(item: List<Token>) -> Maybe<String>
    words = solid(item) |> Iter.to_vector()

    text_at = fn i: Int ->
        Vector.get(words, i)
        |> Maybe.map(fn t -> String.uppercase(t.text))
        |> Maybe.with_default("")
    end

    if text_at(0) != "CAST" or text_at(1) != "(" then return None

    // The closing parenthesis, and the last `AS` directly inside the cast.
    (close, as_at, _) = Iter.reduce(Iter.with_index(words)
    |> Iter.drop(2), (-1, -1, 1), fn acc, (i, t) ->
        (close, as_at, depth) = acc

        if close >= 0 then
            acc
        else
            after = depth + nesting(t)

            if after == 0 then
                (i, as_at, after)
            else if depth == 1 and String.uppercase(t.text) == "AS" and t.kind == Kind.Word then
                (close, i, after)
            else
                (close, as_at, after)
            end
        end
    end)

    rest = Vector.length(words) - close - 1

    named = rest == 0
        or (rest == 1 and text_at(close + 1) != "")
        or (rest == 2 and text_at(close + 1) == "AS")

    case (Vector.get(words, as_at), Vector.get(words, close))
        (Some(a), Some(c)) when as_at >= 0 and close > as_at + 1 and named ->
            inside =
                item
                |> Iter.filter(fn t -> t.start > a.start and t.start < c.start)
                |> Iter.to_list()

            Some(text_of(trim(inside)))

        _ ->
            None
    end
end

/// The text of a run of tokens, as written.
pub fn text_of(tokens: List<Token>) -> String
    tokens |> Iter.map(fn t -> t.text) |> String.join()
end

/// The tokens of the `FROM` and `JOIN` clauses that name a table, each
/// with the name it goes by in the query: `FROM orders o` is
/// `("orders", "o")`.
//! tokens = sqltext.tokens(
//!     "SELECT 1 FROM orders o LEFT JOIN users AS u ON u.id = o.user_id JOIN items"
//! )
//!
//! assert sqltext.table_names(tokens) == [("orders", "o"), ("users", "u"), ("items", "items")]
//
pub fn table_names(tokens: List<Token>) -> List<(String, String)>
    words = solid(tokens) |> Iter.to_vector()
    count = Vector.length(words)

    Iter.from(0)
    |> Iter.take(count)
    |> Iter.flat_map(fn i ->
        upper = String.uppercase(word_at(words, i))

        if upper == "FROM" or upper == "JOIN" then
            table = word_at(words, i + 1)
            next = word_at(words, i + 2)

            alias = if String.uppercase(next) == "AS" then
                word_at(words, i + 3)
            else if is_name(next) and not is_keyword(next) then
                next
            else
                table
            end

            if is_name(table) then [(table, alias)] else []
        else
            []
        end
    end)
    |> Iter.to_list()
end

fn word_at(words: Vector<Token>, i: Int) -> String
    case Vector.get(words, i)
        Some(t) when t.kind == Kind.Word -> t.text
        Some(t) when t.kind == Kind.Quoted -> t.text |> cut_prefix("\"") |> cut_suffix("\"")
        _ -> ""
    end
end

fn is_keyword(word: String) -> Bool
    Iter.contains(
        [
            "ON",
            "USING",
            "WHERE",
            "JOIN",
            "LEFT",
            "RIGHT",
            "FULL",
            "INNER",
            "OUTER",
            "CROSS",
            "NATURAL",
            "GROUP",
            "ORDER",
            "LIMIT",
            "UNION",
            "HAVING",
            "WINDOW",
            "EXCEPT",
            "INTERSECT",
        ],
        String.uppercase(word),
    )
end

/// Whether the SQL joins with `RIGHT` or `FULL`, whose left side may be
/// NULL, which sqlkit does not track table by table.
pub fn is_right_or_full_join(tokens: List<Token>) -> Bool
    Iter.any_match(tokens, fn t ->
        t.kind == Kind.Word
            and (String.uppercase(t.text) == "RIGHT" or String.uppercase(t.text) == "FULL")
    end)
end

/// The tables of `tables`, a SQLite schema's, that an outer join of a
/// query may leave out, from the `LEFT-JOIN` lines of its plan; `None`
/// when any table may be left out. That is so for a `RIGHT` or `FULL`
/// join, and for a `LEFT-JOIN` line that names no table of the query's own
/// `FROM` and `JOIN` clauses: SQLite plans a view, a subquery or a CTE
/// into the query, so the line names an alias written inside it, or the
/// view, and a column it leaves out reads a table under it.
//! plan = [
//!     "SCAN u USING COVERING INDEX sqlite_autoindex_users_1",
//!     "SEARCH o USING AUTOMATIC COVERING INDEX (user_id=?) LEFT-JOIN",
//! ]
//!
//! direct = sqltext.tokens("SELECT u.email, o.id FROM users u LEFT JOIN orders o ON o.user_id = u.id")
//! assert sqltext.outer_joined(direct, plan, ["orders", "users"]) == Some(["orders"])
//!
//! // `user_orders` is a view over the same LEFT JOIN.
//! view = sqltext.tokens("SELECT d.email, d.id FROM user_orders d")
//! assert sqltext.outer_joined(view, plan, ["orders", "users"]) == None
//
pub fn outer_joined(
    tokens: List<Token>,
    plan: List<String>,
    tables: List<String>,
) -> Maybe<List<String>>
    left =
        plan
        |> Iter.filter(fn line -> "LEFT-JOIN" in line)
        |> Iter.map(plan_alias)
        |> Iter.to_list()

    // Each FROM or JOIN of a table, with the table as the schema spells it.
    named =
        table_names(tokens)
        |> Iter.flat_map(fn (t, alias) ->
            Iter.find(tables, fn s -> String.lowercase(s) == String.lowercase(t))
            |> Maybe.map(fn s -> (s, alias))
            |> listed()
        end)
        |> Iter.to_list()

    known = Iter.all_match(left, fn a -> Iter.any_match(named, fn (_, alias) -> alias == a))

    if is_right_or_full_join(tokens) or not known then
        None
    else
        Some(
            named
            |> Iter.filter(fn (_, alias) -> Iter.contains(left, alias))
            |> Iter.map(fn (t, _) -> t)
            |> Iter.to_list()
        )
    end
end

// The table a plan line names: `SEARCH u USING ...` names `u`.
fn plan_alias(line: String) -> String
    case String.words(line) |> Iter.to_list()
        [_, name, ..] -> name
        _ -> ""
    end
end

/// Whether `word` can be a Nomi field name: lower case letters, digits
/// and `_`, not starting with a digit.
//! assert sqltext.is_name("order_count")
//! refute sqltext.is_name("count(*)")
//! refute sqltext.is_name("2x")
//
pub fn is_name(word: String) -> Bool
    first = String.slice(word, 0, 1)

    word != ""
        and not first in "0123456789"
        and Iter.all_match(word, fn c ->
            c in "abcdefghijklmnopqrstuvwxyz0123456789_"
        end)
end

/// `s` without `prefix`, or `s` when it does not start with it.
pub fn cut_prefix(s: String, prefix: String) -> String
    String.strip_prefix(s, prefix) |> Maybe.with_default(s)
end

/// `s` without `suffix`, or `s` when it does not end with it.
pub fn cut_suffix(s: String, suffix: String) -> String
    String.strip_suffix(s, suffix) |> Maybe.with_default(s)
end

/// The value a `Maybe` holds, as a list of none or one.
pub fn listed<T>(m: Maybe<T>) -> List<T>
    case m
        Some(v) -> [v]
        None -> []
    end
end

/// The line, counting from 0, and the text before it on that line, of
/// grapheme `index` of `text`: where a token is in its query file.
//! assert sqltext.position("ab\ncd", 4) == (1, "c")
//
pub fn position(text: String, index: Int) -> (Int, String)
    before = String.slice(text, 0, index)
    lines = String.split(before, "\n")
    (Iter.count(lines) - 1, Iter.last(lines) |> Maybe.with_default(""))
end
