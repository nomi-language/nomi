//# Images: decode JPEG, PNG and WebP, resize, crop, and encode JPEG and
//# PNG. `image.decode(bytes)` returns an `Image`; `Image.fit` scales one
//# down into a box keeping its shape; `Image.encode_jpeg` and
//# `Image.encode_png` return the bytes of a file.
//#
//# Decoding refuses an image whose header declares more pixels than
//# `max_pixels` before it decodes any of them, since a small file can
//# claim a size that would exhaust memory.
//#
//# The codecs are C libraries compiled to WebAssembly (engine/image.wasm,
//# embedded), and each call runs in a fresh instance of it through
//# `wasm.run`, so every function here is pure. An `Image` holds its pixels,
//# and a call that makes a new one hands them to the engine and takes the
//# new ones back.
//#
//# ```nomi
//# import image.{self, Image}
//#
//# fn thumbnail(upload: Bytes) -> Result<Bytes, image.Error>
//#     picture = image.decode(upload)?
//#     Ok(Image.fit(picture, 300, 200) |> Image.encode_jpeg())
//# end
//# ```

import
    std::bytes.Builder
    std::embed.Files
    std::int.Int64
    std::wasm.{self, Module}
end

/// The engine: stb_image, libwebp's decoder, stb_image_resize2,
/// stb_image_write and zlib's deflate, compiled with engine/shim.c by
/// engine/build.sh. shim.c says what each export reads and answers.
embed engine_wasm `engine/image.wasm`

/// The engine's module, compiled once a process: from the artifact cache
/// after the first process compiles it.
once engine: Module = wasm.compile(Files.read(engine_wasm, "engine/image.wasm")!)!

/// A number of pixels: a width, a height, or how many an image may hold.
/// It is at least 1, and at most a signed 64-bit integer.
pub refine Pixels PositiveInt and Int64

/// How far into an image a crop starts, in pixels: 0 at the left or top
/// edge.
pub refine Offset NonNegativeInt and Int64

/// A JPEG's quality, 1 to 100: higher keeps more detail in a larger file.
pub refine Quality Int when fn n -> n >= 1 and n <= 100

/// The file format an image was decoded from.
pub enum Format
    Jpeg
    Png
    Webp
end

derive Equatable for Format
derive Debug for Format

/// Why an image could not be read.
pub enum Error
    /// The bytes are not a JPEG, PNG or WebP file.
    UnsupportedFormat

    /// The bytes start as an image of a known format, but the rest does
    /// not decode: `message` is the decoder's.
    Corrupt {message: String}

    /// The image's header declares `width` by `height` pixels, more than
    /// the decode allows.
    TooLarge {width: Int, height: Int}
end

derive Equatable for Error
derive Debug for Error

impl Display for Error
    //! assert "${Error.UnsupportedFormat}" == "not a JPEG, PNG or WebP image"
    //!
    //! assert "${Error.TooLarge{width: 9000, height: 9000}}"
    //!     == "the image is 9000 by 9000 pixels, more than allowed"
    //
    fn to_string(error: Error) -> String
        case error
            .UnsupportedFormat ->
                "not a JPEG, PNG or WebP image"

            .Corrupt{message:} ->
                "the image is corrupt: ${message}"

            .TooLarge{width:, height:} ->
                "the image is ${width} by ${height} pixels, more than allowed"
        end
    end
end

/// An image's format and size, read from its header.
pub struct Dimensions
    format: Format
    width:  Int
    height: Int
end

derive Equatable for Dimensions
derive Debug for Dimensions

/// The memory an engine call that works in `bytes` may grow to: 64 MiB
/// more, rounded up to a power of two. The engine refuses an image past
/// the pixel limit before it allocates for it, so the limit only bounds
/// what a hostile file makes it take. Rounding keeps the limits few, and a
/// js/wasm build's engine compiles the module once for each limit.
fn memory_for(bytes: NonNegativeInt) -> PositiveInt
    rounded_up(67_108_864 + bytes, 67_108_864)
end

/// The least of `size` doubled until it is `needed` or more.
fn rounded_up(needed: Int, size: PositiveInt) -> PositiveInt
    if size >= needed then
        size
    else
        rounded_up(needed, size * 2)
    end
end

/// The engine's export `name` run over `numbers`, each a u64, and then
/// `data`, in a fresh instance whose memory may grow to `memory` bytes.
fn run(
    name:    String,
    numbers: List<Int>,
    data:    Bytes,
    memory:  NonNegativeInt,
) -> Result<Bytes, wasm.Error>
    numbers
    |> Iter.reduce(Builder.new(), Builder.push_int64_le)
    |> Builder.to_bytes()
    |> Bytes.concat(data)
    |> then &wasm.run(engine, name, &1, memory_limit: memory)
end

/// The u32 of `answer` at `at`.
fn u32(answer: Bytes, at: Int) -> NonNegativeInt
    Bytes.uint32_le_at(answer, at)!
end

/// What follows the status of `answer`.
fn after_status(answer: Bytes) -> Bytes
    Bytes.slice(answer, 1, Bytes.length(answer))
end

/// What the engine's `answer` to a probe or a decode holds after its
/// status when the status is done, or the Error it names (shim.c lists
/// them). A trap, which no input should cause, is the image's corruption.
fn read(answer: Result<Bytes, wasm.Error>) -> Result<Bytes, Error>
    case answer
        Err(e) ->
            Err(.Corrupt{message: "the decoder failed: ${e}"})

        Ok(bytes) ->
            rest = after_status(bytes)

            case Bytes.uint8_at(bytes, 0)!
                0 -> Ok(rest)
                1 -> Err(.UnsupportedFormat)
                2 -> Err(.Corrupt{message: Bytes.to_string_lossy(rest)})
                _ -> Err(.TooLarge{width: u32(rest, 0), height: u32(rest, 4)})
            end
    end
end

/// The engine's answer to `name` over pixels an Image holds, or why it
/// could not make one: a box past what its memory holds.
fn make(
    name:    String,
    numbers: List<Int>,
    data:    Bytes,
    memory:  NonNegativeInt,
) -> Result<Bytes, String>
    answer =
        run(name, numbers, data, memory)
        |> Result.map_err(&"the image engine failed in ${name}: ${&1}")?

    case Bytes.uint8_at(answer, 0)!
        0 -> Ok(after_status(answer))
        _ -> Err("the image engine cannot ${name}: ${Bytes.to_string_lossy(after_status(answer))}")
    end
end

/// The format the engine numbers `code`: 1, 2 and 3 (shim.c).
fn format_of(code: Int) -> Format
    case code
        1 -> .Jpeg
        2 -> .Png
        _ -> .Webp
    end
end

/// A size the engine answered, which is at least 1.
fn pixels(n: Int) -> Pixels
    Pixels.try_from(n)!
end

/// `data`'s format and size, read from its header without decoding its
/// pixels: what a check of an upload needs before it decides to decode.
pub fn dimensions(data: Bytes) -> Result<Dimensions, Error>
    header = run("probe", [], data, memory_for(Bytes.length(data) * 2)) |> read()?

    Ok(
        Dimensions{
            format: format_of(Bytes.uint8_at(header, 0)!),
            width:  u32(header, 1),
            height: u32(header, 5),
        }
    )
end

/// `data` decoded: a JPEG, PNG or WebP file. An image whose header declares
/// more than `max_pixels` pixels is `Err(.TooLarge)`, refused before any
/// pixel is decoded. The default, 50 million, is an 8,660 by 5,773 photo,
/// which decodes into about 200 MB.
pub fn decode(data: Bytes, max_pixels: Pixels = 50_000_000) -> Result<Image, Error>
    // Decoding takes up to 26 bytes a pixel, for a 16-bit PNG with alpha.
    memory = memory_for(Bytes.length(data) * 2 + max_pixels * 32)
    decoded = run("decode", [max_pixels], data, memory) |> read()?

    Ok(
        Image{
            width:  pixels(u32(decoded, 1)),
            height: pixels(u32(decoded, 5)),
            pixels: Bytes.slice(decoded, 9, Bytes.length(decoded)),
            format: Some(format_of(Bytes.uint8_at(decoded, 0)!)),
        }
    )
end

/// A decoded image: its size, its pixels (8-bit RGBA, not premultiplied,
/// row after row) and the format it came from. Every operation returns a
/// new `Image`; none changes the one it is given.
pub opaque struct Image
    width:  Pixels
    height: Pixels
    pixels: Bytes

    /// The format it was decoded from; `None` for an image a resize or a
    /// crop made.
    format: Option<Format>
end

/// `n`, or 1 when it is less: a size computed from a box rounds to no
/// less than one pixel.
fn at_least_one(n: Int) -> Pixels
    pixels(Comparable.max(n, 1))
end

/// The largest size of `width` by `height` that fits in `max_width` by
/// `max_height` keeping its shape, rounded to the nearest pixel: never
/// larger than `width` by `height`, and at least 1 by 1.
fn fitted(width: Pixels, height: Pixels, max_width: Pixels, max_height: Pixels) -> (Pixels, Pixels)
    if width <= max_width and height <= max_height then
        (width, height)
    else if width * max_height >= height * max_width then
        (max_width, at_least_one((height * max_width + width / 2) / width))
    else
        (at_least_one((width * max_height + height / 2) / height), max_height)
    end
end

/// The `width` by `height` part of `image` at `x`, `y`, scaled to
/// `to_width` by `to_height` with Catmull-Rom (copied, when the sizes are
/// the same).
fn scaled(
    image:     Image,
    x:         Int,
    y:         Int,
    width:     Pixels,
    height:    Pixels,
    to_width:  Pixels,
    to_height: Pixels,
) -> Image
    out = to_width * to_height * 4
    numbers = [x, y, width, height, to_width, to_height, image.width, image.height]
    memory = memory_for((Bytes.length(image.pixels) + out) * 2)

    Image{
        width:  to_width,
        height: to_height,
        pixels: make("scale", numbers, image.pixels, memory)!,
        format: None,
    }
end

/// The engine's file of `image`, made by `name` with `numbers` before its
/// size.
fn encoded(image: Image, name: String, numbers: List<Int>) -> Bytes
    memory = memory_for(Bytes.length(image.pixels) * 3)
    make(name, [..numbers, image.width, image.height], image.pixels, memory)!
end

impl Image
    /// The width in pixels.
    pub fn width(image: Image) -> Int
        image.width
    end

    /// The height in pixels.
    pub fn height(image: Image) -> Int
        image.height
    end

    /// The format the image was decoded from, or `None` for one a resize
    /// or a crop made.
    pub fn format(image: Image) -> Option<Format>
        image.format
    end

    /// `image` scaled down to fit inside `max_width` by `max_height`,
    /// keeping its shape. An image that already fits is returned as it is:
    /// `fit` never scales up.
    pub fn fit(image: Image, max_width: Pixels, max_height: Pixels) -> Image
        w = image.width
        h = image.height
        (to_width, to_height) = fitted(w, h, max_width, max_height)

        if to_width == w and to_height == h then
            image
        else
            scaled(image, 0, 0, w, h, to_width, to_height)
        end
    end

    /// `image` scaled and cropped to exactly `width` by `height`: scaled
    /// until it covers the box, keeping its shape, then cut to the box
    /// around its center.
    pub fn fill(image: Image, width: Pixels, height: Pixels) -> Image
        sw = image.width
        sh = image.height

        // The largest part of the image with the box's shape.
        (cw, ch) =
            if sw * height > sh * width then
                (at_least_one((sh * width + height / 2) / height), sh)
            else
                (sw, at_least_one((sw * height + width / 2) / width))
            end

        scaled(image, (sw - cw) / 2, (sh - ch) / 2, cw, ch, width, height)
    end

    /// The part of `image` whose top left corner is at `x`, `y` and that is
    /// `width` by `height`, which must lie inside the image.
    pub fn crop(image: Image, x: Offset, y: Offset, width: Pixels, height: Pixels) -> Image
        inside = x + width <= image.width and y + height <= image.height

        if not inside then unreachable "Image.crop's rectangle must lie inside the image"
        scaled(image, x, y, width, height, width, height)
    end

    /// `image` as a JPEG file at `quality`. JPEG has no transparency, so a
    /// pixel is written as its color over black: a transparent one is
    /// black.
    pub fn encode_jpeg(image: Image, quality: Quality = 90) -> Bytes
        encoded(image, "encode_jpeg", [quality])
    end

    /// `image` as a PNG file.
    pub fn encode_png(image: Image) -> Bytes
        encoded(image, "encode_png", [])
    end
end
