//# Argon2id and bcrypt for std::passwords, over golang.org/x/crypto. Each
//# is a `PasswordHasher`, so `passwords.hash` makes its hashes and
//# `passwords.verify` checks them beside std's PBKDF2 ones:
//#
//# ```nomi
//# import {
//#     password_hashers.{Argon2id, Bcrypt}
//#     std::passwords.{self, PasswordHasher, Pbkdf2}
//# }
//#
//# fn hashers() -> List<PasswordHasher> {
//#     [Argon2id{}, Bcrypt{}, Pbkdf2{}]
//# }
//#
//# fn sign_in(password: String, stored: String) -> Bool {
//#     passwords.verify(password, stored, hashers()) == Ok(True)
//# }
//# ```
//#
//# `Argon2id` is what OWASP's Password Storage Cheat Sheet recommends first,
//# and its defaults are the cheat sheet's: 19 MiB of memory, 2 passes, 1
//# lane. `Bcrypt` is there to read the hashes an older system made, so they
//# verify and `passwords.needs_rehash` moves them to Argon2id at sign-in.

import {
    std::hash
    std::passwords.{PasswordHasher, Phc}
    std::random
}

gopkg "github.com/nomi-language/nomi/lib/password_hashers/goside"

fn argon2id_raw(
    password: Bytes,
    salt: Bytes,
    time: Int,
    memory_kib: Int,
    threads: Int,
    length: Int,
) -> Bytes go goside.Argon2id

fn bcrypt_hash_raw(password: Bytes, cost: Int) -> (String, String) go goside.BcryptHash

fn bcrypt_verify_raw(password: Bytes, stored: String) -> (Bool, String) go goside.BcryptVerify

fn bcrypt_cost_raw(stored: String) -> Int go goside.BcryptCost

/// Argon2id (RFC 9106), version 19. Its stored strings are
/// `$argon2id$v=19$m=<KiB>,t=<passes>,p=<lanes>$<salt>$<hash>`, as the
/// reference implementation writes them.
pub struct Argon2id {
    /// The memory a hash uses, in KiB: 19,456 (19 MiB), OWASP's choice
    /// with 2 passes.
    memory_kib: Int = 19_456
    /// How many passes over the memory.
    iterations: Int = 2
    /// How many lanes the memory is split into.
    parallelism: Int = 1
    /// The random salt's length in bytes, at least 8.
    salt_length: Int = 16
    /// The hash's length in bytes, at least 16.
    length: Int = 32
}

/// Why `params` cannot hash, or `None` when they can.
fn argon2_refusal(
    memory_kib: Int,
    iterations: Int,
    parallelism: Int,
    length: Int,
) -> Maybe<String> {
    if parallelism < 1 or parallelism > 255 {
        Some("Argon2id has 1 to 255 lanes, got ${parallelism}")
    } else if iterations < 1 or iterations > 4_294_967_295 {
        Some("Argon2id needs at least 1 pass, got ${iterations}")
    } else if memory_kib < 8 * parallelism or memory_kib > 4_294_967_295 {
        Some("Argon2id needs at least 8 KiB per lane, got ${memory_kib} KiB for ${parallelism}")
    } else if length < 4 or length > 1024 {
        Some("an Argon2id hash is 4 to 1024 bytes, got ${length}")
    } else {
        None
    }
}

impl PasswordHasher for Argon2id {
    fn recognizes(Argon2id, id: String) -> Bool {
        id == "argon2id"
    }

    fn hash(hasher: Argon2id, password: String) -> Result<String, String> {
        if hasher.length < 16 {
            return Err("an Argon2id hash for a password is at least 16 bytes, got ${hasher.length}")
        }

        if hasher.salt_length < 8 or hasher.salt_length > 1024 {
            return Err("an Argon2id salt is 8 to 1024 bytes, got ${hasher.salt_length}")
        }

        case argon2_refusal(
            hasher.memory_kib,
            hasher.iterations,
            hasher.parallelism,
            hasher.length,
        ) {
            Some(why) -> return Err(why)
            None -> Unit
        }

        salt = random.secure_bytes(hasher.salt_length)

        derived = argon2id_raw(
            String.to_bytes(password),
            salt,
            hasher.iterations,
            hasher.memory_kib,
            hasher.parallelism,
            hasher.length,
        )

        params = [
            ("m", Int.to_string(hasher.memory_kib)),
            ("t", Int.to_string(hasher.iterations)),
            ("p", Int.to_string(hasher.parallelism)),
        ]

        Ok(Display.to_string(Phc{id: "argon2id", version: Some(19), params, salt, hash: derived}))
    }

    fn verify(Argon2id, password: String, stored: String) -> Result<Bool, String> {
        phc = Phc.parse(stored)?

        if phc.id != "argon2id" { return Err("not an Argon2id hash: its algorithm is `${phc.id}`") }

        if phc.version != Some(19) {
            return Err("an Argon2id hash of version 19 is read, not ${phc.version}")
        }

        memory = Phc.int_param(phc, "m")?
        time = Phc.int_param(phc, "t")?
        lanes = Phc.int_param(phc, "p")?
        length = Bytes.length(phc.hash)

        case argon2_refusal(memory, time, lanes, length) {
            Some(why) -> return Err(why)
            None -> Unit
        }

        derived = argon2id_raw(String.to_bytes(password), phc.salt, time, memory, lanes, length)
        Ok(hash.equal_in_constant_time(derived, phc.hash))
    }

    fn needs_rehash(hasher: Argon2id, stored: String) -> Bool {
        case Phc.parse(stored) {
            Ok(phc) ->
                phc.version != Some(19)
                    or Phc.int_param(phc, "m") != Ok(hasher.memory_kib)
                    or Phc.int_param(phc, "t") != Ok(hasher.iterations)
                    or Phc.int_param(phc, "p") != Ok(hasher.parallelism)
                    or Bytes.length(phc.salt) < hasher.salt_length
                    or Bytes.length(phc.hash) != hasher.length

            Err(_) -> True
        }
    }
}

/// bcrypt (Provos and Mazières, 1999), for hashes an older system made. It
/// reads `$2a$`, `$2b$` and `$2y$` hashes, and writes `$2a$`. bcrypt reads
/// only a password's first 72 bytes, so `hash` refuses a longer one rather
/// than cut it.
pub struct Bcrypt {
    /// The cost: each step doubles the work. 12, a common choice above
    /// OWASP's floor of 10.
    cost: Int = 12
}

impl PasswordHasher for Bcrypt {
    fn recognizes(Bcrypt, id: String) -> Bool {
        id == "2a" or id == "2b" or id == "2y"
    }

    fn hash(hasher: Bcrypt, password: String) -> Result<String, String> {
        if hasher.cost < 4 or hasher.cost > 31 {
            return Err("a bcrypt cost is 4 to 31, got ${hasher.cost}")
        }

        case bcrypt_hash_raw(String.to_bytes(password), hasher.cost) {
            (hashed, "") -> Ok(hashed)
            (_, why) -> Err("bcrypt: ${why}")
        }
    }

    fn verify(Bcrypt, password: String, stored: String) -> Result<Bool, String> {
        case bcrypt_verify_raw(String.to_bytes(password), stored) {
            (matched, "") -> Ok(matched)
            (_, why) -> Err("not a bcrypt hash: ${why}")
        }
    }

    fn needs_rehash(hasher: Bcrypt, stored: String) -> Bool {
        bcrypt_cost_raw(stored) != hasher.cost
    }
}
