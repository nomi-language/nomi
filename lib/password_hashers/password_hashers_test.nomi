import
    std::passwords.{self, PasswordHasher, Pbkdf2}
    password_hashers.{Argon2id, Bcrypt}
end

fn hashers() -> List<PasswordHasher>
    [Argon2id{}, Bcrypt{}, Pbkdf2{}]
end

test "the reference implementation's Argon2id hash verifies"
    // phc-winner-argon2's test.c: "password" and "somesalt" at t=2,
    // m=65536, p=1.
    stored = "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc"
    assert passwords.verify("password", stored, hashers()) == Ok(True)
    assert passwords.verify("passw0rd", stored, hashers()) == Ok(False)
    assert passwords.needs_rehash(stored, hasher: Argon2id{})
end

test "a bcrypt test vector verifies, and moves to Argon2id"
    // OpenBSD's and John the Ripper's "U*U" vector.
    stored = "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"
    assert passwords.verify("U*U", stored, hashers()) == Ok(True)
    assert passwords.verify("U*V", stored, hashers()) == Ok(False)
    assert passwords.needs_rehash(stored, hasher: Argon2id{})
    assert passwords.needs_rehash(stored, hasher: Bcrypt{})
    refute passwords.needs_rehash(stored, hasher: Bcrypt{cost: 5})
end

test "Argon2id hashes with OWASP's defaults and verifies"
    stored = passwords.hash("correct horse", hasher: Argon2id{})!
    assert String.starts_with(stored, "$argon2id$v=19$m=19456,t=2,p=1$")
    assert passwords.verify("correct horse", stored, hashers()) == Ok(True)
    assert passwords.verify("correct horsf", stored, hashers()) == Ok(False)
    refute passwords.needs_rehash(stored, hasher: Argon2id{})
    assert passwords.needs_rehash(stored, hasher: Argon2id{iterations: 3})
end

test "bcrypt hashes and refuses what it would cut short"
    stored = passwords.hash("hunter2", hasher: Bcrypt{cost: 4})!
    assert String.starts_with(stored, "$2a$04$")
    assert passwords.verify("hunter2", stored, hashers()) == Ok(True)
    assert passwords.hash(String.repeat("x", 73), hasher: Bcrypt{cost: 4}) |> Result.is_err()
    assert passwords.hash("x", hasher: Bcrypt{cost: 3}) == Err("a bcrypt cost is 4 to 31, got 3")
end

test "a PBKDF2 hash still verifies beside them"
    stored = passwords.hash("hunter2", hasher: Pbkdf2{iterations: 1_000})!
    assert passwords.verify("hunter2", stored, hashers()) == Ok(True)
    assert passwords.needs_rehash(stored, hasher: Argon2id{})
end

test "malformed hashes and parameters are an Err"
    assert passwords.verify("x", "$argon2id$v=19$m=65536,t=2$c29tZXNhbHQ$CTFh", hashers())
        == Err("the PHC string has no `p` parameter")

    assert passwords.verify("x", "$2b$05$short", hashers()) |> Result.is_err()

    assert passwords.hash("x", hasher: Argon2id{parallelism: 0})
        == Err("Argon2id has 1 to 255 lanes, got 0")
end
