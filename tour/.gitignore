.DS_Store

# Staged Nomi wasm/highlighting assets (from scripts/build-tour-wasm.sh)
/public/nomi/

# Generated stdlib API reference (cmd/nomi-docgen, via build-tour-wasm.sh)
/src/content/docs/reference/

# Generated language specification pages (cmd/nomi-docgen -spec, from
# docs/spec.md, via build-tour-wasm.sh)
/src/content/docs/spec/

# Generated Writing Nomi pages (cmd/nomi-docgen -style, from docs/style.md,
# via build-tour-wasm.sh)
/src/content/docs/writing/

# Generated Tooling pages (cmd/nomi-docgen -tooling, from docs/tooling.md,
# via build-tour-wasm.sh)
/src/content/docs/tooling/

# Generated files for models (cmd/nomi-docgen -llms, from docs/cheatsheet.md,
# docs/spec.md, docs/style.md and std/, via build-tour-wasm.sh). The cheat
# sheet's page, src/content/docs/cheat-sheet.md, is committed.
/public/llms.txt
/public/llms-full.txt
/public/cheatsheet.md

# scripts/build-tour-wasm.sh's build and vendoring directory, staged from here
# into public/nomi/
/.wasm-build/
