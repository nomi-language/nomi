import
    std::calendar.NaiveDateTime
    std::json.{FromJson, ToJson}
    std::uuid.Uuid
    models
end

pub struct Order
    id:     Uuid
    buyer:  models.User
    lines:  Vector<Line>
    total:  models.Money
    placed: NaiveDateTime
    page:   models.Page<Line>
    seller: User
end

derive ToJson for Order

pub struct Line
    sku:     String
    qty:     Int
    price:   Float
    ratings: List<Maybe<Float>>
end

derive ToJson for Line
derive FromJson for Line

/// The seller, a User of its own.
pub struct User
    name: String
end

derive ToJson for User
derive FromJson for User
