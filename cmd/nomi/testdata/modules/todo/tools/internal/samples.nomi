//# Sample items for the seed tool. A file in an `internal/` directory under
//# `tools/` is a tool's helper, not a tool.

import item.Item

/// A starter list for a new user.
fn items() -> List<Item>
    [Item.new(1, "read the Nomi tour"), Item.new(2, "write a module"), Item.new(3, "publish it")]
end
