//# Formats items for printing. Its function carries no modifier, so every
//# file in `todo` may call it and no other module may; the `internal/`
//# directory only says so to a reader.

import
    item.Item
    stringkit::pad
end

/// One line of the list: the id, right-aligned, then the item.
fn row(item: Item) -> String
    id =
        item
        |> Item.id()
        |> Int.to_string()
        |> pad.pad_left(3, " ")

    "${id}  ${item}"
end
