// The library through its public API, as a module that imports it would call
// it.
import sqlite

test "a NULL column reads as an empty string" {
    conn = sqlite.open(":memory:")?
    defer sqlite.close(conn)
    sqlite.exec(conn, "CREATE TABLE notes (title TEXT, body TEXT)", [])?
    sqlite.exec(conn, "INSERT INTO notes VALUES (?, NULL)", ["todo"])?
    rows = sqlite.query_all(conn, "SELECT title, body FROM notes", [])
    assert rows == Ok([["todo", ""]])
}

test "updates and deletes change the rows a query returns" {
    conn = sqlite.open(":memory:")?
    defer sqlite.close(conn)
    sqlite.exec(conn, "CREATE TABLE tasks (id INTEGER, done INTEGER)", [])?
    sqlite.exec(conn, "INSERT INTO tasks VALUES (?, 0), (?, 0)", ["1", "2"])?
    sqlite.exec(conn, "UPDATE tasks SET done = 1 WHERE id = ?", ["1"])?
    sqlite.exec(conn, "DELETE FROM tasks WHERE done = 0", [])?
    rows = sqlite.query_all(conn, "SELECT id, done FROM tasks", [])
    assert rows == Ok([["1", "1"]])
}

test "a statement the driver rejects is an error" {
    conn = sqlite.open(":memory:")?
    defer sqlite.close(conn)
    assert Result.is_err(sqlite.exec(conn, "INSERT INTO missing VALUES (1)", []))
    assert Result.is_err(sqlite.query_all(conn, "SELECT * FROM missing", []))
}

test "closing twice is harmless, and a closed database answers errors" {
    conn = sqlite.open(":memory:")?
    sqlite.close(conn)
    sqlite.close(conn)
    assert Result.is_err(sqlite.query_all(conn, "SELECT 1", []))
}
