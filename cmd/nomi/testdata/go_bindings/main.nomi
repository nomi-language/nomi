import {
    std/hash as std_hash
    std/io
    hash
    urls
}

fn main() -> Result<Unit, String> {
    url = try urls.parse("https://example.com/search?tag=go&tag=nomi&q=hello+world")

    tags =
        url.query
        |> Map.get("tag")
        |> Maybe.with_default([])

    io.print("${url.host}${url.path} tags=${tags}")

    digest =
        "nomi"
        |> String.to_bytes()
        |> hash.sha256()
        |> hash.to_hex()

    io.print("sha256(nomi) = ${digest}")

    // This project's hash.sha256 and std/hash's share a key and not a
    // crossing, so both run.
    agrees = std_hash.sha256_hex(String.to_bytes("nomi")) == digest
    io.print("std/hash agrees: ${agrees}")
    Ok(Unit)
}
