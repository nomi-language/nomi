string("import std/io\n\n// A `fn` declared inside a field's default is checked as one inside a\n// function body is, so its body and its call have types and the default\n// runs.\nstruct Defaults {\n    unit: Unit = {\n        fn inner() -> Unit {\n            Unit\n        }\n\n        inner()\n    }\n    twice: (Int) -> Int = {\n        fn double(n: Int) -> Int {\n            n * 2\n        }\n\n        double\n    }\n    word: String = {\n        fn pick(n: Int)\x00\x00\x00 String {\n            case n {\n                1 -> \"one\"\n                _ -> \"many\"\n            }\n        }\n\n        pick(1)\n    }\n}\n\nenum Job {\n    Run {\n        label: String = {\n            fn name() -> String {\n                \"job\"\n            }\n\n            name()\n        },\n    }\n    Idle\n}\n\nfn main() {\n    d = #Defaults{}\n    io.inspect(d.unit)\n    io.inspect(d.twice(4))\n    io.print(d.word)\n    io.inspect(#Job.Run{})\n}\n")
