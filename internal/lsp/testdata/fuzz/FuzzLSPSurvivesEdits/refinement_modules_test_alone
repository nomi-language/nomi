string("import units.{Height, Meters, plus}\n\nrefine Hill Height when fn h -> h < 1000.0\n\nfn total(xs: List<Meters>) -> Float\n    Iter.sum(xs)\nend\n\ntest \"a refinement of another file's refinement checks the whole chain\"\n    assert Hill.try_from(300.0) == Some(300.0)\n    assert Hill.try_from(3000.0) == None\n    assert Hill.try_from(-3.0) == None\n    assert Height.try_from(9500.0) == None\nend\n\ntest \"values of another file's refinements convert up\"\n    h: Hill = 250.0\n    tall: Height = 8848.0\n    m: Meters = 2.0\n    assert total([h, tall, m]) == 9100.0\n    assert plus(h, m) == 252.0\nend\n")
