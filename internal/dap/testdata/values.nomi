import std/io

struct Point {
    x: Int
    y: Int
}

enum Shape {
    Circle {radius: Int}
    Square {side: Int}
    Empty
}

fn main() {
    big = (0..1000) |> Iter.to_list()

    p = #Point{x: 3, y: 4}
    s = #Shape.Circle{radius: 5}
    n = 1
    n = n + 1
    io.print("${Iter.count(big)} ${p.x} ${n}")

    if n > 1 {
        n = n * 10
        io.print("${n}")
        io.inspect(s)
    }
}
