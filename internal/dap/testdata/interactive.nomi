import std::io

fn main() {
    io.print("type lines; end with ctrl-d")

    count = Iter.loop(0, fn seen -> {
        case io.read_line() {
            Ok(Some(line)) -> {
                io.print("got ${line}")
                seen + 1
            }

            // End of input, or a read error.
            _ -> break seen
        }
    })

    io.print("${count} lines")
}
