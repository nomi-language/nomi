import std/io

fn main() {
    io.print("type lines; end with ctrl-d")

    count = Iter.loop(fn seen = 0 -> {
        case io.read_line() {
            Ok(line) -> {
                io.print("got ${line}")
                seen + 1
            }

            Err(_) ->
                break seen
        }
    })

    io.print("${count} lines")
}
