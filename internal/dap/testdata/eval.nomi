import std/io

struct Point {
    x: Int
    y: Int
}

fn norm(p: Point): Int {
    p.x * p.x + p.y * p.y
}

fn spin(n: Int): Int {
    Iter.loop(|i = 0| {
        if i < 0 {
            break i
        } else {
            i + n
        }
    })
}

fn main() {
    p = Point{x: 3, y: 4}
    xs = [1, 2, 3]
    label = "pt"

    (1..=6)
    |> Iter.each(|i| {
        text = "${label} ${i}"
        io.print(text)
    })

    io.print("${norm(p)} ${Iter.count(xs)}")
}
