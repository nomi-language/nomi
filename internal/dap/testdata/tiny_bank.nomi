import std/io

struct Account {
    balance: Int
}

impl Account {
    fn deposit(a: Account, n: Int) -> Account {
        Account{balance: a.balance + n}
    }
}

fn ident<T>(x: T) -> T {
    x
}

fn transact(start: Account, amounts: List<Int>) -> Account {
    amounts |> Iter.reduce(fn acc = start, n -> Account.deposit(acc, n))
}

fn main() {
    a = transact(Account{balance: 0}, [5, 20, 30])
    io.print("${ident(a.balance)} ${ident("done")}")
}
