import std/io

fn connect(host: String, port: Int = 8080, timeout: Int = 30): String {
    "${host}:${Int.to_string(port)}/${Int.to_string(timeout)}"
}

struct Holder {
    f: (String, Int) -> String
}

fn apply_partial(g: (String, Int) -> String): String {
    h = g(_, 7)
    h("arg")
}

fn each(n: Int, scale: Int = 10, cb: (Int) -> Int): Int {
    cb(n * scale)
}

fn main() {
    c = connect(_, port: _)
    io.print(c("a", 1))
    positional = c(_, 2)
    io.print(positional("positional"))
    named = c("named", port: _)
    io.print(named(3))
    swapped = c(port: _, host: "swapped")
    io.print(swapped(port: 4))
    io.print(swapped())
    three = connect(_, port: _, timeout: _)
    mixed = three(timeout: _, host: "mixed", _)
    io.print(mixed(5, 6))
    d1 = three(port: _, host: _)
    d2 = d1(host: "deep", port: _)
    d3 = d2(port: _)
    io.print(d3(port: 7))
    io.print(d3())
    lone = connect("lone", port: _)
    again = lone(port: _)
    io.print(again(8))
    holder = Holder{f: |h, p| connect(h, p)}
    field = holder.f(_, 9)
    io.print(field("field"))
    io.print(apply_partial(|h, p| connect(h, port: p)))
    lam = |a: String, b: Int = 5| "${a}/${Int.to_string(b)}"
    la = lam(b: _, a: _)
    lb = la(a: "lambda", b: _)
    io.print(lb(10))
    io.print(lb())
    routed = each(_, |x| x + 1)
    io.print(Int.to_string(routed(2)))
}
