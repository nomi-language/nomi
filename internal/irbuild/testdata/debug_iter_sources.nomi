// Debug of a declared `Iter<T>` position, whose runtime value is either a lazy
// pipeline (`<iter>`) or a VIEW of the source that entered the position, which
// inspects as that source (spec §16). Each source kind here is one whose Debug
// is a Nomi impl the renderer must be told about: a Range (std's generic
// impl), a user `Iter` implementor, and collections of a declared struct. The
// list of Ints and the pipeline are the controls that needed no impl.
import std/io

struct Point {
    x: Int
    y: Int
}

struct Count {
    n: Int
}

impl Iter for Count {
    fn each_while(c: Count, yield: (Int) -> Bool): Bool {
        Iter.each_while(1..=c.n, yield)
    }
}

struct Holder {
    items: Iter<Int>
}

fn ints(xs: Iter<Int>): String {
    Debug.inspect(xs)
}

fn points(xs: Iter<Point>): String {
    Debug.inspect(xs)
}

fn entries(xs: Iter<(String, Point)>): String {
    Debug.inspect(xs)
}

fn held(m: Maybe<Iter<Int>>): String {
    Debug.inspect(m)
}

fn erased<T>(xs: Iter<T>): String {
    Debug.inspect(xs)
}

fn traced(xs: Iter<Point>): Unit {
    _ = dbg xs
}

fn main(): Unit {
    io.print("1 range    ${ints(1..=3)}")
    io.print("2 user     ${ints(Count{n: 2})}")
    io.print("3 list     ${points([Point{x: 1, y: 2}])}")
    io.print("4 set      ${points(#{Point{x: 3, y: 4}})}")
    io.print("5 map      ${entries({"p" => Point{x: 5, y: 6}})}")
    io.print("6 generic  ${erased(Count{n: 1})}")
    io.print("7 generic  ${erased([Point{x: 0, y: 0}])}")
    io.print("8 field    ${Debug.inspect(Holder{items: 1..=4})}")
    io.print("9 field    ${Debug.inspect(Holder{items: Count{n: 3}})}")
    it: Iter<Int> = 2..=3
    io.print("10 payload ${held(Some(it))}")
    io.inspect(it)
    traced([Point{x: 7, y: 8}])
    // The controls: a list of scalars and a lazy pipeline.
    io.print("11 ints    ${ints([4, 5])}")
    io.print("12 lazy    ${ints(Iter.map([1, 2], |x: Int| x + 1))}")
    // Inspecting does not consume the source.
    io.print("13 after   ${Iter.to_list(it) |> Debug.inspect()}")
}
