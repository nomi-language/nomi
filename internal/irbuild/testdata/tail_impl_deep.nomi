// A tail self-call inside an `impl` block, at a depth that ordinary recursion
// cannot survive.
//
// The depth is the load-bearing part of this fixture: a shallow version of
// this program passes whether or not the tail call is lowered correctly. At
// 1e8 a lowering without the tail call would run out of stack.
//
// It must run in constant stack: `analysis.MarkTailCalls` has an
// `*ast.ImplBlock` arm precisely so that TCO fires inside an impl block.
import std/io

interface Stepper {
    fn step(value: self, n: Int): Int
}

struct Down {}

impl Stepper for Down {
    fn step(value: Down, n: Int): Int {
        if n == 0 {
            0
        } else {
            Stepper.step(value, n - 1)
        }
    }
}

fn main() {
    s = Down{}

    io.print("${Stepper.step(s, 100000000)}")
}
