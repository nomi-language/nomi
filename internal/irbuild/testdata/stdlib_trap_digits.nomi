// A trap inside a stdlib function is reported at the program's call into
// the stdlib. `Int.to_digits` passes its argument to a host function inside
// std/int.nomi, which traps on a negative number, and the report names the
// line below.
import std/io

fn main() {
    io.print("before")
    digits = Int.to_digits(0 - 5)
    io.print(digits)
}
