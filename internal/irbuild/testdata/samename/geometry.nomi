// The other of two files declaring a type called `Point`. See main.nomi.
//
// Different field NAMES and different field TYPES from shapes.Point, and the
// Float is load-bearing twice over: a bare-name collapse cannot compile against
// it, and its comparison must be rt.EqFloat rather than Go's `==` so that
// `nan == nan` is True here and False under a Go struct comparison.
pub struct Point {
    lat: Float
    lon: Float
}

pub fn at(lat: Float, lon: Float): Point {
    Point{lat, lon}
}

/// `==` on geometry.Point, resolved against GEOMETRY's declaration.
pub fn same(a: Point, b: Point): Bool {
    a == b
}
