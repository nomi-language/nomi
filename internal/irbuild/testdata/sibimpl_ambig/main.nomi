// `Thing.go` names one function and two files provide it. A builder that
// picked its single local candidate, or the first indexed one, would be
// silently right or silently wrong depending on the sort, and no diagnostic
// would say so. Refused instead. registerImpl's rule, one level out: never
// let ordering decide.
//
// Refused, so never run on the VM: there is no VM output to compare.
import {
    std/io
    alpha
    beta
    thing.{self, Thing}
}

fn main() {
    _ = alpha.touch()
    _ = beta.touch()
    _ = Thing.go(thing.thing(3))
    io.print("unreachable")
}
