import std/io

// `Iter.loop`, lowered as an inline loop: every control outcome that can
// appear in a TERMINATING program, printed, so a comparison which happens to be
// silent cannot pass for correctness.
//
// Line by line, and each is here because a plausible wrong lowering answers
// something else:
//
//   - `break v`: 3, not 4 and not Unit.
//   - `return v` advancing the state: the same program as a tail expression,
//     which loop_control_test.nomi writes both ways. A `return` lowered as a
//     return from `main` instead would be well typed and wrong.
//   - bare `break`: answers Unit, which has no `Display`, so what is observable
//     is that the loop TERMINATED. A lowering that dropped it would not reach
//     the next line.
//   - the seed evaluated ONCE, in the CLOSURE's scope rather than the
//     callback's parameter scope: `outer()` is the module function.
//   - a DESTRUCTURING state, threaded as one value.
//   - a closure created INSIDE the body capturing the state: the parameter is
//     bound per iteration, so the captured value is that
//     iteration's. A single variable declared outside the loop would hand
//     every such closure the final one.
//   - a rebinding inside the body, which SHADOWS per iteration rather than
//     mutating: `bump` is 1 every time round, never 2. Nomi has no assignment,
//     and the builder reproduces that only because blockInto pushes a scope per
//     block. This is the fact that makes `continue` in a loop non-terminating
//     and so unpinnable here — see iter_reduce_ctrl.nomi, where the source
//     advances and `continue` terminates.
//
// `continue` and a Unit tail are deliberately absent, and neither is an
// omission: a stated callback is typed `(S) -> S` so the checker rejects a Unit
// tail outright (`expected (Int) -> Int, got (Int) -> Unit`), and a loop that
// takes `continue` cannot terminate at all, because `continue` retries with the
// same state and nothing an immutable language can observe has changed.
fn outer(): Int {
    7
}

fn main() {
    first = Iter.loop(|n = 0|
        if n >= 3 {
            break n
        } else {
            n + 1
        }
    )

    io.print("break value: ${first}")

    via_return = Iter.loop(|n = 1| {
        if n % 3 != 0 { return n + 1 }
        break n
    })

    io.print("return advances: ${via_return}")

    _bare = Iter.loop(|| { break })
    io.print("bare break terminated")

    answer = Iter.loop(|| { break 42 })
    io.print("stateless break: ${answer}")

    seeded = Iter.loop(|n = outer()|
        if n >= 9 {
            break n
        } else {
            n + 1
        }
    )

    io.print("seed from closure scope: ${seeded}")

    pair = Iter.loop(|state = (0, 1)| {
        (a, b) = state
        if b > 50 { break (a, b) }
        (b, a + b)
    })

    io.print("fib pair: ${pair}")

    captured = Iter.loop(|n = 0| {
        peek = || n * 10
        if n == 4 { break peek() }
        n + 1
    })

    io.print("captured per iteration: ${captured}")

    count = 0

    shadowed = Iter.loop(|n = 0| {
        count = count + 1
        io.print("count ${count}")
        if n == 2 { break count }
        n + 1
    })

    io.print("shadowed rebinding: ${shadowed} (outer count still ${count})")
}
