// TWO SAME-NAMED TYPES, in two files, both boxed into ONE stdlib interface and
// both dispatched through it.
//
// The entry's `Point` and `shapes.Point` are different types that share a
// spelling. Each gets its own `rt.TypeID`, and each `impl Display for Point`
// binds that ADDRESS into `rt.MDisplayToString`: one table for the whole
// program, two slots.
//
// Key the table on the NAME instead and the two collapse: `rt.Method.Bind`
// panics on the second binding rather than answering wrongly, so the mutation
// is loud. `render` below would otherwise be a coin flip between two
// implementations, decided by registration order, which is
// a type identity decided by a name.
//
// `Comparable` is here as well as `Display`, in a TYPE position only: it has
// TWO self-typed positions, and dispatching one on an erased receiver is
// refused by name because the implementation is selected from argument zero
// while every other self position must hold that same concrete
// type, and these two `Point`s are exactly the pair that makes that
// false. See `interface function with more than one self-typed parameter`
// in impl.go.
import {
    std/io
    shapes.{theirs, theirs_ordered}
}

struct Point {
    tag: String
    weight: Int
}

impl Display for Point {
    fn to_string(p: Point): String {
        "${p.tag}(${p.weight})"
    }
}

impl Comparable for Point {
    fn compare(a: Point, b: Point): Ordering {
        Int.compare(a.weight, b.weight)
    }
}

fn mine(): Display {
    Point{tag: "mine", weight: 41}
}

fn mine_ordered(): Comparable {
    Point{tag: "mine", weight: 41}
}

fn render(d: Display): String {
    Display.to_string(d)
}

// A `Comparable` box crossing a file boundary and being counted rather than
// compared: the TYPE lowers, the erased-receiver dispatch does not.
fn boxed(_a: Comparable, _b: Comparable): Int {
    2
}

// The CONCRETE qualifier, which selects this file's own implementation
// directly with no table in the path. Pinned here because it lowered BEFORE
// this slice and a fallback that shadowed the working route would take it
// away — measured by a peer as a real regression, and invisible to the corpus.
fn order_here(): String {
    case Comparable.compare(Point{tag: "a", weight: 1}, Point{tag: "b", weight: 2}) {
        Ordering.Less -> "less"
        Ordering.Equal -> "equal"
        Ordering.Greater -> "greater"
    }
}

fn main() {
    io.print(render(mine()))
    io.print(render(theirs()))
    // Both boxes flowing through ONE call site, so the answers are evidence of
    // dispatch rather than of two fixed calls.
    io.print("${render(mine())}|${render(theirs())}")
    io.print("${boxed(theirs_ordered(), mine_ordered())}")
    io.print(order_here())
    io.print(Display.to_string(Point{tag: "concrete", weight: 3}))
}
