// std/fs's whole-file pair end to end on the disk: write, read back, and
// io.Error variants reached by pattern.
//
// The path is under /tmp and is TRUNCATED FIRST, so a re-run sees the same
// starting state: each run begins by replacing the file.
//
// `NotFound` is reached by reading a path nothing creates. `NotADirectory` is
// reached by writing INTO a path whose parent is a regular file, which is
// ENOTDIR rather than ENOENT.
import {
    std/fs
    std/io
}

once path: String = "/tmp/nomi-io-files-fixture.txt"

fn describe(e: io.Error) -> String {
    case e {
        #io.Error.NotFound{path} -> "missing:${path}"
        #io.Error.NotADirectory{path: _} -> "not a directory"
        _ -> "other"
    }
}

test "write_text then read_text round-trips the contents" {
    assert fs.write_text(path, "alpha\nbeta") == Ok(Unit)
    assert fs.read_text(path) == Ok("alpha\nbeta")
}

test "write_text replaces rather than appending" {
    assert fs.write_text(path, "one") == Ok(Unit)
    assert fs.write_text(path, "two") == Ok(Unit)
    assert fs.read_text(path) == Ok("two")
}

test "Append appends" {
    assert fs.write_text(path, "one") == Ok(Unit)
    assert fs.write_text(path, "two", mode: .Append) == Ok(Unit)
    assert fs.read_text(path) == Ok("onetwo")
}

test "a missing file reads as NotFound carrying the path verbatim" {
    missing = "/tmp/nomi-io-files-fixture-absent.txt"

    case fs.read_text(missing) {
        Ok(_) -> assert False
        Err(e) -> assert describe(e) == "missing:/tmp/nomi-io-files-fixture-absent.txt"
    }
}

test "io.Error renders through its Display impl" {
    case fs.read_text("/tmp/nomi-io-files-fixture-absent.txt") {
        Ok(_) -> assert False
        Err(e) -> assert Display.to_string(e) == "/tmp/nomi-io-files-fixture-absent.txt: not found"
    }
}

test "a write whose parent is not a directory reports NotADirectory" {
    assert fs.write_text(path, "parent") == Ok(Unit)

    case fs.write_text(path + "/child", "x") {
        Ok(_) -> assert False
        Err(e) -> assert describe(e) == "not a directory"
    }
}

test "io.Error values compare by variant and payload" {
    assert #io.Error.NotFound{path: "a"} == #io.Error.NotFound{path: "a"}
    refute #io.Error.NotFound{path: "a"} == #io.Error.NotFound{path: "b"}
    refute #io.Error.NotFound{path: "a"} == #io.Error.IsADirectory{path: "a"}

    assert #io.Error.Other{operation: "read", path: "a", code: "EIO"} == #io.Error.Other{
        operation: "read",
        path: "a",
        code: "EIO",
    }
}
