// The implementors, in a THIRD file — so an impl binds into a table declared
// somewhere else, which is the half of cross-package dispatch that the
// declaring file cannot do for itself.
//
// Two implementors per interface, because with one the table and a hard-coded
// call are indistinguishable.
import effects.{Clock, Logger}

pub struct Prod
    prefix: String
end

pub struct Tagged
    tag: String
end

pub struct Fixed
    at: Int
end

// A zero-sized marker, so one of the boxed values carries no storage at all.
pub type Zero

impl Logger for Prod
    fn log(p: Prod, message: String) -> String
        "${p.prefix}: ${message}"
    end
end

impl Logger for Tagged
    fn log(t: Tagged, message: String) -> String
        "[${t.tag}] ${message}"
    end
end

impl Clock for Fixed
    fn now(f: Fixed) -> Int
        f.at
    end
end

impl Clock for Zero
    fn now(z: Zero) -> Int
        _ = z
        0
    end
end
