// The interface, alone in its own file — so its dispatch TABLE is a variable
// in this file's builder package and every other file has to name it
// there rather than mint a second one.
//
// This is the shape `tests/15-app-and-defer/effects` uses: the
// interface in one file, each implementor in its own, and a struct in a fourth
// holding whichever one was wired in.
pub interface Logger {
    fn log(value: self, message: String) -> String

    // A DEFAULT, and the reason it is here: a default is lowered in this file
    // once per implementing type, and each implementing file's block calls
    // that instance, so its body's names resolve in THIS file's scope
    // whatever the implementing file binds. `Logger.log` is the
    // implementing block's own function at the receiver, so a block that
    // overrides `twice` or `log` is the one called, and the table entry for
    // `twice` is the block's.
    open fn twice(value: self, message: String) -> String {
        "${Logger.log(value, message)}/${Logger.log(value, message)}"
    }
}

pub interface Clock {
    fn now(value: self) -> Int
}
