// A tail cycle across the impl/free boundary: an interface impl function and a
// free function call each other in tail position.
//
// 1e8 hops is a thousand times the VM's call-depth limit, so the VM prints
// only if each of these tail calls replaces the caller's activation.
import std::io

interface Stepper
    fn step(value: self, n: Int) -> Int
end

struct Down end

impl Stepper for Down
    fn step(value: Down, n: Int) -> Int
        if n == 0 then 0 else bounce(value, n - 1)
    end
end

fn bounce(value: Down, n: Int) -> Int
    Stepper.step(value, n)
end

fn main()
    s = Down{}

    io.print("${bounce(s, 100000000)}")
end
