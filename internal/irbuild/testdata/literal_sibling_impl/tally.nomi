// A typed-literal handler in a SIBLING file, at the DISCRIMINATING
// instantiation.
//
// `Fragment<Int>` is the instantiation where a swapped payload cannot pass:
// `Static`'s payload is a String at every instantiation and `Dynamic`'s is an
// Int here, so a lowering that read the two the other way round fails. At
// `T = String`, which is what most of the corpus writes, the two are the
// same type and the swap is invisible.
import std/literals.{Fragment, Literal}

/// Zero-sized tag carrier. `Tally"..."` sums the `${...}` slots and counts the
/// characters of the static text around them.
pub type Tally

impl Literal for Tally {
    fn from_fragments(fragments: List<Fragment<Int>>): Int {
        Iter.reduce(fragments, |acc = 0, frag|
            case frag {
                .Static(s) -> acc + String.length(s)
                .Dynamic(n) -> acc + n
            }
        )
    }
}
