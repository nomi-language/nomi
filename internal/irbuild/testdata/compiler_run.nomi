import {
    std/compiler
    std/io
}

// `compiler.run` EVALUATES a source and captures its stdout, where
// `compiler.check` only analyzes one. Every row below is a behaviour only the
// evaluator produces, so a `check`-shaped implementation cannot fake any of
// them.
//
// The captured text is printed between `[` and `]` rather than through
// `Debug.inspect`, and that is not cosmetic: the trailing newline `io.print`
// writes is PART of the answer, and a bare print would make it
// indistinguishable from the newline the fixture's own print adds.
// `Debug.inspect` would say it too and is not available here — `String.inspect`
// is refused under `unlowered stdlib function`, a different key — so the
// brackets keep this fixture a witness for `stdlib host function` alone.
//
// This fixture pins no line number about itself, so lines may be added at the
// end freely. See differential_test.go's fixture().
fn out(source: String): String {
    case compiler.run(source) {
        Ok(text) -> "[" + text + "]"
        Err(message) -> "ERR " + message
    }
}

fn main() {
    // Plain stdout.
    io.print("plain = " + out("import std/io\n\nfn main() {\n  io.print(\"hi\")\n}\n"))

    // ORDER, and it is the row that separates a captured buffer from a set of
    // lines: two prints must arrive in program order.
    io.print(
        "order = " + out("import std/io\n\nfn main() {\n  io.print(\"a\")\n  io.print(\"b\")\n}\n")
    )

    // A program with no `main` runs its top level and stops, rather than
    // failing. Distinguishes "no main is an error" from "no main is empty".
    io.print("no_main = " + out("fn unused(): Int {\n  1\n}\n"))

    // ARITHMETIC EVALUATED, not merely type-checked. A checker answers nothing
    // about 6 * 7.
    io.print(
        "arith = " + out("import std/io\n\nfn main() {\n  io.print(Debug.inspect(6 * 7))\n}\n")
    )

    // The failure arms, each a different stage, and each an `Err` rather than a
    // crash.
    io.print("parse = " + out("fn main() {\n"))
    io.print("analysis = " + out("fn main() {\n  _ = missing\n}\n"))

    // A RUNTIME fault, which is the arm no analyzer reaches: this program is
    // type-correct and traps when it runs.
    io.print(
        "trap = " + out(
            "import std/io\n\nfn main() {\n  io.print(Debug.inspect(9223372036854775807 + 1))\n}\n"
        )
    )

    // PARTIAL OUTPUT IS DISCARDED ON A FAULT. The program prints before it
    // traps, and `run` answers Err rather than Ok with the prefix — so the Err
    // arm is not merely "the text so far".
    io.print(
        "trap_after_print = " + out(
            "import std/io\n\nfn main() {\n  io.print(\"before\")\n  io.print(Debug.inspect(1 / 0))\n}\n"
        )
    )

    // A FAILING ASSERTION inside the run source is a fault and not stdout, which
    // is AssertionFailureFromResult in the pipeline rather than the ordinary
    // error path.
    io.print(
        "assert_fail = " + out(
            "import std/assertions.AssertionFailure\n\nfn main(): Result<Unit, AssertionFailure> {\n  assert 1 == 2\n  Ok(Unit)\n}\n"
        )
    )

    // THE STANDARD LIBRARY IS ATTACHED to the run source. `String.trim` is
    // declared nowhere in the text, so this row fails for a pipeline that parsed
    // and evaluated without loading std.
    io.print(
        "stdlib = " + out("import std/io\n\nfn main() {\n  io.print(String.trim(\"  x  \"))\n}\n")
    )

    // DERIVES ARE SYNTHESIZED for the run source. `Debug.inspect` on a struct
    // with no hand-written impl needs the synthesis passes, not just eval.
    io.print(
        "derive = " + out(
            "import std/io\n\nstruct P {\n  x: Int\n}\n\nfn main() {\n  io.print(Debug.inspect(P{x: 1}))\n}\n"
        )
    )

    // NESTING: the run source itself calls `compiler.run`. Nothing else here
    // shows the pipeline is re-entrant.
    io.print(
        "nested = " + out(
            "import std/compiler\nimport std/io\n\nfn main() {\n  case compiler.run(\"import std/io\\n\\nfn main() {\\n  io.print(\\\"deep\\\")\\n}\\n\") {\n    Ok(t) -> io.print(\"got \" + t)\n    Err(_) -> io.print(\"err\")\n  }\n}\n"
        )
    )
}
