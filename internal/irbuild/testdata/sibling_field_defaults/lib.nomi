// Field defaults the constructing file (main.nomi) omits. Each is lowered by
// this file's gen, so the defaults may name this file's private once,
// function and enum, none of which main.nomi imports.
import std::io

once greeting = "lib"

enum Rarity
    Common
    Rare
end

pub enum Item
    Key
    Coin
end

fn base() -> Int
    io.print("base")
    41
end

pub struct Loot
    name:   String
    drops:  Option<Int> = None
    held:   Option<Item> = Some(Item.Key)
    tags:   List<String> = []
    item:   Item = Item.Coin
    hello:  String = greeting
    weight: Int = base() + 1
    rare:   Bool = rarity() == Rarity.Rare
end

fn rarity() -> Rarity
    Rarity.Common
end

pub struct Box<T>
    value: T
    extra: List<T> = []
    label: Option<String> = None
end

pub enum Shape
    Tagged {name: String, tags: List<String> = [], at: Option<Int> = None}
    Plain
end
