// A Nomi FAULT inside a bubbled case, which is the row the main virtual-clock
// fixture cannot cover and the one a plausible mistake breaks.
//
// A trap reaches a compiled test as a Go panic carrying `*rt.Error`, and
// `rt.runTestBody` converts it to the case's error — the text `nomi test`
// prints. `vclock.RunCase`'s layer 2 recovers ANY panic and renders it as
// "test panicked: …", because an escaping panic would reach synctest's own
// handler and dereference the zero-value testing.T.
//
// So the ORDER of those two recovers is observable: the Nomi conversion has to
// happen INSIDE the bubble. Wrap `t.Fn` directly and layer 2 sees the *rt.Error
// first, and a compiled trap reports under different text from the
// interpreter's — a DIFFERING OUTPUT rather than a refusal, and only on cases
// that both bubble and fault. Nothing in the corpus is in that state, which is
// why this fixture exists.
//
// The sleep before the fault is not decoration: it puts the fault after virtual
// time has been spent, so the case is genuinely inside a bubble that has
// advanced its clock when it dies.
import {
    std/duration.Duration
    std/testing.Clock
    std/timer
}

fn boom(n: Int): Int {
    timer.sleep(Duration.minutes(10))
    100 / n
}

tests "a fault under a virtual clock" {
    clock Clock.Virtual

    test "the trap's own text survives the bubble" {
        assert boom(0) == 0
    }

    // A second case, so the run continues past the fault exactly as it does on
    // the real clock: a bubble is per CASE, and one case dying must not take the
    // next one with it.
    test "the next case still runs" {
        assert boom(4) == 25
    }
}
