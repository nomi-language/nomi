// `shapes` joins the program through a re-exported item rather than a call,
// so the output is the entry file's alone. An unused import is an analysis
// error, so re-exporting `origin_x` is what keeps the import, and with it the
// second `Point`, in the program.
import {
    std/io
    shapes.origin_x export
}

/// The entry file's own `Point`, unrelated to `shapes.Point` beyond the
/// spelling. Different field set, so a mix-up would also be observable — but
/// the point of the fixture is that a mix-up is not REPRESENTABLE: the two
/// are two types with two identities at run time.
struct Point {
    label: String
    weight: Int
}

fn heavier(p: Point): Int {
    p.weight + 1
}

fn main() {
    mine = Point{label: "here", weight: 41}
    io.print("label = ${mine.label}")
    io.print("heavier = ${heavier(mine)}")
}
