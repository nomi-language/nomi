/// A `Point` that coexists with the entry file's same-named type. A type is
/// identified by the file that declares it plus its name, so this `Point` and
/// the entry's are two different types even though both are spelled `Point`.
///
/// Each has its own `rt.TypeID`, so the two cannot be confused at run time
/// either: dispatch, equality and rendering all key on that identity, not on
/// the spelling.
pub struct Point {
    x: Int
    y: Int
}

pub fn origin_x(): Int {
    Point{x: 0, y: 7}.x
}
