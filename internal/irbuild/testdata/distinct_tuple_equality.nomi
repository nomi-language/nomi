// `==` and `!=` over containers whose element is a distinct over a tuple.
//
// The element is a record the VM compares with rt.Equal, so the container
// comparison is structural except where the element's type has a
// hand-written Equatable, which vm/keys.go consults at any depth. `Tag`
// below has one, and its answers differ from structural equality, so a
// comparison that skipped the impl prints a different line.
import std/io

type Pair (Int, String)

// Equal when the Int parts match, whatever the labels.
type Tag (Int, String)

impl Equatable for Tag {
    fn equal?(a: Tag, b: Tag): Bool {
        Tag(x, _) = a
        Tag(y, _) = b
        x == y
    }
}

impl Hashable for Tag {
    fn hash(t: Tag): Int {
        Tag(x, _) = t
        x
    }
}

fn main() {
    pairs = [Pair((1, "a")), Pair(2, "b")]

    io.print("list-eq=${pairs == [Pair(1, "a"), Pair((2, "b"))]}")
    io.print("list-ne=${pairs != [Pair(1, "a")]}")
    io.print("list-differs=${pairs == [Pair(1, "a"), Pair(2, "z")]}")
    io.print("nested-list=${[[Pair(1, "a")]] == [[Pair(1, "a")]]}")
    io.print("vector=${#[Pair(1, "a")] == #[Pair(1, "a")]}")
    io.print("set=${#{Pair(1, "a"), Pair(2, "b")} == #{Pair(2, "b"), Pair(1, "a")}}")
    io.print("set-has=${Set.contains?(#{Pair(1, "a")}, Pair(1, "a"))}")
    io.print("map-key=${Map.get({Pair(1, "a") => "one"}, Pair(1, "a")) |> Maybe.with_default("?")}")
    io.print("map-eq=${{Pair(1, "a") => 1} == {Pair(1, "a") => 1}}")
    io.print("map-value=${{"k" => Pair(1, "a")} == {"k" => Pair(1, "b")}}")
    io.print("maybe=${Some(Pair(1, "a")) == Some(Pair(1, "a"))}")
    io.print("list-of-maybe=${[Some(Pair(1, "a"))] == [Some(Pair(1, "a"))]}")
    io.print("tuple=${(Pair(1, "a"), 2) == (Pair(1, "a"), 2)}")

    held: Maybe<Pair> = Some(Pair(3, "c"))
    io.print("maybe-debug=${Debug.inspect(held)}")

    // The hand-written impl answers inside every container.
    io.print("tag-list=${[Tag(1, "a")] == [Tag(1, "b")]}")
    io.print("tag-list-ne=${[Tag(1, "a")] != [Tag(2, "a")]}")
    io.print("tag-maybe=${Some(Tag(1, "a")) == Some(Tag(1, "z"))}")
    tagged: Result<Tag, String> = Ok(Tag(1, "a"))
    io.print("tag-result=${tagged == Ok(Tag(1, "q"))}")
    tags = #{Tag(1, "a"), Tag(1, "b")}
    io.print("tag-set-size=${Set.size(tags)}")
    io.print("tag-set-has=${Set.contains?(tags, Tag(1, "zzz"))}")

    io.print(
        "tag-map-key=${Map.get({Tag(3, "x") => "three"}, Tag(3, "y")) |> Maybe.with_default("?")}"
    )
}
