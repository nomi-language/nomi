import
    std::io
    std::regex.Regex
end

struct Holder
    name: String
    re:   Regex<List<Maybe<String>>>
end

fn main()
    case Regex.compile("\\d+")
        .Ok(re) ->
            dbg re
            io.print(Debug.inspect(re))
            io.print(Debug.inspect(Holder{name: "digits", re:}))
            dbg (Holder{name: "digits", re:})
            io.print(Debug.inspect(Some(re)))
            io.print(Debug.inspect([re]))
            io.print(Debug.inspect((re, 1)))

        .Err(e) ->
            io.print(e)
    end

    io.print(Debug.inspect(Regex.compile("a`b")))
end
