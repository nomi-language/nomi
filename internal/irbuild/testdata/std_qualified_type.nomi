import
    std::duration
    std::io
    std::random.{self, Error}
end

// Std types named through their module's qualifier in signatures.
fn fetch(ok: Bool) -> Result<Int, random.Error>
    if ok then
        Ok(1)
    else
        Err(Error.OsEntropy{reason: "refused"})
    end
end

fn twice(d: duration.Duration) -> duration.Duration
    d + d
end

fn main()
    io.print(
        fetch(False)
        |> Result.map_err(fn e -> "${e}")
    )

    io.print(fetch(True))
    io.print(twice(duration.Duration.seconds(3)))
end
