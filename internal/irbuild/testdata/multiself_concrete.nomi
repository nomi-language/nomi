// TWO self-typed positions, on every route that is sound.
//
// `Cmp.cmp(a: self, b: self)` selects its implementation from ONE receiver and
// then needs every OTHER self position to hold that same concrete type. On an
// ERASED receiver nothing makes that true, so the builder refuses that route.
//
// This fixture is the other half, and it exists because a refusal widened past
// its reason is this project's other recurring failure. Three routes keep
// working and every one is here, in ONE program so a widening cannot pass by
// breaking only one of them:
//
//   - a CONCRETE qualifier at a named receiver, both operands statically typed;
//   - the same through a function whose parameters are the concrete type, so
//     the direct call is reached from a signature rather than from a literal;
//   - a monomorphized interface DEFAULT, emitted once per implementing type
//     with every self position bound to that type — including `Cup`'s own
//     override of it, because the override winning is what makes the default
//     per-type rather than shared.
//
// The refused route cannot appear here without refusing the program. The DICTIONARY
// route is dict_self_identity.nomi.
import std/io

interface Cmp {
    fn cmp(a: self, b: self): Int

    open fn spread(a: self, b: self): Int {
        Cmp.cmp(a, b) - Cmp.cmp(b, a)
    }
}

struct Box {
    n: Int
}

struct Cup {
    n: Int
}

impl Cmp for Box {
    fn cmp(x: Box, y: Box): Int {
        x.n - y.n
    }
}

impl Cmp for Cup {
    fn cmp(x: Cup, y: Cup): Int {
        x.n + y.n
    }

    fn spread(x: Cup, y: Cup): Int {
        Cmp.cmp(x, y) * 10
    }
}

fn box_cmp(a: Box, b: Box): Int {
    Cmp.cmp(a, b)
}

fn cup_cmp(a: Cup, b: Cup): Int {
    Cmp.cmp(a, b)
}

fn main() {
    io.print("${Cmp.cmp(Box{n: 9}, Box{n: 4})}")
    io.print("${Cmp.cmp(Cup{n: 9}, Cup{n: 4})}")
    io.print("${box_cmp(Box{n: 9}, Box{n: 4})}")
    io.print("${cup_cmp(Cup{n: 9}, Cup{n: 4})}")
    io.print("${Cmp.spread(Box{n: 9}, Box{n: 4})}")
    io.print("${Cmp.spread(Cup{n: 9}, Cup{n: 4})}")
}
