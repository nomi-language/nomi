import {
    std/io
    boxes
    boxes.Box as Crate
    boxes.Shape
}

fn main() {
    io.print("seven ${Crate.seven()}")
    io.print("size ${Crate.size(#Crate{items: [1, 2]})}")
    io.inspect(Crate.of("a"))
    io.inspect(Crate.first(Crate.of(4)))
    io.print(Crate.pad("p"))
    io.print(Crate.pad("p", width: 2))
    f = Crate.seven
    io.print("value ${f()}")

    io.inspect(
        [1, 2]
        |> Iter.map(Crate.of)
        |> Iter.map(Crate.size)
        |> Iter.to_list()
    )

    io.print("count ${Crate.count(#Crate{items: [1, 2, 3]})}")
    io.print("unit ${Shape.unit()}")
    io.inspect(Shape.twice("x"))
    io.print("qualified ${boxes.Box.seven()} ${boxes.Box.of(True) |> boxes.Box.size()}")
    io.inspect(boxes.Shape.twice(3))
}
