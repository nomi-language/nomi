// A literal checked as a subtype breaks a rule up its chain: the program
// does not compile, and the diagnostic names the subtype whose rule fails.
import std::io

subtype Probability NonNegativeFloat when fn p -> p <= 1.0

fn percent(p: Probability) -> Float
    p * 100.0
end

fn main()
    io.print(percent(0.25))
    io.print(percent(-0.25))
end
