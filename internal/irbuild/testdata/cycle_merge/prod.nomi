// Closes the cycle: app imports this file and this file names app's `Config`
// and app's `Show`. Everything declared here has a same-named twin in
// test.nomi, and the two land in one builder package.
import app.{Config, Show}

pub struct Slot
    id: Int
end

impl Show for Slot
    fn show(value: Slot) -> String
        "prod-slot-${value.id}"
    end
end

pub once tag: String = "prod"

pub fn slot() -> Slot
    Slot{id: 8080}
end

pub fn badge() -> String
    Show.show(slot())
end

pub fn build() -> Config
    Config{name: tag, level: 20}
end

pub fn label() -> String
    "prod-label"
end
