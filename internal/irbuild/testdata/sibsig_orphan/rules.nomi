// A THIRD file holding the `impl Equatable for Money` — legal, because Nomi's
// orphan rule admits an impl in the type's MODULE or the interface's, and a
// Nomi module is several FILES.
//
// This file is the whole point of the fixture. Asking only the type's OWN file
// whether the program declares an impl answers "no impl" here, takes the
// structural fall-through, and answers False where the impl answers True.
// MUTATION-VERIFIED: narrowing foreignNoEquatableImpl to the owner's own gen
// makes this program LOWER instead of refuse.
import money.Money

impl Equatable for Money {
    fn equal?(a: Money, b: Money): Bool {
        a.cents == b.cents
    }
}

pub fn ping(): Int {
    1
}
