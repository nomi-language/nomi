// `Option<T>` end to end: declaration (in std), all of its construction
// spellings, `case` matching, and use as a parameter, a return and a field
// type.
//
// Every line here is written to be observable. The transcript this pins is in
// prelude_test.go, spelled out rather than compared, because the
// representation `Option` lowers to lives in rt and is implemented once.
import std::io

struct Box
    slot: Option<Int>
end

fn pick(flag: Bool) -> Option<Int>
    if flag then Some(7) else None
end

// The qualified spelling of both constructors, which is a different AST shape
// from the bare one: `Option.Some(x)` is a call through a field access.
fn pick_qualified(flag: Bool) -> Option<String>
    if flag then Option.Some("yes") else Option.None
end

// An Option as a PARAMETER type, matched with the bare pattern head.
fn or_zero(m: Option<Int>) -> Int
    case m
        Some(v) -> v
        None    -> 0
    end
end

// The qualified pattern head, and the dotted one, against the same type.
fn describe(m: Option<String>) -> String
    case m
        Option.Some(s) -> "some ${s}"
        .None          -> "none"
    end
end

// Nesting: `Option<Option<Int>>` is two instantiations, and the inner one is a
// payload of the outer. A representation that flattened them would answer the
// same for `Some(None)` and `None`.
fn depth(m: Option<Option<Int>>) -> String
    case m
        Some(inner) ->
            case inner
                Some(v) -> "some some ${v}"
                None    -> "some none"
            end

        None ->
            "none"
    end
end

// A literal INSIDE the payload pattern, so the arm can fail on the payload
// after the tag matched and fall through to a later arm.
fn is_one(m: Option<Int>) -> String
    case m
        Some(1)     -> "one"
        Some(other) -> "other ${other}"
        None        -> "nothing"
    end
end

fn main() -> Unit
    io.print("${or_zero(pick(True))}")
    io.print("${or_zero(pick(False))}")
    io.print(describe(pick_qualified(True)))
    io.print(describe(pick_qualified(False)))

    // An Option in a struct field, built both ways.
    full = Box{slot: Some(41)}
    empty = Box{slot: None}
    io.print("${or_zero(full.slot)}")
    io.print("${or_zero(empty.slot)}")

    io.print(depth(Some(Some(3))))
    io.print(depth(Some(None)))
    io.print(depth(None))

    io.print(is_one(Some(1)))
    io.print(is_one(Some(2)))
    io.print(is_one(None))

    // An annotated binding is the third position a bare `None` is discharged at,
    // after an argument and a return.
    held: Option<String> = None
    io.print(describe(held))

    // An Option of a Float, so the payload is a kind whose equality is not IEEE's.
    // Nothing here compares two Options — that is refused — but the payload has
    // to survive being carried and read back.
    f: Option<Float> = Some(0.5)

    case f
        Some(x) -> io.print("${x}")
        None    -> io.print("no float")
    end

    // A NaN payload, carried and read back. `==` on an Option is REFUSED
    // (`equality on a named type`) because it dispatches
    // to `impl Equatable for Option<T>`, which recurses into T's own
    // Equatable, so no bare structural `==` on the record is lowered, and a NaN
    // inside one cannot be compared by IEEE rules where Nomi's are reflexive.
    // What this pins is the other half: the payload survives the round trip
    // through the tagged struct unchanged.
    n: Option<Float> = Some(0.0 / 0.0)

    case n
        Some(x) -> io.print("${x}")
        None    -> io.print("no nan")
    end

    // An Option of a List, the other kind a bare `==` gets wrong. Same reason.
    xs: Option<List<Int>> = Some([1, 2, 3])

    case xs
        Some(l) -> io.print("${l}")
        None    -> io.print("no list")
    end
end
