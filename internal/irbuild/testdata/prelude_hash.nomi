// `Option.hash` / `Result.hash`: the DERIVED Hashable of the two prelude
// enums, which writes no function and is the hash a Map key of the type
// takes. Which Int it gives is not specified, so every row prints a
// comparison: equal values hash alike, and the rows that differ tell the
// variants and the payloads apart.
import std::io

// A WRITTEN impl, so every Written hashes alike: a payload hashes through
// it, and two Options holding Writtens of different x hash alike.
struct Written
    x: Int
end

impl Hashable for Written
    fn hash(w: Written) -> Int
        _ = w
        999
    end
end

struct Derived
    a: Int
    b: Int
end

derive Hashable for Derived

fn main()
    // The same value hashes alike, and another payload or variant apart.
    io.print("some int:     ${Option.hash(Some(4)) == Option.hash(Some(4))}")
    io.print("some other:   ${Option.hash(Some(4)) == Option.hash(Some(5))}")
    io.print("ok str:       ${Result.hash(Ok("bad")) == Result.hash(Ok("bad"))}")
    io.print("ok vs err:    ${Result.hash(Ok("bad")) == Result.hash(Err("bad"))}")
    io.print("none:         ${Option.hash(None) == Option.hash(None)}")
    big = Err(9223372036854775807)
    io.print("err big:      ${Result.hash(big) == Result.hash(big)}")

    // The payload routes through `Hashable.hash`, in BOTH variant positions.
    one = Written{x: 1}
    two = Written{x: 2}
    io.print("some written: ${Option.hash(Some(one)) == Option.hash(Some(two))}")
    io.print("err written:  ${Result.hash(Err(one)) == Result.hash(Err(two))}")
    d = Derived{a: 2, b: 3}
    e = Derived{a: 2, b: 4}
    io.print("some derived: ${Option.hash(Some(d)) == Option.hash(Some(d))}")
    io.print("err derived:  ${Result.hash(Err(d)) == Result.hash(Err(e))}")

    // Reached through the pipe spelling, and as an operand.
    io.print("piped some:   ${(Some(7) |> Option.hash()) == Hashable.hash(Some(7))}")
    io.print("piped none:   ${(None |> Option.hash()) == Option.hash(None)}")
    agree = Option.hash(Some(4)) == Option.hash(Some(4))
    differ = Option.hash(Some(4)) == Option.hash(None)
    io.print("agree:        ${agree}")
    io.print("differ:       ${differ}")
end
