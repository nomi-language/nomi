// `Maybe.hash` / `Result.hash` — the DERIVED Hashable half of the two prelude
// enums, which is `declIndex * 31 + Hashable.hash(payload)` and is NOT the
// structural map-key hash next door in maps.go.
//
// Every row below exists to let two independently-derived facts contradict
// each other; see the notes at each group.
import std/io

// A WRITTEN impl, so the payload's hash is a number nothing structural would
// ever produce. This is the row that separates `Hashable.hash` — which a
// program may override — from maps.go's valueHash, which deliberately cannot
// be overridden and would answer an rt.HashMix fold here.
struct Written {
    x: Int
}

impl Hashable for Written {
    fn hash(w: Written): Int {
        _ = w
        999
    }
}

struct Derived {
    a: Int
    b: Int
}

derive Hashable for Derived

fn main() {
    // Declaration index 0. `0 * 31 + h` IS `h`, so this side cannot tell a right
    // mix from no mix, a 0-based index from a 1-based one, or a wrapping add
    // from a trapping one. Three derivations collapse into one observation here,
    // which is why the index-1 group below exists.
    io.print("some int:     ${Maybe.hash(Some(4))}")
    io.print("some str:     ${Maybe.hash(Some("bad"))}")
    io.print("ok int:       ${Result.hash(Ok(4))}")
    io.print("ok str:       ${Result.hash(Ok("bad"))}")

    // Declaration index 1 — the only side that observes the mix at all. `none`
    // pins the index's own base (1, not the builder's 1-based variant tag of 2,
    // and not 31), `err str` pins `1 * 31 + h`, and `err wrap` pins that the mix
    // WRAPS: rt.AddInt would trap on this addition and print nothing at all.
    io.print("none:         ${Maybe.hash(None)}")
    io.print("err str:      ${Result.hash(Err("bad"))}")
    io.print("err wrap:     ${Result.hash(Err(9223372036854775807))}")

    // The payload routes through `Hashable.hash`, in BOTH variant positions.
    io.print("some written: ${Maybe.hash(Some(Written{x: 1}))}")
    io.print("err written:  ${Result.hash(Err(Written{x: 1}))}")
    io.print("some derived: ${Maybe.hash(Some(Derived{a: 2, b: 3}))}")
    io.print("err derived:  ${Result.hash(Err(Derived{a: 2, b: 3}))}")

    // Reached through the pipe spelling, and as an operand.
    io.print("piped some:   ${Some(7) |> Maybe.hash()}")
    io.print("piped none:   ${None |> Maybe.hash()}")
    agree = Maybe.hash(Some(4)) == Maybe.hash(Some(4))
    differ = Maybe.hash(Some(4)) == Maybe.hash(None)
    io.print("agree:        ${agree}")
    io.print("differ:       ${differ}")
}
