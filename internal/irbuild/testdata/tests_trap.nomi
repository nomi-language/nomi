// A Nomi fault inside a test fails that case and lets the run continue. The
// fault ends only the case that raised it, and rt's test reporter prints its
// text in that case's report.
test "an overflow inside a test" {
    assert 9223372036854775807 + 1 == 0
}

test "the next case still runs" {
    assert 1 == 1
}
