// `impl Option<T>` and `impl Result<T, E>` reached through the QUALIFIED CALL
// spelling, at concrete instantiations, beside the operator spelling of the
// same operation.
//
// A TEST file rather than a program because half of what has to agree is that
// the method and the operator answer the SAME thing, and `assert` is the only
// place a Bool is judged.
//
// # Why the pairs matter more than the individual answers
//
// std/lists.nomi defines `List.equal` AS `a == b`, and the builder shares one
// lowering for both spellings for that reason. The
// prelude enums are the same situation: `derive Equatable for Option<T>` is the
// method, and the `==` operator on a prelude instance already lowers through
// g.valueEqual. So every `equal` case below is written twice, once each way,
// and a lowering that gave the method its own comparator would have to agree
// with the operator by luck rather than by construction.
//
// # The cases that are a WRONG ANSWER rather than a missing one
//
//   - NaN. Nomi's Float equality is REFLEXIVE on NaN and IEEE's is not, so
//     `Option.equal(Some(nan), Some(nan))` is True in Nomi and false under an
//     IEEE `==` on the payload. A lowering that compared with IEEE equality
//     would type-check and answer wrongly, silently.
//   - A NON-SCALAR payload. `Option<List<Int>>` compares its payload
//     structurally; comparing cons-cell POINTERS would answer False for two
//     equal lists built separately.
//   - Variant order. `Some` is tag 1 and `None` is tag 2, `Ok` 1 and `Err` 2.
//     `is_ok` reading the wrong tag is a total inversion that no arity or type
//     check can see.
//
// # Deliberately absent, each covered elsewhere
//
// Every None comparison here is written against a typed `None`-valued binding;
// untyped_equality.nomi covers `x == None`. `Option.map` / `flat_map` /
// `Result.map` / `map_err` are prelude_hof.nomi's subject, and `Option.hash` is
// prelude_hash.nomi's.
fn none_string() -> Option<String>
    None
end

fn none_int() -> Option<Int>
    None
end

fn none_float() -> Option<Float>
    None
end

fn none_list() -> Option<List<Int>>
    None
end

test "Option.equal and == agree on two Some values"
    a: Option<String> = Some("Ada")
    b: Option<String> = Some("Ada")
    c: Option<String> = Some("Grace")

    assert Option.equal(a, b)
    assert a == b
    refute Option.equal(a, c)
    refute a == c
end

test "Option.equal and == agree when a variant differs"
    some: Option<String> = Some("Ada")
    nothing = none_string()

    refute Option.equal(some, nothing)
    refute some == nothing
    assert Option.equal(nothing, none_string())
    assert nothing == none_string()
end

test "Option.equal is symmetric across the variant boundary"
    some: Option<Int> = Some(1)
    nothing = none_int()

    refute Option.equal(some, nothing)
    refute Option.equal(nothing, some)
end

test "Option.equal at a Bool payload"
    yes: Option<Bool> = Some(True)
    no: Option<Bool> = Some(False)

    assert Option.equal(yes, Some(True))
    refute Option.equal(yes, no)
    assert yes == Some(True)
end

test "Option.equal is reflexive on NaN, where Go equality is not"
    nan = Float.nan()
    left: Option<Float> = Some(nan)
    right: Option<Float> = Some(nan)

    assert Option.equal(left, right)
    assert left == right
    refute Option.equal(left, Some(1.0))
    refute Option.equal(left, none_float())
end

test "Option.equal compares a List payload structurally"
    left: Option<List<Int>> = Some([1, 2, 3])
    right: Option<List<Int>> = Some([1, 2, 3])
    other: Option<List<Int>> = Some([1, 2])

    assert Option.equal(left, right)
    assert left == right
    refute Option.equal(left, other)
    refute Option.equal(left, none_list())
end

test "Option.equal reached as a pipe stage"
    a: Option<String> = Some("Ada")

    assert a |> Option.equal(Some("Ada"))

    refute a |> Option.equal(Some("Grace"))
end

// A bare `None` has no type argument of its own, and these two shapes are the
// two the corpus writes. Both are answerable and neither needs a `T`:
// `equal(None, None)` compares two tags with no payload behind either, and
// `with_default`'s `T` is bound by BOTH its parameters so the default supplies
// it. Written last so the count above stays stable if they are ever split out.
//
// `Result.equal(Err("bad"), Err("bad"))` is NOT here and the omission is a
// measurement: it refuses as `non-scalar type argument (Result<?, String>)`,
// because a bare `Err` leaves `T` unsolved and nothing in the call can bind it.
// That is the prelude CONSTRUCTOR's gap at a different key, not this one — the
// same refusal `option_result_equatable_test.nomi` carries four times — and
// writing it here would have made this fixture fail for somebody else's reason.
test "a bare None is answerable on both sides of equal"
    assert Option.equal(None, None)
    refute Option.equal(Some(4), None)
    refute Option.equal(None, Some(4))
end

test "a bare None receiver takes its type from the default"
    n =
        None
        |> Option.with_default(99)

    assert n == 99
    assert Option.with_default(None, "fallback") == "fallback"
end

test "Option.is_some and Option.is_none read the variant"
    some: Option<String> = Some("Ada")
    nothing = none_string()

    assert Option.is_some(some)
    refute Option.is_none(some)
    refute Option.is_some(nothing)
    assert Option.is_none(nothing)
end

test "Option.is_some at a non-scalar payload"
    held: Option<List<Int>> = Some([1])

    assert Option.is_some(held)
    refute Option.is_none(held)
    refute Option.is_some(none_list())
end

test "Option.with_default takes the payload or the default"
    some: Option<String> = Some("Ada")

    assert Option.with_default(some, "fallback") == "Ada"
    assert Option.with_default(none_string(), "fallback") == "fallback"
    assert Option.with_default(none_int(), 7) == 7
end

test "Option.with_default at a List payload returns the list itself"
    held: Option<List<Int>> = Some([1, 2])

    assert Option.with_default(held, []) == [1, 2]
    assert Option.with_default(none_list(), [9]) == [9]
end

test "Result.equal and == agree"
    a: Result<Int, String> = Ok(1)
    b: Result<Int, String> = Ok(1)
    c: Result<Int, String> = Ok(2)
    e: Result<Int, String> = Err("bad")
    f: Result<Int, String> = Err("bad")
    g: Result<Int, String> = Err("worse")

    assert Result.equal(a, b)
    assert a == b
    refute Result.equal(a, c)
    refute a == c
    assert Result.equal(e, f)
    assert e == f
    refute Result.equal(e, g)
    refute Result.equal(a, e)
    refute a == e
end

test "Result.is_ok and Result.is_err read the variant"
    good: Result<Int, String> = Ok(1)
    bad: Result<Int, String> = Err("no")

    assert Result.is_ok(good)
    refute Result.is_err(good)
    refute Result.is_ok(bad)
    assert Result.is_err(bad)
end

test "Result.with_default takes the Ok payload or the default"
    good: Result<Int, String> = Ok(41)
    bad: Result<Int, String> = Err("no")

    assert Result.with_default(good, 0) == 41
    assert Result.with_default(bad, 0) == 0
end

test "Option.to_result converts both variants"
    some: Option<Int> = Some(3)

    assert Option.to_result(some, "missing") == Ok(3)
    assert Option.to_result(none_int(), "missing") == Err("missing")
    assert Result.is_ok(Option.to_result(some, "missing"))
    assert Result.is_err(Option.to_result(none_int(), "missing"))
end

test "Result.to_option discards the error value"
    good: Result<Int, String> = Ok(3)
    bad: Result<Int, String> = Err("no")

    assert Result.to_option(good) == Some(3)
    assert Option.is_some(Result.to_option(good))
    assert Option.is_none(Result.to_option(bad))
    assert Option.equal(Result.to_option(bad), none_int())
end

test "the two conversions round-trip"
    some: Option<Int> = Some(5)

    assert Option.equal(Result.to_option(Option.to_result(some, "e")), some)
    assert Option.equal(Result.to_option(Option.to_result(none_int(), "e")), none_int())
end
