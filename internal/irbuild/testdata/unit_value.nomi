// `Unit` named as a VALUE, which is the largest single group inside the
// `type reference` blocker: 12 corpus files, 31 sites, all of this shape.
//
// The failing case at the bottom is the reason this is a test file rather than
// a program. A comparison inside an assertion subject records both operands,
// and `Unit` is a shape where the report could go wrong silently: a bare type
// name is an operand that explains nothing, and rt.RecordOperand suppresses a
// row whose expression text reads exactly like its value. The report has to
// be compared, not assumed.
fn nothing() -> Unit
    Unit
end

test "Unit is the value of a branch with no else"
    when_true = if True then Unit
    when_false = if False then Unit
    assert when_true == Unit
    assert when_false == Unit
    refute when_true != Unit
end

test "Unit crosses a function boundary"
    assert nothing() == Unit
end

test "a failing Unit comparison renders its operands"
    refute nothing() == Unit
end
