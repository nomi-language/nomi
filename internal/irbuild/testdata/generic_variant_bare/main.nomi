// A payload-free variant of a user generic enum where no expected type names
// the instance: a list or tuple element, an `if` branch, an operand of `==`.
// The checker records the instance it solved at each site, and the builder
// builds the variant there. Both a local enum and another file's, named both
// ways, run.
import
    std::io
    tree.{self, Tree}
end

enum Box<T>
    Empty
    Full T
end

fn value_or(t: Tree<String>, d: String) -> String
    case t
        Tree.Leaf    -> d
        Tree.Node(v) -> v
    end
end

fn filled(b: Box<Int>) -> Int
    case b
        Box.Empty   -> 0
        Box.Full(n) -> n
    end
end

fn value_or_box(b: Box<String>) -> String
    case b
        Box.Empty   -> "empty"
        Box.Full(s) -> s
    end
end

fn pick(flag: Bool) -> Box<Int>
    b = if flag then Box.Empty else Box.Full(1)
    b
end

fn main()
    boxes = [Box.Empty, Box.Full(2), Box.Empty]
    io.print("boxes = ${Iter.count(boxes)}")
    io.print("equal lists = ${boxes == [Box.Empty, Box.Full(2), Box.Empty]}")
    io.print("empty == full = ${Box.Empty == Box.Full(5)}")
    io.print("picked = ${filled(pick(True))}, ${filled(pick(False))}")
    pair = (Box.Empty, Box.Full("p"))
    io.print(value_or_box(pair.first))
    io.print("pair full = ${pair.second == Box.Full("p")}")

    io.print(value_or(Tree.Leaf, "none"))
    io.print(value_or(tree.Tree.Leaf, "qualified none"))
    trees = [Tree.Leaf, tree.Tree.Node("x"), tree.Tree.Leaf]

    io.print(
        "trees = ${trees |> Iter.map(fn t: Tree<String> -> value_or(t, "-")) |> String.join()}"
    )
end
