// A selectively imported name, called UNQUALIFIED.
//
// `import lib.{make, label}` puts a SIBLING FILE's `pub fn` in this file's own
// module scope, so `make("Ada")` is spelled exactly like a call to a local
// function, and has to resolve through the file index rather than be
// reported as `call to an unlowered function`, which would name neither the
// construct nor the gap.
//
// The ALIAS is the case that matters and it is why this fixture exists. `twice
// as doubled` binds `doubled` locally while lib.nomi's own table is keyed
// `twice`, so a lookup that read the local spelling in the callee's unit would
// MISS — and would then refuse under a key saying the function does not exist.
// Resolution is by DECLARATION NODE, so both spellings reach one entry.
//
// `String.{contains? as has}` is the same correction one layer over: a stdlib
// TYPE's method reached bare, routed to the same implCall the qualified
// spelling `String.contains?` reaches, so the two cannot answer differently.
//
// And `std/io.{print}` is a stdlib FILE's free function reached bare, the
// spelling that would otherwise report `call to an unlowered function` for
// the one host function this builder does lower.
import {
    std/io.print
    std/strings.String.{contains? as has}
    lib.{self, Widget, label, make, twice as doubled}
}

fn main() {
    w = make("Ada")
    print("label = ${label(w)}")
    print("doubled(21) = ${doubled(21)}")
    print("twice via alias and qualified agree: ${doubled(4) == lib.twice(4)}")
    print("has = ${has("nomi", "om")}")

    // The bare name and the qualified one are the same function, so a Widget
    // built one way is usable the other way. If the two spellings had reached two
    // different declarations this would not type-check.
    typed: Widget = lib.make("Grace")
    print("qualified label = ${label(typed)}")
}
