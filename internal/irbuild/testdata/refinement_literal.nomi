// A literal checked as a refinement breaks a rule up its chain: the program
// does not compile, and the diagnostic names the refinement whose rule fails.
import
    std::float.NonNegativeFloat
    std::io
end

type Probability NonNegativeFloat when fn p -> p <= 1.0

fn percent(p: Probability) -> Float
    p * 100.0
end

fn main()
    io.print(percent(0.25))
    io.print(percent(-0.25))
end
