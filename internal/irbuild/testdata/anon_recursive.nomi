import std/io

// A named type reaching itself through an anonymous struct field. No value of
// this type can be constructed (there is no base case), but the declaration
// still has to lower to a type of finite size. The tagAnonStruct arm in
// appendInlineDefs decides that. Without it the builder would recurse into
// `Node` through `wrap.inner` without end.
struct Node {
    n: Int
    wrap: {inner: Node, depth: Int}
}

fn depth_of(x: Node): Int {
    x.wrap.depth
}

fn main() {
    io.print("declared")
}
