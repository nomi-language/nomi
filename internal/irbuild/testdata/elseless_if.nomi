import
    std::assertions.AssertionFailure
    std::io
end

/// A branch that leaves keeps the `if` Unit, a statement.
fn checked(n: Int) -> Result<Int, String>
    if n < 0 then return Err("negative")

    Ok(n)
end

/// An `else if` chain with no final `else` is a statement too: a branch
/// runs for its effect, and one that returns leaves the function.
fn bucket(n: Int) -> String
    if n < 0 then
        return "negative"
    else if n == 0 then
        io.print("zero")
    else if n < 10 then
        io.print("small")
    end

    "done"
end

/// A pipe's `if` stage with no `else`.
fn shout(n: Int)
    (n > 0) |> if then io.print("positive")
end

fn main()
    io.inspect(checked(-1))
    io.inspect(checked(1))
    io.inspect(bucket(-1))
    io.inspect(bucket(0))
    io.inspect(bucket(5))
    io.inspect(bucket(50))
    shout(1)
    shout(-1)
    [1, 2, 3] |> Iter.each(fn n -> if n > 1 then io.inspect(n))

    io.inspect(in_range(4))
    io.inspect(Result.is_err(in_range(40)))
    noted(-1)
    noted(1)
end

/// A branch that ends in an `assert` or a `dbg` is a statement: the `if`
/// is Unit and the arm drops the value.
fn in_range(n: Int) -> Result<Int, AssertionFailure>
    if n > 0 then
        assert n < 10
    end

    if n > 5 then
        refute n == 7
    else if n < 0 then
        assert n > -10
    end

    Ok(n)
end

fn noted(n: Int)
    if n > 0 then dbg n
end
