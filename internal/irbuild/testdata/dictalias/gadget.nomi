// A type with a UNIQUE name, implementing an interface. The entry imports it
// under an ALIAS, which is the only variable in this fixture.
pub interface Shout {
    fn shout(v: self): String
}

pub struct Gadget {
    n: Int
}

impl Shout for Gadget {
    fn shout(g: Gadget): String {
        "gadget ${g.n}"
    }
}
