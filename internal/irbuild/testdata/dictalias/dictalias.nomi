// An ALIASED type import, and nothing else unusual — the name it aliases is
// unique, so there is no collision to blame.
//
// No test runs this fixture and it has no recorded golden.
//
// Dispatch keys on a `*rt.TypeID` address with no name in the path, so the
// alias at the import site cannot change which impl answers. A dispatch keyed
// on the runtime type name would see the alias there and find no impl.
import {
    std/io
    gadget.{Gadget as Doodad, Shout}
}

fn main() {
    io.print(Shout.shout(Doodad{n: 3}))
}
