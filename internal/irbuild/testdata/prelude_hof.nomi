// The HIGHER-ORDER half of `impl Option<T>` and `impl Result<T, E>`: `map` and
// `flat_map` on both enums, and `map_err`.
//
// A TEST file rather than a program. The VM answers `map`, `flat_map` and
// `map_err` through rt/preludehof.go, while std/option.nomi and
// std/results.nomi state the same rules as Nomi `case` bodies; the asserted
// answers below are what both must agree with.
//
// # THE ABSENT CASE IS WHERE A WRONG ANSWER HIDES, SO EVERY METHOD HAS ONE
//
// Nomi has no zero values but a host representation does, so the arm that does
// NOT run the callback is the arm a lowering can get wrong while type-checking
// perfectly. Three distinct wrong answers are foreclosed here and none is
// visible in the lowered code to a reader:
//
//   - CALLING THE CALLBACK ANYWAY. `OptionMap` on a None would pass a zero
//     value and answer `Some(0)`, so every absent row asserts the result equals
//     the absent value rather than merely that it is absent.
//   - DROPPING THE UNTOUCHED PAYLOAD. `Result.map` leaves `E` alone and
//     `map_err` leaves `T` alone, so an `Err("oops")` mapped over its Ok side
//     must still carry `"oops"` and an `Ok(3)` mapped over its Err side must
//     still carry `3`. A lowering that rebuilt the struct without copying the
//     other field would answer `Err("")` and `Ok(0)`.
//   - NAMING THE VARIANT INSTEAD OF COPYING THE TAG. rt/preludehof.go's header
//     argues this at length; the observable half is that both variants of both
//     enums round-trip.
//
// # WHY EVERY CALLBACK HERE IS A LAMBDA, AND WHY TWO ARE NOT
//
// A lambda's lowering is more than an inline expression. An arm that lowers
// its arguments and then declines leaves that work behind for a later arm to
// lower a second time. That double lowering is invisible for as long as every
// argument is inline, so the callbacks here are lambdas ON PURPOSE. If the
// route to preludeHofCall is ever moved below preludefn.go's own `callArgs`,
// this fixture is where that should show.
//
// Two rows use a bare FUNCTION REFERENCE instead, because that is the spelling
// `08-pattern-matching/option_result_test.nomi` actually writes and a fixture
// covering only lambdas would not exercise it. A funcref lowers to the same
// function kind as a lambda of its signature, so the two spellings
// are one shape here — but that is a claim about the builder, and the two rows
// stop it being an assumption.
//
// # DELIBERATELY ABSENT
//
// Every absent comparison is written against a typed `None`-valued helper
// rather than against a bare `None`. A callback answering an UNTYPED
// literal (`fn x -> []`, `fn x -> None`) is
// refused by name as `prelude function over an unsolved instance` and is
// asserted in preludehof_test.go rather than here, because a refused construct
// cannot appear in a run fixture at all.
fn none_int() -> Option<Int>
    None
end

fn none_string() -> Option<String>
    None
end

fn double(x: Int) -> Int
    x * 2
end

fn err_int() -> Result<Int, String>
    Err("oops")
end

fn positive_half(x: Int) -> Option<Int>
    if x > 0 then Some(x / 2) else none_int()
end

fn checked_double(x: Int) -> Result<Int, String>
    if x > 0 then Ok(x * 2) else err_int()
end

test "Option.map transforms a Some and leaves a None alone"
    some: Option<Int> = Some(5)

    assert Option.map(some, &(&1 * 2)) == Some(10)
    assert Option.map(none_int(), &(&1 * 2)) == none_int()
    assert Option.is_none(Option.map(none_int(), &(&1 * 2)))
    assert Option.is_some(Option.map(some, &(&1 * 2)))
end

test "Option.map may change the payload TYPE"
    some: Option<Int> = Some(7)

    assert Option.map(some, &Int.to_string(&1)) == Some("7")
    assert Option.map(none_int(), &Int.to_string(&1)) == none_string()
end

// The FUNCTION-REFERENCE spelling, in a BINDING rather than as an assertion
// operand — and the binding is the corpus spelling as well as the necessary one.
//
// A funcref written directly inside an `assert` is refused as
// `recording a non-scalar operand ((Int) -> Int)`, which is somebody else's key
// and a position this lowering newly reaches: the builder has no
// rendering for a function value in a `values:` row, so it declines the
// rendering for a function value. `08-pattern-matching/option_result_test.nomi`
// writes both of its `map` calls in a binding for its own reasons, so the corpus
// does not reach that position and this fixture does not manufacture it.
test "Option.map takes a function reference, which is the corpus spelling"
    some: Option<Int> = Some(5)
    mapped = Option.map(some, double)

    piped =
        some
        |> Option.map(double)
        |> Option.with_default(0)

    absent =
        none_int()
        |> Option.map(double)
        |> Option.with_default(0)

    assert mapped == Some(10)
    assert piped == 10
    assert absent == 0
end

test "a bare None receiver takes its type from the callback's parameter"
    n =
        None
        |> Option.map(&(&1 * 2))
        |> Option.with_default(0)

    assert n == 0
    assert Option.is_none(Option.map(None, fn x: Int -> x * 2))
end

test "Option.flat_map flattens rather than nesting"
    some: Option<Int> = Some(10)

    assert Option.flat_map(some, &positive_half(&1)) == Some(5)
    assert Option.flat_map(none_int(), &positive_half(&1)) == none_int()
end

test "Option.flat_map can turn a present value into an absent one"
    negative: Option<Int> = Some(-4)

    assert Option.flat_map(negative, &positive_half(&1)) == none_int()
    assert Option.is_none(Option.flat_map(negative, &positive_half(&1)))
end

test "Result.map transforms an Ok and carries the Err VALUE across"
    good: Result<Int, String> = Ok(7)

    assert Result.map(good, &(&1 * 2)) == Ok(14)
    assert Result.map(err_int(), &(&1 * 2)) == Err("oops")
    assert Result.is_err(Result.map(err_int(), &(&1 * 2)))
    assert Result.with_default(Result.map(err_int(), &(&1 * 2)), 0) == 0
end

test "Result.map may change the Ok TYPE and still carry the Err value"
    good: Result<Int, String> = Ok(7)
    mapped: Result<String, String> = Result.map(err_int(), &Int.to_string(&1))

    assert Result.map(good, &Int.to_string(&1)) == Ok("7")
    assert mapped == Err("oops")
end

test "Result.map takes a function reference, which is the corpus spelling"
    good: Result<Int, String> = Ok(7)
    mapped = Result.map(good, double)

    piped =
        good
        |> Result.map(double)
        |> Result.with_default(0)

    failed =
        err_int()
        |> Result.map(double)
        |> Result.with_default(0)

    assert mapped == Ok(14)
    assert piped == 14
    assert failed == 0
end

test "Result.flat_map flattens and can turn an Ok into an Err"
    good: Result<Int, String> = Ok(7)
    negative: Result<Int, String> = Ok(-1)

    assert Result.flat_map(good, &checked_double(&1)) == Ok(14)
    assert Result.flat_map(negative, &checked_double(&1)) == Err("oops")
    assert Result.flat_map(err_int(), &checked_double(&1)) == Err("oops")
end

test "Result.map_err transforms the error and carries the Ok PAYLOAD across"
    good: Result<Int, String> = Ok(3)

    assert Result.map_err(good, fn e: String -> e + "!") == Ok(3)
    assert Result.map_err(err_int(), fn e: String -> e + "!") == Err("oops!")
    assert Result.is_ok(Result.map_err(good, fn e: String -> e + "!"))
end

test "Result.map_err may change the error TYPE"
    good: Result<Int, String> = Ok(3)
    flagged: Result<Int, Bool> = Result.map_err(err_int(), fn e: String -> e == "oops")

    assert flagged == Err(True)
    assert Result.map_err(good, fn e: String -> e == "oops") == Ok(3)
end

test "the higher-order half composes with the rest of the surface"
    some: Option<Int> = Some(4)

    chained =
        some
        |> Option.map(double)
        |> Option.flat_map(&positive_half(&1))
        |> Option.with_default(0)

    lifted = Option.to_result(Option.map(some, double), "missing")
    dropped = Result.to_option(Result.map(err_int(), double))
    through = Option.map(Result.to_option(Ok(5)), double)

    assert chained == 4
    assert lifted == Ok(8)
    assert dropped == none_int()
    assert through == Some(10)
end
