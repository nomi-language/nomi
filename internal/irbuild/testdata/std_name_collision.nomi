    }
}

struct Task {
    n: Int
}

impl Task {
    fn value(x: Task): Int {
        x.n
    }

    fn spawn(n: Int): Task {
        Task{n: n * 10}
    }

    fn spawn_all(x: Task): Int {
        x.n + 1
    }

    fn await(x: Task): Int {
        x.n + 1
    }
}

impl Display for Task {
    fn to_string(x: Task): String {
        "Task(${x.n})"
    }
}

struct Sender {
    n: Int
}

impl Sender {
    fn value(x: Sender): Int {
        x.n
    }

    fn send(x: Sender): Int {
        x.n + 1
    }
}

impl Display for Sender {
    fn to_string(x: Sender): String {
        "Sender(${x.n})"
    }
}

struct Receiver {
    n: Int
}

impl Receiver {
    fn value(x: Receiver): Int {
