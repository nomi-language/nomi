// User types named after stdlib types, which this file does not import.
//
// A type's identity is its declaring file and its name, so each of these is
// this file's own type and every call on it is this file's function. The
// builder once recognised `Task.*`, `Channel.*`, `Sender.*`, `Receiver.*` and
// `Supervisor.spawn` by spelling and lowered them as std/tasks, std/channels
// and std/supervisors calls, which declined; and the checker applied
// std/tasks' concurrent-block rule to a user `Task.spawn` and
// std/supervisors' boot rule to a user `Supervisor.new`. The second group of
// functions carries exactly those std names.
import std/io

struct Duration {
    n: Int
}

impl Duration {
    fn value(x: Duration): Int {
        x.n
    }
}

impl Display for Duration {
    fn to_string(x: Duration): String {
        "Duration(${x.n})"
    }
}

