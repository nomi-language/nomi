// A tail cycle with no free member: two inherent impl functions on two
// different receivers call each other in tail position, owner-qualified.
//
// 1e8 hops: see tail_impl_free_deep.nomi for why that number.
import std/io

struct Up {}

struct Dn {}

impl Up {
    fn go(_value: Up, n: Int): Int {
        if n == 0 { 0 } else { Dn.go(Dn{}, n - 1) }
    }
}

impl Dn {
    fn go(_value: Dn, n: Int): Int {
        if n == 0 { 0 } else { Up.go(Up{}, n - 1) }
    }
}

fn main() {
    io.print("${Up.go(Up{}, 100000000)}")
}
