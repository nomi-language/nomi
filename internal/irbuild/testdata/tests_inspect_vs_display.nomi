import std/io

// One value, two renderings, in one run. `io.print` renders a List through
// `impl Display for List<T>`, whose elements go through Display.to_string;
// an assertion's `values:` row renders it through value.Inspect, which quotes
// a String. Reusing one for the other is byte-identical to ITSELF and wrong
// here, which is why this fixture is not a differential comparison alone.
fn no(_v: List<String>): Bool {
    False
}

test "the same list, two renderings" {
    xs = ["a", "b"]
    io.print("${xs}")
    assert no(xs)
}
