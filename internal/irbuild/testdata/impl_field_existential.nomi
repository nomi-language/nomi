import std/io

// An interface-typed struct FIELD: the closest thing this language has to a
// canonical box.
//
// A parameter or a return erases for the length of one call. A FIELD erases
// for the lifetime of the value, and it is the position the existential
// decision's fallback rule was written for: `Pen.occupant` may hold any
// implementor, so there is no upstream type to specialize the container on.
// Two implementors are stored into the SAME field below, which is what makes
// that unavoidable rather than merely convenient — a container generic over
// the occupant type would give `Pen{Dog}` and `Pen{Cat}` two Go types, and
// `describe` could then not take both.
//
// `Int` is stored into one as well, because a boxed builtin is the case a Go
// method could not express at all and the case where the box genuinely
// allocates: a struct receiver is already pointer-shaped, an `int64` is not.
interface Speech {
    fn speak(animal: self): String
}

interface Numberish {
    fn label(value: self, prefix: String): String
}

struct Dog {
    name: String
}

struct Cat {
    name: String
}

impl Speech for Dog {
    fn speak(d: Dog): String {
        "${d.name} says woof"
    }
}

impl Speech for Cat {
    fn speak(c: Cat): String {
        "${c.name} says meow"
    }
}

impl Numberish for Int {
    fn label(value: Int, prefix: String): String {
        "${prefix}=${value}"
    }
}

struct Pen {
    label: String
    occupant: Speech
}

struct Tally {
    counted: Numberish
}

fn describe(p: Pen): String {
    "${p.label}: ${Speech.speak(p.occupant)}"
}

fn read_tally(t: Tally): String {
    Numberish.label(t.counted, "n")
}

// The other half of the same rule, and the reason the census below can tell
// the two apart: `rex` is statically a Dog, so the qualifier plus the
// receiver's static type name exactly one function and this is a DIRECT call
// with nothing boxed. Boxing here would be the silent answer the existential
// decision warns about — a performance regression, never a wrong one.
fn statically_known(): String {
    rex = Dog{name: "Rex"}
    Speech.speak(rex)
}

// A field is READ back into an interface-typed position without being
// re-boxed: the identity travels with the value, so passing `p.occupant`
// along costs nothing beyond the copy.
fn relay(s: Speech): String {
    Speech.speak(s)
}

fn main() {
    kennel = Pen{label: "kennel", occupant: Dog{name: "Rex"}}
    basket = Pen{label: "basket", occupant: Cat{name: "Whiskers"}}
    io.print(describe(kennel))
    io.print(describe(basket))
    io.print(relay(kennel.occupant))
    io.print(relay(basket.occupant))
    io.print(statically_known())
    io.print(read_tally(Tally{counted: 42}))
}
