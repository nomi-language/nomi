import {
    std/io
    lib.Powered
}

// The interface lives in `lib.nomi` and the IMPL lives here, so the inherited
// default `tagged` is monomorphized into this file — its body and its parameter
// default both resolve against THIS module's scope while the programmer wrote
// them against lib's.
//
// This file declares its own `tag`. The interpreter prints `w:sibling`, because
// the default is evaluated in lib's scope. Monomorphizing it here would print
// `w:entry` — a silent wrong answer rather than a Go compile error, which is
// exactly what `portableDefault` exists to refuse. Nothing but the DEFAULT
// expression mentions `tag`, so the check only sees it if it walks defaults as
// well as bodies.
once tag = "entry"

struct Widget {
    name: String
}

impl Powered for Widget {
    fn label(w: Widget): String {
        w.name
    }
}

fn main() {
    w = Widget{name: "w"}

    io.print(Powered.tagged(w))
    io.print(tag)
}
