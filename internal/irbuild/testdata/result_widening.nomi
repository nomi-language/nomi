import std::io

// A function's declared result widens its tail as an annotation widens a
// binding's value: the Pt in the tuple becomes a Named.
interface Named
    fn name(value: self) -> String
end

struct Pt
    x: Int
end

impl Named for Pt
    fn name(p: Pt) -> String
        "pt${p.x}"
    end
end

fn pair() -> (Int, Named)
    (1, Pt{x: 5})
end

fn gen<A>(a: A) -> (A, Named)
    (a, Pt{x: 6})
end

fn named_list() -> List<Named>
    [Pt{x: 7}]
end

fn main()
    (n, named) = pair()
    io.print("${n} ${Named.name(named)}")
    io.print(Named.name(gen("a").second))

    io.print(
        named_list()
        |> Iter.map(&Named.name(&1))
        |> String.join(",")
    )
end
