// The sibling half of testdata/sibeq. `Loose` declares `equal` and is
// deliberately NOT `Equatable`, so the operator must not select it.
pub interface Loose
    fn equal(a: self, b: self) -> Bool
end

pub struct Point
    x: Int
    y: Int
end

pub fn point(x: Int, y: Int) -> Point
    Point{x:, y:}
end

impl Loose for Point
    fn equal(a: Point, b: Point) -> Bool
        a.x == b.x
    end
end
