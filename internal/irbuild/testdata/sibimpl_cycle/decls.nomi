// Two types and two interfaces, with each impl block in a DIFFERENT sibling
// file. The two bare imports below reference nothing of either file and are
// what makes those impl blocks visible at all — MEASURED: without them,
// `Thing.go` is "type 'Thing' has no member 'go'". They contribute no
// reference-graph edge, which is the whole point of this fixture.
//
// Neither import names anything, and neither is unused: an import of a file
// counts as used when the program uses an impl block that file declares for a
// type declared elsewhere. `Thing.go` (main.nomi, back.nomi) resolves to hop's
// block and `Other.beta` (hop.nomi) to back's.
import
    back
    hop
end

pub struct Thing
    n: Int
end

pub struct Other
    n: Int
end

pub interface Alpha
    fn go(x: self) -> Int
end

pub interface Beta
    fn beta(x: self) -> Int
end

pub fn thing(n: Int) -> Thing
    Thing{n:}
end

pub fn other(n: Int) -> Other
    Other{n:}
end
