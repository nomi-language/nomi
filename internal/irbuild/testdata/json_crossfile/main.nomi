// A bounded `T.from_json` reaching another file's type, whose name this file
// binds only through its module qualifier: in a user generic, and in std's
// `List<T>` instance.
import {
    std/io
    std/json.{FromJson, Json, ToJson}
    notes
}

fn round<T>(x: T): Result<T, Json.ShapeError> where T: FromJson and ToJson {
    T.from_json(ToJson.to_json(x))
}

fn show<T>(r: Result<T, Json.ShapeError>): String where T: ToJson {
    case r {
        Ok(v) -> Json.encode(ToJson.to_json(v))
        Err(e) -> "expected ${e.expected}, got ${e.got}"
    }
}

fn main() {
    j = Json.Obj{"title" => Json.String("x")}
    one: Result<notes.Note, Json.ShapeError> = FromJson.from_json(j)
    io.print(show(one))
    many: Result<List<notes.Note>, Json.ShapeError> = FromJson.from_json(Json.Arr([j, j]))
    io.print(show(many))
    io.print(show(round(notes.Note{title: "y"})))
    wrong: Result<List<notes.Note>, Json.ShapeError> = FromJson.from_json(j)
    io.print(show(wrong))
}
