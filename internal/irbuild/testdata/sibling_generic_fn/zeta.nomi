// Generic functions main.nomi calls across the file boundary. `pair` calls
// this file's private generic `both`, which calls `ident`, and `boxed` calls
// alpha.nomi's `wrap`.
import alpha

pub struct Tag
    name: String
end

pub fn ident<T>(x: T) -> T
    x
end

pub fn pair<T>(x: T) -> List<T>
    both(x, x)
end

fn both<T>(a: T, b: T) -> List<T>
    [ident(a), ident(b)]
end

pub fn apply<T, U>(x: T, f: (T) -> U) -> U
    f(x)
end

pub fn show<T>(x: T) -> String where T: Display
    "<${Display.to_string(x)}>"
end

pub fn boxed<T>(x: T) -> List<T>
    alpha.wrap(x)
end
