import std::io

// A `fn` declared inside a field's default is checked as one inside a
// function body is, so its body and its call have types and the default
// runs.
struct Defaults
    unit: Unit = begin
        fn inner() -> Unit
            Unit
        end

        inner()
    end
    twice: (Int) -> Int = begin
        fn double(n: Int) -> Int
            n * 2
        end

        double
    end
    word: String = begin
        fn pick(n: Int) -> String
            case n
                1 -> "one"
                _ -> "many"
            end
        end

        pick(1)
    end
end

enum Job
    Run {
        label: String = begin
            fn name() -> String
                "job"
            end

            name()
        end,
    }
    Idle
end

fn main()
    d = Defaults{}
    io.inspect(d.unit)
    io.inspect(d.twice(4))
    io.print(d.word)
    io.inspect(Job.Run{})
end
