// AN ENUM THAT EMBEDS ANOTHER ENUM.
//
// # The three spellings
//
//	Drawable.Shape{}                   constructs, and prints "shape"
//	Drawable.Shape(Shape.Circle(1.5))  the front end accepts it, and this
//	                                   builder refuses it by name
//	                                   (`variant construction`)
//	f(Shape.Circle(1.5))               a front-end error: an embedded ENUM does
//	                                   not widen the way an embedded STRUCT does
//	                                   ("argument 1: expected Drawable, got Shape")
//
// The first row is the one that matters: a value of the embedding enum is
// reachable, so the declaration is not admitted for an empty population.
//
// The `Drawable.Point` arm is the CONTROL. Without it this fixture would show
// an enum-embedding declaration lowering and say nothing about whether the
// struct-embedding half — the half that WIDENS — still works.
import std/io

enum Shape {
    Circle Float
    Square Int
}

struct Point {
    x: Int
    y: Int
}

enum Drawable {
    embeds Point
    embeds Shape
}

fn describe(d: Drawable): String {
    case d {
        Drawable.Point{x: px, y: _} -> "point " + Int.to_string(px)
        Drawable.Shape(_) -> "shape"
    }
}

fn main() {
    io.print(describe(Drawable.Shape{}))
    io.print(describe(Point{x: 3, y: 4}))
}
