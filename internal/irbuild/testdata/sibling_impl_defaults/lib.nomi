import std::io

pub enum Mode
    Fast
    Named String
end

pub struct Box
    mode: Mode
    f:    (Int) -> Int
end

fn same(n: Int) -> Int
    n
end

fn named() -> Mode
    io.print("default mode")
    Mode.Named("x")
end

impl Box
    pub fn new(mode: Mode = named(), f: (Int) -> Int = same) -> Box
        Box{mode:, f:}
    end
end

pub type Runner

impl Runner
    pub fn run<T>(n: Int, body: (Int) -> Result<T, String>) -> Result<T, String>
        body(n)
    end
end
