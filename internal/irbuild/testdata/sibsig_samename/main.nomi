// Two same-named sibling types mirrored into ONE package, exactly one of which
// declares an `impl Equatable`, and both compared.
//
// alpha's impl compares `x` only and beta's `==` is structural, so the answer
// is `alpha = True` and `beta  = False`. Both mirrors carry the Nomi name
// `Point`, so a lookup that resolved the owner by NAME would give both types
// the same answer. Only the declaration NODE separates them, and the mirror
// carries the owner's node verbatim (foreign.go's importDef).
//
// TestSiblingFile_SameNamedTypesKeepTheirOwnEquality runs it.
import {
    std/io
    alpha.{self, Point}
    beta.{self, Point as Coord}
}

fn same_point(a: Point, b: Point): Bool {
    a == b
}

fn same_coord(a: Coord, b: Coord): Bool {
    a == b
}

fn main() {
    io.print("alpha = ${Bool.to_string(same_point(alpha.at(1, 2), alpha.at(1, 3)))}")
    io.print("beta  = ${Bool.to_string(same_coord(beta.at(1, 2), beta.at(1, 3)))}")
}
