// Captures: a `then` stage applying a partial capture to the piped value,
// and a partial capture bound to a name.
//
// Every `noisy` print is a row about EVALUATION ORDER or COUNT, which is the
// half a value-only fixture cannot see.
import std/io

fn noisy(label: String, v: Int) -> Int {
    io.print("  eval ${label}")
    v
}

fn add(x: Int, y: Int) -> Int {
    x + y
}

fn divide(x: Int, y: Int) -> Int {
    x / y
}

fn apply(f: (Int) -> Int, v: Int) -> Int {
    f(v)
}

fn main() {
    // The capture's `&1` takes the piped value wherever it stands, in both
    // positions.
    io.print("slot 1:  ${10 |> then &divide(100, &1)}")
    io.print("slot 0:  ${10 |> then &divide(&1, 2)}")

    // The piped value is evaluated ONCE however many `&1`s read it — one
    // `eval piped` line, not two.
    io.print("two holes:")
    io.print("  = ${noisy("piped", 10) |> then &add(&1, &1)}")

    // ORDER. The LEFT operand is evaluated BEFORE the capture's body runs,
    // so `eval left` must precede `eval right`.
    io.print("order:")
    io.print("  = ${noisy("left", 100) |> then &divide(noisy("right", 500), &1)}")

    // A partial capture is a function VALUE with one parameter per `&N`, in
    // the order they are written, mapped back to each one's slot.
    add1 = &add(1, &1)
    half = &divide(&1, 2)
    both = &add(&1, &2)
    io.print("add1:    ${add1(9)}")
    io.print("half:    ${half(20)}")
    io.print("both:    ${both(3, 4)}")

    // The written arguments are evaluated on EACH call, as the equivalent
    // `fn y -> add(noisy("bound", 100), y)` evaluates them: one `eval bound`
    // line per result, none when the capture is made.
    io.print("per call:")
    per_call = &add(noisy("bound", 100), &1)
    io.print("  a = ${per_call(1)}")
    io.print("  b = ${per_call(2)}")

    // And it is an ordinary value: passable to a parameter of function type.
    io.print("passed:  ${apply(&add(1, &1), 9)}")

    // A pipe stage whose callee is a partial capture's value.
    io.print("chained: ${20 |> half()}")
}
