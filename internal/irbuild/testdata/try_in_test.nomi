// `?` inside a `test` body, which is a boundary of its own and not a harder
// case of the `fn`/lambda one.
//
// A `?` whose operand is `Err`/`None` does not return a value anywhere: it
// FAILS THE CASE, with `line N: test returned early`, the `?` expression as
// the formatter renders it, and the propagated variant's structural rendering.
// The run then continues with the next case. So the observable difference between
// lowering this right and lowering it as an ordinary `return` is the whole
// report block plus the pass/fail tally plus the exit status, and the absolute
// pin below is what asserts it.
//
// Four properties this file exists to pin, each in a case:
//
//   - The success path unwraps and the case runs on (`succeeds?`).
//   - The propagate path ends the case where the `?` is, so a print AFTER it
//     does not happen while a print BEFORE it does (`propagates?`).
//   - The `?`'s own line is reported even when it is nested inside an `if`
//     several statements down (`` `?` inside a nested construct ``).
//   - A `?` inside a LAMBDA in a test body unwinds the LAMBDA, so the case
//     keeps running and observes the failure as an ordinary value
//     (`` `?` inside a lambda ``). That is the row a lowering which hoisted every
//     test-body `?` to the test function would fail, and it fails on the
//     ANSWER: the case would go from `ok` to `FAIL`.
//
// The two spellings' TEXT differs and both are pinned: the prefix arm renders
// the `?` node (`parse(-1)?`) and the pipe arm renders the whole pipe
// (`-1 |> parse()?`).
import std/io

fn parse(n: Int) -> Result<Int, String> {
    if n < 0 {
        Err("negative ${n}")
    } else {
        Ok(n * 2)
    }
}

fn find(n: Int) -> Maybe<Int> {
    if n == 3 { Some(30) } else { None }
}

test "succeeds?" {
    v = parse(4)?

    assert v == 8
}

test "propagates?" {
    io.print("before the ?")
    v = parse(-1)?

    io.print("after the ?")
    assert v == 0
}

test "propagates? None" {
    v = find(4)?

    assert v == 0
}

test "`?` inside a nested construct" {
    base = parse(2)?

    if base > 0 {
        inner = parse(-7)?

        assert inner == 0
    } else {
        assert base == 0
    }
}

test "`?` in pipe position" {
    v = -1 |> parse()?

    assert v == 0
}

test "`?` inside a lambda" {
    f = fn x: Int -> {
        v = parse(x)?

        Ok(v + 7)
    }

    inner = f(-4)
    io.print("after the lambda")

    case inner {
        Ok(_) -> assert False
        Err(e) -> assert e == "negative -4"
    }
}

test "the case after a propagating one still runs" {
    assert 1 == 1
}
