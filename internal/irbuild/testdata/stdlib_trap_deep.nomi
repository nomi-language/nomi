// A trap several stdlib calls deep. `Iter.sum` reduces with a std lambda
// whose `+` is Duration's `Add` impl, and the overflow happens there, in
// std/duration.nomi. The report names the program's call to `Iter.sum`.
import {
    std/duration.Duration
    std/io
}

fn main() {
    io.print("before")

    total =
        [Duration.nanoseconds(Int.max_value), Duration.nanoseconds(1)]
        |> Iter.sum()

    io.print(Duration.as_nanos(total))
}
