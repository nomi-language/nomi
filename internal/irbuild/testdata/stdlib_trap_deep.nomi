// A trap several stdlib calls deep. `Iter.sum` reduces with a std lambda
// whose `+` is Duration's `Add` impl, and the sum is past what a Duration
// holds, which std/duration.nomi faults on. The report names the program's
// call to `Iter.sum`.
import {
    std/duration.Duration
    std/io
}

fn main() {
    io.print("before")

    total =
        [Duration.nanoseconds(9_223_372_036_854_775_807), Duration.nanoseconds(1)]
        |> Iter.sum()

    io.print(Duration.as_nanos(total))
}
