// A trap two stdlib calls deep. `Decimal.format` holds the digits after
// the point within `fraction` through a std function of its own, which
// rounds with `Decimal.round`, a host function. Four billion digits is past
// a Decimal's scale, -2147483648 to 2147483647, so the host function
// faults. The report names the program's line.
import std::io

fn main()
    io.print("before")

    shown = Decimal.format(1.5d, Locale"en", fraction: Range.from(4_294_967_298))

    io.print(shown)
end
