import std/io

// A DERIVED impl, observed through an operator and through printing.
//
// `analysis.SynthesizeDerives` has already run by the time the builder sees this
// file, so `derive Equatable for Point` arrives as an ordinary
// `impl Equatable for Point { ... }` whose body is ordinary Nomi. It lowers
// through exactly the path the hand-written `impl Display for Point` below
// takes. Nothing here special-cases a derive: the derived body is lowered and
// run like any hand-written one.
//
// `==` on a named type is the observation: it dispatches to the derived
// `equal?`. Two same-named types from two modules cannot be compared here,
// because they are two kinds and the builder refuses a mixed-kind operator
// before the arm is reached.
//
// Fields are Int deliberately. Nomi's `==` on Float is reflexive for NaN, which
// float_semantics.nomi covers, and that rule is not this fixture's subject.
struct Point {
    x: Int
    y: Int
}

derive Equatable for Point

impl Display for Point {
    fn to_string(p: Point): String {
        "(${p.x}, ${p.y})"
    }
}

fn main() {
    a = Point{x: 1, y: 2}
    b = Point{x: 1, y: 2}
    c = Point{x: 9, y: 2}

    io.print("a == b: ${a == b}")
    io.print("a == c: ${a == c}")
    io.print("a != c: ${a != c}")
    io.print("a is ${a}")
    io.print(Display.to_string(c))
    io.print(Point.to_string(c))
}
