// The subject is typed with the selective import's `Status`; the patterns
// name the type through the file API object, `ticket.Status`, a spelling no
// signature in this file resolves.
import ticket.{self, Status}

pub fn short(s: Status): String {
    case s {
        ticket.Status.Open -> "O"
        ticket.Status.Assigned(name) -> "A:${name}"
        ticket.Status.Blocked(_) -> "B"
        ticket.Status.Paired((a, _)) -> "P${a}"
        ticket.Status.Noted(_) -> "N"
        ticket.Status.Closed{days} when days > 30 -> "C (old)"
        ticket.Status.Closed{} -> "C"
    }
}
