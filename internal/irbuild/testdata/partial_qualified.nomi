import std::io

// A partial capture over an interface-qualified call, an
// owner-qualified call, a generic function and a stdlib owner function. Each
// is a function of its open slots.
interface Console
    fn write_line(c: self, line: String) -> Unit
end

struct Stdout
    prefix: String
end

impl Console for Stdout
    fn write_line(c: Stdout, line: String) -> Unit
        io.print("${c.prefix}${line}")
    end
end

struct App
    console: Console
    context: Context
end

fn boot() -> Result<App, String>
    Ok(App{console: Stdout{prefix: "app> "}, context: Context.root()})
end

fn pair<T>(a: T, b: T) -> (T, T)
    (a, b)
end

fn main()
    c = Stdout{prefix: "> "}
    Iter.each(["a", "b"], &Console.write_line(c, &1))
    write: (String) -> Unit = &Console.write_line(c, &1)
    write("c")
    Iter.each(["d"], &Stdout.write_line(c, &1))
    Iter.each(["e", "f"], &Console.write_line(App.console, &1))
    with_one: (Int) -> (Int, Int) = &pair(1, &1)
    io.print(Debug.inspect(with_one(2)))

    io.print(
        [3, 4]
        |> Iter.map(&pair(0, &1))
        |> Iter.to_list()
        |> Debug.inspect()
    )

    io.print(
        Iter.map(["x"], &String.repeat(&1, 3))
        |> Iter.to_list()
        |> Debug.inspect()
    )
end
