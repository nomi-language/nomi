import std/io

// A nominal struct and a record of the IDENTICAL shape must not unify.
//
// Nominal identity is (declaring file, name) and never the shape, so `Point`
// lowers to a Go DEFINED type and `{x: Int, y: Int}` to a bare Go struct — two
// Go types, which Go will not assign across without a conversion nobody emits.
//
// The pin is DIFFERENTIAL rather than a text assertion because the failure mode
// is a Go TYPE error: emitting the record as `NomiT_Point`, or the nominal as a
// bare `struct { F_x int64; F_y int64 }`, produces Go that PARSES, so
// TestIRBuild_EveryEmittedFileParsesAsGo could not see it. Only building can.
// The two failing assertions then show the values apart at run time: the
// nominal row carries its type name and the record's does not.
struct Point {
    x: Int
    y: Int
}

fn nominal_sum(p: Point): Int {
    p.x + p.y
}

fn record_sum(p: {x: Int, y: Int}): Int {
    p.x + p.y
}

fn no_nominal(_p: Point): Bool {
    False
}

fn no_record(_p: {x: Int, y: Int}): Bool {
    False
}

test "a record and a same-shaped nominal struct stay apart" {
    nom = Point{x: 1, y: 2}
    rec = {x: 1, y: 2}
    io.print(Int.to_string(nominal_sum(nom)))
    io.print(Int.to_string(record_sum(rec)))
    assert no_nominal(nom)
}

test "and they render apart" {
    rec = {x: 1, y: 2}
    assert no_record(rec)
}
