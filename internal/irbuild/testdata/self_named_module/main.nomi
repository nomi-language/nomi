// A file named after its own module, imported by that name, by an alias, and
// by the module-qualified path. Each spelling names thing.nomi.
import {
    std/io
    thing
    thing as t
    thing/thing as full
}

fn main() {
    io.print(thing.answer())
    io.print(t.answer())
    io.print(full.answer())
    io.print(thing.greet("ada"))
    io.print(t.greet("ada", greeting: "hi"))
}
