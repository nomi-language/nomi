// `items.Item` is another module's typealias of a third module's struct,
// named through the qualifier of the file that declares the alias.
import qualified_alias_dep::items

pub once all: List<items.Item> = [items.Item{n: 1}, items.Item{n: 2}]

pub fn total(xs: List<items.Item>) -> Int
    Iter.sum_by(xs, &(&1.n))
end
