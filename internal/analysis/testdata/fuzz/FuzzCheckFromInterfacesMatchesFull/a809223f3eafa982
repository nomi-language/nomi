string("import {\n    std::compiler\n    engine.{Engine, Mode, Powered}\n    priority\n    test_helpers\n}\n\ninterface Announcer<T> {\n    fn item(s: self) -> T\n\n    fn announce(_s: self, loud: Bool = False) -> String {\n        base = \"item\"\n        if loud { base + \"!\" } else { base }\n    }\n}\n\nstruct Box {\n    value: Int\n}\n\nimpl Announcer for Box {\n    fn item(s: Box) -> Int {\n        s.value\n    }\n}\n\ninterface IdentityWithDefaults {\n    fn name(value: self) -> String\n\n    fn describe(value: self) -> String {\n        \"I am \" + IdentityWithDefaults.name(value)\n    }\n\n    open fn greeting(value: self) -> String {\n        \"Hello from \" + IdentityWithDefaults.name(value)\n    }\n}\n\nstruct Robot {\n    model: String\n}\n\nimpl IdentityWithDefaults for Robot {\n    fn name(robot: Robot) -> String {\n        robot.model\n    }\n}\n\nstruct User {\n    handle: String\n}\n\nimpl IdentityWithDefaults for User {\n    fn name(u: User) -> String {\n        u.handle\n    }\n\n    fn greeting(u: User) -> String {\n        \"hey, it's \" + u.handle\n    }\n}\n\ninterface Formatted {\n    fn label(value: self) -> String\n\n    fn shout(value: self) -> String {\n        \"${label(value)}!\"\n    }\n\n    open fn brief(value: self) -> String {\n        label(value)\n    }\n}\n\nstruct FormattedUser {\n    name: String\n}\n\nimpl Formatted for FormattedUser {\n    fn label(u: FormattedUser) -> String {\n        u.name\n    }\n\n    fn brief(u: FormattedUser) -> String {\n        \"user:${u.name}\"\n    }\n}\n\nstruct Holder<T> {\n    item: T\n}\n\nimpl Ranked for Holder<T> {\n    fn item(h: Holder<T>) -> T {\n        h.item\n    }\n}\n\ninterface Ranked<T> {\n    fn item(r: self) -> T\n\n    fn prefer<K>(_r: self, lhs: K, rhs: K) -> Bool where K: Comparable {\n        case Comparable.compare(lhs, rhs) {\n            .Less -> False\n            _ -> True\n        }\n    }\n}\n\ninterface Chooser<T> {\n    fn item(c: self) -> T\n    fn choose<K>(c: self, lhs: K, rhs: K) -> K where K: Comparable\n}\n\nstruct ChoiceBox<T> {\n    item: T\n}\n\nimpl Chooser for ChoiceBox<T> {\n    fn item(c: ChoiceBox<T>) -> T {\n        c.item\n    }\n\n    fn choose<K>(_c: ChoiceBox<T>, lhs: K, rhs: K) -> K where K: Comparable {\n        case Comparable.compare(lhs, rhs) {\n            .Greater -> lhs\n            _ -> rhs\n        }\n    }\n}\n\nstruct DisplayBox<T> {\n    value: T\n}\n\nderive Display for DisplayBox<T> where T: Display\n\ntest \"interface default functions can have default parameters\" {\n    b = Box{value: 7}\n\n    assert Announcer.announce(b) == \"item\"\n    assert Announcer.announce(b, True) == \"item!\"\n    assert Box.announce(b) == \"item\"\n}\n\ntest \"type-qualified dispatch reaches inherited defaults and open overrides\" {\n    r = Robot{model: \"T-800\"}\n    u = User{handle: \"alice\"}\n\n    assert IdentityWithDefaults.describe(r) == \"I am T-800\"\n    assert Robot.describe(r) == \"I am T-800\"\n    assert Robot.greeting(r) == \"Hello from T-800\"\n    assert IdentityWithDefaults.greeting(u) == \"hey, it's alice\"\n    assert User.greeting(u) == \"hey, it's alice\"\n}\n\ntest \"open default overrides coexist with inherited final defaults\" {\n    alice = FormattedUser{name: \"Alice\"}\n\n    assert Formatted.label(alice) == \"Alice\"\n    assert Formatted.shout(alice) == \"Alice!\"\n    assert Formatted.brief(alice) == \"user:Alice\"\n}\n\ntest \"default parameter dot shorthand works from imported modules\" {\n    e = Engine{name: \"v8\"}\n\n    assert Powered.describe(e) == \"v8 (fast)\"\n    assert Powered.describe(e, Mode.Slow) == \"v8 (slow)\"\n}\n\ntest \"function-level where clauses on defaults are enforced and load imported impls\" {\n    h = Holder{item: \"ignored\"}\n\n    assert Ranked.prefer(h, priority.make(5), priority.make(1))\n    refute Ranked.prefer(h, priority.make(1), priority.make(5))\n}\n\ntest \"function-level where clauses on required interface functions are enforced\" {\n    c = ChoiceBox{item: \"ignored\"}\n\n    assert Chooser.choose(c, priority.make(5), priority.make(1)) == priority.make(5)\n\n    assert Chooser.choose(c, priority.make(1), priority.make(5)) == priority.make(5)\n}\n\ntest \"derive where clauses constrain synthesized impls\" {\n    assert DisplayBox.to_string(DisplayBox{value: \"ok\"}) == \"DisplayBox{value: ok}\"\n}\n\ntest \"required interface functions cannot have parameter defaults\" {\n    diagnostics = compiler.check(\n        \"\"\"\n          interface Greeter<T> {\n            fn greet(s: self, excited: Bool = False) -> String\n          }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) == 1\n\n    assert test_helpers.has_diagnostic(\n        diagnostics,\n        \"a default parameter value is only allowed on a default function with a Nomi body\",\n    )\n}\n\ntest \"interface default parameter values must match parameter types\" {\n    diagnostics = compiler.check(\n        \"\"\"\n        struct Engine {\n          name: String\n        }\n\n        impl Powered for Engine {\n\n          fn label(e: Engine) -> String {\n            e.name\n          }\n        }\n\n        interface Powered {\n          fn label(e: self) -> String\n\n          fn describe(e: self, _count: Int = \"nope\") -> String {\n            Powered.label(e)\n          }\n        }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) == 1\n    assert test_helpers.has_diagnostic(diagnostics, \"default value for parameter '_count'\")\n}\n\ntest \"function-level where clauses on defaults reject unsatisfied arguments\" {\n    diagnostics = compiler.check(\n        \"\"\"\n        \t    struct Plain {\n        \t      tag: String\n        \t    }\n\n        struct Holder<T> {\n          item: T\n        }\n\n        impl Ranked for Holder<T> {\n\n          fn item(h: Holder<T>) -> T {\n            h.item\n          }\n        }\n\n        interface Ranked<T> {\n          fn item(r: self) -> T\n\n          fn prefer<K>(_r: self, lhs: K, rhs: K) -> Bool where K: Comparable {\n            case Comparable.compare(lhs, rhs) {\n              .Less -> False\n              _ -> True\n            }\n          }\n        }\n\n        fn main() {\n          h = Holder{item: 0}\n          _result = Ranked.prefer(h, Plain{tag: \"a\"}, Plain{tag: \"b\"})\n        }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) == 1\n    assert test_helpers.has_diagnostic(diagnostics, \"does not implement Comparable\")\n}\n\ntest \"function-level where clauses on required signatures reject unsatisfied arguments\" {\n    diagnostics = compiler.check(\n        \"\"\"\n\n\n        interface Chooser<T> {\n          fn item(c: self) -> T\n\n          fn choose<K>(c: self, lhs: K, rhs: K) -> K where K: Comparable\n        }\n\n        struct ChoiceBox<T> {\n          item: T\n        }\n\n        struct Plain {\n          tag: String\n        }\n\n        impl Chooser for ChoiceBox<T> {\n\n          fn item(c: ChoiceBox<T>) -> T {\n            c.item\n          }\n\n          fn choose<K>(_c: ChoiceBox<T>, lhs: K, rhs: K) -> K where K: Comparable {\n            _ = rhs\n            lhs\n          }\n        }\n\n        fn main() {\n          _ = Chooser.choose(ChoiceBox{item: \"ignored\"}, Plain{tag: \"a\"}, Plain{tag: \"b\"})\n        }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) == 1\n    assert test_helpers.has_diagnostic(diagnostics, \"does not implement Comparable\")\n}\n\ntest \"interface method-local generics must be declared explicitly\" {\n    diagnostics = compiler.check(\n        \"\"\"\n        import std::comparable: Comparable\n\n        interface Chooser<T> {\n          fn item(c: self) -> T\n\n          fn choose(c: self, lhs: K, rhs: K) -> K where K: Comparable\n        }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) > 0\n    assert test_helpers.has_diagnostic(diagnostics, \"where` names unknown type variable `K`\")\n}\n\ntest \"derive where clauses reject unsatisfied receiver arguments\" {\n    diagnostics = compiler.check(\n        \"\"\"\n        struct DisplayBox<T> {\n          value: T\n        }\n\n        struct Plain {\n          tag: String\n        }\n\n        derive Display for DisplayBox<T> where T: Display\n\n        fn main() {\n          _ = DisplayBox.to_string(DisplayBox{value: Plain{tag: \"a\"}})\n        }\n        \"\"\"\n    )\n\n    assert Iter.count(diagnostics) == 1\n    assert test_helpers.has_diagnostic(diagnostics, \"does not implement Display\")\n}\n")
