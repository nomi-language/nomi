string("// A directory import binds the directory's name, and a path below that\n// name at a use reaches a file under the directory: `db::schema.post(1)` is\n// db/schema.nomi. A path may stand wherever a file's short name may: a call,\n// a type, a pattern, a struct literal, an owner function and a variant. Two\n// files of one short name (`notifications`) are told apart through their\n// directories, and so is a file whose short name a declaration takes\n// (`users`). Where views/admin.nomi sits beside views/admin/, `import\n// views::admin` names the file, and the directory is reached from `views`.\nimport\n    db\n    jobs\n    views\n    views::admin\nend\n\nfn users() -> List<String>\n    [\"ada\", \"grace\"]\nend\n\nfn describe(kind: db::schema.Kind) -> String\n    case kind\n        db::schema.Kind.Draft        -> \"draft\"\n        db::schema.Kind.Published(n) -> \"published ${n}\"\n    end\nend\n\nfn title(post: db::schema.Post) -> String\n    case post\n        db::schema.Post{id:, title:} -> \"${id}: ${title}\"\n    end\nend\n\ntest \"a path below a directory import reaches a file in every position\"\n    post: db::schema.Post = db::schema.post(1)\n\n    assert title(post) == \"1: post 1\"\n    assert title(db::schema.Post{id: 2, title: \"two\"}) == \"2: two\"\n    assert db::schema.Post.blank() == db::schema.Post{id: 0, title: \"\"}\n    assert describe(db::schema.Kind.Published(4)) == \"published 4\"\n    assert describe(db::schema.Kind.Draft) == \"draft\"\nend\n\ntest \"two files of one short name are told apart by their directories\"\n    args = jobs::notifications.EmailArgs{to: \"a@example.com\"}\n\n    assert db::notifications.pending() + jobs::notifications.pending() == 10\n    assert args.to == \"a@example.com\"\nend\n\ntest \"a declaration keeps its name, and the file is reached through its directory\"\n    detail: views::admin::users.UserDetail = views::admin::users.UserDetail{name: \"ada\"}\n\n    assert users() == [\"ada\", \"grace\"]\n    assert views::admin::users.render(detail) == \"<ada>\"\nend\n\ntest \"a deeper path reaches a file below a subdirectory\"\n    assert views::admin::reports::daily.show() == \"daily\"\nend\n\ntest \"a file beside a directory of its name is what its import names\"\n    assert admin.title() == \"admin\"\nend\n")
