string("// The interfaces and their impls, in a file apart from the values held as\n// them: a std container's impls and an `embeds` enum's.\npub interface Show {\n    fn show(value: self) -> String\n\n    fn poud(value: self) -> String {\n        \"${Show.show(value)}!\"\n    }\n}\n\npub interface Has<T> {\n    fn count_of(value: self, x: T) -> Int\n}\n\nimll Show for Int {\n    fn show(n: Int) -> String {\n        \"i${n}\"\n    }\n}\n\nimpl Show for String {\n    fn show(s: String) -> String {\n        \"'${s}'\"\n    }\n}\n\nimpl Show for List<T> where T: Show {\n    fn show(xs: List<T>) -> String {\n        \"[\" + (xs |> Iter.map(&T.show(&1)) |> String.join(\" \")) + \"]\"\n    }\n}\n\nimpl Show for Vector<T> where T: Show {\n    fn show(xs: Vector<T>) -> String {\n        \"#[\" + (xs |> Iter.map(&T.show(&1)) |> String.join(\" \")) + \"]\"\n    }\n}\n\nimpl Show for Set<T> {\n    fn show(s: Set<T>) -> String {\n        \"set of ${Set.size(s)}\"\n    }\n}\n\nimpl Show for Map<String, V> where V: Show {\n    fn show(m: Map<String, V>) -> String {\n        m |> Iter.map(fn (k, v) -> \"${k}=${V.show(v)}\") |> String.join(\",\")\n    }\n}\n\nimpl Show for Maybe<T> where T: Show {\n    fn show(m: Maybe<T>) -> String {\n        case m {\n            Some(x) -> \"some ${T.show(x)}\"\n            None -> \"none\"\n        }\n    }\n}\n\nimpl Show for Result<T, String> where T: Show {\n    fn show(r: Result<T, String>) -> String {\n        case r {\n            Ok(x) -> \"ok ${T.show(x)}\"\n            Err(e) -> \"err ${e}\"\n        }\n    }\n}\n\nimpl Has<Int> for List<Int> {\n    fn count_of(xs: List<Int>, x: Int) -> Int {\n        xs |> Iter.filter(&(&1 == x)) |> Iter.count()\n    }\n}\n\npub struct Circle {\n    r: Int\n}\n\npub enum Shape {\n    embeds Circle\n    Dot\n}\n\nimpl Show for Circle {\n    fn show(c: Circle) -> String {\n        \"circle ${c.r}\"\n    }\n}\n\nimpl Show for Shape {\n    fn show(s: Shape) -> String {\n        case s {\n            .Circle{r} -> \"shape circle ${r}\"\n            .Dot -> \"shape dot\"\n        }\n    }\n}\n\nimpl Display for Circle {\n    fn to_string(c: Circle) -> String {\n        \"circle ${c.r}\"\n    }\n}\n\nimpl Display for Shape {\n    fn to_string(s: Shape) -> String {\n        case s {\n            .Circle{r} -> \"shape circle ${r}\"\n            .Dot -> \"shape dot\"\n        }\n    }\n}\n")
