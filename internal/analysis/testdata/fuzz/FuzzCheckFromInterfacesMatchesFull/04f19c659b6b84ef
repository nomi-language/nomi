string("// Each derive here compares, hashes, orders, renders or converts a field\n// whose type another file declares, through that file's impl: derived for\n// `Money`, `Coin` and `Cents`, written by hand for `Tally`.\nimport {\n    std::json.{FromJson, Json, ToJson}\n    money.{Cents, Coin, Money, Tally}\n}\n\nstruct Wallet {\n    money: Money\n    coin: Coin\n    cents: Cents\n    tally: Tally\n    bills: List<Money>\n}\n\nderive Equatable for Wallet\nderive Hashable for Wallet\nderive Comparable for Wallet\nderive Debug for Wallet\nderive Display for Wallet\nderive ToJson for Wallet\nderive FromJson for Wallet\n\nstruct Spare {\n    money: Maybe<Money>\n}\n\nderive Equatable for Spare\nderive Hashable for Spare\nderive Debug for Spare\nderive Display for Spare\nderive ToJson for Spare\nderive FromJson for Spare\n\nenum Purse {\n    Empty\n    Holding (Money, Coin)\n    Counted {total: Cents, tally: Tally}\n}\n\nderive Equatable for Purse\nderive Hashable for Purse\nderive Comparable for Purse\nderive Debug for Purse\nderive Display for Purse\nderive ToJson for Purse\nderive FromJson for Purse\n\nfn wallet(cents: Int) -> Wallet {\n    Wallet{\n        money: Money{cents},\n        coin: Coin.Dime,\n        cents: Cents(3),\n        tally: Tally{n: 4},\n        bills: [Money{cents: 5}],\n    }\n}\n\nfn counted() -> Purse {\n    Purse.Counted{total: Cents(1), tally: Tally{n: 2}}\n}\n\ntest \"a derived Equatable compares another file's types\" {\n    assert wallet(1) == wallet(1)\n    assert wallet(1) != wallet(2)\n    assert Spare{money: Some(Money{cents: 1})} == Spare{money: Some(Money{cents: 1})}\n    assert Purse.Holding(Money{cents: 1}, Coin.Penny) != Purse.Holding(Money{cents: 1}, Coin.Dime)\n}\n\ntest \"a derived Hashable hashes another file's types\" {\n    assert Hashable.hash(wallet(1)) == Hashable.hash(wallet(1))\n    assert Hashable.hash(Spare{money: None}) == Hashable.hash(Spare{money: None})\n    assert Hashable.hash(counted()) == Hashable.hash(counted())\n}\n\ntest \"a derived Comparable orders by another file's types\" {\n    assert wallet(1) < wallet(2)\n    assert Comparable.compare(wallet(2), wallet(2)) == Ordering.Equal\n    assert Purse.Holding(Money{cents: 1}, Coin.Penny) < Purse.Holding(Money{cents: 1}, Coin.Dime)\n}\n\ntest \"a derived Debug and Display render another file's types\" {\n    inspected = \"Wallet{money: Money{cents: 1}, coin: Dime, cents: Cents(3), tally: Tally#4, bills: [Money{cents: 5}]}\"\n    shown = \"Wallet{money: Money{cents: 1}, coin: Dime, cents: Cents(3), tally: tally 4, bills: [Money{cents: 5}]}\"\n    assert Debug.inspect(wallet(1)) == inspected\n    assert Display.to_string(wallet(1)) == shown\n    spare = Spare{money: Some(Money{cents: 6})}\n    assert Display.to_string(spare) == \"Spare{money: Some(Money{cents: 6})}\"\n    assert Display.to_string(counted()) == \"Counted{total: Cents(1), tally: tally 2}\"\n}\n\ntest \"a derived ToJson and FromJson convert another file's types\" {\n    json = ToJson.to_json(wallet(1))\n    text = \"{\\\"money\\\":{\\\"cents\\\":1},\\\"coin\\\":\\\"Dime\\\",\\\"cents\\\":3,\\\"tally\\\":4,\\\"bills\\\":[{\\\"cents\\\":5}]}\"\n    assert Json.encode(json) == text\n    assert FromJson.from_json<Wallet>(json) == Ok(wallet(1))\n    spare = Spare{money: Some(Money{cents: 6})}\n    assert FromJson.from_json<Spare>(ToJson.to_json(spare)) == Ok(spare)\n    purse = Purse.Holding(Money{cents: 7}, Coin.Penny)\n    assert FromJson.from_json<Purse>(ToJson.to_json(purse)) == Ok(purse)\n}\n\ntest \"another file's derived Variants lists its variants\" {\n    assert Coin.variants() == [Coin.Penny, Coin.Dime]\n    assert Variants.variants<Coin>() == [Coin.Penny, Coin.Dime]\n}\n")
