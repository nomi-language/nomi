string("// A program's own interface implemented for std containers: generically\n// (`impl Show for List<T> where T: Show`, in impls.nomi), at a concrete\n// instance (`impl Sized for List<Int>`, here), and at a partly concrete one\n// (`Map<String, V>`). Each call form reaches the impl the instance selects.\nimport {\n    impls\n    protocols.{Holds, Show, Zero}\n}\n\ninterface Sized {\n    fn size(value: self) -> Int\n}\n\nimpl Sized for List<Int> {\n    fn size(xs: List<Int>) -> Int {\n        Iter.count(xs)\n    }\n}\n\nimpl Sized for Maybe<String> {\n    fn size(m: Maybe<String>) -> Int {\n        case m {\n            Some(s) -> String.length(s)\n            None -> 0\n        }\n    }\n}\n\nfn shown<T>(x: T) -> String where T: Show {\n    T.loud(x)\n}\n\nfn made<T>(n: Int) -> T where T: Zero {\n    T.zero(n)\n}\n\nfn has<C, T>(c: C, x: T) -> Bool where C: Holds<T> {\n    C.holds(c, x)\n}\n\ntest \"an interface-qualified call reaches each container's impl\" {\n    assert Show.show([1, 2]) == \"[i1 i2]\"\n    assert Show.show(#[3]) == \"#[i3]\"\n    assert Show.show(%[\"a\", \"b\"]) == \"set of 2\"\n    assert Show.show(%{\"k\" => 4}) == \"k=i4\"\n    assert Show.show(Some(\"s\")) == \"some 's'\"\n    r: Result<Int, String> = Err(\"no\")\n    assert Show.show(r) == \"err 'no'\"\n}\n\ntest \"a generic interface implemented for a container at several type arguments\" {\n    assert Holds.holds([1, 2], 2)\n    assert Holds.holds(Some(4), \"4\")\n    assert Holds.holds(#[5, 6], 6)\n    assert Holds.holds(#[5, 6], \"5\")\n    refute Vector.holds(#[5], \"6\")\n    assert has(#[7], 7)\n}\n\ntest \"a type-qualified call\" {\n    assert List.show([\"x\"]) == \"['x']\"\n    assert Vector.show(#[5, 6]) == \"#[i5 i6]\"\n    assert Maybe.show(Some(7)) == \"some i7\"\n    assert List.size([1, 2, 3]) == 3\n    assert Maybe.size(Some(\"four\")) == 4\n}\n\ntest \"nested instances\" {\n    assert Show.show([[1], [2, 3]]) == \"[[i1] [i2 i3]]\"\n    assert Show.show(Some([Some(8)])) == \"some [some i8]\"\n    assert Show.show(%{\"a\" => [9]}) == \"a=[i9]\"\n}\n\ntest \"an interface default the impl does not override\" {\n    assert Show.loud([1]) == \"[i1]!\"\n    assert Maybe.loud(Some(2)) == \"some i2!\"\n}\n\ntest \"a call through a bound\" {\n    assert shown([10, 11]) == \"[i10 i11]!\"\n    assert shown(Some(#[12])) == \"some #[i12]!\"\n    assert has([1, 2], 2)\n    refute has([\"a\"], \"b\")\n    assert has(Some(4), \"4\")\n}\n\ntest \"a receiverless function, by turbofish, result type and bound\" {\n    assert Zero.zero<List<Int>>(3) == [3, 3]\n    assert Zero.zero<Maybe<List<Int>>>(1) == Some([1, 1])\n    nested: List<List<Int>> = Zero.zero(2)\n    assert nested == [[2, 2], [2, 2]]\n    some: Maybe<Int> = made(5)\n    assert some == Some(5)\n}\n\ntest \"pipes, placeholders and lambdas\" {\n    assert [1, 2] |> Show.show() == \"[i1 i2]\"\n    assert [[3], [4]] |> Iter.map(&Show.show(&1)) |> String.join(\";\") == \"[i3];[i4]\"\n    assert [[5]] |> Iter.map(fn xs -> List.loud(xs)) |> String.join(\";\") == \"[i5]!\"\n}\n\ntest \"std's own impls for the containers are unchanged\" {\n    assert \"${[1, 2]}\" == \"[1, 2]\"\n    assert Debug.inspect(Some([1])) == \"Some([1])\"\n    assert [1, 2] == [1, 2]\n}\n")
