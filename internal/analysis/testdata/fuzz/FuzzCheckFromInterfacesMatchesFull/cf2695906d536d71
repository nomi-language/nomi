string("import {\n    std::json.Json\n    users.{self, Admin, User}\n    users::teams.{self, Member}\n}\n\ntest \"type-qualified impl methods dispatch by receiver\" {\n    assert User.inspect(users.user(\"Ada\")) == \"user:Ada\"\n    assert Admin.inspect(users.admin(\"Grace\")) == \"admin:Grace\"\n}\n\ntest \"type-qualified impl methods pipe through dispatch\" {\n    assert users.user(\"Lin\") |> User.inspect() == \"user:Lin\"\n    assert users.admin(\"Margaret\") |> Admin.inspect() == \"admin:Margaret\"\n}\n\ntest \"type-qualified generic impl methods can use explicit targets\" {\n    encoded = User.to_json(users.user(\"Ada\"))\n    decoded: User = User.from_json(encoded)?\n\n    assert Json.encode(encoded) == \"{\\\"name\\\":\\\"Ada\\\"}\"\n    assert decoded == users.user(\"Ada\")\n    assert User.from_json(%Json.Obj{\"name\" => Json.String(\"Ada\")}) == Ok(users.user(\"Ada\"))\n}\n\ntest \"nested type-qualified impl methods dispatch by receiver\" {\n    assert Member.inspect(teams.member(\"Katherine\")) == \"member:Katherine\"\n}\n")
